/* ═══════════════════════════════════════════════════════════════════════════
   Mozaiks Keycloak Login Theme — CSS Template
   ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

   DO NOT EDIT login.css DIRECTLY — it is generated from this template.

   Tokens use the double-brace syntax and are resolved from brand.json
   by mozaiksai.cli.generators.theme.  Example: colors.primary.main

   To regenerate:
       python -m mozaiksai.cli generate --theme
       python -m mozaiksai.cli generate          (regenerates realm + theme)

   ═══════════════════════════════════════════════════════════════════════════ */

/* ── Fonts ──────────────────────────────────────────────────────────────── */
@import url('{{fonts.body.googleFont}}');
@import url('{{fonts.heading.googleFont}}');

/* ── Page background ────────────────────────────────────────────────────── */
body,
.login-pf body {
  background: {{colors.background.base}} !important;
  background-image: url('../img/bg.png') !important;
  background-size: cover !important;
  background-position: center center !important;
  background-repeat: no-repeat !important;
  background-attachment: fixed !important;
  font-family: '{{fonts.body.family}}', {{fonts.body.fallbacks}} !important;
}

/* ── Brand header / logo area ───────────────────────────────────────────── */
#kc-header-wrapper {
  font-family: '{{fonts.heading.family}}', '{{fonts.body.family}}', {{fonts.body.fallbacks}} !important;
  font-weight: 700 !important;
  font-size: 2.2rem !important;
  letter-spacing: 0.25em !important;
  color: {{colors.text.primary}} !important;
  text-shadow: 0 0 30px {{colors.primary.main}}66, 0 0 60px {{colors.secondary.main}}33 !important;
  padding: 2rem 0 1rem !important;
}

/* ── Login card ─────────────────────────────────────────────────────────── */
#kc-form-wrapper,
.card-pf,
#kc-login,
#kc-content-wrapper {
  background: {{colors.background.surface}}e0 !important;
  backdrop-filter: blur(20px) !important;
  -webkit-backdrop-filter: blur(20px) !important;
  border: 1px solid {{colors.border.subtle}} !important;
  border-radius: 1rem !important;
  box-shadow: {{shadows.elevated}} !important;
  color: {{colors.text.primary}} !important;
}

#kc-content {
  background: transparent !important;
}

/* ── Form container ─────────────────────────────────────────────────────── */
#kc-form {
  padding: 1.5rem !important;
}

/* ── Labels ─────────────────────────────────────────────────────────────── */
label,
.control-label,
#kc-form-options label {
  color: {{colors.text.secondary}} !important;
  font-family: '{{fonts.body.family}}', {{fonts.body.fallbacks}} !important;
  font-weight: 500 !important;
  font-size: 0.95rem !important;
}

/* ── Text inputs ────────────────────────────────────────────────────────── */
input[type="text"],
input[type="password"],
input[type="email"],
.form-control {
  background: {{colors.background.base}}b3 !important;
  border: 1px solid {{colors.border.strong}} !important;
  border-radius: 0.5rem !important;
  color: {{colors.text.primary}} !important;
  font-family: '{{fonts.body.family}}', {{fonts.body.fallbacks}} !important;
  font-size: 1rem !important;
  padding: 0.65rem 0.85rem !important;
  transition: border-color 0.2s, box-shadow 0.2s !important;
}

input[type="text"]:focus,
input[type="password"]:focus,
input[type="email"]:focus,
.form-control:focus {
  border-color: {{colors.primary.main}} !important;
  box-shadow: {{shadows.focus}} !important;
  outline: none !important;
}

/* ── Primary button (Sign In) ───────────────────────────────────────────── */
input[type="submit"],
.btn-primary,
#kc-login {
  background: linear-gradient(135deg, {{colors.primary.main}}, {{colors.primary.dark}}) !important;
  border: none !important;
  border-radius: 0.5rem !important;
  color: {{colors.text.onAccent}} !important;
  font-family: '{{fonts.body.family}}', {{fonts.body.fallbacks}} !important;
  font-weight: 600 !important;
  font-size: 1.05rem !important;
  letter-spacing: 0.05em !important;
  padding: 0.7rem 1.5rem !important;
  cursor: pointer !important;
  transition: all 0.2s !important;
  box-shadow: {{shadows.primary}} !important;
}

input[type="submit"]:hover,
.btn-primary:hover {
  background: linear-gradient(135deg, {{colors.primary.light}}, {{colors.primary.main}}) !important;
  box-shadow: 0 12px 35px {{colors.primary.main}}73 !important;
  transform: translateY(-1px) !important;
}

/* ── Links ──────────────────────────────────────────────────────────────── */
a,
.login-pf a,
#kc-registration a,
#kc-form-options a {
  color: {{colors.primary.main}} !important;
  text-decoration: none !important;
  transition: color 0.15s !important;
}

a:hover,
.login-pf a:hover {
  color: {{colors.primary.light}} !important;
}

/* ── Error / alert messages ─────────────────────────────────────────────── */
.alert-error,
.kc-feedback-text {
  background: {{colors.error.main}}26 !important;
  border: 1px solid {{colors.error.main}}4d !important;
  border-radius: 0.5rem !important;
  color: {{colors.error.light}} !important;
}

.alert-warning {
  background: {{colors.warning.main}}26 !important;
  border: 1px solid {{colors.warning.main}}4d !important;
  border-radius: 0.5rem !important;
  color: {{colors.warning.light}} !important;
}

.alert-success {
  background: {{colors.success.main}}26 !important;
  border: 1px solid {{colors.success.main}}4d !important;
  border-radius: 0.5rem !important;
  color: {{colors.success.light}} !important;
}

.alert-info {
  background: {{colors.primary.main}}26 !important;
  border: 1px solid {{colors.primary.main}}4d !important;
  border-radius: 0.5rem !important;
  color: {{colors.primary.light}} !important;
}

/* ── "Remember me" / checkbox ───────────────────────────────────────────── */
#kc-form-options .checkbox label,
.checkbox label {
  color: {{colors.text.secondary}} !important;
}

/* ── Registration / forgot password links ───────────────────────────────── */
#kc-registration,
#kc-form-options {
  color: {{colors.text.secondary}} !important;
}

/* ── Social login buttons ───────────────────────────────────────────────── */
.kc-social-provider {
  background: {{colors.background.elevated}}cc !important;
  border: 1px solid {{colors.border.strong}} !important;
  border-radius: 0.5rem !important;
  color: {{colors.text.primary}} !important;
  transition: border-color 0.15s, background 0.15s !important;
}

.kc-social-provider:hover {
  border-color: {{colors.primary.main}} !important;
  background: {{colors.primary.main}}1a !important;
}

/* ── Info / error page overrides ────────────────────────────────────────── */
.pf-c-alert,
.pf-c-card {
  background: {{colors.background.surface}}e0 !important;
  border: 1px solid {{colors.border.subtle}} !important;
  border-radius: 1rem !important;
  color: {{colors.text.primary}} !important;
}

/* ── Page title (h1 on info/error pages) ────────────────────────────────── */
#kc-page-title,
.login-pf h1,
h1 {
  font-family: '{{fonts.heading.family}}', '{{fonts.body.family}}', {{fonts.body.fallbacks}} !important;
  color: {{colors.text.primary}} !important;
  font-weight: 600 !important;
}

/* ── PatternFly overrides (Keycloak 22+) ────────────────────────────────── */
.pf-c-login__main {
  background: {{colors.background.surface}}e0 !important;
  backdrop-filter: blur(20px) !important;
  border: 1px solid {{colors.border.subtle}} !important;
  border-radius: 1rem !important;
}

.pf-c-login__main-header .pf-c-title {
  font-family: '{{fonts.heading.family}}', '{{fonts.body.family}}', {{fonts.body.fallbacks}} !important;
  color: {{colors.text.primary}} !important;
}

.pf-c-login__main-body .pf-c-form__label-text {
  color: {{colors.text.secondary}} !important;
}

.pf-c-login__main-footer__links-primary .pf-c-button--primary,
.pf-c-button.pf-m-primary {
  background: linear-gradient(135deg, {{colors.primary.main}}, {{colors.primary.dark}}) !important;
  border: none !important;
  border-radius: 0.5rem !important;
}

.pf-c-form-control {
  background: {{colors.background.base}}b3 !important;
  border: 1px solid {{colors.border.strong}} !important;
  color: {{colors.text.primary}} !important;
}

/* ── Hide default Keycloak background pattern ───────────────────────────── */
.login-pf .container,
.login-pf-page .container {
  background: transparent !important;
}
