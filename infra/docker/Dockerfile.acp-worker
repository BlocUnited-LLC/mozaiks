# syntax=docker/dockerfile:1
# Credential-free composition proof for the one-shot repository ACP worker.
# Both parent images must be built locally from their pinned Dockerfiles first.
# This image keeps the proof worker's fake-agent entrypoint and has no live mode.
ARG PROOF_IMAGE=mozaiks-acp-proof:local
ARG ADAPTER_IMAGE=mozaiks-acp-adapters:local

FROM ${ADAPTER_IMAGE} AS adapters
FROM ${PROOF_IMAGE}

COPY --from=adapters /usr/local/bin/node /usr/local/bin/node
COPY --from=adapters /opt/acp/node_modules /opt/acp/node_modules
COPY infra/docker/acp_proof/ /opt/mozaiks/acp_proof/
ENV PATH=/opt/acp/node_modules/.bin:$PATH
