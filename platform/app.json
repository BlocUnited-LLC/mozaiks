{
  "appName": "My App",
  "appId": "my-app",
  "apiUrl": "http://localhost:8000",
  "wsUrl": "ws://localhost:8000",
  "platforms": {
    "web": {
      "enabled": true
    },
    "mobile": {
      "enabled": true,
      "displayName": "My App",
      "version": {
        "name": "1.0.0",
        "code": 1
      },
      "ios": {},
      "android": {},
      "auth": {
        "provider": "token",
        "redirectScheme": "myapp",
        "redirectPath": "oauthredirect",
        "scopes": [
          "openid",
          "profile",
          "email"
        ]
      }
    },
    "desktop": {
      "enabled": false
    }
  },
  "auth": {
    "provider": "keycloak",
    "keycloak": {
      "authority": "http://localhost:8080",
      "realm": "mozaiks",
      "clientId": "mozaiks-app",
      "themeName": "mozaiks"
    }
  },
  "dev": {
    "mode": "development",
    "authMode": "mock",
    "fallbackToMockAuth": true,
    "autoLogin": true,
    "users": [
      {
        "username": "dev",
        "password": "dev",
        "email": "dev@mozaiks.local",
        "firstName": "Dev",
        "lastName": "User",
        "roles": [
          "user",
          "admin"
        ]
      }
    ]
  }
}
