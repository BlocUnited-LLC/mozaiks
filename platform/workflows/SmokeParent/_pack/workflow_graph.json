{
  "version": 3,
  "mid_flight_journeys": [
    {
      "id": "smoke-child-run",
      "description": "Spawn one child workflow and resume through a router",
      "trigger_agent": "PlannerAgent",
      "trigger_on": "agent_output",
      "requires": [],
      "fan_out": {
        "spawn_mode": "workflow",
        "max_children": 1,
        "timeout_seconds": 180,
        "input_contract": {
          "required": [],
          "optional": []
        },
        "child_context_seed": {
          "smoke_origin": "live_mfj_smoke"
        }
      },
      "fan_in": {
        "resume_agent": "PresenterAgent",
        "resume_entry_agent": "ResumeRouterAgent",
        "aggregation_strategy": "first_success",
        "inject_as": "mfj_smoke_results",
        "on_partial_failure": "resume_with_available",
        "timeout_seconds": 60
      },
      "output_contract": {
        "required": [
          "result",
          "worker_name"
        ],
        "optional": [
          "agent_message"
        ]
      }
    }
  ]
}