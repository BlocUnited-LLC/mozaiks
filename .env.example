# ============================================================
#  mozaiksai Runtime — Environment Configuration
#  Copy this file to .env and fill in your values.
#  .env is gitignored — never commit real secrets.
# ============================================================


################################################################
# 1. Environment & Runtime
################################################################

# Runtime environment — controls CORS defaults and log verbosity.
# Values: development | production
ENVIRONMENT=development
ENV=development
# Host options: runtime, platform, studio.
# studio is the local management host that serves Mozaiks Studio.
MOZAIKS_HOST=studio

# Application ID for single-tenant / default-app routing.
MOZAIKS_APP_ID=your-app-id-here

# Startup configuration check mode.
# "warn" (default) — emit WARNING logs for missing required config but continue startup.
# "strict" — raise StartupConfigError on the first missing required config (fails fast).
MOZAIKS_STARTUP_CHECKS=warn

# Optional single-root workflow override.
# Leave blank for normal host composition.
# Studio selects factory_app/workflows; app/product hosts select the active
# app root's workflows/ directory when present.
MOZAIKS_WORKFLOWS_PATH=

# Path to the active app input.
# This may be either an app bundle directory containing app.json or a workspace
# root containing ./app/app.json.
# Leave blank to use the repo-local first-party builder/reference app bundle by default.
# For the repo-local first-party bundle:
#   PLATFORM_PATH=factory_app/app
PLATFORM_PATH=

# External app workspace/repo root when PLATFORM_PATH is not set.
# Use this when the active app lives outside the mozaiks repo.
# Example:
#   MOZAIKS_APP_WORKSPACE_PATH=C:/repos/customer-app
MOZAIKS_APP_WORKSPACE_PATH=

# Automation events use in-process ingress by default. Split deployments should
# configure explicit HTTP event delivery at the host boundary.

# Maximum concurrent workflow executions per runtime instance.
MOZAIKS_MAX_PARALLEL_WORKFLOWS=4


################################################################
# 2. LLM / OpenAI
################################################################

# OpenAI API key — required for AG2 agents.
# In production, store in Azure Key Vault as secret "OpenAIApiKey".
OPENAI_API_KEY=sk-...

# Default model when a workflow does not specify one.
DEFAULT_LLM_MODEL=gpt-5-nano

# Comma-separated recovery models if the primary model is unavailable.
OPENAI_MODEL_FALLBACK=

# LLM config cache TTL in seconds (0 = disabled).
LLM_CONFIG_CACHE_TTL=300

# Deterministic seed for reproducible runs (comment out for random).
# LLM_DEFAULT_CACHE_SEED=42
# RANDOMIZE_DEFAULT_CACHE_SEED=1

# Local live generation gates. Keep disabled unless intentionally running
# real-model smoke tests from the repo.
RUN_LIVE_AGENTGENERATOR_SMOKE=0
RUN_LIVE_AGENTGENERATOR_PACK_SMOKE=0
RUN_LIVE_APPGENERATOR_ACCEPTANCE_SMOKE=0
RUN_REAL_FACTORY_ARTIFACT_LINEAGE_SMOKE=0
RUN_LIVE_REAL_FACTORY_ARTIFACT_LINEAGE_SMOKE=0


################################################################
# 3. Azure Key Vault (Production Secrets — optional)
################################################################

# When set, the runtime fetches secrets from Key Vault and falls
# back to env vars if unavailable.
# AZURE_KEY_VAULT_NAME=your-vault-name
# AZURE_TENANT_ID=your-tenant-id
# AZURE_CLIENT_ID=your-client-id
# AZURE_CLIENT_SECRET=your-client-secret
#
# Connector secret backend:
#   auto            - Use Azure Key Vault when AZURE_KEY_VAULT_NAME is set, else disable
#   azure_key_vault - Force Azure Key Vault connector secret storage
#   disabled        - Disable durable connector secret storage
MOZAIKS_CONNECTOR_SECRET_BACKEND=auto
MOZAIKS_CONNECTOR_SECRET_PREFIX=mozaiks-connector


################################################################
# 4. Database (MongoDB)
################################################################

# MongoDB connection string.
# Local: mongodb://localhost:27017
# Atlas: mongodb+srv://user:pass@cluster.mongodb.net
MONGO_URI=mongodb://localhost:27017

# Database name (used for all runtime collections).
MOZAIKS_APP_CODE_DB=mozaiksai

# Collection names.
MOZAIKS_APP_CODE_SNAPSHOTS_COLLECTION=AppCodeSnapshots
MOZAIKS_APP_CODE_PATCHSETS_COLLECTION=AppCodePatchSets
MOZAIKS_EXPORTS_DB=mozaiksai
MOZAIKS_WORKFLOW_EXPORTS_COLLECTION=WorkflowExports


################################################################
# 5. Network & CORS
################################################################

# Frontend origin. Included in CORS allow-list.
FRONTEND_URL=http://localhost:5173

# React dev server origin (allows hot-reload requests in dev).
REACT_DEV_ORIGIN=http://localhost:3000

# Additional CORS origins (comma-separated).
ADDITIONAL_CORS_ORIGINS=

# Internal URL the core-service uses to reach the AI runtime.
MozaiksAI_URL=http://localhost:8000

# Internal URL the AI runtime uses to reach external app services (if any).
# Not needed in unified mode — only for split-mode deployments.

# Shared secret for runtime ↔ backend internal calls.
INTERNAL_API_KEY=

# URL for the Mozaiks deployment / GitHub backend.
MOZAIKS_BACKEND_URL=http://localhost:3000

# Frontend shell envs (Vite reads these from the repo-root .env).
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
VITE_CORE_URL=http://localhost:8000

# Local dev auth convenience.
# keycloak = use real Keycloak auth
# mock = bypass auth UI entirely
VITE_DEV_AUTH_MODE=keycloak
VITE_DEV_AUTOLOGIN=true
VITE_MOCK_MODE=false


################################################################
# 6. Authentication (Pluggable Provider System)
################################################################

# Enable authentication. Set false for demo/development mode.
# When false, all requests are treated as anonymous user.
AUTH_ENABLED=false

# Roles granted to the anonymous dev user when AUTH_ENABLED=false.
# Set to "admin,user" to access the admin portal in no-auth dev mode.
AUTH_ANON_ROLES=admin,user

# Auth provider selection (auto-detected if not set):
#   none      - No authentication (same as AUTH_ENABLED=false)
#   jwt       - Generic OIDC/JWT (works with any compliant provider)
#   supabase  - Supabase Auth
#   keycloak  - Keycloak
AUTH_PROVIDER=

# ── Generic JWT Configuration ────────────────────────────────
# Use these for any OIDC-compliant provider (Auth0, Okta, etc.)

# JWKS URL for signature verification (required for jwt provider)
AUTH_JWKS_URL=

# Expected issuer claim (required for jwt provider)
AUTH_ISSUER=

# Expected audience claim (optional)
AUTH_AUDIENCE=

# Claim mappings (customize per provider)
AUTH_USER_ID_CLAIM=sub
AUTH_EMAIL_CLAIM=email
AUTH_NAME_CLAIM=name
AUTH_ROLES_CLAIM=roles
AUTH_SCOPES_CLAIM=scp

# Scope format: "space" (Azure/Keycloak) or "array" (Auth0)
AUTH_SCOPES_FORMAT=space

# Required scope for user endpoints (optional)
AUTH_REQUIRED_SCOPE=

# Signing algorithms (comma-separated)
AUTH_ALGORITHMS=RS256

# Clock skew tolerance in seconds
AUTH_CLOCK_SKEW=120

# ── Supabase Configuration ───────────────────────────────────
# Set SUPABASE_URL to auto-detect Supabase provider

SUPABASE_URL=
SUPABASE_JWT_SECRET=

# ── Keycloak Configuration ───────────────────────────────────
# Set KEYCLOAK_URL + KEYCLOAK_REALM to auto-detect Keycloak provider

KEYCLOAK_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=

# ── OIDC Discovery for existing app setups ──────
MOZAIKS_OIDC_AUTHORITY=
MOZAIKS_OIDC_DISCOVERY_URL=

# Accept JWT via WebSocket query-param on connect.
# SECURITY: Keep false in production — query-param tokens appear in server logs and browser history.
# Set to true only for local development or when WebSocket header auth is unavailable.
MOZAIKS_WS_ALLOW_QUERY_TOKEN=false


################################################################
# 7. Keycloak Docker Compose (only needed when running via compose)
################################################################

KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=change-me
KC_DB_PASSWORD=change-me
KC_HOSTNAME=localhost


################################################################
# 8. Logging & Observability
################################################################

# Base directory for log files.
LOGS_BASE_DIR=logs/logs

# Emit logs as JSON (useful for log aggregators like Datadog/Loki).
LOGS_AS_JSON=false

# Clear log files on server startup (1=yes, 0=no).
CLEAR_LOGS_ON_START=0

# Clear ephemeral workflow debug artifacts on server startup (1=yes, 0=no).
# This removes files under logs/agent_outputs and logs/workflow_converter.
CLEAR_RUNTIME_ARTIFACTS_ON_START=0

# Optional override directories for ephemeral runtime debug artifacts.
MOZAIKS_AGENT_OUTPUTS_DIR=logs/agent_outputs
MOZAIKS_WORKFLOW_CONVERTER_LOG_DIR=logs/workflow_converter

# Performance telemetry.
MOZAIKS_PERSIST_PERF=0
MOZAIKS_PERF_DEBUG=0

# AG2 runtime logging backend (file | sqlite).
AG2_RUNTIME_LOGGING=true
AG2_RUNTIME_LOGGER_TYPE=sqlite

# AG2 workflow step-by-step debug output.
AG2_WORKFLOW_DEBUG=false

# OpenTelemetry tracing.
# Set AG2_OTEL_EXPORTER=otlp to ship to a collector.
AG2_OTEL_ENABLED=false
AG2_OTEL_SERVICE_NAME=mozaiks-runtime
AG2_OTEL_EXPORTER=console
AG2_OTEL_CAPTURE_MESSAGES=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_HEADERS=


################################################################
# 9. Uploads & Attachments
################################################################

UPLOAD_STORAGE_DIR=uploads
UPLOAD_MAX_BYTES=26214400
UPLOAD_BUNDLE_MAX_BYTES=10485760
CHAT_ATTACHMENTS_ALLOWED_WORKFLOWS=
# Comma-separated MIME type allowlist for chat attachments.
# Defaults to: text/plain, text/markdown, text/csv, text/html, text/xml,
# text/x-python, text/x-java, text/javascript, text/typescript,
# application/json, application/pdf, application/xml, application/yaml,
# image/png, image/jpeg, image/gif, image/webp, image/svg+xml.
# Set to * to disable MIME type enforcement (not recommended in production).
UPLOAD_ALLOWED_MIME_TYPES=
AGENTGEN_ATTACHMENTS_ALLOW_BUNDLING=false


################################################################
# 10. Monetization & Billing
################################################################

# Set to 1 to enable subscription enforcement (0 = open / free).
MONETIZATION=0

# URL for the token/usage billing service.
TOKENS_API_URL=


################################################################
# 11. Runtime Tuning
################################################################

# Tool definition cache: 1=clear on startup, 0=keep.
CLEAR_TOOL_CACHE_ON_START=0

# Idempotency window for duplicate chat-start requests (seconds).
CHAT_START_IDEMPOTENCY_SEC=15

# Auto-expire chat sessions after this many days (TTL index on ChatSessions.created_at).
# Set to 0 to disable TTL.
CHAT_SESSION_TTL_DAYS=90

# Maximum characters allowed in a single user message (~2 000 GPT-4 tokens at the default).
# Set to 0 to disable.
CHAT_MESSAGE_MAX_CHARS=8000

# Enforce application/user principal headers on API requests.
ENFORCE_PRINCIPAL_HEADERS=false

# Max deploy bundle size sent to backend (bytes).
MOZAIKS_DEPLOY_MAX_BUNDLE_BYTES=26214400

MCP_REGISTRY_ENABLE_API=false

# Platform extension modules (managed installs only — leave blank).
RUNTIME_PLATFORM_EXTENSIONS=

# Ask Mode general-agent executor override (advanced).
# Defaults are:
#   module  = mozaiksai.core.capabilities.simple_llm
#   factory = get_general_capability_service
# Uncomment only if you need a custom executor implementation.
# MOZAIKS_GENERAL_AGENT_MODULE=mozaiksai.core.capabilities.simple_llm
# MOZAIKS_GENERAL_AGENT_FACTORY=get_general_capability_service

################################################################
# 12. Context & Schema
################################################################

CONTEXT_AWARE=true
CONTEXT_INCLUDE_SCHEMA=true
CONTEXT_SCHEMA_DB=mozaiksai
CONTEXT_VERBOSE_DEBUG=0
# Optional JSON file that supplies local sample values for `data_reference`
# context variables when DB lookups return empty during development.
# Leave blank for normal runtime behavior.
MOZAIKS_CONTEXT_FALLBACKS_FILE=


################################################################
# 13. E2B Sandbox (optional — app-generator feature)
################################################################

# AppGenerator validation strategy.
# Leave blank to resolve automatically:
#   1. e2b   when E2B_API_KEY is set
#   2. local when npm is available on the current machine
#   3. skip  when neither runtime is available
# Allowed values: e2b | local | skip
MOZAIKS_APP_VALIDATION_STRATEGY=

E2B_API_KEY=
E2B_TIMEOUT=120
APP_VALIDATION_BUILD_OUTPUT_MAX_CHARS=20000


################################################################
# 14. Rate Limiting
################################################################

# Enable rate limiting (recommended for production).
RATE_LIMIT_ENABLED=true

# Default requests per minute per client.
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Burst allowance (extra requests above the limit).
RATE_LIMIT_BURST=10

# Paths to exclude from rate limiting (comma-separated).
RATE_LIMIT_EXCLUDED_PATHS=/api/health,/api/health/live,/api/health/ready

# Path-specific limits (format: "path:limit,path:limit").
# Example: /api/ai:30,/api/chat:120
RATE_LIMIT_PATH_LIMITS=

# Header to use for client identification behind a proxy.
# For production behind a load balancer, set to "X-Forwarded-For".
RATE_LIMIT_CLIENT_HEADER=


################################################################
# 15. Insights / Telemetry Push (dock with mozaiks.ai platform)
################################################################

# Enable telemetry push to mozaiks.ai platform.
INSIGHTS_PUSH_ENABLED=false

# Base URL for the mozaiks.ai insights API.
INSIGHTS_BASE_URL=

# Per-app API key for authentication with mozaiks.ai.
MOZAIKS_API_KEY=

# Push interval in seconds.
INSIGHTS_PUSH_INTERVAL_S=60

# Heartbeat interval in seconds.
INSIGHTS_HEARTBEAT_INTERVAL_S=300


################################################################
# 16. Build Telemetry (Opt-in — anonymized build outcome data)
################################################################

# Anonymized, HMAC-signed build telemetry. No user content, generated code,
# or identifiable information is ever sent. Each build_registry_id is
# one-way hashed (SHA-256) before transmission.
#
# Leave MOZAIKS_TELEMETRY_ENDPOINT unset to disable entirely.
# When set, telemetry fires at the end of each build workflow run.

# HTTPS URL of the telemetry receiver endpoint.
# Example: https://telemetry.mozaiks.ai/v1/build
MOZAIKS_TELEMETRY_ENDPOINT=

# Set to "false" to opt out even when an endpoint is configured.
MOZAIKS_TELEMETRY_ENABLED=true

# Shared HMAC-SHA256 secret for payload signing.
# Must match the receiver's configured secret for signature verification.
MOZAIKS_TELEMETRY_SECRET=


################################################################
# PRODUCTION CHECKLIST
################################################################
#
# Before deploying to production, ensure these settings:
#
# 1. ENVIRONMENT & IDENTITY
#    [ ] ENV=production
#    [ ] MOZAIKS_APP_ID=<your-unique-app-id>
#
# 2. SECRETS
#    [ ] OPENAI_API_KEY is set (or use Azure Key Vault)
#    [ ] INTERNAL_API_KEY is set to a strong random value
#    [ ] KC_ADMIN_PASSWORD is changed from default
#    [ ] KC_DB_PASSWORD is changed from default
#
# 3. AUTHENTICATION
#    [ ] AUTH_ENABLED=true
#    [ ] MOZAIKS_OIDC_AUTHORITY points to production Keycloak
#    [ ] MOZAIKS_WS_ALLOW_QUERY_TOKEN=false (use header auth)
#
# 4. NETWORK
#    [ ] FRONTEND_URL is set to your production domain
#    [ ] ADDITIONAL_CORS_ORIGINS only includes trusted domains
#    [ ] All localhost URLs are replaced with production URLs
#
# 5. DATABASE
#    [ ] MONGO_URI points to production MongoDB (Atlas recommended)
#
# 6. RATE LIMITING
#    [ ] RATE_LIMIT_ENABLED=true
#    [ ] RATE_LIMIT_CLIENT_HEADER=X-Forwarded-For (if behind proxy)
#
# 7. LOGGING
#    [ ] LOGS_AS_JSON=true (for log aggregation)
#    [ ] CLEAR_LOGS_ON_START=0
#    [ ] CLEAR_RUNTIME_ARTIFACTS_ON_START=0
#
# 8. OPTIONAL
#    [ ] MONETIZATION=1 (if enforcing subscriptions)
#    [ ] INSIGHTS_PUSH_ENABLED=true (if using mozaiks.ai platform)
#
