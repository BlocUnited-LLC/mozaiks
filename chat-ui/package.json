{
  "name": "@mozaiks/chat-ui",
  "private": true,
  "version": "1.0.0",
  "description": "Mozaiks Chat UI library. This package.json exists so that dependencies used by src/ are resolvable via standard Node module resolution when developing from template/.",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./core": "./src/core/index.js",
    "./platform": "./src/platform/index.js",
    "./workspace": "./src/workspace/index.js",
    "./ui": "./src/ui/index.js",
    "./embed": "./src/embed/index.js",
    "./coreBridge": "./src/coreBridge.js",
    "./adminPortalRegistry": "./src/adminPortalRegistry.js"
  },
  "scripts": {
    "build:embed": "vite build --config vite.embed.config.js"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "react-native": "*",
    "react-router-dom": ">=6"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-router-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.20",
    "@radix-ui/react-progress": "^1.1.13",
    "@radix-ui/react-select": "^2.3.4",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.18",
    "@radix-ui/react-tooltip": "^1.2.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.12",
    "marked": "^13.0.3",
    "react-icons": "^5.7.0",
    "react-native-web": "^0.21.2",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.20",
    "tailwindcss": "^3.4.13",
    "terser": "^5.49.0",
    "vite": "^5.4.0"
  }
}
