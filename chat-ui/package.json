{
  "name": "@mozaiks/chat-ui",
  "private": true,
  "version": "1.0.0",
  "description": "Mozaiks Chat UI library. This package.json exists so that dependencies used by src/ are resolvable via standard Node module resolution when developing from template/.",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./core": "./src/core/index.js",
    "./platform": "./src/platform/index.js",
    "./workspace": "./src/workspace/index.js",
    "./ui": "./src/ui/index.js",
    "./embed": "./src/embed/index.js",
    "./auth": "./src/auth/index.js",
    "./coreBridge": "./src/coreBridge.js",
    "./adminPortalRegistry": "./src/adminPortalRegistry.js"
  },
  "scripts": {
    "build:embed": "vite build --config vite.embed.config.js"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "react-native": "*",
    "react-router-dom": ">=6"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-router-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "react-icons": "^5.7.0",
    "react-native-web": "^0.21.4",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.30",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "terser": "^5.51.2",
    "vite": "^8.3.4"
  }
}
