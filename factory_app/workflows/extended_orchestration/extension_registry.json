{
  "pack_name": "DefaultPack",
  "version": 3,
  "description": "Universal workflow routing layer. Defines workflow registry entries, dependencies, transition routes, and optional workflow sequence metadata. NOT agent routing; that lives in transition_graph.yaml.",
  "artifact_dependency_graph": {
    "concept": [],
    "theme_capture": [
      "concept"
    ],
    "design_docs": [
      "concept"
    ],
    "workflow_bundle": [
      "design_docs",
      "subscription_contract"
    ],
    "subscription_contract": [
      "concept",
      "design_docs"
    ],
    "app_bundle": [
      "design_docs",
      "workflow_bundle",
      "subscription_contract",
      "theme_capture"
    ],
    "application_inventory": [],
    "ownership_boundary": [
      "application_inventory"
    ],
    "integration_inventory": [
      "application_inventory"
    ],
    "risk_report": [
      "application_inventory",
      "ownership_boundary",
      "integration_inventory"
    ],
    "adoption_plan": [
      "application_inventory",
      "ownership_boundary",
      "integration_inventory",
      "risk_report"
    ],
    "brownfield_registration": [
      "application_inventory",
      "ownership_boundary",
      "integration_inventory",
      "risk_report",
      "adoption_plan"
    ],
    "source_context_bundle": [
      "application_inventory"
    ],
    "app_context_graph": [
      "application_inventory",
      "ownership_boundary",
      "integration_inventory",
      "risk_report",
      "adoption_plan",
      "source_context_bundle"
    ],
    "app_intelligence_snapshot": [
      "source_context_bundle",
      "app_context_graph"
    ],
    "app_context_version": [
      "application_inventory",
      "ownership_boundary",
      "integration_inventory",
      "risk_report",
      "adoption_plan",
      "brownfield_registration",
      "source_context_bundle",
      "app_context_graph",
      "app_intelligence_snapshot"
    ]
  },
  "workflows": [
    {
      "id": "ValueEngine",
      "description": "Concept & value decomposition",
      "startup_mode": "UserDriven",
      "interaction_mode": "user_guided",
      "launch_behavior": "auto_start",
      "handoff_style": "continuous_chat"
    },
    {
      "id": "ThemeCapture",
      "description": "Captures visual identity and produces theme_config.json",
      "startup_mode": "AgentDriven",
      "interaction_mode": "agent_directed",
      "launch_behavior": "auto_start",
      "handoff_style": "continuous_chat",
      "dependencies": [
        "ValueEngine"
      ]
    },
    {
      "id": "DesignDocs",
      "description": "Frontend, backend, database design docs",
      "startup_mode": "AgentDriven",
      "interaction_mode": "agent_directed",
      "launch_behavior": "auto_start",
      "handoff_style": "continuous_chat",
      "dependencies": [
        "ValueEngine"
      ]
    },
    {
      "id": "SubscriptionContractDesigner",
      "description": "Generates provider-neutral subscription, access, and token contract artifacts",
      "startup_mode": "AgentDriven",
      "interaction_mode": "agent_directed",
      "launch_behavior": "auto_start",
      "handoff_style": "continuous_chat",
      "dependencies": [
        "DesignDocs"
      ]
    },
    {
      "id": "AgentGenerator",
      "description": "Generates workflow artifacts and agent specs",
      "startup_mode": "AgentDriven",
      "interaction_mode": "agent_directed",
      "launch_behavior": "auto_start",
      "handoff_style": "continuous_chat",
      "dependencies": [
        "DesignDocs",
        "SubscriptionContractDesigner"
      ]
    },
    {
      "id": "AppGenerator",
      "description": "Generates app schema and module files",
      "startup_mode": "AgentDriven",
      "interaction_mode": "agent_directed",
      "launch_behavior": "auto_start",
      "handoff_style": "continuous_chat",
      "dependencies": [
        "DesignDocs",
        "SubscriptionContractDesigner",
        "AgentGenerator",
        "ThemeCapture"
      ]
    },
    {
      "id": "ExistingAppDiscovery",
      "description": "Discovery workflow for existing-app adopters",
      "startup_mode": "AgentDriven",
      "interaction_mode": "user_guided",
      "launch_behavior": "auto_start",
      "handoff_style": "continuous_chat"
    },
    {
      "id": "AppReview",
      "description": "In-chat build review and promote-or-revise HITL step",
      "startup_mode": "AgentDriven",
      "interaction_mode": "agent_directed",
      "launch_behavior": "auto_start",
      "handoff_style": "continuous_chat",
      "dependencies": [
        "AppGenerator"
      ]
    }
  ],
  "entrypoints": [
    {
      "id": "create_app",
      "path": "/create",
      "label": "Create App",
      "sequence": "build",
      "transition": "app_type_selector",
      "requiresAuth": false,
      "order": 2,
      "meta": {
        "title": "Create App",
        "freshStart": true,
        "shellMode": "focused",
        "navigation": {
          "include": false
        }
      }
    }
  ],
  "workflow_sequences": [
    {
      "id": "build",
      "description": "Full build pipeline: app path context -> value -> brand -> coding participation -> database setup intent -> design -> generation -> review and promote.",
      "affected_declarative_families": [
        "concept",
        "theme_capture",
        "design_docs",
        "subscription_contract",
        "workflow_bundle",
        "app_bundle"
      ],
      "steps": [
        {
          "transition": "app_type_selector"
        },
        {
          "workflows": [
            "ValueEngine"
          ]
        },
        {
          "workflows": [
            "ThemeCapture"
          ]
        },
        {
          "transition": "coding_journey_selector"
        },
        {
          "transition": "database_setup_selector"
        },
        {
          "workflows": [
            "DesignDocs"
          ]
        },
        {
          "workflows": [
            "SubscriptionContractDesigner"
          ]
        },
        {
          "workflows": [
            "AgentGenerator"
          ]
        },
        {
          "workflows": [
            "AppGenerator"
          ]
        },
        {
          "transition": "app_review"
        }
      ]
    },
    {
      "id": "brownfield_app_adoption",
      "description": "Existing app intake pipeline: app path context -> enhancement-path selection -> repo selection -> App Intelligence indexing -> discovery chat.",
      "affected_declarative_families": [
        "application_inventory",
        "ownership_boundary",
        "integration_inventory",
        "risk_report",
        "adoption_plan",
        "brownfield_registration",
        "source_context_bundle",
        "app_context_graph",
        "app_intelligence_snapshot",
        "app_context_version"
      ],
      "steps": [
        {
          "transition": "app_type_selector"
        },
        {
          "transition": "brownfield_path_selector"
        },
        {
          "transition": "brownfield_repo_input"
        },
        {
          "workflows": [
            "ExistingAppDiscovery"
          ]
        }
      ]
    },
    {
      "id": "brownfield_discovery_refresh",
      "description": "Non-mutating brownfield context refresh: reruns ExistingAppDiscovery for a registered brownfield app to refresh app-context artifacts and the current AppContextVersion. Does not run generation, create staged patches, or mutate source repositories.",
      "affected_declarative_families": [
        "application_inventory",
        "ownership_boundary",
        "integration_inventory",
        "risk_report",
        "adoption_plan",
        "brownfield_registration",
        "source_context_bundle",
        "app_context_graph",
        "app_intelligence_snapshot",
        "app_context_version"
      ],
      "steps": [
        {
          "workflows": [
            "ExistingAppDiscovery"
          ]
        }
      ]
    },
    {
      "id": "brownfield_overlay_generation",
      "description": "Existing app Add AI Workflows path: ValueEngine plans app-aware AI improvements, then the scoped build stack generates approved workflow and app surfaces without replacing the existing app.",
      "affected_declarative_families": [
        "concept",
        "theme_capture",
        "design_docs",
        "subscription_contract",
        "workflow_bundle",
        "app_bundle"
      ],
      "steps": [
        {
          "workflows": [
            "ValueEngine"
          ]
        },
        {
          "workflows": [
            "ThemeCapture"
          ]
        },
        {
          "workflows": [
            "DesignDocs"
          ]
        },
        {
          "workflows": [
            "SubscriptionContractDesigner"
          ]
        },
        {
          "workflows": [
            "AgentGenerator"
          ]
        },
        {
          "workflows": [
            "AppGenerator"
          ]
        },
        {
          "transition": "app_review"
        }
      ]
    },
    {
      "id": "brownfield_module_generation",
      "description": "Existing app Build App Features path: ValueEngine plans approved feature expansion, then the scoped build stack generates Mozaiks-owned features and extensions without rewriting the source repository.",
      "affected_declarative_families": [
        "concept",
        "theme_capture",
        "design_docs",
        "subscription_contract",
        "workflow_bundle",
        "app_bundle"
      ],
      "steps": [
        {
          "workflows": [
            "ValueEngine"
          ]
        },
        {
          "workflows": [
            "ThemeCapture"
          ]
        },
        {
          "workflows": [
            "DesignDocs"
          ]
        },
        {
          "workflows": [
            "SubscriptionContractDesigner"
          ]
        },
        {
          "workflows": [
            "AgentGenerator"
          ]
        },
        {
          "workflows": [
            "AppGenerator"
          ]
        },
        {
          "transition": "app_review"
        }
      ]
    },
    {
      "id": "full_rebuild",
      "description": "Revision pipeline for concept-level changes that need the full build stack refreshed without onboarding transitions.",
      "affected_declarative_families": [
        "concept",
        "theme_capture",
        "design_docs",
        "subscription_contract",
        "workflow_bundle",
        "app_bundle"
      ],
      "steps": [
        {
          "workflows": [
            "ValueEngine"
          ]
        },
        {
          "workflows": [
            "ThemeCapture"
          ]
        },
        {
          "workflows": [
            "DesignDocs"
          ]
        },
        {
          "workflows": [
            "SubscriptionContractDesigner"
          ]
        },
        {
          "workflows": [
            "AgentGenerator"
          ]
        },
        {
          "workflows": [
            "AppGenerator"
          ]
        },
        {
          "transition": "app_review"
        }
      ]
    },
    {
      "id": "conceptual_replan",
      "description": "Concept-level pivot that re-plans from existing app context, preserving brand and reusable generic modules. Runs the same workflow chain as full_rebuild but is semantically distinct so later work can inject preservation context (pivot_description, preserve_families, carry_forward_modules).",
      "affected_declarative_families": [
        "concept",
        "theme_capture",
        "design_docs",
        "subscription_contract",
        "workflow_bundle",
        "app_bundle"
      ],
      "steps": [
        {
          "workflows": [
            "ValueEngine"
          ]
        },
        {
          "workflows": [
            "ThemeCapture"
          ]
        },
        {
          "workflows": [
            "DesignDocs"
          ]
        },
        {
          "workflows": [
            "SubscriptionContractDesigner"
          ]
        },
        {
          "workflows": [
            "AgentGenerator"
          ]
        },
        {
          "workflows": [
            "AppGenerator"
          ]
        },
        {
          "transition": "app_review"
        }
      ]
    },
    {
      "id": "concept_patch",
      "description": "Scoped concept revision owned by ValueEngine.",
      "affected_declarative_families": [
        "concept"
      ],
      "steps": [
        {
          "workflows": [
            "ValueEngine"
          ]
        }
      ]
    },
    {
      "id": "design_patch",
      "description": "Scoped design-document revision owned by DesignDocs.",
      "affected_declarative_families": [
        "design_docs"
      ],
      "steps": [
        {
          "workflows": [
            "DesignDocs"
          ]
        }
      ]
    },
    {
      "id": "design_revision",
      "description": "Design-intent revision that refreshes downstream workflow and app artifacts.",
      "affected_declarative_families": [
        "design_docs",
        "subscription_contract",
        "workflow_bundle",
        "app_bundle"
      ],
      "steps": [
        {
          "workflows": [
            "DesignDocs"
          ]
        },
        {
          "workflows": [
            "SubscriptionContractDesigner"
          ]
        },
        {
          "workflows": [
            "AgentGenerator"
          ]
        },
        {
          "workflows": [
            "AppGenerator"
          ]
        }
      ]
    },
    {
      "id": "app_surface_revision",
      "description": "App-surface revision that reopens DesignDocs and regenerates app artifacts.",
      "affected_declarative_families": [
        "design_docs",
        "app_bundle"
      ],
      "steps": [
        {
          "workflows": [
            "DesignDocs"
          ]
        },
        {
          "workflows": [
            "AppGenerator"
          ]
        }
      ]
    },
    {
      "id": "subscription_patch",
      "description": "Scoped subscription contract revision owned by SubscriptionContractDesigner, then an app-bundle refresh to re-emit the contract's generated config and gated action declarations.",
      "affected_declarative_families": [
        "subscription_contract",
        "app_bundle"
      ],
      "steps": [
        {
          "workflows": [
            "SubscriptionContractDesigner"
          ]
        },
        {
          "workflows": [
            "AppGenerator"
          ]
        }
      ]
    },
    {
      "id": "subscription_revision",
      "description": "Subscription contract revision that refreshes workflow metering and regenerated app artifacts.",
      "affected_declarative_families": [
        "subscription_contract",
        "workflow_bundle",
        "app_bundle"
      ],
      "steps": [
        {
          "workflows": [
            "SubscriptionContractDesigner"
          ]
        },
        {
          "workflows": [
            "AgentGenerator"
          ]
        },
        {
          "workflows": [
            "AppGenerator"
          ]
        }
      ]
    },
    {
      "id": "workflow_patch",
      "description": "Scoped workflow-bundle revision owned by AgentGenerator.",
      "affected_declarative_families": [
        "workflow_bundle"
      ],
      "steps": [
        {
          "workflows": [
            "AgentGenerator"
          ]
        }
      ]
    },
    {
      "id": "workflow_revision",
      "description": "Workflow-bundle revision that refreshes generated app wiring.",
      "affected_declarative_families": [
        "workflow_bundle",
        "app_bundle"
      ],
      "steps": [
        {
          "workflows": [
            "AgentGenerator"
          ]
        },
        {
          "workflows": [
            "AppGenerator"
          ]
        }
      ]
    },
    {
      "id": "app_revision",
      "description": "Scoped app-bundle revision owned by AppGenerator.",
      "affected_declarative_families": [
        "app_bundle"
      ],
      "steps": [
        {
          "workflows": [
            "AppGenerator"
          ]
        }
      ]
    },
    {
      "id": "theme_revision",
      "description": "Theme revision pipeline: re-runs ThemeCapture to refresh brand tokens, then rebuilds the app bundle with the updated theme.",
      "affected_declarative_families": [
        "theme_capture",
        "app_bundle"
      ],
      "steps": [
        {
          "workflows": [
            "ThemeCapture"
          ]
        },
        {
          "workflows": [
            "AppGenerator"
          ]
        }
      ]
    },
    {
      "id": "theme_patch",
      "description": "Scoped theme patch applied within AppGenerator without re-running ThemeCapture.",
      "affected_declarative_families": [
        "theme_capture",
        "app_bundle"
      ],
      "steps": [
        {
          "workflows": [
            "AppGenerator"
          ]
        }
      ]
    }
  ],
  "transitions": [
    {
      "id": "app_type_selector",
      "transition_type": "user_choice_context",
      "ui": {
        "component": "AppTypeSelector",
        "mode": "screen",
        "shell_mode": "focused",
        "props": {
          "dismissible": true,
          "dismiss_to": "/apps",
          "close_label": "Back to Apps"
        }
      },
      "options": [
        {
          "id": "greenfield_app",
          "route_to": "ValueEngine",
          "sequence": "build",
          "context_variables": {
            "app_type": "greenfield_app"
          }
        },
        {
          "id": "brownfield_app",
          "route_to": "brownfield_path_selector",
          "sequence": "brownfield_app_adoption",
          "context_variables": {
            "app_type": "brownfield_app"
          }
        }
      ]
    },
    {
      "id": "coding_journey_selector",
      "transition_type": "user_choice_context",
      "ui": {
        "component": "CodingJourneySelector",
        "mode": "screen",
        "shell_mode": "focused"
      },
      "options": [
        {
          "id": "autonomous",
          "route_to": "DesignDocs",
          "context_variables": {
            "coding_participation": "autonomous",
            "design_docs_hitl": false
          }
        },
        {
          "id": "guided",
          "route_to": "DesignDocs",
          "context_variables": {
            "coding_participation": "guided",
            "design_docs_hitl": true
          }
        }
      ]
    },
    {
      "id": "app_review",
      "transition_type": "chat_session",
      "route_to": "AppReview"
    },
    {
      "id": "brownfield_path_selector",
      "transition_type": "user_choice_context",
      "ui": {
        "component": "BrownfieldPathSelector",
        "mode": "screen",
        "shell_mode": "focused"
      },
      "options": [
        {
          "id": "light_integration",
          "route_to": "brownfield_repo_input",
          "sequence": "brownfield_app_adoption",
          "context_variables": {
            "brownfield_build_path": "light_integration"
          }
        },
        {
          "id": "full_migration",
          "route_to": "brownfield_repo_input",
          "sequence": "brownfield_app_adoption",
          "context_variables": {
            "brownfield_build_path": "full_migration"
          }
        }
      ]
    },
    {
      "id": "brownfield_repo_input",
      "transition_type": "user_choice_context",
      "ui": {
        "component": "BrownfieldRepoInput",
        "mode": "screen",
        "shell_mode": "focused"
      },
      "options": [
        {
          "id": "start_discovery",
          "route_to": "ExistingAppDiscovery",
          "sequence": "brownfield_app_adoption",
          "context_variables": {}
        }
      ]
    },
    {
      "id": "database_setup_selector",
      "transition_type": "user_choice_context",
      "ui": {
        "component": "DatabaseSetupSelector",
        "mode": "screen",
        "shell_mode": "focused"
      },
      "options": [
        {
          "id": "local_mongodb",
          "route_to": "DesignDocs",
          "context_variables": {
            "database_provider": "mongodb",
            "database_setup_mode": "local"
          }
        },
        {
          "id": "mongodb_atlas",
          "route_to": "DesignDocs",
          "context_variables": {
            "database_provider": "mongodb",
            "database_setup_mode": "atlas"
          }
        },
        {
          "id": "existing_uri",
          "route_to": "DesignDocs",
          "context_variables": {
            "database_provider": "mongodb",
            "database_setup_mode": "existing_uri"
          }
        },
        {
          "id": "skip_for_now",
          "route_to": "DesignDocs",
          "context_variables": {
            "database_provider": "mongodb",
            "database_setup_mode": "skip"
          }
        }
      ]
    },
    {
      "id": "workflow_complete",
      "transition_type": "workflow_complete",
      "ui": {
        "component": "WorkflowCompletion",
        "mode": "screen",
        "shell_mode": "focused"
      }
    }
  ]
}
