    },
    {
      "path": "/apps/new",
      "component": "CreateAppRedirectPage",
      "label": "Create App",
      "order": 3,
      "meta": {
        "surfaces": ["studio"],
        "title": "Create App",
        "appShell": true,
        "ai_context": "The user is on the Create App page, where they can generate a new AI-powered app using the Studio builder.",
        "navigation": {
          "group": "workspace-studio",
          "include": false
        }
      }
    },
    {
      "path": "/apps",
      "component": "AppsPage",
      "label": "My Apps",
      "order": 4,
      "meta": {
        "surfaces": ["studio"],
        "title": "My Apps",
        "appShell": true,
        "ai_context": "The user is on My Apps in Studio, showing the apps they manage. Each app can be clicked to open App Studio for configuration, usage, and health details.",
        "navigation": {
          "group": "workspace-studio",
          "scope": "local",
          "icon": "apps"
        }
      }
    },
    {
      "path": "/performance",
      "component": "WorkspacePerformancePage",
