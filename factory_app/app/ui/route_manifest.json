      "meta": {
        "surfaces": ["studio"],
        "requiresRole": "admin",
        "title": "Integrations",
        "appShell": true,
        "ai_context": "The user is on the workspace Integrations page. It shows shared services by task state: app-used services needing setup, connected services ready for reuse, and available services for future apps. Secret values are never displayed.",
        "navigation": {
          "group": "workspace-studio",
          "scope": "local",
          "icon": "plug"
        }
      }
