{
  "pack_name": "DefaultPack",
  "version": 3,
  "description": "Universal workflow routing layer. Defines workflow registry entries, dependencies, transition routes, and optional workflow sequence metadata. NOT agent routing; that lives in handoffs.yaml.",

  "workflows": [
    { "id": "ValueEngine",          "description": "Concept & value decomposition" },
    { "id": "ThemeCapture",         "description": "Captures visual identity and produces theme_config.json", "dependencies": ["ValueEngine"] },
    { "id": "DesignDocs",           "description": "Frontend, backend, database design docs", "dependencies": ["ValueEngine"] },
    { "id": "AgentGenerator",       "description": "Generates workflow artifacts and agent specs", "dependencies": ["DesignDocs"] },
    { "id": "AppGenerator",         "description": "Generates app schema and module files", "dependencies": ["DesignDocs", "AgentGenerator", "ThemeCapture"] },
    { "id": "ExistingAppDiscovery", "description": "Discovery workflow for existing-app adopters" }
  ],

  "entrypoints": [
    {
      "id": "create_app",
      "path": "/create",
      "label": "Create App",
      "sequence": "build",
      "transition": "app_type_selector",
      "requiresAuth": false,
      "order": 2,
      "meta": {
        "title": "Create App"
      }
    }
  ],

  "workflow_sequences": [
    {
      "id": "build",
      "description": "Full build pipeline: app path context → value → brand → coding participation → design → generation.",
      "steps": [
        { "transition": "app_type_selector" },
        { "workflows": ["ValueEngine"] },
        { "workflows": ["ThemeCapture"] },
        { "transition": "coding_journey_selector" },
        { "workflows": ["DesignDocs"] },
        { "workflows": ["AgentGenerator"] },
        { "workflows": ["AppGenerator"] }
      ]
    }
  ],

  "transitions": [
    {
      "id": "app_type_selector",
      "transition_type": "user_choice_context",
      "ui": {
        "component": "AppTypeSelector",
        "mode": "screen"
      },
      "options": [
        {
          "id": "new_app",
          "route_to": "ValueEngine",
          "context_variables": {
            "app_type": "new"
          }
        },
        {
          "id": "existing_app",
          "route_to": "ValueEngine",
          "context_variables": {
            "app_type": "existing"
          }
        }
      ]
    },
    {
      "id": "coding_journey_selector",
      "transition_type": "user_choice_context",
      "ui": {
        "component": "CodingJourneySelector",
        "mode": "screen"
      },
      "options": [
        {
          "id": "autonomous",
          "route_to": "DesignDocs",
          "context_variables": {
            "coding_participation": "autonomous",
            "design_docs_hitl": false
          }
        },
        {
          "id": "guided",
          "route_to": "DesignDocs",
          "context_variables": {
            "coding_participation": "guided",
            "design_docs_hitl": true
          }
        }
      ]
    }
  ]
}
