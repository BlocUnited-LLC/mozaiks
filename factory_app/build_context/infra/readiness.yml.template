# .github/workflows/readiness.yml
# Generated by mozaiks factory — operator fills in {{VARIABLE}} values
# and stores SMOKE_CLIENT_ID / SMOKE_CLIENT_SECRET as GitHub environment secrets.
#
# Required GitHub environment secrets (Settings → Environments → {{ENV_NAME}} → Secrets):
#   AUTH_URL                  — OIDC provider base URL (e.g. https://auth.yourapp.com)
#   SMOKE_CLIENT_ID           — client_credentials client ID for CI smoke user
#   SMOKE_CLIENT_SECRET       — client_credentials client secret for CI smoke user
#
# Required GitHub environment variables:
#   APP_URL                   — deployed app base URL (e.g. https://app.yourapp.com)
#   AUTH_REALM                — OIDC realm name (default: {{APP_ID}})

name: Readiness

on:
  workflow_dispatch:
    inputs:
      run_health_gate:
        description: "Check deployed app health endpoints"
        required: true
        default: true
        type: boolean
      run_smoke_gate:
        description: "Run authenticated API smoke against deployed app"
        required: true
        default: true
        type: boolean

concurrency:
  group: readiness-{{APP_ID}}
  cancel-in-progress: false

permissions:
  contents: read

jobs:
  readiness:
    name: Readiness report
    runs-on: ubuntu-latest
    environment:
      name: {{ENV_NAME}}
      url: ${{ vars.APP_URL }}

    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
          cache: pip
          cache-dependency-path: requirements.txt

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          python -m pip install -r requirements.txt

      # -----------------------------------------------------------------------
      # Token minting — client_credentials grant, no expiry management needed.
      # SMOKE_CLIENT_ID + SMOKE_CLIENT_SECRET are stored as environment secrets
      # and never rotate unless explicitly rotated by the operator.
      # -----------------------------------------------------------------------
      - name: Mint smoke token
        if: ${{ inputs.run_smoke_gate }}
        env:
          AUTH_URL: ${{ secrets.AUTH_URL }}
          AUTH_REALM: ${{ vars.AUTH_REALM || '{{APP_ID}}' }}
          SMOKE_CLIENT_ID: ${{ secrets.SMOKE_CLIENT_ID }}
          SMOKE_CLIENT_SECRET: ${{ secrets.SMOKE_CLIENT_SECRET }}
        run: |
          TOKEN=$(curl -sf -X POST \
            "${AUTH_URL}/realms/${AUTH_REALM}/protocol/openid-connect/token" \
            -d "grant_type=client_credentials" \
            -d "client_id=${SMOKE_CLIENT_ID}" \
            -d "client_secret=${SMOKE_CLIENT_SECRET}" \
            | jq -r .access_token)
          if [ -z "$TOKEN" ] || [ "$TOKEN" = "null" ]; then
            echo "Failed to mint smoke token — check SMOKE_CLIENT_ID and SMOKE_CLIENT_SECRET." >&2
            exit 1
          fi
          echo "SMOKE_TOKEN=$TOKEN" >> $GITHUB_ENV

      # -----------------------------------------------------------------------
      # Health gate — verifies the deployed app is up and responding.
      # -----------------------------------------------------------------------
      - name: Check deployed app health
        if: ${{ inputs.run_health_gate }}
        env:
          APP_URL: ${{ vars.APP_URL }}
        run: |
          if [ -z "$APP_URL" ]; then
            echo "APP_URL environment variable is required." >&2
            exit 1
          fi
          curl --fail --show-error --silent "$APP_URL/api/health" | tee health.json
          curl --fail --show-error --silent "$APP_URL/api/health/readiness" | tee readiness.json

      # -----------------------------------------------------------------------
      # Smoke gate — replace this step with your app's smoke script.
      # The SMOKE_TOKEN env var is available from the mint step above.
      # -----------------------------------------------------------------------
      - name: Run API smoke
        if: ${{ inputs.run_smoke_gate }}
        env:
          APP_URL: ${{ vars.APP_URL }}
          SMOKE_TOKEN: ${{ env.SMOKE_TOKEN }}
        run: |
          set -o pipefail
          python scripts/smoke_api.py --json | tee smoke.json

      - name: Upload readiness artifacts
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: readiness-${{ github.run_id }}
          path: |
            health.json
            readiness.json
            smoke.json
          if-no-files-found: ignore
