#!/usr/bin/env bash
# provision.sh — Self-hosted operator bootstrap
# Generated by mozaiks factory — fill in {{VARIABLE}} values before running.
#
# What this script does (idempotent, safe to re-run):
#   1. Mint a Keycloak admin token from the master realm.
#   2. Create (or reuse) a client_credentials service client in your app realm.
#   3. Assign a realm role to the service client's service account.
#   4. Retrieve the client secret.
#   5. Push KEYCLOAK_SMOKE_CLIENT_ID, KEYCLOAK_SMOKE_CLIENT_SECRET,
#      KEYCLOAK_URL, and KEYCLOAK_REALM into your GitHub environment secrets,
#      ready for the readiness.yml workflow to mint tokens per CI run.
#
# Prerequisites:
#   - curl, jq — for Keycloak admin API calls
#   - python3 with PyNaCl — for GitHub secret encryption
#       pip install pynacl
#   - A Keycloak admin account with access to the master realm
#   - A GitHub PAT (GITHUB_TOKEN) with `secrets:write` on the target repo
#
# Required environment variables (set before running or export inline):
#   KEYCLOAK_URL            — Keycloak base URL, no trailing slash
#                             e.g. https://auth.{{APP_ID}}.example.com
#   KEYCLOAK_ADMIN_PASSWORD — master realm admin password
#   GITHUB_TOKEN            — PAT with secrets:write on GITHUB_OWNER/GITHUB_REPO
#   GITHUB_OWNER            — GitHub org or user (e.g. acme-corp)
#   GITHUB_REPO             — GitHub repo name (e.g. my-mozaiks-app)
#
# Optional environment variables (defaults shown):
#   KEYCLOAK_ADMIN_USER     — master realm admin username (default: admin)
#   KEYCLOAK_REALM          — app realm name (default: {{APP_ID}})
#   KEYCLOAK_SMOKE_CLIENT   — smoke client id (default: {{APP_ID}}-smoke)
#   KEYCLOAK_SMOKE_ROLE     — realm role to assign (default: admin)
#   GITHUB_ENVIRONMENT      — GitHub environment name (default: {{ENV_NAME}})
#
# Usage:
#   export KEYCLOAK_URL=https://auth.myapp.example.com
#   export KEYCLOAK_ADMIN_PASSWORD=...
#   export GITHUB_TOKEN=ghp_...
#   export GITHUB_OWNER=my-org
#   export GITHUB_REPO=my-app
#   bash provision.sh

set -euo pipefail

# ---------------------------------------------------------------------------
# Config — override via env vars before running
# ---------------------------------------------------------------------------
KEYCLOAK_URL="${KEYCLOAK_URL:?KEYCLOAK_URL is required}"
KEYCLOAK_ADMIN_USER="${KEYCLOAK_ADMIN_USER:-admin}"
KEYCLOAK_ADMIN_PASSWORD="${KEYCLOAK_ADMIN_PASSWORD:?KEYCLOAK_ADMIN_PASSWORD is required}"
KEYCLOAK_REALM="${KEYCLOAK_REALM:-{{APP_ID}}}"
KEYCLOAK_SMOKE_CLIENT="${KEYCLOAK_SMOKE_CLIENT:-{{APP_ID}}-smoke}"
KEYCLOAK_SMOKE_ROLE="${KEYCLOAK_SMOKE_ROLE:-admin}"

GITHUB_TOKEN="${GITHUB_TOKEN:?GITHUB_TOKEN is required}"
GITHUB_OWNER="${GITHUB_OWNER:?GITHUB_OWNER is required}"
GITHUB_REPO="${GITHUB_REPO:?GITHUB_REPO is required}"
GITHUB_ENVIRONMENT="${GITHUB_ENVIRONMENT:-{{ENV_NAME}}}"
GITHUB_API="https://api.github.com"

echo "==> Keycloak: ${KEYCLOAK_URL}/realms/${KEYCLOAK_REALM}"
echo "==> GitHub:   ${GITHUB_OWNER}/${GITHUB_REPO} @ environment '${GITHUB_ENVIRONMENT}'"
echo ""

# ---------------------------------------------------------------------------
# Step 1 — mint Keycloak admin token from master realm
# ---------------------------------------------------------------------------
echo "[1/5] Minting Keycloak admin token..."
ADMIN_TOKEN=$(curl -sf -X POST \
  "${KEYCLOAK_URL}/realms/master/protocol/openid-connect/token" \
  -H "Content-Type: application/x-www-form-urlencoded" \
  -d "grant_type=password" \
  -d "client_id=admin-cli" \
  -d "username=${KEYCLOAK_ADMIN_USER}" \
  -d "password=${KEYCLOAK_ADMIN_PASSWORD}" \
  | jq -r .access_token)

if [ -z "${ADMIN_TOKEN}" ] || [ "${ADMIN_TOKEN}" = "null" ]; then
  echo "ERROR: Could not mint admin token — check KEYCLOAK_URL and KEYCLOAK_ADMIN_PASSWORD." >&2
  exit 1
fi
echo "    Admin token minted."

KC_CLIENTS_URL="${KEYCLOAK_URL}/admin/realms/${KEYCLOAK_REALM}/clients"
AUTH_HEADER="Authorization: Bearer ${ADMIN_TOKEN}"

# ---------------------------------------------------------------------------
# Step 2 — create or reuse the smoke service client
# ---------------------------------------------------------------------------
echo "[2/5] Checking for existing client '${KEYCLOAK_SMOKE_CLIENT}'..."
EXISTING_ID=$(curl -sf \
  "${KC_CLIENTS_URL}?clientId=${KEYCLOAK_SMOKE_CLIENT}" \
  -H "${AUTH_HEADER}" \
  | jq -r '.[0].id // empty')

if [ -n "${EXISTING_ID}" ]; then
  echo "    Client already exists (id: ${EXISTING_ID}) — reusing."
  CLIENT_UUID="${EXISTING_ID}"
else
  echo "    Creating client '${KEYCLOAK_SMOKE_CLIENT}'..."
  curl -sf -X POST "${KC_CLIENTS_URL}" \
    -H "${AUTH_HEADER}" \
    -H "Content-Type: application/json" \
    -d "$(jq -n \
      --arg cid "${KEYCLOAK_SMOKE_CLIENT}" \
      '{
        clientId: $cid,
        enabled: true,
        publicClient: false,
        serviceAccountsEnabled: true,
        authorizationServicesEnabled: false,
        standardFlowEnabled: false,
        implicitFlowEnabled: false,
        directAccessGrantsEnabled: false,
        protocol: "openid-connect"
      }')"

  CLIENT_UUID=$(curl -sf \
    "${KC_CLIENTS_URL}?clientId=${KEYCLOAK_SMOKE_CLIENT}" \
    -H "${AUTH_HEADER}" \
    | jq -r '.[0].id')
  echo "    Created client (id: ${CLIENT_UUID})."
fi

# ---------------------------------------------------------------------------
# Step 3 — assign realm role to service account
# ---------------------------------------------------------------------------
echo "[3/5] Assigning realm role '${KEYCLOAK_SMOKE_ROLE}' to service account..."

SA_USER_ID=$(curl -sf \
  "${KEYCLOAK_URL}/admin/realms/${KEYCLOAK_REALM}/clients/${CLIENT_UUID}/service-account-user" \
  -H "${AUTH_HEADER}" \
  | jq -r '.id')

ROLE_PAYLOAD=$(curl -sf \
  "${KEYCLOAK_URL}/admin/realms/${KEYCLOAK_REALM}/roles/${KEYCLOAK_SMOKE_ROLE}" \
  -H "${AUTH_HEADER}" \
  | jq -c '[{id: .id, name: .name}]')

curl -sf -X POST \
  "${KEYCLOAK_URL}/admin/realms/${KEYCLOAK_REALM}/users/${SA_USER_ID}/role-mappings/realm" \
  -H "${AUTH_HEADER}" \
  -H "Content-Type: application/json" \
  -d "${ROLE_PAYLOAD}" \
  -o /dev/null \
  -w "" 2>/dev/null || true   # 409 is fine — role already assigned

echo "    Role assigned (or already present)."

# ---------------------------------------------------------------------------
# Step 4 — retrieve client secret
# ---------------------------------------------------------------------------
echo "[4/5] Retrieving client secret..."
CLIENT_SECRET=$(curl -sf \
  "${KC_CLIENTS_URL}/${CLIENT_UUID}/client-secret" \
  -H "${AUTH_HEADER}" \
  | jq -r '.value')

if [ -z "${CLIENT_SECRET}" ] || [ "${CLIENT_SECRET}" = "null" ]; then
  echo "    Regenerating secret..."
  CLIENT_SECRET=$(curl -sf -X POST \
    "${KC_CLIENTS_URL}/${CLIENT_UUID}/client-secret" \
    -H "${AUTH_HEADER}" \
    | jq -r '.value')
fi
echo "    Secret retrieved."

# ---------------------------------------------------------------------------
# Step 5 — push secrets into GitHub environment
# ---------------------------------------------------------------------------
echo "[5/5] Pushing secrets to GitHub environment '${GITHUB_ENVIRONMENT}'..."

GH_ENV_PATH="repos/${GITHUB_OWNER}/${GITHUB_REPO}/environments/${GITHUB_ENVIRONMENT}/secrets"

# Fetch environment public key for NaCl encryption
KEY_RESP=$(curl -sf \
  "${GITHUB_API}/${GH_ENV_PATH}/public-key" \
  -H "Authorization: Bearer ${GITHUB_TOKEN}" \
  -H "Accept: application/vnd.github+json" \
  -H "X-GitHub-Api-Version: 2022-11-28")

KEY_ID=$(echo "${KEY_RESP}" | jq -r '.key_id')
PUB_KEY=$(echo "${KEY_RESP}" | jq -r '.key')

# Encrypt a secret value using NaCl sealed box (PyNaCl)
encrypt_secret() {
  local SECRET_VALUE="$1"
  python3 - <<PYEOF
import base64, sys
try:
    from nacl import encoding, public
except ImportError:
    print("ERROR: PyNaCl not installed — run: pip install pynacl", file=sys.stderr)
    sys.exit(1)
pub_key = base64.b64decode("${PUB_KEY}")
sealed = public.SealedBox(public.PublicKey(pub_key)).encrypt(
    "${SECRET_VALUE}".encode("utf-8")
)
print(base64.b64encode(sealed).decode("ascii"))
PYEOF
}

put_secret() {
  local NAME="$1"
  local VALUE="$2"
  local ENCRYPTED
  ENCRYPTED=$(encrypt_secret "${VALUE}")
  HTTP_CODE=$(curl -s -o /dev/null -w "%{http_code}" -X PUT \
    "${GITHUB_API}/${GH_ENV_PATH}/${NAME}" \
    -H "Authorization: Bearer ${GITHUB_TOKEN}" \
    -H "Accept: application/vnd.github+json" \
    -H "X-GitHub-Api-Version: 2022-11-28" \
    -H "Content-Type: application/json" \
    -d "$(jq -n --arg ev "${ENCRYPTED}" --arg kid "${KEY_ID}" \
          '{encrypted_value: $ev, key_id: $kid}')")
  if [ "${HTTP_CODE}" = "201" ] || [ "${HTTP_CODE}" = "204" ]; then
    echo "    ${NAME} written (HTTP ${HTTP_CODE})."
  else
    echo "ERROR: Failed to write ${NAME} — HTTP ${HTTP_CODE}." >&2
    exit 1
  fi
}

put_secret "KEYCLOAK_SMOKE_CLIENT_ID"     "${KEYCLOAK_SMOKE_CLIENT}"
put_secret "KEYCLOAK_SMOKE_CLIENT_SECRET" "${CLIENT_SECRET}"
put_secret "KEYCLOAK_URL"                 "${KEYCLOAK_URL}"
put_secret "KEYCLOAK_REALM"               "${KEYCLOAK_REALM}"

# ---------------------------------------------------------------------------
# Done
# ---------------------------------------------------------------------------
echo ""
echo "Provisioning complete."
echo ""
echo "GitHub environment '${GITHUB_ENVIRONMENT}' now has:"
echo "  KEYCLOAK_SMOKE_CLIENT_ID     = ${KEYCLOAK_SMOKE_CLIENT}"
echo "  KEYCLOAK_SMOKE_CLIENT_SECRET = (stored, not shown)"
echo "  KEYCLOAK_URL                 = ${KEYCLOAK_URL}"
echo "  KEYCLOAK_REALM               = ${KEYCLOAK_REALM}"
echo ""
echo "The readiness.yml workflow will use these to mint a fresh token per CI run."
echo "No further token rotation is required."
