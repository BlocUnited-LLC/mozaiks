            },
            {
              "name": "filename",
              "type": "string",
              "required": true
            },
            {
              "name": "mime_type",
              "type": "string",
              "required": true
            },
            {
              "name": "size_bytes",
              "type": "integer",
              "required": true
            },
            {
              "name": "storage_url",
              "type": "string",
              "required": true
            },
            {
              "name": "is_public",
              "type": "boolean",
              "required": true
            },
            {
              "name": "created_by",
              "type": "string",
              "required": true
            },
            {
              "name": "created_at",
              "type": "string",
              "required": true
            },
            {
              "name": "deleted",
              "type": "boolean",
              "required": true
            },
            {
              "name": "deleted_at",
              "type": "string",
              "required": false
            },
            {
              "name": "deleted_by",
