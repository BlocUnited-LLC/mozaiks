# Local MongoDB; use a fresh database for this public-only reference.
MONGO_URI=mongodb://127.0.0.1:27017
MOZAIKS_APP_DATABASE_NAME=common_ground_reference
MOZAIKS_DATABASE_STARTUP_POLICY=required

# Configure an OIDC issuer and a public browser client with PKCE.
# The issuer must grant these permissions; requesting scopes does not grant them.
# Reference users need user_posts.read, user_posts.create, user_posts.react only.
AUTH_ENABLED=true
AUTH_PROVIDER=jwt
AUTH_ISSUER=
AUTH_JWKS_URL=
AUTH_AUDIENCE=
AUTH_SCOPES_CLAIM=scope
AUTH_SCOPES_FORMAT=space
# RFC 9068 at+jwt access tokens need no discriminator override. For another
# issuer, configure its signed access-token-only claim and value together.
# Local Keycloak example: claim typ, value Bearer.
AUTH_ACCESS_TOKEN_TYPE_CLAIM=
AUTH_ACCESS_TOKEN_TYPE_VALUE=
MOZAIKS_OIDC_AUTHORITY=
MOZAIKS_OIDC_DISCOVERY_URL=

VITE_OIDC_CLIENT_ID=
VITE_OIDC_AUTHORITY=
VITE_OIDC_DISCOVERY_URL=
VITE_OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
VITE_OIDC_SCOPE=openid profile email user_posts.read user_posts.create user_posts.react
