      "navigation": { "scope": "global", "order": 10 },
      "meta": { "requiresAuth": true, "title": "Community" },
      "purpose": "Member-authored posts with persisted reactions and conversations."
    },
    {
      "id": "community-post", "path": "/community/:postId", "component": "CommunityPostPage",
      "label": "Conversation", "shell_mode": "standard",
      "navigation": { "include": false },
      "meta": { "requiresAuth": true, "title": "Conversation" },
      "purpose": "Deep-linked post detail and an interactive comment thread."
