    description: \"Warehouse and location management \\u2014 bins, zones, pick paths.\"\n        recommended_module_type: standard\n  erp_operations:\n    description: \"Enterprise resource planning \\u2014 finance, procurement, HR, operations.\"\n    common_app_types:\n    - ERP\n    - operations platform\n    - business management suite\n    - SMB back-office\n    modules:\n      general_ledger:\n        description: Chart of accounts, journal entries, and financial reporting.\n        recommended_module_type: transactional\n      accounts_payable:\n        description: Supplier invoices, approval, and payment scheduling.\n        recommended_module_type: transactional\n      accounts_receivable:\n        description: Customer invoicing, payment collection, and aging.\n        recommended_module_type: transactional\n      hr_employees:\n        description: Employee records, contracts, and HR lifecycle.\n        recommended_module_type: standard\n  legal_compliance:\n    description: \"Legal operations \\u2014 contracts, compliance tracking, risk management.\"\n    common_app_types:\n    - contract management\n    - compliance platform\n    - legal ops\n    - risk management\n    modules:\n      contracts:\n        description: \"Contract lifecycle \\u2014 drafting, review, signing, renewal.\"\n        recommended_module_type: workflow\n      compliance_items:\n        description: \"Compliance requirements \\u2014 obligations, deadlines, evidence collection.\"\n        recommended_module_type: standard\n      risk_register:\n        description: Risk identification, assessment, and mitigation tracking.\n        recommended_module_type: standard\n  government_civic:\n    description: \"Government and civic platforms \\u2014 services, permits, public records, participation.\"\n    common_app_types:\n    - citizen portal\n    - permit management\n    - public services\n    - civic engagement\n    modules:\n      service_requests:\n        description: \"Citizen service requests \\u2014 submission, routing, status tracking.\"\n        recommended_module_type: standard\n      permits:\n        description: \"Permit applications \\u2014 submission, review, approval, and issuance.\"\n        recommended_module_type: workflow\n      public_records:\n        description: Public record publication and search.\n        recommended_module_type: standard\n  nonprofit_fundraising:\n    description: \"Nonprofit operations \\u2014 donations, campaigns, donor management, grants.\"\n    common_app_types:\n    - fundraising platform\n    - donor CRM\n    - grant management\n    - volunteer platform\n    modules:\n      campaigns:\n        description: \"Fundraising campaigns \\u2014 goal, timeline, story, and progress.\"\n        recommended_module_type: standard\n      donations:\n        description: \"Donation processing \\u2014 one-time and recurring, receipts, tax records.\"\n        recommended_module_type: transactional\n      donors:\n        description: \"Donor profiles \\u2014 giving history, segmentation, stewardship.\"\n        recommended_module_type: standard\n      grants:\n        description: \"Grant applications \\u2014 submissions, review, award, and reporting.\"\n        recommended_module_type: workflow\n  iot_devices:\n    description: \"IoT platforms \\u2014 device management, telemetry, rules, and remote control.\"\n    common_app_types:\n    - IoT management platform\n    - smart home\n    - industrial IoT\n    - connected product\n    modules:\n      devices:\n        description: \"Device registry \\u2014 provisioning, metadata, connectivity status.\"\n        recommended_module_type: standard\n      telemetry:\n        description: \"Device telemetry ingestion \\u2014 sensor readings, time-series storage.\"\n        recommended_module_type: standard\n      rules:\n        description: \"Automation rules \\u2014 trigger conditions, device actions, notifications.\"\n        recommended_module_type: standard\n      firmware:\n        description: Firmware version management and OTA update orchestration.\n        recommended_module_type: standard\n  gaming_interactive:\n    description: \"Gaming platforms \\u2014 player accounts, matches, leaderboards, in-game economy.\"\n    common_app_types:\n    - multiplayer game backend\n    - gaming platform\n    - esports\n    - casual game\n    modules:\n      players:\n        description: \"Player profiles \\u2014 stats, achievements, game history, and identity.\"\n        recommended_module_type: standard\n      matches:\n        description: \"Match lifecycle \\u2014 creation, player assignment, result recording.\"\n        recommended_module_type: standard\n      leaderboards:\n        description: \"Global and scoped leaderboards \\u2014 rankings, score history.\"\n        recommended_module_type: standard\n      economy:\n        description: \"In-game economy \\u2014 virtual currency, item purchases, inventory.\"\n        recommended_module_type: transactional\n  directory_discovery:\n    description: \"Directory and discovery platforms \\u2014 listings, profiles, search, reviews.\"\n    common_app_types:\n    - business directory\n    - professional network\n    - local discovery\n    - niche directory\n    modules:\n      profiles:\n        description: \"Listed entity profiles \\u2014 businesses, professionals, venues.\"\n        recommended_module_type: standard\n      search:\n        description: Location-aware and keyword search across directory listings.\n        recommended_module_type: standard\n      reviews:\n        description: User reviews and ratings for listed entities.\n        recommended_module_type: workflow\n      claims:\n        description: Ownership claim flow for unclaimed profiles.\n        recommended_module_type: standard\n  classifieds_auction:\n    description: \"Classifieds and auction platforms \\u2014 listings, bids, payments, safety.\"\n    common_app_types:\n    - classifieds site\n    - online auction\n    - C2C marketplace\n    - equipment auction\n    modules:\n      listings:\n        description: \"Ad and auction item listings \\u2014 creation, pricing, expiry.\"\n        recommended_module_type: standard\n      bids:\n        description: \"Auction bidding \\u2014 bid submission, outbid detection, winner selection.\"\n        recommended_module_type: standard\n      messages:\n        description: \"Buyer\\u2013seller messaging before transaction.\"\n        recommended_module_type: messaging\n  internal_tools:\n    description: \"Internal business tools \\u2014 admin panels, operational dashboards, data management.\"\n    common_app_types:\n    - internal admin tool\n    - ops dashboard\n    - data management tool\n    - employee portal\n    modules:\n      data_management:\n        description: Bulk data import, export, and transformation tools.\n        recommended_module_type: standard\n      reports:\n        description: \"Internal operational reports \\u2014 scheduled and on-demand.\"\n        recommended_module_type: standard\n      approvals:\n        description: \"Internal approval workflows \\u2014 requests, reviewers, decisions.\"\n        recommended_module_type: workflow\n      config_management:\n        description: \"Operational configuration \\u2014 feature toggles, system parameters.\"\n        recommended_module_type: standard\n  collaboration_productivity:"},{"checksum":"sha256:41269fbd1f8844575d8eff69e69d5833210b70e4344caa508fa234a22a5678ab","chunk_id":"chunk_8852be2a32cf9f69","end_line":868,"path":"build_context/AppGenerator/domain_catalogs.yaml","start_line":853,"symbol_ids":[],"text":"    description: \"Team collaboration \\u2014 documents, whiteboards, calendars, task lists.\"\n    common_app_types:\n    - collaboration suite\n    - team workspace\n    - productivity app\n    - shared workspace\n    modules:\n      documents:\n        description: \"Collaborative document editing \\u2014 real-time, versioning, sharing.\"\n        recommended_module_type: standard\n      calendars:\n        description: \"Shared team calendars \\u2014 events, availability, scheduling.\"\n        recommended_module_type: standard\n      tasks:\n        description: Personal and shared task lists with due dates and assignments.\n        recommended_module_type: standard"},{"checksum":"sha256:4139452d57c81adebe2bedccfc44c0fa0fac8b5dbb3242ba3c3b0f6578ce5827","chunk_id":"chunk_8c505fb2d6a20731","end_line":84,"path":"build_context/AppGenerator/file_contracts.yaml","start_line":1,"symbol_ids":[],"text":"version: 1\n\ndescription: >\n  Advisory file contract catalog for AppGenerator. Declares task ownership\n  boundaries, canonical output families, and hard constraints for each task type.\n\n  Language-agnostic by design. File path templates under downstream_backend_defaults\n  and optional_frontend_stubs use the active dev pack's language profile for their\n  actual extension and path conventions. The webapp_builder dev pack\n  (build_context/webapp_builder/language_profile.yaml) is the authoritative source\n  for Python/FastAPI/MongoDB/React path conventions. A different dev pack would\n  declare different conventions without changing this file.\n\n  Runtime truth remains the structured outputs, build_tasks, owned_paths, and\n  runtime loaders \u2014 not this catalog.\n\n  Authenticated app scaffolds are emitted through save_auth_scaffold outside\n  AppBuildPlan build_tasks. config/auth.yaml\n  validates against the shared mozaiks.auth.v1 model; ui/auth/authAdapter.js\n  delegates to @mozaiks/chat-ui/auth. Do not generate OIDC, token storage, or\n  local demo identity implementations. Backend configuration selects auth mode.\n\ntask_contracts:\n  page_bundle:\n    owner_agent: AppSchemaAgent\n    summary: Declarative persistent app UI bundle for the page_bundle task.\n    required_outputs:\n      - ui/pages/*.yaml\n    optional_outputs:\n      - app.json\n      - provenance.yaml\n      - ui/route_manifest.json\n      - ui/pages/custom/*.jsx\n      - ui/index.js\n      - ui/lib/moduleApi.js\n      - brand/theme_config.json\n      - dashboard/dashboard.yaml\n      - config/shell.json\n      - config/asset_manifest.json\n    hard_constraints:\n      - Persistent app pages stay declarative by default.\n      - Page filenames are case-sensitive lowercase identities derived by the canonical materializer from the final route segment (or the page name for /), with non-alphanumeric runs replaced by underscores. Copy exact planner-injected paths into owned_paths; display titles are not filenames. Never emit both uppercase and lowercase variants.\n      - Emit exactly the current task's owned_paths. Required page outputs apply only to pages in that scope; a manifest-only task may emit pages as an empty list.\n      - AppSchemaOutput.manifest is AppManifest or explicit null. A task owning app.json must emit AppManifest; otherwise emit null, which materializes neither app.json nor provenance.yaml. Do not emit a placeholder manifest or silently discard out-of-scope files.\n      - New-app page_bundle tasks collectively own app.json and every planned page, with one manifest owner. Page-only revisions preserve app.json and unchanged pages from the verified baseline; full-bundle acceptance still requires a complete valid app. Standalone save_app_schema requires a non-null manifest.\n      - provenance.yaml is app-root metadata emitted by the scaffold/generator path. It records creation/refinement/validation lineage and declared contract refs; it must not contain secrets, absolute local paths, or provider execution state.\n      - \"Workflow launches from pages use action_type: workflow.\"\n      - Prefer compact config/shell.json shortcuts for common shell chrome instead of repeating full header/profile/mobile/footer arrays.\n      - Shell shortcuts may target header, profile, mobile, and footer slots using primitive ids such as home, apps, workspace, wallet, create, profile, messages, notifications, signout, signin, legal, terms, cookies, and privacy. Use dashboard only when the app declares a route/page with id dashboard; it is not a built-in shortcut. Do NOT include admin_portal in any shortcuts list \u2014 it is framework-injected automatically for admin users and must not be declared by app config or generated output.\n      - Do not put profile-owned social surfaces such as friends, direct messages, user posts, or activity feed into config/shell.json shortcuts or generated global nav by default. They belong in contracts/profile.yaml tabs unless the product explicitly asks for a separate app-wide discovery route.\n      - Prefer route-level AppPageSchema.navigation for page-owned global/local/profile/footer nav contributions; keep config/shell.json focused on app-wide navigation policy and built-in chrome shortcuts.\n      - Workspace/App Dashboard portal structure belongs in dashboard/dashboard.yaml, not in config/shell.json, ui/route_manifest.json, admin/admin_registry.yaml, or workflows/extended_orchestration/extension_registry.json.\n      - Dashboard manifests may reference workflow_sequence actions, but those sequences must already exist in workflows/extended_orchestration/extension_registry.json.\n      - Use config/shell.json navigation.policy for placement rules such as desktop global=header, desktop local=sidebar, mobile global=bottomBar, mobile local=sheet, and mobile footer=hidden.\n      - Put route chrome intent on AppPageSchema.shell_mode; use config/shell.json chrome only for app-wide mode-policy overrides.\n      - Use layout=full-width for a PageHeader followed by a primary record table. Grid places peer top-level sections in separate columns; it does not stack a heading above a full-width table.\n      - Use shell_mode=conversation for DM/chat/thread routes, workspace for dense module/profile/admin-like work surfaces, focused for setup/review flows, immersive for full-viewport experiences, public for public/legal routes, and standard for ordinary pages.\n      - Use explicit shell arrays only when labels, icons, role gates, or custom paths differ from the shortcut catalog.\n      - Durable page mutations bind through declared api_endpoint values or canonical module actions.\n      - Design documents and ExperienceSpec describe approved product intent, not executable API authority. Replace illustrative endpoint hints with exact /api/modules/{module_id}/{action_id} bindings from planned and generated module contracts; never copy a placeholder URL into task initial_message or page output. Preserve the approved behavior, fields, and layout.\n      - Every data-backed summary needs a declared backend action returning its value_key fields. A ui_only page does not create that action. Plan the owning module contract and business_services implementation before the dependent page task; do not invent an endpoint or replace live counts with constants.\n      - Do not emit raw frontend source outside the bounded custom route bundle.\n      - Pages that require reading URL query params on mount, polling an endpoint until state changes, or rendering conditional sections based on API response value must use custom_route_bundle; they cannot be expressed as declarative AppPageSchema.\n      - A post-redirect confirmation page must not display confirmed/success state from the redirect URL alone. Confirmation must come from querying an app-owned module action after the backend has processed the event.\n      - The api_endpoint field on a page section is a POST path only \u2014 no query strings, fragments, or dynamic path segments. Page-level filters, pagination limits, and record identifiers must go in payload or the module action input schema.\n      - Custom route JSX must call module actions through moduleAction() imported from ui/lib/moduleApi.js. This file is always present in the generated bundle. Do not write raw fetch() calls to /api/modules/** directly in page components.\n      - Custom route error handling must use err.error_code (and err.code) from the caught error object to branch on backend states. The generated moduleApi.js preserves structured error fields on thrown errors. Do not parse raw response text or HTTP status codes to infer error state.\n      - Custom routes that launch LLM-backed or token-metered actions/workflows must detect INSUFFICIENT_TOKENS with isInsufficientTokensError(err), navigate to insufficientTokensRecoveryPath(err), and return without retrying automatically.\n      - Custom routes that call entitlement-gated module actions must detect ENTITLEMENT_REQUIRED with isEntitlementRequiredError(err), navigate to entitlementUpgradePath(err), and return without retrying automatically. Both helpers are exported from ui/lib/moduleApi.js.\n\n  subscription_config:\n    owner_agent: ConfigMiddlewareAgent\n    summary: >\n      Provider-neutral generated-app SaaS subscription/token contract. Present\n      only when SubscriptionContractDesigner emits contract_required=true.\n    required_outputs:\n      - config/subscriptions.yaml\n    optional_outputs: []\n    hard_constraints:\n      - Generate config/subscriptions.yaml only from SubscriptionContractDesigner subscription_config_file.\n      - Schema version must be mozaiks.subscriptions.v1.\n      - Do not emit modules/{pack_name}/contracts/subscriptions.yaml or any module-local subscriptions.yaml.\n      - Do not emit hosted billing admin actions, payment-provider products, price ids, invoices, checkout internals, or settlement logic in this file.\n        - token_wallets live at the config root and are provider-neutral."},{"checksum":"sha256:3f6c052ab95fe04abacc919d64395e1aec9e80a1dba7c8f4b0dc986d843e0873","chunk_id":"chunk_96b3813a219d0eab","end_line":149,"path":"build_context/AppGenerator/file_contracts.yaml","start_line":85,"symbol_ids":[],"text":"        - token_wallets[].depleted_balance declares safe app-local recovery routes for INSUFFICIENT_TOKENS; routes must not be external provider URLs.\n        - top_up_products live at the config root and declare provider-neutral app-owned token packs by product_id, wallet_id, token_amount, and price.amount_cents/currency only.\n        - token_allowances live under plans[] and every wallet_id must reference a declared token_wallet.\n        - assignment_store declares where active app-owned subscription assignments are read by ConfiguredEntitlementAdapter.\n        - Optional usage_charge_policies live at the config root and describe app-level customer charge estimates only; they may use runtime_llm_usage, provider_cost_usd markup, or a fixed token unit price.\n        - Optional pricing_catalog groups are display metadata for public pricing tabs/service selectors only. They may group declared plan_ids and app/provider-owned add_on_ids, but they must not grant capabilities or carry payment-provider price IDs.\n      - Use pricing_catalog when an app sells multiple service lines on one pricing surface, such as platform access, token packs, hosting, domains, marketing, or support.\n      - Generated module actions that require paid access must declare actions[].entitlement_gate with a capability_id granted by at least one plan.\n      - Monetized AI/token apps must expose billing/top-up/usage pages through an app-owned billing_portal facade module; pages must not call hosted or provider internals directly.\n      - Token wallets and token_allowances are only for apps selling AI usage, credits, quotas, token packs, or usage-charge estimates; access-only SaaS plans must omit those fields.\n      - Runtime token usage measurement and token wallet accounting are OSS runtime primitives; generated apps must not create duplicate usage or balance ledgers.\n\n  module_contract:\n    owner_agent: ConfigMiddlewareAgent\n    summary: Canonical module contract bundle that declares module behavior before Python or JS implementation.\n    required_outputs:\n      - modules/{pack_name}/module.yaml\n    optional_outputs:\n      - modules/{pack_name}/contracts/events.yaml\n      - modules/{pack_name}/contracts/reactions.yaml\n      - modules/{pack_name}/contracts/notifications.yaml\n      - modules/{pack_name}/contracts/policy_hooks.yaml\n      - modules/{pack_name}/contracts/settings.yaml\n      - modules/{pack_name}/contracts/admin.yaml\n      - modules/{pack_name}/contracts/profile.yaml\n      - modules/{pack_name}/contracts/relationships.yaml\n      - modules/{pack_name}/runtime_extensions.yaml\n    downstream_backend_defaults:\n      - backend/handler.py\n      - backend/service.py\n      - backend/repo.py\n      - backend/policy.py\n      - backend/schemas.py\n    optional_backend_hooks:\n      - backend/settings.py\n      - backend/notifications.py\n      - backend/admin.py\n    optional_frontend_stubs:\n      - ui/admin/*.jsx\n      - ui/index.js\n    hard_constraints:\n      - module.yaml is always required.\n      - module_contract owned_paths are YAML/declarative contract files only - module.yaml, contracts/*.yaml, and optional runtime_extensions.yaml. Do not include backend/*.py in module_contract tasks; use data_models for backend/schemas.py and business_services for handler.py/service.py/repo.py/policy.py.\n      - Optional request and event properties are not nullable unless their declared type admits null. Service code normalizes documented defaults before writes, preserves omitted fields on partial update, and omits absent optional event keys rather than emitting None. Verify required-only inputs against the event schema as well as fully populated forms.\n      - actions[].input_schema is a closed request contract. Every object level (root, nested objects, array item objects) must declare additionalProperties false, and every accepted request key must be an explicitly declared property. Never emit an open map property such as metadata {type object} in an action input schema - use a closed nested object with declared keys, or an array of closed {key, value} string entries for app-defined annotations. Keep input schemas to closed-profile keywords (type, enum, items, properties, required, additionalProperties); defaults and length limits live in service code. Expected business-rule input rejections raise mozaiksai.core.runtime.ModuleInputValidationError before writes/events, producing INVALID_PARAMS/400. Plain ValueError remains an unexpected execution error.\n      - Emit only files declared by owned_paths or explicit file_manifest.\n      - Omit YAML files that would serialize to empty arrays or null objects.\n      - YAML declares the contract; downstream agents implement Python and JS stubs.\n      - actions[].api_surface is part of the module contract. Use public or public_readonly only for anonymous-safe HTTP actions. Omit it or use null for authenticated UI/API actions. Internal/admin_internal actions reject every HTTP request, including authenticated requests; use them only for event reactions or trusted runtime dispatch, never page bindings.\n      - Public/public_readonly actions are only anonymous entrypoints; they still dispatch with an enforce-mode authority carrying a concrete (possibly empty) permission set and still run actions[].permissions and actions[].entitlement_gate checks.\n      - External HTTP dispatch and internal runtime dispatch are separate paths. Internal event reactions may use api_surface=internal and permissions=[] because the event bus is the authorization boundary; do not mark internal reaction handlers public.\n      - contracts/reactions.yaml target.kind may be handler, capability, notification, or service_adapter. service_adapter targets must declare target.adapter and target.adapter_method, point only to app-owned services/adapters/* support code, and must not be used to bypass facade modules, module state ownership, or managed-provider boundaries.\n      - JS stubs are allowed only for declared customization surfaces.\n      - Emit contracts/profile.yaml only when a module has user-scoped data worth surfacing on the profile page (e.g. account summary, notification preferences, usage stats). Do not emit profile.yaml for every module.\n      - profile.yaml tabs are the default for first-class social/profile sections such as friends, messages, user posts, and activity feed. Do not generate standalone /friends, /messages, /posts, or /feed routes or shell shortcuts for those surfaces by default.\n      - profile.yaml panels and tabs must bind to module actions declared in module.yaml. Actions that need the viewed profile subject must declare an optional user_id input; viewer-scoped actions should use ctx.user_id instead. Do not expose admin-only actions or secrets through profile composition.\n      - Do not emit profile.yaml with kind=form \u2014 that kind is reserved and not yet implemented.\n      - profile.yaml does not replace /api/me identity. Auth identity and core account data remain platform-owned.\n      - Emit contracts/relationships.yaml only when a module can enumerate current-user relationships to its own resources for generic My Apps, Portfolio, or My Resources surfaces.\n      - relationships.yaml providers must bind to module actions declared in module.yaml. Provider actions must return normalized relationship rows with resource_type, resource_id, relationship_type, primary_route, capabilities, status, and metadata as needed.\n      - Do not encode app-specific monetization, payment-provider, ownership-rights, or hosted-product policy in relationships.yaml. Keep it to generic resource relationship discovery.\n      - When an app needs durable user classes, team membership, project collaborators, moderators, participants, invite flows, or resource-scoped route access, emit a membership-style module instead of storing app classes only in auth claims, app.json admins, frontend route metadata, or unrelated resource records.\n      - Membership-style modules own resource-scoped class assignment records. Records should include user_id, resource_type, resource_id, class_id or role, status, created_by, created_at, and updated_at, plus tenant_id/workspace_id when the app uses those scopes.\n      - Membership-style module policy must resolve authority from ctx.user_id, ctx.tenant_id, ctx.workspace_id, ctx.permissions, and module-owned records. Do not trust request body user_id, tenant_id, workspace_id, class, role, or permission fields for authorization.\n      - When membership-style modules need configurable class labels, categories, or default vote/allocation weights, emit those defaults in contracts/settings.yaml. Do not hardcode class defaults in generated Python constants; active membership/policy records still grant rights."},{"checksum":"sha256:73b4eb64810469fdef8f407e7e18e4b5d1e91595be878ab319fb934d741a1d37","chunk_id":"chunk_ce029c9580eb927a","end_line":214,"path":"build_context/AppGenerator/file_contracts.yaml","start_line":150,"symbol_ids":[],"text":"      - Scoped private routes whose visibility depends on membership, ownership, invitation state, tenant/workspace scope, or resource access must declare meta.routeAuth pointing to an app-owned authorize_*_route module action. The action returns a minimal allowed/status/capabilities summary and must not return raw records, secrets, payment provider fields, or ledger data.\n      - Emit contracts/policy_hooks.yaml only when another module, route guard, admin panel, or app-owned process needs to ask this module a generic policy question such as access, classification, or deterministic decision input. Hook providers must point to declared module actions and return allowlisted result shapes.\n      - If class assignments affect vote weights, approval quorum, judging weight, or app-owned allocation logic, expose an app-owned policy hook or evaluator action from the membership/policy module. The consuming feature module owns any decision record, freeze semantics, or frozen process record it requires. Do not make snapshots a generic membership-module product feature.\n      - Do not encode MozaiksPay, wallet, payout, hosted billing, managed hosting, growth campaign returns, investor marketplace policy, ownership-right claims, or hosted product revenue-share rules in generated membership modules. Those are hosted-product or app-specific economics concerns, not OSS user-class primitives.\n      - Emit contracts/notifications.yaml only when one or more declared module events should create user-facing notifications. Notification rules are deterministic event-to-intent mappings consumed by the OSS runtime; generated apps must not create a standalone notifications module, notification persistence repo, or notification websocket worker for ordinary in-app alerts.\n      - Notification rules must use schema_version mozaiks.notifications.v1, stable notification ids, event_type values declared in contracts/events.yaml or canonical domain/platform/hosted/mozaikspay namespaces, controlled channels from [in_app, email, push, sms], and explicit audience roles/permissions, audience.user_id_field for event-payload target users, or a declared module-local resolver hook.\n      - Use channel in_app by default. Add email, push, or sms only when the app plan explicitly requires external delivery and the corresponding operator pack or app-owned provider adapter is available. Do not invent provider delivery internals in module business logic.\n      - Use context_fields only for non-secret identifiers or display context needed by the notification center. Never include token, key, password, credential, payment provider, or idempotency fields.\n      - Persistent modules express collection ownership through data_contract, not ad hoc database files.\n      - backend/repo.py owns persistence operations and must not contain product policy.\n      - backend/schemas.py owns typed DTO/document shapes and pure helpers.\n      - backend/policy.py owns scope query helpers.\n      - backend/policy.py should derive tenant/workspace/user resource filters from ctx.app_id, ctx.tenant_id, ctx.workspace_id, ctx.user_id, and ctx.permissions. Generated modules must not trust request-supplied tenant_id, workspace_id, or user_id params as authorization.\n      - backend/repo.py may use ctx.persistence.collection(module_id, entity_name) for generated module persistence.\n      - For offset pagination, PersistenceCollection.find_many has no skip argument and returns a list, not a cursor. In repo.py use aggregate with an ownership-scoped $match, a stable $sort including a unique tie-breaker, then the requested $skip and a bounded $limit. Validate the declared page/offset inputs and limit before querying; never compute an offset and leave it unused or fetch an unbounded collection for client slicing.\n      - Pagination totals must count the same query as the page, including ownership, search, and all other active filters. Use count(query) with that matching query or a matching aggregate count; do not count unrelated or foreign records.\n      - When literal search is requested, search only the declared fields and use re.escape on user text before placing it in a Mongo $regex. Preserve the requested case behavior. Do not reinterpret literal metacharacters as regex operators or silently escape explicitly requested regex search; explicit regex intent requires its declared validation and bounds.\n      - repo.py must return the actual write result needed by service.py to distinguish an owned mutation from a missing/foreign record, concurrent deletion, or unchanged state. A pre-read or a write call without checking its outcome is not proof of mutation. Emit mutation-success events only after confirmed writes; when no owned mutation happened, do not emit such an event.\n      - A not-found, denied, or idempotent no-op response must follow the declared action contract. Do not invent a global HTTP status or success response for all modules. Keep caller-safe outcomes consistent with the module's authorization boundary and never disclose a foreign record.\n      - backend/repo.py must use module_id/entity_name values aligned with data_contract and data/contract.json.\n      - Generated repo code must not use ctx.db.\n      - Generated repo code must not import or call get_mongo_client().\n      - Generated repo code must not hardcode database names.\n      - Do not emit backend/models.py or backend/models/*.py.\n      - Do not emit backend/database/schema.json or backend/database/seed.json.\n      - Do not put DB access in backend/handler.py.\n      - Do not put raw persistence logic in backend/service.py.\n      - \"list_* action output_schema must declare items.properties explicitly. A bare { type: array } with no items or item properties is invalid for list_* action outputs.\"\n      - backend/service.py must not return raw repo records from list_* methods. Each record must be serialized through a _serialize_{entity}_row or _serialize_{entity}_record allowlist helper declared in backend/schemas.py. The allowlist ensures unknown future DB fields cannot leak into caller responses.\n\n  persistence_contract:\n    owner_agent: DatabaseAgent\n    summary: Canonical generated app persistence intent and migration artifact family.\n    required_outputs:\n      - data/contract.json\n    optional_outputs:\n      - data/migrations/{migration_id}.json\n    downstream_backend_defaults:\n      - modules/{module_id}/backend/repo.py\n      - modules/{module_id}/backend/policy.py\n      - modules/{module_id}/backend/schemas.py\n    hard_constraints:\n      - data_contract is the canonical source of truth for durable generated app collections.\n      - data/contract.json is the exported app artifact for that bundle.\n      - data/migrations/{migration_id}.json is the exported additive migration artifact.\n      - config/data.json is a removed path and must never appear in owned_paths, database_files, code_files, or generated bundle output.\n      - config/data_migrations is a removed path and must never appear in owned_paths, database_files, code_files, or generated bundle output.\n      - data/contract.json is opt-in only. Generate it only when the app plan explicitly needs a canonical app data contract, cross-module aggregate ownership, explicit authority records with stable collection names, explicit aliases, or an external existing database contract that ordinary generated-scoped persistence cannot represent.\n      - Default generated apps must omit data/contract.json and use generated-scoped ctx.persistence.\n      - Data contracts are generic app infrastructure, not hosted-product special cases. Do not emit ad hoc folders or host-internal helper names for normal generated apps.\n      - app/data is declarative only. Do not emit Python helper files under data/ or services/data/.\n      - Cross-surface collection access must be declared before module repo code uses it. Cross-module reads, lifecycle updates, shared aggregate ownership, and documented alias exclusions must be explicit in data/contract.json.\n      - backend/schemas.py replaces backend model files.\n      - backend/repo.py is derived from the data contract and owns persistence operations only.\n      - backend/policy.py owns tenant/app/user scope query helpers.\n      - Generated repo.py must use ctx.persistence.collection(module_id, entity_name) for generated module persistence.\n      - Generated repo.py may use data aliases only when its module/action is explicitly declared in data/contract.json.\n      - module_id/entity_name in repo.py must match data_contract surfaces and collections.\n      - Generated repo.py must not use ctx.db.\n      - Generated repo.py must not import or call get_mongo_client().\n      - Generated repo.py must not hardcode database names.\n      - backend/service.py calls repo.py and must not contain raw persistence logic.\n      - backend/handler.py must not contain persistence logic.\n      - Do not emit backend/models.py.\n      - Do not emit backend/models/*.py."},{"checksum":"sha256:cb4a4d628641ce655098ff669f9a3326d94654d508c65659eb7d54277e426eac","chunk_id":"chunk_15b74b67ba266584","end_line":315,"path":"build_context/AppGenerator/file_contracts.yaml","start_line":215,"symbol_ids":[],"text":"      - Do not emit backend/database/schema.json.\n      - Do not emit backend/database/seed.json.\n      - Do not generate destructive migrations.\n\n  service_foundation:\n    owner_agent: ConfigMiddlewareAgent\n    summary: [REDACTED] service support code for integrations, provider adapters, routes, and names-only secret policy. Paths are app-bundle-relative and assemble under physical app/services/ or app/security/.\n    required_outputs: []\n    optional_outputs:\n      - services/__init__.py\n      - services/config.py\n      - services/integrations/*.py\n      - services/routes/*.py\n      - services/adapters/__init__.py\n      - services/adapters/**/*.py\n      - security/secrets.yaml\n      - task-owned service support files\n    hard_constraints:\n      - Stay within current_build_task.owned_paths.\n      - Emit integration glue or provider adapter support only.\n      - Do not generate a standalone platform or alternate host.\n      - App-owned support code belongs under app-bundle-relative services/integrations/ for external or hosted API clients, services/adapters/ for provider-specific implementation boundaries, and services/routes/ for app-level routes only when needed; physical generated workspaces place these under app/services/.\n      - Optional __init__.py package markers may be empty and must be preserved in services/, services/integrations/, services/routes/, services/adapters/, and services/adapters/{adapter_area}/. They do not authorize other service directories or move module-owned behavior into services.\n      - \"If app-owned runtime secrets are required, emit security/secrets.yaml as a names-only contract validated by mozaiksai.core.secrets.AppSecretContract: [REDACTED] 1 and secrets entries with env (never string entries), optional azure_key_vault.secret_name, and optional provider policy. Unknown fields and raw values are forbidden. Never emit raw secret values.\"\n      - Common services/adapters/ areas include auth, source_control, deployment, dns, registrar, cloud, storage, secrets, and payments when the generated app itself directly owns those provider mechanics rather than consuming a hosted platform capability.\n      - Do not use service_foundation for Mozaiks-hosted deployment, DNS, domain, billing, payment processing, or platform operations. Hosted platform capabilities are consumed through hosted API clients/facade modules and host-owned records; provider adapters stay in the hosted product.\n      - services/adapters/ and services/integrations/ must not own business actions, product lifecycle, user-facing actions, emitted domain events, or persistence authority. Modules own those behaviors.\n      - Do not emit Dockerfile, docker-compose.yml, .env.example, .env.staging.example, .env.production.example, deployment.manifest.json, .github/workflows/*.yml, or other deployment packaging artifacts from service_foundation.\n      - Deployment packaging artifacts are emitted only by the generate_and_download deployment contract renderer through DownloadRequest deployment_profile/include_* fields.\n      - Generated deployment artifacts must follow the provider-neutral deployment contract, must never include real secrets or provider-tenant identifiers, and generated CI workflow secret references must stay names-only through ci_secret_requirements.\n\n  refinement_harness:\n    owner_agent: RefinementHarnessAgent\n    summary: >\n      Optional app-local declarative refinement harness. Use only when\n      the app needs checkpoint/routing/refinement behavior beyond ordinary\n      extension_registry.json transitions and workflow_sequences.\n    required_outputs:\n      - config/refinement_policy.yaml\n      - refinement_harness/config/harness.yaml\n    optional_outputs:\n      - refinement_harness/config/tools.yaml\n      - refinement_harness/config/policies.yaml\n      - refinement_harness/prompts/*.yaml\n    hard_constraints:\n      - Generate this task only when the product explicitly needs a harnessed app lifecycle/refinement/session loop; most apps should omit it.\n      - Do NOT generate module.yaml, handler.py, service.py, repo.py, backend/refinement_harness/*.py, or other module/runtime files.\n      - Do NOT register this surface as a runtime module under app/modules/.\n      - Stay within current_build_task.owned_paths.\n      - config/refinement_policy.yaml is the app-local refinement policy seed. It must carry the shipped runtime contract and must not move ask/chat/workflows startup into harness.yaml.\n      - Default app-local harnesses must extend mozaiks.default_refinement_harness with an empty overrides mapping instead of copying OSS tools, policies, checkpoints, routes, or prompt files.\n      - Emit refinement_harness/config/tools.yaml, refinement_harness/config/policies.yaml, or refinement_harness/prompts/*.yaml only when the app has a real app-specific delta from the default harness.\n      - harness.yaml routes declare workflow_sequence only; do not declare route_to, affected_workflows, affected_declarative_families, requires_replanning, requires_rebuild, or scope_summary.\n      - Every workflow_sequence referenced by harness.yaml must exist in workflows/extended_orchestration/extension_registry.json and declare affected_declarative_families there.\n      - Use shipped mozaiksai.control_plane implementations and tool entrypoints unless a future custom-harness Python contract is explicitly introduced.\n      - Refinement harness artifacts coordinate app-level lifecycle, refinement, or session state only \u2014 no business domain logic.\n      - Do not duplicate host-universal refinement engine behavior already provided by the platform.\n\n  api_surface:\n    owner_agent: ControllerAgent\n    summary: Optional external API adapter lane. Default app behavior uses the platform module API.\n    required_outputs: []\n    optional_outputs:\n      - modules/{pack_name}/backend/api.py\n      - backend/admin_config.py\n      - services/routes/admin.py\n      - services/integrations/{pack_id}_client.py\n    hard_constraints:\n      - Default module access is /api/modules/{module_name}/{action_name}.\n      - Page api_endpoint values must use /api/modules/{module_name}/{action_name} without query strings or fragments. Put pagination limits in page_size and filters in payload/input schemas.\n      - Auth for /api/modules/** is platform-owned. Custom API adapters must not bypass module action auth, permissions, entitlement checks, or module_scope_resolver scope validation.\n      - Emit bespoke REST adapters only when explicitly requested.\n      - Delegate behavior to backend/handler.py instead of duplicating business logic.\n      - Service admin config is a separate contract and must expose only GET /api/admin/config.\n      - For managed-capability adapter tasks (owned_paths under services/integrations/), generate thin client wrappers only \u2014 no provider business logic, no proprietary provider internals in generated files.\n      - Managed capability adapter clients must target the stable API contract supplied by the operator/provider boundary (e.g. POST {APP_BACKEND_URL}/api/modules/{module_id}/{action_id}). Do not embed host-specific secrets or provider credentials in generated files.\n      - Pages must not bind directly to /api/modules/{managed_capability_id}/{action}. When managed-capability data must appear on a persistent page, AppGenerator generates an app-owned fa\u00e7ade module (generated_module) whose service calls the managed capability adapter client. Pages bind to /api/modules/{facade_module_id}/{action} using the standard page\u2192module convention.\n      - Provider implementation adapters that are not managed-capability API clients belong in services/adapters/ through service_foundation, not under modules/ and not in services/integrations/.\n\n\nbackend_helper_files:\n  description: >\n    Rules for backend/{helper_name}.py files generated under app/modules/{module_id}/backend/.\n    Helper files are explicit build outputs \u2014 they must be declared before generation.\n    They are not a catch-all for logic that does not fit canonical layers.\n    App-level support code under services/integrations/ or services/adapters/ is governed by\n    task_contracts.service_foundation or task_contracts.api_surface, not by this module-local\n    helper contract.\n\n  canonical_layers:\n    - backend/base_handler.py  # OSS-generated dispatch base \u2014 regenerated on upgrades, never edited\n    - backend/handler.py       # workspace subclass \u2014 preserved on regen; add app extensions here\n    - backend/service.py       # business logic and event publication\n    - backend/repo.py          # persistence queries and writes\n    - backend/policy.py        # authorization, ownership, transition checks\n    - backend/schemas.py       # typed DTOs, enums, normalization helpers\n\n  workspace_handler_split:\n    description: >\n      Pack templates that support workspace customization generate two handler files.\n      base_handler.py contains the full OSS implementation and is always regenerated."},{"checksum":"sha256:ce0187dcba55640349e78a1fdd599ef96b1418dbfd3d7f25b57d874e4c9a3f90","chunk_id":"chunk_a48fb9da32ae7781","end_line":467,"path":"build_context/AppGenerator/file_contracts.yaml","start_line":316,"symbol_ids":[],"text":"      handler.py is a thin subclass generated once and preserved. Workspaces declare\n      extra params, param overrides, and extra actions in build_context/{pack_id}/extensions.yaml.\n      See factory_app/build_context/AppGenerator/workspace_extensions_contract.yaml for the schema.\n    base_handler_class_suffix: BaseHandler\n    handler_class: \"{ModuleId}Handler\"\n    handler_imports_from: \".base_handler\"\n    regeneration:\n      base_handler.py: always overwrite\n      handler.py: preserve (overwrite only with --force-handlers)\n\n  helper_contract:\n    canonical_location: backend/{helper_name}.py\n    kind: helper\n    generated_by: ServiceAgent\n    required: false\n    allowed_when:\n      - external provider client wrapper for a declared integration\n      - runtime_extensions.yaml api_router entrypoint implementation\n      - runtime_extensions.yaml startup_service entrypoint implementation\n      - module-local adapter or client wrapper for an external service\n      - complex domain helper that would bloat service.py without creating a new canonical layer\n      - integration helper tying two declared capabilities together at the module level\n      - event subscriber startup logic when declared as a startup_service extension\n      - module-local guard wrapper bridging a declared capability into this module's action layer\n    prohibited_for:\n      - generic business logic that belongs in service.py\n      - persistence or database access that belongs in repo.py\n      - authorization or scoping that belongs in policy.py\n      - typed shapes or DTOs that belong in schemas.py\n      - transport or WebSocket infrastructure (use runtime_extensions.yaml startup_service instead)\n      - workflow or agent orchestration logic\n      - arbitrary file splitting to break up long files\n    rules:\n      - must be declared in current_build_task.owned_paths or python_stubs before the business_services task generates it\n      - must be imported by at least one canonical backend layer (handler.py, service.py) or referenced by runtime_extensions.yaml\n      - must be module-local \u2014 no cross-module imports except to managed capability service interfaces\n      - must not create new public module actions or bypass the handler dispatch contract\n      - The build task initial_message must declare it with a short rationale\n      - The module contract output must include it in python_stubs before backend implementation\n      - Backend implementation must not invent helper files that do not appear in python_stubs\n\n  runtime_extension_entrypoints:\n    description: >\n      When runtime_extensions.yaml is declared, each extension type requires an explicit backend file\n      that must be declared in python_stubs. Entrypoints are module-local values such as\n      backend.routes_hooks:get_router or backend.event_worker:MessageDeliveryWorker;\n      never use modules.*, app.modules.*, or mozaiksai.* import paths.\n    api_router:\n      required_stub: backend/{router_file}.py\n      factory_function: get_router\n      note: Must be declared in python_stubs before backend implementation generates it.\n    startup_service:\n      required_stub: backend/{worker_file}.py\n      service_class: \"{ServiceClass}\"\n      note: Must be declared in python_stubs before backend implementation generates it.\n\n  event_pipeline_conventions:\n    description: >\n      Additional contracts that apply when a module uses the event_pipeline archetype\n      (multi-step pipeline driven by event reactions and background pollers).\n    internal_action_contract:\n      api_surface: internal\n      permissions: \"[]  # empty \u2014 event bus is the authorization boundary\"\n      emits: \"must match events declared in this module's contracts/events.yaml\"\n      handler_method: \"must be declared in reactions.yaml target.handler_method\"\n      idempotency: >\n        The service layer must guard against duplicate activation. Check for an\n        existing active record before inserting a new one and return\n        {success: true, skipped: true} rather than an error on duplicates.\n    poller_contract:\n      location: backend/{poller_name}.py\n      entrypoint_format: \"backend.{poller_name}:{ServiceClass}\"\n      required_methods:\n        - \"start() -> None  # sync; creates asyncio task via loop.create_task\"\n        - \"stop() -> None   # sync; cancels task\"\n      db_access: >\n        Must use direct AsyncIOMotorClient(MONGO_URI) \u2014 NOT app_data_from_context.\n        Startup services run outside any module request context.\n      event_emission: >\n        Must emit through the OSS runtime event dispatcher singleton, wrapped in\n        try/except with a warning log on failure. Never let an emit failure crash\n        the poller. Do not inline runtime import paths in prompt-time contracts.\n      adapter_resolution: >\n        Resolve provider adapters lazily inside _poll_once(). Return early when\n        the adapter is not configured. Never crash the process on missing config.\n    stub_adapter_contract:\n      location: app/services/adapters/{area}/stub.py\n      required: true\n      activation: \"env var e.g. SSL_ADAPTER=stub\"\n      purpose: >\n        Enables the full pipeline to run locally and in CI with no external\n        infrastructure. Must implement the same Protocol as the real adapter.\n        May simulate lifecycle progression using in-process state.\n    url_to_hostname_rule: >\n      URL-shaped values (e.g. hosting_url containing https://...) must be parsed\n      to extract the bare hostname before use in DNS records. Never write a URL\n      as a CNAME target. Use urllib.parse.urlparse(url).hostname.\n\n  account_data_handler:\n    canonical_location: backend/account_data_handler.py\n    kind: helper\n    generated_by: ServiceAgent\n    required: true_when_user_data_scope_is_set\n    trigger: module.yaml declares module.user_data_scope=true\n    implements_protocol: AccountDataHandler\n    auto_registered_by: ModuleLoader at startup \u2014 no manual registration required\n    required_methods:\n      - \"async delete_user_data(*, app_id: str, user_id: str) -> dict  # returns {deleted_count: int, ...}\"\n      - \"async export_user_data(*, app_id: str, user_id: str) -> dict  # returns module-namespaced records\"\n    constructor_signature: \"__init__(self, db: Any) -> None  # receives raw Motor database from account registry\"\n    database_contract: >\n      This handler receives a raw Motor database, NOT ModuleContext or\n      PersistenceCollection. Use db[physical_collection_name], find(...).to_list(...),\n      and delete_many(query) when the declared deletion policy permits deletion.\n      Do not call ctx.persistence methods such as find_many on this raw collection,\n      or db.get_collection(module_id, entity_name). Raw database access adds no scope.\n    collection_resolution: >\n      For entities stored by repo.py through ctx.persistence.collection(module_id,\n      entity_name), import collection_name_for from\n      mozaiksai.core.runtime.persistence.naming and resolve\n      db[collection_name_for(app_id=app_id, module_id=module_id, entity_name=entity_name)].\n      Use the exact module_id and entity_name from that repo, not a bare entity name,\n      hand-built physical name, or a scan of database collections. The standard\n      module executor omits app_slug, so omit it here too; do not substitute a\n      display name or app slug. This rule is not universal for literal collections,\n      alias bindings, externally bound storage, or a custom persistence context:\n      follow their existing declared database, physical collection, naming inputs,\n      and ownership contract instead. In every case, both export and deletion must\n      explicitly filter by app_id and the requested user's ownership using the\n      same owner fields as the repo. Physical collection isolation alone is insufficient.\n    export_example: |\n      # For a user_id-owned entity using standard generated-module persistence.\n      # module_id and entity_name must match the existing repo's collection call.\n      from bson import ObjectId\n      from fastapi.encoders import jsonable_encoder\n      from mozaiksai.core.runtime.persistence.naming import collection_name_for\n\n      collection = db[collection_name_for(\n          app_id=app_id, module_id=module_id, entity_name=entity_name,\n      )]\n      query = {\"app_id\": app_id, \"user_id\": user_id}\n      records = await collection.find(query, {\"_id\": 0}).to_list(length=None)\n      if not records:\n          return {}\n      return {f\"{module_id}_{entity_name}\": jsonable_encoder(\n          records, custom_encoder={ObjectId: str},\n      )}\n    hard_constraints:\n      - Must be named AccountDataHandler (the loader discovers it by this name first).\n      - Both methods must scope ALL queries through app_id AND user_id. Never delete or export records across tenants.\n      - delete_user_data must be idempotent \u2014 calling it twice must not raise an error.\n      - export_user_data must return an empty dict (not None or raise) when the user has no records."},{"checksum":"sha256:eec39e4280d4925d9f0cfe961477116945e1795e0fa93094b7c49a3da250767f","chunk_id":"chunk_9c64c2632ae43df2","end_line":483,"path":"build_context/AppGenerator/file_contracts.yaml","start_line":468,"symbol_ids":[],"text":"      - Export payloads must already be JSON-safe because the account route uses JSONResponse directly. Exclude storage _id or convert ObjectId values to strings, and serialize datetimes as ISO 8601 strings, including nested values. Do not return raw Motor documents with BSON values.\n      - For financial/ledger modules (transactional archetype), anonymise rather than delete user_id on ledger entries to preserve audit integrity. Document this in the method docstring.\n      - \"Return key names in export_user_data must be namespaced with the module_id to avoid collisions when the platform merges all module exports (e.g. {\\\"messages_threads\\\": [...], \\\"messages_dms\\\": [...]}).\"\n      - Do not call service.py or handler.py from the handler \u2014 access the db directly for simplicity and to avoid ctx dependencies.\n      - Do not import from other modules. The handler must be self-contained within its module's backend.\n      - The ModuleLoader auto-registers this class; do not call account_data_registry.register() manually in the handler file.\n\n  examples:\n    - backend/provider_client.py   # external provider client wrapper\n    - backend/routes_hooks.py       # api_router entrypoint \u2014 custom inbound route mounting\n    - backend/event_worker.py      # startup_service entrypoint \u2014 background subscriber/worker\n    - backend/notification_client.py # module-local wrapper over a notification capability\n    - backend/audit_subscriber.py    # startup_service entrypoint for audit event handling\n    - backend/verification_poller.py # startup_service \u2014 background DNS/state poller (event_pipeline)\n    - backend/ssl_status_poller.py   # startup_service \u2014 background certificate poller (event_pipeline)\n    - backend/account_data_handler.py # AccountDataHandler \u2014 GDPR delete + export for user-scoped modules"},{"checksum":"sha256:69f5e6f7d35088fb8e03a62ef72d5128f43dd647080bc6450e792cc65933fba4","chunk_id":"chunk_4a9fdec52bc5506b","end_line":167,"path":"build_context/AppGenerator/module_archetypes.yaml","start_line":1,"symbol_ids":[],"text":"version: 1\n\ndescription: >\n  Advisory module archetypes used as prompt-time guidance for keeping module\n  contracts and backend stubs consistent across domains.\n\n  Language-agnostic by design. The backend_stub_defaults field lists canonical\n  backend file names using path conventions. The active dev pack's language profile\n  (e.g. build_context/webapp_builder/language_profile.yaml) is the authoritative\n  source for actual file extensions and language-specific constraints. Archetypes\n  define behavior conventions; the dev pack defines the implementation language.\n\n  Runtime archetypes under `archetypes` must match ModuleIdentity.type exactly.\n  They guide selection of module.type and the behavior conventions that follow\n  from it. Behavior patterns under `behavior_patterns` are advisory capability\n  patterns that map onto a supported canonical module type or capability pack;\n  they must never be serialized as module.type values.\n\nmodule_yaml_schema_notes:\n  description: >\n    module.yaml is validated by a strict Pydantic model (extra=\"forbid\"). Only\n    declared top-level keys are permitted: schema_version, module, permissions,\n    actions, capabilities. Any other top-level key causes a validation error at\n    startup.\n\n  version_changelog_convention: >\n    Do NOT add a top-level changelog: or history: field to module.yaml \u2014 those\n    keys are not declared in ModuleDefinition and will cause an extra_forbidden\n    validation error. Record version promotion notes as YAML block comments\n    immediately before the schema_version line instead:\n\n      # v1.0.0 (2026-07-01): Promoted to stable. Wired settlement reaction.\n      schema_version: mozaiks.module.v1\n\n    This preserves change history in a human-readable form without adding\n    undeclared fields that break module loading.\n\n  version_field: >\n    Bump module.version (a semver string under the module: block) when\n    promoting a module to stable or making a breaking contract change. The\n    value is recorded in startup logs and is the canonical module version the\n    runtime reports. Do not conflate the schema_version (always\n    \"mozaiks.module.v1\") with the module identity version.\n\n# Constraints enforced by ModuleLoader at startup for every archetype.\n# Violations cause a hard ModuleLoadError before the app accepts traffic.\n# List them here once rather than duplicating across every archetype block.\nuniversal_hard_constraints:\n  permission_consistency: >\n    Every permission ID listed in action.permissions[] must be declared in the\n    module-level permissions block. The loader validates this at startup and\n    raises ModuleLoadError on any undeclared reference. Generate all permission\n    IDs that actions reference \u2014 including special scopes such as access_as_user\n    \u2014 as explicit entries in the top-level permissions block before referencing\n    them in any action.\n  notification_id_consistency: >\n    Every reactions.yaml reaction with target.kind=notification must have a\n    target.notification_id that matches an id declared in\n    contracts/notifications.yaml. The loader validates this at startup and\n    raises ModuleLoadError when notification_id is missing or undeclared, and\n    also when a notification reaction exists but contracts/notifications.yaml\n    does not. Generate contracts/notifications.yaml whenever any reaction\n    dispatches to target.kind=notification.\n  user_data_scope_file_required: >\n    When module.yaml declares module.user_data_scope=true, the loader raises\n    ModuleLoadError at startup if backend/account_data_handler.py is absent.\n    Generate backend/account_data_handler.py implementing the AccountDataHandler\n    protocol (delete_user_data + export_user_data) whenever user_data_scope=true\n    is declared. Omit user_data_scope=true for modules that only reference\n    user_id as a foreign key without owning the user's primary records.\n  handler_method_required: >\n    Every action.handler_method value declared in module.yaml must exist as a\n    callable method on the handler class. The loader raises ModuleLoadError for\n    any undeclared or renamed method. Generated handler classes must implement\n    every method listed in module.yaml before the module can load.\n  emits_events_declared: >\n    Every event type listed in action.emits[] must be declared in\n    contracts/events.yaml. The loader raises ModuleLoadError for any undeclared\n    emit reference. backend/service.py must call ctx.emit() only for event types\n    declared in module.yaml emits[] and contracts/events.yaml \u2014 orphaned\n    ctx.emit() calls for events removed from the contract are not caught by the\n    loader and must be covered by module drift-guard tests (see\n    drift_guard_test_guidance below).\n\n# Advisory test-scaffold guidance for AppGenerator. When generating a new\n# module, scaffold tests/test_{module_id}_module_drift.py using these patterns\n# so the app's CI suite catches module contract drift at test time \u2014 before\n# the module is deployed or loaded by the runtime.\ndrift_guard_test_guidance:\n  summary: >\n    Drift-guard test file pattern for generated app modules. Scaffold once per\n    module at generation time. Tests are intentionally lightweight \u2014 they load\n    the module or inspect source, they do not mock business logic or run handler\n    methods. The file should sit in the app-bundle tests/ directory alongside\n    other module tests.\n\n  scaffold_policy:\n    description: >\n      Which patterns to include when generating tests/test_{module_id}_module_drift.py.\n      This is a scaffold policy, not an AppBuildTask.task_type. Until a dedicated\n      production test-scaffold renderer exists, generated test files must be\n      emitted through explicit owned_paths in supported task types or selected\n      capability-pack templates. Pattern selection is conditional on module.yaml\n      content.\n    always_include:\n      - handler_method_alignment\n    include_when_emits_declared:\n      condition: module.yaml declares action.emits[] for at least one action\n      patterns:\n        - emits_service_alignment\n        - events_yaml_service_alignment\n    include_when_user_data_scope:\n      condition: module.yaml declares module.user_data_scope=true\n      patterns:\n        - user_data_scope_handler_completeness\n    app_level_once:\n      description: >\n        App-level tests are scaffolded once per app workspace, not per module.\n        Check whether the file already exists before emitting.\n      include_when_entitlement_gates:\n        condition: >\n          config/subscriptions.yaml exists AND at least one module action\n          declares entitlement_gate across any module in the app\n        output: tests/test_entitlement_gate_coverage.py\n        pattern: entitlement_gate_coverage\n\n  patterns:\n    handler_method_alignment:\n      description: >\n        Load the module via ModuleLoader and assert it succeeds. This triggers\n        the handler_method reflection check at test time, catching any\n        module.yaml/handler.py drift on every CI run rather than only at app\n        startup.\n      template: |\n        def test_{module_id}_handler_methods_align_with_module_yaml(tmp_path):\n            # Verify every module.yaml handler_method exists on the handler class.\n            # ModuleLoader raises ModuleLoadError if any method is missing.\n            loader = ModuleLoader(str(Path(__file__).resolve().parents[1] / \"app\"))\n            loaded = loader.load(\"{module_id}\")\n            declared = {{a.handler_method for a in loaded.definition.actions}}\n            handler_methods = {{m for m in dir(loaded.handler) if not m.startswith(\"_\")}}\n            assert declared <= handler_methods\n    emits_service_alignment:\n      description: >\n        Use the OSS emit_drift utility to AST-scan backend/service.py for\n        ctx.emit() calls with string-literal first arguments and assert each\n        found event type is declared in the module's action.emits[] lists.\n        Catches service.py calling ctx.emit() for events that were never\n        declared or were removed from the contract \u2014 a gap ModuleLoader does\n        not statically enforce. Only literal string arguments are checked;\n        dynamic calls using variables are intentionally ignored (cannot be\n        resolved statically). Import check_orphaned_emits from\n        mozaiksai.\n        core.runtime.app.emit_drift \u2014 available in any app that\n        has the mozaiksai package installed.\n      template: |\n        from pathlib import Path\n        from mozaiksai.\n        core.runtime.app.emit_drift import check_orphaned_emits\n\n        def test_{module_id}_service_emits_match_declared_events():\n            module_dir = (\n                Path(__file__).resolve().parents[1] / \"app\" / \"modules\" / \"{module_id}\"\n            )\n            orphans = check_orphaned_emits(module_dir)\n            assert orphans == [], (\n                f\"backend/service.py calls ctx.emit() for undeclared events: \""},{"checksum":"sha256:f693e07f9eb81cee98f435bf3a7367c879f7ed6cccef16af9a71d857491e3041","chunk_id":"chunk_bf937577f06830ed","end_line":343,"path":"build_context/AppGenerator/module_archetypes.yaml","start_line":168,"symbol_ids":[],"text":"                + \", \".join(f\"{{e!r}} (line {{ln}})\" for e, ln in orphans)\n            )\n    events_yaml_service_alignment:\n      description: >\n        Lane 4 \u2014 contracts/events.yaml \u2194 service.py alignment. Use the OSS\n        emit_drift utility to check that every event type declared in\n        module.yaml action.emits[] (and therefore in contracts/events.yaml,\n        since the loader enforces that subset relationship at startup) has a\n        matching ctx.emit(\"event_type\", ...) string-literal call somewhere in\n        backend/service.py. Catches \"declared but dead\" events \u2014 events added\n        to the contract during design but whose ctx.emit() call was never\n        written, or an emit removed from service.py without cleaning up\n        module.yaml and events.yaml. Import check_missing_emits from\n        mozaiksai.\n        core.runtime.app.emit_drift \u2014 available in any app that\n        has the mozaiksai package installed. Note: only literal string\n        arguments are detected; a declared event emitted only via a dynamic\n        variable will appear as missing \u2014 suppress with a skip marker or\n        convert to a string literal.\n      template: |\n        from pathlib import Path\n        from mozaiksai.\n        core.runtime.app.emit_drift import check_missing_emits\n\n        def test_{module_id}_declared_events_are_emitted():\n            module_dir = (\n                Path(__file__).resolve().parents[1] / \"app\" / \"modules\" / \"{module_id}\"\n            )\n            missing = check_missing_emits(module_dir)\n            assert missing == [], (\n                \"Events declared in module.yaml/events.yaml but never emitted \"\n                \"by backend/service.py: \" + \", \".join(repr(e) for e in missing)\n            )\n    user_data_scope_handler_completeness:\n      description: >\n        When user_data_scope=true, assert backend/account_data_handler.py exists\n        and that AccountDataHandler implements both required methods. The loader\n        enforces file existence as a hard error; this test additionally catches\n        accidental removal of methods from a previously correct implementation.\n      template: |\n        import inspect, yaml\n        from pathlib import Path\n\n        def test_{module_id}_account_data_handler_complete():\n            app_root = Path(__file__).resolve().parents[1] / \"app\"\n            module_dir = app_root / \"modules\" / \"{module_id}\"\n            manifest = yaml.safe_load((module_dir / \"module.yaml\").read_text())\n            if not manifest.get(\"module\", {{}}).get(\"user_data_scope\"):\n                return  # not a user-data-scoped module\n\n            handler_file = module_dir / \"backend\" / \"account_data_handler.py\"\n            assert handler_file.exists(), \"account_data_handler.py must exist when user_data_scope=true\"\n\n            import importlib.util\n            spec = importlib.util.spec_from_file_location(\"adh\", handler_file)\n            mod = importlib.util.module_from_spec(spec)\n            spec.loader.exec_module(mod)\n            cls = getattr(mod, \"AccountDataHandler\", None)\n            assert cls is not None, \"AccountDataHandler class must be defined\"\n            assert callable(getattr(cls, \"delete_user_data\", None)), \"delete_user_data must be implemented\"\n            assert callable(getattr(cls, \"export_user_data\", None)), \"export_user_data must be implemented\"\n\n    entitlement_gate_coverage:\n      description: >\n        Use the OSS entitlement_drift utility to check that every\n        entitlement_gate capability_id declared in module actions is granted\n        by at least one plan in config/subscriptions.yaml.  A gate that\n        references a capability not in any plan causes silent always-deny for\n        non-trusted callers \u2014 the platform startup logs a soft warning, but\n        this test makes it a hard CI failure so the misconfiguration is caught\n        before deploy.  Import check_entitlement_gate_coverage from\n        mozaiksai.\n        core.runtime.app.entitlement_drift.\n      template: |\n        from pathlib import Path\n        from mozaiksai.\n        core.runtime.app.entitlement_drift import check_entitlement_gate_coverage\n\n        def test_entitlement_gates_covered_by_subscription_plan():\n            app_root = Path(__file__).resolve().parents[1] / \"app\"\n            uncovered = check_entitlement_gate_coverage(app_root)\n            assert uncovered == [], (\n                \"Actions gate on capabilities not granted by any plan in subscriptions.yaml:\\n\"\n                + \"\\n\".join(\n                    f\"  {mod}.{action}: '{cap}' not in subscriptions.yaml\"\n                    for mod, action, cap in uncovered\n                )\n            )\n\narchetypes:\n  standard:\n    summary: Default deterministic module for CRUD and ordinary business logic.\n    select_when:\n      - The module owns standard business records and actions.\n      - No real-time messaging semantics are required.\n      - No ledger or named state-machine semantics are required.\n    canonical_yaml_family:\n      always:\n        - module.yaml\n      optional:\n        - events.yaml\n        - reactions.yaml\n        - notifications.yaml\n        - settings.yaml\n        - admin.yaml\n        - profile.yaml\n        - policy_hooks.yaml\n        - relationships.yaml\n    backend_stub_defaults:\n      - backend/handler.py\n      - backend/service.py\n      - backend/repo.py\n      - backend/policy.py\n      - backend/schemas.py\n    hard_constraints:\n      - Keep the handler layer thin \u2014 dispatch only, no business logic.\n      - Put business logic in the service layer, persistence in the repo layer.\n      - Publish only declared domain events.\n      - Use public/public_readonly api_surface only for anonymous-safe read actions. Tenant, workspace, user, mutation, and admin actions require authenticated HTTP dispatch by default.\n      - Build resource scope filters from ctx.app_id, ctx.tenant_id, ctx.workspace_id, ctx.user_id, and ctx.permissions in backend/policy.py rather than trusting request payload scope fields.\n      - list_* service methods must serialize repo records through an allowlist helper defined in backend/schemas.py before returning. Never pass raw repo documents to callers. The allowlist returns only the fields declared in module.yaml output_schema items.properties; unknown or future DB fields are excluded by default.\n      - If the module stores records that include user_id (i.e. it owns user-scoped data), set module.user_data_scope=true in module.yaml and generate backend/account_data_handler.py implementing the AccountDataHandler protocol (delete_user_data + export_user_data). The OSS loader auto-registers the handler at startup. Do not declare user_data_scope=true for modules that only reference user_id as a foreign key without owning the user's primary records (e.g. audit logs that reference but do not belong to the user).\n\n  messaging:\n    summary: Deterministic module for real-time or threaded communication.\n    select_when:\n      - The module owns threads, direct messages, announcements, or read state.\n      - Delivery semantics and participant scoping are core behavior.\n    canonical_yaml_family:\n      always:\n        - module.yaml\n      optional:\n        - events.yaml\n        - reactions.yaml\n        - notifications.yaml\n        - settings.yaml\n        - admin.yaml\n        - profile.yaml\n        - policy_hooks.yaml\n        - relationships.yaml\n    backend_stub_defaults:\n      - backend/handler.py\n      - backend/service.py\n      - backend/repo.py\n      - backend/policy.py\n      - backend/schemas.py\n    hard_constraints:\n      - Message records carry thread_id and sender_id.\n      - Thread records carry participants and per-member read state.\n      - The repo layer provides read-state update helpers.\n      - Event payloads include delivery metadata needed for real-time routing.\n      - Do not emit channels.yaml; messaging metadata belongs in canonical contracts and backend policy helpers.\n      - Messaging modules always own user-scoped data (message content, thread membership, read state). Set module.user_data_scope=true and generate backend/account_data_handler.py. delete_user_data must remove or anonymise the user's message content, DMs, and thread participation records. export_user_data must return all sent messages and thread membership.\n\n  workflow:\n    summary: Deterministic module that manages a named state machine.\n    select_when:\n      - The module owns state transitions, approvals, queues, or lifecycle stages.\n      - Valid transitions and role-aware mutation rules are core behavior.\n    canonical_yaml_family:\n      always:\n        - module.yaml\n      optional:\n        - events.yaml\n        - reactions.yaml\n        - notifications.yaml\n        - settings.yaml\n        - admin.yaml\n        - profile.yaml\n        - policy_hooks.yaml\n        - relationships.yaml\n    backend_stub_defaults:\n      - backend/handler.py\n      - backend/service.py\n      - backend/repo.py\n      - backend/policy.py"},{"checksum":"sha256:b38e0ccfd719bf202889a43cce2689bf71f2d8223ec0254a5dd690e0d2d94359","chunk_id":"chunk_dabd789ba2542cf5","end_line":498,"path":"build_context/AppGenerator/module_archetypes.yaml","start_line":344,"symbol_ids":[],"text":"      - backend/schemas.py\n    hard_constraints:\n      - Managed documents carry a state field.\n      - The policy layer exposes a validate_transition helper.\n      - The service layer enforces transition validation before mutation.\n      - Transition events include from_state and to_state when declared.\n      - If the workflow module's managed documents are owned by a specific user (e.g. user-submitted requests, approvals initiated by a user), set module.user_data_scope=true and generate backend/account_data_handler.py. delete_user_data must delete or anonymise records where user_id matches the deleted user. export_user_data must return all user-initiated workflow records. Omit user_data_scope if the module owns only app-scoped or tenant-scoped state with no direct user_id ownership.\n\n  membership:\n    summary: >\n      Deterministic module for resource-scoped user classes, memberships,\n      invitations, collaborators, moderators, participants, and route access\n      summaries. Use when an app needs durable app-local roles such as teacher,\n      student, seller, buyer, project_owner, collaborator, reviewer, moderator,\n      member, or viewer.\n    select_when:\n      - The app needs resource-scoped user classes, memberships, collaborators,\n        participants, or invite/accept/remove flows.\n      - Access to a route or record depends on a user's relationship to a\n        specific resource, not only on global auth roles or token scopes.\n      - My Apps, Portfolio, My Communities, or My Resources should list\n        resources connected to the current user.\n      - Vote weights, approval quorums, review authority, or other\n        app-owned decision processes need deterministic class/policy inputs.\n    canonical_yaml_family:\n      always:\n        - module.yaml\n      optional:\n        - contracts/events.yaml\n        - contracts/reactions.yaml\n        - contracts/notifications.yaml\n        - contracts/policy_hooks.yaml\n        - contracts/settings.yaml\n        - contracts/admin.yaml\n        - contracts/profile.yaml\n        - contracts/relationships.yaml\n    backend_stub_defaults:\n      - backend/handler.py\n      - backend/service.py\n      - backend/repo.py\n      - backend/policy.py\n      - backend/schemas.py\n      - backend/account_data_handler.py\n    key_actions:\n      - invite_member: >\n          Create a pending invitation for a resource-scoped user class. The\n          actor must be authorized through ctx.user_id, ctx.tenant_id,\n          ctx.workspace_id, ctx.permissions, and existing module-owned\n          membership records.\n      - accept_invitation: >\n          Accept the current user's pending invitation and create or activate\n          a membership assignment. The service must ignore any request-body\n          user_id that conflicts with ctx.user_id.\n      - update_member_class: >\n          Change a member's class or status for a scoped resource. Only\n          authorized owners/admins/managers for that resource may call it.\n      - list_members: >\n          List members for an authorized resource using serialized allowlist\n          rows. Never return raw membership records.\n      - get_my_membership: >\n          Return the current user's active membership summary for a resource.\n      - authorize_resource_route: >\n          Return a minimal route authorization summary with allowed,\n          resource_type, resource_id, viewer_class, status, capabilities, and\n          safe display metadata only.\n      - list_user_relationships: >\n          Return current-user resource relationship rows for\n          contracts/relationships.yaml hydration.\n      - evaluate_policy_hook: >\n          Return an allowlisted deterministic policy result for app-owned\n          access, classification, or decision-input requests declared in\n          contracts/policy_hooks.yaml. The response must not expose raw\n          membership records, secrets, payment data, or ledger rows.\n    hard_constraints:\n      - Auth identity and /api/me remain platform-owned. Do not create a\n        replacement account/profile/user table to identify the signed-in user.\n      - Durable app-specific classes are module-owned records scoped to\n        resource_type/resource_id plus app/tenant/workspace context; they are\n        not only JWT roles or frontend state.\n      - backend/policy.py must derive access from ctx.user_id, ctx.tenant_id,\n        ctx.workspace_id, ctx.permissions, and module-owned membership records.\n        Do not trust request payload user_id, tenant_id, workspace_id, class,\n        role, or permission fields as authorization truth.\n      - Membership assignment records should include user_id, resource_type,\n        resource_id, class_id or role, status, created_by, created_at, and\n        updated_at. Include tenant_id/workspace_id when the app uses those\n        scopes.\n      - Set module.user_data_scope=true when the module owns membership or\n        invitation records for users, and generate backend/account_data_handler.py.\n        Delete/export behavior must be tenant/app scoped and documented.\n      - Use contracts/relationships.yaml when the module can enumerate\n        current-user resources. Provider actions must return normalized\n        relationship rows only; relationship rows are routing inventory and\n        never grant rights by themselves.\n      - Private scoped routes must use meta.routeAuth pointing to an\n        app-owned authorize_*_route action. Do not rely on frontend-only\n        checks or global shell role strings for resource-scoped access.\n      - contracts/profile.yaml is optional and only for personal account\n        panels backed by user-scoped module data. It does not replace /api/me\n        identity or resource administration surfaces.\n      - Use contracts/policy_hooks.yaml only when another module, route guard,\n        admin panel, or app-owned process needs to ask this module a generic\n        policy question. Hook actions return allowlisted eligibility,\n        class/relationship, capability, or decision-input values; consuming\n        modules own any decision records or freeze semantics they require.\n      - If the app needs configurable class labels, categories, or default\n        voting/allocation weights, put that class catalog in\n        contracts/settings.yaml. Do not hardcode class defaults in generated\n        Python constants; active membership/policy records still grant rights.\n      - This archetype is host-agnostic. Do not include MozaiksPay, wallet,\n        payout, hosted billing, managed hosting, growth campaign returns,\n        investor marketplace policy, ownership-right claims, or hosted product\n        revenue-share logic in generated membership modules.\n\n  event_pipeline:\n    summary: >\n      Deterministic module that drives an automated multi-step pipeline through\n      event reactions and background polling. Use when a customer action starts a\n      chain that spans multiple modules (e.g. domain verification \u2192 DNS \u2192 SSL \u2192 live),\n      each step triggered automatically by the previous step's event rather than by\n      human operators or manual action calls.\n    select_when:\n      - The module owns a multi-step lifecycle where each step emits an event that\n        triggers the next step in a different module.\n      - Background polling is needed to detect external state changes (DNS propagation,\n        certificate issuance, payment confirmation) and advance the pipeline.\n      - Steps must be idempotent and the pipeline must degrade gracefully when\n        provider adapters are not configured.\n    canonical_yaml_family:\n      always:\n        - module.yaml\n        - contracts/events.yaml\n        - contracts/reactions.yaml\n      optional:\n        - runtime_extensions.yaml   # startup_service for background poller\n        - notifications.yaml\n        - settings.yaml\n    backend_stub_defaults:\n      - backend/handler.py\n      - backend/service.py\n      - backend/repo.py\n      - backend/policy.py\n      - backend/schemas.py\n      - backend/{poller_name}.py   # startup_service entrypoint for background polling\n    hard_constraints:\n      - Each pipeline step is an internal module action with api_surface=internal and permissions=[].\n        The event bus is the authorization boundary; no user permission is required.\n      - Internal actions must be idempotent \u2014 the service layer guards against duplicate\n        activation requests, double-provisioning, and repeated state transitions.\n      - reactions.yaml wires each cross-module event to a handler_method; never call\n        a foreign module's service directly from business logic.\n      - Background pollers use direct motor connection (AsyncIOMotorClient) because they\n        run outside any module request context and cannot use app_data_from_context.\n        Event emission uses the OSS dispatcher singleton (get_event_dispatcher().emit).\n      - Provider adapters are resolved lazily and return None when not configured."},{"checksum":"sha256:044f49cfe2fc57365001bf91a8162e6f1a1d74246b55541a225e9faef0673ff0","chunk_id":"chunk_65b6b621d7e3c832","end_line":655,"path":"build_context/AppGenerator/module_archetypes.yaml","start_line":499,"symbol_ids":[],"text":"        The poller and service must return early gracefully rather than crashing.\n      - A stub adapter must accompany every real provider adapter so the pipeline\n        can run locally and in CI without external infrastructure.\n      - URL-shaped values (e.g. hosting_url) must be parsed to extract the hostname\n        before use in DNS records. Never write a URL as a CNAME target.\n      - emits declarations in module.yaml must match events declared in contracts/events.yaml.\n        Cross-module events subscribed to in reactions.yaml are declared by the producing module.\n\n  transactional:\n    summary: Deterministic module for balances, ledgers, audit trails, or append-only value tracking.\n    select_when:\n      - The module owns balances, transfers, credits, debits, or double-entry semantics.\n      - Append-only or audit-heavy writes are required.\n    canonical_yaml_family:\n      always:\n        - module.yaml\n      optional:\n        - events.yaml\n        - reactions.yaml\n        - notifications.yaml\n        - settings.yaml\n        - admin.yaml\n        - profile.yaml\n        - policy_hooks.yaml\n        - relationships.yaml\n    backend_stub_defaults:\n      - backend/handler.py\n      - backend/service.py\n      - backend/repo.py\n      - backend/policy.py\n      - backend/schemas.py\n    hard_constraints:\n      - State is derived from an append-only ledger.\n      - The repo layer provides append_entry style writes instead of update_balance shortcuts.\n      - Multi-document writes use atomic operations.\n      - The schemas layer separates balance projections from ledger entries.\n      - If ledger entries carry user_id (e.g. a per-user token wallet or user balance ledger), set module.user_data_scope=[REDACTED] and generate backend/account_data_handler.py. export_user_data must return the user's ledger entries and current balance projection. delete_user_data should anonymise the user_id field on ledger entries rather than deleting them (preserving financial audit integrity) \u2014 document this choice in the handler's docstring. Omit user_data_scope for purely app-scoped or tenant-scoped ledgers with no user_id ownership.\n\n  billing:\n    summary: >\n      Deterministic module that gates features behind subscription plans, reacts\n      to managed billing lifecycle events or fulfillment commands, and exposes\n      self-serve upgrade/cancellation surfaces. Use when an app monetizes\n      through subscriptions, pay-per-use, or one-time purchases and needs\n      entitlement enforcement at the action level.\n    select_when:\n      - The module owns app-facing plan status, entitlement presentation, or checkout session facade actions.\n      - Actions must be gated by entitlement_gate declarations tied to plan capabilities.\n      - The module reacts to hosted billing lifecycle events or BillingFulfillmentCommand inputs\n        to update app-facing subscription state.\n      - Usage metering or token allowance sync is required on plan activation.\n    canonical_yaml_family:\n      always:\n        - module.yaml\n        - contracts/events.yaml\n        - contracts/reactions.yaml\n      optional:\n        - notifications.yaml\n        - settings.yaml\n        - admin.yaml\n    backend_stub_defaults:\n      - backend/handler.py\n      - backend/service.py\n      - backend/repo.py\n      - backend/policy.py\n      - backend/schemas.py\n    hard_constraints:\n      - Every plan-gated module action must declare entitlement_gate in module.yaml\n        referencing a capability_id from config/subscriptions.yaml.\n      - Include a public_readonly get_plans action (no permissions, no entitlement_gate)\n        that reads config/subscriptions.yaml using the OSS load_subscriptions_config\n        runtime utility and returns the plan catalog with labels, capability ids, and\n        usage limits. This is the canonical data source for the /pricing page \u2014 never\n        hardcode plan data in JSX or page schemas, always derive from subscriptions config.\n        It must return only catalog data, never tenant/workspace subscription assignment\n        records, invoices, payment secrets, or customer identity data.\n      - The service layer never checks entitlements itself \u2014 entitlement_gate on\n        the action declaration is the authorization boundary.\n      - Subscription state transitions are driven by hosted billing lifecycle\n        events or BillingFulfillmentCommand inputs reacted to via reactions.yaml,\n        not by direct payment provider webhooks or operator calls.\n      - Usage meters (token_wallets, usage_limits) are synced from the plan\n        snapshot captured at subscription activation time, not derived live.\n      - The schemas layer exposes plan_snapshot, catalog_id, and catalog_version\n        fields on subscription records for downstream audit traceability.\n      - Emit hosted.* namespaced events for platform subscription lifecycle;\n        emit domain.* events for app-level entitlement changes that other modules react to.\n      - Generated OSS app modules must not own payment provider webhook receivers,\n        payment provider SDK imports, customer/payment-provider mappings, refunds,\n        wallet ledgers, payouts, or provider credential handling.\n      - Checkout session facade records are append-only; never mutate a completed session.\n      - Cancellation or plan-update facade flows must emit events that downstream\n        entitlement and token-metered modules can react to independently.\n      - >\n        Any module that writes time-bounded pending records (checkout sessions,\n        reservations, invitations, etc.) must include a background expiry watcher\n        declared as a startup_service in runtime_extensions.yaml. The watcher runs\n        on a fixed interval (recommended: hourly), calls a service-layer\n        expire_stale_<records> method, and emits a <record>.expired domain event\n        per expired record. The service method must be exposed as an internal\n        module action (api_surface: internal) so operators can trigger it manually\n        and tests can exercise it without spawning the startup service. The watcher\n        uses a direct Motor connection (AsyncIOMotorClient via MONGO_URI /\n        MONGO_DB_NAME) because it runs outside any module request context.\n\n  entitlement_dispatch:\n    summary: >\n      Self-hosted entitlement dispatch module. Writes subscription assignment\n      records to the collection declared in config/subscriptions.yaml\n      assignment_store so that ConfiguredEntitlementAdapter can grant or deny\n      capability access at module action dispatch time. Use in self-hosted OSS\n      apps that manage their own subscriptions without the mozaiks-app hosted\n      entitlement service.\n    select_when:\n      - App declares config/subscriptions.yaml with at least one plan that grants capabilities.\n      - App is self-hosted (not deployed on the mozaiks-app hosted platform).\n      - App needs to activate or deactivate capability grants when subscription events arrive.\n      - App integrates with an external payment provider that emits normalized domain events.\n    canonical_yaml_family:\n      always:\n        - module.yaml\n        - contracts/events.yaml\n        - contracts/reactions.yaml\n      optional:\n        - notifications.yaml\n        - admin.yaml\n    backend_stub_defaults:\n      - backend/handler.py\n      - backend/service.py\n      - backend/repo.py\n      - backend/policy.py\n      - backend/schemas.py\n    key_actions:\n      - activate_subscription: >\n          Writes a grant record to the assignment_store collection with\n          plan_id, granted_capabilities (copied from the plan snapshot in\n          config/subscriptions.yaml), status=active, and optional expires_at.\n          Input: { user_id, plan_id, granted_at?, expires_at? }.\n      - deactivate_subscription: >\n          Updates the assignment record status to cancelled or expired.\n          Input: { user_id, reason }.\n      - get_entitlement_status: >\n          Read-only status check safe to expose to authenticated UI callers.\n          Returns current plan_id, status, and granted_capabilities for the\n          requesting user. No entitlement_gate \u2014 this action is itself free.\n    assignment_store_convention: >\n      The module repo writes to the collection declared in\n      config/subscriptions.yaml assignment_store.data_alias. The record schema\n      must include fields that ConfiguredEntitlementAdapter expects:\n        app_id, user_id (or tenant_id/workspace_id for non-user-scoped grants),\n        plan_id, granted_capabilities (list of capability_id strings or\n        { pack_id, capability_id } dicts), status (must be one of the\n        active_statuses declared in assignment_store), expires_at (ISO-8601 or null).\n      Use ctx.persistence.collection(assignment_store_alias) in backend/repo.py.\n      Do not hard-code the collection name \u2014 read it from the loaded subscriptions\n      config at startup or pass it from the service layer.\n    hard_constraints:"},{"checksum":"sha256:b44fd2ac0f4c75e0d46eb454a1cfa055542cd3b6d89ac1251b2b80e1b11fac57","chunk_id":"chunk_ec804be64acc1b50","end_line":825,"path":"build_context/AppGenerator/module_archetypes.yaml","start_line":656,"symbol_ids":[],"text":"      - This archetype is for self-hosted apps only. Apps on the mozaiks-app\n        hosted platform must not instantiate this module; the hosted entitlement\n        service manages grants for hosted apps and is the authoritative source.\n      - Do not call Stripe, MozaiksPay, or any payment provider from this module.\n        Payment events are provider-specific. This module receives normalized\n        domain events only (e.g. subscription.activated, subscription.cancelled)\n        and reacts to them via contracts/reactions.yaml. The payment-event adapter\n        lives in services/adapters/payments/{provider}.py.\n      - The service layer must be idempotent \u2014 duplicate activation events for\n        the same user/plan must not create duplicate grant records.\n      - activate_subscription must snapshot the plan's capability_ids from\n        config/subscriptions.yaml at activation time and store the snapshot.\n        ConfiguredEntitlementAdapter may use the snapshot rather than re-reading\n        the catalog at check time (see plan_snapshot field behavior in entitlements.py).\n      - Never emit or handle direct payment provider webhook events (Stripe, etc.).\n        Those belong in services/adapters/payments/{provider}.py and are normalized\n        before reaching this module.\n      - get_entitlement_status is the only action whose result is safe to return\n        directly to the UI. activate_subscription and deactivate_subscription are\n        internal actions (api_surface=internal) triggered via reactions.yaml.\n\nbehavior_patterns:\n  state_machine:\n    canonical_module_type: workflow\n    summary: >\n      Deterministic lifecycle pattern for modules that own records with a named\n      status field driven by time-based transitions (e.g. pending -> active ->\n      expired) or explicit operator/system triggers. Use when records progress\n      through a lifecycle that includes at least one timestamp-gated automatic\n      transition and requires an audit trail of every status change.\n    select_when:\n      - The module owns records with a status field that advances based on\n        publish_at, expire_at, end_at, activate_at, or similar timestamps.\n      - Status transitions must happen automatically without human operator action.\n      - Records require an audit trail of every status change and who/what triggered it.\n      - The transition logic is too heavy or operationally distinct to run inline\n        in a request handler.\n    canonical_yaml_family:\n      always:\n        - module.yaml\n        - contracts/events.yaml\n      optional:\n        - contracts/reactions.yaml\n        - contracts/notifications.yaml\n        - contracts/admin.yaml\n        - contracts/settings.yaml\n        - runtime_extensions.yaml\n    backend_stub_defaults:\n      - backend/handler.py\n      - backend/service.py\n      - backend/repo.py\n      - backend/schemas.py\n    hard_constraints:\n      - >\n        Set module.type to the supported canonical value `workflow`; do not\n        serialize `state_machine` as module.type.\n      - >\n        Expose a run_<entity>_lifecycle_tick(ctx) method on the service layer.\n        This is the canonical tick: it scans for records with pending\n        timestamp-gated transitions, advances their status, emits a domain event\n        per transition, and returns a summary dict with { published_count,\n        expired_count, errors } or equivalent keys. The method must be\n        idempotent and safe to call frequently.\n      - >\n        Declare the tick as an internal module action (api_surface: internal,\n        permissions: []) in module.yaml so operators can trigger it manually and\n        tests can exercise it without a scheduler. Name it\n        run_<entity>_lifecycle_tick consistently.\n      - >\n        Every status transition must emit a named domain event\n        (e.g. domain.<module>.status_changed) and record an audit entry with the\n        previous status, new status, timestamp, and trigger source.\n      - >\n        The repo layer must expose indexed query methods named\n        find_pending_<transition>(now) that filter by status and timestamp field\n        (e.g. publish_at <= now). Index both fields; never do a collection scan\n        inside the tick.\n      - >\n        Choose the right tick delivery mechanism based on scale and isolation:\n        use startup_service for lightweight in-process sweeps, or emit an\n        external cron script (scripts/cron_<entity>_lifecycle.py) when the tick\n        needs independent resource limits, restart behavior, logs, metrics, or\n        scheduled-job infrastructure.\n      - >\n        External cron entry points must use the _MinimalCtx pattern: a lightweight\n        context stub with an async emit() method that captures emitted events\n        without dispatching them to the live event bus. The script connects via\n        get_mongo_client(), calls the service tick, and exits with a non-zero\n        code on errors. Required env vars must be documented in the script\n        module docstring.\n      - >\n        Provider-specific scheduled jobs belong to the operator or hosted deployment\n        adapter, outside the authentication scaffold or generated app bundle. Do not call the\n        tick from a user-facing request handler.\n\n  file_storage:\n    canonical_module_type: standard\n    source_pack: files\n    summary: >\n      Metadata-only file storage pattern. Stores file records (filename,\n      mime_type, size_bytes, storage_url, is_public, created_by) in MongoDB;\n      actual blobs are stored externally via services/adapters/storage/{provider}.py.\n      Prefer the active `files` capability pack when selected.\n    select_when:\n      - App needs file upload, media storage, or document management.\n      - Users upload images, documents, or attachments.\n      - App stores user-generated files, photos, or media assets.\n    canonical_yaml_family:\n      always:\n        - module.yaml\n        - contracts/events.yaml\n      optional:\n        - contracts/notifications.yaml\n        - contracts/admin.yaml\n    backend_stub_defaults:\n      - backend/handler.py\n      - backend/service.py\n      - backend/repo.py\n      - backend/policy.py\n      - backend/schemas.py\n      - backend/account_data_handler.py\n    hard_constraints:\n      - Set module.type to `standard`; do not serialize `file_storage` as module.type.\n      - Prefer selecting the `files` capability pack, whose templates own the\n        canonical files module.\n      - The module must be named `files`, not `file_storage`, `media`, or `documents`.\n      - Do not import cloud storage SDKs in module backend files. Cloud SDK calls\n        belong in services/adapters/storage/.\n      - Set module.user_data_scope=true and generate backend/account_data_handler.py.\n      - The storage_url field must be accepted from input; the adapter provides it.\n      - Use ctx.persistence.collection(\"files\", \"records\") in repo.py; do not use\n        ctx.db or raw Motor client imports.\n\n  notification_preferences:\n    canonical_module_type: standard\n    source_pack: notifications\n    summary: >\n      User notification preference pattern. Stores per-channel opt-in preferences\n      per user. It does not own ordinary runtime in-app notifications; external\n      delivery adapters live in services/adapters/notifications/. Prefer the\n      active `notifications` capability pack when selected.\n    select_when:\n      - notifications capability pack is selected for external delivery.\n      - App needs to let users opt in or out of email, push, or SMS notifications.\n      - App must track per-user delivery channel preferences for external notifications.\n    canonical_yaml_family:\n      always:\n        - module.yaml\n        - contracts/reactions.yaml\n      optional:\n        - contracts/admin.yaml\n    backend_stub_defaults:\n      - backend/handler.py\n      - backend/service.py\n      - backend/repo.py\n      - backend/schemas.py\n      - backend/account_data_handler.py\n    hard_constraints:\n      - Set module.type to `standard`; do not serialize `notification_preferences`\n        as module.type.\n      - Prefer selecting the `notifications` capability pack, whose templates own\n        the canonical notification_settings module and provider-neutral adapters.\n      - The module must be named `notification_settings`, not `notifications`.\n      - Do not re-implement in-app notification storage or websocket delivery.\n      - Do not add entitlement_gate to get_notification_preferences or\n        update_notification_preferences.\n      - Set module.user_data_scope=true and generate backend/account_data_handler.py.\n      - External delivery mechanics belong in services/adapters/notifications/.\n\n"},{"checksum":"sha256:e7bc5f761149ff9f4d427da3d39407485dce76924bdb56ba9e750b54f1645e72","chunk_id":"chunk_fc48aaf87fef844a","end_line":147,"path":"build_context/AppGenerator/shell_presets.yaml","start_line":1,"symbol_ids":[],"text":"version: 1\ndescription: >\n  Prompt-time shell preset catalog for AppGenerator. Presets are app-wide\n  chrome and navigation priors. They compile into AppBuildPlan\n  shell_preset_hint, AppPageSchema.navigation, AppPageSchema.shell_mode, and\n  optional shell_config. Runtime never loads this file.\ndefaults:\n  fallback_preset: product_app\npresets:\n  product_app:\n    description: Standard logged-in product with a few durable destinations.\n    select_when:\n    - Most customer-facing SaaS or product apps.\n    - Global navigation has three to five primary destinations.\n    shell_policy:\n      desktop:\n        global: header\n        local: sidebar\n        footer: visible\n      mobile:\n        global: bottomBar\n        local: sheet\n        footer: hidden\n      maxMobileItems: 5\n      autoFromPages: false\n    chrome_default: standard\n    page_guidance:\n      primary_modes:\n        default: standard\n        settings: workspace\n        setup: focused\n      navigation_scopes:\n        primary: global\n        settings: profile\n        legal: footer\n  workspace_studio:\n    description: Dense multi-resource management surface with persistent side navigation.\n    select_when:\n    - Internal tools, admin portals, CRMs, operations centers, or workspace managers.\n    - Users repeatedly switch between resource lists, settings, and operational views.\n    shell_policy:\n      desktop:\n        global: header\n        local: sidebar\n        footer: hidden\n      mobile:\n        global: bottomBar\n        local: sheet\n        footer: hidden\n      maxMobileItems: 5\n      autoFromPages: false\n    chrome_default: workspace\n    page_guidance:\n      primary_modes:\n        default: workspace\n        detail: workspace\n        setup: focused\n      navigation_scopes:\n        primary: global\n        subsection: local\n        settings: profile\n  public_plus_app:\n    description: Public routes plus authenticated product routes.\n    select_when:\n    - The app needs marketing, pricing, docs, or legal pages plus a logged-in product area.\n    - Public pages should keep public chrome while authenticated pages use product chrome.\n    shell_policy:\n      desktop:\n        global: header\n        local: sidebar\n        footer: visible\n      mobile:\n        global: bottomBar\n        local: sheet\n        footer: hidden\n      maxMobileItems: 5\n      autoFromPages: false\n    chrome_default: standard\n    page_guidance:\n      primary_modes:\n        public: public\n        app: standard\n        onboarding: focused\n      navigation_scopes:\n        public_primary: global\n        app_primary: global\n        legal: footer\n  conversation_app:\n    description: Chat, inbox, support, or collaboration-heavy product.\n    select_when:\n    - Primary UX is message threads, live chat, an inbox, or realtime collaboration.\n    - The conversation surface needs to own the lower viewport edge.\n    shell_policy:\n      desktop:\n        global: header\n        local: sidebar\n        footer: hidden\n      mobile:\n        global: bottomBar\n        local: sheet\n        footer: hidden\n      maxMobileItems: 5\n      autoFromPages: false\n    chrome_default: standard\n    page_guidance:\n      primary_modes:\n        inbox: workspace\n        thread: conversation\n        settings: workspace\n      navigation_scopes:\n        inbox: global\n        thread: local\n        settings: profile\n  flow_app:\n    description: Guided flow, onboarding, checkout, review, or approval product.\n    select_when:\n    - Primary UX is a sequential setup, submission, review, approval, or checkout flow.\n    - The user should complete focused steps before entering a normal product area.\n    shell_policy:\n      desktop:\n        global: header\n        local: sidebar\n        footer: hidden\n      mobile:\n        global: bottomBar\n        local: sheet\n        footer: hidden\n      maxMobileItems: 5\n      autoFromPages: false\n    chrome_default: focused\n    page_guidance:\n      primary_modes:\n        flow: focused\n        summary: standard\n        settings: workspace\n      navigation_scopes:\n        flow: direct-link only\n        summary: global\n        settings: profile\nrules:\n- Presets are prompt-time guidance only, not runtime artifacts.\n- Select at most one shell_preset_hint unless the app clearly combines public and authenticated zones.\n- Do not emit preset ids into generated runtime files.\n- Compile the selected preset into normal AppPageSchema.navigation, AppPageSchema.shell_mode, and optional shell_config.\n- Keep shell_config null when the selected preset matches platform defaults.\n- Do not use presets to create extra shell buttons. Header actions still require explicit user/product intent.\n- If a header action changes by workflow/app context, use semantic action variants with bounded when fields; do not generate path-prefix or query-param override rules."},{"checksum":"sha256:a06e06668d043e517031a7a6a67c754df3146e20efb41df69ddeec66997943ae","chunk_id":"chunk_99f3154a82701775","end_line":132,"path":"build_context/AppGenerator/templates/ai-subprocessors.md","start_line":1,"symbol_ids":[],"text":"# AI Subprocessors and Data Use Disclosure\n\n<!-- TODO: Replace all [PLACEHOLDER] values before publishing this document. -->\n<!-- This file was scaffolded by Mozaiks AppGenerator because your app uses    -->\n<!-- AI-powered features. You must complete and review it before launch.        -->\n\n**Last updated:** [DATE]  \n**App name:** [APP_NAME]  \n**App operator:** [COMPANY_NAME]\n\n---\n\n## Overview\n\n[APP_NAME] uses AI-powered features to provide [BRIEF_DESCRIPTION_OF_AI_FEATURES].\nThese features are powered by one or more third-party AI subprocessors listed below.\nThis document describes what data each subprocessor receives, how long they retain it,\nand your rights as a user.\n\n---\n\n## AI Subprocessors\n\n| Subprocessor | Purpose | Data sent | Trains on user data? | Retention |\n|---|---|---|---|---|\n| [PROVIDER_NAME] | [PURPOSE] | [DATA_TYPES, e.g. \"message text, user role\"] | [Yes / No \u2014 link to provider policy] | [RETENTION_PERIOD, e.g. \"30 days\"] |\n\n<!-- Add one row per AI provider your app sends user data to.          -->\n<!-- Typical providers include LLM API providers (OpenAI, Anthropic,   -->\n<!-- Cohere, etc.), embedding services, and speech/image providers.    -->\n<!-- Check each provider's data processing agreement (DPA) for        -->\n<!-- accurate retention and training-opt-out information.              -->\n\n---\n\n## What Data Is Sent to AI Subprocessors\n\nWhen you use AI-powered features, the following types of data may be transmitted\nto the subprocessors listed above:\n\n- [DATA_TYPE_1, e.g. \"Your submitted text or messages\"]\n- [DATA_TYPE_2, e.g. \"File or document content you choose to share\"]\n- [DATA_TYPE_3, e.g. \"Your account role (e.g. admin, member) used for context\"]\n\nThe following data is **never** sent to AI subprocessors:\n\n- [EXCLUDED_DATA_1, e.g. \"Payment card or financial account details\"]\n- [EXCLUDED_DATA_2, e.g. \"Passwords or authentication tokens\"]\n- [EXCLUDED_DATA_3 \u2014 list any data categories you explicitly exclude]\n\n---\n\n## Model Training\n\n<!-- Review each provider's current DPA. Policies change.             -->\n<!-- Do not leave this section blank \u2014 regulators and users will ask. -->\n\n[APP_NAME] [does / does not] share data with subprocessors that use it for model\ntraining. Specifically:\n\n- **[PROVIDER_NAME]:** [Does / Does not] use submitted data to train models.\n  [Optional: You can opt out by [OPT_OUT_MECHANISM] or by contacting [CONTACT].]\n\n---\n\n## User Rights\n\nUnder GDPR, CCPA, and similar regulations you have the right to:\n\n- **Access** the personal data we hold about you.\n- **Delete** your account and associated data, including data sent to AI subprocessors\n  where the provider's retention window allows deletion on request.\n- **Object** to AI-powered processing. You may [DESCRIBE_OPT_OUT_PATH, e.g.\n  \"disable AI features in your account settings under Settings \u2192 AI Features\"].\n- **Port** a copy of your data in a machine-readable format.\n\nTo exercise any of these rights, contact us at [DATA_RIGHTS_EMAIL_OR_FORM_URL].\n\nWe will respond within [RESPONSE_TIMEFRAME, e.g. \"30 days\"] in line with\napplicable law.\n\n---\n\n## Consent and Notice\n\n<!-- Describe when and how users are informed that AI features process  -->\n<!-- their data. This may be at signup, at first AI feature use, or    -->\n<!-- through a banner/modal. Choose what applies to your app.          -->\n\nUsers are informed of AI data processing at [POINT_OF_NOTICE, e.g. \"account\nsign-up through our Terms of Service and Privacy Policy, and again at first use\nof an AI-powered feature through an in-product notice\"].\n\n[If applicable: We obtain explicit opt-in consent before processing [SENSITIVE_DATA_CATEGORY]\nthrough AI features.]\n\n---\n\n## Data Retention\n\n[APP_NAME] retains AI-interaction logs (prompt inputs, outputs, session metadata)\nfor [YOUR_APP_RETENTION_PERIOD, e.g. \"90 days\"] for debugging and quality purposes.\nAfter that period, logs are deleted from our systems. Subprocessor retention windows\nare listed in the table above; we cannot guarantee earlier deletion by subprocessors\nonce data is transmitted.\n\n---\n\n## Security\n\nAll data sent to AI subprocessors is transmitted over encrypted channels (TLS 1.2+).\n[Add any additional controls relevant to your app, e.g. VPC peering, no-logging API\ntier, enterprise DPA.]\n\n---\n\n## Changes to This Document\n\nWe will update this document when we add, remove, or change AI subprocessors.\nSignificant changes will be communicated to registered users by [NOTIFICATION_METHOD,\ne.g. \"email at least 30 days before taking effect\"].\n\n---\n\n## Contact\n\nFor questions about this disclosure or to exercise your rights, contact:\n\n**[COMPANY_NAME]**  \n[CONTACT_EMAIL]  \n[OPTIONAL: Data Protection Officer: DPO_NAME \u2014 dpo@[DOMAIN]]  \n[OPTIONAL: EU Representative: EU_REP_NAME \u2014 [ADDRESS]]"},{"checksum":"sha256:53d0575c125eb7a102eb6b0b6d20310de4a705b4b9ee5a91c69a8b1a2547345c","chunk_id":"chunk_dc39f626166b6097","end_line":174,"path":"build_context/AppGenerator/templates/privacy-policy.md","start_line":1,"symbol_ids":[],"text":"# Privacy Policy\n\n<!-- TODO: Replace every [PLACEHOLDER] with your actual information before publishing.\n     Do not make this app publicly accessible until this document is complete and reviewed\n     by a qualified legal professional for your jurisdiction. -->\n\n**Effective date:** [EFFECTIVE_DATE]\n**Last updated:** [LAST_UPDATED_DATE]\n\n---\n\n## 1. Introduction\n\n[APP_NAME] (\"we\", \"our\", or \"us\") operates [APP_URL] (the \"Service\"). This Privacy Policy\nexplains how we collect, use, disclose, and safeguard your information when you use our Service.\n\n**Data controller:** [DATA_CONTROLLER_LEGAL_NAME]\n**Registered address:** [DATA_CONTROLLER_ADDRESS]\n**Contact:** [PRIVACY_CONTACT_EMAIL]\n\n---\n\n## 2. Information We Collect\n\n### 2.1 Information you provide directly\n\n- **Account registration:[REDACTED] [DESCRIBE_WHAT_IS_COLLECTED, e.g. name, email address, password]\n- **Profile information:** [DESCRIBE_OPTIONAL_PROFILE_FIELDS]\n- **User-generated content:** [DESCRIBE_CONTENT_USERS_CREATE, e.g. messages, files, projects]\n- **Payment information:** [DESCRIBE_PAYMENT_DATA_HANDLING; if using a payment processor, state that card details are handled by [PAYMENT_PROVIDER] and you do not store raw card numbers]\n\n### 2.2 Information collected automatically\n\n- **Usage data:** Pages visited, features used, timestamps, and session duration.\n- **Device data:** IP address, browser type, operating system, and device identifiers.\n- **Cookies and similar technologies:** See Section 5 (Cookies) for details.\n\n### 2.3 Information from third parties\n\n- **Authentication providers:** If you sign in via [OAUTH_PROVIDERS, e.g. Google], we receive your name and email from that provider.\n- **[OTHER_THIRD_PARTY_SOURCE]:** [DESCRIBE_DATA_RECEIVED]\n\n---\n\n## 3. How We Use Your Information\n\nWe use your information to:\n\n- Create and manage your account.\n- Provide, maintain, and improve the Service.\n- Process transactions and send related notices (receipts, invoices).\n- Send transactional emails (password reset, account notifications).\n- [DESCRIBE_ANY_MARKETING_USE \u2014 if none, state \"We do not send marketing emails without your explicit consent.\"]\n- Comply with legal obligations.\n- Detect and prevent fraud or abuse.\n\n**Legal basis (GDPR):** [SPECIFY_LEGAL_BASIS per processing purpose, e.g. contract performance,\nlegitimate interest, consent, or legal obligation]\n\n---\n\n## 4. Data Storage and Retention\n\nYour data is stored on [CLOUD_PROVIDER / HOSTING_REGION]. We retain your data:\n\n| Data type | Retention period |\n|-----------|-----------------|\n| Account data | Until account deletion + [N] days |\n| Usage logs | [RETENTION_PERIOD, e.g. 90 days] |\n| Payment records | [RETENTION_PERIOD, e.g. 7 years for tax purposes] |\n| [OTHER_DATA_TYPE] | [RETENTION_PERIOD] |\n\nWhen you delete your account, we [DESCRIBE_DELETION_PROCESS, e.g. anonymise or hard-delete\npersonal data within 30 days, except where retention is required by law].\n\n---\n\n## 5. Cookies and Tracking\n\nWe use the following cookies:\n\n| Cookie | Purpose | Duration | Type |\n|--------|---------|----------|------|\n| `session` | Maintains your login session | Session | Essential |\n| [COOKIE_NAME] | [PURPOSE] | [DURATION] | [Essential / Functional / Analytics] |\n\nYou can control cookies through your browser settings. Disabling essential cookies will\nprevent you from using core Service features.\n\n[DESCRIBE_ANALYTICS_TOOLS_IN_USE, e.g. \"We use [ANALYTICS_PROVIDER] to understand aggregate\nusage patterns. This tool sets [DESCRIBE_COOKIES_SET].\"]\n\n---\n\n## 6. Third-Party Sharing and Subprocessors\n\nWe share your data only as described below. We do not sell your personal data.\n\n| Recipient | Purpose | Data shared | Location |\n|-----------|---------|-------------|----------|\n| [HOSTING_PROVIDER] | Infrastructure | All app data | [REGION] |\n| [EMAIL_PROVIDER] | Transactional email | Name, email | [REGION] |\n| [AI_PROVIDER] | AI-powered features | [DESCRIBE_INPUT_DATA] | [REGION] |\n| [PAYMENT_PROCESSOR] | Payment processing | Billing info | [REGION] |\n| [OTHER_SUBPROCESSOR] | [PURPOSE] | [DATA] | [REGION] |\n\nAll subprocessors are bound by data processing agreements and must protect your data\nin accordance with applicable law.\n\n---\n\n## 7. Your Rights\n\nDepending on your jurisdiction you may have the right to:\n\n- **Access** the personal data we hold about you.\n- **Correct** inaccurate or incomplete data.\n- **Delete** your data (\"right to be forgotten\").\n- **Port** your data in a machine-readable format.\n- **Restrict** or **object** to certain processing.\n- **Withdraw consent** at any time where processing is consent-based.\n- **Lodge a complaint** with your local data protection authority.\n\nTo exercise your rights, contact us at [PRIVACY_CONTACT_EMAIL]. We will respond within\n[RESPONSE_TIMEFRAME, e.g. 30 days].\n\n[GDPR_DPO_SECTION \u2014 if required: \"Our Data Protection Officer can be reached at [DPO_EMAIL].\"]\n\n---\n\n## 8. Children's Privacy\n\nThe Service is not directed to individuals under the age of [MINIMUM_AGE, e.g. 13 / 16 for GDPR].\nWe do not knowingly collect personal data from children. If you believe we have collected\ndata from a child, please contact us immediately at [PRIVACY_CONTACT_EMAIL].\n\n---\n\n## 9. International Transfers\n\n[If applicable: \"Your data may be transferred to and processed in countries outside your own.\nWhen we transfer data from the EEA/UK, we use [TRANSFER_MECHANISM, e.g. Standard Contractual\nClauses approved by the European Commission].\"]\n\n[If not applicable: \"We process all data within [REGION] and do not transfer data internationally.\"]\n\n---\n\n## 10. Security\n\nWe implement [DESCRIBE_SECURITY_MEASURES, e.g. encryption at rest and in transit, access\ncontrols, and regular security reviews] to protect your data. However, no system is perfectly\nsecure. If you discover a vulnerability, please contact [SECURITY_CONTACT_EMAIL].\n\n---\n\n## 11. Changes to This Policy\n\nWe may update this Privacy Policy from time to time. When we make material changes, we will\n[DESCRIBE_NOTIFICATION_METHOD, e.g. notify you by email and/or display a prominent notice in\nthe app] at least [NOTICE_PERIOD, e.g. 14] days before the changes take effect.\n\nYour continued use of the Service after the effective date constitutes acceptance of the\nupdated policy.\n\n---\n\n## 12. Contact Us\n\nFor questions about this Privacy Policy or to exercise your rights:\n\n**[DATA_CONTROLLER_LEGAL_NAME]**\n[DATA_CONTROLLER_ADDRESS]\nEmail: [PRIVACY_CONTACT_EMAIL]"},{"checksum":"sha256:76af0652f86346180115d42f31b38e6ba3362ca6179dfd76703fa3186242b7c7","chunk_id":"chunk_45d3905670f81ac2","end_line":207,"path":"build_context/AppGenerator/templates/terms-of-service.md","start_line":1,"symbol_ids":[],"text":"# Terms of Service\n\n<!-- TODO: Replace every [PLACEHOLDER] with your actual information before publishing.\n     Do not make this app publicly accessible until this document is complete and reviewed\n     by a qualified legal professional for your jurisdiction. -->\n\n**Effective date:** [EFFECTIVE_DATE]\n**Last updated:** [LAST_UPDATED_DATE]\n\n---\n\n## 1. Acceptance of Terms\n\nBy accessing or using [APP_NAME] (\"Service\") operated by [OPERATOR_LEGAL_NAME] (\"we\",\n\"our\", or \"us\") at [APP_URL], you agree to be bound by these Terms of Service (\"Terms\").\n\nIf you do not agree to these Terms, do not use the Service.\n\n[DESCRIBE_MINIMUM_AGE_REQUIREMENT, e.g. \"You must be at least 18 years old, or the age of\nlegal majority in your jurisdiction, to use this Service.\"]\n\n---\n\n## 2. Description of the Service\n\n[APP_NAME] provides [BRIEF_DESCRIPTION_OF_SERVICE, e.g. a platform for building and\nmanaging community-driven projects with AI-powered tools].\n\nWe reserve the right to modify, suspend, or discontinue any part of the Service at any time\nwith [NOTICE_PERIOD, e.g. 30 days'] notice, except in cases of legal obligation or emergency.\n\n---\n\n## 3. Account Registration and Responsibilities\n\n### 3.1 Account creation\n\nTo access certain features you must create an account. You agree to:\n\n- Provide accurate, current, and complete information during registration.\n- Maintain and promptly update your account information.\n- Keep your password confidential and notify us immediately of any unauthorized access.\n- Accept responsibility for all activities that occur under your account.\n\n### 3.2 Account termination by you\n\nYou may delete your account at any time through [DESCRIBE_DELETION_PATH, e.g. Account\nSettings \u2192 Delete Account]. Deletion is permanent and [DESCRIBE_DATA_HANDLING_ON_DELETION,\ne.g. your data will be removed within 30 days per our Privacy Policy].\n\n### 3.3 Account suspension by us\n\nWe may suspend or terminate your account if you violate these Terms, engage in fraudulent\nactivity, or for any other reason at our sole discretion, with or without notice.\n\n---\n\n## 4. Prohibited Conduct\n\nYou agree not to:\n\n- Use the Service for any unlawful purpose or in violation of applicable regulations.\n- Post, transmit, or distribute content that is defamatory, obscene, harassing, or\n  that infringes any third-party intellectual property rights.\n- Attempt to gain unauthorized access to any part of the Service or its related systems.\n- Introduce malware, viruses, or other malicious code.\n- Use automated bots, scrapers, or crawlers without our prior written consent.\n- Impersonate any person or entity, or misrepresent your affiliation with any person or entity.\n- [ADD_ANY_APP_SPECIFIC_PROHIBITED_USES]\n\nWe reserve the right to investigate and take appropriate action against violations, including\nremoving content, suspending accounts, and referring matters to law enforcement.\n\n---\n\n## 5. User Content\n\n### 5.1 Your content\n\nYou retain ownership of content you submit to the Service (\"User Content\"). By submitting\nUser Content, you grant us a [SCOPE_OF_LICENSE, e.g. non-exclusive, worldwide, royalty-free]\nlicense to use, store, and display your User Content solely for the purpose of operating the Service.\n\n### 5.2 Content standards\n\nUser Content must not violate applicable law or the rights of third parties. You are solely\nresponsible for the accuracy, legality, and appropriateness of your User Content.\n\n### 5.3 Content removal\n\nWe may remove User Content that violates these Terms or applicable law, without notice.\n\n---\n\n## 6. Intellectual Property\n\nThe Service, including all software, designs, text, graphics, logos, and trademarks, is owned\nby [OPERATOR_LEGAL_NAME] or its licensors and is protected by intellectual property laws.\n\nYou may not copy, modify, distribute, sell, or create derivative works from any part of the\nService without our prior written consent.\n\n---\n\n## 7. Third-Party Services and Links\n\nThe Service may integrate with or link to third-party services. These services are governed\nby their own terms and privacy policies. We are not responsible for the practices of any\nthird-party services.\n\n---\n\n## 8. Fees and Payment\n\n[If applicable:]\n\n[APP_NAME] offers [DESCRIBE_PRICING_TIERS]. By subscribing to a paid plan, you agree to:\n\n- Pay all applicable fees as described on our pricing page.\n- Authorize us (or our payment processor, [PAYMENT_PROVIDER]) to charge your payment method.\n- [DESCRIBE_REFUND_POLICY, e.g. \"Subscription fees are non-refundable except as required by law.\"]\n- [DESCRIBE_AUTO_RENEWAL_POLICY]\n\n[If free only: \"The Service is currently provided free of charge. We reserve the right to\nintroduce fees in the future with [NOTICE_PERIOD] days' advance notice.\"]\n\n---\n\n## 9. Disclaimer of Warranties\n\nTHE SERVICE IS PROVIDED \"AS IS\" AND \"AS AVAILABLE\" WITHOUT WARRANTIES OF ANY KIND, EITHER\nEXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO WARRANTIES OF MERCHANTABILITY, FITNESS FOR\nA PARTICULAR PURPOSE, OR NON-INFRINGEMENT.\n\nWE DO NOT WARRANT THAT THE SERVICE WILL BE UNINTERRUPTED, ERROR-FREE, OR SECURE, OR THAT\nDEFECTS WILL BE CORRECTED.\n\n---\n\n## 10. Limitation of Liability\n\nTO THE MAXIMUM EXTENT PERMITTED BY APPLICABLE LAW, [OPERATOR_LEGAL_NAME] SHALL NOT BE\nLIABLE FOR ANY INDIRECT, INCIDENTAL, SPECIAL, CONSEQUENTIAL, OR PUNITIVE DAMAGES, INCLUDING\nLOST PROFITS, LOSS OF DATA, OR LOSS OF GOODWILL, ARISING OUT OF OR IN CONNECTION WITH YOUR\nUSE OF THE SERVICE.\n\nOUR TOTAL LIABILITY FOR ANY CLAIM ARISING OUT OF OR RELATING TO THESE TERMS SHALL NOT EXCEED\n[LIABILITY_CAP, e.g. THE GREATER OF $100 USD OR THE AMOUNT YOU PAID US IN THE PAST 12 MONTHS].\n\n[Some jurisdictions do not allow limitation of liability \u2014 adjust or remove the above as required\nby your legal counsel for your target jurisdiction.]\n\n---\n\n## 11. Indemnification\n\nYou agree to indemnify, defend, and hold harmless [OPERATOR_LEGAL_NAME], its affiliates,\nofficers, employees, and agents from and against any claims, damages, losses, and expenses\n(including reasonable attorneys' fees) arising from your use of the Service, your User Content,\nor your violation of these Terms.\n\n---\n\n## 12. Governing Law and Dispute Resolution\n\nThese Terms shall be governed by and construed in accordance with the laws of [GOVERNING_JURISDICTION,\ne.g. the State of Delaware, USA / England and Wales], without regard to conflict-of-law principles.\n\n[CHOOSE ONE \u2014 delete the other:]\n\n**Option A (litigation):** Any disputes shall be resolved exclusively in the courts of [COURT_LOCATION].\n\n**Option B (arbitration):** Any disputes shall be resolved by binding arbitration administered by\n[ARBITRATION_BODY, e.g. JAMS / AAA] under its [RULES_SET] rules. Class actions are waived to the\nextent permitted by law.\n\n---\n\n## 13. Changes to These Terms\n\nWe may update these Terms at any time. When we make material changes, we will [DESCRIBE_NOTIFICATION_METHOD,\ne.g. notify you by email and/or display a prominent notice in the app] at least [NOTICE_PERIOD,\ne.g. 14] days before the changes take effect.\n\nYour continued use of the Service after the effective date constitutes acceptance of the updated Terms.\n\n---\n\n## 14. Miscellaneous\n\n- **Entire agreement:** These Terms, together with our Privacy Policy and any other policies\n  referenced herein, constitute the entire agreement between you and us regarding the Service.\n- **Severability:** If any provision of these Terms is held invalid, the remaining provisions\n  remain in full force.\n- **Waiver:** Our failure to enforce any right or provision shall not constitute a waiver.\n- **Assignment:** You may not assign your rights under these Terms without our consent. We may\n  assign ours freely.\n\n---\n\n## 15. Contact Us\n\nQuestions about these Terms? Contact us at:\n\n**[OPERATOR_LEGAL_NAME]**\n[OPERATOR_ADDRESS]\nEmail: [LEGAL_CONTACT_EMAIL]"},{"checksum":"sha256:8fd0ad8b1d84bce7be520a8351fe51c406515e14ec4ee26d9a2dc3094ec21f25","chunk_id":"chunk_f7a71b57e304385f","end_line":177,"path":"build_context/AppGenerator/workflow_archetypes.yaml","start_line":1,"symbol_ids":[],"text":"version: 1\n\ndescription: >\n  Advisory workflow archetypes used as prompt-time guidance for app planning\n  when planning workflow-surface capability packs. These archetypes define the\n  expected orchestrator shape, canonical agent sequence, tool constraints,\n  structured output field defaults, and output invariants for common workflow\n  patterns.\n\n  Archetypes do not change the canonical structured output models.\n  They guide app planning and workflow authoring in selecting the right\n  orchestrator shape and agent conventions for each workflow capability pack.\n\n  Injected into app planning via [WORKFLOW ARCHETYPE CONTEXT].\n\narchetypes:\n\n  ai_review:\n    summary: >\n      BackendOnly autonomous review workflow. Triggered by a domain event when a\n      record is submitted for review. Evaluates the record using LLM reasoning,\n      produces a structured decision (approved/rejected/revision_requested), and\n      calls record_review_result on the owning module to persist the outcome.\n    select_when:\n      - \"The app has an ai_review_pack capability \u2014 autonomous evaluation without a human reviewer per item.\"\n      - \"Records are submitted for review and need a structured decision written back to the module.\"\n      - \"The workflow runs BackendOnly \u2014 no user-facing chat session.\"\n    workflow_startup_mode: BackendOnly\n    orchestration_pattern: Feedback Loop\n    capability_id_suffix: \"-review-workflow\"\n    orchestrator_defaults:\n      schema_version: mozaiks.orchestrator.v1\n      human_in_the_loop: false\n      workflow_startup_mode: BackendOnly\n      max_turns: 20\n    canonical_agent_sequence:\n      - IntakeAgent:\n          role: >\n            Receives the submission event payload. Reads the submitted record via\n            module action. Validates completeness. Emits NEXT when ready for review.\n          max_consecutive_auto_reply: 4\n          structured_outputs_required: false\n      - ReviewerAgent:\n          role: >\n            Evaluates the submitted record against declared review criteria.\n            Produces a structured decision: approved, rejected, or revision_requested.\n            Includes evidence, rationale, and feedback. May loop back if the record\n            needs clarification or additional context.\n          max_consecutive_auto_reply: 8\n          structured_outputs_required: true\n      - ResultAgent:\n          role: >\n            Calls record_review_result on the owning module with the supplied structured review\n            decision and feedback. Confirms the write succeeded. Emits NEXT to close.\n          max_consecutive_auto_reply: 4\n          structured_outputs_required: false\n    hard_constraints:\n      - \"workflow_startup_mode: BackendOnly \u2014 no user chat session.\"\n      - \"ResultAgent MUST call record_review_result \u2014 the module owns the persistence.\"\n      - \"Never write review state directly to the database \u2014 always via module action.\"\n      - \"Decision must be one of: approved, rejected, revision_requested.\"\n\n  ai_analysis:\n    summary: >\n      BackendOnly autonomous analysis workflow. Triggered when a record is created.\n      Enriches the record with AI-derived analysis (sentiment, classification, scoring,\n      extraction) and writes the result back to the owning module via store_analysis_result.\n    select_when:\n      - \"The app has an ai_analysis_pack capability \u2014 background enrichment on record creation.\"\n      - \"Records need AI-derived fields populated automatically after creation.\"\n      - \"The workflow runs BackendOnly \u2014 no user interaction required.\"\n    workflow_startup_mode: BackendOnly\n    orchestration_pattern: Pipeline\n    capability_id_suffix: \"-analysis-workflow\"\n    orchestrator_defaults:\n      schema_version: mozaiks.orchestrator.v1\n      human_in_the_loop: false\n      workflow_startup_mode: BackendOnly\n      max_turns: 15\n    canonical_agent_sequence:\n      - ContextReaderAgent:\n          role: >\n            Reads the newly created record and any relevant context (related records,\n            user history, domain rules). Prepares the analysis inputs. Emits NEXT.\n          max_consecutive_auto_reply: 4\n          structured_outputs_required: false\n      - AnalysisAgent:\n          role: >\n            Applies LLM reasoning to produce structured analysis output: classification,\n            scoring, sentiment, entity extraction, or domain-specific enrichment fields.\n            Output is a typed structured object matching the module's analysis_result schema.\n          max_consecutive_auto_reply: 6\n          structured_outputs_required: true\n      - ResultWriterAgent:\n          role: >\n            Calls store_analysis_result on the owning module with the supplied typed analysis_result object.\n            Confirms the write succeeded.\n          max_consecutive_auto_reply: 3\n          structured_outputs_required: false\n    hard_constraints:\n      - \"workflow_startup_mode: BackendOnly \u2014 triggered by domain.{module_id}.created event.\"\n      - \"ResultWriterAgent MUST call store_analysis_result \u2014 the module owns the persistence.\"\n      - \"Never write analysis fields directly \u2014 always via the module action contract.\"\n\n  ai_extraction:\n    summary: >\n      BackendOnly batch extraction workflow. Triggered when a batch of documents or\n      records is submitted for processing. Fans out parallel extraction workers across\n      the batch items and writes results back to the owning module.\n    select_when:\n      - \"The app has an ai_extraction_pack capability \u2014 parallel processing of document batches.\"\n      - \"Multiple records or files need to be processed in parallel with results persisted.\"\n      - \"The workflow runs BackendOnly with task_batches for parallel workers.\"\n    workflow_startup_mode: BackendOnly\n    orchestration_pattern: Triage with Tasks\n    capability_id_suffix: \"-extraction-workflow\"\n    task_batches_required: true\n    orchestrator_defaults:\n      schema_version: mozaiks.orchestrator.v1\n      human_in_the_loop: false\n      workflow_startup_mode: BackendOnly\n      max_turns: 30\n    canonical_agent_sequence:\n      - TriageAgent:\n          role: >\n            Receives the batch_submitted event payload. Reads the batch record list.\n            Partitions items into parallel worker tasks via task_batches.yaml.\n            Emits NEXT when the fan-out dispatch is complete.\n          max_consecutive_auto_reply: 6\n          structured_outputs_required: true\n      - ExtractionWorkerAgent:\n          role: >\n            Parallel worker. Receives one batch item. Applies LLM extraction (structured\n            fields, entities, classifications, or domain-specific schema). Returns typed\n            extraction result. One worker per item via task_batches.yaml.\n          max_consecutive_auto_reply: 8\n          structured_outputs_required: true\n      - SynthesisAgent:\n          role: >\n            Collects all worker results. Calls store_extraction_results on the owning\n            module with the batch_id and complete results array.\n          max_consecutive_auto_reply: 4\n          structured_outputs_required: false\n    hard_constraints:\n      - \"workflow_startup_mode: BackendOnly \u2014 triggered by domain.{module_id}.batch_submitted event.\"\n      - \"task_batches.yaml is required for parallel ExtractionWorkerAgent dispatch.\"\n      - \"SynthesisAgent MUST call store_extraction_results \u2014 the module owns the persistence.\"\n      - \"Never write extraction results directly \u2014 always via the module action contract.\"\n\n  proposal_only:\n    summary: >\n      A human-in-the-loop workflow that produces a structured proposal, plan,\n      or review brief for operator approval. No irreversible action is taken by\n      the workflow itself. All phases or steps are status=proposed or\n      status=blocked, never executed. The operator must review the output and\n      advance through a separate execution or approval workflow.\n    select_when:\n      - \"The workflow purpose is to plan, assess, or recommend \u2014 not to execute.\"\n      - \"The output requires human review before any data or system change is made.\"\n      - \"High-risk or irreversible actions must be deferred to a downstream execution workflow.\"\n      - \"Applicable to: compliance review, migration planning, deployment remediation plan, data cleanup plan, content moderation proposal, change proposal review, deployment impact assessment.\"\n    orchestrator_defaults:\n      schema_version: mozaiks.orchestrator.v1\n      human_in_the_loop: true\n      max_turns: 30\n      workflow_startup_mode: AgentDriven\n    canonical_agent_sequence:\n      - IntakeAgent:\n          role: >\n            Gathers operator scope (tenant, domain, subject). Read-only.\n            Confirms scope with the operator. Emits NEXT on confirmation.\n            Does not execute anything. Does not call provider APIs.\n          max_consecutive_auto_reply: 8\n          structured_outputs_required: false\n      - PlannerAgent:\n          role: >\n            Reads relevant data using read-only tools (list_*, get_*, read_*)."},{"checksum":"sha256:2d613d6330f80d7629aee59372a89ce87e6ff927893ee73ae93085ccb25aa15f","chunk_id":"chunk_067956a1e75f43ae","end_line":352,"path":"build_context/AppGenerator/workflow_archetypes.yaml","start_line":178,"symbol_ids":[],"text":"            Synthesizes a structured proposal or review brief covering findings,\n            recommended actions, risks, assumptions, and a next_step.\n            Emits NEXT when the analysis is ready.\n            Must not call execute_action, approve, or any mutating action.\n          max_consecutive_auto_reply: 12\n          structured_outputs_required: false\n      - OutputAgent:\n          role: >\n            Serializes the proposal into the top-level structured output model.\n            Must enforce all output invariants regardless of supplied upstream proposal content.\n            Output is JSON only \u2014 no prose.\n          max_consecutive_auto_reply: 4\n          structured_outputs_required: true\n    optional_agents:\n      - ReviewerAgent:\n          role: >\n            Optional intermediate agent for second-opinion or stakeholder review.\n            May inject risks or caveats but must not approve or execute.\n    tool_constraints:\n      allowed:\n        - \"list_* \u2014 read-only data enumeration (lists records, zones, items)\"\n        - \"get_* \u2014 read-only record fetch (fetches a single record or snapshot)\"\n        - \"read_* \u2014 read-only snapshot or document read\"\n        - \"save_* \u2014 proposal artifact persistence (auto_tool_call: true, OutputAgent only)\"\n      forbidden:\n        - \"execute_action \u2014 bypasses the approval state machine; always forbidden\"\n        - \"approve \u2014 operator-only action; must not be triggered by the workflow\"\n        - \"create_* / update_* / delete_* \u2014 write-path actions deferred to execution workflow\"\n        - \"Any direct external provider API call (cloud, DNS, registrar, storage)\"\n    structured_output_defaults:\n      description: >\n        Minimum required fields for the top-level output model of a proposal_only workflow.\n        The final structured output must enforce the invariant fields regardless of supplied intermediate results.\n      required_fields:\n        proposal_id:\n          type: str\n          description: \"Unique identifier for this proposal artifact (uuid4 recommended).\"\n        artifact_type:\n          type: str\n          description: >\n            Semantic type of this proposal (e.g. migration_plan, compliance_brief,\n            remediation_plan, content_review_brief, deployment_assessment).\n        human_review_required:\n          type: bool\n          description: >\n            Always true regardless of supplied intermediate results. Schema-level invariant\n            enforcement is a future enhancement; the final output prompt instructions\n            are the current enforcement mechanism.\n        status:\n          type: str\n          description: >\n            Overall proposal status. Always \"proposed\" in workflow output.\n            Never \"approved\", \"active\", \"in_progress\", or \"executed\".\n        risks:\n          type: list\n          items: str\n          description: \"Identified risks or open questions for operator validation.\"\n        assumptions:\n          type: list\n          items: str\n          description: \"Key assumptions the proposal is based on.\"\n        next_step:\n          type: object\n          description: >\n            Operator instructions for advancing the proposal after review.\n            next_step.requires_human_approval must always be true.\n      optional_fields:\n        phases:\n          description: \"Ordered list of proposed phases or steps (see blocked_phase_pattern).\"\n        blockers:\n          description: >\n            Systemic blockers that prevent phases from being executable in the current\n            product phase. Use the blocked_phase_pattern for each entry.\n        approval_instructions:\n          description: >\n            Step-by-step operator instructions for advancing proposals through an\n            approval state machine after review.\n    output_invariants:\n      description: >\n        The final structured output must satisfy these invariants.\n        They are enforced through explicit final-output prompt instructions, not through\n        schema-level constraints. A future enhancement may add schema-level invariant\n        metadata to structured_outputs.yaml when schema-level invariants are\n        introduced.\n      invariants:\n        - field: human_review_required\n          enforced_value: true\n          prompt_instruction: \"human_review_required: true (always \u2014 never false)\"\n        - field: status\n          allowed_values:\n            - proposed\n            - blocked\n          forbidden_values:\n            - approved\n            - active\n            - in_progress\n            - executed\n          prompt_instruction: >\n            All status values must be \"proposed\" or \"blocked\".\n            Never \"approved\", \"active\", \"in_progress\", or \"executed\".\n        - field: next_step.requires_human_approval\n          enforced_value: true\n          prompt_instruction: \"next_step.requires_human_approval: true (always)\"\n    hard_constraints:\n      - \"DO NOT add execute_action as a callable tool in any proposal_only workflow.\"\n      - \"DO NOT set human_review_required to false under any circumstances.\"\n      - \"DO NOT set any phase, step, or item status to approved, active, in_progress, or executed.\"\n      - \"DO NOT call provider write APIs (cloud DNS, registrar, storage, external SaaS).\"\n      - \"All tool functions must start with list_, get_, read_, or save_.\"\n      - \"OutputAgent must have structured_outputs_required: true.\"\n      - \"OutputAgent [OUTPUT FORMAT] section must list all output invariants explicitly.\"\n      - \"The final output must enforce invariants regardless of supplied intermediate results.\"\n      - \"Blocked/deferred phases must appear in the output \u2014 never silently omitted.\"\n    blocked_phase_pattern:\n      description: >\n        When a proposal includes phases or steps that cannot be executed in the\n        current product phase (e.g. write adapters not yet implemented, required\n        credentials not yet issued), those phases are represented as blocked.\n        Blocked phases must still appear in the output plan so operators have\n        full visibility. They must never be silently omitted.\n      fields:\n        status:\n          value: blocked\n          note: \"Never proposed, approved, or executed for a phase that cannot run.\"\n        blocked_reason:\n          type: str\n          description: >\n            Error code or human-readable reason (e.g. WRITE_NOT_IMPLEMENTED,\n            ADAPTER_NOT_READY, CREDENTIALS_REQUIRED).\n        deferred_to:\n          type: str\n          description: >\n            Phase, release, or condition when this will become executable\n            (e.g. Phase 3D, v2.0, after_operator_approval).\n      example:\n        phase_id: dangerous_cutover\n        phase_type: nameserver_cutover\n        status: blocked\n        blocked_reason: WRITE_NOT_IMPLEMENTED\n        deferred_to: Phase 3D\n        risk_level: high\n        rollback_note: >\n          Revert to previous state via the operator admin panel.\n          Allow up to 48 hours for propagation.\n      rule: >\n        A tool call returning WRITE_NOT_IMPLEMENTED or similar error is a signal\n        to mark the related phase as blocked \u2014 not to skip it. The operator benefits\n        from seeing blocked phases so they can plan around current limitations.\n\n  standard:\n    summary: >\n      A general agentic workflow that may execute tasks, call module actions,\n      and write data \u2014 with human in the loop for scope confirmation, not for\n      every individual action. The workflow produces results during the session.\n    select_when:\n      - \"The workflow creates, updates, or manages records during the session.\"\n      - \"Write actions are expected and permitted after operator scope confirmation.\"\n      - \"The workflow is not exclusively a planning or review surface.\"\n      - \"Applicable to: chat assistant, onboarding wizard, content generation, form submission.\"\n    orchestrator_defaults:\n      schema_version: mozaiks.orchestrator.v1\n      human_in_the_loop: true\n      workflow_startup_mode: AgentDriven\n    tool_constraints:\n      allowed:\n        - \"list_*, get_*, read_* \u2014 read-only tools always allowed\"\n        - \"Write-path actions declared by the owning module contract\"\n        - \"emit_event \u2014 publish domain events to the app event bus\"\n      forbidden:\n        - \"Do not implement business logic that belongs in a deterministic module.\"\n        - \"Do not call raw external APIs that bypass the app module action contract.\"\n    hard_constraints:\n      - \"Emit domain events only through emit_event, not through direct module calls.\"\n      - \"Do not implement business logic that belongs in a deterministic module.\"\n      - \"Write-path actions must be declared in the plan before a downstream agent generates them.\""},{"checksum":"sha256:6c48cfe75f2fa3cda912590a2c00fa2a56a14651d9bd47179683212cbe9ef34f","chunk_id":"chunk_12cfa1147d13166d","end_line":162,"path":"build_context/AppGenerator/workspace_extensions_contract.yaml","start_line":1,"symbol_ids":[],"text":"schema_version: 1\n\ndescription: >\n  Contract schema for workspace-level build context extension files.\n  Any app workspace may place an extensions.yaml in a root named build context\n  pack to declare module-level customizations on top of OSS pack templates.\n\n  AppGenerator reads both the OSS pack template and the workspace extension\n  declarations to produce two handler files per module:\n\n    base_handler.py  \u2014 OSS-generated, always overwritten on regeneration.\n                       Contains the full implementation from the pack template.\n                       Never edit this file directly.\n\n    handler.py       \u2014 Workspace-owned subclass, preserved across regeneration.\n                       Subclasses the base handler. Add extra action params,\n                       overridden methods, and app-specific extra actions here.\n                       Regenerated only when --force-handlers is passed.\n\n  module.yaml continues to declare:\n    module.handler: backend.handler:ClassName\n  pointing at the subclass in handler.py. The runtime is unaffected.\n\nfile_location: \"build_context/{pack_id}/extensions.yaml\"\n\nschema:\n  schema_version:\n    type: string\n    required: true\n    value: \"mozaiks.workspace_extensions.v1\"\n\n  module_extensions:\n    type: array\n    description: >\n      List of module-level extension declarations. One entry per module\n      that diverges from the OSS pack template.\n    items:\n      module_id:\n        type: string\n        required: true\n        description: >\n          Module directory name matching the generated app's modules/{module_id}/.\n\n      base_pack:\n        type: string\n        required: true\n        description: >\n          OSS pack and module this extends, in {pack_id}.{module_id} form.\n          Example: \"messaging.messages\", \"social.friends\".\n\n      action_extensions:\n        type: array\n        required: false\n        description: >\n          Extra params added to existing actions from the base template.\n          AppGenerator adds these to the handler.py override of that action method.\n          The base_handler.py method signature stays unchanged.\n\n          Pack action request contracts are closed (every module.yaml\n          input_schema object declares additionalProperties: false), so every\n          extra param must also be added to that action's module.yaml\n          input_schema as an explicitly declared property \u2014 otherwise runtime\n          dispatch validation rejects requests carrying it. Extensions keep the\n          schema closed; they never reopen additionalProperties.\n        items:\n          action_id:\n            type: string\n            required: true\n            description: Action id from the base module.yaml.\n          extra_params:\n            type: array\n            description: Additional keyword params appended to the base method signature.\n            items:\n              name:\n                type: string\n                required: true\n              type:\n                type: string\n                required: true\n                description: Python type annotation string (e.g. \"str | None\", \"bool\").\n              default:\n                type: string\n                required: true\n                description: >\n                  Python literal default value string (e.g. \"None\", '\"user\"', \"False\").\n          param_overrides:\n            type: array\n            required: false\n            description: >\n              Change the default value of a param that exists in the base method.\n              Use sparingly \u2014 prefer extra_params for truly new params.\n            items:\n              name:\n                type: string\n                required: true\n              default:\n                type: string\n                required: true\n\n      extra_actions:\n        type: array\n        required: false\n        description: >\n          Fully new actions declared only by this workspace module \u2014 not in the\n          base pack template. These must also appear in the module's module.yaml\n          actions list so the runtime loader can validate dispatch methods.\n          AppGenerator adds these as new methods on the handler.py subclass.\n        items:\n          action_id:\n            type: string\n            required: true\n          handler_method:\n            type: string\n            required: true\n            description: >\n              Must match the handler_method declared in module.yaml actions[].\n          params:\n            type: array\n            items:\n              name: { type: string }\n              type: { type: string }\n              default: { type: string }\n\nregeneration_semantics:\n  base_handler.py:\n    owner: oss_template\n    on_regeneration: overwrite\n    rule: >\n      Always overwritten when the pack template changes or when mozaiks is upgraded.\n      Never edit this file. Customizations in this file will be lost on regeneration.\n\n  handler.py:\n    owner: workspace\n    on_regeneration: preserve\n    rule: >\n      Generated once from workspace extensions.yaml, then preserved.\n      Subclasses base_handler.py. Safe to add overrides and extra methods.\n      Pass --force-handlers to regenerate from extensions.yaml (overwrites manual edits).\n\nexamples:\n  - description: Messages module with extra create_thread and send_message params\n    file: build_context/messaging/extensions.yaml\n    content: |\n      schema_version: mozaiks.workspace_extensions.v1\n\n      module_extensions:\n        - module_id: messages\n          base_pack: messaging.messages\n          action_extensions:\n            - action_id: create_thread\n              extra_params:\n                - name: listing_id\n                  type: \"str | None\"\n                  default: \"None\"\n            - action_id: send_message\n              extra_params:\n                - name: sender_role\n                  type: str\n                  default: '\"user\"'\n                - name: allow_nonparticipant_sender\n                  type: bool\n                  default: \"False\""},{"checksum":"sha256:e106d7051af897fad8d24fbeafec370220f98f3a8d52a39e3c1260d4a33d220c","chunk_id":"chunk_a8db8c6d58239e60","end_line":24,"path":"build_context/SecurityReadiness/app_security_file_contracts.yaml","start_line":1,"symbol_ids":[],"text":"contract_id: app_security_file_contracts\ncontract_type: generated_app_security_files\nversion: 1\nfiles:\n  - path: [REDACTED]\n    required: [REDACTED]\n    owner: AppGenerator\n    rules:\n      - Names-only contract; never raw credential values.\n      - Use version 1 and secrets entries with id, env, purpose, required, and optional provider policy.\n      - Do not place Python resolver code under app/security/.\n  - path: app/security/production_operations.yaml\n    required: when_app_declares_production_or_hosted_operations\n    owner: AppGenerator_or_hosted_overlay\n    rules:\n      - Provider-neutral operational authority contract.\n      - No tenant ids, connection strings, tokens, or cloud resource secrets.\n      - Hosted products may extend with stricter operation classes through workspace build_context overlays.\n  - path: app/config/auth.yaml\n    required: when_auth_required_or_provider_configured\n    owner: AppGenerator\n    rules:\n      - Provider-neutral auth behavior lives here.\n      - Provider mechanics belong under app/services/adapters/auth/ only when the app itself owns the provider integration."},{"checksum":"sha256:5d0455ff281019505ee8881bae8fec282d71387777372264dec247109d045271","chunk_id":"chunk_3b0f56dc78a8047e","end_line":50,"path":"build_context/SecurityReadiness/baseline_security_controls.yaml","start_line":1,"symbol_ids":[],"text":"contract_id: security_readiness_baseline\ncontract_type: build_security_controls\nversion: 1\nmode: advisory\nselection_rules:\n  - id: always_review_generated_app_bundle\n    when:\n      artifact_family: app_bundle\n    action: inspect_after_app_generator\n  - id: [REDACTED]\n    when:\n      finding_source: generated_app_bundle\n    action: record_names_and_evidence_only\nrequired_checks:\n  - id: [REDACTED]\n    severity: critical\n    control_area: [REDACTED]\n    rule: [REDACTED] app files must not contain raw API keys, tokens, passwords, private keys, or webhook secret values.\n  - id: [REDACTED]\n    severity: high\n    control_area: [REDACTED]\n    rule: [REDACTED] may declare secret names, env handles, and provider policy only; it must not carry credential values.\n  - id: auth_contract_when_auth_required\n    severity: high\n    control_area: auth\n    rule: Apps that require authentication should declare app/config/auth.yaml or an equivalent app-level auth contract.\n  - id: module_permissions_declared\n    severity: high\n    control_area: permissions\n    rule: Module actions that expose private or mutating APIs must declare permissions that resolve to module.yaml permissions entries.\n  - id: tenant_scope_for_persistent_modules\n    severity: high\n    control_area: tenant_isolation\n    rule: Persistent multi-user modules should keep ownership/scope policy in backend/policy.py and use ctx.persistence through backend/repo.py.\n  - id: production_operations_when_deployable\n    severity: medium\n    control_area: deployment\n    rule: Deployable apps should declare production operation expectations instead of relying on hidden hosted defaults.\nforbidden_outputs:\n  - path_prefix: app/services/security/\n    reason: [REDACTED] policy belongs in app/security/secrets.yaml and generic secret resolution belongs in mozaiksai.core.secrets.\n  - path_prefix: app/build_context/\n    reason: Build context lives at workspace root build_context/, beside app/ and workflows/.\nruntime_boundaries:\n  - id: advisory_by_default\n    rule: OSS SecurityReadiness records findings and review evidence by default. Promotion blocking requires an explicit future policy switch.\n  - id: no_compliance_claims\n    rule: OSS readiness checks are not SOC2, ISO, HIPAA, or PCI certification claims.\n  - id: hosted_compliance_overlay\n    rule: Hosted product repos may add proprietary SOC2/ISO/evidence build contexts that apply to SecurityReadiness without forking the OSS workflow."},{"checksum":"sha256:aee76d607f9561bfee815e7a17e46234f7304f9c5678b9de50cd3f0c685629cd","chunk_id":"chunk_73b63705a51babf4","end_line":12,"path":"build_context/SecurityReadiness/context.yaml","start_line":1,"symbol_ids":[],"text":"context_id: SecurityReadiness\napplies_to_workflows:\n  - SecurityReadiness\nassets:\n  - path: baseline_security_controls.yaml\n    kind: contract\n  - path: app_security_file_contracts.yaml\n    kind: contract\n  - path: finding_taxonomy.yaml\n    kind: catalog\nprojections:\n  context_variables: {}"},{"checksum":"sha256:5c9262ae56f687e0a10976f9457138094f4323cc908f6d37ff2592567d7c5aa1","chunk_id":"chunk_2549f2c5c7495192","end_line":18,"path":"build_context/SecurityReadiness/finding_taxonomy.yaml","start_line":1,"symbol_ids":[],"text":"catalog_id: security_readiness_finding_taxonomy\nversion: 1\nstatuses: [open, accepted, resolved]\nseverities: [low, medium, high, critical]\nsources: [manual, validation, eval, import]\ncontrol_areas:\n  - auth\n  - secrets\n  - permissions\n  - tenant_isolation\n  - managed_capability_boundary\n  - deployment\n  - data_persistence\n  - evals\n  - compliance_readiness\nblocking_policy:\n  default_mode: advisory\n  advisory_blocking_definition: Open high or critical findings are highlighted as blocking candidates but do not block promotion in OSS."},{"checksum":"sha256:1a5e0910e180a9d4c6c0eac9ffe9a830d9d72e687a7d1efa1a00014bca7d1b18","chunk_id":"chunk_d0937e33ba85ef03","end_line":30,"path":"build_context/commerce/context.yaml","start_line":1,"symbol_ids":[],"text":"context_id: commerce\napplies_to_workflows:\n  - AppGenerator\nassets:\n  - path: contract.yaml\n    kind: contract\n  - path: templates/\n    kind: templates\npack:\n  id: commerce\n  version: \"0.1.11\"\n  status: active\n  capability_source: generated_module\ncapabilities:\n  - capability_id: commerce.products.browse\n    facade_recommended: commerce\n  - capability_id: commerce.products.manage\n    facade_recommended: commerce\n  - capability_id: commerce.inventory.manage\n    facade_recommended: commerce\n  - capability_id: commerce.cart.manage\n    facade_recommended: commerce\n  - capability_id: commerce.checkout.start\n    facade_recommended: commerce\n  - capability_id: commerce.orders.manage\n    facade_recommended: commerce\nprojections:\n  context_variables:\n    capability_packs:\n      from: capability_packs"},{"checksum":"sha256:2332ea1f2761b79a1dbc44ba13278cf6957ac0f13db95a90640120e042058438","chunk_id":"chunk_5a75748089af55ef","end_line":124,"path":"build_context/commerce/contract.yaml","start_line":1,"symbol_ids":[],"text":"contract_id: commerce\ncontract_type: build_pack_instructions\n\nselection_rules:\n  - id: select_for_ecommerce_apps\n    when:\n      intent_any:\n        - ecommerce\n        - e-commerce\n        - online store\n        - shop\n        - storefront\n        - product catalog\n        - cart\n        - checkout\n        - orders\n        - inventory\n    action: select_pack\n  - id: confirm_for_light_listing_apps\n    when:\n      intent_any:\n        - directory\n        - listings\n        - gallery\n        - showcase\n    action: require_explicit_user_confirmation\n\nrecommended_domains:\n  - commerce\n  - ecommerce\n  - storefront\n  - catalog\n  - orders\n  - inventory\n  - checkout\n\nrequired_outputs:\n  - path: data/migrations/001_commerce_collections.json\n    owner: templates\n  - path: modules/commerce/module.yaml\n    owner: templates\n  - path: modules/commerce/backend/__init__.py\n    owner: templates\n  - path: modules/commerce/backend/account_data_handler.py\n    owner: templates\n  - path: modules/commerce/backend/base_handler.py\n    owner: templates\n  - path: modules/commerce/backend/handler.py\n    owner: workspace  # preserved across regeneration; subclasses base_handler.py\n  - path: modules/commerce/backend/service.py\n    owner: templates\n  - path: modules/commerce/backend/repo.py\n    owner: templates\n  - path: modules/commerce/backend/policy.py\n    owner: templates\n  - path: modules/commerce/backend/schemas.py\n    owner: templates\n  - path: modules/commerce/contracts/events.yaml\n    owner: templates\n  - path: modules/commerce/contracts/admin.yaml\n    owner: templates\n  - path: modules/commerce/contracts/settings.yaml\n    owner: templates\n  - path: modules/commerce/contracts/reactions.yaml\n    owner: templates\n  - path: modules/commerce/contracts/notifications.yaml\n    owner: templates\n  - path: ui/pages/products.yaml\n    owner: templates\n  - path: ui/pages/product_detail.yaml\n    owner: templates\n  - path: ui/pages/cart.yaml\n    owner: templates\n  - path: ui/pages/orders.yaml\n    owner: templates\n\nforbidden_outputs:\n  - path_prefix: modules/ecommerce/\n  - path_prefix: modules/shop/\n  - path_prefix: modules/marketplace/\n  - path_prefix: modules/mozaikspay/\n  - path_prefix: modules/payment_provider/\n  - path_prefix: services/payments/\n  - path_prefix: services/adapters/payments/\n  - path_prefix: app/capability_packs/\n\nruntime_boundaries:\n  - id: persistence_layer\n    rule: Generated repo.py must use app_data_from_context and data aliases. No direct Motor clients and no hardcoded database names.\n  - id: payment_provider_boundary\n    rule: Commerce owns catalog, cart, orders, checkout requests, and fulfillment state. Payment provider mechanics stay in a selected payment capability pack or app-owned services/adapters/payments when the user explicitly brings a provider.\n  - id: checkout_event_boundary\n    rule: start_checkout emits domain.commerce.checkout.requested and returns an app-owned checkout request. Payment completion is recorded through the internal record_checkout_result action.\n  - id: inventory_authority\n    rule: Inventory is decremented only after successful checkout completion or an explicit inventory adjustment. Do not trust client-side totals.\n  - id: tenant_user_scope\n    rule: Cart and order queries must scope to the current actor unless the caller has commerce.orders.manage or ops.admin permission.\n  - id: idempotency\n    rule: Checkout completion handlers must accept provider_reference and avoid duplicate paid-order transitions.\n  - id: no_multi_vendor_assumptions\n    rule: This pack is single-merchant commerce. Seller onboarding, seller payouts, disputes, commissions, and seller-specific dashboards belong in a later commerce_marketplace overlay pack.\n  - id: dynamic_detail_routes\n    rule: Product detail routes that must read route params, poll checkout state, or branch on async response state should use custom_route_bundle. Declarative page schemas can still provide the products, cart, and orders operational surfaces.\n\nfacades: []\n\ncross_pack_integrations:\n  - pack: mozaikspay\n    description: >\n      When both commerce and mozaikspay are selected, the generated app can route\n      domain.commerce.checkout.requested to an app-owned MozaiksPay checkout facade.\n      Commerce never calls hosted payment internals directly.\n    optional: true\n    integration_surface:\n      - commerce_action: start_checkout\n        emitted_event: domain.commerce.checkout.requested\n        note: >\n          The payment facade creates the hosted checkout session from the order\n          snapshot and calls record_checkout_result after provider confirmation.\n      - commerce_action: record_checkout_result\n        trigger: checkout.session.completed\n        note: >\n          Internal app action that marks the order paid, records provider\n          metadata, decrements inventory, and emits domain.commerce.order.paid."},{"checksum":"sha256:a8e635a326c2c4ab324065462fa077caca1dcca3307629a09b1e153132d7c3a1","chunk_id":"chunk_bb9e7c1e0538ba88","end_line":98,"path":"build_context/commerce/templates/data/migrations/001_commerce_collections.json","start_line":1,"symbol_ids":[],"text":"{\n  \"migration_id\": \"commerce_001_collections\",\n  \"description\": \"Declare commerce catalog, cart, checkout, and order collections in the app data contract.\",\n  \"surfaces\": [\n    {\n      \"surface_id\": \"commerce\",\n      \"collections\": [\n        {\n          \"mongo_collection\": \"commerce_products\",\n          \"data_alias\": \"commerce.products\",\n          \"indexes\": [\n            {\n              \"name\": \"products_by_id\",\n              \"keys\": [{\"field\": \"product_id\", \"order\": 1}],\n              \"unique\": true\n            },\n            {\n              \"name\": \"products_by_status_updated\",\n              \"keys\": [{\"field\": \"status\", \"order\": 1}, {\"field\": \"updated_at\", \"order\": -1}]\n            },\n            {\n              \"name\": \"products_by_slug\",\n              \"keys\": [{\"field\": \"slug\", \"order\": 1}],\n              \"unique\": true,\n              \"sparse\": true\n            },\n            {\n              \"name\": \"products_by_category\",\n              \"keys\": [{\"field\": \"category\", \"order\": 1}, {\"field\": \"status\", \"order\": 1}]\n            }\n          ]\n        },\n        {\n          \"mongo_collection\": \"commerce_carts\",\n          \"data_alias\": \"commerce.carts\",\n          \"indexes\": [\n            {\n              \"name\": \"carts_by_id\",\n              \"keys\": [{\"field\": \"cart_id\", \"order\": 1}],\n              \"unique\": true\n            },\n            {\n              \"name\": \"carts_by_actor_status\",\n              \"keys\": [{\"field\": \"actor_id\", \"order\": 1}, {\"field\": \"status\", \"order\": 1}]\n            },\n            {\n              \"name\": \"carts_by_updated\",\n              \"keys\": [{\"field\": \"updated_at\", \"order\": -1}]\n            }\n          ]\n        },\n        {\n          \"mongo_collection\": \"commerce_orders\",\n          \"data_alias\": \"commerce.orders\",\n          \"indexes\": [\n            {\n              \"name\": \"orders_by_id\",\n              \"keys\": [{\"field\": \"order_id\", \"order\": 1}],\n              \"unique\": true\n            },\n            {\n              \"name\": \"orders_by_actor_created\",\n              \"keys\": [{\"field\": \"actor_id\", \"order\": 1}, {\"field\": \"created_at\", \"order\": -1}]\n            },\n            {\n              \"name\": \"orders_by_status_created\",\n              \"keys\": [{\"field\": \"status\", \"order\": 1}, {\"field\": \"created_at\", \"order\": -1}]\n            },\n            {\n              \"name\": \"orders_by_provider_reference\",\n              \"keys\": [{\"field\": \"payment.provider_reference\", \"order\": 1}],\n              \"sparse\": true\n            }\n          ]\n        },\n        {\n          \"mongo_collection\": \"commerce_checkout_requests\",\n          \"data_alias\": \"commerce.checkout_requests\",\n          \"indexes\": [\n            {\n              \"name\": \"checkout_requests_by_id\",\n              \"keys\": [{\"field\": \"checkout_id\", \"order\": 1}],\n              \"unique\": true\n            },\n            {\n              \"name\": \"checkout_requests_by_order\",\n              \"keys\": [{\"field\": \"order_id\", \"order\": 1}]\n            },\n            {\n              \"name\": \"checkout_requests_by_status_created\",\n              \"keys\": [{\"field\": \"status\", \"order\": 1}, {\"field\": \"created_at\", \"order\": -1}]\n            }\n          ]\n        }\n      ]\n    }\n  ]\n}"},{"checksum":"sha256:c8495da9cf5df9b308c9624f9d31bce36917308176eff3e1169b8359a3c8ccb8","chunk_id":"chunk_4ddd1ff204ef0003","end_line":1,"path":"build_context/commerce/templates/modules/commerce/backend/__init__.py","start_line":1,"symbol_ids":[],"text":"\"\"\"Generated commerce module package.\"\"\""},{"checksum":"sha256:ea6a5634b569a6943e804c4d2ff4dc1908efcf3dd1aa50a9bd4c3516f5010b72","chunk_id":"chunk_994a21db93eb054f","end_line":66,"path":"build_context/commerce/templates/modules/commerce/backend/account_data_handler.py","start_line":1,"symbol_ids":["sym_4d29226e99a630f9","sym_cbf57dd8747c55c4","sym_83a77f6c48e3e9b0","sym_92d851bdf38eb9cb"],"text":"from __future__ import annotations\n\nfrom typing import Any\n\n\nclass AccountDataHandler:\n    \"\"\"GDPR data handler for commerce module records.\n\n    Commerce stores user-linked data in three collections:\n      - carts (actor_id = the shopper)\n      - orders (actor_id = the buyer)\n      - checkout_requests (actor_id = the buyer)\n\n    Products are catalog data \u2014 not user-owned \u2014 and are excluded.\n\n    Note on order retention: tax and accounting regulations in many jurisdictions\n    require order records to be retained for 5\u20137 years even after a user data\n    deletion request. App operators should review applicable regulations and may\n    need to anonymise rather than hard-delete completed order records.\n    \"\"\"\n\n    def __init__(self, db: Any) -> None:\n        self._db = db\n\n    async def delete_user_data(self, *, app_id: str, user_id: str) -> dict[str, Any]:\n        \"\"\"Delete cart, order, and checkout request records owned by this user.\"\"\"\n        query = {\"app_id\": app_id, \"actor_id\": user_id}\n\n        carts_coll = self._db.get_collection(\"commerce\", \"carts\")\n        carts_result = await carts_coll.delete_many(query)\n        carts_deleted = int(getattr(carts_result, \"deleted_count\", 0) or 0)\n\n        orders_coll = self._db.get_collection(\"commerce\", \"orders\")\n        orders_result = await orders_coll.delete_many(query)\n        orders_deleted = int(getattr(orders_result, \"deleted_count\", 0) or 0)\n\n        checkout_coll = self._db.get_collection(\"commerce\", \"checkout_requests\")\n        checkout_result = await checkout_coll.delete_many(query)\n        checkout_deleted = int(getattr(checkout_result, \"deleted_count\", 0) or 0)\n\n        return {\n            \"module\": \"commerce\",\n            \"carts_deleted\": carts_deleted,\n            \"orders_deleted\": orders_deleted,\n            \"checkout_requests_deleted\": checkout_deleted,\n        }\n\n    async def export_user_data(self, *, app_id: str, user_id: str) -> dict[str, Any]:\n        \"\"\"Export cart, order, and checkout request records owned by this user.\"\"\"\n        query = {\"app_id\": app_id, \"actor_id\": user_id}\n\n        carts_coll = self._db.get_collection(\"commerce\", \"carts\")\n        cart = await carts_coll.find_one(query)\n\n        orders_coll = self._db.get_collection(\"commerce\", \"orders\")\n        orders = await orders_coll.find_many(query)\n\n        checkout_coll = self._db.get_collection(\"commerce\", \"checkout_requests\")\n        checkout_requests = await checkout_coll.find_many(query)\n\n        return {\n            \"module\": \"commerce\",\n            \"cart\": dict(cart) if cart else None,\n            \"orders\": [dict(o) for o in (orders or [])],\n            \"checkout_requests\": [dict(c) for c in (checkout_requests or [])],\n        }"},{"checksum":"sha256:5f7e71082607a9fa130ac37ef202959f9589f4cb9a514220cdb1e6ba0ffcefe1","chunk_id":"chunk_a59bce5f284230ed","end_line":63,"path":"build_context/commerce/templates/modules/commerce/backend/base_handler.py","start_line":1,"symbol_ids":["sym_4e4d72d9c8bd1e4d","sym_e75cb1f9a27f6858","sym_85a4a3122c689a40","sym_10ad1e8ccf2829fa","sym_cf9f0fa8fad25d76","sym_3b26f14940381ae9","sym_935dbb1ecb4e16c2","sym_c984234a784dd06b","sym_f26fbe67da5ba4d5","sym_f805c20d928bc2c0","sym_609118d72dc02fb0","sym_3b9e71a522540557","sym_715d12f7aa87dd25","sym_0399d9bfe90f2857","sym_deec7a07145d41d6","sym_746aaea2deccac47","sym_6cddeb487921f09c","sym_1d98d268480fe83b"],"text":"\"\"\"\nOSS-generated base handler for the commerce module.\nDO NOT EDIT \u2014 regenerated on framework upgrades.\nPut app-specific customizations in handler.py (the workspace subclass).\n\"\"\"\nfrom __future__ import annotations\n\nfrom typing import Any\n\nfrom .service import CommerceService\n\n\nclass CommerceBaseHandler:\n    def __init__(self, service: CommerceService | None = None) -> None:\n        self._service = service or CommerceService()\n\n    async def list_products(self, ctx, **kwargs: Any) -> dict[str, Any]:\n        return await self._service.list_products(ctx, **kwargs)\n\n    async def get_product(self, ctx, **kwargs: Any) -> dict[str, Any]:\n        return await self._service.get_product(ctx, **kwargs)\n\n    async def create_product(self, ctx, **kwargs: Any) -> dict[str, Any]:\n        return await self._service.create_product(ctx, **kwargs)\n\n    async def update_product(self, ctx, **kwargs: Any) -> dict[str, Any]:\n        return await self._service.update_product(ctx, **kwargs)\n\n    async def archive_product(self, ctx, *, product_id: str) -> dict[str, Any]:\n        return await self._service.archive_product(ctx, product_id=product_id)\n\n    async def adjust_inventory(self, ctx, **kwargs: Any) -> dict[str, Any]:\n        return await self._service.adjust_inventory(ctx, **kwargs)\n\n    async def get_cart(self, ctx) -> dict[str, Any]:\n        return await self._service.get_cart(ctx)\n\n    async def add_cart_item(self, ctx, **kwargs: Any) -> dict[str, Any]:\n        return await self._service.add_cart_item(ctx, **kwargs)\n\n    async def update_cart_item(self, ctx, **kwargs: Any) -> dict[str, Any]:\n        return await self._service.update_cart_item(ctx, **kwargs)\n\n    async def remove_cart_item(self, ctx, *, product_id: str) -> dict[str, Any]:\n        return await self._service.remove_cart_item(ctx, product_id=product_id)\n\n    async def clear_cart(self, ctx) -> dict[str, Any]:\n        return await self._service.clear_cart(ctx)\n\n    async def start_checkout(self, ctx, **kwargs: Any) -> dict[str, Any]:\n        return await self._service.start_checkout(ctx, **kwargs)\n\n    async def record_checkout_result(self, ctx, **kwargs: Any) -> dict[str, Any]:\n        return await self._service.record_checkout_result(ctx, **kwargs)\n\n    async def list_orders(self, ctx, **kwargs: Any) -> dict[str, Any]:\n        return await self._service.list_orders(ctx, **kwargs)\n\n    async def get_order(self, ctx, *, order_id: str) -> dict[str, Any]:\n        return await self._service.get_order(ctx, order_id=order_id)\n\n    async def update_order_status(self, ctx, **kwargs: Any) -> dict[str, Any]:\n        return await self._service.update_order_status(ctx, **kwargs)"},{"checksum":"sha256:73516751012e3fbbd377a09dbaf428de831ba062caa883b7e082331e9b985841","chunk_id":"chunk_ef890e91a9f794a4","end_line":12,"path":"build_context/commerce/templates/modules/commerce/backend/handler.py","start_line":1,"symbol_ids":["sym_eadf6ce174269f88"],"text":"\"\"\"\nWorkspace handler for the commerce module.\nSubclasses CommerceBaseHandler \u2014 add overrides and extra methods here.\nThis file is preserved across regeneration.\n\"\"\"\nfrom __future__ import annotations\n\nfrom .base_handler import CommerceBaseHandler\n\n\nclass CommerceHandler(CommerceBaseHandler):\n    \"\"\"App-local handler \u2014 extend or override base methods below.\"\"\""},{"checksum":"sha256:bef20168ede637f97bd046c0eecdf336466e468bbcd04e371827d1ae526f451d","chunk_id":"chunk_f20d5c552da977df","end_line":39,"path":"build_context/commerce/templates/modules/commerce/backend/policy.py","start_line":1,"symbol_ids":["sym_438521a4c03ffd52","sym_7d5a2aaa38b5c255","sym_fc6ff9bb3500460e","sym_59926cc2f5af3d9a","sym_4321ec58c4f500a9","sym_c2e223b3dcf2a926","sym_2917c147b7f8189d"],"text":"from __future__ import annotations\n\nfrom typing import Any\n\n\ndef actor_id(ctx) -> str:\n    return getattr(ctx, \"user_id\", None) or getattr(ctx, \"session_id\", None) or \"\"\n\n\ndef has_permission(ctx, permission: str) -> bool:\n    permissions = getattr(ctx, \"permissions\", None) or []\n    return permission in permissions or \"ops.admin\" in permissions\n\n\ndef can_manage_catalog(ctx) -> bool:\n    return has_permission(ctx, \"commerce.catalog.manage\")\n\n\ndef can_manage_orders(ctx) -> bool:\n    return has_permission(ctx, \"commerce.orders.manage\")\n\n\ndef product_visibility_query(ctx, *, status: str | None = None) -> dict[str, Any]:\n    if can_manage_catalog(ctx):\n        return {\"status\": status} if status else {}\n    return {\"status\": \"active\"}\n\n\ndef cart_scope_query(ctx) -> dict[str, Any]:\n    return {\"actor_id\": actor_id(ctx), \"status\": \"active\"}\n\n\ndef order_scope_query(ctx, *, status: str | None = None) -> dict[str, Any]:\n    query: dict[str, Any] = {}\n    if not can_manage_orders(ctx):\n        query[\"actor_id\"] = actor_id(ctx)\n    if status:\n        query[\"status\"] = status\n    return query"},{"checksum":"sha256:4aeca76b37a838911deb86678272cfbb64bdd3ad365bb5afed54a13e0f44f258","chunk_id":"chunk_1f7e8e78f3404183","end_line":142,"path":"build_context/commerce/templates/modules/commerce/backend/repo.py","start_line":1,"symbol_ids":["sym_4ec4e358663884a9","sym_12e7c8384cdb72a4","sym_1afdf88738226ed6","sym_885cbf1b036efb8e","sym_08199ccc08fb9a64","sym_34a3a2ec436e393d","sym_ed0681484aea8e0b","sym_8d81e31d8bf15943","sym_4dacfe24e4eddda0","sym_1db9fe7ab9b0bc2e","sym_144f1c96efce740c","sym_9dd4d60ebcfd4756","sym_7008290dd101a9f6","sym_e911ea4d6fbeb6f9","sym_c4b030833239db91","sym_138c9fdf82b2d455","sym_5ff1469d30db6fd3","sym_ff2ef0e9e38689de","sym_39b31393b9cf8199","sym_16d9e1902b4c88fb","sym_0cc7ef38ce854a0e","sym_9bc61d49566f7dde","sym_7fd69d98f81750ca"],"text":"from __future__ import annotations\n\nfrom collections.abc import Mapping\nfrom typing import Any\n\nfrom mozaiksai.core.runtime.persistence import app_data_from_context\n\n_PRODUCTS_ALIAS = \"commerce.products\"\n_CARTS_ALIAS = \"commerce.carts\"\n_ORDERS_ALIAS = \"commerce.orders\"\n_CHECKOUT_REQUESTS_ALIAS = \"commerce.checkout_requests\"\n\nDocument = dict[str, Any]\n\n\ndef _persistence(ctx):\n    return app_data_from_context(ctx)\n\n\ndef _normalize_doc(value: Any) -> Document | None:\n    return dict(value) if isinstance(value, dict) else None\n\n\ndef _normalize_docs(value: Any) -> list[Document]:\n    if not isinstance(value, list):\n        return []\n    return [dict(item) for item in value if isinstance(item, dict)]\n\n\nclass ProductRepo:\n    async def list(\n        self,\n        ctx,\n        *,\n        query: dict[str, Any],\n        limit: int,\n        before: str | None = None,\n    ) -> list[dict[str, Any]]:\n        if before:\n            query = {**query, \"updated_at\": {\"$lt\": before}}\n        col = _persistence(ctx).collection(_PRODUCTS_ALIAS)\n        cursor = col.find(query, {\"_id\": 0}).sort(\"updated_at\", -1).limit(limit)\n        return _normalize_docs(await cursor.to_list(length=limit))\n\n    async def get(self, ctx, *, product_id: str | None = None, slug: str | None = None) -> dict[str, Any] | None:\n        query: dict[str, Any] = {\"product_id\": product_id} if product_id else {\"slug\": slug}\n        col = _persistence(ctx).collection(_PRODUCTS_ALIAS)\n        return _normalize_doc(await col.find_one(query, {\"_id\": 0}))\n\n    async def insert(self, ctx, *, doc: Mapping[str, Any]) -> None:\n        await _persistence(ctx).collection(_PRODUCTS_ALIAS).insert_one(dict(doc))\n\n    async def update(self, ctx, *, product_id: str, updates: dict[str, Any]) -> dict[str, Any] | None:\n        col = _persistence(ctx).collection(_PRODUCTS_ALIAS)\n        await col.update_one({\"product_id\": product_id}, {\"$set\": dict(updates)})\n        return await self.get(ctx, product_id=product_id)\n\n    async def adjust_inventory(self, ctx, *, product_id: str, delta: int) -> dict[str, Any] | None:\n        col = _persistence(ctx).collection(_PRODUCTS_ALIAS)\n        await col.update_one(\n            {\"product_id\": product_id, \"track_inventory\": True},\n            {\"$inc\": {\"inventory_quantity\": int(delta)}},\n        )\n        return await self.get(ctx, product_id=product_id)\n\n    async def reserve_inventory(self, ctx, *, product_id: str, quantity: int) -> bool:\n        col = _persistence(ctx).collection(_PRODUCTS_ALIAS)\n        result = await col.update_one(\n            {\n                \"product_id\": product_id,\n                \"track_inventory\": True,\n                \"inventory_quantity\": {\"$gte\": int(quantity)},\n            },\n            {\"$inc\": {\"inventory_quantity\": -int(quantity)}},\n        )\n        return bool(result.modified_count)\n\n\nclass CartRepo:\n    async def get_active(self, ctx, *, actor_id: str) -> dict[str, Any] | None:\n        col = _persistence(ctx).collection(_CARTS_ALIAS)\n        return _normalize_doc(await col.find_one({\"actor_id\": actor_id, \"status\": \"active\"}, {\"_id\": 0}))\n\n    async def upsert_active(self, ctx, *, actor_id: str, cart: dict[str, Any]) -> dict[str, Any]:\n        col = _persistence(ctx).collection(_CARTS_ALIAS)\n        await col.update_one(\n            {\"actor_id\": actor_id, \"status\": \"active\"},\n            {\"$set\": dict(cart), \"$setOnInsert\": {\"cart_id\": cart[\"cart_id\"]}},\n            upsert=True,\n        )\n        saved = await self.get_active(ctx, actor_id=actor_id)\n        return saved or cart\n\n    async def mark_converted(self, ctx, *, cart_id: str, now: str) -> None:\n        col = _persistence(ctx).collection(_CARTS_ALIAS)\n        await col.update_one(\n            {\"cart_id\": cart_id},\n            {\"$set\": {\"status\": \"converted\", \"updated_at\": now}},\n        )\n\n\nclass OrderRepo:\n    async def insert(self, ctx, *, doc: Mapping[str, Any]) -> None:\n        await _persistence(ctx).collection(_ORDERS_ALIAS).insert_one(dict(doc))\n\n    async def list(\n        self,\n        ctx,\n        *,\n        query: dict[str, Any],\n        limit: int,\n        before: str | None = None,\n    ) -> list[dict[str, Any]]:\n        if before:\n            query = {**query, \"created_at\": {\"$lt\": before}}\n        col = _persistence(ctx).collection(_ORDERS_ALIAS)\n        cursor = col.find(query, {\"_id\": 0}).sort(\"created_at\", -1).limit(limit)\n        return _normalize_docs(await cursor.to_list(length=limit))\n\n    async def get(self, ctx, *, order_id: str) -> dict[str, Any] | None:\n        col = _persistence(ctx).collection(_ORDERS_ALIAS)\n        return _normalize_doc(await col.find_one({\"order_id\": order_id}, {\"_id\": 0}))\n\n    async def find_by_provider_reference(self, ctx, *, provider_reference: str) -> dict[str, Any] | None:\n        if not provider_reference:\n            return None\n        col = _persistence(ctx).collection(_ORDERS_ALIAS)\n        return _normalize_doc(await col.find_one({\"payment.provider_reference\": provider_reference}, {\"_id\": 0}))\n\n    async def update(self, ctx, *, order_id: str, updates: dict[str, Any]) -> dict[str, Any] | None:\n        col = _persistence(ctx).collection(_ORDERS_ALIAS)\n        await col.update_one({\"order_id\": order_id}, {\"$set\": dict(updates)})\n        return await self.get(ctx, order_id=order_id)\n\n\nclass CheckoutRequestRepo:\n    async def insert(self, ctx, *, doc: Mapping[str, Any]) -> None:\n        await _persistence(ctx).collection(_CHECKOUT_REQUESTS_ALIAS).insert_one(dict(doc))\n\n    async def update_status(self, ctx, *, order_id: str, updates: dict[str, Any]) -> None:\n        col = _persistence(ctx).collection(_CHECKOUT_REQUESTS_ALIAS)\n        await col.update_one({\"order_id\": order_id}, {\"$set\": dict(updates)})"},{"checksum":"sha256:f8131130c7d451f4cc25eb5ceb6c57f4e542fa2f7d783d0de4a65ba1cf793b96","chunk_id":"chunk_496b233b357c73c4","end_line":164,"path":"build_context/commerce/templates/modules/commerce/backend/schemas.py","start_line":1,"symbol_ids":["sym_3098bca82c88c8db","sym_e616c86193ae44f9","sym_ed3596adc2c9ba7a","sym_20b897bd6eb211e7","sym_0eeed1f233cc9a33","sym_5ff20245e95071ec","sym_841ef4dce6bf6f7a","sym_4c351f8479adab93","sym_6a8e5c70e609d7e4","sym_8c4684adc792485b","sym_ac3dd66897abbc15","sym_b50b15c78e0b79cb","sym_a13210aee69b84e2","sym_037d4dc17ebe9a0c","sym_c779efc03752d4ba"],"text":"from __future__ import annotations\n\nfrom datetime import UTC, datetime\nfrom decimal import ROUND_HALF_UP, Decimal\nfrom typing import Any, TypedDict\n\nPRODUCT_STATUSES = {\"draft\", \"active\", \"archived\"}\nCART_STATUS_ACTIVE = \"active\"\nCART_STATUS_CONVERTED = \"converted\"\nORDER_STATUSES = {\n    \"checkout_pending\",\n    \"paid\",\n    \"processing\",\n    \"fulfilled\",\n    \"cancelled\",\n    \"refunded\",\n    \"payment_failed\",\n    \"expired\",\n}\nCHECKOUT_RESULT_STATUSES = {\"paid\", \"failed\", \"cancelled\", \"expired\"}\nDEFAULT_CURRENCY = \"USD\"\n\n\nclass Product(TypedDict):\n    product_id: str\n    title: str\n    slug: str | None\n    description: str\n    category: str\n    sku: str | None\n    status: str\n    price_amount: int\n    currency: str\n    inventory_quantity: int | None\n    track_inventory: bool\n    image_url: str | None\n    created_by: str\n    created_at: str\n    updated_at: str\n\n\nclass CartItem(TypedDict):\n    product_id: str\n    title: str\n    sku: str | None\n    quantity: int\n    unit_amount: int\n    line_total: int\n    currency: str\n    track_inventory: bool\n\n\nclass Cart(TypedDict):\n    cart_id: str\n    actor_id: str\n    status: str\n    items: list[CartItem]\n    subtotal_amount: int\n    currency: str\n    created_at: str\n    updated_at: str\n\n\nclass Order(TypedDict):\n    order_id: str\n    actor_id: str\n    cart_id: str\n    status: str\n    items: list[CartItem]\n    subtotal_amount: int\n    total_amount: int\n    currency: str\n    payment: dict[str, Any]\n    fulfillment: dict[str, Any]\n    created_at: str\n    updated_at: str\n\n\ndef timestamp_now() -> str:\n    return datetime.now(UTC).isoformat()\n\n\ndef coerce_limit(value: Any, default: int = 20, maximum: int = 100) -> int:\n    try:\n        parsed = int(value)\n    except Exception:\n        parsed = default\n    return max(1, min(parsed, maximum))\n\n\ndef normalize_status(value: str | None, *, allowed: set[str], default: str) -> str:\n    status = str(value or default).strip().lower()\n    if status not in allowed:\n        raise ValueError(f\"invalid status: {value!r}\")\n    return status\n\n\ndef normalize_currency(value: str | None) -> str:\n    currency = str(value or DEFAULT_CURRENCY).strip().upper()\n    return currency[:3] if len(currency) >= 3 else DEFAULT_CURRENCY\n\n\ndef money_to_minor_units(value: Any) -> int:\n    try:\n        amount = Decimal(str(value or \"0\"))\n    except Exception:\n        amount = Decimal(\"0\")\n    cents = (amount * Decimal(\"100\")).quantize(Decimal(\"1\"), rounding=ROUND_HALF_UP)\n    return max(0, int(cents))\n\n\ndef minor_units_to_display(amount: Any, currency: str = DEFAULT_CURRENCY) -> str:\n    try:\n        cents = int(amount or 0)\n    except Exception:\n        cents = 0\n    return f\"{currency.upper()} {Decimal(cents) / Decimal('100'):.2f}\"\n\n\ndef coerce_quantity(value: Any, *, default: int = 1, maximum: int = 999) -> int:\n    try:\n        parsed = int(value)\n    except Exception:\n        parsed = default\n    return max(0, min(parsed, maximum))\n\n\ndef product_snapshot(product: dict[str, Any], quantity: int) -> CartItem:\n    unit_amount = int(product.get(\"price_amount\") or 0)\n    return {\n        \"product_id\": str(product.get(\"product_id\") or \"\"),\n        \"title\": str(product.get(\"title\") or \"Untitled product\"),\n        \"sku\": product.get(\"sku\") or None,\n        \"quantity\": quantity,\n        \"unit_amount\": unit_amount,\n        \"line_total\": unit_amount * quantity,\n        \"currency\": normalize_currency(product.get(\"currency\")),\n        \"track_inventory\": bool(product.get(\"track_inventory\")),\n    }\n\n\ndef recalculate_cart(cart: dict[str, Any]) -> dict[str, Any]:\n    items = list(cart.get(\"items\") or [])\n    subtotal = sum(int(item.get(\"line_total\") or 0) for item in items)\n    currency = items[0].get(\"currency\") if items else cart.get(\"currency\")\n    return {\n        **cart,\n        \"items\": items,\n        \"subtotal_amount\": subtotal,\n        \"subtotal_display\": minor_units_to_display(subtotal, normalize_currency(currency)),\n        \"currency\": normalize_currency(currency),\n    }\n\n\ndef serialize_product(product: dict[str, Any]) -> dict[str, Any]:\n    clean = dict(product)\n    clean[\"price_display\"] = minor_units_to_display(clean.get(\"price_amount\"), clean.get(\"currency\", DEFAULT_CURRENCY))\n    return clean\n\n\ndef serialize_order(order: dict[str, Any]) -> dict[str, Any]:\n    clean = dict(order)\n    clean[\"total_display\"] = minor_units_to_display(clean.get(\"total_amount\"), clean.get(\"currency\", DEFAULT_CURRENCY))\n    return clean"},{"checksum":"sha256:5448cd05b2f77a884cfca533e53cbc30687b03594df8be895d2709fcfc201263","chunk_id":"chunk_71708e6db317d71b","end_line":234,"path":"build_context/commerce/templates/modules/commerce/backend/service.py","start_line":1,"symbol_ids":["sym_b38737ae3bb81ebb","sym_170d0413ade6bf00","sym_459c6cb835de7174","sym_9e9b43da3d95be87","sym_094f1b3fdd5fcc12","sym_c2468bc13dd571dc","sym_8e9286a5dd9cd130","sym_2b63943fdd3d7996","sym_cc9bf4345803638b","sym_4d299bfa330a3dfa"],"text":"from __future__ import annotations\n\nimport re\nfrom typing import Any\nfrom uuid import uuid4\n\nfrom .policy import (\n    actor_id,\n    can_manage_catalog,\n    can_manage_orders,\n    order_scope_query,\n    product_visibility_query,\n)\nfrom .repo import CartRepo, CheckoutRequestRepo, OrderRepo, ProductRepo\nfrom .schemas import (\n    CART_STATUS_ACTIVE,\n    CHECKOUT_RESULT_STATUSES,\n    DEFAULT_CURRENCY,\n    ORDER_STATUSES,\n    PRODUCT_STATUSES,\n    coerce_limit,\n    coerce_quantity,\n    minor_units_to_display,\n    money_to_minor_units,\n    normalize_currency,\n    normalize_status,\n    product_snapshot,\n    recalculate_cart,\n    serialize_order,\n    serialize_product,\n    timestamp_now,\n)\n\n\ndef _clean_text(value: Any, *, max_length: int, default: str = \"\") -> str:\n    text = str(value or default).strip()\n    return text[:max_length]\n\n\ndef _slugify(value: str) -> str:\n    slug = re.sub(r\"[^a-z0-9]+\", \"-\", value.lower()).strip(\"-\")\n    return slug[:90] or str(uuid4())\n\n\ndef _require_actor(ctx) -> str | None:\n    actor = actor_id(ctx)\n    return actor or None\n\n\nclass CommerceService:\n    def __init__(\n        self,\n        products: ProductRepo | None = None,\n        carts: CartRepo | None = None,\n        orders: OrderRepo | None = None,\n        checkout_requests: CheckoutRequestRepo | None = None,\n    ) -> None:\n        self.products = products or ProductRepo()\n        self.carts = carts or CartRepo()\n        self.orders = orders or OrderRepo()\n        self.checkout_requests = checkout_requests or CheckoutRequestRepo()\n\n    # ---------------------------------------------------------------------\n    # Catalog\n    # ---------------------------------------------------------------------\n\n    async def list_products(\n        self,\n        ctx,\n        *,\n        search: str | None = None,\n        category: str | None = None,\n        status: str | None = None,\n        before: str | None = None,\n        limit: int = 20,\n    ) -> dict[str, Any]:\n        try:\n            requested_status = normalize_status(\n                status, allowed=PRODUCT_STATUSES, default=\"active\"\n            ) if status else None\n        except ValueError as exc:\n            return {\"products\": [], \"count\": 0, \"next_cursor\": None, \"error\": str(exc)}\n\n        query = product_visibility_query(ctx, status=requested_status)\n        clean_category = _clean_text(category, max_length=80)\n        if clean_category:\n            query[\"category\"] = clean_category\n        clean_search = _clean_text(search, max_length=100)\n        if clean_search:\n            query[\"$or\"] = [\n                {\"title\": {\"$regex\": clean_search, \"$options\": \"i\"}},\n                {\"description\": {\"$regex\": clean_search, \"$options\": \"i\"}},\n                {\"sku\": {\"$regex\": clean_search, \"$options\": \"i\"}},\n            ]\n\n        page_size = coerce_limit(limit, default=20)\n        rows = await self.products.list(ctx, query=query, limit=page_size + 1, before=before)\n        has_more = len(rows) > page_size\n        if has_more:\n            rows = rows[:page_size]\n        next_cursor = rows[-1][\"updated_at\"] if has_more and rows else None\n        return {\n            \"products\": [serialize_product(row) for row in rows],\n            \"count\": len(rows),\n            \"next_cursor\": next_cursor,\n        }\n\n    async def get_product(\n        self,\n        ctx,\n        *,\n        product_id: str | None = None,\n        slug: str | None = None,\n    ) -> dict[str, Any]:\n        if not product_id and not slug:\n            return {\"product\": None, \"error\": \"product_id or slug is required\"}\n        product = await self.products.get(ctx, product_id=product_id, slug=slug)\n        if not product:\n            return {\"product\": None, \"error\": \"product not found\"}\n        if not can_manage_catalog(ctx) and product.get(\"status\") != \"active\":\n            return {\"product\": None, \"error\": \"product not found\"}\n        return {\"product\": serialize_product(product)}\n\n    async def create_product(\n        self,\n        ctx,\n        *,\n        title: str,\n        price_amount: Any,\n        slug: str | None = None,\n        description: str = \"\",\n        category: str = \"\",\n        sku: str | None = None,\n        status: str = \"draft\",\n        currency: str = DEFAULT_CURRENCY,\n        inventory_quantity: int | None = None,\n        track_inventory: bool = False,\n        image_url: str | None = None,\n    ) -> dict[str, Any]:\n        actor = _require_actor(ctx)\n        if not actor:\n            return {\"success\": False, \"error\": \"user_id or session_id is required\"}\n\n        clean_title = _clean_text(title, max_length=140)\n        if not clean_title:\n            return {\"success\": False, \"error\": \"title is required\"}\n        try:\n            clean_status = normalize_status(status, allowed=PRODUCT_STATUSES, default=\"draft\")\n        except ValueError as exc:\n            return {\"success\": False, \"error\": str(exc)}\n\n        now = timestamp_now()\n        product = {\n            \"product_id\": str(uuid4()),\n            \"title\": clean_title,\n            \"slug\": _slugify(slug or clean_title),\n            \"description\": _clean_text(description, max_length=2000),\n            \"category\": _clean_text(category, max_length=80),\n            \"sku\": _clean_text(sku, max_length=80) or None,\n            \"status\": clean_status,\n            \"price_amount\": money_to_minor_units(price_amount),\n            \"currency\": normalize_currency(currency),\n            \"inventory_quantity\": max(0, int(inventory_quantity or 0)) if track_inventory else None,\n            \"track_inventory\": bool(track_inventory),\n            \"image_url\": _clean_text(image_url, max_length=1000) or None,\n            \"created_by\": actor,\n            \"created_at\": now,\n            \"updated_at\": now,\n        }\n        await self.products.insert(ctx, doc=product)\n        await ctx.emit(\n            \"domain.commerce.product.created\",\n            {\"product_id\": product[\"product_id\"], \"status\": product[\"status\"], \"created_by\": actor},\n        )\n        return {\"success\": True, \"product\": serialize_product(product)}\n\n    async def update_product(self, ctx, *, product_id: str, **fields: Any) -> dict[str, Any]:\n        product = await self.products.get(ctx, product_id=product_id)\n        if not product:\n            return {\"success\": False, \"error\": \"product not found\"}\n\n        updates: dict[str, Any] = {}\n        text_fields = {\n            \"title\": 140,\n            \"description\": 2000,\n            \"category\": 80,\n            \"sku\": 80,\n            \"image_url\": 1000,\n        }\n        for key, max_length in text_fields.items():\n            if key in fields and fields[key] is not None:\n                value = _clean_text(fields[key], max_length=max_length)\n                updates[key] = value or None if key in {\"sku\", \"image_url\"} else value\n        if \"slug\" in fields and fields[\"slug\"] is not None:\n            updates[\"slug\"] = _slugify(str(fields[\"slug\"]))\n        if \"status\" in fields and fields[\"status\"] is not None:\n            try:\n                updates[\"status\"] = normalize_status(\n                    fields[\"status\"], allowed=PRODUCT_STATUSES, default=product.get(\"status\", \"draft\")\n                )\n            except ValueError as exc:\n                return {\"success\": False, \"error\": str(exc)}\n        if \"price_amount\" in fields and fields[\"price_amount\"] is not None:\n            updates[\"price_amount\"] = money_to_minor_units(fields[\"price_amount\"])\n        if \"currency\" in fields and fields[\"currency\"] is not None:\n            updates[\"currency\"] = normalize_currency(fields[\"currency\"])\n        if \"track_inventory\" in fields and fields[\"track_inventory\"] is not None:\n            updates[\"track_inventory\"] = bool(fields[\"track_inventory\"])\n            if not updates[\"track_inventory\"]:\n                updates[\"inventory_quantity\"] = None\n        if \"inventory_quantity\" in fields and fields[\"inventory_quantity\"] is not None:\n            updates[\"inventory_quantity\"] = max(0, int(fields[\"inventory_quantity\"]))\n\n        if not updates:\n            return {\"success\": True, \"product\": serialize_product(product)}\n\n        updates[\"updated_at\"] = timestamp_now()\n        updated = await self.products.update(ctx, product_id=product_id, updates=updates)\n        await ctx.emit(\n            \"domain.commerce.product.updated\",\n            {\"product_id\": product_id, \"changes\": sorted(updates.keys()), \"updated_by\": actor_id(ctx)},\n        )\n        return {\"success\": True, \"product\": serialize_product(updated or product)}\n\n    async def archive_product(self, ctx, *, product_id: str) -> dict[str, Any]:\n        updated = await self.products.update(\n            ctx,\n            product_id=product_id,\n            updates={\"status\": \"archived\", \"updated_at\": timestamp_now()},\n        )\n        if not updated:\n            return {\"success\": False, \"error\": \"product not found\"}\n        await ctx.emit(\n            \"domain.commerce.product.archived\","},{"checksum":"sha256:2e2da729c53f8dab5f0af2a7a2ea6ce25e24c38c794d8cd3e3615e4559573899","chunk_id":"chunk_f6f432cfb39419ae","end_line":463,"path":"build_context/commerce/templates/modules/commerce/backend/service.py","start_line":235,"symbol_ids":["sym_9e9b43da3d95be87","sym_4d299bfa330a3dfa","sym_273b6ecf632f33d9","sym_9a7c91a2c43bc340","sym_207cf61404cac160","sym_436daffa7f1e9143","sym_243e818f0b5dcb3c","sym_84663ffb5661fec0","sym_3cd0ae12159b6513","sym_62adebc4b8874ae1"],"text":"            {\"product_id\": product_id, \"archived_by\": actor_id(ctx)},\n        )\n        return {\"success\": True, \"product\": serialize_product(updated)}\n\n    async def adjust_inventory(\n        self,\n        ctx,\n        *,\n        product_id: str,\n        delta: int,\n        reason: str | None = None,\n    ) -> dict[str, Any]:\n        product = await self.products.adjust_inventory(ctx, product_id=product_id, delta=int(delta))\n        if not product:\n            return {\"success\": False, \"error\": \"tracked product not found\"}\n        if int(product.get(\"inventory_quantity\") or 0) < 0:\n            product = await self.products.update(\n                ctx,\n                product_id=product_id,\n                updates={\"inventory_quantity\": 0, \"updated_at\": timestamp_now()},\n            )\n            if not product:\n                return {\"success\": False, \"error\": \"product not found\"}\n        await ctx.emit(\n            \"domain.commerce.inventory.adjusted\",\n            {\n                \"product_id\": product_id,\n                \"delta\": int(delta),\n                \"reason\": _clean_text(reason, max_length=240),\n                \"adjusted_by\": actor_id(ctx),\n            },\n        )\n        return {\"success\": True, \"product\": serialize_product(product)}\n\n    # ---------------------------------------------------------------------\n    # Cart\n    # ---------------------------------------------------------------------\n\n    async def get_cart(self, ctx) -> dict[str, Any]:\n        actor = _require_actor(ctx)\n        if not actor:\n            return {\"cart\": None, \"error\": \"user_id or session_id is required\"}\n        cart = await self._get_or_create_cart(ctx, actor=actor)\n        return {\"cart\": recalculate_cart(cart)}\n\n    async def add_cart_item(\n        self,\n        ctx,\n        *,\n        product_id: str,\n        quantity: int = 1,\n    ) -> dict[str, Any]:\n        actor = _require_actor(ctx)\n        if not actor:\n            return {\"success\": False, \"error\": \"user_id or session_id is required\"}\n        qty = coerce_quantity(quantity, default=1)\n        if qty <= 0:\n            return {\"success\": False, \"error\": \"quantity must be greater than zero\"}\n\n        product = await self._get_buyable_product(ctx, product_id=product_id)\n        if not product:\n            return {\"success\": False, \"error\": \"product is not available\"}\n\n        cart = await self._get_or_create_cart(ctx, actor=actor)\n        existing_qty = self._cart_quantity(cart, product_id=product_id)\n        desired_qty = existing_qty + qty\n        stock_error = self._stock_error(product, desired_qty)\n        if stock_error:\n            return {\"success\": False, \"error\": stock_error}\n\n        cart = self._replace_cart_item(cart, product=product, quantity=desired_qty)\n        saved = await self._save_cart(ctx, actor=actor, cart=cart)\n        await self._emit_cart_updated(ctx, saved)\n        return {\"success\": True, \"cart\": recalculate_cart(saved)}\n\n    async def update_cart_item(\n        self,\n        ctx,\n        *,\n        product_id: str,\n        quantity: int,\n    ) -> dict[str, Any]:\n        actor = _require_actor(ctx)\n        if not actor:\n            return {\"success\": False, \"error\": \"user_id or session_id is required\"}\n        qty = coerce_quantity(quantity, default=0)\n        cart = await self._get_or_create_cart(ctx, actor=actor)\n\n        if qty == 0:\n            cart[\"items\"] = [item for item in cart.get(\"items\", []) if item.get(\"product_id\") != product_id]\n        else:\n            product = await self._get_buyable_product(ctx, product_id=product_id)\n            if not product:\n                return {\"success\": False, \"error\": \"product is not available\"}\n            stock_error = self._stock_error(product, qty)\n            if stock_error:\n                return {\"success\": False, \"error\": stock_error}\n            cart = self._replace_cart_item(cart, product=product, quantity=qty)\n\n        saved = await self._save_cart(ctx, actor=actor, cart=cart)\n        await self._emit_cart_updated(ctx, saved)\n        return {\"success\": True, \"cart\": recalculate_cart(saved)}\n\n    async def remove_cart_item(self, ctx, *, product_id: str) -> dict[str, Any]:\n        return await self.update_cart_item(ctx, product_id=product_id, quantity=0)\n\n    async def clear_cart(self, ctx) -> dict[str, Any]:\n        actor = _require_actor(ctx)\n        if not actor:\n            return {\"success\": False, \"error\": \"user_id or session_id is required\"}\n        cart = await self._get_or_create_cart(ctx, actor=actor)\n        cart[\"items\"] = []\n        saved = await self._save_cart(ctx, actor=actor, cart=cart)\n        await self._emit_cart_updated(ctx, saved)\n        return {\"success\": True, \"cart\": recalculate_cart(saved)}\n\n    # ---------------------------------------------------------------------\n    # Checkout and orders\n    # ---------------------------------------------------------------------\n\n    async def start_checkout(\n        self,\n        ctx,\n        *,\n        payment_provider: str = \"mozaikspay\",\n        success_url: str = \"\",\n        cancel_url: str = \"\",\n    ) -> dict[str, Any]:\n        actor = _require_actor(ctx)\n        if not actor:\n            return {\"success\": False, \"error\": \"user_id or session_id is required\"}\n        cart = recalculate_cart(await self._get_or_create_cart(ctx, actor=actor))\n        items = list(cart.get(\"items\") or [])\n        if not items:\n            return {\"success\": False, \"error\": \"cart is empty\"}\n\n        stock_error = await self._validate_cart_stock(ctx, items)\n        if stock_error:\n            return {\"success\": False, \"error\": stock_error}\n\n        now = timestamp_now()\n        order_id = str(uuid4())\n        checkout_id = str(uuid4())\n        provider = _clean_text(payment_provider, max_length=80, default=\"mozaikspay\") or \"mozaikspay\"\n        currency = normalize_currency(cart.get(\"currency\"))\n        total_amount = int(cart.get(\"subtotal_amount\") or 0)\n        order = {\n            \"order_id\": order_id,\n            \"actor_id\": actor,\n            \"cart_id\": cart[\"cart_id\"],\n            \"status\": \"checkout_pending\",\n            \"items\": items,\n            \"subtotal_amount\": total_amount,\n            \"total_amount\": total_amount,\n            \"total_display\": minor_units_to_display(total_amount, currency),\n            \"currency\": currency,\n            \"payment\": {\n                \"provider\": provider,\n                \"status\": \"pending\",\n                \"provider_reference\": None,\n                \"checkout_id\": checkout_id,\n            },\n            \"fulfillment\": {\"status\": \"not_started\", \"updated_at\": None},\n            \"created_at\": now,\n            \"updated_at\": now,\n        }\n        checkout_request = {\n            \"checkout_id\": checkout_id,\n            \"order_id\": order_id,\n            \"actor_id\": actor,\n            \"cart_id\": cart[\"cart_id\"],\n            \"status\": \"requested\",\n            \"payment_provider\": provider,\n            \"amount\": total_amount,\n            \"currency\": currency,\n            \"success_url\": _clean_text(success_url, max_length=1000),\n            \"cancel_url\": _clean_text(cancel_url, max_length=1000),\n            \"created_at\": now,\n            \"updated_at\": now,\n        }\n        await self.orders.insert(ctx, doc=order)\n        await self.checkout_requests.insert(ctx, doc=checkout_request)\n        await self.carts.mark_converted(ctx, cart_id=cart[\"cart_id\"], now=now)\n        await ctx.emit(\n            \"domain.commerce.checkout.requested\",\n            {\n                \"checkout_id\": checkout_id,\n                \"order_id\": order_id,\n                \"actor_id\": actor,\n                \"payment_provider\": provider,\n                \"amount\": total_amount,\n                \"currency\": currency,\n            },\n        )\n        return {\n            \"success\": True,\n            \"order\": serialize_order(order),\n            \"checkout_request\": checkout_request,\n        }\n\n    async def record_checkout_result(\n        self,\n        ctx,\n        *,\n        order_id: str,\n        status: str,\n        provider: str = \"\",\n        provider_reference: str = \"\",\n        raw_event: dict[str, Any] | None = None,\n    ) -> dict[str, Any]:\n        try:\n            result_status = normalize_status(\n                status, allowed=CHECKOUT_RESULT_STATUSES, default=\"failed\"\n            )\n        except ValueError as exc:\n            return {\"success\": False, \"error\": str(exc), \"order\": None}\n\n        existing_by_reference = await self.orders.find_by_provider_reference(\n            ctx, provider_reference=provider_reference\n        )\n        if existing_by_reference and existing_by_reference.get(\"order_id\") != order_id:\n            return {\n                \"success\": True,\n                \"idempotent\": True,\n                \"order\": serialize_order(existing_by_reference),\n            }\n\n        order = await self.orders.get(ctx, order_id=order_id)\n        if not order:"},{"checksum":"sha256:5ec9b698bade2b3fe8765ae3e32d96adbfbf08030255cc488584cf73693bd1f8","chunk_id":"chunk_741895b9386093fc","end_line":676,"path":"build_context/commerce/templates/modules/commerce/backend/service.py","start_line":464,"symbol_ids":["sym_9e9b43da3d95be87","sym_62adebc4b8874ae1","sym_74dea7e2d875f6f3","sym_6d705ca2cae0c718","sym_066438118b22915f","sym_07cf1bdeb0291513","sym_2eb351080fd93c3d","sym_576b7745b5d8c151","sym_5735218387f8b5c1","sym_f8cde42eb15fba4c","sym_c21c021f78344ce0","sym_d6db057ffc6c2534","sym_0d152a8a074c2210"],"text":"            return {\"success\": False, \"error\": \"order not found\", \"order\": None}\n\n        already_paid = order.get(\"status\") == \"paid\" or (order.get(\"payment\") or {}).get(\"status\") == \"paid\"\n        if result_status == \"paid\" and not already_paid:\n            reserve_error = await self._reserve_order_inventory(ctx, order)\n            if reserve_error:\n                return {\"success\": False, \"error\": reserve_error, \"order\": serialize_order(order)}\n\n        now = timestamp_now()\n        mapped_order_status = {\n            \"paid\": \"paid\",\n            \"failed\": \"payment_failed\",\n            \"cancelled\": \"cancelled\",\n            \"expired\": \"expired\",\n        }[result_status]\n        payment = dict(order.get(\"payment\") or {})\n        payment.update(\n            {\n                \"provider\": _clean_text(provider, max_length=80) or payment.get(\"provider\"),\n                \"status\": result_status,\n                \"provider_reference\": _clean_text(provider_reference, max_length=160) or payment.get(\"provider_reference\"),\n                \"updated_at\": now,\n            }\n        )\n        updates = {\n            \"status\": mapped_order_status,\n            \"payment\": payment,\n            \"updated_at\": now,\n        }\n        if raw_event:\n            updates[\"payment_event\"] = {\n                \"received_at\": now,\n                \"event_type\": _clean_text(raw_event.get(\"type\") if isinstance(raw_event, dict) else None, max_length=120),\n            }\n\n        updated = await self.orders.update(ctx, order_id=order_id, updates=updates)\n        await self.checkout_requests.update_status(\n            ctx,\n            order_id=order_id,\n            updates={\"status\": result_status, \"updated_at\": now},\n        )\n        event_type = \"domain.commerce.order.paid\" if result_status == \"paid\" else \"domain.commerce.checkout.failed\"\n        await ctx.emit(\n            event_type,\n            {\n                \"order_id\": order_id,\n                \"status\": mapped_order_status,\n                \"payment_provider\": payment.get(\"provider\"),\n                \"provider_reference\": payment.get(\"provider_reference\"),\n            },\n        )\n        return {\"success\": True, \"order\": serialize_order(updated or {**order, **updates})}\n\n    async def list_orders(\n        self,\n        ctx,\n        *,\n        status: str | None = None,\n        before: str | None = None,\n        limit: int = 20,\n    ) -> dict[str, Any]:\n        if not can_manage_orders(ctx) and not _require_actor(ctx):\n            return {\"orders\": [], \"count\": 0, \"next_cursor\": None, \"error\": \"user_id or session_id is required\"}\n        try:\n            clean_status = normalize_status(status, allowed=ORDER_STATUSES, default=\"paid\") if status else None\n        except ValueError as exc:\n            return {\"orders\": [], \"count\": 0, \"next_cursor\": None, \"error\": str(exc)}\n        query = order_scope_query(ctx, status=clean_status)\n        page_size = coerce_limit(limit, default=20)\n        rows = await self.orders.list(ctx, query=query, limit=page_size + 1, before=before)\n        has_more = len(rows) > page_size\n        if has_more:\n            rows = rows[:page_size]\n        next_cursor = rows[-1][\"created_at\"] if has_more and rows else None\n        return {\n            \"orders\": [serialize_order(row) for row in rows],\n            \"count\": len(rows),\n            \"next_cursor\": next_cursor,\n        }\n\n    async def get_order(self, ctx, *, order_id: str) -> dict[str, Any]:\n        order = await self.orders.get(ctx, order_id=order_id)\n        if not order:\n            return {\"order\": None, \"error\": \"order not found\"}\n        if not can_manage_orders(ctx) and order.get(\"actor_id\") != actor_id(ctx):\n            return {\"order\": None, \"error\": \"order not found\"}\n        return {\"order\": serialize_order(order)}\n\n    async def update_order_status(\n        self,\n        ctx,\n        *,\n        order_id: str,\n        status: str,\n        note: str | None = None,\n    ) -> dict[str, Any]:\n        order = await self.orders.get(ctx, order_id=order_id)\n        if not order:\n            return {\"success\": False, \"error\": \"order not found\", \"order\": None}\n        allowed = {\"processing\", \"fulfilled\", \"cancelled\", \"refunded\"}\n        try:\n            clean_status = normalize_status(status, allowed=allowed, default=order.get(\"status\", \"processing\"))\n        except ValueError as exc:\n            return {\"success\": False, \"error\": str(exc), \"order\": serialize_order(order)}\n        now = timestamp_now()\n        fulfillment = dict(order.get(\"fulfillment\") or {})\n        fulfillment.update(\n            {\n                \"status\": clean_status,\n                \"note\": _clean_text(note, max_length=500),\n                \"updated_at\": now,\n                \"updated_by\": actor_id(ctx),\n            }\n        )\n        updated = await self.orders.update(\n            ctx,\n            order_id=order_id,\n            updates={\"status\": clean_status, \"fulfillment\": fulfillment, \"updated_at\": now},\n        )\n        await ctx.emit(\n            \"domain.commerce.order.updated\",\n            {\"order_id\": order_id, \"status\": clean_status, \"updated_by\": actor_id(ctx)},\n        )\n        return {\"success\": True, \"order\": serialize_order(updated or order)}\n\n    # ---------------------------------------------------------------------\n    # Helpers\n    # ---------------------------------------------------------------------\n\n    async def _get_buyable_product(self, ctx, *, product_id: str) -> dict[str, Any] | None:\n        product = await self.products.get(ctx, product_id=product_id)\n        if not product or product.get(\"status\") != \"active\":\n            return None\n        return product\n\n    async def _get_or_create_cart(self, ctx, *, actor: str) -> dict[str, Any]:\n        existing = await self.carts.get_active(ctx, actor_id=actor)\n        if existing:\n            return recalculate_cart(existing)\n        now = timestamp_now()\n        return {\n            \"cart_id\": str(uuid4()),\n            \"actor_id\": actor,\n            \"status\": CART_STATUS_ACTIVE,\n            \"items\": [],\n            \"subtotal_amount\": 0,\n            \"currency\": DEFAULT_CURRENCY,\n            \"created_at\": now,\n            \"updated_at\": now,\n        }\n\n    async def _save_cart(self, ctx, *, actor: str, cart: dict[str, Any]) -> dict[str, Any]:\n        now = timestamp_now()\n        cart = recalculate_cart({**cart, \"status\": CART_STATUS_ACTIVE, \"updated_at\": now})\n        return await self.carts.upsert_active(ctx, actor_id=actor, cart=cart)\n\n    @staticmethod\n    def _cart_quantity(cart: dict[str, Any], *, product_id: str) -> int:\n        for item in cart.get(\"items\") or []:\n            if item.get(\"product_id\") == product_id:\n                return int(item.get(\"quantity\") or 0)\n        return 0\n\n    @staticmethod\n    def _replace_cart_item(\n        cart: dict[str, Any],\n        *,\n        product: dict[str, Any],\n        quantity: int,\n    ) -> dict[str, Any]:\n        product_id = product[\"product_id\"]\n        items = [item for item in cart.get(\"items\", []) if item.get(\"product_id\") != product_id]\n        items.append(product_snapshot(product, quantity))\n        return recalculate_cart({**cart, \"items\": items})\n\n    @staticmethod\n    def _stock_error(product: dict[str, Any], quantity: int) -> str | None:\n        if not product.get(\"track_inventory\"):\n            return None\n        available = int(product.get(\"inventory_quantity\") or 0)\n        if available < quantity:\n            return f\"only {available} available\"\n        return None\n\n    async def _validate_cart_stock(self, ctx, items: list[dict[str, Any]]) -> str | None:\n        for item in items:\n            if not item.get(\"track_inventory\"):\n                continue\n            product = await self.products.get(ctx, product_id=item.get(\"product_id\"))\n            if not product or product.get(\"status\") != \"active\":\n                return f\"{item.get('title') or 'product'} is no longer available\"\n            error = self._stock_error(product, int(item.get(\"quantity\") or 0))\n            if error:\n                return f\"{item.get('title') or 'product'}: {error}\"\n        return None\n\n    async def _reserve_order_inventory(self, ctx, order: dict[str, Any]) -> str | None:\n        reserved: list[tuple[str, int]] = []\n        for item in order.get(\"items\") or []:\n            if not item.get(\"track_inventory\"):\n                continue\n            product_id = str(item.get(\"product_id\") or \"\")\n            quantity = int(item.get(\"quantity\") or 0)\n            if quantity <= 0:\n                continue\n            ok = await self.products.reserve_inventory(ctx, product_id=product_id, quantity=quantity)\n            if ok:\n                reserved.append((product_id, quantity))\n                continue\n            for reserved_product_id, reserved_quantity in reserved:\n                await self.products.adjust_inventory(\n                    ctx,\n                    product_id=reserved_product_id,"},{"checksum":"sha256:46f7b5b8b0c78f75db20ea7700003f42d280f6948fecdfc96f416cbde3c735d7","chunk_id":"chunk_4518dac10ad212e3","end_line":691,"path":"build_context/commerce/templates/modules/commerce/backend/service.py","start_line":677,"symbol_ids":["sym_9e9b43da3d95be87","sym_0d152a8a074c2210","sym_87809e9b16f0c8d3"],"text":"                    delta=reserved_quantity,\n                )\n            return f\"{item.get('title') or 'product'} no longer has enough inventory\"\n        return None\n\n    async def _emit_cart_updated(self, ctx, cart: dict[str, Any]) -> None:\n        await ctx.emit(\n            \"domain.commerce.cart.updated\",\n            {\n                \"cart_id\": cart[\"cart_id\"],\n                \"actor_id\": cart[\"actor_id\"],\n                \"item_count\": len(cart.get(\"items\") or []),\n                \"subtotal_amount\": int(cart.get(\"subtotal_amount\") or 0),\n            },\n        )"},{"checksum":"sha256:f5fca9bed04b4ace5608fd6fa0d3c0d90f7a9deaa8c05a1375cbc83b28afb4e7","chunk_id":"chunk_2e6e1086097f667d","end_line":68,"path":"build_context/commerce/templates/modules/commerce/contracts/admin.yaml","start_line":1,"symbol_ids":[],"text":"schema_version: mozaiks.admin.v1\npanels:\n  - id: commerce_catalog_panel\n    title: Commerce Catalog\n    description: Manage products, publication status, prices, categories, SKUs, and inventory policy.\n    module: commerce\n    actions:\n      - id: list_products\n        label: List Products\n        input_overrides:\n          status: active\n          limit: 50\n      - id: create_product\n        label: Create Product\n      - id: update_product\n        label: Update Product\n      - id: archive_product\n        label: Archive Product\n        confirm: true\n        confirm_message: \"Archive this product and remove it from storefront browsing?\"\n    filters:\n      - field: status\n        label: Status\n        options: [Active, Draft, Archived]\n        map: { Active: active, Draft: draft, Archived: archived }\n      - field: category\n        label: Category\n        options: []\n    permissions: [commerce.catalog.manage, ops.admin]\n\n  - id: commerce_inventory_panel\n    title: Inventory\n    description: Review stock on tracked products and apply manual stock adjustments.\n    module: commerce\n    actions:\n      - id: list_products\n        label: List Tracked Products\n        input_overrides:\n          limit: 50\n      - id: adjust_inventory\n        label: Adjust Inventory\n    permissions: [commerce.inventory.manage, ops.admin]\n\n  - id: commerce_orders_panel\n    title: Orders\n    description: Review orders, payment state, and fulfillment status.\n    module: commerce\n    actions:\n      - id: list_orders\n        label: List Orders\n        input_overrides:\n          limit: 50\n      - id: get_order\n        label: View Order\n      - id: update_order_status\n        label: Update Fulfillment\n    filters:\n      - field: status\n        label: Status\n        options: [Paid, Processing, Fulfilled, Cancelled, Refunded, Payment Failed]\n        map:\n          Paid: paid\n          Processing: processing\n          Fulfilled: fulfilled\n          Cancelled: cancelled\n          Refunded: refunded\n          Payment Failed: payment_failed\n    permissions: [commerce.orders.manage, ops.admin]"},{"checksum":"sha256:8dfaf69319f18221b5fcb634973faa25c2ffe3f0aaccb81e454e3a03343dd3a8","chunk_id":"chunk_1502e5230c4e805e","end_line":119,"path":"build_context/commerce/templates/modules/commerce/contracts/events.yaml","start_line":1,"symbol_ids":[],"text":"schema_version: mozaiks.events.v1\nevents:\n  - type: domain.commerce.product.created\n    version: 1\n    description: Emitted after a product is created.\n    producer: commerce\n    payload_schema:\n      type: object\n      required: [product_id, status, created_by]\n      properties:\n        product_id: { type: string }\n        status: { type: string }\n        created_by: { type: string }\n\n  - type: domain.commerce.product.updated\n    version: 1\n    description: Emitted after product metadata, price, status, or inventory policy changes.\n    producer: commerce\n    payload_schema:\n      type: object\n      required: [product_id, changes, updated_by]\n      properties:\n        product_id: { type: string }\n        changes:\n          type: array\n          items: { type: string }\n        updated_by: { type: string }\n\n  - type: domain.commerce.product.archived\n    version: 1\n    description: Emitted after a product is removed from storefront browse results.\n    producer: commerce\n    payload_schema:\n      type: object\n      required: [product_id, archived_by]\n      properties:\n        product_id: { type: string }\n        archived_by: { type: string }\n\n  - type: domain.commerce.inventory.adjusted\n    version: 1\n    description: Emitted after an operator manually changes tracked inventory.\n    producer: commerce\n    payload_schema:\n      type: object\n      required: [product_id, delta, adjusted_by]\n      properties:\n        product_id: { type: string }\n        delta: { type: integer }\n        reason: { type: string }\n        adjusted_by: { type: string }\n\n  - type: domain.commerce.cart.updated\n    version: 1\n    description: Emitted after a viewer changes cart contents.\n    producer: commerce\n    payload_schema:\n      type: object\n      required: [cart_id, actor_id, item_count, subtotal_amount]\n      properties:\n        cart_id: { type: string }\n        actor_id: { type: string }\n        item_count: { type: integer }\n        subtotal_amount: { type: integer }\n\n  - type: domain.commerce.checkout.requested\n    version: 1\n    description: >\n      Emitted when commerce snapshots a cart into an order and requests a\n      payment facade to create the external checkout session.\n    producer: commerce\n    payload_schema:\n      type: object\n      required: [checkout_id, order_id, actor_id, payment_provider, amount, currency]\n      properties:\n        checkout_id: { type: string }\n        order_id: { type: string }\n        actor_id: { type: string }\n        payment_provider: { type: string }\n        amount: { type: integer }\n        currency: { type: string }\n\n  - type: domain.commerce.order.paid\n    version: 1\n    description: Emitted after an internal payment facade marks an order paid.\n    producer: commerce\n    payload_schema:\n      type: object\n      required: [order_id, status]\n      properties:\n        order_id: { type: string }\n        status: { type: string }\n        payment_provider: { type: string }\n        provider_reference: { type: string }\n\n  - type: domain.commerce.checkout.failed\n    version: 1\n    description: Emitted after checkout fails, is cancelled, or expires.\n    producer: commerce\n    payload_schema:\n      type: object\n      required: [order_id, status]\n      properties:\n        order_id: { type: string }\n        status: { type: string }\n        payment_provider: { type: string }\n        provider_reference: { type: string }\n\n  - type: domain.commerce.order.updated\n    version: 1\n    description: Emitted after fulfillment or order state changes.\n    producer: commerce\n    payload_schema:\n      type: object\n      required: [order_id, status, updated_by]\n      properties:\n        order_id: { type: string }\n        status: { type: string }\n        updated_by: { type: string }"},{"checksum":"sha256:77d173bfdceedff35d6a11f99be1a46303b8d66dc22a3dd15e1545568c36c81f","chunk_id":"chunk_54033b7380053e39","end_line":33,"path":"build_context/commerce/templates/modules/commerce/contracts/notifications.yaml","start_line":1,"symbol_ids":[],"text":"schema_version: mozaiks.notifications.v1\nnotifications:\n  - id: commerce_order_receipt\n    description: Notify the buyer after a successful payment.\n    event_type: domain.commerce.order.paid\n    channels:\n      - in_app\n    audience:\n      user_id_field: buyer_id\n    template:\n      title: \"Order confirmed\"\n      body: \"Your order {{order_id}} has been paid successfully.\"\n    context_fields:\n      - order_id\n      - status\n      - payment_provider\n      - provider_reference\n\n  - id: commerce_checkout_failed\n    description: Notify the buyer when checkout fails, expires, or is cancelled.\n    event_type: domain.commerce.checkout.failed\n    channels:\n      - in_app\n    audience:\n      user_id_field: buyer_id\n    template:\n      title: \"Checkout unsuccessful\"\n      body: \"Your checkout for order {{order_id}} could not be completed.\"\n    context_fields:\n      - order_id\n      - status\n      - payment_provider\n      - provider_reference"},{"checksum":"sha256:625769fbef149e7b5cc3117ecc9be7871144ab8f75c6aa881fa7e00d780cb35a","chunk_id":"chunk_1f3c7c554460869d","end_line":25,"path":"build_context/commerce/templates/modules/commerce/contracts/reactions.yaml","start_line":1,"symbol_ids":[],"text":"schema_version: mozaiks.reactions.v1\nreactions:\n  - id: commerce_checkout_requested_payment_facade\n    event_type: domain.commerce.checkout.requested\n    target:\n      kind: capability\n      capability_id: mozaikspay.checkout.create_session\n    description: >\n      Optional managed-payment bridge. When the mozaikspay pack is selected,\n      this reaction lets the payment facade create a provider checkout session\n      and call commerce.record_checkout_result after completion.\n\n  - id: commerce_paid_order_receipt\n    event_type: domain.commerce.order.paid\n    target:\n      kind: notification\n      notification_id: commerce_order_receipt\n    description: Notify the buyer and operators after payment succeeds.\n\n  - id: commerce_checkout_failed_notification\n    event_type: domain.commerce.checkout.failed\n    target:\n      kind: notification\n      notification_id: commerce_checkout_failed\n    description: Notify the buyer when checkout fails, expires, or is cancelled."},{"checksum":"sha256:ea4e7926eb5d02606c51c66ffe9f80ff12c2b972b20fa86e633420cb2681beea","chunk_id":"chunk_1d75f3e2ca464fbc","end_line":36,"path":"build_context/commerce/templates/modules/commerce/contracts/settings.yaml","start_line":1,"symbol_ids":[],"text":"schema_version: mozaiks.settings.v1\nsettings:\n  - id: commerce.catalog.default_currency\n    label: Default currency\n    description: Currency used when generated app operators create products without specifying a currency.\n    type: string\n    default: USD\n    scope: app\n\n  - id: commerce.catalog.require_inventory_for_publish\n    label: Require inventory for publish\n    description: Require tracked products to have positive inventory before publishing.\n    type: boolean\n    default: false\n    scope: app\n\n  - id: commerce.checkout.default_provider\n    label: Default checkout provider\n    description: Payment facade identifier requested by commerce checkout events.\n    type: string\n    default: mozaikspay\n    scope: app\n\n  - id: commerce.orders.email_receipts\n    label: Email receipts\n    description: Send receipts when an order is marked paid by the payment facade.\n    type: boolean\n    default: true\n    scope: app\n\n  - id: commerce.orders.operator_notifications\n    label: Operator order notifications\n    description: Notify commerce operators when paid orders need fulfillment.\n    type: boolean\n    default: true\n    scope: app"},{"checksum":"sha256:451d28622f0aefd2ec3c76844dd9a42aa09f28a927c575b71f8c91455504c9a8","chunk_id":"chunk_1dd0603dc772728c","end_line":274,"path":"build_context/commerce/templates/modules/commerce/module.yaml","start_line":1,"symbol_ids":[],"text":"schema_version: mozaiks.module.v1\nmodule:\n  id: commerce\n  display_name: Commerce\n  version: 1.0.0\n  description: Product catalog, inventory, cart, checkout request, order, and fulfillment state for generated commerce apps.\n  owner: app\n  visibility: app\n  type: standard\n  handler: backend.handler:CommerceHandler\n  user_data_scope: true\n\npermissions:\n  - id: commerce.catalog.read\n    description: Browse published products and read public catalog details.\n  - id: commerce.catalog.manage\n    description: Create, edit, publish, and archive products.\n  - id: commerce.inventory.manage\n    description: Adjust stock and inventory policy for products.\n  - id: commerce.cart.manage\n    description: Read and mutate the current viewer's cart.\n  - id: commerce.checkout.start\n    description: Start checkout for the current viewer's cart.\n  - id: commerce.orders.read\n    description: Read orders owned by the current viewer.\n  - id: commerce.orders.manage\n    description: Review, fulfill, cancel, refund, or administer all orders.\n\nactions:\n  - id: list_products\n    api_surface: public_readonly\n    description: Browse products visible in the storefront. Supports search, category, status, and cursor pagination.\n    handler_method: list_products\n    input_schema:\n      type: object\n      additionalProperties: false\n      properties:\n        search: { type: string }\n        category: { type: string }\n        status: { type: string, enum: [draft, active, archived] }\n        before: { type: string }\n        limit: { type: integer }\n    output_schema:\n      type: object\n      required: [products, count]\n      properties:\n        products:\n          type: array\n          items:\n            type: object\n            properties:\n              product_id: { type: string }\n              title: { type: string }\n              slug: { type: string, nullable: true }\n              category: { type: string }\n              sku: { type: string, nullable: true }\n              status: { type: string }\n              price_amount: { type: integer }\n              price_display: { type: string }\n              currency: { type: string }\n              inventory_quantity: { type: integer, nullable: true }\n              track_inventory: { type: boolean }\n              image_url: { type: string, nullable: true }\n        count: { type: integer }\n        next_cursor: { type: string, nullable: true }\n    permissions: [commerce.catalog.read]\n\n  - id: get_product\n    api_surface: public_readonly\n    description: Fetch one product by product_id or slug.\n    handler_method: get_product\n    input_schema:\n      type: object\n      additionalProperties: false\n      properties:\n        product_id: { type: string }\n        slug: { type: string }\n    output_schema:\n      type: object\n      required: [product]\n      properties:\n        product: { type: object, nullable: true }\n    permissions: [commerce.catalog.read]\n\n  - id: create_product\n    api_surface: public\n    description: Create a draft or active product with price, currency, SKU, category, and inventory metadata.\n    handler_method: create_product\n    entitlement_gate: commerce.products.manage\n    input_schema:\n      type: object\n      additionalProperties: false\n      required: [title, price_amount]\n      properties:\n        title: { type: string }\n        slug: { type: string }\n        description: { type: string }\n        category: { type: string }\n        sku: { type: string }\n        status: { type: string, enum: [draft, active, archived] }\n        price_amount: { type: number }\n        currency: { type: string }\n        inventory_quantity: { type: integer }\n        track_inventory: { type: boolean }\n        image_url: { type: string }\n    output_schema:\n      type: object\n      required: [success, product]\n    permissions: [commerce.catalog.manage]\n    emits: [domain.commerce.product.created]\n\n  - id: update_product\n    api_surface: public\n    description: Update catalog, price, status, or inventory policy fields for a product.\n    handler_method: update_product\n    input_schema:\n      type: object\n      additionalProperties: false\n      required: [product_id]\n      properties:\n        product_id: { type: string }\n        title: { type: string }\n        slug: { type: string }\n        description: { type: string }\n        category: { type: string }\n        sku: { type: string }\n        status: { type: string, enum: [draft, active, archived] }\n        price_amount: { type: number }\n        currency: { type: string }\n        inventory_quantity: { type: integer }\n        track_inventory: { type: boolean }\n        image_url: { type: string }\n    output_schema:\n      type: object\n      required: [success, product]\n    permissions: [commerce.catalog.manage]\n    emits: [domain.commerce.product.updated]\n\n  - id: archive_product\n    api_surface: public\n    description: Archive a product so it no longer appears in storefront browse results.\n    handler_method: archive_product\n    input_schema:\n      type: object\n      additionalProperties: false\n      required: [product_id]\n      properties:\n        product_id: { type: string }\n    output_schema:\n      type: object\n      required: [success]\n    permissions: [commerce.catalog.manage]\n    emits: [domain.commerce.product.archived]\n\n  - id: adjust_inventory\n    api_surface: public\n    description: Adjust product inventory by a signed delta and record the reason.\n    handler_method: adjust_inventory\n    input_schema:\n      type: object\n      additionalProperties: false\n      required: [product_id, delta]\n      properties:\n        product_id: { type: string }\n        delta: { type: integer }\n        reason: { type: string }\n    output_schema:\n      type: object\n      required: [success, product]\n    permissions: [commerce.inventory.manage]\n    emits: [domain.commerce.inventory.adjusted]\n\n  - id: get_cart\n    api_surface: public_readonly\n    description: Return the current viewer's active cart, including recalculated totals.\n    handler_method: get_cart\n    input_schema:\n      type: object\n      additionalProperties: false\n      properties: {}\n    output_schema:\n      type: object\n      required: [cart]\n    permissions: [commerce.cart.manage]\n\n  - id: add_cart_item\n    api_surface: public\n    description: Add a product to the current viewer's active cart or increment quantity.\n    handler_method: add_cart_item\n    input_schema:\n      type: object\n      additionalProperties: false\n      required: [product_id]\n      properties:\n        product_id: { type: string }\n        quantity: { type: integer }\n    output_schema:\n      type: object\n      required: [success, cart]\n    permissions: [commerce.cart.manage]\n    emits: [domain.commerce.cart.updated]\n\n  - id: update_cart_item\n    api_surface: public\n    description: Set the quantity for one cart item. Quantity 0 removes the item.\n    handler_method: update_cart_item\n    input_schema:\n      type: object\n      additionalProperties: false\n      required: [product_id, quantity]\n      properties:\n        product_id: { type: string }\n        quantity: { type: integer }\n    output_schema:\n      type: object\n      required: [success, cart]\n    permissions: [commerce.cart.manage]\n    emits: [domain.commerce.cart.updated]\n\n  - id: remove_cart_item\n    api_surface: public\n    description: Remove one product from the current viewer's cart.\n    handler_method: remove_cart_item\n    input_schema:\n      type: object\n      additionalProperties: false\n      required: [product_id]\n      properties:\n        product_id: { type: string }\n    output_schema:\n      type: object\n      required: [success, cart]\n    permissions: [commerce.cart.manage]\n    emits: [domain.commerce.cart.updated]\n\n  - id: clear_cart\n    api_surface: public\n    description: Clear all items from the current viewer's active cart.\n    handler_method: clear_cart\n    input_schema:\n      type: object\n      additionalProperties: false\n      properties: {}\n    output_schema:\n      type: object\n      required: [success, cart]\n    permissions: [commerce.cart.manage]\n    emits: [domain.commerce.cart.updated]\n\n  - id: start_checkout\n    api_surface: public\n    description: Snapshot the current cart into an order and emit a checkout request for the selected payment facade.\n    handler_method: start_checkout\n    entitlement_gate: commerce.checkout.start\n    input_schema:\n      type: object\n      additionalProperties: false\n      properties:\n        payment_provider: { type: string }\n        success_url: { type: string }\n        cancel_url: { type: string }\n    output_schema:\n      type: object\n      required: [success]\n      properties:\n        success: { type: boolean }\n        order: { type: object }\n        checkout_request: { type: object }\n        error: { type: string }\n    permissions: [commerce.checkout.start]\n    emits: [domain.commerce.checkout.requested]\n\n  - id: record_checkout_result\n    api_surface: internal"},{"checksum":"sha256:496e848da3cfbdf757afb0dc03eb6904d10168b89c9f18b5c6c0e1eb14b59ae5","chunk_id":"chunk_b8c45b1d76e30f17","end_line":398,"path":"build_context/commerce/templates/modules/commerce/module.yaml","start_line":275,"symbol_ids":[],"text":"    description: Internal payment-facade callback that marks checkout paid, failed, cancelled, or expired.\n    handler_method: record_checkout_result\n    input_schema:\n      type: object\n      additionalProperties: false\n      required: [order_id, status]\n      properties:\n        order_id: { type: string }\n        status: { type: string, enum: [paid, failed, cancelled, expired] }\n        provider: { type: string }\n        provider_reference: { type: string }\n        # Closed provider-event summary. The service records only the event\n        # type (payment_event.event_type); providers keep the full payload.\n        raw_event:\n          type: object\n          additionalProperties: false\n          properties:\n            type: { type: string }\n    output_schema:\n      type: object\n      required: [success, order]\n    permissions: []\n    emits: [domain.commerce.order.paid, domain.commerce.checkout.failed]\n\n  - id: list_orders\n    api_surface: public_readonly\n    description: List orders for the current viewer, or all orders for commerce managers.\n    handler_method: list_orders\n    input_schema:\n      type: object\n      additionalProperties: false\n      properties:\n        status: { type: string }\n        before: { type: string }\n        limit: { type: integer }\n    output_schema:\n      type: object\n      required: [orders, count]\n      properties:\n        orders:\n          type: array\n          items:\n            type: object\n            properties:\n              order_id: { type: string }\n              actor_id: { type: string }\n              cart_id: { type: string }\n              status: { type: string }\n              items: { type: array }\n              subtotal_amount: { type: integer }\n              total_amount: { type: integer }\n              total_display: { type: string }\n              currency: { type: string }\n              payment: { type: object }\n              fulfillment: { type: object }\n              created_at: { type: string }\n              updated_at: { type: string }\n        count: { type: integer }\n        next_cursor: { type: string, nullable: true }\n    permissions: [commerce.orders.read]\n\n  - id: get_order\n    api_surface: public_readonly\n    description: Fetch one order visible to the current viewer or commerce manager.\n    handler_method: get_order\n    input_schema:\n      type: object\n      additionalProperties: false\n      required: [order_id]\n      properties:\n        order_id: { type: string }\n    output_schema:\n      type: object\n      required: [order]\n    permissions: [commerce.orders.read]\n\n  - id: update_order_status\n    api_surface: public\n    description: Move an order through fulfillment states such as processing, fulfilled, cancelled, or refunded.\n    handler_method: update_order_status\n    input_schema:\n      type: object\n      additionalProperties: false\n      required: [order_id, status]\n      properties:\n        order_id: { type: string }\n        status: { type: string, enum: [processing, fulfilled, cancelled, refunded] }\n        note: { type: string }\n    output_schema:\n      type: object\n      required: [success, order]\n    permissions: [commerce.orders.manage]\n    emits: [domain.commerce.order.updated]\n\n# Capability ids are unique public surface identifiers (ModuleDefinition\n# rejects duplicates). Each grants its capability group through one primary\n# action target; the remaining actions stay reachable through the standard\n# /api/modules/commerce/{action} surface and share the same permissions and\n# entitlement gates.\ncapabilities:\n  - capability_id: commerce.products.browse\n    kind: action\n    target: list_products\n    title: Browse products\n  - capability_id: commerce.products.manage\n    kind: action\n    target: create_product\n    title: Manage products\n  - capability_id: commerce.inventory.manage\n    kind: action\n    target: adjust_inventory\n    title: Adjust inventory\n  - capability_id: commerce.cart.manage\n    kind: action\n    target: get_cart\n    title: Manage cart\n  - capability_id: commerce.checkout.start\n    kind: action\n    target: start_checkout\n    title: Start checkout\n  - capability_id: commerce.orders.manage\n    kind: action\n    target: list_orders\n    title: Manage orders"},{"checksum":"sha256:3c856ed9a6753c7674684bbe181f178b8671c36e79303e6a484702b7239e5373","chunk_id":"chunk_72162d003f6a4f28","end_line":97,"path":"build_context/commerce/templates/ui/pages/cart.yaml","start_line":1,"symbol_ids":[],"text":"schema_version: mozaiks.app_page.v1\nname: cart\nroute: /cart\ntitle: Cart\npage_type: wizard\nlayout: full-width\nshell_mode: focused\nnavigation:\n  id: cart\n  label: Cart\n  icon: ShoppingCart\n  scope: global\n  order: 42\n  visible: true\nsections:\n  - id: cart-header\n    primitive: PageHeader\n    title: null\n    config:\n      title: Cart\n      subtitle: Review items before checkout.\n      title_font: body\n      actions:\n        - id: keep-shopping\n          label: Products\n          variant: secondary\n          action_type: navigate\n          href: /products\n\n  - id: cart-summary\n    primitive: SummaryStrip\n    title: null\n    config:\n      items:\n        - id: subtotal\n          label: Subtotal\n          value_key: cart.subtotal_display\n        - id: status\n          label: Status\n          value_key: cart.status\n        - id: currency\n          label: Currency\n          value_key: cart.currency\n\n  - id: cart-items\n    primitive: ResourceTable\n    title: Items\n    config:\n      api_endpoint: /api/modules/commerce/get_cart\n      data_key: cart.items\n      selection: single\n      search: false\n      columns:\n        - key: title\n          label: Product\n        - key: quantity\n          label: Quantity\n          type: number\n        - key: unit_amount\n          label: Unit Amount\n          type: number\n        - key: line_total\n          label: Line Total\n          type: number\n      actions:\n        - id: remove-item\n          label: Remove\n          variant: destructive\n          action_type: submit\n          href: /api/modules/commerce/remove_cart_item\n          requires_selection: true\n          payload:\n            product_id: \"{product_id}\"\n      empty:\n        title: Your cart is empty\n        message: Browse products to add something.\n        action:\n          label: Browse Products\n          action_type: navigate\n          href: /products\n\n  - id: checkout-action\n    primitive: ActionButton\n    title: null\n    config:\n      layout: row\n      actions:\n        - id: start-checkout\n          label: Checkout\n          variant: primary\n          action_type: submit\n          href: /api/modules/commerce/start_checkout\n          payload:\n            payment_provider: mozaikspay\n            success_url: /checkout/success\n            cancel_url: /cart\nroles: null"},{"checksum":"sha256:3c9eefc8d311618ad1d528e2df3ac684613fc41722accec74e228903f04fe414","chunk_id":"chunk_13944612cddaadab","end_line":63,"path":"build_context/commerce/templates/ui/pages/orders.yaml","start_line":1,"symbol_ids":[],"text":"schema_version: mozaiks.app_page.v1\nname: orders\nroute: /orders\ntitle: Orders\npage_type: record_list\nlayout: full-width\nshell_mode: workspace\nnavigation:\n  id: orders\n  label: Orders\n  icon: Receipt\n  scope: global\n  order: 43\n  visible: true\nsections:\n  - id: orders-header\n    primitive: PageHeader\n    title: null\n    config:\n      title: Orders\n      subtitle: Review purchases and fulfillment state.\n      title_font: body\n      actions:\n        - id: back-products\n          label: Products\n          variant: secondary\n          action_type: navigate\n          href: /products\n\n  - id: order-list\n    primitive: ResourceTable\n    title: null\n    config:\n      api_endpoint: /api/modules/commerce/list_orders\n      data_key: orders\n      selection: single\n      search: true\n      search_placeholder: Search orders...\n      columns:\n        - key: order_id\n          label: Order\n        - key: status\n          label: Status\n          type: status\n        - key: total_display\n          label: Total\n        - key: currency\n          label: Currency\n        - key: created_at\n          label: Created\n          type: date\n          sortable: true\n      actions:\n        - id: open-order\n          label: View Order\n          variant: secondary\n          action_type: navigate\n          href: /orders/{order_id}\n          requires_selection: true\n      empty:\n        title: No orders yet\n        message: Paid orders appear here after checkout completes.\nroles: null"},{"checksum":"sha256:5dc58420737a51d26a8898b1fbfa242d70d3f0393896b44616bf1cfb9a58bc61","chunk_id":"chunk_613bf9f8a814b4ac","end_line":70,"path":"build_context/commerce/templates/ui/pages/product_detail.yaml","start_line":1,"symbol_ids":[],"text":"schema_version: mozaiks.app_page.v1\nname: product_detail\nroute: /products/:productId\ntitle: Product\npage_type: record_detail\nlayout: full-width\nshell_mode: standard\nnavigation:\n  id: product-detail\n  label: Product\n  icon: ShoppingBag\n  scope: local\n  order: 41\n  visible: false\nsections:\n  - id: product-detail-header\n    primitive: PageHeader\n    title: null\n    config:\n      title: Product\n      subtitle: Review details, then add the product to your cart.\n      title_font: body\n      actions:\n        - id: back-to-products\n          label: Products\n          variant: secondary\n          action_type: navigate\n          href: /products\n        - id: view-cart\n          label: View Cart\n          variant: primary\n          action_type: navigate\n          href: /cart\n\n  - id: product-lookup\n    primitive: Form\n    title: Product Lookup\n    config:\n      layout: grid\n      columns: 2\n      submit_label: Load Product\n      fields:\n        - name: product_id\n          label: Product ID\n          type: text\n          required: false\n        - name: slug\n          label: Slug\n          type: text\n          required: false\n      submit_action:\n        label: Load Product\n        action_type: submit\n        href: /api/modules/commerce/get_product\n\n  - id: add-product-action\n    primitive: ActionButton\n    title: null\n    config:\n      layout: row\n      actions:\n        - id: add-product-to-cart\n          label: Add to Cart\n          variant: primary\n          action_type: submit\n          href: /api/modules/commerce/add_cart_item\n          payload:\n            product_id: \"{product_id}\"\n            quantity: 1\nroles: null"},{"checksum":"sha256:8d9a14cdf459cdb891178a64302603c8f5cfd62eee68f123b3ab0391f3b6b3a2","chunk_id":"chunk_ea10d1b9c80dc32a","end_line":77,"path":"build_context/commerce/templates/ui/pages/products.yaml","start_line":1,"symbol_ids":[],"text":"schema_version: mozaiks.app_page.v1\nname: products\nroute: /products\ntitle: Products\npage_type: gallery\nlayout: full-width\nshell_mode: standard\nnavigation:\n  id: products\n  label: Products\n  icon: ShoppingBag\n  scope: global\n  order: 40\n  visible: true\nsections:\n  - id: products-header\n    primitive: PageHeader\n    title: null\n    config:\n      title: Products\n      subtitle: Browse the catalog and add products to your cart.\n      title_font: body\n      actions:\n        - id: view-cart\n          label: View Cart\n          variant: secondary\n          action_type: navigate\n          href: /cart\n        - id: view-orders\n          label: Orders\n          variant: ghost\n          action_type: navigate\n          href: /orders\n\n  - id: product-list\n    primitive: ResourceTable\n    title: null\n    config:\n      api_endpoint: /api/modules/commerce/list_products\n      data_key: products\n      selection: single\n      search: true\n      search_placeholder: Search products...\n      columns:\n        - key: title\n          label: Product\n          sortable: true\n        - key: category\n          label: Category\n        - key: price_display\n          label: Price\n        - key: inventory_quantity\n          label: Stock\n          type: number\n        - key: status\n          label: Status\n          type: status\n      actions:\n        - id: open-product\n          label: View Product\n          variant: secondary\n          action_type: navigate\n          href: /products/{product_id}\n          requires_selection: true\n        - id: add-to-cart\n          label: Add to Cart\n          variant: primary\n          action_type: submit\n          href: /api/modules/commerce/add_cart_item\n          requires_selection: true\n          payload:\n            product_id: \"{product_id}\"\n            quantity: 1\n      empty:\n        title: No products yet\n        message: Publish products from the commerce admin panel.\nroles: null"},{"checksum":"sha256:2de57ae3f437119809c7cfd6c275e1f5228be763c8fc4a4cdd6cf4c2a5823a83","chunk_id":"chunk_56ec72136dba73b9","end_line":19,"path":"build_context/entitlement_dispatch/context.yaml","start_line":1,"symbol_ids":[],"text":"context_id: entitlement_dispatch\napplies_to_workflows:\n  - AppGenerator\nassets:\n  - path: contract.yaml\n    kind: contract\n  - path: templates/\n    kind: templates\npack:\n  id: entitlement_dispatch\n  version: \"0.1.11\"\n  status: active\n  capability_source: generated_module\nprojections:\n  context_variables:\n    capability_packs:\n      from: capability_packs\n    operator_contracts:\n      from: operator_contracts"},{"checksum":"sha256:c4179c4165caa3d864ab872ab6db898b73108619bcf676a7dbc7068c1df703fc","chunk_id":"chunk_34d6b851bfec7a2b","end_line":110,"path":"build_context/entitlement_dispatch/contract.yaml","start_line":1,"symbol_ids":[],"text":"contract_id: entitlement_dispatch\ncontract_type: build_pack_instructions\n\n# entitlement_dispatch is not selected by LLM intent matching.\n# AppPlanAgent includes it automatically when:\n#   - config/subscriptions.yaml declares assignment_store\n#   - the build does NOT include a managed capability pack that owns\n#     subscription assignment writes\n# The selection rule is injected by subscription_contract_context.py.\nselection_rules:\n  - id: implicit_for_self_hosted_saas\n    when:\n      intent_any:\n        - self-hosted subscription billing\n        - entitlement dispatch\n        - subscription assignment store\n    action: select_pack\n\nrecommended_domains:\n  - saas\n  - subscriptions\n  - entitlements\n  - self-hosted billing\n\nrequired_outputs:\n  - path: data/migrations/001_entitlement_dispatch_collections.json\n    owner: templates\n  - path: modules/entitlement_dispatch/module.yaml\n    owner: templates\n  - path: modules/entitlement_dispatch/backend/__init__.py\n    owner: templates\n  - path: modules/entitlement_dispatch/backend/base_handler.py\n    owner: templates\n  - path: modules/entitlement_dispatch/backend/handler.py\n    owner: workspace  # preserved across regeneration; subclasses base_handler.py\n  - path: modules/entitlement_dispatch/backend/service.py\n    owner: templates\n  - path: modules/entitlement_dispatch/backend/repo.py\n    owner: templates\n  - path: modules/entitlement_dispatch/backend/schemas.py\n    owner: templates\n\nforbidden_outputs:\n  - path_prefix: modules/subscriptions/\n  - path_prefix: modules/billing/\n  - path_prefix: services/billing/\n  - path_prefix: services/adapters/payments/\n  - path_prefix: app/capability_packs/\n\nmanaged_assignment_writer_contract:\n  purpose: >\n    entitlement_dispatch is only needed when subscription assignments do not\n    arrive through a trusted managed adapter or the OSS\n    BillingFulfillmentCommand ingress.\n  selection_mechanism: >\n    The planning system checks whether any selected managed_capability pack\n    declares provides_capabilities: [subscription_write_path] in its contract.\n    If found, that pack owns the subscription assignment write path and\n    entitlement_dispatch is not selected. The mechanism is pack-driven;\n    no specific pack name is hardcoded into the OSS planner.\n  replacement_rule: >\n    A future managed monetization pack can replace the current write-path owner\n    for this planning decision only if it explicitly declares\n    provides_capabilities: [subscription_write_path] in its contract.yaml and\n    applies provider-neutral fulfillment effects into the same configured\n    assignment_store.\n\nruntime_boundaries:\n  - id: write_path_only\n    rule: >\n      entitlement_dispatch is the app-owned write path for subscription\n      assignments. ConfiguredEntitlementAdapter is the read path. Do not\n      duplicate ledger, capability-grant, or entitlement check logic here.\n  - id: assignment_store_alias\n    rule: >\n      repo.py must write to the billing.subscriptions data alias declared in\n      data/contract.json. The assignment_store.data_alias in\n      config/subscriptions.yaml must match this alias. Do not invent a\n      separate collection or bypass the data contract alias.\n  - id: app_id_required_in_document\n    rule: >\n      Every written document must include app_id from ctx.app_id.\n      ConfiguredEntitlementAdapter queries with {app_id_field: app_id} so the\n      field must be present in the stored record.\n  - id: action_contract\n    rule: >\n      The module must declare exactly two actions \u2014 activate_subscription and\n      deactivate_subscription \u2014 with no entitlement_gate, no permissions, and\n      capabilities: []. This is an internal system module; do not add\n      user-facing queries, admin surfaces, or UI pages.\n  - id: no_provider_logic\n    rule: >\n      Do not call any payment provider SDK, billing API, or external service.\n      The module only writes MongoDB records. Payment confirmation, webhook\n      verification, and plan change policy belong in the app's billing facade\n      or a managed MozaiksPay integration \u2014 not here.\n\nfacades: []\n\ncross_pack_integrations:\n  - provides_capability: subscription_write_path\n    description: >\n      Any managed capability pack that declares\n      provides_capabilities: [subscription_write_path] owns the subscription\n      assignment write path by applying verified checkout facts to\n      provider-neutral fulfillment effects. The entitlement_dispatch pack must\n      NOT be included alongside any such managed assignment writer \u2014 doing so\n      creates a duplicate write path and risks conflicting subscription state.\n    optional: false\n    integration_surface: []"},{"checksum":"sha256:40851810ef4ce0a07d308178db373ca5de83e6b20da61511fadbd61b67226767","chunk_id":"chunk_d2fe1eba38d7fceb","end_line":27,"path":"build_context/entitlement_dispatch/templates/data/migrations/001_entitlement_dispatch_collections.json","start_line":1,"symbol_ids":[],"text":"{\n  \"migration_id\": \"entitlement_dispatch_001_collections\",\n  \"description\": \"Declare the billing.subscriptions collection used by the entitlement_dispatch module (write side) and ConfiguredEntitlementAdapter (read side).\",\n  \"surfaces\": [\n    {\n      \"surface_id\": \"entitlement_dispatch\",\n      \"collections\": [\n        {\n          \"mongo_collection\": \"entitlement_dispatch_subscriptions\",\n          \"data_alias\": \"billing.subscriptions\",\n          \"description\": \"Subscription assignment records. ConfiguredEntitlementAdapter queries status and plan_id to enforce entitlement gates on module actions.\",\n          \"indexes\": [\n            {\n              \"name\": \"subscriptions_by_app_user\",\n              \"keys\": [{\"field\": \"app_id\", \"order\": 1}, {\"field\": \"user_id\", \"order\": 1}],\n              \"unique\": true\n            },\n            {\n              \"name\": \"subscriptions_by_app_plan_status\",\n              \"keys\": [{\"field\": \"app_id\", \"order\": 1}, {\"field\": \"plan_id\", \"order\": 1}, {\"field\": \"status\", \"order\": 1}]\n            }\n          ]\n        }\n      ]\n    }\n  ]\n}"},{"checksum":"sha256:9b980753ae2beb987370a0c3821cfa764eac3499db5a3f19e886eeb17d85825c","chunk_id":"chunk_fd21e451ae8d3faa","end_line":21,"path":"build_context/entitlement_dispatch/templates/modules/entitlement_dispatch/backend/base_handler.py","start_line":1,"symbol_ids":["sym_60d084c048f37a70","sym_087dbcd742f4bcb4","sym_2be70b6d318571c3","sym_61430f0e57a6aa73"],"text":"\"\"\"\nOSS-generated base handler for the entitlement_dispatch module.\nDO NOT EDIT \u2014 regenerated on framework upgrades.\nPut app-specific customizations in handler.py (the workspace subclass).\n\"\"\"\nfrom __future__ import annotations\n\nfrom typing import Any\n\nfrom .service import EntitlementDispatchService\n\n\nclass EntitlementDispatchBaseHandler:\n    def __init__(self, service: EntitlementDispatchService | None = None) -> None:\n        self._service = service or EntitlementDispatchService()\n\n    async def activate_subscription(self, ctx: Any, **kwargs: Any) -> dict[str, Any]:\n        return await self._service.activate_subscription(ctx, **kwargs)\n\n    async def deactivate_subscription(self, ctx: Any, **kwargs: Any) -> dict[str, Any]:\n        return await self._service.deactivate_subscription(ctx, **kwargs)"},{"checksum":"sha256:4f06e8cf50e8dac42811454c5f82d563732df7e8bd33012e5012e20d1a879db1","chunk_id":"chunk_fd65cd644fea64b8","end_line":12,"path":"build_context/entitlement_dispatch/templates/modules/entitlement_dispatch/backend/handler.py","start_line":1,"symbol_ids":["sym_9ac010254606e790"],"text":"\"\"\"\nWorkspace handler for the entitlement_dispatch module.\nSubclasses EntitlementDispatchBaseHandler \u2014 add overrides and extra methods here.\nThis file is preserved across regeneration.\n\"\"\"\nfrom __future__ import annotations\n\nfrom .base_handler import EntitlementDispatchBaseHandler\n\n\nclass EntitlementDispatchHandler(EntitlementDispatchBaseHandler):\n    \"\"\"App-local handler \u2014 extend or override base methods below.\"\"\""},{"checksum":"sha256:07aa5350d651082ef3adb1e59aee013ce22b4e5edc43547bf7ea9694ddb0756b","chunk_id":"chunk_419a03512819ffa1","end_line":76,"path":"build_context/entitlement_dispatch/templates/modules/entitlement_dispatch/backend/repo.py","start_line":1,"symbol_ids":["sym_3fe2230d1a4eb0e4","sym_3f856b28ab34b8bc","sym_c5d0eb3aebd44328","sym_cad282a9ec3a7963"],"text":"from __future__ import annotations\n\nfrom datetime import UTC, datetime\nfrom typing import Any\n\nfrom mozaiksai.core.runtime.persistence import app_data_from_context\n\n# The billing.subscriptions alias is declared in data/contract.json by the\n# entitlement_dispatch_001_collections migration. ConfiguredEntitlementAdapter\n# reads from the same alias via assignment_store.data_alias in\n# config/subscriptions.yaml. Both sides must resolve to the same collection.\n_SUBSCRIPTIONS_ALIAS = \"billing.subscriptions\"\n\n\ndef _now_iso() -> str:\n    return datetime.now(UTC).isoformat()\n\n\nclass EntitlementDispatchRepo:\n    \"\"\"Write-side persistence for subscription assignment records.\n\n    Writes to the billing.subscriptions data contract alias. The app_id field\n    is included in every document because ConfiguredEntitlementAdapter queries\n    assignments with {app_id_field: app_id} (default field name: \"app_id\").\n    \"\"\"\n\n    async def activate(\n        self,\n        ctx: Any,\n        *,\n        user_id: str,\n        plan_id: str,\n        activated_at: str | None = None,\n        metadata: dict[str, Any] | None = None,\n    ) -> None:\n        \"\"\"Upsert an active subscription assignment for the user.\"\"\"\n        app_id = str(getattr(ctx, \"app_id\", None) or \"\").strip()\n        col = app_data_from_context(ctx).collection(_SUBSCRIPTIONS_ALIAS)\n        await col.update_one(\n            {\"app_id\": app_id, \"user_id\": user_id},\n            {\n                \"$set\": {\n                    \"app_id\": app_id,\n                    \"user_id\": user_id,\n                    \"plan_id\": plan_id,\n                    \"status\": \"active\",\n                    \"activated_at\": activated_at or _now_iso(),\n                    \"deactivated_at\": None,\n                    \"metadata\": metadata or {},\n                }\n            },\n            upsert=True,\n        )\n\n    async def deactivate(\n        self,\n        ctx: Any,\n        *,\n        user_id: str,\n        plan_id: str | None = None,\n    ) -> bool:\n        \"\"\"Mark the active subscription assignment as cancelled.\n\n        Returns True when a record was found and updated, False when no active\n        record matched (e.g. already deactivated or never activated).\n        \"\"\"\n        app_id = str(getattr(ctx, \"app_id\", None) or \"\").strip()\n        col = app_data_from_context(ctx).collection(_SUBSCRIPTIONS_ALIAS)\n        query: dict[str, Any] = {\"app_id\": app_id, \"user_id\": user_id, \"status\": \"active\"}\n        if plan_id:\n            query[\"plan_id\"] = plan_id\n        result = await col.update_one(\n            query,\n            {\"$set\": {\"status\": \"cancelled\", \"deactivated_at\": _now_iso()}},\n        )\n        return bool(result.modified_count)"},{"checksum":"sha256:c73cea87adced18dd0f9949f4534b3ba43b0bfbad8f7e51cea4bce67fa9f7d06","chunk_id":"chunk_7e0e056cfdbee777","end_line":30,"path":"build_context/entitlement_dispatch/templates/modules/entitlement_dispatch/backend/schemas.py","start_line":1,"symbol_ids":["sym_c55fececf9fd6a69"],"text":"from __future__ import annotations\n\nfrom typing import Any\n\n# Subscription assignment document stored in the billing.subscriptions collection.\n#\n# Fields read by ConfiguredEntitlementAdapter (via assignment_store config):\n#   app_id        \u2014 used to scope queries per app (app_id_field default: \"app_id\")\n#   user_id       \u2014 used to find the user's assignment (user_id_field default: \"user_id\")\n#   status        \u2014 checked against active_statuses (default: [\"active\", \"pending\", \"trialing\"])\n#   plan_id       \u2014 used to look up capabilities in config/subscriptions.yaml plan catalog\n#\n# Optional fields read by ConfiguredEntitlementAdapter:\n#   granted_capabilities \u2014 if present, used directly instead of plan catalog lookup\n#   activated_at  \u2014 informational; not used for grant logic\n#   deactivated_at \u2014 informational; not used for grant logic\n#   metadata      \u2014 not read by the adapter; available for app-owned billing context\nSubscriptionAssignmentDoc = dict[str, Any]\n\n\ndef metadata_entries_to_map(entries: list[dict[str, Any]] | None) -> dict[str, str]:\n    \"\"\"Fold closed {key, value} request entries into the stored metadata map.\n\n    The module request contract carries metadata as typed entries; assignment\n    records keep the {key: value} map shape. Later entries win on duplicate keys.\n    \"\"\"\n    metadata: dict[str, str] = {}\n    for entry in entries or []:\n        metadata[str(entry[\"key\"])] = str(entry[\"value\"])\n    return metadata"},{"checksum":"sha256:0f14b62fe13c60dab9f7cfc4bfb3ac412176fad6063522ea602d6ff0da71f9b4","chunk_id":"chunk_f42187a253a0bbaf","end_line":63,"path":"build_context/entitlement_dispatch/templates/modules/entitlement_dispatch/backend/service.py","start_line":1,"symbol_ids":["sym_a761bac737ae7e83","sym_cb71e0dcff62186e","sym_4128b106b48515f6","sym_2c47009aec35ef89"],"text":"from __future__ import annotations\n\nfrom typing import Any\n\nfrom .repo import EntitlementDispatchRepo\nfrom .schemas import metadata_entries_to_map\n\n\nclass EntitlementDispatchService:\n    \"\"\"Business logic for the entitlement dispatch write path.\n\n    Validates inputs and delegates persistence to EntitlementDispatchRepo.\n    Does not call payment providers, check entitlements, or emit billing events.\n    \"\"\"\n\n    def __init__(self) -> None:\n        self._repo = EntitlementDispatchRepo()\n\n    async def activate_subscription(\n        self,\n        ctx: Any,\n        *,\n        user_id: str,\n        plan_id: str,\n        activated_at: str | None = None,\n        metadata: list[dict[str, Any]] | None = None,\n    ) -> dict[str, Any]:\n        \"\"\"Write an active subscription assignment record.\n\n        ConfiguredEntitlementAdapter reads the record to grant plan capabilities.\n        Call this after payment confirmation or explicit plan assignment.\n\n        ``metadata`` arrives as closed {key, value} entries per the module\n        request contract and is stored as the same {key: value} map records\n        carried before the contract closed.\n        \"\"\"\n        if not user_id or not plan_id:\n            return {\"activated\": False, \"error\": \"user_id and plan_id are required\"}\n        await self._repo.activate(\n            ctx,\n            user_id=user_id,\n            plan_id=plan_id,\n            activated_at=activated_at,\n            metadata=metadata_entries_to_map(metadata),\n        )\n        return {\"activated\": True, \"plan_id\": plan_id}\n\n    async def deactivate_subscription(\n        self,\n        ctx: Any,\n        *,\n        user_id: str,\n        plan_id: str | None = None,\n    ) -> dict[str, Any]:\n        \"\"\"Mark the active assignment as cancelled.\n\n        ConfiguredEntitlementAdapter stops granting capabilities once the record\n        status is no longer in active_statuses.\n        \"\"\"\n        if not user_id:\n            return {\"deactivated\": False, \"error\": \"user_id is required\"}\n        deactivated = await self._repo.deactivate(ctx, user_id=user_id, plan_id=plan_id)\n        return {\"deactivated\": deactivated}"},{"checksum":"sha256:a5b948f43a7cea6369d438ea1127779fbda8a67a67dfc8da3671ada0bfbbdaaf","chunk_id":"chunk_f02d54360ad4bca3","end_line":107,"path":"build_context/entitlement_dispatch/templates/modules/entitlement_dispatch/module.yaml","start_line":1,"symbol_ids":[],"text":"schema_version: mozaiks.module.v1\nmodule:\n  id: entitlement_dispatch\n  display_name: Entitlement Dispatch\n  version: 1.0.0\n  description: >\n    Write-side partner for ConfiguredEntitlementAdapter. Activates and\n    deactivates subscription assignment records in the billing.subscriptions\n    collection so the runtime entitlement gate can enforce plan-based\n    capability access on module actions.\n\n    Requires config/subscriptions.yaml to declare an assignment_store with\n    data_alias: billing.subscriptions.\n\n    This module is internal \u2014 it has no entitlement_gate, no permissions, and\n    no user-facing capabilities. Payment confirmation and plan change policy\n    belong in the app's billing facade; this module only writes the assignment\n    record that ConfiguredEntitlementAdapter reads.\n  owner: app\n  visibility: private\n  type: entitlement_dispatch\n  handler: backend.handler:EntitlementDispatchHandler\n\npermissions: []\n\nactions:\n  - id: activate_subscription\n    description: >\n      Write an active subscription assignment record so ConfiguredEntitlementAdapter\n      can grant the plan's declared capabilities to the user.\n      Call this after payment confirmation or explicit plan assignment.\n    handler_method: activate_subscription\n    input_schema:\n      type: object\n      additionalProperties: false\n      required:\n        - user_id\n        - plan_id\n      properties:\n        # user_id \u2014 the user receiving the subscription.\n        user_id:\n          type: string\n        # plan_id \u2014 as declared in config/subscriptions.yaml.\n        plan_id:\n          type: string\n        # activated_at \u2014 optional ISO 8601 activation timestamp; omit for \"now\".\n        activated_at:\n          type: string\n        # metadata \u2014 optional provider or billing context entries. Not read by\n        # the entitlement adapter; stored on the assignment record as a\n        # {key: value} map built from these typed entries.\n        metadata:\n          type: array\n          items:\n            type: object\n            additionalProperties: false\n            required:\n              - key\n              - value\n            properties:\n              key: { type: string }\n              value: { type: string }\n    output_schema:\n      type: object\n      required:\n        - activated\n      properties:\n        activated:\n          type: boolean\n        plan_id:\n          type: string\n          nullable: true\n        error:\n          type: string\n          nullable: true\n\n  - id: deactivate_subscription\n    description: >\n      Mark the active subscription assignment as cancelled so ConfiguredEntitlementAdapter\n      stops granting the plan's capabilities.\n      Call this on subscription cancellation, expiry, or plan downgrade.\n    handler_method: deactivate_subscription\n    input_schema:\n      type: object\n      additionalProperties: false\n      required:\n        - user_id\n      properties:\n        # user_id \u2014 the user whose subscription is being cancelled.\n        user_id:\n          type: string\n        # plan_id \u2014 optional; targets a specific plan record. When omitted,\n        # any active record for the user is deactivated.\n        plan_id:\n          type: string\n    output_schema:\n      type: object\n      required:\n        - deactivated\n      properties:\n        deactivated:\n          type: boolean\n        error:\n          type: string\n          nullable: true\n\ncapabilities: []"},{"checksum":"sha256:17f70df04b691f891bdaabb1670282e8173af1cbea67554722d43919a2013f37","chunk_id":"chunk_98db23960411f3c7","end_line":20,"path":"build_context/files/context.yaml","start_line":1,"symbol_ids":[],"text":"context_id: files\napplies_to_workflows:\n  - AppGenerator\nassets:\n  - path: contract.yaml\n    kind: contract\n  - path: templates/\n    kind: templates\npack:\n  id: files\n  version: \"0.1.11\"\n  status: active\n  capability_source: generated_module\ncapabilities:\n  - capability_id: files.upload\n    facade_recommended: file_manager\n  - capability_id: files.read\n    facade_recommended: file_manager\n  - capability_id: files.delete\n    facade_recommended: file_manager"},{"checksum":"sha256:c5099723257b3e99a73b7829690e0d77b40104aaf16dcba5bba0fb7bf37b38c3","chunk_id":"chunk_a7401cf6962d0a25","end_line":87,"path":"build_context/files/contract.yaml","start_line":1,"symbol_ids":[],"text":"contract_id: files\ncontract_type: build_pack_instructions\n\nselection_rules:\n  - id: select_for_file_storage_apps\n    when:\n      intent_any:\n        - file upload\n        - file storage\n        - media management\n        - document management\n        - user files\n        - attachments\n        - photo upload\n        - image upload\n        - file sharing\n        - document storage\n        - media upload\n        - upload files\n    action: select_pack\n\nrecommended_domains:\n  - files\n  - media\n  - storage\n  - documents\n  - attachments\n\nrequired_outputs:\n  - path: data/migrations/001_files_collections.json\n    owner: templates\n  - path: modules/files/module.yaml\n    owner: templates\n  - path: modules/files/backend/__init__.py\n    owner: templates\n  - path: modules/files/backend/base_handler.py\n    owner: templates\n  - path: modules/files/backend/handler.py\n    owner: workspace  # preserved across regeneration; subclasses base_handler.py\n  - path: modules/files/backend/service.py\n    owner: templates\n  - path: modules/files/backend/repo.py\n    owner: templates\n  - path: modules/files/backend/policy.py\n    owner: templates\n  - path: modules/files/backend/schemas.py\n    owner: templates\n  - path: modules/files/backend/account_data_handler.py\n    owner: templates\n  - path: modules/files/contracts/events.yaml\n    owner: templates\n  - path: modules/files/contracts/notifications.yaml\n    owner: templates\n\nforbidden_outputs:\n  - path_prefix: modules/storage/\n  - path_prefix: modules/media/\n  - path_prefix: modules/uploads/\n  - path_prefix: services/cloud_storage/\n\nruntime_boundaries:\n  - id: metadata_only\n    rule: >\n      Generated module stores file metadata only (file_id, filename, mime_type,\n      size_bytes, storage_url, is_public, created_by). The actual blob belongs in\n      a provider storage service. Do not generate AWS/GCP/Azure SDK calls in the\n      module backend.\n  - id: storage_url_is_opaque\n    rule: >\n      The storage_url field is an opaque provider URL. The module does not validate,\n      sign, or proxy it. The app's storage adapter manages blob lifecycle.\n  - id: user_data_scope\n    rule: >\n      File records are user-owned PII. The module declares user_data_scope: true\n      and ships account_data_handler.py implementing delete_user_data and\n      export_user_data.\n  - id: no_direct_sdk_calls\n    rule: >\n      Generated repo.py must use ctx.persistence.collection(\"files\", entity_name).\n      No direct cloud storage SDK calls in module backend. Storage mechanics belong\n      in services/adapters/storage/{provider}.py.\n  - id: event_emission\n    rule: >\n      Events must be emitted via ctx.emit() from service.py, not from handler.py\n      or repo.py.\n\nfacades: []"},{"checksum":"sha256:3cbac4a74d4168584a981127d59e0dccfe5f986e7397ad7e2dd4fa4a189639db","chunk_id":"chunk_a7f414f17a5103af","end_line":33,"path":"build_context/files/templates/data/migrations/001_files_collections.json","start_line":1,"symbol_ids":[],"text":"{\n  \"migration_id\": \"files_001_collections\",\n  \"description\": \"Declare the files.records collection for the files module.\",\n  \"surfaces\": [\n    {\n      \"surface_id\": \"files\",\n      \"collections\": [\n        {\n          \"mongo_collection\": \"files_records\",\n          \"data_alias\": \"files.records\",\n          \"description\": \"File metadata records. Blobs are stored externally; this collection tracks metadata and the opaque storage_url.\",\n          \"indexes\": [\n            {\n              \"name\": \"files_by_app_user\",\n              \"keys\": [\n                {\"field\": \"app_id\", \"order\": 1},\n                {\"field\": \"created_by\", \"order\": 1}\n              ]\n            },\n            {\n              \"name\": \"files_by_app_file_id\",\n              \"keys\": [\n                {\"field\": \"app_id\", \"order\": 1},\n                {\"field\": \"file_id\", \"order\": 1}\n              ],\n              \"unique\": true\n            }\n          ]\n        }\n      ]\n    }\n  ]\n}"},{"checksum":"sha256:77429ba21ae34a4c74144818aeb81fb01dded64bc959e35cbb7e2858027bb27b","chunk_id":"chunk_57a33161e61a4643","end_line":57,"path":"build_context/files/templates/modules/files/backend/account_data_handler.py","start_line":1,"symbol_ids":["sym_a07c3f7bab91a5c0","sym_7a74bfc0a0e36604","sym_f1725e9c6518b088","sym_aa16e904d0d3e23c","sym_9acd622a77823f53"],"text":"\"\"\"AccountDataHandler for the files module.\n\nGDPR deletion and export for user-uploaded file records.\n\nDeletion policy:\n  - File records where created_by == deleted user: soft-deleted (deleted flag set).\n    The storage_url is an opaque provider reference; blob cleanup is handled by the\n    app's storage adapter using domain.files.file_deleted events or a separate\n    retention sweep. This handler marks metadata records as deleted so they are\n    excluded from queries.\n\nNote: actual blob data lives outside this module in provider storage. This handler\nonly operates on metadata records in the files.records collection.\n\"\"\"\nfrom __future__ import annotations\n\nfrom datetime import UTC, datetime\nfrom typing import Any\n\n_RECORDS = \"files_records\"\n\n\ndef _now() -> str:\n    return datetime.now(UTC).isoformat()\n\n\nclass AccountDataHandler:\n    \"\"\"GDPR delete + export handler for the files module.\"\"\"\n\n    def __init__(self, db: Any) -> None:\n        self._db = db\n\n    async def delete_user_data(self, *, app_id: str, user_id: str) -> dict[str, Any]:\n        \"\"\"Soft-delete all file records created by the user.\"\"\"\n        result = await self._db[_RECORDS].update_many(\n            {\"app_id\": app_id, \"created_by\": user_id, \"deleted\": {\"$ne\": True}},\n            {\n                \"$set\": {\n                    \"deleted\": True,\n                    \"deleted_at\": _now(),\n                    \"deleted_by\": \"__gdpr_deletion__\",\n                }\n            },\n        )\n        return {\n            \"files_deleted\": getattr(result, \"modified_count\", 0),\n        }\n\n    async def export_user_data(self, *, app_id: str, user_id: str) -> dict[str, Any]:\n        \"\"\"Export all non-deleted file records created by the user.\"\"\"\n        files = await self._db[_RECORDS].find(\n            {\"app_id\": app_id, \"created_by\": user_id, \"deleted\": {\"$ne\": True}},\n            {\"_id\": 0, \"app_id\": 0},\n        ).to_list(length=None)\n        return {\n            \"files\": files,\n        }"},{"checksum":"sha256:a0ba9a5507b3a7a2c373b9418f7ccba50d43753d58b678562a7b3c4d160c8bb8","chunk_id":"chunk_d2854e70b96028a3","end_line":73,"path":"build_context/files/templates/modules/files/backend/base_handler.py","start_line":1,"symbol_ids":["sym_d1abba9fe03f443d","sym_5075d70f5a554803","sym_09431fe36a801e37","sym_c50d733c8796ecd2","sym_142bda9442873591","sym_97b96b6e13c50695"],"text":"\"\"\"\nOSS-generated base handler for the files module.\nDO NOT EDIT \u2014 regenerated on framework upgrades.\nPut app-specific customizations in handler.py (the workspace subclass).\n\"\"\"\nfrom __future__ import annotations\n\nfrom typing import Any\n\nfrom mozaiksai.core.runtime.composition.module_context import ModuleContext\n\nfrom .service import FilesService\n\n\nclass FilesBaseHandler:\n    def __init__(self, service: FilesService | None = None) -> None:\n        self._service = service or FilesService()\n\n    async def upload_file(\n        self,\n        ctx: ModuleContext,\n        *,\n        filename: str,\n        mime_type: str,\n        size_bytes: int,\n        storage_url: str,\n        is_public: bool = False,\n        metadata: list[dict[str, Any]] | None = None,\n        **_: object,\n    ) -> dict[str, Any]:\n        return await self._service.upload_file(\n            ctx,\n            filename=filename,\n            mime_type=mime_type,\n            size_bytes=size_bytes,\n            storage_url=storage_url,\n            is_public=is_public,\n            metadata=metadata,\n        )\n\n    async def get_file(\n        self,\n        ctx: ModuleContext,\n        *,\n        file_id: str,\n        **_: object,\n    ) -> dict[str, Any]:\n        return await self._service.get_file(ctx, file_id=file_id)\n\n    async def list_files(\n        self,\n        ctx: ModuleContext,\n        *,\n        is_public: bool | None = None,\n        mime_type: str | None = None,\n        limit: int = 50,\n        **_: object,\n    ) -> dict[str, Any]:\n        return await self._service.list_files(\n            ctx,\n            is_public=is_public,\n            mime_type=mime_type,\n            limit=limit,\n        )\n\n    async def delete_file(\n        self,\n        ctx: ModuleContext,\n        *,\n        file_id: str,\n        **_: object,\n    ) -> dict[str, Any]:\n        return await self._service.delete_file(ctx, file_id=file_id)"},{"checksum":"sha256:3faa1b46e055ccaefc783baab15c6771fed8dd15921828e17ce1db7912adad4d","chunk_id":"chunk_4a9c584ec66e9e74","end_line":12,"path":"build_context/files/templates/modules/files/backend/handler.py","start_line":1,"symbol_ids":["sym_12416a91f877f6a3"],"text":"\"\"\"\nWorkspace handler for the files module.\nSubclasses FilesBaseHandler \u2014 add overrides and extra methods here.\nThis file is preserved across regeneration.\n\"\"\"\nfrom __future__ import annotations\n\nfrom .base_handler import FilesBaseHandler\n\n\nclass FilesHandler(FilesBaseHandler):\n    \"\"\"App-local handler \u2014 extend or override base methods below.\"\"\""},{"checksum":"sha256:de129e5e54053210fc820e0d751449f04e96626f6abbf5fab0a88aa0df259d13","chunk_id":"chunk_3a590264972d8f70","end_line":11,"path":"build_context/files/templates/modules/files/backend/policy.py","start_line":1,"symbol_ids":["sym_f42130a1096af5bc"],"text":"from __future__ import annotations\n\nfrom typing import Any\n\n\ndef files_scope(ctx, extra: dict[str, Any] | None = None) -> dict[str, Any]:\n    \"\"\"Return a base query scope keyed by app_id, optionally merged with extra fields.\"\"\"\n    scope: dict[str, Any] = {\"app_id\": getattr(ctx, \"app_id\", None)}\n    if extra:\n        scope.update({key: value for key, value in extra.items() if value is not None})\n    return scope"},{"checksum":"sha256:67f2c904e4e44d2e1ccbe78178d70200070ec62e46e014b44e68d189ac8b9ed5","chunk_id":"chunk_ada000e06563140d","end_line":102,"path":"build_context/files/templates/modules/files/backend/repo.py","start_line":1,"symbol_ids":["sym_c9b35fda2a0a131c","sym_b2cb5dbd9e9210bd","sym_618fd6880d0f368d","sym_c97e3fe64298b724","sym_548210ef07da8ed3","sym_2d94e30e050bbb14","sym_fdb839d67d1b727d"],"text":"from __future__ import annotations\n\nfrom collections.abc import Mapping\nfrom typing import Any\n\nDocument = dict[str, Any]\n\n\ndef _collection(ctx, entity_name: str):\n    persistence = getattr(ctx, \"persistence\", None)\n    if persistence is None:\n        raise RuntimeError(\"Persistence is not available for this app context.\")\n    return persistence.collection(\"files\", entity_name)\n\n\ndef _document(value: Any) -> Document | None:\n    return dict(value) if isinstance(value, Mapping) else None\n\n\ndef _documents(values: list[Any] | None) -> list[Document]:\n    return [dict(item) for item in values or [] if isinstance(item, Mapping)]\n\n\nasync def register_file(\n    ctx,\n    *,\n    file_id: str,\n    filename: str,\n    mime_type: str,\n    size_bytes: int,\n    storage_url: str,\n    is_public: bool,\n    created_by: str,\n    metadata: dict[str, Any] | None = None,\n) -> None:\n    app_id = getattr(ctx, \"app_id\", None)\n    record = {\n        \"file_id\": file_id,\n        \"app_id\": app_id,\n        \"filename\": filename,\n        \"mime_type\": mime_type,\n        \"size_bytes\": size_bytes,\n        \"storage_url\": storage_url,\n        \"is_public\": is_public,\n        \"created_by\": created_by,\n        \"deleted\": False,\n        \"deleted_at\": None,\n        \"deleted_by\": None,\n        \"metadata\": dict(metadata or {}),\n    }\n    await _collection(ctx, \"records\").insert_one(record)\n\n\nasync def get_file(ctx, *, file_id: str) -> Document | None:\n    app_id = getattr(ctx, \"app_id\", None)\n    return _document(\n        await _collection(ctx, \"records\").find_one(\n            {\"app_id\": app_id, \"file_id\": file_id, \"deleted\": {\"$ne\": True}}\n        )\n    )\n\n\nasync def list_files(\n    ctx,\n    *,\n    created_by: str | None = None,\n    is_public: bool | None = None,\n    mime_type: str | None = None,\n    limit: int = 50,\n) -> list[Document]:\n    app_id = getattr(ctx, \"app_id\", None)\n    query: dict[str, Any] = {\"app_id\": app_id, \"deleted\": {\"$ne\": True}}\n    if created_by is not None:\n        query[\"created_by\"] = created_by\n    if is_public is not None:\n        query[\"is_public\"] = is_public\n    if mime_type is not None:\n        query[\"mime_type\"] = mime_type\n    return _documents(\n        await _collection(ctx, \"records\").find_many(\n            query,\n            limit=max(1, min(int(limit), 200)),\n            sort=[(\"created_at\", -1)],\n        )\n    )\n\n\nasync def soft_delete_file(ctx, *, file_id: str, deleted_by: str) -> int:\n    from .schemas import timestamp_now\n\n    app_id = getattr(ctx, \"app_id\", None)\n    result = await _collection(ctx, \"records\").update_one(\n        {\"app_id\": app_id, \"file_id\": file_id, \"deleted\": {\"$ne\": True}},\n        {\n            \"$set\": {\n                \"deleted\": True,\n                \"deleted_at\": timestamp_now(),\n                \"deleted_by\": deleted_by,\n            }\n        },\n    )\n    return int(getattr(result, \"matched_count\", 0) or 0)"},{"checksum":"sha256:fd8c509949def7ecd598557bb4a3639219ac76ea705327fc1d2d35fde3683107","chunk_id":"chunk_31a168d120e45e13","end_line":86,"path":"build_context/files/templates/modules/files/backend/schemas.py","start_line":1,"symbol_ids":["sym_5751d46d214c5f0c","sym_7fdc69aa7e050168","sym_2d10f238396c6053","sym_7298d0a34db4d86a","sym_0f1e41863f4e403a","sym_4cce6ecbe5e8445a"],"text":"from __future__ import annotations\n\nfrom datetime import UTC, datetime\nfrom typing import Any, TypedDict\nfrom uuid import uuid4\n\n\nclass FileRecord(TypedDict, total=False):\n    file_id: str\n    app_id: str\n    filename: str\n    mime_type: str\n    size_bytes: int\n    storage_url: str\n    is_public: bool\n    created_by: str\n    created_at: str\n    deleted: bool\n    deleted_at: str | None\n    deleted_by: str | None\n    metadata: dict[str, Any]\n\n\ndef timestamp_now() -> str:\n    return datetime.now(UTC).isoformat()\n\n\ndef new_file_id() -> str:\n    return f\"file_{uuid4().hex}\"\n\n\ndef metadata_entries_to_map(entries: list[dict[str, Any]] | None) -> dict[str, str]:\n    \"\"\"Fold closed {key, value} request entries into the stored metadata map.\n\n    The module request contract carries metadata as typed entries; file records\n    keep the {key: value} map shape. Later entries win on duplicate keys.\n    \"\"\"\n    metadata: dict[str, str] = {}\n    for entry in entries or []:\n        metadata[str(entry[\"key\"])] = str(entry[\"value\"])\n    return metadata\n\n\ndef build_file_record(\n    *,\n    app_id: str,\n    filename: str,\n    mime_type: str,\n    size_bytes: int,\n    storage_url: str,\n    is_public: bool = False,\n    created_by: str,\n    metadata: dict[str, Any] | None = None,\n) -> FileRecord:\n    now = timestamp_now()\n    return {\n        \"file_id\": new_file_id(),\n        \"app_id\": app_id,\n        \"filename\": str(filename or \"\").strip(),\n        \"mime_type\": str(mime_type or \"\").strip(),\n        \"size_bytes\": int(size_bytes),\n        \"storage_url\": str(storage_url or \"\").strip(),\n        \"is_public\": bool(is_public),\n        \"created_by\": created_by,\n        \"created_at\": now,\n        \"deleted\": False,\n        \"deleted_at\": None,\n        \"deleted_by\": None,\n        \"metadata\": dict(metadata or {}),\n    }\n\n\ndef safe_file_record(doc: Any) -> dict[str, Any]:\n    \"\"\"Return a safe dict of file fields, excluding internal storage fields.\"\"\"\n    if not doc:\n        return {}\n    return {\n        \"file_id\": doc.get(\"file_id\"),\n        \"filename\": doc.get(\"filename\"),\n        \"mime_type\": doc.get(\"mime_type\"),\n        \"size_bytes\": doc.get(\"size_bytes\"),\n        \"storage_url\": doc.get(\"storage_url\"),\n        \"is_public\": doc.get(\"is_public\", False),\n        \"created_by\": doc.get(\"created_by\"),\n        \"created_at\": doc.get(\"created_at\"),\n    }"},{"checksum":"sha256:93673c42a3e223639789de591483fe6ed1f8e30f62453eba8e2b54c39b17a91f","chunk_id":"chunk_d842a8709288049c","end_line":132,"path":"build_context/files/templates/modules/files/backend/service.py","start_line":1,"symbol_ids":["sym_fb4208cda0ab13d6","sym_59b5b133f02c6685","sym_762cd5c118007239","sym_47e99ed912896931","sym_64334c1b8f335a91","sym_3962e297ed9ff52d"],"text":"from __future__ import annotations\n\nimport inspect\nfrom typing import Any\n\nfrom .repo import get_file, list_files, register_file, soft_delete_file\nfrom .schemas import build_file_record, metadata_entries_to_map, safe_file_record\n\n\nclass FilesService:\n    async def _emit(self, ctx, event_type: str, payload: dict[str, Any]) -> None:\n        emit = getattr(ctx, \"emit\", None)\n        if emit is None:\n            return\n        result = emit(event_type, payload)\n        if inspect.isawaitable(result):\n            await result\n\n    async def upload_file(\n        self,\n        ctx,\n        *,\n        filename: str,\n        mime_type: str,\n        size_bytes: int,\n        storage_url: str,\n        is_public: bool = False,\n        metadata: list[dict[str, Any]] | None = None,\n    ) -> dict[str, Any]:\n        filename = str(filename or \"\").strip()\n        if not filename:\n            return {\"success\": False, \"error\": \"filename is required\"}\n\n        mime_type = str(mime_type or \"\").strip()\n        if not mime_type:\n            return {\"success\": False, \"error\": \"mime_type is required\"}\n\n        try:\n            size_bytes = int(size_bytes)\n        except (TypeError, ValueError):\n            return {\"success\": False, \"error\": \"size_bytes must be an integer\"}\n        if size_bytes <= 0:\n            return {\"success\": False, \"error\": \"size_bytes must be greater than zero\"}\n\n        storage_url = str(storage_url or \"\").strip()\n        if not storage_url:\n            return {\"success\": False, \"error\": \"storage_url is required\"}\n\n        created_by = str(getattr(ctx, \"user_id\", None) or \"anonymous\").strip() or \"anonymous\"\n        app_id = str(getattr(ctx, \"app_id\", None) or \"\")\n\n        record = build_file_record(\n            app_id=app_id,\n            filename=filename,\n            mime_type=mime_type,\n            size_bytes=size_bytes,\n            storage_url=storage_url,\n            is_public=is_public,\n            created_by=created_by,\n            metadata=metadata_entries_to_map(metadata),\n        )\n\n        await register_file(\n            ctx,\n            file_id=record[\"file_id\"],\n            filename=record[\"filename\"],\n            mime_type=record[\"mime_type\"],\n            size_bytes=record[\"size_bytes\"],\n            storage_url=record[\"storage_url\"],\n            is_public=record[\"is_public\"],\n            created_by=record[\"created_by\"],\n            metadata=record.get(\"metadata\"),\n        )\n\n        await self._emit(\n            ctx,\n            \"domain.files.file_uploaded\",\n            {\n                \"file_id\": record[\"file_id\"],\n                \"filename\": record[\"filename\"],\n                \"mime_type\": record[\"mime_type\"],\n                \"size_bytes\": record[\"size_bytes\"],\n                \"is_public\": record[\"is_public\"],\n                \"created_by\": record[\"created_by\"],\n                \"app_id\": app_id,\n            },\n        )\n\n        return {\"success\": True, \"file\": safe_file_record(record)}\n\n    async def get_file(self, ctx, *, file_id: str) -> dict[str, Any]:\n        doc = await get_file(ctx, file_id=file_id)\n        return {\"file\": safe_file_record(doc) if doc else None}\n\n    async def list_files(\n        self,\n        ctx,\n        *,\n        is_public: bool | None = None,\n        mime_type: str | None = None,\n        limit: int = 50,\n    ) -> dict[str, Any]:\n        created_by = str(getattr(ctx, \"user_id\", None) or \"\").strip() or None\n        docs = await list_files(\n            ctx,\n            created_by=created_by,\n            is_public=is_public,\n            mime_type=mime_type,\n            limit=limit,\n        )\n        files = [safe_file_record(doc) for doc in docs]\n        return {\"files\": files, \"total\": len(files)}\n\n    async def delete_file(self, ctx, *, file_id: str) -> dict[str, Any]:\n        deleted_by = str(getattr(ctx, \"user_id\", None) or \"anonymous\").strip() or \"anonymous\"\n        app_id = getattr(ctx, \"app_id\", None)\n\n        matched = await soft_delete_file(ctx, file_id=file_id, deleted_by=deleted_by)\n        if not matched:\n            return {\"success\": False, \"error\": \"file not found\"}\n\n        await self._emit(\n            ctx,\n            \"domain.files.file_deleted\",\n            {\n                \"file_id\": file_id,\n                \"deleted_by\": deleted_by,\n                \"app_id\": app_id,\n            },\n        )\n\n        return {\"success\": True}"},{"checksum":"sha256:93fda88eba54c5b113813fd6d0b282d347f77324037ea032564f95c343ffb072","chunk_id":"chunk_8476414bcdfc49e3","end_line":29,"path":"build_context/files/templates/modules/files/contracts/events.yaml","start_line":1,"symbol_ids":[],"text":"schema_version: mozaiks.events.v1\nevents:\n  - type: domain.files.file_uploaded\n    version: 1\n    description: Emitted after a file metadata record is registered following external blob upload.\n    producer: files\n    payload_schema:\n      type: object\n      required: [file_id, filename, mime_type, size_bytes, created_by, app_id]\n      properties:\n        file_id: { type: string }\n        filename: { type: string }\n        mime_type: { type: string }\n        size_bytes: { type: integer }\n        is_public: { type: boolean }\n        created_by: { type: string }\n        app_id: { type: string }\n\n  - type: domain.files.file_deleted\n    version: 1\n    description: Emitted after a file metadata record is soft-deleted. Storage adapters may use this to schedule blob cleanup.\n    producer: files\n    payload_schema:\n      type: object\n      required: [file_id, deleted_by, app_id]\n      properties:\n        file_id: { type: string }\n        deleted_by: { type: string }\n        app_id: { type: string }"},{"checksum":"sha256:be950326b512e83373587e2d01a6204e07f0c32e9d3c6b29f2c85637b13b4f24","chunk_id":"chunk_27b016347923d4c8","end_line":20,"path":"build_context/files/templates/modules/files/contracts/notifications.yaml","start_line":1,"symbol_ids":[],"text":"schema_version: mozaiks.notifications.v1\n\nnotifications:\n  - id: public_file_uploaded\n    description: Notify relevant users when a public file is uploaded and available for viewing.\n    event_type: domain.files.file_uploaded\n    condition:\n      field: is_public\n      value: true\n    channels:\n      - in_app\n    audience:\n      strategy: app_admins\n    template:\n      title: \"New file available\"\n      body: \"{{filename}} has been uploaded.\"\n    context_fields:\n      - file_id\n      - filename\n      - mime_type"},{"checksum":"sha256:46fdae03b8d501d784cc9a67c9614e9e58bf72fa0c8249eb4fd6bd01237277af","chunk_id":"chunk_0bc963ee49fb2e0c","end_line":146,"path":"build_context/files/templates/modules/files/module.yaml","start_line":1,"symbol_ids":[],"text":"schema_version: mozaiks.module.v1\nmodule:\n  id: files\n  display_name: Files\n  version: 1.0.0\n  description: User-generated file upload, storage metadata, retrieval, and deletion. Stores file metadata only; blobs are managed by the app's storage adapter.\n  owner: app\n  visibility: private\n  handler: backend.handler:FilesHandler\n  user_data_scope: true\n\npermissions:\n  - id: files.read\n    description: Read file records and metadata.\n  - id: files.write\n    description: Upload and delete files.\n\nactions:\n  - id: upload_file\n    description: Register a file record after the blob has been stored externally.\n    handler_method: upload_file\n    input_schema:\n      type: object\n      additionalProperties: false\n      required: [filename, mime_type, size_bytes, storage_url]\n      properties:\n        filename:\n          type: string\n        mime_type:\n          type: string\n        size_bytes:\n          type: integer\n        # storage_url \u2014 opaque provider URL returned by the storage adapter\n        # after blob upload.\n        storage_url:\n          type: string\n        # is_public \u2014 optional; the service defaults omitted values to false.\n        is_public:\n          type: boolean\n        # metadata \u2014 optional file annotation entries. Stored on the file\n        # record as a {key: value} map built from these typed entries.\n        metadata:\n          type: array\n          items:\n            type: object\n            additionalProperties: false\n            required: [key, value]\n            properties:\n              key: { type: string }\n              value: { type: string }\n    output_schema:\n      type: object\n      required: [success, file]\n      properties:\n        success:\n          type: boolean\n        file:\n          type: object\n    permissions:\n      - files.write\n    emits:\n      - domain.files.file_uploaded\n\n  - id: get_file\n    description: Fetch a single file record by file_id.\n    handler_method: get_file\n    input_schema:\n      type: object\n      additionalProperties: false\n      required: [file_id]\n      properties:\n        file_id:\n          type: string\n    output_schema:\n      type: object\n      required: [file]\n      properties:\n        file:\n          type: object\n    permissions:\n      - files.read\n\n  - id: list_files\n    description: List file records for the current user.\n    handler_method: list_files\n    input_schema:\n      type: object\n      additionalProperties: false\n      properties:\n        is_public:\n          type: boolean\n        mime_type:\n          type: string\n        limit:\n          type: integer\n    output_schema:\n      type: object\n      required: [files, total]\n      properties:\n        files:\n          type: array\n        total:\n          type: integer\n    permissions:\n      - files.read\n\n  - id: delete_file\n    description: Soft-delete a file record by file_id.\n    handler_method: delete_file\n    input_schema:\n      type: object\n      additionalProperties: false\n      required: [file_id]\n      properties:\n        file_id:\n          type: string\n    output_schema:\n      type: object\n      required: [success]\n      properties:\n        success:\n          type: boolean\n    permissions:\n      - files.write\n    emits:\n      - domain.files.file_deleted\n\ncapabilities:\n  - capability_id: files.upload\n    kind: action\n    target: upload_file\n    title: Upload file\n    permissions:\n      - files.write\n  - capability_id: files.read\n    kind: action\n    target: list_files\n    title: List files\n    permissions:\n      - files.read\n  - capability_id: files.delete\n    kind: action\n    target: delete_file\n    title: Delete file\n    permissions:\n      - files.write"},{"checksum":"sha256:aad4ff21fd572c10d5845c46e4cc2994fb13a4f3a865651ad945d17950e70721","chunk_id":"chunk_94f5d3d361274c2e","end_line":40,"path":"build_context/infra/context.yaml","start_line":1,"symbol_ids":[],"text":"context_id: infra\ndescription: Provider-neutral deployment scaffold templates.\n\napplies_to_workflows:\n  - AppGenerator\n\n# Reference template variables for explicitly selected infrastructure packs.\n# DownloadAgent's canonical deployment renderer owns generated deployment artifacts.\n#   APP_NAME                   \u2014 app slug used in image tags\n#   MOZAIKS_VERSION            \u2014 pinned mozaiks version from requirements.txt\n#   REGISTRY                   \u2014 container registry prefix (e.g. ghcr.io/your-org)\n#   DEPLOY_TARGET              \u2014 azure_container_apps | fly | render | generic\n#\n# Cron script template variables (templates/scripts/cron_tick.py):\n#   ACTION_LABEL               \u2014 human-readable name (e.g. \"Placement lifecycle\")\n#   ACTION_DESCRIPTION         \u2014 one-line description of what the tick does\n#   CRON_INTERVAL_MINUTES      \u2014 tick frequency in minutes (e.g. 5)\n#   CRON_SCRIPT_NAME           \u2014 output filename without .py (e.g. cron_placement_lifecycle)\n#   MODULE_ID                  \u2014 module directory name (e.g. investor_marketplace)\n#   SERVICE_CLASS              \u2014 service class name (e.g. InvestorMarketplaceService)\n#   TICK_METHOD                \u2014 service method name (e.g. run_placement_lifecycle_tick)\n#   ACTION_ID                  \u2014 log prefix identifier (e.g. placement_lifecycle)\n#\n# Provider job provisioning belongs to the operator or hosted deployment adapter,\n# not to generated apps or the auth scaffold.\n\nassets:\n  - path: templates\n    kind: templates\n    description: >\n      Reference infrastructure templates for explicitly selected build packs.\n      AuthScaffoldAgent does not emit these files. DownloadAgent owns the\n      canonical provider-neutral deployment artifact contract.\n      Operator-owned after first emit; regeneration is explicit and opt-in.\n      The readiness workflow is an environment-staging gate for the promoted or\n      exported app. It is separate from Mozaiks artifact review staging, where\n      generated files wait for validation, review, and promotion.\n      templates/scripts/cron_tick.py is emitted once per state_machine module\n      that requires an external cron entry point; each copy is renamed to\n      scripts/cron_<entity>_lifecycle.py in the generated app bundle."},{"checksum":"sha256:b9852fbb138dd12862682b038e21115f478c64fe9fa1383d8f00d0134f4d5cdb","chunk_id":"chunk_fbd7fe1b58049949","end_line":168,"path":"build_context/infra/templates/.github/workflows/deploy.yml","start_line":1,"symbol_ids":[],"text":"# Generated by mozaiks InfraScaffoldAgent \u2014 edit after generation as needed.\n# ============================================================================\n# {{APP_NAME}} \u2014 Deploy workflow\n# Template variables: {{APP_NAME}}, {{REGISTRY}}, {{DEPLOY_TARGET}}\n# Environment names such as staging/production belong to the operator or host.\n# They are separate from Mozaiks artifact review staging and promotion.\n# ============================================================================\nname: Deploy\n\non:\n  push:\n    branches:\n      - main      # auto-deploy to production\n      - staging   # auto-deploy to staging\n  workflow_dispatch:\n    inputs:\n      environment:\n        description: \"Target environment\"\n        required: true\n        default: \"production\"\n        type: choice\n        options:\n          - production\n          - staging\n\nconcurrency:\n  group: deploy-${{ github.ref }}\n  cancel-in-progress: false  # never cancel an in-flight deploy\n\npermissions:\n  contents: read\n  id-token: [REDACTED]  # OIDC token for cloud provider login\n\njobs:\n  # \u2500\u2500 Build and push Docker image \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n  build-and-push:\n    name: Build and push image\n    runs-on: ubuntu-latest\n    environment:\n      name: >-\n        ${{\n          github.event.inputs.environment\n          || (github.ref == 'refs/heads/staging' && 'staging')\n          || 'production'\n        }}\n    outputs:\n      image_tag: ${{ steps.meta.outputs.tag }}\n    steps:\n      - uses: actions/checkout@v4\n\n      - name: Validate build configuration\n        env:\n          VITE_OIDC_REDIRECT_URI: [REDACTED] vars.VITE_OIDC_REDIRECT_URI || secrets.VITE_OIDC_REDIRECT_URI }}\n          VITE_OIDC_AUTHORITY: [REDACTED] vars.VITE_OIDC_AUTHORITY || secrets.VITE_OIDC_AUTHORITY }}\n        run: |\n          missing=()\n          for name in VITE_OIDC_REDIRECT_URI; do\n            if [ -z \"${!name:-}\" ]; then\n              missing+=(\"$name\")\n            fi\n          done\n          if [ -z \"${VITE_OIDC_AUTHORITY:-}\" ]; then\n            echo \"WARNING: VITE_OIDC_AUTHORITY not set \u2014 OIDC login will not work\"\n          fi\n          if [ ${#missing[@]} -gt 0 ]; then\n            echo \"ERROR: [REDACTED] secrets not set: [REDACTED]\" >&2\n            exit 1\n          fi\n\n      - name: Set image tag\n        id: meta\n        run: |\n          SHORT_SHA=\"${GITHUB_SHA::8}\"\n          ENV_NAME=\"${{ github.event.inputs.environment || (github.ref == 'refs/heads/staging' && 'staging') || 'production' }}\"\n          echo \"tag={{REGISTRY}}/{{APP_NAME}}:${ENV_NAME}-${SHORT_SHA}\" >> \"$GITHUB_OUTPUT\"\n\n      - name: Log in to container registry\n        # Replace this step with the login action for your registry.\n        # Azure ACR example (uncomment and configure):\n        # - uses: azure/login@v2\n        #   with:\n        #     client-id: [REDACTED] secrets.AZURE_OIDC_CLIENT_ID }}\n        #     tenant-id: [REDACTED] secrets.AZURE_TENANT_ID }}\n        #     subscription-id: [REDACTED] secrets.AZURE_SUBSCRIPTION_ID }}\n        # - run: [REDACTED] acr login --name ${{ secrets.ACR_NAME }}\n        #\n        # GitHub Container Registry example:\n        # - uses: docker/login-action@v3\n        #   with:\n        #     registry: ghcr.io\n        #     username: ${{ github.actor }}\n        #     password: [REDACTED] secrets.GITHUB_TOKEN }}\n        run: echo \"Configure registry login for {{DEPLOY_TARGET}}\"\n\n      - name: Build and push image\n        run: |\n          docker build \\\n            --build-arg VITE_OIDC_AUTHORITY=\"${{ vars.VITE_OIDC_AUTHORITY || secrets.VITE_OIDC_AUTHORITY }}\" \\\n            --build-arg VITE_OIDC_REDIRECT_URI=\"${{ vars.VITE_OIDC_REDIRECT_URI || secrets.VITE_OIDC_REDIRECT_URI }}\" \\\n            --build-arg VITE_OIDC_DISCOVERY_URL=\"${{ vars.VITE_OIDC_DISCOVERY_URL || '' }}\" \\\n            -t \"${{ steps.meta.outputs.tag }}\" \\\n            .\n          docker push \"${{ steps.meta.outputs.tag }}\"\n\n  # \u2500\u2500 Deploy image to target platform \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n  deploy:\n    name: Deploy to ${{ github.event.inputs.environment || 'production' }}\n    needs: build-and-push\n    runs-on: ubuntu-latest\n    environment:\n      name: >-\n        ${{\n          github.event.inputs.environment\n          || (github.ref == 'refs/heads/staging' && 'staging')\n          || 'production'\n        }}\n    steps:\n      - uses: actions/checkout@v4\n\n      - name: Deploy\n        env:\n          IMAGE_TAG: ${{ needs.build-and-push.outputs.image_tag }}\n        run: |\n          # Replace this block with the deploy command for {{DEPLOY_TARGET}}.\n          #\n          # Azure Container Apps example:\n          #   az containerapp update \\\n          #     --name {{APP_NAME}} \\\n          #     --resource-group <rg-name> \\\n          #     --image \"$IMAGE_TAG\"\n          #\n          # Fly.io example:\n          #   fly deploy --image \"$IMAGE_TAG\" --app {{APP_NAME}}\n          #\n          # Render: update the SERVICE_ID image via the Render API.\n          echo \"Deploying $IMAGE_TAG to {{DEPLOY_TARGET}}\"\n\n  # \u2500\u2500 Post-deploy health verify \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n  verify:\n    name: Health check\n    needs: deploy\n    runs-on: ubuntu-latest\n    environment:\n      name: >-\n        ${{\n          github.event.inputs.environment\n          || (github.ref == 'refs/heads/staging' && 'staging')\n          || 'production'\n        }}\n    steps:\n      - name: Wait for app to come up\n        run: sleep 30\n\n      - name: Health check\n        env:\n          APP_URL: [REDACTED] vars.APP_URL || secrets.APP_URL }}\n        run: |\n          for i in {1..10}; do\n            if curl -sf \"${APP_URL}/api/health\"; then\n              echo \"Health check passed\"\n              exit 0\n            fi\n            echo \"Attempt $i failed \u2014 retrying in 15s\"\n            sleep 15\n          done\n          echo \"Health check failed after 10 attempts \u2014 triggering rollback\" >&2\n          # Add rollback command here for {{DEPLOY_TARGET}}\n          exit 1"},{"checksum":"sha256:8ecad45f1e3667e9f0604cbd2c060f0b538db51f333f98eb985cd5bc859ec057","chunk_id":"chunk_645c7fd9ec591bf1","end_line":80,"path":"build_context/infra/templates/scripts/cron_tick.py","start_line":1,"symbol_ids":["sym_9468b71c36bd96d6","sym_9d436338a70cfe9e","sym_870d0109fb45d302","sym_ec0bcfecfcd962f0","sym_06cd634ca3330c6b"],"text":"\"\"\"{{ACTION_LABEL}} \u2014 run via ACA Job, platform cron trigger, or scheduled workflow.\n\n{{ACTION_DESCRIPTION}}\n\nSafe to run frequently (every {{CRON_INTERVAL_MINUTES}} minutes). Emits domain\nevents and records audit entries. Exits non-zero if any transitions produced\nerrors so the scheduler can surface failures.\n\nUsage:\n    python scripts/{{CRON_SCRIPT_NAME}}.py\n    python scripts/{{CRON_SCRIPT_NAME}}.py --mongo-uri mongodb://...\n\nRequired env vars:\n    MONGO_URI   \u2014 MongoDB connection URI\n\nMaterialized from the selected infrastructure build pack. Edit after generation as needed.\nTemplate variables: {{ACTION_LABEL}}, {{ACTION_DESCRIPTION}},\n  {{CRON_INTERVAL_MINUTES}}, {{CRON_SCRIPT_NAME}}, {{MODULE_ID}},\n  {{SERVICE_CLASS}}, {{TICK_METHOD}}, {{ACTION_ID}}\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport asyncio\nimport os\nimport sys\nfrom pathlib import Path\n\nROOT = Path(__file__).resolve().parents[1]\nif str(ROOT) not in sys.path:\n    sys.path.insert(0, str(ROOT))\n\nfrom app.modules.{{MODULE_ID}}.backend.service import {{SERVICE_CLASS}}  # noqa: E402\nfrom mozaiksai.core.core_config import close_mongo_client, get_mongo_client  # noqa: E402\n\n\nclass _MinimalCtx:\n    \"\"\"Minimal context stub for service calls outside the request cycle.\n\n    Captures emitted events without dispatching them to the live event bus.\n    Replace with a real dispatcher if downstream reactions must fire during\n    the cron tick (uncommon \u2014 prefer letting the tick emit events that the\n    running app process reacts to via its own subscription).\n    \"\"\"\n\n    def __init__(self) -> None:\n        self._emitted: list[tuple[str, dict]] = []\n\n    async def emit(self, event_type: str, payload: dict) -> None:\n        self._emitted.append((event_type, payload))\n\n\nasync def run(mongo_uri: str | None = None) -> int:\n    if mongo_uri:\n        os.environ.setdefault(\"MONGO_URI\", mongo_uri)\n    get_mongo_client()  # validates MONGO_URI is present; raises ValueError early if not\n    try:\n        ctx = _MinimalCtx()\n        service = {{SERVICE_CLASS}}()\n        result = await service.{{TICK_METHOD}}(ctx)\n        errors = result.get(\"errors\", [])\n        # Log a compact summary line so container job logs are easy to scan.\n        print(f\"[{{ACTION_ID}}] result={result} errors={len(errors)}\")\n        for err in errors:\n            print(f\"  ERROR: {err}\", file=sys.stderr)\n        return 1 if errors else 0\n    finally:\n        close_mongo_client()\n\n\ndef main() -> None:\n    parser = argparse.ArgumentParser(description=\"{{ACTION_LABEL}}\")\n    parser.add_argument(\"--mongo-uri\", default=None, help=\"MongoDB connection URI (overrides MONGO_URI env var)\")\n    args = parser.parse_args()\n    sys.exit(asyncio.run(run(mongo_uri=args.mongo_uri)))\n\n\nif __name__ == \"__main__\":\n    main()"},{"checksum":"sha256:3042fcf736be0fe89f55e268fa2031ab80036005afa26e481045d3f57840fe01","chunk_id":"chunk_d5f666fbcbb55662","end_line":236,"path":"build_context/infra/templates/workflows/deploy.yml","start_line":1,"symbol_ids":[],"text":"# Operator reference template; generated app deployment files are owned by DownloadAgent.\n# ============================================================================\n# {{APP_NAME}} \u2014 Deploy workflow\n# Template variables: {{APP_NAME}}, {{REGISTRY}}, {{DEPLOY_TARGET}}\n# Environment names such as staging/production belong to the operator or host.\n# They are separate from Mozaiks artifact review staging and promotion.\n# ============================================================================\nname: Deploy\n\non:\n  push:\n    branches:\n      - main      # auto-deploy to production\n      - staging   # auto-deploy to staging\n  workflow_dispatch:\n    inputs:\n      environment:\n        description: \"Target environment\"\n        required: true\n        default: \"production\"\n        type: choice\n        options:\n          - production\n          - staging\n\nconcurrency:\n  group: deploy-${{ github.ref }}\n  cancel-in-progress: false  # never cancel an in-flight deploy\n\npermissions:\n  contents: read\n  id-token: [REDACTED]  # OIDC token for cloud provider login\n\njobs:\n  # \u2500\u2500 Build and push Docker image \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n  build-and-push:\n    name: Build and push image\n    runs-on: ubuntu-latest\n    environment:\n      name: >-\n        ${{\n          github.event.inputs.environment\n          || (github.ref == 'refs/heads/staging' && 'staging')\n          || 'production'\n        }}\n    outputs:\n      image_tag: ${{ steps.meta.outputs.tag }}\n    steps:\n      - uses: actions/checkout@v4\n\n      - name: Validate build configuration\n        env:\n          VITE_OIDC_REDIRECT_URI: [REDACTED] vars.VITE_OIDC_REDIRECT_URI || secrets.VITE_OIDC_REDIRECT_URI }}\n          VITE_OIDC_AUTHORITY: [REDACTED] vars.VITE_OIDC_AUTHORITY || secrets.VITE_OIDC_AUTHORITY }}\n          VITE_OIDC_DISCOVERY_URL: [REDACTED] vars.VITE_OIDC_DISCOVERY_URL || secrets.VITE_OIDC_DISCOVERY_URL }}\n        run: |\n          is_placeholder() {\n            local value=\"${1:-}\"\n            value=\"${value#\"${value%%[![:space:]]*}\"}\"\n            value=\"${value%\"${value##*[![:space:]]}\"}\"\n            [[ \"$value\" == \"placeholder-change-me\" || \"$value\" == \"<NEEDED\"* ]]\n          }\n\n          missing=()\n          for name in VITE_OIDC_REDIRECT_URI; do\n            if [ -z \"${!name:-}\" ]; then\n              missing+=(\"$name\")\n            elif is_placeholder \"${!name}\"; then\n              missing+=(\"$name (placeholder)\")\n            fi\n          done\n\n          oidc_sources=()\n          for name in VITE_OIDC_AUTHORITY VITE_OIDC_DISCOVERY_URL; do\n            if [ -n \"${!name:-}\" ] && ! is_placeholder \"${!name}\"; then\n              oidc_sources+=(\"$name\")\n            fi\n          done\n          if [ \"${#oidc_sources[@]}\" -eq 0 ]; then\n            missing+=(\"VITE_OIDC_AUTHORITY or VITE_OIDC_DISCOVERY_URL\")\n          fi\n\n          if [ ${#missing[@]} -gt 0 ]; then\n            printf 'Missing required build configuration: %s\\n' \"${missing[*]}\" >&2\n            exit 1\n          fi\n\n      - name: Set image tag\n        id: meta\n        run: |\n          SHORT_SHA=\"${GITHUB_SHA::8}\"\n          ENV_NAME=\"${{ github.event.inputs.environment || (github.ref == 'refs/heads/staging' && 'staging') || 'production' }}\"\n          echo \"tag={{REGISTRY}}/{{APP_NAME}}:${ENV_NAME}-${SHORT_SHA}\" >> \"$GITHUB_OUTPUT\"\n\n      - name: Log in to container registry\n        # Replace this step with the login action for your registry.\n        #\n        # Azure ACR example:\n        #   - uses: azure/login@v2\n        #     with:\n        #       client-id: [REDACTED] secrets.AZURE_OIDC_CLIENT_ID }}\n        #       tenant-id: [REDACTED] secrets.AZURE_TENANT_ID }}\n        #       subscription-id: [REDACTED] secrets.AZURE_SUBSCRIPTION_ID }}\n        #   - run: [REDACTED] acr login --name ${{ secrets.ACR_NAME }}\n        #\n        # GitHub Container Registry example:\n        #   - uses: docker/login-action@v3\n        #     with:\n        #       registry: ghcr.io\n        #       username: ${{ github.actor }}\n        #       password: [REDACTED] secrets.GITHUB_TOKEN }}\n        run: echo \"Configure registry login for {{DEPLOY_TARGET}}\"\n\n      - name: Set up Docker Buildx\n        uses: docker/setup-buildx-action@v3\n\n      - name: Build and push image\n        uses: docker/build-push-action@v5\n        with:\n          context: .\n          push: true\n          tags: ${{ steps.meta.outputs.tag }}\n          build-args: |\n            VITE_OIDC_AUTHORITY=[REDACTED] vars.VITE_OIDC_AUTHORITY || secrets.VITE_OIDC_AUTHORITY }}\n            VITE_OIDC_CLIENT_ID=[REDACTED] vars.VITE_OIDC_CLIENT_ID || secrets.VITE_OIDC_CLIENT_ID || '{{APP_NAME}}' }}\n            VITE_OIDC_DISCOVERY_URL=${{ vars.VITE_OIDC_DISCOVERY_URL || '' }}\n            VITE_OIDC_SCOPE=${{ vars.VITE_OIDC_SCOPE || 'openid profile email' }}\n            VITE_OIDC_REDIRECT_URI=[REDACTED] vars.VITE_OIDC_REDIRECT_URI || secrets.VITE_OIDC_REDIRECT_URI }}\n            VITE_MOCK_MODE=false\n          cache-from: type=gha\n          cache-to: type=gha,mode=max\n\n  # \u2500\u2500 Deploy image to target platform \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n  deploy:\n    name: Deploy to ${{ github.event.inputs.environment || 'production' }}\n    needs: build-and-push\n    runs-on: ubuntu-latest\n    environment:\n      name: >-\n        ${{\n          github.event.inputs.environment\n          || (github.ref == 'refs/heads/staging' && 'staging')\n          || 'production'\n        }}\n    steps:\n      - uses: actions/checkout@v4\n\n      - name: Validate deploy configuration\n        env:\n          MONGO_URI: [REDACTED] secrets.MONGO_URI }}\n          OPENAI_API_KEY: [REDACTED] secrets.OPENAI_API_KEY }}\n          ANTHROPIC_API_KEY: [REDACTED] secrets.ANTHROPIC_API_KEY }}\n          INTERNAL_API_KEY: [REDACTED] secrets.INTERNAL_API_KEY }}\n        run: |\n          is_placeholder() {\n            local value=\"${1:-}\"\n            value=\"${value#\"${value%%[![:space:]]*}\"}\"\n            value=\"${value%\"${value##*[![:space:]]}\"}\"\n            [[ \"$value\" == \"placeholder-change-me\" || \"$value\" == \"<NEEDED\"* ]]\n          }\n\n          missing=()\n          # Validate required runtime secrets.\n          # Add app-specific required names to this list.\n          required_names=[REDACTED] OPENAI_API_KEY ANTHROPIC_API_KEY INTERNAL_API_KEY)\n          for name in \"${required_names[@]}\"; do\n            if [ -z \"${!name:-}\" ]; then\n              missing+=(\"$name\")\n            elif is_placeholder \"${!name}\"; then\n              missing+=(\"$name (placeholder)\")\n            fi\n          done\n\n          if [ \"${#missing[@]}\" -gt 0 ]; then\n            printf 'Missing required deploy configuration: %s\\n' \"${missing[*]}\" >&2\n            exit 1\n          fi\n\n      - name: Deploy to {{DEPLOY_TARGET}}\n        env:\n          IMAGE_TAG: ${{ needs.build-and-push.outputs.image_tag }}\n          MONGO_URI: [REDACTED] secrets.MONGO_URI }}\n          OPENAI_API_KEY: [REDACTED] secrets.OPENAI_API_KEY }}\n          ANTHROPIC_API_KEY: [REDACTED] secrets.ANTHROPIC_API_KEY }}\n          INTERNAL_API_KEY: [REDACTED] secrets.INTERNAL_API_KEY }}\n        run: |\n          # Replace this block with the deploy command for {{DEPLOY_TARGET}}.\n          #\n          # Azure Container Apps example:\n          #   az containerapp update \\\n          #     --name {{APP_NAME}} \\\n          #     --resource-group <rg-name> \\\n          #     --image \"$IMAGE_TAG\"\n          #\n          # Fly.io example:\n          #   fly deploy --image \"$IMAGE_TAG\" --app {{APP_NAME}}\n          #\n          # Render: use the Render Deploy Hook or update the service via the Render API.\n          #\n          # Generic (SSH + Docker Compose):\n          #   ssh $SSH_HOST \"docker pull $IMAGE_TAG && docker compose up -d\"\n          echo \"Deploying $IMAGE_TAG to {{DEPLOY_TARGET}}\"\n\n  # \u2500\u2500 Post-deploy health verify with rollback stub \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n  verify:\n    name: Health check\n    needs: [build-and-push, deploy]\n    runs-on: ubuntu-latest\n    environment:\n      name: >-\n        ${{\n          github.event.inputs.environment\n          || (github.ref == 'refs/heads/staging' && 'staging')\n          || 'production'\n        }}\n    steps:\n      - name: Wait for app to come up\n        run: sleep 30\n\n      - name: Health check\n        env:\n          APP_URL: [REDACTED] vars.APP_URL || secrets.APP_URL }}\n        run: |\n          for i in {1..10}; do\n            if curl -sf \"${APP_URL}/api/health\"; then\n              echo \"Health check passed\"\n              exit 0\n            fi\n            echo \"Attempt $i failed \u2014 retrying in 15s\"\n            sleep 15\n          done\n          echo \"Health check failed after 10 attempts\" >&2\n          # Add platform-specific rollback here, e.g.:\n          #   az containerapp revision deactivate --name {{APP_NAME}} ...\n          #   fly releases rollback --app {{APP_NAME}}\n          exit 1"},{"checksum":"sha256:e1320273f7ab9959a18dd8a367c33176cda2d891efdda5d4617ff36fa65b4e53","chunk_id":"chunk_7cfb69c0262296b4","end_line":221,"path":"build_context/infra/templates/workflows/readiness.yml","start_line":1,"symbol_ids":[],"text":"# Operator reference template; generated app deployment files are owned by DownloadAgent.\n# ============================================================================\n# {{APP_NAME}} \u2014 Staging readiness workflow\n# Run this manually before promoting staging \u2192 production.\n# This is environment staging for a promoted/exported app. It is not Mozaiks\n# artifact review staging, which happens before ArtifactVersion promotion.\n# ============================================================================\nname: Staging Readiness\n\non:\n  workflow_dispatch:\n    inputs:\n      run_container_gate:\n        description: \"Build and smoke the deployment image locally\"\n        required: true\n        default: true\n        type: boolean\n      run_remote_health:\n        description: \"Check deployed staging health endpoints\"\n        required: true\n        default: true\n        type: boolean\n      run_entitlement_gate:\n        description: \"Smoke subscription entitlement gates against staging\"\n        required: true\n        default: true\n        type: boolean\n\nconcurrency:\n  group: \"staging-readiness-{{APP_NAME}}\"\n  cancel-in-progress: false\n\npermissions:\n  contents: read\n\njobs:\n  readiness:\n    name: Staging readiness report\n    runs-on: ubuntu-latest\n    environment:\n      name: staging\n      url: ${{ vars.APP_URL }}\n\n    services:\n      mongo:\n        image: mongo:7\n        ports:\n          - 27017:27017\n        options: >-\n          --health-cmd \"mongosh --eval \\\"db.adminCommand('ping')\\\"\"\n          --health-interval 10s\n          --health-timeout 5s\n          --health-retries 5\n\n    steps:\n      - uses: actions/checkout@v4\n\n      - uses: actions/setup-python@v5\n        with:\n          python-version: \"3.11\"\n          cache: pip\n          cache-dependency-path: requirements.txt\n\n      - name: Install dependencies\n        run: |\n          python -m pip install --upgrade pip\n          python -m pip install -r requirements.txt\n          python -m pip install pytest pytest-asyncio anyio httpx\n\n      - name: [REDACTED] declared secrets\n        env:\n          MONGO_URI: [REDACTED] secrets.MONGO_URI }}\n          OPENAI_API_KEY: [REDACTED] secrets.OPENAI_API_KEY }}\n          ANTHROPIC_API_KEY: [REDACTED] secrets.ANTHROPIC_API_KEY }}\n          INTERNAL_API_KEY: [REDACTED] secrets.INTERNAL_API_KEY }}\n        run: |\n          # This validates the names expected by the generated app contract.\n          # Real secret values must live in the operator's CI/cloud secret store.\n          # Add app-specific secret names to this list (read from app/security/secrets.yaml).\n          required=[REDACTED] OPENAI_API_KEY ANTHROPIC_API_KEY INTERNAL_API_KEY)\n          missing=()\n          for name in \"${required[@]}\"; do\n            if [ -z \"${!name:-}\" ]; then\n              missing+=(\"$name\")\n            fi\n          done\n          if [ \"${#missing[@]}\" -gt 0 ]; then\n            printf 'Missing required staging secrets: [REDACTED]' \"${missing[*]}\" >&2\n            exit 1\n          fi\n          echo \"All required secrets present.\"\n\n      - name: Set up Docker Buildx\n        if: ${{ inputs.run_container_gate }}\n        uses: docker/setup-buildx-action@v3\n\n      - name: Build deployment image\n        if: ${{ inputs.run_container_gate }}\n        uses: docker/build-push-action@v5\n        with:\n          context: .\n          push: false\n          load: true\n          tags: \"{{APP_NAME}}:staging-readiness-${{ github.sha }}\"\n          build-args: |\n            VITE_OIDC_AUTHORITY=[REDACTED] vars.VITE_OIDC_AUTHORITY || secrets.VITE_OIDC_AUTHORITY }}\n            VITE_OIDC_CLIENT_ID=[REDACTED] vars.VITE_OIDC_CLIENT_ID || secrets.VITE_OIDC_CLIENT_ID || '{{APP_NAME}}' }}\n            VITE_OIDC_DISCOVERY_URL=${{ vars.VITE_OIDC_DISCOVERY_URL || '' }}\n            VITE_OIDC_SCOPE=${{ vars.VITE_OIDC_SCOPE || 'openid profile email' }}\n            VITE_OIDC_REDIRECT_URI=[REDACTED] vars.VITE_OIDC_REDIRECT_URI || secrets.VITE_OIDC_REDIRECT_URI }}\n            VITE_MOCK_MODE=false\n          cache-from: type=gha\n          cache-to: type=gha,mode=max\n\n      - name: Smoke deployment image startup\n        if: ${{ inputs.run_container_gate }}\n        env:\n          MONGO_URI: [REDACTED] secrets.MONGO_URI }}\n          OPENAI_API_KEY: [REDACTED] secrets.OPENAI_API_KEY }}\n          ANTHROPIC_API_KEY: [REDACTED] secrets.ANTHROPIC_API_KEY }}\n          INTERNAL_API_KEY: [REDACTED] secrets.INTERNAL_API_KEY }}\n        run: |\n          docker run --rm -d \\\n            --name {{APP_NAME}}-readiness-smoke \\\n            -p 8010:8000 \\\n            -e MONGO_URI=\"$MONGO_URI\" \\\n            -e OPENAI_API_KEY=\"[REDACTED]\" \\\n            -e ANTHROPIC_API_KEY=\"[REDACTED]\" \\\n            -e INTERNAL_API_KEY=\"[REDACTED]\" \\\n            -e MOZAIKS_ENV=staging \\\n            -e AUTH_ENABLED=false \\\n            {{APP_NAME}}:staging-readiness-${{ github.sha }}\n\n          for i in {1..12}; do\n            if curl -sf http://localhost:8010/api/health; then\n              echo \"Container health check passed\"\n              docker stop {{APP_NAME}}-readiness-smoke\n              exit 0\n            fi\n            echo \"Attempt $i \u2014 waiting 10s\"\n            sleep 10\n          done\n          docker stop {{APP_NAME}}-readiness-smoke 2>/dev/null || true\n          echo \"Container failed to pass health check in 120s\" >&2\n          exit 1\n\n      - name: Check deployed staging health\n        if: ${{ inputs.run_remote_health }}\n        env:\n          APP_URL: ${{ vars.APP_URL }}\n        run: |\n          if [ -z \"$APP_URL\" ]; then\n            echo \"APP_URL environment variable is required.\" >&2\n            exit 1\n          fi\n\n          curl --fail --show-error --silent \"$APP_URL/api/health\" | tee health.json\n          curl --fail --show-error --silent \"$APP_URL/api/health/readiness\" | tee readiness.json\n          echo \"Remote health checks passed.\"\n\n      - name: [REDACTED] OIDC smoke token\n        if: ${{ inputs.run_entitlement_gate }}\n        env:\n          OIDC_SMOKE_TOKEN_URL: [REDACTED] vars.OIDC_SMOKE_TOKEN_URL || secrets.OIDC_SMOKE_TOKEN_URL }}\n          OIDC_SMOKE_TOKEN_SCOPE: [REDACTED] vars.OIDC_SMOKE_TOKEN_SCOPE || secrets.OIDC_SMOKE_TOKEN_SCOPE }}\n          OIDC_SMOKE_CLIENT_ID: [REDACTED] vars.OIDC_SMOKE_CLIENT_ID || secrets.OIDC_SMOKE_CLIENT_ID }}\n          OIDC_SMOKE_CLIENT_SECRET: [REDACTED] secrets.OIDC_SMOKE_CLIENT_SECRET }}\n        run: |\n          set -euo pipefail\n          if [ -z \"${OIDC_SMOKE_TOKEN_URL:[REDACTED]\" ] || \\\n             [ -z \"${OIDC_SMOKE_TOKEN_SCOPE:[REDACTED]\" ] || \\\n             [ -z \"${OIDC_SMOKE_CLIENT_ID:-}\" ] || \\\n             [ -z \"${OIDC_SMOKE_CLIENT_SECRET:[REDACTED]\" ]; then\n            echo \"OIDC smoke client credentials not configured; using ENTITLEMENT_SMOKE_TOKEN if supplied.\"\n            exit 0\n          fi\n\n          RESPONSE=[REDACTED] -sf -X POST \"$OIDC_SMOKE_TOKEN_URL\" \\\n            -H \"Content-Type: application/x-www-form-urlencoded\" \\\n            --data-urlencode \"grant_type=[REDACTED]\" \\\n            --data-urlencode \"client_id=${OIDC_SMOKE_CLIENT_ID}\" \\\n            --data-urlencode \"client_secret=[REDACTED]\" \\\n            --data-urlencode \"scope=[REDACTED]\")\n          TOKEN=[REDACTED] -c \"import json,sys; print(json.load(sys.stdin).get('access_token',''))\" <<< \"$RESPONSE\")\n          if [ -z \"$TOKEN\" ]; then\n            echo \"OIDC smoke token response did not include access_token.\" >&2\n            exit 1\n          fi\n          echo \":[REDACTED]\"\n          echo \"OIDC_MINTED_ENTITLEMENT_SMOKE_TOKEN=[REDACTED]\" >> \"$GITHUB_ENV\"\n\n      - name: Smoke subscription entitlement gates\n        if: ${{ inputs.run_entitlement_gate }}\n        env:\n          APP_URL: ${{ vars.APP_URL }}\n          MONGO_URI: [REDACTED] secrets.MONGO_URI }}\n          # Optional: [REDACTED] smoke tokens if your entitlement module requires a test user.\n          ENTITLEMENT_SMOKE_TOKEN: [REDACTED] secrets.ENTITLEMENT_SMOKE_TOKEN }}\n          ENTITLEMENT_SMOKE_USER_ID: ${{ vars.ENTITLEMENT_SMOKE_USER_ID }}\n        run: |\n          if [ -n \"${OIDC_MINTED_ENTITLEMENT_SMOKE_TOKEN:[REDACTED]\" ]; then\n            export ENTITLEMENT_SMOKE_TOKEN=\"[REDACTED]\"\n          fi\n          # This hook is intentionally app-owned. Hosted products may replace it\n          # with product-specific gates after consuming deployment.manifest.json.\n          # Adjust this script path if you have a custom entitlement smoke script.\n          if [ -f scripts/smoke_entitlement_api.py ]; then\n            python scripts/smoke_entitlement_api.py --json | tee entitlement-smoke.json\n          else\n            echo \"No entitlement smoke script found \u2014 checking health/readiness only.\"\n            curl --fail --show-error --silent \"$APP_URL/api/health/readiness\" | tee entitlement-smoke.json\n          fi\n\n      - name: Upload readiness artifacts\n        if: always()\n        uses: actions/upload-artifact@v4\n        with:\n          name: \"staging-readiness-{{APP_NAME}}-${{ github.run_id }}\"\n          path: |\n            health.json\n            readiness.json"},{"checksum":"sha256:7e0138ead02f97a8c0cb3ca61c6ea94f21d140d28fd9db66a8e2398c0083ff6b","chunk_id":"chunk_2ff86f8fabe79eda","end_line":223,"path":"build_context/infra/templates/workflows/readiness.yml","start_line":222,"symbol_ids":[],"text":"            entitlement-smoke.json\n          if-no-files-found: ignore"},{"checksum":"sha256:15ef1a936e6bf7f21c6acc7caa4c813db715a78fef4ddb8281756144bb3c4519","chunk_id":"chunk_727eec37ce288a1d","end_line":270,"path":"build_context/integrations/catalog.yaml","start_line":1,"symbol_ids":[],"text":"schema_version: mozaiks.integrations.v1\nintegrations:\n  - id: openai\n    name: OpenAI\n    category: llms\n    description: GPT models, embeddings, and assistants API.\n    required_secrets:\n      - OPENAI_API_KEY\n    optional_secrets:\n      - OPENAI_ORG_ID\n    setup_steps:\n      - Sign in to platform.openai.com \u2192 API Keys\n      - Create a new secret key and copy it immediately (shown once)\n    preferred_setup_lane: bring_your_own_key\n    allowed_setup_lanes:\n      - bring_your_own_key\n\n  - id: anthropic\n    name: Anthropic\n    category: llms\n    description: Claude models for reasoning, analysis, and generation.\n    required_secrets:\n      - ANTHROPIC_API_KEY\n    optional_secrets: [REDACTED]\n    setup_steps:\n      - Sign in to console.anthropic.com \u2192 API Keys\n      - Create a new key and copy it immediately (shown once)\n    preferred_setup_lane: bring_your_own_key\n    allowed_setup_lanes:\n      - bring_your_own_key\n\n  - id: gemini\n    name: Gemini\n    category: llms\n    description: Google Gemini models for multimodal reasoning, code, and generation via Google AI Studio or Vertex AI.\n    required_secrets:\n      - GEMINI_API_KEY\n    optional_secrets:\n      - GOOGLE_API_KEY\n    setup_steps:\n      - Sign in to aistudio.google.com \u2192 Get API key\n      - Create or select a project and copy the API key\n    preferred_setup_lane: bring_your_own_key\n    allowed_setup_lanes:\n      - bring_your_own_key\n\n  - id: mozaikspay\n    name: Mozaiks Pay\n    category: payments\n    description: [REDACTED] subscription billing, token billing, billing portal, and usage display for Mozaiks apps.\n    required_secrets:\n      - MOZAIKSPAY_API_BASE\n      - MOZAIKSPAY_API_KEY\n    optional_secrets:\n      - MOZAIKS_APP_URL\n      - MOZAIKSPAY_CLIENT_ID\n      - MOZAIKSPAY_CLIENT_SECRET\n    default_for:\n      - subscription_or_usage_app\n    removable_default: true\n    capabilities:\n      - subscriptions\n      - usage_billing\n      - billing_portal\n    preferred_setup_lane: managed\n    allowed_setup_lanes:\n      - managed\n      - bring_your_own_key\n    managed_default:\n      provider: mozaikspay\n      mode: hosted\n    setup_steps:\n      - Open the workspace Integrations page and select Mozaiks Pay\n      - Enter the Mozaiks Pay API base URL and app-scoped API key\n      - Save the connector before launching paid plans or billing portal pages\n\n  - id: resend\n    name: Resend\n    category: email\n    description: Transactional email delivery with high deliverability.\n    required_secrets:\n      - RESEND_API_KEY\n    optional_secrets:\n      - RESEND_FROM_EMAIL\n    setup_steps:\n      - Sign in to resend.com \u2192 API Keys\n      - Create an API key with Send access\n      - Verify your sending domain under Domains\n    preferred_setup_lane: bring_your_own_key\n    allowed_setup_lanes:\n      - bring_your_own_key\n\n  - id: sendgrid\n    name: SendGrid\n    category: email\n    description: Transactional email delivery through Twilio SendGrid.\n    required_secrets:\n      - SENDGRID_API_KEY\n    optional_secrets:\n      - SENDGRID_FROM_EMAIL\n    setup_steps:\n      - Sign in to SendGrid \u2192 Settings \u2192 API Keys\n      - Create an API key with Mail Send access\n      - Verify your sender identity or sending domain before production delivery\n    preferred_setup_lane: bring_your_own_key\n    allowed_setup_lanes:\n      - bring_your_own_key\n\n  - id: twilio\n    name: Twilio\n    category: sms\n    description: SMS, voice, and WhatsApp messaging.\n    required_secrets:\n      - TWILIO_ACCOUNT_SID\n      - TWILIO_AUTH_TOKEN\n      - TWILIO_PHONE_NUMBER\n    optional_secrets: [REDACTED]\n    setup_steps:\n      - Sign in to Twilio Console \u2192 Account \u2192 API keys & tokens\n      - Copy the Account SID and Auth Token\n      - Purchase or verify a phone number to use as the sender\n    preferred_setup_lane: bring_your_own_key\n    allowed_setup_lanes:\n      - bring_your_own_key\n\n  - id: slack\n    name: Slack\n    category: notifications\n    description: Team notifications, alerts, and workflow triggers via Slack.\n    required_secrets:\n      - SLACK_BOT_TOKEN\n    optional_secrets:\n      - SLACK_WEBHOOK_URL\n      - SLACK_DEFAULT_CHANNEL\n    setup_steps:\n      - Go to api.slack.com/apps \u2192 Create New App\n      - Add OAuth scopes: chat:write, channels:read\n      - Install the app to your workspace and copy the Bot User OAuth Token\n    preferred_setup_lane: connect_account\n    allowed_setup_lanes:\n      - connect_account\n      - bring_your_own_key\n\n  - id: github\n    name: GitHub\n    category: source_control\n    description: Repository access, webhooks, and CI/CD triggers.\n    required_secrets:\n      - GITHUB_TOKEN\n    optional_secrets:\n      - GITHUB_ORG\n      - GITHUB_WEBHOOK_SECRET\n    setup_steps:\n      - Go to GitHub \u2192 Settings \u2192 Developer settings \u2192 Personal access tokens\n      - Generate a token with repo and workflow scopes\n      - For org-level access, use a GitHub App or fine-grained token scoped to the org\n    preferred_setup_lane: connect_account\n    allowed_setup_lanes:\n      - connect_account\n      - bring_your_own_key\n\n  - id: s3\n    name: AWS S3\n    category: storage\n    description: Object storage for files, images, and generated artifacts.\n    required_secrets:\n      - AWS_ACCESS_KEY_ID\n      - AWS_SECRET_ACCESS_KEY\n      - AWS_S3_BUCKET\n    optional_secrets:\n      - AWS_REGION\n      - AWS_S3_ENDPOINT_URL\n    setup_steps:\n      - In AWS IAM, create a user with a scoped S3 policy\n      - Generate Access Key ID and Secret Access Key under Security Credentials\n      - Create or identify the S3 bucket this app will use\n    preferred_setup_lane: bring_your_own_key\n    allowed_setup_lanes:\n      - bring_your_own_key\n\n  - id: cloudinary\n    name: Cloudinary\n    category: storage\n    description: Image and media storage, transformation, and delivery.\n    required_secrets:\n      - CLOUDINARY_URL\n    optional_secrets: [REDACTED]\n    setup_steps:\n      - Sign in to Cloudinary \u2192 Dashboard\n      - Copy the CLOUDINARY_URL credential for the target cloud\n      - Use a scoped product environment for production apps\n    preferred_setup_lane: bring_your_own_key\n    allowed_setup_lanes:\n      - bring_your_own_key\n\n  - id: mongodb\n    name: MongoDB\n    category: database\n    description: MongoDB database used by Mozaiks runtime persistence and generated app data.\n    required_secrets:\n      - MONGO_URI\n    optional_secrets:\n      - MONGO_DB_NAME\n    setup_steps:\n      - Provision MongoDB locally, in Atlas, or through a managed provider\n      - Create an app-scoped database user with the minimum required database permissions\n      - Copy the connection string as MONGO_URI and verify it with the readiness check before deploy\n    preferred_setup_lane: bring_your_own_key\n    allowed_setup_lanes:\n      - bring_your_own_key\n\n  - id: postgres\n    name: PostgreSQL\n    category: database\n    description: Relational database for structured app data.\n    required_secrets:\n      - POSTGRES_URL\n    optional_secrets:\n      - POSTGRES_POOL_SIZE\n    setup_steps:\n      - Provision a PostgreSQL instance (Supabase, Neon, RDS, or self-hosted)\n      - Copy the connection string in the format postgresql://user:pass@host:port/dbname\n    preferred_setup_lane: bring_your_own_key\n    allowed_setup_lanes:\n      - bring_your_own_key\n\n  - id: redis\n    name: Redis\n    category: cache\n    description: Optional in-memory cache, session store, and pub/sub broker. Do not add for default development or single-instance deployments.\n    required_secrets:\n      - REDIS_URL\n    optional_secrets: [REDACTED]\n    setup_steps:\n      - Leave Redis unconfigured unless the app explicitly requires shared cache, shared sessions, pub/sub, queues, or multi-instance rate limiting\n      - For development, prefer no Redis or a local/self-hosted Redis container; do not provision a paid managed Redis service by default\n      - For production scale, provide an operator-owned Redis instance (Upstash, Redis Cloud, Azure Cache, or self-hosted)\n      - Copy the connection URL in the format redis://user:pass@host:port\n    preferred_setup_lane: bring_your_own_key\n    allowed_setup_lanes:\n      - bring_your_own_key\n\n  - id: google_oauth\n    name: Google OAuth\n    category: auth\n    description: Sign in with Google for user authentication.\n    required_secrets:\n      - GOOGLE_CLIENT_ID\n      - GOOGLE_CLIENT_SECRET\n    optional_secrets:\n      - GOOGLE_REDIRECT_URI\n    setup_steps:\n      - Go to Google Cloud Console \u2192 APIs & Services \u2192 Credentials\n      - Create an OAuth 2.0 Client ID (Web application type)\n      - Add your app's redirect URI to the Authorized redirect URIs list\n    preferred_setup_lane: connect_account\n    allowed_setup_lanes:\n      - connect_account\n      - bring_your_own_key\n\n  - id: microsoft_oauth\n    name: Microsoft OAuth\n    category: auth\n    description: Sign in with Microsoft or Entra ID through OIDC/OAuth.\n    required_secrets:\n      - MICROSOFT_CLIENT_ID\n      - MICROSOFT_CLIENT_SECRET\n    optional_secrets:\n      - MICROSOFT_TENANT_ID\n      - MICROSOFT_REDIRECT_URI"},{"checksum":"sha256:ee55013977c419591dbf8c40b09183ae1cad7080e7daf9405a608d87cd1f3b88","chunk_id":"chunk_a8484729b964b5d3","end_line":292,"path":"build_context/integrations/catalog.yaml","start_line":271,"symbol_ids":[],"text":"    setup_steps:\n      - Create an app registration in Microsoft Entra admin center\n      - Add the app redirect URI under Authentication\n      - Create a client secret and store only the secret handle in the workspace connector\n    preferred_setup_lane: connect_account\n    allowed_setup_lanes:\n      - connect_account\n      - bring_your_own_key\n\n  - id: segment\n    name: Segment\n    category: analytics\n    description: Customer data platform for event tracking and analytics routing.\n    required_secrets:\n      - SEGMENT_WRITE_KEY\n    optional_secrets: [REDACTED]\n    setup_steps:\n      - Sign in to Segment \u2192 Sources \u2192 Add Source \u2192 Node.js\n      - Copy the Write Key from the source settings\n    preferred_setup_lane: bring_your_own_key\n    allowed_setup_lanes:\n      - bring_your_own_key"},{"checksum":"sha256:b06f6cee253697a404b8383dd04b8a015c13698806a931938768cd26b30b1638","chunk_id":"chunk_21c4e5ef6629c506","end_line":14,"path":"build_context/integrations/context.yaml","start_line":1,"symbol_ids":[],"text":"context_id: integrations\napplies_to_workflows:\n  - AppGenerator\nassets:\n  - path: catalog.yaml\n    kind: catalog\n    projections:\n      - id: integrations_catalog_for_planning\n        records: integrations\n        recipients:\n          - AppPlanAgent\n        render: summary\n        marker: INTEGRATIONS_CATALOG_CONTEXT\n        heading: Available Workspace Integrations"},{"checksum":"sha256:b19c82aba49736f84ca3a7aba3e3693eccbf0d0e061a51207ad3973e549b2413","chunk_id":"chunk_72510194863a593d","end_line":22,"path":"build_context/messaging/context.yaml","start_line":1,"symbol_ids":[],"text":"context_id: messaging\napplies_to_workflows:\n  - AppGenerator\nassets:\n  - path: contract.yaml\n    kind: contract\n  - path: templates/\n    kind: templates\npack:\n  id: messaging\n  version: \"0.1.12\"\n  status: active\n  capability_source: generated_module\ncapabilities:\n  - capability_id: messaging.threads.list\n    facade_recommended: messages\n  - capability_id: messaging.messages.send\n    facade_recommended: messages\nprojections:\n  context_variables:\n    capability_packs:\n      from: capability_packs"},{"checksum":"sha256:f67ae026beb7d809dbae07759e5908189f23679b589b4bec1d74edb8180e612c","chunk_id":"chunk_3eb5de9f0876af7c","end_line":124,"path":"build_context/messaging/contract.yaml","start_line":1,"symbol_ids":[],"text":"contract_id: messaging\ncontract_type: build_pack_instructions\n\nselection_rules:\n  - id: select_for_messaging_apps\n    when:\n      intent_any:\n        - direct messages\n        - dm\n        - messaging\n        - chat\n        - conversations\n        - inbox\n        - threads\n        - support chat\n        - support messages\n        - conversation threads\n    action: select_pack\n  - id: confirm_for_light_social\n    when:\n      intent_any:\n        - notifications\n        - comments\n        - activity feed\n    action: require_explicit_user_confirmation\n\nrecommended_domains:\n  - messaging\n  - chat\n  - social\n  - community\n  - marketplace\n\nrequired_outputs:\n  - path: data/migrations/001_messaging_collections.json\n    owner: templates\n  - path: modules/messages/module.yaml\n    owner: templates\n  - path: modules/messages/backend/__init__.py\n    owner: templates\n  - path: modules/messages/backend/base_handler.py\n    owner: templates\n  - path: modules/messages/backend/handler.py\n    owner: workspace  # preserved across regeneration; subclasses base_handler.py\n  - path: modules/messages/backend/service.py\n    owner: templates\n  - path: modules/messages/backend/repo.py\n    owner: templates\n  - path: modules/messages/backend/policy.py\n    owner: templates\n  - path: modules/messages/backend/schemas.py\n    owner: templates\n  - path: modules/messages/backend/account_data_handler.py\n    owner: templates\n  - path: modules/messages/contracts/events.yaml\n    owner: templates\n  - path: modules/messages/contracts/notifications.yaml\n    owner: templates\n  - path: modules/messages/contracts/reactions.yaml\n    owner: templates\n  - path: modules/messages/contracts/profile.yaml\n    owner: templates\n  - path: ui/index.js\n    owner: templates\n  - path: ui/components/MessagingProfileTab.jsx\n    owner: templates\n  - path: ui/pages/custom/Messages.jsx\n    owner: templates\n  - path: ui/route_manifest.json\n    owner: templates\n\nforbidden_outputs:\n  - path_prefix: modules/messaging/\n  - path_prefix: modules/chat/\n  - path_prefix: modules/contacts/\n  - path_prefix: services/messaging/\n  - path_prefix: services/chat/\n\nruntime_boundaries:\n  - id: persistence_layer\n    rule: Generated repo.py must use ctx.persistence.collection(\"messages\", entity_name). No direct Motor clients and no app_data_from_context aliases.\n  - id: event_emission\n    rule: Events must be emitted via ctx.emit(), not direct dispatcher calls from service/handler.\n  - id: support_ticket_authority\n    rule: >\n      Generated public messages actions only create, list, read, and send direct\n      or group conversations. The support module alone creates support threads\n      and mediates support conversation reads and replies after ticket authority\n      checks, while the messages service owns persistence and lifecycle events.\n  - id: notification_delivery\n    rule: Message recipient notifications are declared in messages/contracts/notifications.yaml from domain.messages.message_sent. Do not create a notification repo or delivery worker inside the app module.\n  - id: no_announcement_leakage\n    rule: The create_announcement action is hosted-platform only. Do not add it to generated app templates.\n  - id: contacts_belong_to_social\n    rule: Friends, follows, contacts, invitations, and social graph state belong to the social pack or an app-specific module, not the messaging substrate.\n  - id: no_messaging_contacts_facade\n    rule: Do not emit messaging.contacts.* capabilities or a contacts module as a DM roster. Select the social pack for friend/relationship rosters, or use an app-specific relationship provider with non-messaging capability ids when the product truly needs a private address book.\n  - id: hosted_extension_boundary\n    rule: Hosted products may add announcements, operator routing, realtime fan-out, or product-specific moderation, but they must keep core thread/message persistence on the messages module and preserve domain.messages.* lifecycle events for create_thread, send_message, and mark_thread_read.\n  - id: profile_tab_composition\n    rule: >\n      The default DM inbox entrypoint is a profile tab declared in\n      modules/messages/contracts/profile.yaml and registered through ui/index.js.\n      Keep /messages as a focused conversation route, but do not add it to global\n      shell navigation or profile shortcut pills by default.\n\nfacades: []\n\ncross_pack_integrations:\n  - pack_id: support\n    description: >\n      Support modules call the messages service for persisted conversations.\n      Support stores ticket metadata and references messages.thread_id through\n      message_thread_id; public support reads and replies use support actions.\n  - pack_id: social\n    description: >\n      Social apps may use messages for DMs after the social pack creates\n      friends, follows, or invitations. Social graph ownership remains in the\n      social pack.\n  - pack_id: governance\n    description: >\n      Governance apps may use messages for deliberation threads, but proposals,\n      votes, quorum, moderation, and role policy are app-specific or a separate\n      governance pack."},{"checksum":"sha256:1b0a5dcd0ee8f1b283e183dd641cc5d46d8b90a8ddad53697e7cf4ecd6b9441e","chunk_id":"chunk_9cfee442a900ca3c","end_line":88,"path":"build_context/messaging/templates/data/migrations/001_messaging_collections.json","start_line":1,"symbol_ids":[],"text":"{\n  \"migration_id\": \"messaging_001_collections\",\n  \"description\": \"Declare messaging module collections and indexes in the app data contract.\",\n  \"surfaces\": [\n    {\n      \"surface_id\": \"messaging\",\n      \"collections\": [\n        {\n          \"mongo_collection\": \"messages_threads\",\n          \"data_alias\": \"messages.threads\",\n          \"indexes\": [\n            {\n              \"name\": \"threads_by_id\",\n              \"keys\": [{\"field\": \"thread_id\", \"order\": 1}],\n              \"unique\": true\n            },\n            {\n              \"name\": \"threads_by_participant_updated\",\n              \"keys\": [{\"field\": \"participant_ids\", \"order\": 1}, {\"field\": \"updated_at\", \"order\": -1}]\n            },\n            {\n              \"name\": \"threads_by_subject_app_updated\",\n              \"keys\": [{\"field\": \"subject_app_id\", \"order\": 1}, {\"field\": \"updated_at\", \"order\": -1}]\n            },\n            {\n              \"name\": \"threads_by_scope_updated\",\n              \"keys\": [{\"field\": \"scope_type\", \"order\": 1}, {\"field\": \"scope_id\", \"order\": 1}, {\"field\": \"updated_at\", \"order\": -1}]\n            },\n            {\n              \"name\": \"threads_by_participant_type_status\",\n              \"keys\": [\n                {\"field\": \"participant_ids\", \"order\": 1},\n                {\"field\": \"thread_type\", \"order\": 1},\n                {\"field\": \"status\", \"order\": 1}\n              ]\n            },\n            {\n              \"name\": \"threads_by_participant_last_message\",\n              \"keys\": [{\"field\": \"participant_ids\", \"order\": 1}, {\"field\": \"last_message_at\", \"order\": -1}]\n            }\n          ]\n        },\n        {\n          \"mongo_collection\": \"messages_messages\",\n          \"data_alias\": \"messages.messages\",\n          \"indexes\": [\n            {\n              \"name\": \"messages_by_thread_created_asc\",\n              \"keys\": [{\"field\": \"thread_id\", \"order\": 1}, {\"field\": \"created_at\", \"order\": 1}]\n            },\n            {\n              \"name\": \"messages_by_thread_created_desc\",\n              \"keys\": [{\"field\": \"thread_id\", \"order\": 1}, {\"field\": \"created_at\", \"order\": -1}]\n            },\n            {\n              \"name\": \"messages_unread_scan\",\n              \"keys\": [\n                {\"field\": \"thread_id\", \"order\": 1},\n                {\"field\": \"sender_id\", \"order\": 1},\n                {\"field\": \"created_at\", \"order\": 1}\n              ]\n            }\n          ]\n        },\n        {\n          \"mongo_collection\": \"messages_thread_reads\",\n          \"data_alias\": \"messages.thread_reads\",\n          \"indexes\": [\n            {\n              \"name\": \"reads_by_thread_user\",\n              \"keys\": [\n                {\"field\": \"scope_type\", \"order\": 1},\n                {\"field\": \"scope_id\", \"order\": 1},\n                {\"field\": \"thread_id\", \"order\": 1},\n                {\"field\": \"user_id\", \"order\": 1}\n              ],\n              \"unique\": true\n            },\n            {\n              \"name\": \"reads_by_user\",\n              \"keys\": [{\"field\": \"user_id\", \"order\": 1}]\n            }\n          ]\n        }\n      ]\n    }\n  ]\n}"},{"checksum":"sha256:b47220a9492193c188b766c4c5c8a824358776462a59db160bf2c5594c00862d","chunk_id":"chunk_a303c09b6ae2f8e1","end_line":81,"path":"build_context/messaging/templates/modules/messages/backend/account_data_handler.py","start_line":1,"symbol_ids":["sym_5663249de9d35667","sym_9beeb7fc504ebec9","sym_820bf61b8025aa06","sym_c16c20d6143bdb28"],"text":"\"\"\"AccountDataHandler for the messages module.\n\nGDPR deletion and export for message threads, messages, and read state.\n\nDeletion policy:\n  - Threads where creator_id == deleted user: hard-deleted (the user created them).\n  - Thread participant records where user_id == deleted user: hard-deleted.\n  - Messages where sender_id == deleted user: hard-deleted.\n    The thread and other messages remain intact so that peer conversation history\n    is not silently destroyed; the deleted user's contributions are removed.\n  - Thread read state records where user_id == deleted user: hard-deleted.\n\nNote: deleting a thread creator's messages may leave a thread with no messages.\nThe UI should handle empty-thread states gracefully. Do not cascade-delete\nthreads that have messages from other participants \u2014 those are not owned by\nthe deleted user.\n\"\"\"\nfrom __future__ import annotations\n\nfrom typing import Any\n\n_THREADS = \"messages.threads\"\n_MESSAGES = \"messages.messages\"\n_THREAD_READS = \"messages.thread_reads\"\n\n\nclass AccountDataHandler:\n    \"\"\"GDPR delete + export handler for the messages module.\"\"\"\n\n    def __init__(self, db: Any) -> None:\n        self._db = db\n\n    async def delete_user_data(self, *, app_id: str, user_id: str) -> dict[str, Any]:\n        scope = {\"app_id\": app_id}\n\n        # Remove threads the user created that have no other messages.\n        user_threads = await self._db[_THREADS].find(\n            {**scope, \"creator_id\": user_id}, {\"_id\": 0, \"thread_id\": 1}\n        ).to_list(length=None)\n        user_thread_ids = [t[\"thread_id\"] for t in user_threads]\n\n        threads_deleted = 0\n        for thread_id in user_thread_ids:\n            peer_messages = await self._db[_MESSAGES].count_documents(\n                {**scope, \"thread_id\": thread_id, \"sender_id\": {\"$ne\": user_id}}\n            )\n            if peer_messages == 0:\n                await self._db[_THREADS].delete_one({**scope, \"thread_id\": thread_id})\n                threads_deleted += 1\n\n        # Remove the user's own messages from all threads.\n        msgs_result = await self._db[_MESSAGES].delete_many(\n            {**scope, \"sender_id\": user_id}\n        )\n\n        # Remove the user's thread read state.\n        reads_result = await self._db[_THREAD_READS].delete_many(\n            {**scope, \"user_id\": user_id}\n        )\n\n        return {\n            \"threads_deleted\": threads_deleted,\n            \"messages_deleted\": msgs_result.deleted_count,\n            \"read_state_deleted\": reads_result.deleted_count,\n        }\n\n    async def export_user_data(self, *, app_id: str, user_id: str) -> dict[str, Any]:\n        scope = {\"app_id\": app_id}\n\n        threads = await self._db[_THREADS].find(\n            {**scope, \"creator_id\": user_id}, {\"_id\": 0}\n        ).to_list(length=None)\n\n        messages = await self._db[_MESSAGES].find(\n            {**scope, \"sender_id\": user_id}, {\"_id\": 0}\n        ).to_list(length=None)\n\n        return {\n            \"threads_created\": threads,\n            \"messages_sent\": messages,\n        }"},{"checksum":"sha256:a17eb27840c61f3b52caed47a9dc7f107771a12cfff600d14260624f59e301d3","chunk_id":"chunk_59bb357b16b3416f","end_line":101,"path":"build_context/messaging/templates/modules/messages/backend/base_handler.py","start_line":1,"symbol_ids":["sym_82ac6e0d2eb1d328","sym_bffacb8eac65a00c","sym_6bab37ac61eb3548","sym_33b9fd220948c6b6","sym_2394f260a609329f","sym_173c934a3e6f71da","sym_b92308b8559e9563"],"text":"\"\"\"\nOSS-generated base handler for the messages module.\nDO NOT EDIT \u2014 regenerated on framework upgrades.\nPut app-specific customizations in handler.py (the workspace subclass).\n\"\"\"\nfrom __future__ import annotations\n\nfrom typing import Any\n\nfrom mozaiksai.core.runtime.composition.module_context import ModuleContext\n\nfrom .service import MessageService\n\n\nclass MessagesBaseHandler:\n    def __init__(self, service: MessageService | None = None) -> None:\n        self._service = service or MessageService()\n\n    async def create_thread(\n        self,\n        ctx: ModuleContext,\n        *,\n        title: str | None = None,\n        participant_ids: list[str] | None = None,\n        thread_type: str = \"group\",\n        scope_type: str = \"app\",\n        scope_id: str | None = None,\n        subject_app_id: str | None = None,\n        related_type: str | None = None,\n        related_id: str | None = None,\n        metadata: list[dict[str, Any]] | None = None,\n        **_: object,\n    ) -> dict[str, Any]:\n        return await self._service.create_thread(\n            ctx,\n            title=title,\n            participant_ids=participant_ids,\n            thread_type=thread_type,\n            scope_type=scope_type,\n            scope_id=scope_id,\n            subject_app_id=subject_app_id,\n            related_type=related_type,\n            related_id=related_id,\n            metadata=metadata,\n        )\n\n    async def list_threads(\n        self,\n        ctx: ModuleContext,\n        *,\n        status: str | None = None,\n        thread_type: str | None = None,\n        scope_type: str | None = None,\n        scope_id: str | None = None,\n        subject_app_id: str | None = None,\n        related_type: str | None = None,\n        related_id: str | None = None,\n        limit: int = 50,\n        **_: object,\n    ) -> dict[str, Any]:\n        return await self._service.list_threads(\n            ctx,\n            status=status,\n            thread_type=thread_type,\n            scope_type=scope_type,\n            scope_id=scope_id,\n            subject_app_id=subject_app_id,\n            related_type=related_type,\n            related_id=related_id,\n            limit=limit,\n        )\n\n    async def get_thread(\n        self,\n        ctx: ModuleContext,\n        *,\n        thread_id: str,\n        message_limit: int = 50,\n        **_: object,\n    ) -> dict[str, Any]:\n        return await self._service.get_thread(ctx, thread_id=thread_id, message_limit=message_limit)\n\n    async def send_message(\n        self,\n        ctx: ModuleContext,\n        *,\n        thread_id: str,\n        body: str,\n        message_type: str = \"text\",\n        **_: object,\n    ) -> dict[str, Any]:\n        return await self._service.send_message(ctx, thread_id=thread_id, body=body, message_type=message_type)\n\n    async def mark_thread_read(\n        self,\n        ctx: ModuleContext,\n        *,\n        thread_id: str,\n        **_: object,\n    ) -> dict[str, Any]:\n        return await self._service.mark_thread_read(ctx, thread_id=thread_id)"},{"checksum":"sha256:117e48d97c1eb8f6933ebd98f873dde8d46e441a82755b8f68b99c1b2a35aa05","chunk_id":"chunk_9b6f7f650e78baf3","end_line":12,"path":"build_context/messaging/templates/modules/messages/backend/handler.py","start_line":1,"symbol_ids":["sym_786bb13f3e6896b0"],"text":"\"\"\"\nWorkspace handler for the messages module.\nSubclasses MessagesBaseHandler \u2014 add overrides and extra methods here.\nThis file is preserved across regeneration.\n\"\"\"\nfrom __future__ import annotations\n\nfrom .base_handler import MessagesBaseHandler\n\n\nclass MessagesHandler(MessagesBaseHandler):\n    \"\"\"App-local handler \u2014 extend or override base methods below.\"\"\""},{"checksum":"sha256:1ad17bf642fca41131638fcb7942254b60f79bbb4e03f378ad15d9fed1270dd7","chunk_id":"chunk_3992898ede71c02c","end_line":56,"path":"build_context/messaging/templates/modules/messages/backend/policy.py","start_line":1,"symbol_ids":["sym_97a0b8355a726204","sym_fcf3cadaaec45fe3","sym_d6d2d4e1d5c10b93","sym_efd27a9c027fcb85","sym_0430b04dd3e57122","sym_4a41a4b3506171ec","sym_3a59ccec559517c5","sym_01ba08d76bd363f8"],"text":"from __future__ import annotations\n\nfrom typing import Any\n\n_SCOPE_TYPES = {\"app\", \"workspace\"}\n\n\ndef actor_id(ctx) -> str:\n    return str(getattr(ctx, \"user_id\", None) or \"anonymous\").strip() or \"anonymous\"\n\n\ndef is_participant(thread: dict[str, Any], user_id: str) -> bool:\n    return user_id in (thread.get(\"participant_ids\") or [])\n\n\ndef _clean(value: Any) -> str:\n    return str(value or \"\").strip()\n\n\ndef _scope_authority(ctx, scope_type: str) -> str:\n    if scope_type == \"workspace\":\n        return _clean(getattr(ctx, \"workspace_id\", None))\n    return _clean(getattr(ctx, \"app_id\", None))\n\n\ndef resolve_scope(ctx, *, scope_type: str | None = None, scope_id: str | None = None) -> tuple[str, str | None]:\n    resolved_type = _clean(scope_type) or \"app\"\n    if resolved_type not in _SCOPE_TYPES:\n        resolved_type = \"app\"\n\n    authorized_id = _scope_authority(ctx, resolved_type)\n    requested_id = _clean(scope_id)\n    if requested_id and authorized_id and requested_id != authorized_id:\n        raise PermissionError(f\"{resolved_type} message scope must match the current context\")\n    return resolved_type, authorized_id or requested_id or None\n\n\ndef current_scope_query(ctx, *, scope_type: str | None = None, scope_id: str | None = None) -> dict[str, Any]:\n    resolved_type, resolved_id = resolve_scope(ctx, scope_type=scope_type, scope_id=scope_id)\n    query: dict[str, Any] = {\"scope_type\": resolved_type}\n    if resolved_id is not None:\n        query[\"scope_id\"] = resolved_id\n    return query\n\n\ndef thread_identity_queries(ctx, *, thread_id: str) -> list[dict[str, Any]]:\n    queries = [{\"thread_id\": thread_id, **current_scope_query(ctx, scope_type=\"app\")}]\n    if _scope_authority(ctx, \"workspace\"):\n        queries.append({\"thread_id\": thread_id, **current_scope_query(ctx, scope_type=\"workspace\")})\n    return queries\n\n\ndef participant_thread_query(ctx, **extra: Any) -> dict[str, Any]:\n    query: dict[str, Any] = {\"participant_ids\": actor_id(ctx), **current_scope_query(ctx)}\n    query.update({key: value for key, value in extra.items() if value is not None})\n    return query"},{"checksum":"sha256:b3b3cbbb8fe58ce247fd654021df6ca2eb0ff40eeac7d66ce8b5f0065170f452","chunk_id":"chunk_9db4ac3047654616","end_line":104,"path":"build_context/messaging/templates/modules/messages/backend/repo.py","start_line":1,"symbol_ids":["sym_22c656596e92aa0c","sym_cdd96cd605023237","sym_18bea9aaa5dcaca3","sym_69e472f30377cf25","sym_2a39c0fe02361cf4","sym_ff7f09302a6e1914","sym_042cb435ced97882","sym_9e9789263ffbe3a6","sym_77a49325f59977d0","sym_638ad8922e27d8df","sym_6a7ac8aeaaa8e8e2","sym_b7553a24d0cf7bf1","sym_f5e3094e15006760","sym_f09a44f71d51ca3f"],"text":"from __future__ import annotations\n\nfrom collections.abc import Mapping, Sequence\nfrom typing import Any\n\nDocument = dict[str, Any]\n\n\ndef _collection(ctx, entity_name: str):\n    persistence = getattr(ctx, \"persistence\", None)\n    if persistence is None:\n        raise RuntimeError(\"Persistence is not available for this app context.\")\n    return persistence.collection(\"messages\", entity_name)\n\n\ndef _document(value: Any) -> Document | None:\n    return dict(value) if isinstance(value, Mapping) else None\n\n\ndef _documents(values: list[Any] | None) -> list[Document]:\n    return [dict(item) for item in values or [] if isinstance(item, Mapping)]\n\n\nclass ThreadRepo:\n    async def insert(self, ctx, *, record: Mapping[str, Any]) -> None:\n        await _collection(ctx, \"threads\").insert_one(dict(record))\n\n    async def get(self, ctx, *, query: Mapping[str, Any]) -> Document | None:\n        return _document(await _collection(ctx, \"threads\").find_one(dict(query)))\n\n    async def list(self, ctx, *, query: dict[str, Any], limit: int) -> list[Document]:\n        return _documents(\n            await _collection(ctx, \"threads\").find_many(\n                query,\n                limit=limit,\n                sort=[(\"updated_at\", -1)],\n            )\n        )\n\n    async def update(self, ctx, *, query: Mapping[str, Any], updates: Mapping[str, Any]) -> int:\n        result = await _collection(ctx, \"threads\").update_one(\n            dict(query),\n            {\"$set\": dict(updates)},\n        )\n        return int(getattr(result, \"matched_count\", 0) or 0)\n\n    async def update_last_message(\n        self,\n        ctx,\n        *,\n        thread_id: str,\n        query: Mapping[str, Any] | None = None,\n        updated_at: str,\n        preview: Mapping[str, Any],\n        participant_ids: Sequence[str] | None = None,\n    ) -> int:\n        updates: dict[str, Any] = {\n            \"updated_at\": updated_at,\n            \"last_message_at\": updated_at,\n            \"last_message\": dict(preview),\n        }\n        if participant_ids is not None:\n            updates[\"participant_ids\"] = list(participant_ids)\n        return await self.update(ctx, query=query or {\"thread_id\": thread_id}, updates=updates)\n\n\nclass MessageRepo:\n    async def insert(self, ctx, *, record: Mapping[str, Any]) -> None:\n        await _collection(ctx, \"messages\").insert_one(dict(record))\n\n    async def list(self, ctx, *, query: Mapping[str, Any], limit: int) -> list[Document]:\n        return _documents(\n            await _collection(ctx, \"messages\").find_many(\n                dict(query),\n                limit=limit,\n                sort=[(\"created_at\", 1)],\n            )\n        )\n\n\nclass ReadStateRepo:\n    async def upsert(\n        self,\n        ctx,\n        *,\n        thread_id: str,\n        user_id: str,\n        read_at: str,\n        scope_type: str | None = None,\n        scope_id: str | None = None,\n    ) -> None:\n        query = {\"thread_id\": thread_id, \"user_id\": user_id}\n        updates = {\"thread_id\": thread_id, \"user_id\": user_id, \"read_at\": read_at}\n        if scope_type:\n            query[\"scope_type\"] = scope_type\n            updates[\"scope_type\"] = scope_type\n        if scope_id:\n            query[\"scope_id\"] = scope_id\n            updates[\"scope_id\"] = scope_id\n        await _collection(ctx, \"thread_reads\").update_one(\n            query,\n            {\"$set\": updates},\n            upsert=True,\n        )"},{"checksum":"sha256:d74f02a13286e91db93a7324d5c6aa19d2077af853133ce4c3ae69c4c7680a4b","chunk_id":"chunk_fb588738aa87c0e3","end_line":154,"path":"build_context/messaging/templates/modules/messages/backend/schemas.py","start_line":1,"symbol_ids":["sym_60c9cf2607c2c3ee","sym_3be82a8aaa71e13c","sym_bc0e0a7f884ecd48","sym_75b223ccf9a9f69e","sym_f2b576e03e6c0a7c","sym_c1c1b5bb3a61fc0e","sym_5c37e8ba2ad99603","sym_953ea89b58176d77","sym_f2de9a233e07b1ff","sym_93cfd52a9692c0df","sym_91a1bdf09de8c6e0","sym_85470aa5b937af7a","sym_9ad11f4652e1242d"],"text":"from __future__ import annotations\n\nfrom datetime import UTC, datetime\nfrom typing import Any, TypedDict\nfrom uuid import uuid4\n\nMAX_MESSAGE_LENGTH = 4000\nMESSAGE_PREVIEW_LENGTH = 160\n\nTHREAD_TYPES = {\"group\", \"direct\", \"support\"}\nTHREAD_SCOPE_TYPES = {\"app\", \"workspace\"}\nTHREAD_STATUSES = {\"open\", \"resolved\", \"archived\"}\n\n\nclass ThreadRecord(TypedDict, total=False):\n    thread_id: str\n    scope_type: str\n    scope_id: str | None\n    subject_app_id: str | None\n    title: str\n    thread_type: str\n    participant_ids: list[str]\n    status: str\n    created_by: str\n    created_at: str\n    updated_at: str\n    last_message_at: str | None\n    last_message: dict[str, Any] | None\n    related_type: str | None\n    related_id: str | None\n    metadata: dict[str, Any]\n\n\nclass MessageRecord(TypedDict, total=False):\n    message_id: str\n    thread_id: str\n    sender_id: str\n    sender_role: str\n    body: str\n    message_type: str\n    created_at: str\n    edited_at: str | None\n    is_deleted: bool\n    metadata: dict[str, Any]\n\n\ndef timestamp_now() -> str:\n    return datetime.now(UTC).isoformat()\n\n\ndef metadata_entries_to_map(entries: list[dict[str, Any]] | None) -> dict[str, str]:\n    \"\"\"Fold closed {key, value} request entries into the stored metadata map.\n\n    The module request contract carries metadata as typed entries; thread\n    records keep the {key: value} map shape. Later entries win on duplicate keys.\n    \"\"\"\n    metadata: dict[str, str] = {}\n    for entry in entries or []:\n        metadata[str(entry[\"key\"])] = str(entry[\"value\"])\n    return metadata\n\n\ndef coerce_limit(value: Any, *, default: int = 50, maximum: int = 100) -> int:\n    try:\n        parsed = int(value)\n    except Exception:\n        parsed = default\n    return max(1, min(parsed, maximum))\n\n\ndef normalize_string(value: Any) -> str:\n    return str(value or \"\").strip()\n\n\ndef normalize_participant_ids(values: list[str] | None, *, required_user_id: str | None = None) -> list[str]:\n    raw = [required_user_id, *(values or [])] if required_user_id else list(values or [])\n    return list(dict.fromkeys(user_id for user_id in (normalize_string(item) for item in raw) if user_id))\n\n\ndef normalize_thread_type(value: Any) -> str:\n    thread_type = normalize_string(value) or \"group\"\n    return thread_type if thread_type in THREAD_TYPES else \"group\"\n\n\ndef normalize_scope_type(value: Any) -> str:\n    scope_type = normalize_string(value) or \"app\"\n    return scope_type if scope_type in THREAD_SCOPE_TYPES else \"app\"\n\n\ndef normalize_status(value: Any) -> str:\n    status = normalize_string(value) or \"open\"\n    return status if status in THREAD_STATUSES else \"open\"\n\n\ndef message_preview(body: str) -> str:\n    return body[:MESSAGE_PREVIEW_LENGTH]\n\n\ndef build_thread_record(\n    *,\n    created_by: str,\n    scope_type: str = \"app\",\n    scope_id: str | None = None,\n    subject_app_id: str | None = None,\n    title: str | None = None,\n    participant_ids: list[str] | None = None,\n    thread_type: str = \"group\",\n    related_type: str | None = None,\n    related_id: str | None = None,\n    metadata: dict[str, Any] | None = None,\n) -> ThreadRecord:\n    now = timestamp_now()\n    return {\n        \"thread_id\": f\"thr_{uuid4().hex}\",\n        \"scope_type\": normalize_scope_type(scope_type),\n        \"scope_id\": normalize_string(scope_id) or None,\n        \"subject_app_id\": normalize_string(subject_app_id) or None,\n        \"title\": normalize_string(title),\n        \"thread_type\": normalize_thread_type(thread_type),\n        \"participant_ids\": normalize_participant_ids(participant_ids, required_user_id=created_by),\n        \"status\": \"open\",\n        \"created_by\": created_by,\n        \"created_at\": now,\n        \"updated_at\": now,\n        \"last_message_at\": None,\n        \"last_message\": None,\n        \"related_type\": normalize_string(related_type) or None,\n        \"related_id\": normalize_string(related_id) or None,\n        \"metadata\": dict(metadata or {}),\n    }\n\n\ndef build_message_record(\n    *,\n    thread_id: str,\n    sender_id: str,\n    body: str,\n    sender_role: str = \"user\",\n    message_type: str = \"text\",\n    metadata: dict[str, Any] | None = None,\n) -> MessageRecord:\n    now = timestamp_now()\n    return {\n        \"message_id\": f\"msg_{uuid4().hex}\",\n        \"thread_id\": thread_id,\n        \"sender_id\": sender_id,\n        \"sender_role\": normalize_string(sender_role) or \"user\",\n        \"body\": body,\n        \"message_type\": normalize_string(message_type) or \"text\",\n        \"created_at\": now,\n        \"edited_at\": None,\n        \"is_deleted\": False,\n        \"metadata\": dict(metadata or {}),\n    }"},{"checksum":"sha256:4c81f966bbf74d1ae23d7e15afacc5334a47234a1e204d3df9dcb2c23430740c","chunk_id":"chunk_0781c80d24fb6d11","end_line":231,"path":"build_context/messaging/templates/modules/messages/backend/service.py","start_line":1,"symbol_ids":["sym_f77fa4a75953888b","sym_b500f794fac584b7","sym_ee36a450c853deba","sym_d89b2549159e207f","sym_6df90fc369912f30","sym_e1b866e4fabce3ff","sym_eec1ef2b61185d49","sym_b102da7ac124248b"],"text":"from __future__ import annotations\n\nimport inspect\nfrom typing import Any\n\nfrom .policy import actor_id, current_scope_query, is_participant, participant_thread_query, resolve_scope, thread_identity_queries\nfrom .repo import MessageRepo, ReadStateRepo, ThreadRepo\nfrom .schemas import (\n    MAX_MESSAGE_LENGTH,\n    build_message_record,\n    build_thread_record,\n    coerce_limit,\n    message_preview,\n    metadata_entries_to_map,\n    normalize_participant_ids,\n    normalize_scope_type,\n    normalize_status,\n    normalize_string,\n    normalize_thread_type,\n    timestamp_now,\n)\n\n\nclass MessageService:\n    def __init__(\n        self,\n        *,\n        threads: ThreadRepo | None = None,\n        messages: MessageRepo | None = None,\n        reads: ReadStateRepo | None = None,\n    ) -> None:\n        self.threads = threads or ThreadRepo()\n        self.messages = messages or MessageRepo()\n        self.reads = reads or ReadStateRepo()\n\n    async def _get_authorized_thread(self, ctx, *, thread_id: str) -> dict[str, Any] | None:\n        for query in thread_identity_queries(ctx, thread_id=thread_id):\n            thread = await self.threads.get(ctx, query=query)\n            if thread:\n                return thread\n        return None\n\n    async def _emit(self, ctx, event_type: str, payload: dict[str, Any]) -> None:\n        emit = getattr(ctx, \"emit\", None)\n        if emit is None:\n            return\n        result = emit(event_type, payload)\n        if inspect.isawaitable(result):\n            await result\n\n    async def create_thread(\n        self,\n        ctx,\n        *,\n        title: str | None = None,\n        participant_ids: list[str] | None = None,\n        thread_type: str = \"group\",\n        scope_type: str = \"app\",\n        scope_id: str | None = None,\n        subject_app_id: str | None = None,\n        related_type: str | None = None,\n        related_id: str | None = None,\n        metadata: list[dict[str, Any]] | None = None,\n    ) -> dict[str, Any]:\n        created_by = actor_id(ctx)\n        resolved_scope_type, resolved_scope_id = resolve_scope(ctx, scope_type=scope_type, scope_id=scope_id)\n        resolved_subject_app_id = subject_app_id or (getattr(ctx, \"app_id\", None) if resolved_scope_type == \"app\" else None)\n        thread = build_thread_record(\n            created_by=created_by,\n            scope_type=resolved_scope_type,\n            scope_id=resolved_scope_id,\n            subject_app_id=resolved_subject_app_id,\n            title=title,\n            participant_ids=participant_ids,\n            thread_type=thread_type,\n            related_type=related_type,\n            related_id=related_id,\n            metadata=metadata_entries_to_map(metadata),\n        )\n        await self.threads.insert(ctx, record=thread)\n        await self._emit(\n            ctx,\n            \"domain.messages.thread_created\",\n            {\n                \"thread_id\": thread[\"thread_id\"],\n                \"thread_type\": thread[\"thread_type\"],\n                \"scope_type\": thread.get(\"scope_type\"),\n                \"scope_id\": thread.get(\"scope_id\"),\n                \"subject_app_id\": thread.get(\"subject_app_id\"),\n                \"created_by\": created_by,\n                \"related_type\": thread.get(\"related_type\"),\n                \"related_id\": thread.get(\"related_id\"),\n            },\n        )\n        return {\"success\": True, \"thread\": dict(thread)}\n\n    async def list_threads(\n        self,\n        ctx,\n        *,\n        status: str | None = None,\n        thread_type: str | None = None,\n        scope_type: str | None = None,\n        scope_id: str | None = None,\n        subject_app_id: str | None = None,\n        related_type: str | None = None,\n        related_id: str | None = None,\n        limit: int = 50,\n        include_support_threads: bool = False,\n    ) -> dict[str, Any]:\n        query = participant_thread_query(ctx)\n        if status:\n            query[\"status\"] = normalize_status(status)\n        if thread_type:\n            query[\"thread_type\"] = normalize_thread_type(thread_type)\n        if not include_support_threads:\n            if query.get(\"thread_type\") == \"support\":\n                return {\"threads\": [], \"total\": 0}\n            query.setdefault(\"thread_type\", {\"$ne\": \"support\"})\n        if scope_type:\n            query.update(current_scope_query(ctx, scope_type=normalize_scope_type(scope_type), scope_id=scope_id))\n        if scope_id:\n            query.update(current_scope_query(ctx, scope_type=scope_type, scope_id=normalize_string(scope_id)))\n        if subject_app_id:\n            query[\"subject_app_id\"] = normalize_string(subject_app_id)\n        if related_type:\n            query[\"related_type\"] = normalize_string(related_type)\n        if related_id:\n            query[\"related_id\"] = normalize_string(related_id)\n        threads = await self.threads.list(ctx, query=query, limit=coerce_limit(limit))\n        return {\"threads\": threads, \"total\": len(threads)}\n\n    async def get_thread(\n        self,\n        ctx,\n        *,\n        thread_id: str,\n        message_limit: int = 50,\n        allow_nonparticipant_reader: bool = False,\n        allow_support_thread_reader: bool = False,\n    ) -> dict[str, Any]:\n        thread = await self._get_authorized_thread(ctx, thread_id=thread_id)\n        if not thread:\n            return {\"thread\": None, \"messages\": [], \"error\": \"thread not found\"}\n        if thread.get(\"thread_type\") == \"support\" and not allow_support_thread_reader:\n            return {\"thread\": None, \"messages\": [], \"error\": \"thread not found\"}\n        if not allow_nonparticipant_reader and not is_participant(thread, actor_id(ctx)):\n            return {\"thread\": None, \"messages\": [], \"error\": \"access denied\"}\n        messages = await self.messages.list(\n            ctx,\n            query={\"thread_id\": thread_id, \"is_deleted\": {\"$ne\": True}},\n            limit=coerce_limit(message_limit, default=50, maximum=200),\n        )\n        return {\"thread\": thread, \"messages\": messages}\n\n    async def send_message(\n        self,\n        ctx,\n        *,\n        thread_id: str,\n        body: str,\n        message_type: str = \"text\",\n        sender_role: str = \"user\",\n        recipient_ids: list[str] | None = None,\n        metadata: dict[str, Any] | None = None,\n        allow_nonparticipant_sender: bool = False,\n        allow_support_thread_sender: bool = False,\n    ) -> dict[str, Any]:\n        clean_body = normalize_string(body)\n        if not clean_body:\n            return {\"success\": False, \"error\": \"body is required\"}\n        if len(clean_body) > MAX_MESSAGE_LENGTH:\n            return {\"success\": False, \"error\": f\"message exceeds {MAX_MESSAGE_LENGTH} character limit\"}\n\n        thread = await self._get_authorized_thread(ctx, thread_id=thread_id)\n        if not thread:\n            return {\"success\": False, \"error\": \"thread not found\"}\n        if thread.get(\"thread_type\") == \"support\" and not allow_support_thread_sender:\n            return {\"success\": False, \"error\": \"thread not found\"}\n        if thread.get(\"status\") != \"open\":\n            return {\"success\": False, \"error\": \"thread is closed\"}\n\n        sender_id = actor_id(ctx)\n        participant_ids = list(thread.get(\"participant_ids\") or [])\n        if not is_participant(thread, sender_id):\n            if not allow_nonparticipant_sender:\n                return {\"success\": False, \"error\": \"access denied\"}\n            participant_ids = normalize_participant_ids([*participant_ids, sender_id])\n\n        message = build_message_record(\n            thread_id=thread_id,\n            sender_id=sender_id,\n            sender_role=sender_role,\n            body=clean_body,\n            message_type=message_type,\n            metadata=metadata,\n        )\n        await self.messages.insert(ctx, record=message)\n\n        preview = {\n            \"message_id\": message[\"message_id\"],\n            \"sender_id\": sender_id,\n            \"sender_role\": message[\"sender_role\"],\n            \"body_preview\": message_preview(clean_body),\n            \"sent_at\": message[\"created_at\"],\n        }\n        await self.threads.update_last_message(\n            ctx,\n            thread_id=thread_id,\n            query={\n                \"thread_id\": thread_id,\n                \"scope_type\": thread.get(\"scope_type\"),\n                \"scope_id\": thread.get(\"scope_id\"),\n            },\n            updated_at=message[\"created_at\"],\n            preview=preview,\n            participant_ids=participant_ids,\n        )\n\n        recipients = normalize_participant_ids(recipient_ids) if recipient_ids is not None else [\n            participant_id for participant_id in participant_ids if participant_id != sender_id\n        ]\n        await self._emit(\n            ctx,\n            \"domain.messages.message_sent\",\n            {\n                \"thread_id\": thread_id,\n                \"message_id\": message[\"message_id\"],\n                \"sender_id\": sender_id,\n                \"sender_role\": message[\"sender_role\"],\n                \"body_preview\": message_preview(clean_body),"},{"checksum":"sha256:69154fe6fb29e4304c8c94929b84e3d158d9434958d72430710e6c3b525a3512","chunk_id":"chunk_da593a8077cbc033","end_line":258,"path":"build_context/messaging/templates/modules/messages/backend/service.py","start_line":232,"symbol_ids":["sym_f77fa4a75953888b","sym_b102da7ac124248b","sym_e36690350a1af6d8"],"text":"                \"sent_at\": message[\"created_at\"],\n                \"recipient_ids\": recipients,\n                \"participant_ids\": participant_ids,\n                \"scope_type\": thread.get(\"scope_type\"),\n                \"scope_id\": thread.get(\"scope_id\"),\n                \"subject_app_id\": thread.get(\"subject_app_id\"),\n                \"related_type\": thread.get(\"related_type\"),\n                \"related_id\": thread.get(\"related_id\"),\n            },\n        )\n        return {\"success\": True, \"message\": dict(message)}\n\n    async def mark_thread_read(self, ctx, *, thread_id: str) -> dict[str, Any]:\n        thread = await self._get_authorized_thread(ctx, thread_id=thread_id)\n        user_id = actor_id(ctx)\n        if not thread or thread.get(\"thread_type\") == \"support\" or not is_participant(thread, user_id):\n            return {\"success\": False, \"error\": \"thread not found\"}\n        await self.reads.upsert(\n            ctx,\n            thread_id=thread_id,\n            user_id=user_id,\n            read_at=timestamp_now(),\n            scope_type=thread.get(\"scope_type\"),\n            scope_id=thread.get(\"scope_id\"),\n        )\n        await self._emit(ctx, \"domain.messages.thread_read\", {\"thread_id\": thread_id, \"user_id\": user_id})\n        return {\"success\": True}"},{"checksum":"sha256:3bc7fd8ef982124ce6900ea1cbf0916e72967f96f91b50b2e9176716b4487600","chunk_id":"chunk_1d09275245918795","end_line":55,"path":"build_context/messaging/templates/modules/messages/contracts/events.yaml","start_line":1,"symbol_ids":[],"text":"schema_version: mozaiks.events.v1\nevents:\n  - type: domain.messages.thread_created\n    version: 1\n    description: Emitted after an internal message thread is created.\n    producer: messages\n    payload_schema:\n      type: object\n      required: [thread_id, thread_type, created_by]\n      properties:\n        thread_id: { type: string }\n        thread_type: { type: string }\n        scope_type: { type: string }\n        scope_id: { type: string }\n        subject_app_id: { type: string }\n        created_by: { type: string }\n        related_type: { type: string }\n        related_id: { type: string }\n\n  - type: domain.messages.message_sent\n    version: 1\n    description: Emitted after a message is persisted and ready for recipient notification.\n    producer: messages\n    payload_schema:\n      type: object\n      required: [thread_id, message_id, sender_id, sender_role, body_preview, sent_at, recipient_ids]\n      properties:\n        thread_id: { type: string }\n        message_id: { type: string }\n        sender_id: { type: string }\n        sender_role: { type: string }\n        body_preview: { type: string }\n        sent_at: { type: string }\n        scope_type: { type: string }\n        scope_id: { type: string }\n        subject_app_id: { type: string }\n        related_type: { type: string }\n        related_id: { type: string }\n        recipient_ids:\n          type: array\n          items: { type: string }\n        participant_ids:\n          type: array\n          items: { type: string }\n\n  - type: domain.messages.thread_read\n    version: 1\n    description: Emitted when a user marks a message thread as read.\n    producer: messages\n    payload_schema:\n      type: object\n      required: [thread_id, user_id]\n      properties:\n        thread_id: { type: string }\n        user_id: { type: string }"},{"checksum":"sha256:9c1f50a9f252715b18e52eafb3db6da766f8a2cda210395fff347b211196b0f6","chunk_id":"chunk_98b32dba8ae01c7a","end_line":18,"path":"build_context/messaging/templates/modules/messages/contracts/notifications.yaml","start_line":1,"symbol_ids":[],"text":"schema_version: mozaiks.notifications.v1\n\nnotifications:\n  - id: message_sent\n    description: Notify message recipients when a new internal message is sent.\n    event_type: domain.messages.message_sent\n    channels:\n      - in_app\n    audience:\n      user_id_field: recipient_ids\n    template:\n      title: \"New message\"\n      body: \"{{body_preview}}\"\n    context_fields:\n      - thread_id\n      - message_id\n      - related_type\n      - related_id"},{"checksum":"sha256:0c0cd05d872e0c8ec9201d57058c3d581ee4d13de7a781aa18a7c3afc02cde6f","chunk_id":"chunk_2c80afe56d8aede7","end_line":7,"path":"build_context/messaging/templates/modules/messages/contracts/profile.yaml","start_line":1,"symbol_ids":[],"text":"schema_version: mozaiks.profile.v1\ntabs:\n  - id: messages\n    label: Messages\n    order: 40\n    action: list_threads\n    component: MessagingProfileTab"},{"checksum":"sha256:077a6a383a4d09e9d73ebadf612730ee482ffab516fe83d9615537fd26552254","chunk_id":"chunk_f2eea46c20c31d44","end_line":2,"path":"build_context/messaging/templates/modules/messages/contracts/reactions.yaml","start_line":1,"symbol_ids":[],"text":"schema_version: mozaiks.reactions.v1\nreactions: []"},{"checksum":"sha256:1f11b537c7a11317186bd3cbb887122c314fd74c22af3932e53fa678385f5eb9","chunk_id":"chunk_a0ae19329318e202","end_line":203,"path":"build_context/messaging/templates/modules/messages/module.yaml","start_line":1,"symbol_ids":[],"text":"schema_version: mozaiks.module.v1\nmodule:\n  id: messages\n  display_name: Messages\n  version: 1.0.0\n  description: Internal app messaging for user conversations, support threads, read state, and notification fan-out.\n  owner: app\n  visibility: private\n  handler: backend.handler:MessagesHandler\n  user_data_scope: true\n\npermissions:\n  - id: messages.read\n    description: Read message threads and messages.\n  - id: messages.write\n    description: Create threads, send messages, and update read state.\n\nactions:\n  - id: create_thread\n    description: Create a direct or group message thread. Support threads are created by the support module.\n    handler_method: create_thread\n    input_schema:\n      type: object\n      additionalProperties: false\n      properties:\n        title:\n          type: string\n        participant_ids:\n          type: array\n          items:\n            type: string\n        # thread_type \u2014 optional; the service defaults omitted values to group.\n        thread_type:\n          type: string\n          enum: [group, direct]\n        # scope_type \u2014 whether the conversation belongs to one app or to\n        # workspace-level social context; the service defaults omissions to app.\n        scope_type:\n          type: string\n          enum: [app, workspace]\n        # scope_id \u2014 optional explicit scope id. Defaults to ctx.app_id for app\n        # scope or ctx.workspace_id for workspace scope.\n        scope_id:\n          type: string\n        # subject_app_id \u2014 the app this conversation is about. Support threads\n        # should set this to the supported app id.\n        subject_app_id:\n          type: string\n        # related_type \u2014 optional owning entity type such as\n        # workspace_support.request.\n        related_type:\n          type: string\n        # related_id \u2014 optional owning entity id.\n        related_id:\n          type: string\n        # metadata \u2014 optional thread annotation entries (for example the\n        # support pack's request_id link). Stored on the thread as a\n        # {key: value} map built from these typed entries.\n        metadata:\n          type: array\n          items:\n            type: object\n            additionalProperties: false\n            required: [key, value]\n            properties:\n              key: { type: string }\n              value: { type: string }\n    output_schema:\n      type: object\n      required: [success, thread]\n      properties:\n        success:\n          type: boolean\n        thread:\n          type: object\n    permissions:\n      - messages.write\n    emits:\n      - domain.messages.thread_created\n\n  - id: list_threads\n    description: List threads for the current user.\n    handler_method: list_threads\n    input_schema:\n      type: object\n      additionalProperties: false\n      properties:\n        status:\n          type: string\n          enum: [open, resolved, archived]\n        thread_type:\n          type: string\n          enum: [group, direct]\n        scope_type:\n          type: string\n          enum: [app, workspace]\n        scope_id:\n          type: string\n        subject_app_id:\n          type: string\n        related_type:\n          type: string\n        related_id:\n          type: string\n        limit:\n          type: integer\n    output_schema:\n      type: object\n      required: [threads, total]\n      properties:\n        threads:\n          type: array\n        total:\n          type: integer\n    permissions:\n      - messages.read\n\n  - id: get_thread\n    description: Fetch a direct or group thread and its messages. Support conversations use support.get_support_conversation.\n    handler_method: get_thread\n    input_schema:\n      type: object\n      additionalProperties: false\n      required: [thread_id]\n      properties:\n        thread_id:\n          type: string\n        message_limit:\n          type: integer\n    output_schema:\n      type: object\n      required: [thread, messages]\n      properties:\n        thread:\n          type: object\n        messages:\n          type: array\n    permissions:\n      - messages.read\n\n  - id: send_message\n    description: Send a direct or group message. Support replies use support.reply_support_request.\n    handler_method: send_message\n    input_schema:\n      type: object\n      additionalProperties: false\n      required: [thread_id, body]\n      properties:\n        thread_id:\n          type: string\n        body:\n          type: string\n        # message_type \u2014 optional; the service defaults omitted values to text.\n        message_type:\n          type: string\n          enum: [text, system]\n    output_schema:\n      type: object\n      required: [success, message]\n      properties:\n        success:\n          type: boolean\n        message:\n          type: object\n    permissions:\n      - messages.write\n    emits:\n      - domain.messages.message_sent\n\n  - id: mark_thread_read\n    description: Mark a thread as read for the current user.\n    handler_method: mark_thread_read\n    input_schema:\n      type: object\n      additionalProperties: false\n      required: [thread_id]\n      properties:\n        thread_id:\n          type: string\n    output_schema:\n      type: object\n      required: [success]\n      properties:\n        success:\n          type: boolean\n    permissions:\n      - messages.write\n    emits:\n      - domain.messages.thread_read\n\ncapabilities:\n  - capability_id: messaging.threads.list\n    kind: action\n    target: list_threads\n    title: List message threads\n    permissions:\n      - messages.read\n  - capability_id: messaging.messages.send\n    kind: action\n    target: send_message\n    title: Send message\n    permissions:\n      - messages.write"},{"checksum":"sha256:ce2d053ac5f4c3e00a9864061a572aec4ad31513269b37361675e679659dfe21","chunk_id":"chunk_e775a6f23f2df086","end_line":55,"path":"build_context/messaging/templates/ui/components/MessagingProfileTab.jsx","start_line":1,"symbol_ids":["sym_05700b7d8692d52c","sym_2b3fef8b1483744a","sym_d8e9f148d8f7711d"],"text":"import { useMemo } from \"react\";\n\nfunction relativeTime(value) {\n  if (!value) return \"\";\n  const diff = Date.now() - new Date(value).getTime();\n  const minutes = Math.max(0, Math.floor(diff / 60000));\n  if (minutes < 1) return \"just now\";\n  if (minutes < 60) return `${minutes}m ago`;\n  const hours = Math.floor(minutes / 60);\n  if (hours < 24) return `${hours}h ago`;\n  return `${Math.floor(hours / 24)}d ago`;\n}\n\nfunction threadTitle(thread) {\n  return thread?.title || thread?.related_type || thread?.thread_type || \"Conversation\";\n}\n\nexport default function MessagingProfileTab({ data }) {\n  const threads = useMemo(\n    () => (Array.isArray(data?.threads) ? data.threads : []),\n    [data]\n  );\n\n  if (threads.length === 0) {\n    return (\n      <section style={{ border: \"1px solid var(--border-color, #d1d5db)\", padding: 16 }}>\n        <p style={{ margin: 0 }}>No conversations yet.</p>\n      </section>\n    );\n  }\n\n  return (\n    <section style={{ display: \"grid\", gap: 8 }}>\n      {threads.map((thread) => (\n        <a\n          key={thread.thread_id}\n          href={`/messages?thread=${encodeURIComponent(thread.thread_id)}`}\n          style={{\n            border: \"1px solid var(--border-color, #d1d5db)\",\n            color: \"inherit\",\n            display: \"block\",\n            padding: 12,\n            textDecoration: \"none\",\n          }}\n        >\n          <strong>{threadTitle(thread)}</strong>\n          {thread.last_message?.body_preview && (\n            <p style={{ margin: \"4px 0\", opacity: 0.75 }}>{thread.last_message.body_preview}</p>\n          )}\n          <span style={{ fontSize: 12, opacity: 0.65 }}>{relativeTime(thread.updated_at)}</span>\n        </a>\n      ))}\n    </section>\n  );\n}"},{"checksum":"sha256:b41343900315eb26977bbb750e052759cc469ca0b5211d8694682c4071894ed5","chunk_id":"chunk_895cf9aade6bfe7a","end_line":6,"path":"build_context/messaging/templates/ui/index.js","start_line":1,"symbol_ids":["sym_6ce788b3174aeae9"],"text":"import MessagingProfileTab from \"./components/MessagingProfileTab.jsx\";\n\nexport function register(registerComponent) {\n  if (typeof registerComponent !== \"function\") return;\n  registerComponent(\"MessagingProfileTab\", MessagingProfileTab);\n}"},{"checksum":"sha256:6c970619997cbd2135913ba7e3256392094bf2d55ba3d5ca52380123c03113c0","chunk_id":"chunk_51999a971bbbb4aa","end_line":203,"path":"build_context/messaging/templates/ui/pages/custom/Messages.jsx","start_line":1,"symbol_ids":["sym_a84a2e46691f2a81","sym_522533fd0cafae21","sym_7e68f9d8791e0c89","sym_f044638a2efdaa21"],"text":"import React, { useCallback, useEffect, useMemo, useState } from \"react\";\nimport { moduleAction } from \"../../../lib/moduleApi.js\";\n\nconst EMPTY_THREAD = { title: \"\", participantIds: \"\" };\n\nfunction ThreadTitle({ thread }) {\n  const title = thread?.title || thread?.related_type || thread?.thread_type || \"Conversation\";\n  return <span>{title}</span>;\n}\n\nexport default function Messages() {\n  const [threads, setThreads] = useState([]);\n  const [selectedThreadId, setSelectedThreadId] = useState(null);\n  const [selectedMessages, setSelectedMessages] = useState([]);\n  const [draft, setDraft] = useState(\"\");\n  const [newThread, setNewThread] = useState(EMPTY_THREAD);\n  const [loading, setLoading] = useState(false);\n  const [detailLoading, setDetailLoading] = useState(false);\n  const [error, setError] = useState(null);\n\n  const selectedThread = useMemo(\n    () => threads.find((thread) => thread.thread_id === selectedThreadId) || null,\n    [threads, selectedThreadId]\n  );\n\n  const loadThreads = useCallback(async () => {\n    setLoading(true);\n    setError(null);\n    try {\n      const result = await moduleAction(\"messages\", \"list_threads\", { limit: 50 });\n      const nextThreads = result.threads || [];\n      setThreads(nextThreads);\n      if (!selectedThreadId && nextThreads.length > 0) {\n        setSelectedThreadId(nextThreads[0].thread_id);\n      }\n    } catch (err) {\n      setError(err?.message || \"Could not load conversations.\");\n    } finally {\n      setLoading(false);\n    }\n  }, [selectedThreadId]);\n\n  const loadThread = useCallback(async (threadId) => {\n    if (!threadId) return;\n    setDetailLoading(true);\n    setError(null);\n    try {\n      const result = await moduleAction(\"messages\", \"get_thread\", {\n        thread_id: threadId,\n        message_limit: 100,\n      });\n      setSelectedMessages(result.messages || []);\n      await moduleAction(\"messages\", \"mark_thread_read\", { thread_id: threadId });\n    } catch (err) {\n      setError(err?.message || \"Could not load the selected conversation.\");\n      setSelectedMessages([]);\n    } finally {\n      setDetailLoading(false);\n    }\n  }, []);\n\n  useEffect(() => {\n    loadThreads();\n  }, [loadThreads]);\n\n  useEffect(() => {\n    loadThread(selectedThreadId);\n  }, [selectedThreadId, loadThread]);\n\n  async function createThread(event) {\n    event.preventDefault();\n    const title = newThread.title.trim();\n    const participant_ids = newThread.participantIds\n      .split(\",\")\n      .map((value) => value.trim())\n      .filter(Boolean);\n    if (!title && participant_ids.length === 0) return;\n\n    try {\n      const result = await moduleAction(\"messages\", \"create_thread\", {\n        title,\n        participant_ids,\n        thread_type: participant_ids.length <= 1 ? \"direct\" : \"group\",\n      });\n      const thread = result.thread;\n      if (thread) {\n        setThreads((current) => [thread, ...current]);\n        setSelectedThreadId(thread.thread_id);\n        setNewThread(EMPTY_THREAD);\n      }\n    } catch (err) {\n      setError(err?.message || \"Could not create conversation.\");\n    }\n  }\n\n  async function sendMessage(event) {\n    event.preventDefault();\n    const body = draft.trim();\n    if (!body || !selectedThreadId) return;\n    try {\n      const result = await moduleAction(\"messages\", \"send_message\", {\n        thread_id: selectedThreadId,\n        body,\n      });\n      if (result.message) {\n        setSelectedMessages((current) => [...current, result.message]);\n      }\n      setDraft(\"\");\n      await loadThreads();\n    } catch (err) {\n      setError(err?.message || \"Could not send message.\");\n    }\n  }\n\n  return (\n    <main className=\"messages-page\" style={{ display: \"grid\", gridTemplateColumns: \"320px 1fr\", minHeight: \"100vh\" }}>\n      <aside style={{ borderRight: \"1px solid var(--border-color, #d1d5db)\", padding: 16 }}>\n        <header style={{ display: \"flex\", alignItems: \"center\", justifyContent: \"space-between\", gap: 12 }}>\n          <h1 style={{ margin: 0, fontSize: 24 }}>Messages</h1>\n          <button type=\"button\" onClick={loadThreads} disabled={loading}>\n            Refresh\n          </button>\n        </header>\n\n        <form onSubmit={createThread} style={{ display: \"grid\", gap: 8, marginTop: 16 }}>\n          <input\n            value={newThread.title}\n            onChange={(event) => setNewThread((current) => ({ ...current, title: event.target.value }))}\n            placeholder=\"Thread title\"\n          />\n          <input\n            value={newThread.participantIds}\n            onChange={(event) => setNewThread((current) => ({ ...current, participantIds: event.target.value }))}\n            placeholder=\"Participant ids, comma separated\"\n          />\n          <button type=\"submit\">Start conversation</button>\n        </form>\n\n        {error && <p style={{ color: \"var(--destructive, #dc2626)\" }}>{error}</p>}\n\n        <div style={{ display: \"grid\", gap: 8, marginTop: 16 }}>\n          {threads.map((thread) => (\n            <button\n              key={thread.thread_id}\n              type=\"button\"\n              onClick={() => setSelectedThreadId(thread.thread_id)}\n              style={{\n                padding: 12,\n                textAlign: \"left\",\n                border: selectedThreadId === thread.thread_id ? \"1px solid var(--primary, #2563eb)\" : \"1px solid var(--border-color, #d1d5db)\",\n                background: selectedThreadId === thread.thread_id ? \"var(--muted, #f3f4f6)\" : \"transparent\",\n              }}\n            >\n              <strong><ThreadTitle thread={thread} /></strong>\n              <span style={{ display: \"block\", opacity: 0.7, fontSize: 12 }}>\n                {thread.thread_type || \"group\"} - {thread.status || \"open\"}\n              </span>\n              {thread.last_message?.body_preview && (\n                <span style={{ display: \"block\", marginTop: 4, fontSize: 12 }}>\n                  {thread.last_message.body_preview}\n                </span>\n              )}\n            </button>\n          ))}\n          {!loading && threads.length === 0 && <p>No conversations yet.</p>}\n        </div>\n      </aside>\n\n      <section style={{ display: \"grid\", gridTemplateRows: \"auto 1fr auto\", minHeight: 0 }}>\n        <header style={{ borderBottom: \"1px solid var(--border-color, #d1d5db)\", padding: 16 }}>\n          <h2 style={{ margin: 0 }}>\n            {selectedThread ? <ThreadTitle thread={selectedThread} /> : \"Select a conversation\"}\n          </h2>\n        </header>\n\n        <div style={{ overflow: \"auto\", padding: 16 }}>\n          {detailLoading && <p>Loading messages...</p>}\n          {!detailLoading && selectedMessages.length === 0 && selectedThread && <p>No messages yet.</p>}\n          {!selectedThread && <p>Pick a conversation or start a new one.</p>}\n          {selectedMessages.map((message) => (\n            <article key={message.message_id} style={{ marginBottom: 12 }}>\n              <strong>{message.sender_role || \"user\"}</strong>\n              <p style={{ margin: \"4px 0 0\" }}>{message.body}</p>\n            </article>\n          ))}\n        </div>\n\n        <form onSubmit={sendMessage} style={{ borderTop: \"1px solid var(--border-color, #d1d5db)\", display: \"flex\", gap: 8, padding: 16 }}>\n          <input\n            value={draft}\n            onChange={(event) => setDraft(event.target.value)}\n            disabled={!selectedThread}\n            placeholder={selectedThread ? \"Type a message\" : \"Select a conversation first\"}\n            style={{ flex: 1 }}\n          />\n          <button type=\"submit\" disabled={!selectedThread || !draft.trim()}>\n            Send\n          </button>\n        </form>\n      </section>\n    </main>\n  );\n}"},{"checksum":"sha256:6b71f56d2c0063eb5fa5e01f68277a8a9d2a108d829f24c08856d9671e0460ca","chunk_id":"chunk_7876e3e27adc9ba1","end_line":19,"path":"build_context/messaging/templates/ui/route_manifest.json","start_line":1,"symbol_ids":[],"text":"{\n  \"pages\": [\n    {\n      \"id\": \"messages\",\n      \"label\": \"Messages\",\n      \"path\": \"/messages\",\n      \"component\": \"Messages\",\n      \"order\": 50,\n      \"navigation\": {\n        \"include\": false\n      },\n      \"meta\": {\n        \"title\": \"Messages\",\n        \"requiresAuth\": true,\n        \"shellMode\": \"conversation\"\n      }\n    }\n  ]\n}"},{"checksum":"sha256:ece16d7db58c91b834d402ebf07420b6ca677038a1cff640c134e0dcec3d39cb","chunk_id":"chunk_389dc6c672f22cfa","end_line":110,"path":"build_context/mozaiks_cloud/context.yaml","start_line":1,"symbol_ids":[],"text":"context_id: mozaiks_cloud\napplies_to_workflows:\n  - AppGenerator\nassets:\n  - path: contract.yaml\n    kind: contract\n  - path: provider_api_contract.yaml\n    kind: contract\n  - path: templates/\n    kind: templates\npack:\n  id: mozaiks_cloud\n  version: \"0.1.0\"\n  status: active\n  capability_source: managed_capability\n  required_integrations:\n    - service: mozaiks_cloud\n      provider: mozaiks_cloud\n      display_name: Mozaiks Cloud\n      kind: [REDACTED]\n      purpose: >\n        Submit deployments, inspect hosting/environment state, request rollbacks,\n        and manage domain DNS/TLS lifecycle through one Mozaiks Cloud-compatible\n        managed-service credential.\n      required_at: runtime\n      service_scopes:\n        - cloud:read\n        - cloud:deploy\n        - cloud:rollback\n        - cloud:usage\n        - domains:read\n        - domains:write\n        - domains:manage\n      required_fields:\n        - name: api_base\n          label: Mozaiks Cloud API Base URL\n          type: url\n          required: true\n          frontend_safe: true\n        - name: [REDACTED]\n          label: Mozaiks Cloud API Key\n          type: [REDACTED]\n          required: true\n          frontend_safe: false\n      optional_fields:\n        - name: app_id\n          label: Mozaiks Cloud App ID\n          type: text\n          required: false\n          frontend_safe: true\n  deployment_env:\n    optional:\n      - MOZAIKS_CLOUD_API_BASE\n      - MOZAIKS_CLOUD_APP_ID\n    secret:\n      - MOZAIKS_CLOUD_API_KEY\ncapabilities:\n  - capability_id: cloud.deployment.submit\n    facade_recommended: cloud_deployment\n  - capability_id: cloud.deployment.status\n    facade_recommended: cloud_deployment\n  - capability_id: cloud.deployment.rollback\n    facade_recommended: cloud_deployment\n  - capability_id: cloud.environment.endpoints\n    facade_recommended: cloud_deployment\n  - capability_id: cloud.deployment.health\n    facade_recommended: cloud_deployment\n  - capability_id: cloud.domain.connect\n    facade_recommended: cloud_domain\n  - capability_id: cloud.domain.status\n    facade_recommended: cloud_domain\n  - capability_id: cloud.domain.disconnect\n    facade_recommended: cloud_domain\n  - capability_id: cloud.usage.report\n    facade_recommended: cloud_usage_reporter\nfacades:\n  - module_id: cloud_deployment\n    provider_module: mozaiks_cloud\n    provider_actions:\n      - submit_deployment\n      - get_deployment_status\n      - get_environment_endpoints\n      - request_rollback\n    pages:\n      - name: Deployments\n        route: /deployments\n        page_type_hint: list_detail\n  - module_id: cloud_usage_reporter\n    provider_module: mozaiks_cloud\n    provider_actions:\n      - report_usage_rollups\n  - module_id: cloud_domain\n    provider_module: mozaiks_cloud\n    provider_actions:\n      - connect_domain\n      - get_domain_verification\n      - get_dns_instructions\n      - request_domain_activation\n      - get_domain_status\n      - disconnect_domain\n    pages:\n      - name: Domains\n        route: /domains\n        page_type_hint: list_detail\nprojections:\n  context_variables:\n    capability_packs:\n      from: capability_packs\n    operator_contracts:\n      from: operator_contracts"},{"checksum":"sha256:29e69992a4d27fcc6332c6b68eb52d16232829a02b098b53ea5eefd716483b2d","chunk_id":"chunk_a6696fb530ce956b","end_line":251,"path":"build_context/mozaiks_cloud/contract.yaml","start_line":1,"symbol_ids":[],"text":"contract_id: mozaiks_cloud_connector\ncontract_type: build_pack_instructions\n\n# Declares capabilities this pack provides to the OSS planning system.\n# cloud_deployment_write_path: this managed pack owns the deployment\n# submission path. Generated apps use app-owned facade modules.\n# cloud_domain_write_path: this managed pack owns domain connection ops.\nprovides_capabilities:\n  - cloud_deployment_write_path\n  - cloud_domain_write_path\n\nselection_rules:\n  - id: require_explicit_selection_for_cloud_hosting\n    description: >\n      Mozaiks Cloud connector requires explicit user selection. Self-hosted and\n      portable app deployments work without it. Never auto-select this pack\n      from generic deployment intent alone.\n    when:\n      intent_any:\n        - deploy to mozaiks cloud\n        - mozaiks cloud hosting\n        - managed cloud hosting\n        - cloud deployment connector\n    action: require_explicit_user_confirmation\n    confirmation_message: >\n      Mozaiks Cloud adds managed deployment, environment endpoint retrieval, and\n      custom domain management. Activation requires a Mozaiks Cloud account and\n      API credentials. This pack is optional \u2014 self-hosted and portable\n      deployments remain fully valid without it.\n\nrecommended_domains:\n  - deployments\n  - hosting\n  - domains\n  - environments\n\nrequired_integrations:\n  - service: mozaiks_cloud\n    provider: mozaiks_cloud\n    display_name: Mozaiks Cloud\n    kind: [REDACTED]\n    purpose: >\n      Submit deployments, inspect hosting/environment state, request rollbacks,\n      and manage domain DNS/TLS lifecycle through one Mozaiks Cloud-compatible\n      managed-service credential.\n    required_at: runtime\n    service_scopes:\n      - cloud:read\n      - cloud:deploy\n      - cloud:rollback\n      - domains:read\n      - domains:write\n      - domains:manage\n    required_fields:\n      - name: api_base\n        label: Mozaiks Cloud API Base URL\n        type: url\n        required: true\n        frontend_safe: true\n      - name: [REDACTED]\n        label: Mozaiks Cloud API Key\n        type: [REDACTED]\n        required: true\n        frontend_safe: false\n    optional_fields:\n      - name: app_id\n        label: Mozaiks Cloud App ID\n        type: text\n        required: false\n        frontend_safe: true\n\nrequired_outputs:\n  - path: services/integrations/mozaiks_cloud_client.py\n    owner: templates\n  - path: services/integrations/mozaiks_cloud_deployment_client.py\n    owner: templates\n  - path: services/integrations/mozaiks_cloud_domain_client.py\n    owner: templates\n  - path: modules/cloud_deployment/module.yaml\n    owner: templates\n  - path: modules/cloud_deployment/backend/handler.py\n    owner: templates\n  - path: modules/cloud_deployment/backend/service.py\n    owner: templates\n  - path: modules/cloud_domain/module.yaml\n    owner: templates\n  - path: modules/cloud_domain/backend/handler.py\n    owner: templates\n  - path: modules/cloud_domain/backend/service.py\n    owner: templates\n\nforbidden_outputs:\n  - path_prefix: services/adapters/azure/\n    reason: Azure provider mechanics belong in mozaiks-app, not in generated app bundles.\n  - path_prefix: services/adapters/cloudflare/\n    reason: Cloudflare provider mechanics belong in mozaiks-app, not in generated app bundles.\n  - path_prefix: services/adapters/github/\n    reason: GitHub CI/CD provider mechanics belong in mozaiks-app, not in generated app bundles.\n  - path_prefix: services/adapters/dns/\n    reason: DNS provider mechanics belong in mozaiks-app, not in generated app bundles.\n  - path_prefix: modules/mozaiks_cloud/\n    reason: No monolithic cloud module; use bounded facade modules (cloud_deployment, cloud_domain).\n  - path_prefix: infra/azure/\n    reason: Azure infrastructure configuration belongs in mozaiks-app.\n\nruntime_boundaries:\n  - id: no_azure_sdk\n    rule: >\n      Generated bundles must not import Azure SDK libraries directly.\n      All Azure operations flow through the Mozaiks Cloud platform API; never\n      through azure-sdk or azure-mgmt in the generated app.\n  - id: no_cloudflare_sdk\n    rule: >\n      Generated bundles must not import Cloudflare SDK libraries directly.\n      DNS and TLS operations flow through the MozaiksCloud domain client,\n      not cloudflare-sdk.\n  - id: no_direct_provider_operations\n    rule: >\n      All deployment and domain operations must route through the bounded\n      MozaiksCloud sub-clients. Generated business code must not construct\n      raw HTTP calls to deployment, hosting, DNS, or TLS provider APIs.\n  - id: [REDACTED]\n    rule: >\n      Generated code contains only environment variable names\n      (MOZAIKS_CLOUD_API_KEY, MOZAIKS_CLOUD_API_BASE). Credential values\n      are resolved at runtime through ConnectorStore or env fallback.\n      No API key values appear in generated source.\n  - id: no_provision_on_import\n    rule: >\n      Importing or constructing any MozaiksCloud sub-client must not provision,\n      create, or modify external infrastructure. Side effects are confined to\n      explicit authorized API method calls.\n  - id: page_bindings\n    rule: >\n      Generated pages must call app-owned cloud_deployment and cloud_domain\n      facade actions, not Mozaiks Cloud platform API endpoints directly.\n\nfacades:\n  - module_id: cloud_deployment\n    provider_module: mozaiks_cloud\n    provider_actions:\n      - submit_deployment\n      - get_deployment_status\n      - get_environment_endpoints\n      - get_deployment_health\n      - request_rollback\n    pages:\n      - name: Deployments\n        route: /deployments\n        page_type_hint: list_detail\n        primary_entities:\n          - deployment_operation\n        primary_actions:\n          - submit_deployment\n          - get_deployment_status\n          - request_rollback\n  - module_id: cloud_domain\n    provider_module: mozaiks_cloud\n    provider_actions:\n      - connect_domain\n      - get_domain_verification\n      - get_dns_instructions\n      - request_domain_activation\n      - get_domain_status\n      - disconnect_domain\n    pages:\n      - name: Domains\n        route: /domains\n        page_type_hint: list_detail\n        primary_entities:\n          - domain_connection\n        primary_actions:\n          - connect_domain\n          - get_domain_status\n          - disconnect_domain\n\nprovider_api_response_contract:\n  spec_file: provider_api_contract.yaml\n  description: >\n    A Mozaiks Cloud-compatible provider serves the deployment and domain API\n    endpoints consumed by generated apps. Response shapes are pinned in\n    provider_api_contract.yaml. Any change to field names or types on either\n    side is a breaking change requiring coordinated release. Generated apps use\n    polling-only operation status and do not expose provider callback routes.\n  operation_required_fields:\n    - operation_id\n    - status\n    - created_at\n  deployment_status_required_fields:\n    - operation_id\n    - status\n    - environment\n    - release_ref\n    - created_at\n  environment_endpoints_required_fields:\n    - environment\n    - endpoints\n  domain_status_required_fields:\n    - domain\n    - status\n    - dns_verified\n    - tls_status\n    - created_at\n  dns_instructions_required_fields:\n    - domain\n    - records\n  globally_forbidden_response_fields:\n    - azure_resource_id\n    - azure_subscription_id\n    - azure_resource_group\n    - azure_tenant_id\n    - cloudflare_account_id\n    - cloudflare_zone_id\n    - cloudflare_api_token\n    - github_installation_id\n    - github_token\n    - internal_pricing\n    - internal_margin\n    - provider_credentials\n    - ssl_private_key\n    - tls_private_key\n\ninactive_surfaces:\n  - domain_purchasing\n  - registrar_transfer\n  - domain_renewal\n  - generated_callback_routes\n  - provider_account_creation\n  - source_upload\n\n# ---------------------------------------------------------------------------\n# Provider lifecycle boundary \u2014 responsibilities owned by the Mozaiks Cloud-\n# compatible provider, not by the generated app. Generated apps never\n# implement cloud provisioning, DNS management, TLS provisioning, credential\n# issuance, deployment pipeline mechanics, or provider resource management.\n# ---------------------------------------------------------------------------\nprovider_lifecycle_boundary:\n  - id: no_provision_on_select\n    provider_role: mozaiks_cloud_compatible_provider\n    description: >\n      Selecting the mozaiks_cloud pack must not create or provision any external\n      infrastructure, DNS records, TLS certificates, deployment environments, or\n      cloud resources. Provisioning occurs only through explicit authorized API\n      operations after credentials are configured.\n  - id: [REDACTED]\n    provider_role: mozaiks_cloud_compatible_provider\n    description: >\n      The pack does not generate or distribute API keys. Users obtain credentials\n      from the Mozaiks Cloud portal and configure them through the app-scoped\n      mozaiks_cloud connector or MOZAIKS_CLOUD_API_KEY environment variable.\n  - id: provider_owns_infrastructure"},{"checksum":"sha256:1ad8905d1753a6b4b84316ce51f96d5df44e1ac318fc5836f8abd778d0cca966","chunk_id":"chunk_e0eeb2c183e7f829","end_line":265,"path":"build_context/mozaiks_cloud/contract.yaml","start_line":252,"symbol_ids":[],"text":"    provider_role: mozaiks_cloud_compatible_provider\n    description: >\n      Azure resources, Cloudflare zones, DNS records, TLS certificates, deployment\n      pipelines, rollback state, and environment provisioning are provider-owned.\n      Generated apps receive normalized status responses; they never see or store\n      provider-internal resource identifiers (azure_resource_id, cloudflare_zone_id,\n      github_installation_id, ssl_private_key, or equivalent).\n  - id: deployment_separation\n    provider_role: mozaiks_cloud_compatible_provider\n    description: >\n      Hosting and Domains are separate bounded sub-resources sharing only\n      transport and authentication. No god-client or cross-resource operation\n      must be generated. Provider implementations remain bounded by the\n      deployment client API and the domain client API independently."},{"checksum":"sha256:7b3dee3e204e5f26596d1c3ebcf944cf37a42d1651df3604493d5235428ff9c8","chunk_id":"chunk_b7ec1fc9bdd109bc","end_line":264,"path":"build_context/mozaiks_cloud/provider_api_contract.yaml","start_line":1,"symbol_ids":[],"text":"schema_version: mozaiks.provider_api_contract.v1\ncontract_id: mozaiks_cloud_provider_api\nprovider_id: mozaiks_cloud\nbase_path: /api/mozaiks-cloud/v1\ndescription: >\n  Public Mozaiks Cloud connector contract. Any provider, including a\n  custom/self-managed implementation, may satisfy this contract by exposing the\n  versioned endpoints, shared authentication rules, idempotency behavior,\n  normalized error envelope, and operation status model declared here.\napi_version:\n  header: X-MozaiksCloud-Api-Version\n  current: mozaiks.cloud.v1\n\nauth:\n  kind: managed_service_bearer\n  service: mozaiks_cloud\n  credential_reference: [REDACTED]\n  header: Authorization\n  scheme: Bearer\n  scopes:\n    read:\n      - cloud:read\n      - deployments:read\n      - domains:read\n    deploy:\n      - cloud:deploy\n      - deployments:write\n    rollback:\n      - cloud:rollback\n      - deployments:rollback\n    domains_write:\n      - domains:write\n    usage:\n      - cloud:usage\n      - cloud:deploy\n      - domains:manage\n    domains_manage:\n      - domains:manage\n\nidempotency:\n  header: Idempotency-Key\n  required_for_methods:\n    - POST\n    - DELETE\n  replay_behavior: same_key_same_scope_returns_original_operation_or_result\n  conflict_behavior: same_key_different_payload_returns_normalized_conflict_error\n\nerror_envelope:\n  success_shape:\n    success: true\n  error_shape:\n    success: false\n    error:\n      code: str\n      message: str\n      kind: auth_error | rate_limited | validation_error | not_found | conflict | provider_error | timeout | unsupported | unknown\n      retryable: bool\n      details: dict | null\n      correlation_id: str | null\n\noperation_status_model:\n  terminal_statuses:\n    - succeeded\n    - failed\n    - cancelled\n  fields:\n    operation_id: str\n    operation_type: str\n    status: pending | running | succeeded | failed | cancelled | rolling_back | activating\n    resource_type: deployment | domain | rollback\n    resource_id: str | null\n    app_id: str\n    target_environment: str | null\n    created_at: str\n    updated_at: str | null\n    completed_at: str | null\n    error: dict | null\n    result: dict | null\n\noperations:\n  - id: submit_deployment\n    status: supported\n    method: POST\n    path: /deployments\n    scope: cloud:deploy | deployments:write\n    request_model: SubmitDeploymentRequest\n    response_model: OperationAccepted\n    idempotency: required\n    async_behavior: returns operation_id; poll get_deployment_operation_status\n    internal_app_owner: app_registry.request_hosting -> hosting deployment pipeline\n    app_pr_208: implemented_same_path\n    app_pr_209: not_applicable\n\n  - id: get_deployment_operation_status\n    status: supported\n    method: GET\n    path: /operations/{operation_id}\n    scope: cloud:read | deployments:read\n    request_model: OperationStatusRequest\n    response_model: OperationStatus\n    idempotency: not_allowed\n    async_behavior: canonical polling endpoint for deployment and rollback operations\n    internal_app_owner: hosting deployment records\n    app_pr_208: implemented_same_path\n    app_pr_209: must_share_same_model_for_domain_operations\n\n  - id: get_environment_endpoints\n    status: supported\n    method: GET\n    path: /apps/{app_id}/endpoints\n    scope: cloud:read | deployments:read\n    request_model: EnvironmentEndpointsRequest\n    response_model: EnvironmentEndpoints\n    idempotency: not_allowed\n    async_behavior: synchronous read\n    internal_app_owner: app_registry deployment_manifest + hosting_url\n    app_pr_208: implemented_same_path\n    app_pr_209: not_applicable\n\n  - id: get_deployment_health\n    status: supported\n    method: GET\n    path: /deployments/{deployment_id}/health\n    scope: cloud:read | deployments:read\n    request_model: DeploymentHealthRequest\n    response_model: DeploymentHealth\n    idempotency: not_allowed\n    async_behavior: synchronous read\n    internal_app_owner: hosting deployment records\n    app_pr_208: implemented_same_path\n    app_pr_209: not_applicable\n\n  - id: request_rollback\n    status: supported\n    method: POST\n    path: /rollbacks\n    scope: cloud:rollback | deployments:rollback\n    request_model: RollbackRequest\n    response_model: OperationAccepted\n    idempotency: required\n    async_behavior: returns operation_id; poll get_deployment_operation_status\n    internal_app_owner: hosting.rollback_deployment\n    app_pr_208: implemented_same_path\n    app_pr_209: not_applicable\n\n  - id: connect_domain\n    status: supported_contract_pending_app_correction\n    method: POST\n    path: /domains\n    scope: domains:write | domains:manage\n    request_model: ConnectDomainRequest\n    response_model: OperationAcceptedWithDomainVerification\n    idempotency: required\n    async_behavior: returns operation_id and binding_id; poll get_domain_operation_status\n    internal_app_owner: domains binding + verification records; dns/ssl/hosting pipeline\n    app_pr_208: not_applicable\n    app_pr_209: implemented_wrong_base_path_and_wrong_auth\n\n  - id: get_domain_verification\n    status: supported_contract_pending_app_correction\n    method: GET\n    path: /domains/{binding_id}/verification\n    scope: domains:read | cloud:read\n    request_model: DomainBindingRequest\n    response_model: DomainVerification\n    idempotency: not_allowed\n    async_behavior: synchronous read\n    internal_app_owner: domains verification records\n    app_pr_208: not_applicable\n    app_pr_209: exposed_as_instructions_under_wrong_base_path\n\n  - id: get_dns_instructions\n    status: supported_contract_pending_app_correction\n    method: GET\n    path: /domains/{binding_id}/instructions\n    scope: domains:read | cloud:read\n    request_model: DomainBindingRequest\n    response_model: DnsInstructions\n    idempotency: not_allowed\n    async_behavior: synchronous read\n    internal_app_owner: domains + hosting public endpoint facts\n    app_pr_208: not_applicable\n    app_pr_209: implemented_wrong_base_path_and_wrong_auth\n\n  - id: check_domain_verification\n    status: supported_contract_pending_app_correction\n    method: POST\n    path: /domains/{binding_id}/verify\n    scope: domains:write | domains:manage\n    request_model: DomainVerificationCheckRequest\n    response_model: OperationAccepted\n    idempotency: required\n    async_behavior: returns operation_id; may complete immediately if already verified\n    internal_app_owner: domains DNS verification + hosted domain pipeline trigger\n    app_pr_208: not_applicable\n    app_pr_209: implemented_wrong_base_path_and_wrong_auth\n\n  - id: request_domain_activation\n    status: supported_contract_pending_app_correction\n    method: POST\n    path: /domains/{binding_id}/activate\n    scope: domains:manage\n    request_model: DomainActivationRequest\n    response_model: OperationAccepted\n    idempotency: required\n    async_behavior: returns operation_id; poll get_domain_operation_status\n    internal_app_owner: domains verified binding -> dns/ssl/hosting activation pipeline\n    app_pr_208: not_applicable\n    app_pr_209: implemented_wrong_base_path_and_wrong_auth\n\n  - id: get_domain_status\n    status: supported_contract_pending_app_correction\n    method: GET\n    path: /domains/{binding_id}\n    scope: domains:read | cloud:read\n    request_model: DomainBindingRequest\n    response_model: DomainStatus\n    idempotency: not_allowed\n    async_behavior: synchronous read\n    internal_app_owner: domains binding status + dns/tls normalized status\n    app_pr_208: not_applicable\n    app_pr_209: implemented_wrong_base_path_and_wrong_auth\n\n  - id: disconnect_domain\n    status: supported_contract_pending_app_correction\n    method: DELETE\n    path: /domains/{binding_id}\n    scope: domains:manage\n    request_model: DomainDisconnectRequest\n    response_model: OperationAccepted\n    idempotency: required\n    async_behavior: returns operation_id; poll get_domain_operation_status\n    internal_app_owner: domains binding lifecycle + operator cleanup event\n    app_pr_208: not_applicable\n    app_pr_209: implemented_wrong_base_path_and_wrong_auth\n\n  - id: report_usage_rollups\n    status: supported\n    method: POST\n    path: /usage/rollups\n    scope: cloud:usage | cloud:deploy\n    request_model: UsageRollupsRequest\n    response_model: UsageRollupsAccepted\n    idempotency: required\n    async_behavior: synchronous; the (app_id, granularity, period_start) upsert is naturally idempotent\n    internal_app_owner: [REDACTED] (app_id attributed from credentials)\n    app_pr_208: not_applicable\n    app_pr_209: not_applicable\n\nrequest_models:\n  UsageRollupsRequest:\n    required: [rollups]\n    fields:\n      rollups: \"list[{period_start: str YYYY-MM-DD, granularity: 'day', page_views: int, unique_sessions: int | null, action_invocations: int | null, active_users: int | null, events: dict[str, int] | null}] (max 31)\"\n  SubmitDeploymentRequest:\n    required: [app_id]\n    fields:\n      app_id: str\n      target_environment: str | null\n      release_ref: str | null\n  OperationStatusRequest:\n    required: [operation_id]\n    fields:\n      operation_id: str"},{"checksum":"sha256:c0dd26c2dc9a5d655ffaa9e9e683badcc073ec37c695c16e5d91ef491a7acdb1","chunk_id":"chunk_52ea83e229eefc3b","end_line":367,"path":"build_context/mozaiks_cloud/provider_api_contract.yaml","start_line":265,"symbol_ids":[],"text":"  EnvironmentEndpointsRequest:\n    required: [app_id]\n    fields:\n      app_id: str\n      target_environment: str | null\n  DeploymentHealthRequest:\n    required: [deployment_id]\n    fields:\n      deployment_id: str\n      app_id: str | null\n  RollbackRequest:\n    required: [target_release_id, approval_reference]\n    fields:\n      target_release_id: str\n      expected_current_deployment_id: str | null\n      target_environment: str | null\n      reason: str | null\n      approval_reference: str\n  ConnectDomainRequest:\n    required: [app_id, domain]\n    fields:\n      app_id: str\n      domain: str\n      target_environment: str | null\n  DomainBindingRequest:\n    required: [binding_id]\n    fields:\n      binding_id: str\n      tenant_id: str | null\n      app_id: str | null\n  DomainVerificationCheckRequest:\n    required: [binding_id]\n    fields:\n      binding_id: str\n      tenant_id: str | null\n      app_id: str | null\n  DomainActivationRequest:\n    required: [binding_id]\n    fields:\n      binding_id: str\n      tenant_id: str | null\n      app_id: str | null\n  DomainDisconnectRequest:\n    required: [binding_id]\n    fields:\n      binding_id: str\n      tenant_id: str | null\n      app_id: str | null\n\nresponse_models:\n  UsageRollupsAccepted:\n    fields:\n      success: bool\n      app_id: \"str (from credentials, never from payload)\"\n      accepted: int\n      rejected: \"list[{index: int, code: str}]\"\n  OperationAccepted:\n    required: [success, operation]\n    operation_ref: operation_status_model\n  OperationAcceptedWithDomainVerification:\n    required: [success, operation, binding_id, verification]\n  EnvironmentEndpoints:\n    required: [success, app_id, endpoints]\n  DeploymentHealth:\n    required: [success, deployment, health]\n  DomainVerification:\n    required: [success, binding_id, domain, verification]\n  DnsInstructions:\n    required: [success, binding_id, domain, records]\n  DomainStatus:\n    required: [success, binding_id, domain, status, dns_status, tls_status]\n\nunsupported_operations:\n  - domain_registration\n  - domain_purchase\n  - registrar_transfer\n  - dns_zone_creation\n  - dns_zone_deletion\n  - custom_certificate_upload\n  - generated_callback_receiver\n  - provider_account_creation\n  - source_code_upload\n\ncallbacks:\n  generated_app_callback_routes: unsupported\n  provider_to_app_events: unsupported\n  polling_contract: use_operations_endpoint\n  replay_contract: providers must deduplicate mutating requests by Idempotency-Key\n\ndrift_guard:\n  forbidden_response_fields:\n    - azure_resource_id\n    - azure_subscription_id\n    - azure_resource_group\n    - azure_tenant_id\n    - cloudflare_account_id\n    - cloudflare_zone_id\n    - cloudflare_api_token\n    - github_installation_id\n    - github_token\n    - provider_credentials\n    - ssl_private_key\n    - tls_private_key"},{"checksum":"sha256:f01d9edb5e2ee9e9d3ec2fc567fc136cbfc67150352ebe5eee41f2995da917e5","chunk_id":"chunk_eb10a6d435469732","end_line":25,"path":"build_context/mozaiks_cloud/templates/modules/cloud_deployment/backend/handler.py","start_line":1,"symbol_ids":["sym_7093e55b22dff6c7","sym_ee9de1d09f447b89","sym_d7c68c7eeada1431","sym_eb0b4e790acd2e61","sym_aa61fa6c2f088c4d","sym_d5d20dbf680ea41a","sym_cf1cbfc8c64e0049"],"text":"from __future__ import annotations\n\nfrom typing import Any\n\nfrom .service import CloudDeploymentService\n\n\nclass CloudDeploymentHandler:\n    def __init__(self) -> None:\n        self._service = CloudDeploymentService()\n\n    async def submit_deployment(self, ctx: Any, **params: Any) -> dict[str, Any]:\n        return await self._service.submit_deployment(ctx, **params)\n\n    async def get_deployment_status(self, ctx: Any, **params: Any) -> dict[str, Any]:\n        return await self._service.get_deployment_status(ctx, **params)\n\n    async def get_environment_endpoints(self, ctx: Any, **params: Any) -> dict[str, Any]:\n        return await self._service.get_environment_endpoints(ctx, **params)\n\n    async def get_deployment_health(self, ctx: Any, **params: Any) -> dict[str, Any]:\n        return await self._service.get_deployment_health(ctx, **params)\n\n    async def request_rollback(self, ctx: Any, **params: Any) -> dict[str, Any]:\n        return await self._service.request_rollback(ctx, **params)"},{"checksum":"sha256:84e1a25ac8aaabe003c99348b2a3d6a387ac1cf3a65b0da44bcbc0dec1bdea87","chunk_id":"chunk_dadba66f9633ec7c","end_line":62,"path":"build_context/mozaiks_cloud/templates/modules/cloud_deployment/backend/service.py","start_line":1,"symbol_ids":["sym_844dde57efad83c6","sym_82c124148e349ef9","sym_e2fb56e079106c7d","sym_ce47cca572afb5a4","sym_f20809975b909b60","sym_044723710ec42eb2","sym_f03d0eb45d2397cc","sym_8b9cc33b578ca11b","sym_27e769e10e74296c"],"text":"from __future__ import annotations\n\nfrom typing import Any\n\nfrom services.integrations.mozaiks_cloud_client import MozaiksCloudTransport\nfrom services.integrations.mozaiks_cloud_deployment_client import (\n    MozaiksCloudDeploymentClient,\n)\n\n\ndef _clean(value: Any) -> str:\n    return str(value or \"\").strip()\n\n\ndef _require(value: Any, field: str) -> str:\n    cleaned = _clean(value)\n    if not cleaned:\n        raise ValueError(f\"{field} is required\")\n    return cleaned\n\n\nclass CloudDeploymentService:\n    def _client(self, *, app_id: str | None = None) -> MozaiksCloudDeploymentClient:\n        return MozaiksCloudDeploymentClient(MozaiksCloudTransport(app_id=app_id))\n\n    async def submit_deployment(self, ctx: Any, **params: Any) -> dict[str, Any]:\n        del ctx\n        app_id = _require(params.get(\"app_id\"), \"app_id\")\n        return await self._client(app_id=app_id).submit_deployment_request(\n            app_id=app_id,\n            target_environment=_clean(params.get(\"target_environment\")) or \"production\",\n            release_ref=_clean(params.get(\"release_ref\")) or None,\n            idempotency_key=_require(params.get(\"idempotency_key\"), \"idempotency_key\"),\n        )\n\n    async def get_deployment_status(self, ctx: Any, **params: Any) -> dict[str, Any]:\n        del ctx\n        return await self._client(app_id=_clean(params.get(\"app_id\")) or None).get_operation_status(\n            operation_id=_require(params.get(\"operation_id\"), \"operation_id\"),\n        )\n\n    async def get_environment_endpoints(self, ctx: Any, **params: Any) -> dict[str, Any]:\n        del ctx\n        app_id = _require(params.get(\"app_id\"), \"app_id\")\n        return await self._client(app_id=app_id).get_environment_endpoints(app_id=app_id)\n\n    async def get_deployment_health(self, ctx: Any, **params: Any) -> dict[str, Any]:\n        del ctx\n        return await self._client(app_id=_clean(params.get(\"app_id\")) or None).get_deployment_health(\n            deployment_id=_require(params.get(\"deployment_id\"), \"deployment_id\"),\n        )\n\n    async def request_rollback(self, ctx: Any, **params: Any) -> dict[str, Any]:\n        del ctx\n        return await self._client(app_id=_clean(params.get(\"app_id\")) or None).request_rollback(\n            target_release_id=_require(params.get(\"target_release_id\"), \"target_release_id\"),\n            expected_current_deployment_id=_clean(params.get(\"expected_current_deployment_id\")) or None,\n            target_environment=_clean(params.get(\"target_environment\")) or \"production\",\n            reason=_clean(params.get(\"reason\")) or None,\n            approval_reference=_require(params.get(\"approval_reference\"), \"approval_reference\"),\n            idempotency_key=_require(params.get(\"idempotency_key\"), \"idempotency_key\"),\n        )"},{"checksum":"sha256:ef4ff0eea3d9cb3637d533fba22f452213c7e15d2e22fccb2fe3b99b4dcc106d","chunk_id":"chunk_d30bd3eee1033cb0","end_line":70,"path":"build_context/mozaiks_cloud/templates/modules/cloud_deployment/module.yaml","start_line":1,"symbol_ids":[],"text":"schema_version: mozaiks.module.v1\nmodule:\n  id: cloud_deployment\n  label: Cloud Deployment\n  description: >\n    Facade module for Mozaiks Cloud deployment and environment operations.\n    Submits, monitors, and manages app deployment lifecycle through the Mozaiks\n    Cloud managed platform. All operations are app-owned; provider internals\n    (Azure resource IDs, pipeline configuration, credential material) are never\n    exposed to the generated app.\n  capability_source: managed_capability\n  provider: mozaiks_cloud\n\npermissions:\n  - id: cloud_deployment.read\n    label: View deployment status and environment endpoints\n  - id: cloud_deployment.write\n    label: Submit deployments and request rollbacks\n\nactions:\n  - id: submit_deployment\n    label: Submit Deployment\n    handler_method: submit_deployment\n    api_surface: internal\n    permissions:\n      - cloud_deployment.write\n    description: >\n      Submit an authorized deployment/release request to Mozaiks Cloud.\n      Requires cloud_deployment.write permission.\n\n  - id: get_deployment_status\n    label: Get Deployment Status\n    handler_method: get_deployment_status\n    api_surface: public_readonly\n    permissions:\n      - cloud_deployment.read\n    description: >\n      Retrieve normalized deployment operation status by operation_id.\n      Status values: pending, running, succeeded, failed, cancelled, rolling_back.\n\n  - id: get_environment_endpoints\n    label: Get Environment Endpoints\n    handler_method: get_environment_endpoints\n    api_surface: public_readonly\n    permissions:\n      - cloud_deployment.read\n    description: >\n      Retrieve normalized environment endpoints for the app.\n      Each endpoint has url, kind, and optional region.\n      Provider-internal resource IDs are never returned.\n\n  - id: get_deployment_health\n    label: Get Deployment Health\n    handler_method: get_deployment_health\n    api_surface: public_readonly\n    permissions:\n      - cloud_deployment.read\n    description: >\n      Retrieve sanitized deployment health for a provider-owned deployment.\n      Provider-internal resource IDs and raw build logs are never returned.\n\n  - id: request_rollback\n    label: Request Rollback\n    handler_method: request_rollback\n    api_surface: internal\n    permissions:\n      - cloud_deployment.write\n    description: >\n      Request rollback of a deployment to a previous release through\n      an explicitly authorized operation. Requires cloud_deployment.write permission."},{"checksum":"sha256:cbeeb58ac542cf56015601da2dfc438e8548884d54f2567ba52b6cd76433ac5f","chunk_id":"chunk_8cadc0908e74344b","end_line":28,"path":"build_context/mozaiks_cloud/templates/modules/cloud_domain/backend/handler.py","start_line":1,"symbol_ids":["sym_ec896c7d3464d6de","sym_13102e07d34fefd6","sym_28159ac26a643248","sym_22874678cbd8ac3f","sym_d0d030561fa2fc10","sym_a459c040e74734b9","sym_f5074d8ca6e806a4","sym_6885f5c81a61e02f"],"text":"from __future__ import annotations\n\nfrom typing import Any\n\nfrom .service import CloudDomainService\n\n\nclass CloudDomainHandler:\n    def __init__(self) -> None:\n        self._service = CloudDomainService()\n\n    async def connect_domain(self, ctx: Any, **params: Any) -> dict[str, Any]:\n        return await self._service.connect_domain(ctx, **params)\n\n    async def get_domain_verification(self, ctx: Any, **params: Any) -> dict[str, Any]:\n        return await self._service.get_domain_verification(ctx, **params)\n\n    async def get_dns_instructions(self, ctx: Any, **params: Any) -> dict[str, Any]:\n        return await self._service.get_dns_instructions(ctx, **params)\n\n    async def request_domain_activation(self, ctx: Any, **params: Any) -> dict[str, Any]:\n        return await self._service.request_domain_activation(ctx, **params)\n\n    async def get_domain_status(self, ctx: Any, **params: Any) -> dict[str, Any]:\n        return await self._service.get_domain_status(ctx, **params)\n\n    async def disconnect_domain(self, ctx: Any, **params: Any) -> dict[str, Any]:\n        return await self._service.disconnect_domain(ctx, **params)"},{"checksum":"sha256:500ed53a0cff201d11a24929d26f343f69e630e0e2a6ace874883f991450e6b0","chunk_id":"chunk_050ac170c5930ad1","end_line":74,"path":"build_context/mozaiks_cloud/templates/modules/cloud_domain/backend/service.py","start_line":1,"symbol_ids":["sym_52900c500d4b07fb","sym_2848a27e807b705d","sym_2acfe7df2e193668","sym_859f6fad2c8a8ab2","sym_a5d7cc3ee9a8a0a1","sym_c7de961893004c7c","sym_1e3a96709a9e9bcb","sym_bb3708fc7897a41b","sym_0029a7472dd7b326","sym_0cfd1bf3a8700508"],"text":"from __future__ import annotations\n\nfrom typing import Any\n\nfrom services.integrations.mozaiks_cloud_client import MozaiksCloudTransport\nfrom services.integrations.mozaiks_cloud_domain_client import MozaiksCloudDomainClient\n\n\ndef _clean(value: Any) -> str:\n    return str(value or \"\").strip()\n\n\ndef _require(value: Any, field: str) -> str:\n    cleaned = _clean(value)\n    if not cleaned:\n        raise ValueError(f\"{field} is required\")\n    return cleaned\n\n\nclass CloudDomainService:\n    def _client(self, *, app_id: str | None = None) -> MozaiksCloudDomainClient:\n        return MozaiksCloudDomainClient(MozaiksCloudTransport(app_id=app_id))\n\n    async def connect_domain(self, ctx: Any, **params: Any) -> dict[str, Any]:\n        del ctx\n        app_id = _require(params.get(\"app_id\"), \"app_id\")\n        return await self._client(app_id=app_id).connect_domain(\n            app_id=app_id,\n            domain=_require(params.get(\"domain\"), \"domain\"),\n            target_environment=_clean(params.get(\"target_environment\")) or \"production\",\n            idempotency_key=_require(params.get(\"idempotency_key\"), \"idempotency_key\"),\n        )\n\n    async def get_domain_verification(self, ctx: Any, **params: Any) -> dict[str, Any]:\n        del ctx\n        return await self._client(app_id=_clean(params.get(\"app_id\")) or None).get_domain_verification(\n            binding_id=_require(params.get(\"binding_id\"), \"binding_id\"),\n            tenant_id=_clean(params.get(\"tenant_id\")) or None,\n            app_id=_clean(params.get(\"app_id\")) or None,\n        )\n\n    async def get_dns_instructions(self, ctx: Any, **params: Any) -> dict[str, Any]:\n        del ctx\n        return await self._client(app_id=_clean(params.get(\"app_id\")) or None).get_dns_instructions(\n            binding_id=_require(params.get(\"binding_id\"), \"binding_id\"),\n            tenant_id=_clean(params.get(\"tenant_id\")) or None,\n            app_id=_clean(params.get(\"app_id\")) or None,\n        )\n\n    async def request_domain_activation(self, ctx: Any, **params: Any) -> dict[str, Any]:\n        del ctx\n        return await self._client(app_id=_clean(params.get(\"app_id\")) or None).request_domain_activation(\n            binding_id=_require(params.get(\"binding_id\"), \"binding_id\"),\n            tenant_id=_require(params.get(\"tenant_id\"), \"tenant_id\"),\n            app_id=_require(params.get(\"app_id\"), \"app_id\"),\n            idempotency_key=_require(params.get(\"idempotency_key\"), \"idempotency_key\"),\n        )\n\n    async def get_domain_status(self, ctx: Any, **params: Any) -> dict[str, Any]:\n        del ctx\n        return await self._client(app_id=_clean(params.get(\"app_id\")) or None).get_domain_status(\n            binding_id=_require(params.get(\"binding_id\"), \"binding_id\"),\n            tenant_id=_clean(params.get(\"tenant_id\")) or None,\n            app_id=_clean(params.get(\"app_id\")) or None,\n        )\n\n    async def disconnect_domain(self, ctx: Any, **params: Any) -> dict[str, Any]:\n        del ctx\n        return await self._client(app_id=_clean(params.get(\"app_id\")) or None).disconnect_domain(\n            binding_id=_require(params.get(\"binding_id\"), \"binding_id\"),\n            tenant_id=_require(params.get(\"tenant_id\"), \"tenant_id\"),\n            app_id=_require(params.get(\"app_id\"), \"app_id\"),\n            idempotency_key=_require(params.get(\"idempotency_key\"), \"idempotency_key\"),\n        )"},{"checksum":"sha256:a66a8abad52d0c3ee2591c3f079c4daf79606a9c5a9c546fa3cb73fc4416d833","chunk_id":"chunk_47a715205d790504","end_line":80,"path":"build_context/mozaiks_cloud/templates/modules/cloud_domain/module.yaml","start_line":1,"symbol_ids":[],"text":"schema_version: mozaiks.module.v1\nmodule:\n  id: cloud_domain\n  label: Cloud Domain Management\n  description: >\n    Facade module for Mozaiks Cloud domain operations. Connects, verifies,\n    activates, and disconnects custom domains with normalized DNS and TLS\n    status display. All operations are app-owned; provider DNS/TLS internals\n    (Cloudflare zone IDs, certificate material, registrar configuration) are\n    never exposed to the generated app.\n  capability_source: managed_capability\n  provider: mozaiks_cloud\n\npermissions:\n  - id: cloud_domain.read\n    label: View domain status and DNS instructions\n  - id: cloud_domain.manage\n    label: Connect, activate, and disconnect domains\n\nactions:\n  - id: connect_domain\n    label: Connect Domain\n    handler_method: connect_domain\n    api_surface: internal\n    permissions:\n      - cloud_domain.manage\n    description: >\n      Connect an existing domain to the app via Mozaiks Cloud.\n      Requires cloud_domain.manage permission.\n\n  - id: get_domain_verification\n    label: Get Domain Verification\n    handler_method: get_domain_verification\n    api_surface: public_readonly\n    permissions:\n      - cloud_domain.read\n    description: >\n      Request ownership verification status and verification records for display.\n      Each record has type, name, value, and optional ttl.\n\n  - id: get_dns_instructions\n    label: Get DNS Instructions\n    handler_method: get_dns_instructions\n    api_surface: public_readonly\n    permissions:\n      - cloud_domain.read\n    description: >\n      Retrieve DNS configuration instructions for the domain.\n      Records are for display only; the Mozaiks Cloud provider applies DNS changes.\n\n  - id: request_domain_activation\n    label: Activate Domain\n    handler_method: request_domain_activation\n    api_surface: internal\n    permissions:\n      - cloud_domain.manage\n    description: >\n      Request domain activation after ownership verification.\n      Requires cloud_domain.manage permission.\n\n  - id: get_domain_status\n    label: Get Domain Status\n    handler_method: get_domain_status\n    api_surface: public_readonly\n    permissions:\n      - cloud_domain.read\n    description: >\n      Retrieve DNS and TLS status for a connected domain.\n      Domain status: pending_verification | verified | activating | active | failed | disconnected\n      TLS status: pending | provisioning | active | failed\n\n  - id: disconnect_domain\n    label: Disconnect Domain\n    handler_method: disconnect_domain\n    api_surface: internal\n    permissions:\n      - cloud_domain.manage\n    description: >\n      Disconnect a domain from the app.\n      Requires cloud_domain.manage permission."},{"checksum":"sha256:05282ce556bfc60027354e820bb1ac9c7f8f7af997776bb81cd8dfb0242804f9","chunk_id":"chunk_1d6cd8a31a1ecbee","end_line":22,"path":"build_context/mozaiks_cloud/templates/modules/cloud_usage_reporter/backend/handler.py","start_line":1,"symbol_ids":["sym_df9a4a42ae59d941","sym_28add1dc62bcf235"],"text":"from __future__ import annotations\n\nimport os\nfrom typing import Any\n\n\nclass CloudUsageReporterHandler:\n\n    async def get_reporter_status(self, ctx, **_: Any) -> dict[str, Any]:\n        from app.services.integrations.mozaiks_cloud_usage_client import (\n            MozaiksCloudUsageClient,\n        )\n\n        enabled = str(\n            os.environ.get(\"MOZAIKS_CLOUD_USAGE_REPORTING\", \"\")\n        ).strip().lower() not in {\"0\", \"false\", \"no\", \"off\"}\n        configured = await MozaiksCloudUsageClient().is_configured()\n        return {\n            \"enabled\": enabled,\n            \"configured\": configured,\n            \"reporting\": enabled and configured,\n        }"},{"checksum":"sha256:7189018ed597161f9f007675d558b3edde5882b2b9c2624c0a45d159096ba782","chunk_id":"chunk_896c9735bfb759b7","end_line":126,"path":"build_context/mozaiks_cloud/templates/modules/cloud_usage_reporter/backend/reporter.py","start_line":1,"symbol_ids":["sym_9ddda5a4e4698fe0","sym_91bbcb7f831151de","sym_51bbf16b55317407","sym_851c94165ec5e177","sym_a5d9ef77be994bf6","sym_500a7e3241fd33be","sym_e56b04b397053b8c","sym_06ce3adcc87a1cbb","sym_fc693f1b601dd17a"],"text":"\"\"\"UsageReporterService \u2014 periodic usage-rollup reporting startup service.\n\nEvery interval (MOZAIKS_CLOUD_USAGE_REPORT_INTERVAL_SECONDS, default 3600),\nrolls up the app's own AppMetrics usage instrumentation for today and\nyesterday and posts the daily aggregates through MozaiksCloudUsageClient.\nThe receiving end upserts by (app_id, period_start), so re-sending a\npartial day simply overwrites it with the fuller count.\n\nOff switches, in order:\n- No mozaiks_cloud connector / MOZAIKS_CLOUD_* configuration \u2192 silently idle\n  (checked every cycle, so configuring later needs no restart).\n- MOZAIKS_CLOUD_USAGE_REPORTING=0 \u2192 hard off.\n\nAggregate counts only. No per-user or per-session records leave the app.\n\"\"\"\nfrom __future__ import annotations\n\nimport asyncio\nimport logging\nimport os\nimport uuid\nfrom datetime import UTC, datetime, timedelta\nfrom types import SimpleNamespace\n\nlogger = logging.getLogger(\"app.cloud_usage_reporter\")\n\n_DISABLED_VALUES = {\"0\", \"false\", \"no\", \"off\"}\n_INITIAL_DELAY_SECONDS = 90\n\n\ndef _interval_seconds() -> int:\n    try:\n        return max(\n            300,\n            int(os.environ.get(\"MOZAIKS_CLOUD_USAGE_REPORT_INTERVAL_SECONDS\", \"3600\")),\n        )\n    except ValueError:\n        return 3600\n\n\ndef _reporting_enabled() -> bool:\n    value = str(os.environ.get(\"MOZAIKS_CLOUD_USAGE_REPORTING\", \"\")).strip().lower()\n    return value not in _DISABLED_VALUES\n\n\ndef _app_id() -> str:\n    return str(os.environ.get(\"MOZAIKS_APP_ID\", \"\") or \"default\").strip() or \"default\"\n\n\nclass UsageReporterService:\n    \"\"\"Process-lifetime startup service posting daily usage rollups.\"\"\"\n\n    def __init__(self) -> None:\n        self._running = False\n        self._task: asyncio.Task | None = None\n        self.last_report_at: str | None = None\n        self.last_error: str | None = None\n\n    def start(self) -> None:\n        self._running = True\n        if not _reporting_enabled():\n            logger.info(\"CLOUD_USAGE_REPORTER_DISABLED: MOZAIKS_CLOUD_USAGE_REPORTING=0\")\n            return\n        try:\n            loop = asyncio.get_event_loop()\n        except RuntimeError:\n            loop = asyncio.new_event_loop()\n            asyncio.set_event_loop(loop)\n        self._task = loop.create_task(self._run_loop())\n        logger.info(\n            \"CLOUD_USAGE_REPORTER_STARTED: interval=%ss\", _interval_seconds()\n        )\n\n    def stop(self) -> None:\n        self._running = False\n        if self._task is not None:\n            self._task.cancel()\n            self._task = None\n        logger.info(\"CLOUD_USAGE_REPORTER_STOPPED\")\n\n    async def _run_loop(self) -> None:\n        try:\n            await asyncio.sleep(_INITIAL_DELAY_SECONDS)\n        except asyncio.CancelledError:\n            return\n        while self._running:\n            try:\n                await self.report_once()\n            except Exception as exc:\n                self.last_error = str(exc)[:300]\n                logger.warning(\"CLOUD_USAGE_REPORTER_ERROR: %s\", exc)\n            try:\n                await asyncio.sleep(_interval_seconds())\n            except asyncio.CancelledError:\n                break\n\n    async def report_once(self) -> dict:\n        from app.services.integrations.mozaiks_cloud_usage_client import (\n            MozaiksCloudUsageClient,\n        )\n        from mozaiksai.core.metrics.app_metrics import AppMetrics\n\n        client = MozaiksCloudUsageClient()\n        if not await client.is_configured():\n            return {\"sent\": 0, \"reason\": \"unconfigured\"}\n\n        since = (datetime.now(UTC) - timedelta(days=2)).replace(\n            hour=0, minute=0, second=0, microsecond=0\n        )\n        metrics = AppMetrics(SimpleNamespace(app_id=_app_id()))\n        rollups = await metrics.usage_rollup(since=since)\n        if not rollups:\n            return {\"sent\": 0, \"reason\": \"no_usage\"}\n\n        result = await client.post_usage_rollups(\n            rollups,\n            idempotency_key=f\"usage_{uuid.uuid4().hex}\",\n        )\n        self.last_report_at = datetime.now(UTC).isoformat()\n        self.last_error = None\n        logger.info(\n            \"CLOUD_USAGE_REPORTER_SENT: rollups=%d accepted=%s\",\n            len(rollups),\n            (result or {}).get(\"accepted\"),\n        )\n        return {\"sent\": len(rollups), \"result\": result}"},{"checksum":"sha256:9426052993aae87df1d104379526a5657b00bc3a5f5d609c74b3d5d85c70d378","chunk_id":"chunk_2a4bd91dd48ce83a","end_line":29,"path":"build_context/mozaiks_cloud/templates/modules/cloud_usage_reporter/module.yaml","start_line":1,"symbol_ids":[],"text":"schema_version: mozaiks.module.v1\nmodule:\n  id: cloud_usage_reporter\n  label: Cloud Usage Reporter\n  description: >\n    Periodically rolls up the app's own AppMetrics usage instrumentation\n    (page views, sessions, action invocations) into daily aggregate counts\n    and reports them to the configured Mozaiks Cloud-compatible operator\n    endpoint. Sink-agnostic: silently idle when no mozaiks_cloud connector\n    or MOZAIKS_CLOUD_* configuration exists \u2014 the app never phones home by\n    default. Aggregate counts only; no per-user or per-session data leaves\n    the app.\n  capability_source: managed_capability\n  provider: mozaiks_cloud\n\npermissions:\n  - id: cloud_usage_reporter.read\n    label: View usage reporting status\n\nactions:\n  - id: get_reporter_status\n    label: Get Usage Reporter Status\n    handler_method: get_reporter_status\n    api_surface: public_readonly\n    permissions:\n      - cloud_usage_reporter.read\n    description: >\n      Report whether usage reporting is configured/enabled and when the last\n      report was sent."},{"checksum":"sha256:9572db0bcc29884f0679534e72c8998456379da106bb0d3141f9e8c740e7d483","chunk_id":"chunk_32a0a62ff1839a62","end_line":4,"path":"build_context/mozaiks_cloud/templates/modules/cloud_usage_reporter/runtime_extensions.yaml","start_line":1,"symbol_ids":[],"text":"schema_version: mozaiks.runtime_extensions.v1\nextensions:\n  - kind: startup_service\n    entrypoint: backend.reporter:UsageReporterService"},{"checksum":"sha256:a471380afdb954d477228e9c5b76747c3d50c04304e2c1427eb1f7fa25b33d61","chunk_id":"chunk_a506087511b7be84","end_line":235,"path":"build_context/mozaiks_cloud/templates/services/integrations/mozaiks_cloud_client.py","start_line":1,"symbol_ids":["sym_a37dbdea9aa84b2b","sym_5a00dd8144a55c9e","sym_559ebba22d8bc1cd","sym_9fccdac16537e92b","sym_334a9f22a89c1ca6","sym_61025d8b79c6a4bc","sym_d524bb3311d17bf8","sym_dd158fbb0dd03e1c","sym_46a102609cabe838","sym_3f6520a399c0cece","sym_3843114904c9feb0","sym_db3c4b315bb2e9a5","sym_4df8145b503b51dd","sym_4f9f6c302179ffa7"],"text":"from __future__ import annotations\n\nimport os\nfrom dataclasses import dataclass\nfrom typing import Any\n\nimport httpx\n\n_CONNECTOR_SERVICE = \"mozaiks_cloud\"\n_DEFAULT_TIMEOUT = 20.0\n_DEFAULT_MAX_RETRIES = 2\n_PROVIDER_API_PREFIX = \"/api/mozaiks-cloud/v1\"\n_API_VERSION = \"mozaiks.cloud.v1\"\n_RETRYABLE_STATUS_CODES = {408, 429, 500, 502, 503, 504}\n_ERROR_KIND_BY_STATUS = {\n    400: \"validation_error\",\n    401: \"auth_error\",\n    403: \"auth_error\",\n    404: \"not_found\",\n    409: \"conflict\",\n    422: \"validation_error\",\n    429: \"rate_limited\",\n}\n\n\nclass MozaiksCloudError(Exception):\n    \"\"\"Base error raised by Mozaiks Cloud integration clients.\"\"\"\n\n\nclass MozaiksCloudConfigurationError(MozaiksCloudError):\n    \"\"\"Raised when the Mozaiks Cloud connector is not configured.\"\"\"\n\n\nclass MozaiksCloudHTTPError(MozaiksCloudError):\n    def __init__(\n        self,\n        status_code: int,\n        *,\n        code: str = \"unknown\",\n        message: str = \"\",\n        kind: str = \"unknown\",\n        retryable: bool = False,\n        details: dict[str, Any] | None = None,\n    ) -> None:\n        self.status_code = status_code\n        self.code = code\n        self.kind = kind\n        self.retryable = retryable\n        self.details = details or {}\n        super().__init__(f\"Mozaiks Cloud HTTP {status_code} [{code}]: {message}\")\n\n\n@dataclass(frozen=True)\nclass MozaiksCloudConnectorSettings:\n    api_base: str | None = None\n    api_key: [REDACTED] | None = [REDACTED]\n    app_id: str | None = None\n    source: str = \"unconfigured\"\n\n\ndef _clean(value: Any) -> str:\n    return str(value or \"\").strip()\n\n\ndef _env_settings() -> MozaiksCloudConnectorSettings:\n    return MozaiksCloudConnectorSettings(\n        api_base=_clean(os.getenv(\"MOZAIKS_CLOUD_API_BASE\")) or None,\n        api_key=[REDACTED]\"MOZAIKS_CLOUD_API_KEY\")) or None,\n        app_id=_clean(os.getenv(\"MOZAIKS_CLOUD_APP_ID\")) or None,\n        source=\"env\",\n    )\n\n\nasync def _load_connector_settings(app_id: str | None = None) -> MozaiksCloudConnectorSettings | None:\n    if not app_id:\n        return None\n    try:\n        from mozaiksai.core.data.persistence.connector_store import ConnectorStore\n        from mozaiksai.core.secrets import get_connector_vault_backend\n\n        record = await ConnectorStore().get(\n            scope=ConnectorStore.SCOPE_APP,\n            scope_id=str(app_id),\n            service=_CONNECTOR_SERVICE,\n        )\n        if not isinstance(record, dict):\n            return None\n        public_config = record.get(\"public_config\") if isinstance(record.get(\"public_config\"), dict) else {}\n        secret_result = [REDACTED] get_connector_vault_backend().get_secret(\n            scope_id=str(app_id),\n            service=_CONNECTOR_SERVICE,\n        )\n        credential = [REDACTED]\"secret_value\")) if isinstance(secret_result, dict) else \"\"\n        api_base = _clean(public_config.get(\"api_base\")) or None\n        cloud_app_id = _clean(public_config.get(\"app_id\")) or None\n        if not api_base and not credential:\n            return None\n        return MozaiksCloudConnectorSettings(\n            api_base=api_base,\n            api_key=[REDACTED] or None,\n            app_id=cloud_app_id,\n            source=\"connector\",\n        )\n    except Exception:\n        return None\n\n\ndef _authorization_header(value: str) -> str:\n    return value if value.lower().startswith(\"bearer \") else f\"Bearer {value}\"\n\n\ndef _error_from_response(status_code: int, body: dict[str, Any]) -> MozaiksCloudHTTPError:\n    raw_error = body.get(\"error\") if isinstance(body, dict) else None\n    envelope = raw_error if isinstance(raw_error, dict) else {}\n    code = _clean(envelope.get(\"code\") or body.get(\"error_code\") or body.get(\"code\") or \"unknown\")\n    message = _clean(envelope.get(\"message\") or body.get(\"detail\") or body.get(\"error\") or \"\")\n    kind = _clean(envelope.get(\"kind\") or body.get(\"error_kind\") or _ERROR_KIND_BY_STATUS.get(status_code))\n    if not kind and status_code >= 500:\n        kind = \"provider_error\"\n    if not kind:\n        kind = \"unknown\"\n    retryable = bool(envelope.get(\"retryable\")) or status_code in _RETRYABLE_STATUS_CODES\n    details = envelope.get(\"details\") if isinstance(envelope.get(\"details\"), dict) else None\n    return MozaiksCloudHTTPError(\n        status_code,\n        code=code,\n        message=message,\n        kind=kind,\n        retryable=retryable,\n        details=details,\n    )\n\n\nclass MozaiksCloudTransport:\n    def __init__(\n        self,\n        api_base: str | None = None,\n        api_key: [REDACTED] | None = [REDACTED]\n        app_id: str | None = None,\n        timeout_seconds: float = _DEFAULT_TIMEOUT,\n        max_retries: int = _DEFAULT_MAX_RETRIES,\n        connector_settings_loader: Any = None,\n    ) -> None:\n        self._api_base = _clean(api_base) or None\n        self._api_key = [REDACTED] or None\n        self._app_id = _clean(app_id) or None\n        self._timeout = timeout_seconds\n        self._max_retries = max(0, min(max_retries, 5))\n        self._connector_settings_loader = connector_settings_loader or _load_connector_settings\n        self._settings_cache: MozaiksCloudConnectorSettings | None = None\n\n    async def settings(self) -> MozaiksCloudConnectorSettings:\n        if self._settings_cache is not None:\n            return self._settings_cache\n        connector = await self._connector_settings_loader(self._app_id)\n        env = _env_settings()\n        resolved = MozaiksCloudConnectorSettings(\n            api_base=self._api_base or (connector.api_base if connector else None) or env.api_base,\n            api_key=[REDACTED] or (connector.api_key if connector else None) or env.api_key,\n            app_id=self._app_id or (connector.app_id if connector else None) or env.app_id,\n            source=\"[REDACTED]\" if (self._api_base or self._api_key) else (connector.source if connector else env.source),\n        )\n        if not resolved.api_base:\n            raise MozaiksCloudConfigurationError(\n                \"Mozaiks Cloud API base is required. Configure the mozaiks_cloud connector \"\n                \"or set MOZAIKS_CLOUD_API_BASE.\"\n            )\n        if not resolved.api_key:\n            raise MozaiksCloudConfigurationError(\n                \"Mozaiks Cloud API key is required. Configure the mozaiks_cloud connector \"\n                \"or set MOZAIKS_CLOUD_API_KEY.\"\n            )\n        self._settings_cache = resolved\n        return resolved\n\n    async def request(\n        self,\n        method: str,\n        path: str,\n        *,\n        json: dict[str, Any] | None = None,\n        params: dict[str, str] | None = None,\n        idempotency_key: str | None = None,\n    ) -> dict[str, Any]:\n        cfg = await self.settings()\n        headers: dict[str, str] = {\n            \"Accept\": \"application/json\",\n            \"Content-Type\": \"application/json\",\n            \"X-MozaiksCloud-Api-Version\": _API_VERSION,\n            \"Authorization\": [REDACTED] or \"\"),\n        }\n        if idempotency_key:\n            headers[\"Idempotency-Key\"] = idempotency_key\n        url = f\"{(cfg.api_base or '').rstrip('/')}{_PROVIDER_API_PREFIX}{path}\"\n        attempts = self._max_retries + 1\n        last_error: MozaiksCloudHTTPError | None = None\n        for attempt in range(attempts):\n            try:\n                async with httpx.AsyncClient(timeout=self._timeout) as client:\n                    response = await client.request(method, url, json=json, params=params, headers=headers)\n            except httpx.TimeoutException as exc:\n                last_error = MozaiksCloudHTTPError(0, code=\"timeout\", message=str(exc), kind=\"timeout\", retryable=True)\n                if attempt + 1 >= attempts:\n                    raise last_error from exc\n                continue\n            except httpx.RequestError as exc:\n                last_error = MozaiksCloudHTTPError(\n                    0,\n                    code=\"network_error\",\n                    message=str(exc),\n                    kind=\"provider_error\",\n                    retryable=True,\n                )\n                if attempt + 1 >= attempts:\n                    raise last_error from exc\n                continue\n\n            body: dict[str, Any] = {}\n            try:\n                parsed = response.json()\n                body = parsed if isinstance(parsed, dict) else {}\n            except Exception:\n                body = {}\n\n            if response.is_success:\n                if body.get(\"success\") is False:\n                    raise _error_from_response(response.status_code, body)\n                return body\n\n            last_error = _error_from_response(response.status_code, body)\n            if not last_error.retryable or attempt + 1 >= attempts:\n                raise last_error\n        if last_error is not None:\n            raise last_error\n        raise MozaiksCloudHTTPError(0, code=\"request_failed\", message=\"Request failed\", kind=\"unknown\")"},{"checksum":"sha256:598547b1569b5106821abbd4986d12c21378f72aa0e9d9002d65540b2f96c560","chunk_id":"chunk_40877bb70e8e9be3","end_line":61,"path":"build_context/mozaiks_cloud/templates/services/integrations/mozaiks_cloud_deployment_client.py","start_line":1,"symbol_ids":["sym_73fe4b64bd77f0e8","sym_b19efa0946aaf547","sym_bd5114d2b27078f7","sym_c19a4ad69e5b89ce","sym_5844a1b3b5147c51","sym_eccbbc3e50e0f7f8","sym_6ff5c00601ebad98"],"text":"from __future__ import annotations\n\nfrom typing import Any\n\nfrom .mozaiks_cloud_client import MozaiksCloudTransport\n\n\nclass MozaiksCloudDeploymentClient:\n    def __init__(self, transport: MozaiksCloudTransport) -> None:\n        self._transport = transport\n\n    async def submit_deployment_request(\n        self,\n        *,\n        app_id: str,\n        target_environment: str = \"production\",\n        release_ref: str | None = None,\n        idempotency_key: str,\n    ) -> dict[str, Any]:\n        return await self._transport.request(\n            \"POST\",\n            \"/deployments\",\n            json={\n                \"app_id\": app_id,\n                \"target_environment\": target_environment,\n                \"release_ref\": release_ref,\n            },\n            idempotency_key=idempotency_key,\n        )\n\n    async def get_operation_status(self, *, operation_id: str) -> dict[str, Any]:\n        return await self._transport.request(\"GET\", f\"/operations/{operation_id}\")\n\n    async def get_environment_endpoints(self, *, app_id: str) -> dict[str, Any]:\n        return await self._transport.request(\"GET\", f\"/apps/{app_id}/endpoints\")\n\n    async def get_deployment_health(self, *, deployment_id: str) -> dict[str, Any]:\n        return await self._transport.request(\"GET\", f\"/deployments/{deployment_id}/health\")\n\n    async def request_rollback(\n        self,\n        *,\n        target_release_id: str,\n        expected_current_deployment_id: str | None = None,\n        target_environment: str = \"production\",\n        reason: str | None = None,\n        approval_reference: str,\n        idempotency_key: str,\n    ) -> dict[str, Any]:\n        return await self._transport.request(\n            \"POST\",\n            \"/rollbacks\",\n            json={\n                \"target_release_id\": target_release_id,\n                \"expected_current_deployment_id\": expected_current_deployment_id,\n                \"target_environment\": target_environment,\n                \"reason\": reason,\n                \"approval_reference\": approval_reference,\n            },\n            idempotency_key=idempotency_key,\n        )"},{"checksum":"sha256:20386dd4450d6eae09fcfdf7de8618994dc8fd0a0251c49ca66bbab1614c4c91","chunk_id":"chunk_c80c5539fffd6ed1","end_line":107,"path":"build_context/mozaiks_cloud/templates/services/integrations/mozaiks_cloud_domain_client.py","start_line":1,"symbol_ids":["sym_b0ad8936904a864c","sym_19f7a3c3c327bf45","sym_45eece1ed7eff414","sym_d394216d90df49b2","sym_43c8ad4fa8b1cafb","sym_a5217f9e784c5a10","sym_71d78ed8e7b53d89","sym_4b320a2b7bd0c2d6","sym_5772a64b5d871443"],"text":"from __future__ import annotations\n\nfrom typing import Any\n\nfrom .mozaiks_cloud_client import MozaiksCloudTransport\n\n\ndef _query_params(*, tenant_id: str | None = None, app_id: str | None = None) -> dict[str, str]:\n    params: dict[str, str] = {}\n    if tenant_id:\n        params[\"tenant_id\"] = tenant_id\n    if app_id:\n        params[\"app_id\"] = app_id\n    return params\n\n\nclass MozaiksCloudDomainClient:\n    def __init__(self, transport: MozaiksCloudTransport) -> None:\n        self._transport = transport\n\n    async def connect_domain(\n        self,\n        *,\n        app_id: str,\n        domain: str,\n        target_environment: str = \"production\",\n        idempotency_key: str,\n    ) -> dict[str, Any]:\n        return await self._transport.request(\n            \"POST\",\n            \"/domains\",\n            json={\n                \"app_id\": app_id,\n                \"domain\": domain,\n                \"target_environment\": target_environment,\n            },\n            idempotency_key=idempotency_key,\n        )\n\n    async def get_domain_verification(\n        self,\n        *,\n        binding_id: str,\n        tenant_id: str | None = None,\n        app_id: str | None = None,\n    ) -> dict[str, Any]:\n        return await self._transport.request(\n            \"GET\",\n            f\"/domains/{binding_id}/verification\",\n            params=_query_params(tenant_id=tenant_id, app_id=app_id),\n        )\n\n    async def get_dns_instructions(\n        self,\n        *,\n        binding_id: str,\n        tenant_id: str | None = None,\n        app_id: str | None = None,\n    ) -> dict[str, Any]:\n        return await self._transport.request(\n            \"GET\",\n            f\"/domains/{binding_id}/instructions\",\n            params=_query_params(tenant_id=tenant_id, app_id=app_id),\n        )\n\n    async def request_domain_activation(\n        self,\n        *,\n        binding_id: str,\n        tenant_id: str,\n        app_id: str,\n        idempotency_key: str,\n    ) -> dict[str, Any]:\n        return await self._transport.request(\n            \"POST\",\n            f\"/domains/{binding_id}/activate\",\n            json={\"tenant_id\": tenant_id, \"app_id\": app_id},\n            idempotency_key=idempotency_key,\n        )\n\n    async def get_domain_status(\n        self,\n        *,\n        binding_id: str,\n        tenant_id: str | None = None,\n        app_id: str | None = None,\n    ) -> dict[str, Any]:\n        return await self._transport.request(\n            \"GET\",\n            f\"/domains/{binding_id}\",\n            params=_query_params(tenant_id=tenant_id, app_id=app_id),\n        )\n\n    async def disconnect_domain(\n        self,\n        *,\n        binding_id: str,\n        tenant_id: str,\n        app_id: str,\n        idempotency_key: str,\n    ) -> dict[str, Any]:\n        return await self._transport.request(\n            \"DELETE\",\n            f\"/domains/{binding_id}\",\n            json={\"tenant_id\": tenant_id, \"app_id\": app_id},\n            idempotency_key=idempotency_key,\n        )"},{"checksum":"sha256:acb7f2c7944f68945faed21e7f957ad0d819e7967b784bdfb44c58b3471e53ed","chunk_id":"chunk_9ba7c9f78820d979","end_line":51,"path":"build_context/mozaiks_cloud/templates/services/integrations/mozaiks_cloud_usage_client.py","start_line":1,"symbol_ids":["sym_bfb3811a12887f13","sym_0d335f95baec8c70","sym_e599b6d46969f495","sym_25a6c62783f0e71d"],"text":"\"\"\"Mozaiks Cloud usage-report client.\n\nPosts the app's own daily usage rollups (aggregate counts only) to the\nconfigured Mozaiks Cloud-compatible operator endpoint:\n\n    POST /usage/rollups   (scope: cloud:usage or cloud:deploy)\n\nSink-agnostic by design: where reports go is entirely determined by the\nmozaiks_cloud connector / MOZAIKS_CLOUD_* configuration. When nothing is\nconfigured the client reports is_configured() == False and sends nothing \u2014\ngenerated apps never phone home by default.\n\"\"\"\nfrom __future__ import annotations\n\nfrom typing import Any\n\nfrom .mozaiks_cloud_client import (\n    MozaiksCloudConfigurationError,\n    MozaiksCloudTransport,\n)\n\n\nclass MozaiksCloudUsageClient:\n    def __init__(self, transport: MozaiksCloudTransport | None = None) -> None:\n        self._transport = transport or MozaiksCloudTransport()\n\n    async def is_configured(self) -> bool:\n        try:\n            await self._transport.settings()\n        except MozaiksCloudConfigurationError:\n            return False\n        except Exception:\n            return False\n        return True\n\n    async def post_usage_rollups(\n        self,\n        rollups: list[dict[str, Any]],\n        *,\n        idempotency_key: str,\n    ) -> dict[str, Any]:\n        \"\"\"Send daily usage rollups. Each rollup:\n        {period_start, granularity, page_views, unique_sessions,\n        action_invocations, active_users}.\n        \"\"\"\n        return await self._transport.request(\n            \"POST\",\n            \"/usage/rollups\",\n            json={\"rollups\": list(rollups)},\n            idempotency_key=idempotency_key,\n        )"},{"checksum":"sha256:9e8319fff380530e2eea5f29324d32506f7cf9d9034d70ceba3432a5c833913b","chunk_id":"chunk_2c395d1c060ca78c","end_line":98,"path":"build_context/mozaikspay/context.yaml","start_line":1,"symbol_ids":[],"text":"context_id: mozaikspay\napplies_to_workflows:\n  - AppGenerator\nassets:\n  - path: contract.yaml\n    kind: contract\n  - path: provider_api_contract.yaml\n    kind: contract\n  - path: templates/\n    kind: templates\npack:\n  id: mozaikspay\n  version: \"0.1.11\"\n  status: active\n  capability_source: managed_capability\n  required_integrations:\n    - service: mozaikspay\n      provider: mozaiks_pay\n      display_name: MozaiksPay\n      kind: [REDACTED]\n      purpose: Connect this generated SaaS app to the managed MozaiksPay subscription provider.\n      required_at: runtime\n      required_fields:\n        - name: api_base\n          label: MozaiksPay API Base URL\n          type: url\n          required: true\n          frontend_safe: true\n        - name: [REDACTED]\n          label: MozaiksPay API Key\n          type: [REDACTED]\n          required: true\n          frontend_safe: false\n      optional_fields:\n        - name: client_id\n          label: Client ID\n          type: text\n          required: false\n          frontend_safe: true\n        - name: [REDACTED]\n          label: [REDACTED] Secret\n          type: [REDACTED]\n          required: false\n          frontend_safe: false\n  deployment_env:\n    optional:\n      - MOZAIKS_APP_URL\n      - MOZAIKSPAY_API_BASE\n      - MOZAIKSPAY_CLIENT_ID\n      - MOZAIKSPAY_CLIENT_SECRET\n      - MOZAIKSPAY_API_KEY\n    secret:\n      - MOZAIKSPAY_CLIENT_SECRET\n      - MOZAIKSPAY_API_KEY\ncapabilities:\n  - capability_id: mozaikspay.billing_portal\n    facade_recommended: billing_portal\n  - capability_id: mozaikspay.subscription_status\n    facade_recommended: billing_portal\n  - capability_id: mozaikspay.subscription_checkout\n    facade_recommended: billing_portal\n  - capability_id: mozaikspay.usage_status\n    facade_recommended: billing_portal\n  - capability_id: [REDACTED]\n    facade_recommended: billing_portal\n  - capability_id: [REDACTED]\n    facade_recommended: billing_portal\nfacades:\n  - module_id: billing_portal\n    provider_module: mozaikspay\n    provider_actions:\n      - billing_portal\n      - create_billing_portal_session\n      - subscription_status\n      - get_subscription_status\n      - subscription_checkout\n      - create_subscription_checkout_session\n      - start_subscription_checkout\n      - usage_status\n      - get_usage_status\n      - token_status\n      - get_token_status\n      - token_top_up\n      - create_token_top_up_session\n      - start_token_top_up\n    pages:\n      - name: Billing\n        route: /billing\n        page_type_hint: analytics_dashboard\n      - name: Usage\n        route: /usage\n        page_type_hint: analytics_dashboard\nprojections:\n  context_variables:\n    capability_packs:\n      from: capability_packs\n    operator_contracts:\n      from: operator_contracts"},{"checksum":"sha256:6d36b1a308515bc14ba8052e85008580bf0f63d58809c78e43ef74f48b8b931e","chunk_id":"chunk_bdecd65489142ff1","end_line":284,"path":"build_context/mozaikspay/contract.yaml","start_line":1,"symbol_ids":[],"text":"contract_id: mozaikspay\ncontract_type: build_pack_instructions\ncanonical_provider:\n  provider_id: mozaiks_pay\n  provider_pack_id: mozaikspay\n  display_name: MozaiksPay\n  api_contract_version: mozaiks.provider_api_contract.v1\n  provider_api_contract_id: mozaikspay_provider_api\n  connector_file: services/integrations/mozaikspay_client.py\n  callback_event_namespace: mozaikspay.billing\n  fulfillment_boundary: BillingFulfillmentCommand\n  entitlement_boundary: EntitlementPort\n  secret_references:\n    - MOZAIKSPAY_API_BASE\n    - MOZAIKSPAY_API_KEY\n    - MOZAIKSPAY_CLIENT_ID\n    - MOZAIKSPAY_CLIENT_SECRET\n  activation_requires_explicit_selection: false\n  activation_requires_credentials: [REDACTED]\n  self_managed_replacement_provider_id: entitlement_dispatch\n\n# Declares capabilities this pack provides to the OSS planning system.\n# subscription_write_path: this managed pack owns the subscription assignment\n# write path. AppPlanAgent must not also include entitlement_dispatch when\n# this pack is selected as managed_capability.\nprovides_capabilities:\n  - subscription_write_path\n\nselection_rules:\n  - id: [REDACTED]\n    when:\n      app_declares:\n        - token_wallets\n        - top_up_products\n    action: select_pack\n  - id: select_for_saas_billing\n    when:\n      intent_any:\n        - saas billing\n        - subscriptions\n        - billing portal\n        - runtime usage display\n    action: select_pack\n  - id: do_not_select_for_generic_payments\n    when:\n      intent_any:\n        - checkout\n        - marketplace payments\n        - wallet connection\n        - creator payouts\n    action: require_explicit_user_confirmation\n\nrecommended_domains:\n  - billing\n  - subscriptions\n  - usage\n  - saas\n\nrequired_integrations:\n  - service: mozaikspay\n    provider: mozaiks_pay\n    display_name: MozaiksPay\n    kind: [REDACTED]\n    purpose: Connect this generated SaaS app to the managed MozaiksPay subscription provider.\n    required_at: runtime\n    required_fields:\n      - name: api_base\n        label: MozaiksPay API Base URL\n        type: url\n        required: true\n        frontend_safe: true\n      - name: [REDACTED]\n        label: MozaiksPay API Key\n        type: [REDACTED]\n        required: true\n        frontend_safe: false\n    optional_fields:\n      - name: client_id\n        label: Client ID\n        type: text\n        required: false\n        frontend_safe: true\n      - name: [REDACTED]\n        label: [REDACTED] Secret\n        type: [REDACTED]\n        required: false\n        frontend_safe: false\n\nrequired_outputs:\n  - path: services/integrations/mozaikspay_client.py\n    owner: templates\n  - path: modules/billing_portal/module.yaml\n    owner: templates\n  - path: modules/billing_portal/backend/base_handler.py\n    owner: templates\n  - path: modules/billing_portal/backend/handler.py\n    owner: workspace  # preserved across regeneration; subclasses base_handler.py\n  - path: modules/billing_portal/backend/service.py\n    owner: templates\n  - path: modules/billing_portal/backend/schemas.py\n    owner: templates\n  - path: modules/billing_portal/contracts/reactions.yaml\n    owner: templates\n  - path: modules/billing_portal/contracts/profile.yaml\n    owner: templates\n  - path: modules/billing_portal/contracts/admin.yaml\n    owner: templates\n  - path: ui/pages/billing.yaml\n    owner: templates\n  - path: ui/pages/usage.yaml\n    owner: templates\n\nforbidden_outputs:\n  - path_prefix: modules/mozaikspay/\n  - path_prefix: modules/wallet/\n  - path_prefix: app/capability_packs/\n  - path_prefix: services/managed_billing/\n  - path_prefix: services/wallet/\n\nruntime_boundaries:\n  - id: entitlements_runtime\n    rule: Keep entitlement enforcement on the OSS runtime/module contract path.\n  - id: usage_runtime\n    rule: [REDACTED] runtime token usage through /api/me/usage or /api/admin/usage; use the OSS token wallet ledger for balances instead of app-local duplicate ledgers.\n  - id: plan_limits\n    rule: [REDACTED] app/config/subscriptions.yaml usage_limits, token_wallets, token_allowances, depleted_balance, and top_up_products for generated SaaS plan limits, token allowances, and recovery paths only when the app sells AI usage, credits, quotas, or token packs; access-only plans omit token wallet fields.\n  - id: [REDACTED]\n    rule: [REDACTED] top-up products are provider-neutral app contract entries; MozaiksPay only creates checkout sessions and must confirm payment before OSS billing fulfillment credits tokens.\n  - id: managed_internals\n    rule: [REDACTED] not generate managed service internals, checkout, wallet, settlement logic, private APIs, or provider credentials.\n  - id: connector_boundary\n    rule: [REDACTED] apps must configure MozaiksPay through the app-scoped connector named mozaikspay or the MOZAIKSPAY_* env fallback; never commit provider credentials.\n  - id: page_bindings\n    rule: Generated pages must call app-owned billing_portal actions, not managed backing modules directly.\n\nfacades:\n  - module_id: billing_portal\n    provider_module: mozaikspay\n    provider_actions:\n      - billing_portal\n      - create_billing_portal_session\n      - subscription_status\n      - get_subscription_status\n      - subscription_checkout\n      - create_subscription_checkout_session\n      - start_subscription_checkout\n      - usage_status\n      - get_usage_status\n      - token_status\n      - get_token_status\n      - token_top_up\n      - create_token_top_up_session\n      - start_token_top_up\n    pages:\n      - name: Pricing\n        route: /pricing\n        page_type_hint: landing\n        primary_entities:\n          - subscription\n        primary_actions:\n          - list_plans\n          - open_billing_portal\n      - name: Billing\n        route: /billing\n        page_type_hint: analytics_dashboard\n        primary_entities:\n          - subscription\n        primary_actions:\n          - get_subscription_status\n          - list_plans\n          - start_subscription_checkout\n          - open_billing_portal\n      - name: Usage\n        route: /usage\n        page_type_hint: analytics_dashboard\n        primary_entities:\n          - runtime_usage\n          - token_wallet\n        primary_actions:\n          - get_usage_status\n          - get_token_status\n          - start_token_top_up\n\nprovider_api_response_contract:\n  spec_file: provider_api_contract.yaml\n  description: >\n    A MozaiksPay-compatible provider serves the provider API endpoints consumed\n    by generated apps. Response shapes are pinned in provider_api_contract.yaml.\n    Any change to field names or types on either side is a breaking change\n    requiring coordinated release.\n  subscription_status_required_fields:\n    - success\n    - found\n    - plan_id\n    - plan_name\n    - status\n    - starts_at\n    - expires_at\n    - on_free_plan\n  billing_portal_session_required_fields:\n    - success\n    - portal_url\n    - return_url\n  subscription_checkout_session_required_fields:\n    - success\n    - checkout_url\n    - success_url\n    - cancel_url\n    - plan_id\n  token_top_up_session_required_fields:\n    - success\n    - checkout_url\n    - success_url\n    - cancel_url\n    - product_id\n    - wallet_id\n    - token_amount\n  globally_forbidden_response_fields:\n    - provider_customer_id\n    - provider_subscription_id\n    - payment_provider_customer_id\n    - payment_provider_subscription_id\n    - client_secret\n    - secret_salt\n    - client_secret_hash\n    - session_id\n\nruntime_connector_contract:\n  connector_id: mozaikspay\n  canonical_provider_id: mozaiks_pay\n  selection_field: AppBuildPlan.monetization_provider\n  selection_value: mozaiks_pay\n  required_selected_pack_id: mozaikspay\n  mutually_exclusive_with:\n    - entitlement_dispatch\n  operations:\n    - subscription_status\n    - billing_portal_session\n    - subscription_checkout_session\n    - token_top_up_session\n  auth_secret_refs:\n    primary:\n      - MOZAIKSPAY_API_KEY\n    compatibility:\n      - MOZAIKSPAY_CLIENT_ID\n      - MOZAIKSPAY_CLIENT_SECRET\n    public:\n      - MOZAIKSPAY_API_BASE\n      - MOZAIKS_APP_URL\n  idempotency:\n    required_for_provider_fulfillment: true\n    command_id_source: provider_event_id\n    replay_boundary: BillingFulfillmentService\n  callback_verification:\n    required: true\n    fail_closed: true\n    unsigned_callbacks: reject\n    malformed_callbacks: reject\n    accepted_event_shapes:\n      - subscription_activated\n      - subscription_updated\n      - subscription_cancelled\n      - token_top_up_paid\n  retry_policy:\n    retryable_errors:\n      - timeout\n      - rate_limited\n      - service_unavailable\n    terminal_errors:\n      - invalid_credentials\n      - invalid_scope\n      - contract_version_mismatch\n      - malformed_callback\n      - unsigned_callback\n  readiness:\n    health_operation: provider_readiness\n    required_config:\n      - api_base\n      - api_key\n    offline_behavior: not_ready\n  entitlement_sync:\n    source: verified_provider_fulfillment\n    normalized_command: BillingFulfillmentCommand\n    assignment_store_authority: config/subscriptions.yaml"},{"checksum":"sha256:e86f163247e6b066d60ea4b2e69c4dd86a5b3597bc859fb3bc93b47357797e8d","chunk_id":"chunk_248ca633657934c8","end_line":325,"path":"build_context/mozaikspay/contract.yaml","start_line":285,"symbol_ids":[],"text":"    enforcement_adapter: ConfiguredEntitlementAdapter\n\ninactive_surfaces:\n  - checkout\n  - creator_earnings\n  - wallet_connection\n\n# ---------------------------------------------------------------------------\n# Provider lifecycle boundary \u2014 responsibilities owned by the selected\n# MozaiksPay-compatible provider, not by the generated app. Generated apps never\n# implement payment-provider provisioning, hosted billing modules, wallet\n# engines, payout engines, settlement logic, or provider credential handling.\n# ---------------------------------------------------------------------------\nprovider_lifecycle_boundary:\n  - id: plan_catalog_mapping\n    provider_role: mozaikspay_compatible_provider\n    description: >\n      The selected provider may read the app bundle's app/config/subscriptions.yaml\n      catalog to map paid plans and top-up products to provider-owned billing\n      objects. Mapping, provisioning, idempotency, provider IDs, payment\n      processor objects, and hosted operational records remain provider-owned and\n      are not generated into the canonical app bundle.\n    app_requirements:\n      subscriptions_yaml_price_block:\n        description: >\n          Optional price metadata on each plan entry in app/config/subscriptions.yaml.\n          When present on a plan, a compatible provider may use this metadata to\n          map or provision provider-owned billing objects. When absent, the plan\n          is free or requires provider/operator-side pricing configuration.\n        example: |\n          plans:\n            - plan_id: pro\n              label: Pro\n              price:\n                amount: 29        # dollars\n                currency: usd\n                interval: month   # month | year\n              billing:\n                lookup_key: my_app_pro_monthly   # optional stable provider mapping key\n                allow_promotion_codes: true\n              capabilities: [...]"},{"checksum":"sha256:8b8b5fd34cd99e1b6380d5c109e22258abbbc0c6a70d5e3da6bd3ed0d0273d66","chunk_id":"chunk_ead2df3e7ce55544","end_line":234,"path":"build_context/mozaikspay/provider_api_contract.yaml","start_line":1,"symbol_ids":[],"text":"schema_version: mozaiks.provider_api_contract.v1\ncontract_id: mozaikspay_provider_api\ndescription: >\n  Machine-readable interface spec for the MozaiksPay provider API.\n  Consumed by generated SaaS apps via mozaikspay_client.py.\n  Served by the selected MozaiksPay-compatible provider. The hosted MozaiksPay\n  service is the default provider implementation, but self-hosted or alternative\n  providers may satisfy this same app-facing contract.\n\n  This file defines ONLY the public interface \u2014 request shape, response shape,\n  auth scheme, and which fields are forbidden from responses. No payment provider\n  logic, fee calculations, or subscription business rules belong here.\n\nauth:\n  scheme: [REDACTED]\n  headers:\n    - name: Authorization\n      format: \"Bearer {api_key}\"\n      description: App-scoped MozaiksPay-compatible API key issued by the selected provider.\n      required: true\n      secret: [REDACTED]\n  credential_prefixes:\n    api_key:\n      - \"mzk_live_\"\n      - \"mzk_test_\"\n  compatibility_auth:\n    scheme: [REDACTED]\n    headers:\n      - name: X-MozaiksPay-Client-Id\n        description: App-scoped client ID issued by the selected provider.\n        required: true\n        secret: [REDACTED]\n      - name: Authorization\n        format: \"Bearer {client_secret}\"\n        description: [REDACTED] client secret issued by the selected provider.\n        required: true\n        secret: [REDACTED]\n    credential_prefixes:\n      client_id: \"mpc_\"\n      client_secret: \"[REDACTED]\"\n\ncontract_version:\n  header: X-MozaiksPay-Contract-Version\n  current: mozaiks.provider_api_contract.v1\n  mismatch_error_code: contract_version_mismatch\n\nendpoints:\n  - id: provider_readiness\n    method: GET\n    path: /api/mozaikspay/v1/health\n    description: >\n      Return whether the selected MozaiksPay-compatible provider is reachable\n      and serving this public contract. This endpoint is a readiness check only;\n      it must not create accounts, activate billing, mutate subscription state,\n      transmit source code, or incur charges.\n    response:\n      success_shape:\n        success: { type: boolean, value: true }\n        ready: { type: boolean }\n        contract_version: { type: string }\n      error_shape:\n        success: { type: boolean, value: false }\n        ready: { type: boolean, value: false }\n        error_code: { type: string }\n\n  - id: subscription_status\n    method: GET\n    path: /api/mozaikspay/v1/subscription/status\n    description: >\n      Return the current subscription plan for the calling app scope.\n      Safe for display in generated app billing pages.\n    scope_params:\n      - name: user_id\n        in: query\n        required: false\n      - name: tenant_id\n        in: query\n        required: false\n      - name: workspace_id\n        in: query\n        required: false\n    response:\n      success_shape:\n        success: { type: boolean, value: true }\n        found: { type: boolean }\n        plan_id: { type: string, nullable: true }\n        plan_name: { type: string, nullable: true }\n        status: { type: string, nullable: true }\n        starts_at: { type: string, format: iso8601, nullable: true }\n        expires_at: { type: string, format: iso8601, nullable: true }\n        on_free_plan: { type: boolean }\n      not_found_shape:\n        success: { type: boolean, value: true }\n        found: { type: boolean, value: false }\n        plan_id: { type: \"null\" }\n        plan_name: { type: \"null\" }\n        status: { type: \"null\" }\n        starts_at: { type: \"null\" }\n        expires_at: { type: \"null\" }\n        on_free_plan: { type: boolean, value: true }\n      error_shape:\n        success: { type: boolean, value: false }\n        error: { type: string }\n        error_code: { type: string }\n      forbidden_fields:\n        - provider_customer_id\n        - provider_subscription_id\n        - payment_provider_customer_id\n        - payment_provider_subscription_id\n        - granted_capabilities\n        - metadata\n        - client_secret\n        - secret_salt\n        - client_secret_hash\n\n  - id: billing_portal_session\n    method: POST\n    path: /api/mozaikspay/v1/billing-portal/session\n    description: >\n      Create a hosted billing portal redirect session. The caller redirects\n      their end-user to portal_url. No subscription state is mutated by this call.\n    request_body:\n      return_url: { type: string, format: https_url, required: true }\n      user_id: { type: string, required: false }\n      tenant_id: { type: string, required: false }\n      workspace_id: { type: string, required: false }\n    response:\n      success_shape:\n        success: { type: boolean, value: true }\n        portal_url: { type: string, format: https_url }\n        return_url: { type: string, format: https_url }\n        expires_at: { type: string, format: iso8601, nullable: true }\n      error_shape:\n        success: { type: boolean, value: false }\n        error_code: { type: string }\n      forbidden_fields:\n        - provider_customer_id\n        - provider_subscription_id\n        - payment_provider_customer_id\n        - payment_provider_subscription_id\n        - session_id\n        - client_secret\n        - secret_salt\n\n  - id: subscription_checkout_session\n    method: POST\n    path: /api/mozaikspay/v1/subscription/checkout-session\n    description: >\n      Create a hosted subscription checkout redirect session for a paid plan.\n      The caller redirects their end-user to checkout_url. No OSS runtime state\n      is mutated by this call; subscription fulfillment is driven by the selected\n      provider after the payment provider confirms the subscription.\n    request_body:\n      plan_id: { type: string, required: true }\n      success_url: { type: string, format: https_url, required: true }\n      cancel_url: { type: string, format: https_url, required: true }\n      customer_email: { type: string, required: false }\n      user_id: { type: string, required: false }\n      tenant_id: { type: string, required: false }\n      workspace_id: { type: string, required: false }\n    response:\n      success_shape:\n        success: { type: boolean, value: true }\n        checkout_url: { type: string, format: https_url }\n        success_url: { type: string, format: https_url }\n        cancel_url: { type: string, format: https_url }\n        plan_id: { type: string }\n        expires_at: { type: string, format: iso8601, nullable: true }\n        dry_run: { type: boolean, nullable: true }\n      error_shape:\n        success: { type: boolean, value: false }\n        error_code: { type: string }\n        portal_available: { type: boolean, nullable: true }\n        missing_env: { type: string, nullable: true }\n      forbidden_fields:\n        - provider_price_id\n        - payment_provider_price_id\n        - provider_customer_id\n        - provider_subscription_id\n        - payment_provider_customer_id\n        - payment_provider_subscription_id\n        - session_id\n        - client_secret\n        - secret_salt\n\n  - id: [REDACTED]\n    method: POST\n    path: [REDACTED]\n    description: >\n      Create a hosted token top-up checkout session for a provider-neutral\n      top_up_products entry declared by the generated app. Payment confirmation\n      must produce an OSS BillingFulfillmentCommand with event_type\n      token_top_up_paid before tokens are credited.\n    request_body:\n      product_id: { type: string, required: true }\n      wallet_id: { type: string, required: true }\n      token_amount: [REDACTED] type: [REDACTED] required: [REDACTED] }\n      amount_cents: { type: integer, required: true }\n      currency: { type: string, required: true }\n      success_url: { type: string, format: https_url, required: true }\n      cancel_url: { type: string, format: https_url, required: true }\n      user_id: { type: string, required: false }\n      tenant_id: { type: string, required: false }\n      workspace_id: { type: string, required: false }\n    response:\n      success_shape:\n        success: { type: boolean, value: true }\n        checkout_url: { type: string, format: https_url }\n        success_url: { type: string, format: https_url }\n        cancel_url: { type: string, format: https_url }\n        product_id: { type: string }\n        wallet_id: { type: string }\n        token_amount: [REDACTED] type: [REDACTED] }\n        amount_cents: { type: integer }\n        currency: { type: string }\n        expires_at: { type: string, format: iso8601, nullable: true }\n      error_shape:\n        success: { type: boolean, value: false }\n        error_code: { type: string }\n        product_id: { type: string, nullable: true }\n        wallet_id: { type: string, nullable: true }\n        amount_cents: { type: integer, nullable: true }\n        currency: { type: string, nullable: true }\n      forbidden_fields:\n        - provider_price_id\n        - payment_provider_price_id\n        - provider_customer_id\n        - payment_provider_customer_id\n        - session_id\n        - client_secret\n        - secret_salt\n\nerror_handling:\n  http_errors:"},{"checksum":"sha256:11805d3ac2b461f03ed52e3170b95e32ebb67425167cfe5554d9743b67e95635","chunk_id":"chunk_dbacb5cd91880cfd","end_line":301,"path":"build_context/mozaikspay/provider_api_contract.yaml","start_line":235,"symbol_ids":[],"text":"    401: \"Missing or invalid MozaiksPay API key or client credentials.\"\n    403: \"MozaiksPay credential app or user/tenant/workspace scope does not allow this request.\"\n    400: \"Invalid request body (missing return_url, unsafe URL, etc.).\"\n    404: \"No subscription found for this scope (subscription_status only \u2014 not an HTTP 404).\"\n  application_errors:\n    SUBSCRIPTION_NOT_FOUND: \"No subscription record for the given scope.\"\n    BILLING_CUSTOMER_NOT_FOUND: \"Subscription exists but billing provider customer not yet linked.\"\n    MOZAIKSPAY_BILLING_NOT_CONFIGURED: \"Selected MozaiksPay-compatible provider is not configured.\"\n    MOZAIKSPAY_BILLING_API_ERROR: \"Billing provider returned an error.\"\n    INVALID_INPUT: \"Required field missing or unsafe URL.\"\n    PLAN_NOT_CHECKOUTABLE: \"Free/default plan cannot be purchased through checkout.\"\n    CUSTOM_PLAN_REQUIRES_SALES: \"Plan requires operator setup before self-serve checkout.\"\n    SUBSCRIPTION_ALREADY_EXISTS: \"The requested billing scope already has an active paid subscription.\"\n    MOZAIKSPAY_PRICE_NOT_CONFIGURED: \"Selected provider has no price mapping for the plan.\"\n    TOKEN_TOP_UP_PRODUCT_NOT_FOUND: \"The requested token top-up product is not declared by the app.\"\n    CONTRACT_VERSION_MISMATCH: \"Provider and generated client do not agree on the MozaiksPay public contract version.\"\n\ncallbacks:\n  verification:\n    required: true\n    fail_closed: true\n    unsigned_callbacks: reject\n    malformed_callbacks: reject\n    signature_header: X-MozaiksPay-Signature\n    timestamp_header: X-MozaiksPay-Timestamp\n  idempotency:\n    event_id_field: event_id\n    normalized_command_id: event_id\n    replay_boundary: BillingFulfillmentService\n  fulfillment_events:\n    - event_type: subscription_activated\n      normalized_command: BillingFulfillmentCommand\n      required_fields:\n        - event_id\n        - app_id\n        - plan_id\n        - status\n    - event_type: subscription_updated\n      normalized_command: BillingFulfillmentCommand\n      required_fields:\n        - event_id\n        - app_id\n        - plan_id\n        - status\n    - event_type: subscription_cancelled\n      normalized_command: BillingFulfillmentCommand\n      required_fields:\n        - event_id\n        - app_id\n        - status\n    - event_type: [REDACTED]\n      normalized_command: BillingFulfillmentCommand\n      required_fields:\n        - event_id\n        - app_id\n        - wallet_id\n        - token_amount\n\ndrift_guard:\n  description: >\n    Changes to this file must be reflected in:\n    - The selected provider server implementation\n    - The generated client template (templates/services/integrations/mozaikspay_client.py)\n    - The generated billing_portal schemas (templates/modules/billing_portal/backend/schemas.py)\n    If any of these diverge, generated SaaS apps will break silently at runtime.\n  owned_by: mozaikspay-platform\n  consumer: generated-saas-apps"},{"checksum":"sha256:11bcb628fb21eaa55645c1db257bc3339cc8752c0fca8d790f56c2bd55651db0","chunk_id":"chunk_edffdada055451e5","end_line":45,"path":"build_context/mozaikspay/templates/modules/billing_portal/backend/base_handler.py","start_line":1,"symbol_ids":["sym_fe2bcf7f5101d169","sym_d82bb81901194d09","sym_885d5ffeaeb9bfad","sym_3416295c92520ef0","sym_d90b17795fd8e835","sym_28857d7131dd6e10","sym_ab24d8a0973bcbde","sym_3419f0a9888c229a","sym_615bcc5cd9397f81","sym_8db6c036106ae0ec"],"text":"\"\"\"\nOSS-generated base handler for the billing_portal module.\nDO NOT EDIT \u2014 regenerated on framework upgrades.\nPut app-specific customizations in handler.py (the workspace subclass).\n\"\"\"\nfrom __future__ import annotations\n\nfrom typing import Any\n\nfrom .service import BillingPortalService\n\n\nclass BillingPortalBaseHandler:\n    def __init__(self, service: BillingPortalService | None = None) -> None:\n        self._service = service or BillingPortalService()\n\n    async def get_subscription_status(self, ctx: Any, **params: Any) -> dict[str, Any]:\n        return await self._service.get_subscription_status(ctx)\n\n    async def get_usage_status(self, ctx: Any, **params: Any) -> dict[str, Any]:\n        return await self._service.get_usage_status(ctx, **params)\n\n    async def get_token_status(self, ctx: [REDACTED] **params: [REDACTED] -> dict[str, Any]:\n        return await self._service.get_token_status(ctx, **params)\n\n    async def list_plans(self, ctx: Any, **params: Any) -> dict[str, Any]:\n        return await self._service.list_plans(ctx)\n\n    async def start_subscription_checkout(self, ctx: Any, **params: Any) -> dict[str, Any]:\n        return await self._service.start_subscription_checkout(ctx, **params)\n\n    async def start_token_top_up(self, ctx: [REDACTED] **params: [REDACTED] -> dict[str, Any]:\n        return await self._service.start_token_top_up(ctx, **params)\n\n    async def open_billing_portal(self, ctx: Any, **params: Any) -> dict[str, Any]:\n        return await self._service.open_billing_portal(ctx, **params)\n\n    async def handle_subscription_activated(self, ctx: Any, **params: Any) -> dict[str, Any]:\n        return await self._service.handle_subscription_event(ctx, \"activated\", params)\n\n    async def handle_subscription_updated(self, ctx: Any, **params: Any) -> dict[str, Any]:\n        return await self._service.handle_subscription_event(ctx, \"updated\", params)\n\n    async def handle_subscription_cancelled(self, ctx: Any, **params: Any) -> dict[str, Any]:\n        return await self._service.handle_subscription_event(ctx, \"cancelled\", params)"},{"checksum":"sha256:a3d9f1b211a520b35e3e527fcc54a65c611c41811025b34e3d5620116fae4a17","chunk_id":"chunk_f8c4fa4b481eee6a","end_line":12,"path":"build_context/mozaikspay/templates/modules/billing_portal/backend/handler.py","start_line":1,"symbol_ids":["sym_4b1ff8a68487a2e0"],"text":"\"\"\"\nWorkspace handler for the billing_portal module.\nSubclasses BillingPortalBaseHandler \u2014 add overrides and extra methods here.\nThis file is preserved across regeneration.\n\"\"\"\nfrom __future__ import annotations\n\nfrom .base_handler import BillingPortalBaseHandler\n\n\nclass BillingPortalHandler(BillingPortalBaseHandler):\n    \"\"\"App-local handler \u2014 extend or override base methods below.\"\"\""},{"checksum":"sha256:67e7d2950ef6468acff8aac4e6ac0cd9c14e4b81469242ca9808afe15b942d63","chunk_id":"chunk_d3d9e028e4abd439","end_line":66,"path":"build_context/mozaikspay/templates/modules/billing_portal/backend/schemas.py","start_line":1,"symbol_ids":["sym_4bb9475d81c2eed8","sym_553ba586bc8d8fc9","sym_defb8fb1bab1ccc7","sym_6a80965d729265be","sym_c814a951f16d53d7"],"text":"from __future__ import annotations\n\nfrom dataclasses import dataclass\nfrom typing import Any\n\n\n@dataclass(frozen=True)\nclass SubscriptionStatus:\n    success: bool\n    found: bool = False\n    plan_id: str | None = None\n    plan_name: str | None = None\n    status: str | None = None\n    starts_at: str | None = None\n    expires_at: str | None = None\n    on_free_plan: bool = True\n\n    @classmethod\n    def from_hosted(cls, raw: dict[str, Any]) -> SubscriptionStatus:\n        return cls(\n            success=bool(raw.get(\"success\", True)),\n            found=bool(raw.get(\"found\", False)),\n            plan_id=raw.get(\"plan_id\"),\n            plan_name=raw.get(\"plan_name\"),\n            status=raw.get(\"status\"),\n            starts_at=raw.get(\"starts_at\"),\n            expires_at=raw.get(\"expires_at\"),\n            on_free_plan=bool(raw.get(\"on_free_plan\", True)),\n        )\n\n    def to_dict(self) -> dict[str, Any]:\n        return {\n            \"success\": self.success,\n            \"found\": self.found,\n            \"plan_id\": self.plan_id,\n            \"plan_name\": self.plan_name,\n            \"status\": self.status,\n            \"starts_at\": self.starts_at,\n            \"expires_at\": self.expires_at,\n            \"on_free_plan\": self.on_free_plan,\n        }\n\n\ndef safe_portal_response(raw: dict[str, Any]) -> dict[str, Any]:\n    return {\n        \"success\": bool(raw.get(\"success\", False)),\n        \"portal_url\": raw.get(\"portal_url\"),\n        \"return_url\": raw.get(\"return_url\"),\n        \"error\": raw.get(\"error\") or raw.get(\"error_code\"),\n    }\n\n\ndef safe_checkout_response(raw: dict[str, Any]) -> dict[str, Any]:\n    return {\n        \"success\": bool(raw.get(\"success\", False)),\n        \"checkout_url\": raw.get(\"checkout_url\"),\n        \"success_url\": raw.get(\"success_url\"),\n        \"cancel_url\": raw.get(\"cancel_url\"),\n        \"plan_id\": raw.get(\"plan_id\"),\n        \"product_id\": raw.get(\"product_id\"),\n        \"wallet_id\": raw.get(\"wallet_id\"),\n        \"token_amount\": [REDACTED]\"token_amount\"),\n        \"amount_cents\": raw.get(\"amount_cents\"),\n        \"currency\": raw.get(\"currency\"),\n        \"error\": raw.get(\"error\") or raw.get(\"error_code\"),\n    }"},{"checksum":"sha256:fed97bb70e00858b951c2414afa8be2fb407dc02453d38be34cec26728698f60","chunk_id":"chunk_ee62de23d9121c68","end_line":259,"path":"build_context/mozaikspay/templates/modules/billing_portal/backend/service.py","start_line":1,"symbol_ids":[],"text":"from __future__ import annotations\n\nfrom pathlib import Path\nfrom typing import Any\nfrom urllib.parse import urlparse\n\nfrom services.integrations.mozaikspay_client import MozaiksPayClient\n\nfrom .schemas import SubscriptionStatus, safe_checkout_response, safe_portal_response\n\n\ndef _auth_token_from_ctx(ctx: [REDACTED] -> str | None:\n    for attr in (\"auth_token\", \"authorization\"):\n        value = getattr(ctx, attr, None)\n        if isinstance(value, str) and value:\n            return value\n    headers = getattr(ctx, \"headers\", None)\n    if isinstance(headers, dict):\n        value = headers.get(\"Authorization\") or headers.get(\"authorization\")\n        if isinstance(value, str) and value:\n            return value\n    return None\n\n\ndef _ctx_scope(ctx: Any) -> dict[str, str | None]:\n    return {\n        \"user_id\": getattr(ctx, \"user_id\", None),\n        \"tenant_id\": getattr(ctx, \"tenant_id\", None),\n        \"workspace_id\": getattr(ctx, \"workspace_id\", None),\n    }\n\n\ndef _subscriptions_config() -> dict[str, Any]:\n    candidates: list[Path] = []\n    active_app_root: Path | None = None\n    try:\n        from mozaiksai.core.workflow.paths import resolve_active_app_root\n\n        active_app_root = resolve_active_app_root()\n    except Exception:\n        active_app_root = None\n\n    if active_app_root is not None:\n        candidates.append(active_app_root / \"config\" / \"subscriptions.yaml\")\n\n    cwd = Path.cwd()\n    candidates.extend(\n        [\n            cwd / \"config\" / \"subscriptions.yaml\",\n            cwd / \"app\" / \"config\" / \"subscriptions.yaml\",\n        ]\n    )\n\n    seen: set[Path] = set()\n    for subs_path in candidates:\n        resolved = subs_path.resolve()\n        if resolved in seen or not resolved.exists():\n            continue\n        seen.add(resolved)\n        try:\n            import yaml\n\n            raw = yaml.safe_load(resolved.read_text(encoding=\"utf-8\"))\n        except Exception:\n            continue\n        return raw if isinstance(raw, dict) else {}\n    return {}\n\n\ndef _safe_https_url(value: str) -> bool:\n    parsed = urlparse(value)\n    return parsed.scheme == \"https\" and bool(parsed.netloc)\n\n\ndef _positive_int(value: Any) -> int:\n    try:\n        return max(0, int(value or 0))\n    except (TypeError, ValueError):\n        return 0\n\n\ndef _safe_plan(plan: dict[str, Any]) -> dict[str, Any]:\n    return {\n        \"plan_id\": plan.get(\"plan_id\", \"\"),\n        \"label\": plan.get(\"label\", \"\"),\n        \"description\": plan.get(\"description\", \"\"),\n        \"capabilities\": plan.get(\"capabilities\", []),\n        \"usage_limits\": plan.get(\"usage_limits\", {}),\n        \"token_allowances\": [REDACTED]\"token_allowances\", []),\n    }\n\n\ndef _safe_token_wallet(wallet: [REDACTED] Any]) -> dict[str, Any]:\n    return {\n        \"wallet_id\": wallet.get(\"wallet_id\", \"\"),\n        \"label\": wallet.get(\"label\", \"\"),\n        \"unit\": wallet.get(\"unit\", \"\"),\n        \"usage_meter_id\": wallet.get(\"usage_meter_id\", \"\"),\n        \"scope\": wallet.get(\"scope\", \"\"),\n        \"auto_debit_usage\": bool(wallet.get(\"auto_debit_usage\", False)),\n        \"depleted_balance\": wallet.get(\"depleted_balance\") or None,\n    }\n\n\ndef _safe_top_up_product(product: dict[str, Any]) -> dict[str, Any]:\n    raw_price = product.get(\"price\")\n    price = raw_price if isinstance(raw_price, dict) else {}\n    currency = str(price.get(\"currency\") or \"usd\").strip().lower()\n    return {\n        \"product_id\": product.get(\"product_id\", \"\"),\n        \"label\": product.get(\"label\", \"\"),\n        \"description\": product.get(\"description\", \"\"),\n        \"wallet_id\": [REDACTED]\"wallet_id\", \"ai_tokens\"),\n        \"token_amount\": [REDACTED]\"token_amount\")),\n        \"price\": {\n            \"amount_cents\": _positive_int(price.get(\"amount_cents\")),\n            \"currency\": currency if len(currency) == 3 else \"usd\",\n            \"display\": str(price.get(\"display\") or \"\").strip(),\n        },\n        \"active\": bool(product.get(\"active\", True)),\n    }\n\n\nclass BillingPortalService:\n    def __init__(self, mozaikspay_client: MozaiksPayClient | None = None) -> None:\n        self._mozaikspay_client = mozaikspay_client\n\n    def _client(self, ctx: Any) -> MozaiksPayClient:\n        if self._mozaikspay_client is not None:\n            return self._mozaikspay_client\n        return MozaiksPayClient(\n            auth_token=[REDACTED]\n            app_id=getattr(ctx, \"app_id\", None),\n        )\n\n    async def get_subscription_status(self, ctx: Any) -> dict[str, Any]:\n        raw = await self._client(ctx).get_subscription_status_for_scope(**_ctx_scope(ctx))\n        return SubscriptionStatus.from_hosted(raw).to_dict()\n\n    async def get_usage_status(\n        self,\n        ctx: Any,\n        *,\n        limit: int = 500,\n        **_: Any,\n    ) -> dict[str, Any]:\n        client = self._client(ctx)\n        runtime_ai_usage = await client.get_runtime_ai_usage(limit=limit)\n        return {\n            \"success\": True,\n            \"runtime_ai_usage\": runtime_ai_usage,\n            \"source\": \"mozaikspay_facade\",\n        }\n\n    async def get_token_status(\n        self,\n        ctx: Any,\n        *,\n        limit: int = 500,\n        **_: Any,\n    ) -> dict[str, Any]:\n        config = _subscriptions_config()\n        runtime_ai_usage = await self._client(ctx).get_runtime_ai_usage(limit=limit)\n        token_wallets = [REDACTED]\n            _safe_token_wallet(wallet)\n            for wallet in (config.get(\"token_wallets\") or [])\n            if isinstance(wallet, dict)\n        ]\n        top_up_products = [\n            _safe_top_up_product(product)\n            for product in (config.get(\"top_up_products\") or [])\n            if isinstance(product, dict) and product.get(\"active\", True)\n        ]\n        return {\n            \"success\": True,\n            \"runtime_ai_usage\": runtime_ai_usage,\n            \"token_wallets\": [REDACTED]\n            \"top_up_products\": top_up_products,\n            \"source\": \"mozaikspay_facade\",\n        }\n\n    async def list_plans(self, ctx: Any) -> dict[str, Any]:\n        raw = _subscriptions_config()\n        plans = raw.get(\"plans\", [])\n        top_up_products = raw.get(\"top_up_products\", [])\n        return {\n            \"success\": True,\n            \"plans\": [_safe_plan(plan) for plan in plans if isinstance(plan, dict)],\n            \"top_up_products\": [\n                _safe_top_up_product(product)\n                for product in top_up_products\n                if isinstance(product, dict) and product.get(\"active\", True)\n            ],\n            \"pricing_catalog\": raw.get(\"pricing_catalog\") or {},\n        }\n\n    async def start_subscription_checkout(\n        self,\n        ctx: Any,\n        *,\n        plan_id: str,\n        success_url: str,\n        cancel_url: str,\n        customer_email: str | None = None,\n        **_: Any,\n    ) -> dict[str, Any]:\n        if not plan_id:\n            return {\"success\": False, \"error_code\": \"INVALID_INPUT\", \"detail\": \"plan_id is required\"}\n        if not _safe_https_url(success_url) or not _safe_https_url(cancel_url):\n            return {\n                \"success\": False,\n                \"error_code\": \"INVALID_INPUT\",\n                \"detail\": \"success_url and cancel_url must be https URLs\",\n            }\n        raw = await self._client(ctx).create_subscription_checkout_session(\n            plan_id=plan_id,\n            success_url=success_url,\n            cancel_url=cancel_url,\n            customer_email=customer_email,\n            **_ctx_scope(ctx),\n        )\n        return safe_checkout_response(raw)\n\n    async def start_token_top_up(\n        self,\n        ctx: Any,\n        *,\n        product_id: str,\n        success_url: str,\n        cancel_url: str,\n        **_: Any,\n    ) -> dict[str, Any]:\n        if not product_id:\n            return {\"success\": False, \"error_code\": \"INVALID_INPUT\", \"detail\": \"product_id is required\"}\n        if not _safe_https_url(success_url) or not _safe_https_url(cancel_url):\n            return {\n                \"success\": False,\n                \"error_code\": \"INVALID_INPUT\",\n                \"detail\": \"success_url and cancel_url must be https URLs\",\n            }\n        products = [\n            product\n            for product in (_subscriptions_config().get(\"top_up_products\") or [])\n            if isinstance(product, dict) and product.get(\"product_id\") == product_id\n        ]\n        if not products:\n            return {\"success\": [REDACTED] \"error_code\": \"[REDACTED]\"}\n        product = _safe_top_up_product(products[0])\n        price = product[\"price\"]\n        if product[\"token_amount\"] <= [REDACTED] or price[\"amount_cents\"] <= [REDACTED]\n            return {\"success\": [REDACTED] \"error_code\": \"[REDACTED]\"}\n        raw = [REDACTED] self._client(ctx).create_token_top_up_session(\n            product_id=product[\"product_id\"],\n            wallet_id=product[\"wallet_id\"],\n            token_amount=[REDACTED]\"token_amount\"],\n            amount_cents=price[\"amount_cents\"],\n            currency=price[\"currency\"],\n            success_url=success_url,\n            cancel_url=cancel_url,"},{"checksum":"sha256:5ddcccba718b5fc02a75eeb3b60881c5626d5b523c72c712c02219379b2a0d02","chunk_id":"chunk_61392bcfe60f25dd","end_line":292,"path":"build_context/mozaikspay/templates/modules/billing_portal/backend/service.py","start_line":260,"symbol_ids":[],"text":"            **_ctx_scope(ctx),\n        )\n        return safe_checkout_response(raw)\n\n    async def open_billing_portal(\n        self,\n        ctx: Any,\n        *,\n        return_url: str,\n        **_: Any,\n    ) -> dict[str, Any]:\n        if not return_url:\n            return {\"success\": False, \"error_code\": \"INVALID_INPUT\", \"detail\": \"return_url is required\"}\n        if not _safe_https_url(return_url):\n            return {\"success\": False, \"error_code\": \"INVALID_INPUT\", \"detail\": \"return_url must be an https URL\"}\n        raw = await self._client(ctx).create_billing_portal_session(\n            return_url=return_url,\n            **_ctx_scope(ctx),\n        )\n        return safe_portal_response(raw)\n\n    async def handle_subscription_event(\n        self,\n        ctx: Any,\n        status: str,\n        payload: dict[str, Any],\n    ) -> dict[str, Any]:\n        return {\n            \"success\": True,\n            \"handled\": True,\n            \"status\": status,\n            \"plan_id\": payload.get(\"plan_id\"),\n        }"},{"checksum":"sha256:6641dd6286a435918e8ba5baaa6e35a99bf1a384c8d71c830a145dff01c0163c","chunk_id":"chunk_320fc60fd4b55253","end_line":28,"path":"build_context/mozaikspay/templates/modules/billing_portal/contracts/admin.yaml","start_line":1,"symbol_ids":[],"text":"schema_version: mozaiks.admin.v2\n\n# Admin panels contributed by the billing_portal facade module.\n# Two distinct panels \u2014 keep them separate:\n#   my-usage   : [REDACTED] signed-in admin's own token balance (personal)\n#   app-usage  : aggregate usage across all end users of this app (operational)\n\npanels:\n  - id: my-usage\n    label: [REDACTED] Token Usage\n    page: usage\n    order: 10\n    renderer: custom_component\n    component: AdminMyUsagePanel\n    description: >\n      Your personal AI token balance and usage this period. Balance includes\n      any top-up credits purchased. Does not include other users' consumption.\n\n  - id: app-usage\n    label: App Usage\n    page: usage\n    order: 20\n    renderer: custom_component\n    component: AdminAppUsagePanel\n    description: >\n      Aggregate AI token consumption across all end users of this app.\n      Total tokens consumed, active user count, and per-wallet balance\n      totals. Sourced from the OSS runtime ledger \u2014 provider-neutral."},{"checksum":"sha256:ea68eaaa7f1b9bb6813f888dd8ecf4330d9df3f46e05d8d60d506293ab447392","chunk_id":"chunk_9949cb89ada833f0","end_line":17,"path":"build_context/mozaikspay/templates/modules/billing_portal/contracts/profile.yaml","start_line":1,"symbol_ids":[],"text":"schema_version: mozaiks.profile.v1\n\n# Declares a Tokens tab on the user profile page (/me).\n# The platform hydrates the tab by calling get_token_status and passes the\n# result as `data` to the registered TokenStatusTab component.\n#\n# The platform also injects a built-in Tokens tab for any app whose\n# subscriptions.yaml declares token_wallets. This profile.yaml overrides\n# that built-in by claiming the same id, allowing the billing_portal module\n# to own the tab and customise the component when the mozaikspay pack is used.\n\ntabs:\n  - id: [REDACTED]\n    label: [REDACTED]\n    order: 80\n    action: [REDACTED]\n    component: [REDACTED]"},{"checksum":"sha256:b6edce9560d631e8e9572823e06678748790ec01cc5800209fd652f8a39cec92","chunk_id":"chunk_9ad9bf5d867d8e76","end_line":29,"path":"build_context/mozaikspay/templates/modules/billing_portal/contracts/reactions.yaml","start_line":1,"symbol_ids":[],"text":"schema_version: mozaiks.reactions.v1\nreactions:\n  - id: subscription_activated\n    event_type: hosted.billing.subscription.activated\n    target:\n      kind: handler\n      handler_method: handle_subscription_activated\n    description: >\n      Observe hosted subscription activation and refresh local display/cache\n      state if the generated app chooses to persist a display snapshot.\n      Read-only: never mutates hosted billing, usage, or entitlement state.\n\n  - id: subscription_updated\n    event_type: hosted.billing.subscription.updated\n    target:\n      kind: handler\n      handler_method: handle_subscription_updated\n    description: >\n      Observe hosted subscription updates and refresh local display/cache state.\n      Read-only: never mutates hosted billing, usage, or entitlement state.\n\n  - id: subscription_cancelled\n    event_type: hosted.billing.subscription.cancelled\n    target:\n      kind: handler\n      handler_method: handle_subscription_cancelled\n    description: >\n      Observe hosted subscription cancellation and refresh local display/cache\n      state. Read-only: never mutates hosted billing, usage, or entitlement state."},{"checksum":"sha256:28a5595433aabe72f17308ac12c95a1a2b84a46609f544cb7cba1d3d91b83470","chunk_id":"chunk_ef27f85cb4bd709f","end_line":194,"path":"build_context/mozaikspay/templates/modules/billing_portal/module.yaml","start_line":1,"symbol_ids":[],"text":"schema_version: mozaiks.module.v1\nmodule:\n  id: billing_portal\n  display_name: Billing Portal\n  version: 1.0.0\n  description: >\n    App-owned facade for subscription status, usage display, and customer\n    billing portal redirects through the MozaiksPay managed capability client.\n  owner: app\n  visibility: private\n  handler: backend.handler:BillingPortalHandler\n\npermissions:\n  - id: billing_portal.read\n    description: Read safe subscription and usage status summaries.\n  - id: billing_portal.manage\n    description: Create customer billing portal redirect sessions.\n\nactions:\n  - id: get_subscription_status\n    description: >\n      Return safe current plan display fields through MozaiksPayClient.\n      Never returns hosted subscription ids, payment provider customer ids, or granted\n      managed-capability capabilities.\n    handler_method: get_subscription_status\n    input_schema:\n      type: object\n      additionalProperties: false\n      properties: {}\n    output_schema:\n      type: object\n      required: [success]\n      properties:\n        success: {type: boolean}\n        found: {type: boolean}\n        plan_id: {type: string, nullable: true}\n        plan_name: {type: string, nullable: true}\n        status: {type: string, nullable: true}\n        starts_at: {type: string, nullable: true}\n        expires_at: {type: string, nullable: true}\n        on_free_plan: {type: boolean}\n    permissions: [billing_portal.read]\n\n  - id: get_usage_status\n    description: >\n      Return runtime AI token usage through MozaiksPayClient. Plan limit\n      metadata comes from app/config/subscriptions.yaml via /api/me/usage.\n    handler_method: get_usage_status\n    input_schema:\n      type: object\n      additionalProperties: false\n      properties:\n        # limit \u2014 optional; the service defaults omitted values to 500.\n        limit: {type: integer}\n    output_schema:\n      type: object\n      required: [success]\n      properties:\n        success: {type: boolean}\n        runtime_ai_usage: {type: object}\n        source: {type: string}\n    permissions: [billing_portal.read]\n\n  - id: [REDACTED]\n    description: >\n      Return runtime AI token usage plus provider-neutral token wallet and top-up\n      product metadata declared in app/config/subscriptions.yaml.\n    handler_method: [REDACTED]\n    input_schema:\n      type: object\n      additionalProperties: false\n      properties:\n        # limit \u2014 optional; the service defaults omitted values to 500.\n        limit: {type: integer}\n    output_schema:\n      type: object\n      required: [success]\n      properties:\n        success: {type: boolean}\n        runtime_ai_usage: {type: object}\n        token_wallets: [REDACTED] array}\n        top_up_products: {type: array}\n        source: {type: string}\n    permissions: [billing_portal.read]\n\n  - id: list_plans\n    description: >\n      Return the available plan catalog declared in app/config/subscriptions.yaml.\n      Safe plan display fields only \u2014 never exposes managed-capability internals\n      or granted capability identifiers. Public so the /pricing landing page can\n      render the catalog without authentication.\n    handler_method: list_plans\n    api_surface: public_readonly\n    input_schema:\n      type: object\n      additionalProperties: false\n      properties: {}\n    output_schema:\n      type: object\n      required: [success]\n      properties:\n        success: {type: boolean}\n        plans:\n          type: array\n          items:\n            type: object\n            properties:\n              plan_id: {type: string}\n              label: {type: string}\n              description: {type: string}\n              capabilities: {type: array, items: {type: string}}\n              usage_limits: {type: object}\n              token_allowances: [REDACTED] array}\n        top_up_products: {type: array}\n        pricing_catalog: {type: object}\n    permissions: []\n\n  - id: start_subscription_checkout\n    description: >\n      Create a hosted subscription checkout session through MozaiksPayClient and\n      return checkout_url for immediate redirect. The app must not store the URL.\n    handler_method: start_subscription_checkout\n    input_schema:\n      type: object\n      additionalProperties: false\n      required: [plan_id, success_url, cancel_url]\n      properties:\n        plan_id: {type: string}\n        success_url: {type: string}\n        cancel_url: {type: string}\n        # customer_email \u2014 optional; omit when unknown.\n        customer_email: {type: string}\n    output_schema:\n      type: object\n      required: [success]\n      properties:\n        success: {type: boolean}\n        checkout_url: {type: string, nullable: true}\n        success_url: {type: string, nullable: true}\n        cancel_url: {type: string, nullable: true}\n        plan_id: {type: string, nullable: true}\n        error: {type: string, nullable: true}\n    permissions: [billing_portal.manage]\n\n  - id: [REDACTED]\n    description: >\n      Create a hosted token top-up checkout session through MozaiksPayClient for\n      a provider-neutral top_up_products entry declared in subscriptions.yaml.\n      The payment provider must confirm payment before tokens are credited.\n    handler_method: [REDACTED]\n    input_schema:\n      type: object\n      additionalProperties: false\n      required: [product_id, success_url, cancel_url]\n      properties:\n        product_id: {type: string}\n        success_url: {type: string}\n        cancel_url: {type: string}\n    output_schema:\n      type: object\n      required: [success]\n      properties:\n        success: {type: boolean}\n        checkout_url: {type: string, nullable: true}\n        success_url: {type: string, nullable: true}\n        cancel_url: {type: string, nullable: true}\n        product_id: {type: string, nullable: true}\n        wallet_id: {type: string, nullable: true}\n        token_amount: [REDACTED] integer, nullable: [REDACTED]\n        amount_cents: {type: integer, nullable: true}\n        currency: {type: string, nullable: true}\n        error: {type: string, nullable: true}\n    permissions: [billing_portal.manage]\n\n  - id: open_billing_portal\n    description: >\n      Create a hosted billing portal session through MozaiksPayClient and\n      return the portal_url for immediate redirect. The app must not store the URL.\n    handler_method: open_billing_portal\n    input_schema:\n      type: object\n      additionalProperties: false\n      required: [return_url]\n      properties:\n        return_url: {type: string}\n    output_schema:\n      type: object\n      required: [success]\n      properties:\n        success: {type: boolean}\n        portal_url: {type: string, nullable: true}\n        return_url: {type: string, nullable: true}\n        error: {type: string, nullable: true}\n    permissions: [billing_portal.manage]"},{"checksum":"sha256:2142a3c37541b19dcb4fd60cf0d92faee56b1cc71beba5a15507b1e3b8af20f4","chunk_id":"chunk_67419cb8a9030775","end_line":232,"path":"build_context/mozaikspay/templates/services/integrations/mozaikspay_client.py","start_line":1,"symbol_ids":["sym_86c86d3658d784b5","sym_14949ffdebc74692","sym_d8c2181d1a9eb570","sym_c6dd5b566acf82b4","sym_83e5157087a3f128","sym_e386af098c1892ad","sym_5b3235786fbb2915","sym_e52265dbb6213d79","sym_f0a1f231ebfae16f","sym_b0ffd451860e9954","sym_36c9c32709f9f457","sym_ef6391a47d5769fb","sym_97598fe61b2a1afd","sym_8638909ec7edea80","sym_282789092233b31a","sym_8c10b8e2f575b47c","sym_2241db68a2f4d139","sym_7c2c7364c4850203","sym_ba567a9eaa1fbfa7","sym_acce1ab3661d95df"],"text":"\"\"\"Thin MozaiksPay billing client for generated SaaS apps.\n\nThis file is copied to:\n    services/integrations/mozaikspay_client.py\n\nIt is consumer-side adapter code. It must not import provider-owned modules,\ncall payment provider directly, store secrets, or create a token usage ledger.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nfrom collections.abc import Awaitable, Callable\nfrom dataclasses import dataclass\nfrom typing import Any\n\nimport httpx\n\n_DEFAULT_TIMEOUT = 20.0\n_MAX_RETRIES = 2\n_CONNECTOR_SERVICE = \"mozaikspay\"\n_PROVIDER_API_PREFIX = \"/api/mozaikspay/v1\"\n_CONTRACT_VERSION = \"mozaiks.provider_api_contract.v1\"\n\n\nclass MozaiksPayError(Exception):\n    \"\"\"Base exception for MozaiksPay client errors.\"\"\"\n\n\nclass MozaiksPayConfigurationError(MozaiksPayError):\n    \"\"\"Raised when MozaiksPay provider config is unavailable.\"\"\"\n\n\nclass MozaiksPayHTTPError(MozaiksPayError):\n    \"\"\"Raised when the platform returns a non-2xx HTTP status.\"\"\"\n\n    def __init__(self, status_code: int, detail: str = \"\") -> None:\n        self.status_code = status_code\n        super().__init__(f\"HTTP {status_code}: {detail}\")\n\n\nclass MozaiksPayApplicationError(MozaiksPayError):\n    \"\"\"Raised when the platform returns success=false.\"\"\"\n\n    def __init__(self, error: str) -> None:\n        self.error = error\n        super().__init__(error)\n\n\n@dataclass(frozen=True)\nclass MozaiksPayConnectorSettings:\n    api_base: str | None = None\n    api_key: [REDACTED] | None = [REDACTED]\n    client_id: str | None = None\n    client_secret: [REDACTED] | None = [REDACTED]\n    runtime_base: str | None = None\n    source: str = \"unconfigured\"\n\n    @property\n    def has_provider_credentials(self) -> bool:\n        return bool(self.api_base and (self.api_key or (self.client_id and self.client_secret)))\n\n\nConnectorSettingsLoader = Callable[[str | None], Awaitable[MozaiksPayConnectorSettings | None]]\n\n\ndef _clean(value: Any) -> str:\n    return str(value or \"\").strip()\n\n\ndef _env_settings() -> MozaiksPayConnectorSettings:\n    api_base = _clean(os.getenv(\"MOZAIKSPAY_API_BASE\")) or None\n    runtime_base = _clean(os.getenv(\"MOZAIKS_APP_URL\")) or None\n    return MozaiksPayConnectorSettings(\n        api_base=api_base,\n        api_key=[REDACTED]\"MOZAIKSPAY_API_KEY\")) or None,\n        client_id=_clean(os.getenv(\"MOZAIKSPAY_CLIENT_ID\")) or None,\n        client_secret=[REDACTED]\"MOZAIKSPAY_CLIENT_SECRET\")) or None,\n        runtime_base=runtime_base,\n        source=\"env\",\n    )\n\n\nasync def _load_connector_settings(app_id: str | None) -> MozaiksPayConnectorSettings | None:\n    \"\"\"Load app-scoped MozaiksPay connector config when Studio stored it.\n\n    The connector record stores only frontend-safe config. The client secret is\n    fetched from the configured connector vault. Missing or unavailable vault\n    state falls back to environment variables in the caller.\n    \"\"\"\n\n    if not app_id:\n        return None\n    try:\n        from mozaiksai.core.data.persistence.connector_store import ConnectorStore\n        from mozaiksai.core.secrets import get_connector_vault_backend\n\n        record = await ConnectorStore().get(scope=ConnectorStore.SCOPE_APP, scope_id=str(app_id), service=_CONNECTOR_SERVICE)\n        if not isinstance(record, dict):\n            return None\n        raw_public_config = record.get(\"public_config\")\n        public_config: dict[str, Any] = raw_public_config if isinstance(raw_public_config, dict) else {}\n        secret_result = [REDACTED] get_connector_vault_backend().get_secret(\n            scope_id=str(app_id),\n            service=_CONNECTOR_SERVICE,\n        )\n        credential = [REDACTED]\"secret_value\")) if isinstance(secret_result, dict) else \"\"\n        api_base = _clean(public_config.get(\"api_base\")) or _clean(public_config.get(\"base_url\")) or None\n        client_id = _clean(public_config.get(\"client_id\")) or None\n        runtime_base = _clean(public_config.get(\"runtime_base\")) or _clean(os.getenv(\"MOZAIKS_APP_URL\")) or None\n        api_key = [REDACTED] if not client_id else \"\"\n        client_secret = [REDACTED] if client_id else \"\"\n        if not any([api_base, api_key, client_id, client_secret]):\n            return None\n        return MozaiksPayConnectorSettings(\n            api_base=api_base,\n            api_key=[REDACTED] or None,\n            client_id=client_id,\n            client_secret=[REDACTED] or None,\n            runtime_base=runtime_base,\n            source=\"connector\",\n        )\n    except Exception:\n        return None\n\n\ndef _authorization_header(value: str) -> str:\n    return value if value.lower().startswith((\"bearer \", \"basic \")) else f\"Bearer {value}\"\n\n\nclass MozaiksPayClient:\n    \"\"\"App-side client for MozaiksPay SaaS billing surfaces.\"\"\"\n\n    def __init__(\n        self,\n        api_base: str | None = None,\n        runtime_base: str | None = None,\n        api_key: [REDACTED] | None = [REDACTED]\n        client_id: str | None = None,\n        client_secret: [REDACTED] | None = [REDACTED]\n        auth_token: [REDACTED] | None = [REDACTED]\n        app_id: str | None = None,\n        timeout_seconds: float = _DEFAULT_TIMEOUT,\n        connector_settings_loader: ConnectorSettingsLoader | None = None,\n    ) -> None:\n        self._api_base = _clean(api_base) or None\n        self._runtime_base = _clean(runtime_base) or None\n        self._api_key = [REDACTED] or None\n        self._client_id = _clean(client_id) or None\n        self._client_secret = [REDACTED] or None\n        self._auth_token = [REDACTED] or None\n        self._app_id = _clean(app_id) or None\n        self._timeout = timeout_seconds\n        self._connector_settings_loader = connector_settings_loader or _load_connector_settings\n        self._settings_cache: MozaiksPayConnectorSettings | None = None\n\n    async def get_subscription_status(self) -> dict[str, Any]:\n        \"\"\"Return safe plan display fields from MozaiksPay.\"\"\"\n        return await self.get_subscription_status_for_scope()\n\n    async def readiness(self) -> dict[str, Any]:\n        \"\"\"Return provider readiness without activating billing or mutating state.\"\"\"\n        settings = await self._settings()\n        self._require_provider_credentials(settings)\n        api_base = settings.api_base\n        if not api_base:\n            raise MozaiksPayConfigurationError(\"MozaiksPay provider API base is required.\")\n        return await self._request(\n            \"GET\",\n            f\"{api_base.rstrip('/')}{_PROVIDER_API_PREFIX}/health\",\n            settings=settings,\n            provider_auth=True,\n        )\n\n    async def get_subscription_status_for_scope(\n        self,\n        *,\n        user_id: str | None = None,\n        tenant_id: str | None = None,\n        workspace_id: str | None = None,\n    ) -> dict[str, Any]:\n        \"\"\"Return safe plan display fields for an app-owned billing scope.\"\"\"\n        settings = await self._settings()\n        self._require_provider_credentials(settings)\n        api_base = settings.api_base\n        if not api_base:\n            raise MozaiksPayConfigurationError(\"MozaiksPay provider API base is required.\")\n        return await self._request(\n            \"GET\",\n            f\"{api_base.rstrip('/')}{_PROVIDER_API_PREFIX}/subscription/status\",\n            params=_scope_params(user_id=user_id, tenant_id=tenant_id, workspace_id=workspace_id),\n            settings=settings,\n            provider_auth=True,\n        )\n\n    async def get_usage_status(self, *, limit: int = 500) -> dict[str, Any]:\n        \"\"\"Return runtime AI token usage for the current app user.\"\"\"\n        return await self.get_runtime_ai_usage(limit=limit)\n\n    async def get_runtime_ai_usage(self, *, limit: int = 500) -> dict[str, Any]:\n        \"\"\"Return OSS runtime AI usage from this generated app's /api/me/usage.\"\"\"\n        settings = await self._settings()\n        runtime_base = (settings.runtime_base or \"\").rstrip(\"/\")\n        if not runtime_base:\n            raise MozaiksPayConfigurationError(\n                \"MOZAIKS_APP_URL is not set. Configure the generated app runtime URL for usage display; \"\n                \"MOZAIKSPAY_API_BASE is only the MozaiksPay provider host.\"\n            )\n        bounded_limit = max(1, min(int(limit or 1), 1000))\n        return await self._request(\n            \"GET\",\n            f\"{runtime_base}/api/me/usage?limit={bounded_limit}\",\n            settings=settings,\n            provider_auth=False,\n        )\n\n    async def create_billing_portal_session(\n        self,\n        *,\n        return_url: str,\n        user_id: str | None = None,\n        tenant_id: str | None = None,\n        workspace_id: str | None = None,\n    ) -> dict[str, Any]:\n        \"\"\"Create a hosted billing portal redirect session.\"\"\"\n        settings = await self._settings()\n        self._require_provider_credentials(settings)\n        api_base = settings.api_base\n        if not api_base:\n            raise MozaiksPayConfigurationError(\"MozaiksPay provider API base is required.\")\n        payload = {\n            \"return_url\": return_url,"},{"checksum":"sha256:ca3aecff47ce131c49b86ad5672ff90d9514cfda635c3180b2c643e5ffb082e5","chunk_id":"chunk_4dd9a7db14d4ba97","end_line":417,"path":"build_context/mozaikspay/templates/services/integrations/mozaikspay_client.py","start_line":233,"symbol_ids":["sym_97598fe61b2a1afd","sym_acce1ab3661d95df","sym_b3d063ecc14c35b8","sym_5ecd242b117d15ee","sym_e9d75ce89cbd0deb","sym_e0a07f91a5c96cbe"],"text":"            **_scope_params(user_id=user_id, tenant_id=tenant_id, workspace_id=workspace_id),\n        }\n        return await self._request(\n            \"POST\",\n            f\"{api_base.rstrip('/')}{_PROVIDER_API_PREFIX}/billing-portal/session\",\n            json=payload,\n            settings=settings,\n            provider_auth=True,\n        )\n\n    async def create_subscription_checkout_session(\n        self,\n        *,\n        plan_id: str,\n        success_url: str,\n        cancel_url: str,\n        customer_email: str | None = None,\n        user_id: str | None = None,\n        tenant_id: str | None = None,\n        workspace_id: str | None = None,\n    ) -> dict[str, Any]:\n        \"\"\"Create a hosted subscription checkout redirect session.\"\"\"\n        settings = await self._settings()\n        self._require_provider_credentials(settings)\n        api_base = settings.api_base\n        if not api_base:\n            raise MozaiksPayConfigurationError(\"MozaiksPay provider API base is required.\")\n        payload = {\n            \"plan_id\": plan_id,\n            \"success_url\": success_url,\n            \"cancel_url\": cancel_url,\n            \"customer_email\": _clean(customer_email),\n            **_scope_params(user_id=user_id, tenant_id=tenant_id, workspace_id=workspace_id),\n        }\n        return await self._request(\n            \"POST\",\n            f\"{api_base.rstrip('/')}{_PROVIDER_API_PREFIX}/subscription/checkout-session\",\n            json=payload,\n            settings=settings,\n            provider_auth=True,\n        )\n\n    async def create_token_top_up_session(\n        self,\n        *,\n        product_id: str,\n        success_url: str,\n        cancel_url: str,\n        wallet_id: str,\n        token_amount: [REDACTED]\n        amount_cents: int,\n        currency: str = \"usd\",\n        user_id: str | None = None,\n        tenant_id: str | None = None,\n        workspace_id: str | None = None,\n    ) -> dict[str, Any]:\n        \"\"\"Create a hosted token top-up checkout session when the provider supports it.\"\"\"\n        settings = await self._settings()\n        self._require_provider_credentials(settings)\n        api_base = settings.api_base\n        if not api_base:\n            raise MozaiksPayConfigurationError(\"MozaiksPay provider API base is required.\")\n        payload: dict[str, Any] = {\n            \"product_id\": product_id,\n            \"wallet_id\": wallet_id,\n            \"token_amount\": [REDACTED]\n            \"amount_cents\": int(amount_cents),\n            \"currency\": currency,\n            \"success_url\": success_url,\n            \"cancel_url\": cancel_url,\n            **_scope_params(user_id=user_id, tenant_id=tenant_id, workspace_id=workspace_id),\n        }\n        return await self._request(\n            \"POST\",\n            f\"{api_base.rstrip('/')}{_PROVIDER_API_PREFIX}/tokens/top-up-session\",\n            json=payload,\n            settings=settings,\n            provider_auth=True,\n        )\n\n    async def _settings(self) -> MozaiksPayConnectorSettings:\n        if self._settings_cache is not None:\n            return self._settings_cache\n\n        connector = await self._connector_settings_loader(self._app_id)\n        env = _env_settings()\n        settings = MozaiksPayConnectorSettings(\n            api_base=self._api_base or (connector.api_base if connector else None) or env.api_base,\n            api_key=[REDACTED] or (connector.api_key if connector else None) or env.api_key,\n            client_id=self._client_id or (connector.client_id if connector else None) or env.client_id,\n            client_secret=[REDACTED] or (connector.client_secret if connector else None) or env.client_secret,\n            runtime_base=self._runtime_base or (connector.runtime_base if connector else None) or env.runtime_base,\n            source=\"[REDACTED]\" if self._api_base or self._api_key or self._client_id or self._client_secret else (connector.source if connector else env.source),\n        )\n        if not settings.api_base:\n            raise MozaiksPayConfigurationError(\n                \"MozaiksPay is not configured. Add the mozaikspay connector or set MOZAIKSPAY_API_BASE.\"\n            )\n        self._settings_cache = settings\n        return settings\n\n    @staticmethod\n    def _require_provider_credentials(settings: [REDACTED] -> None:\n        if not settings.has_provider_credentials:\n            raise MozaiksPayConfigurationError(\n                \"MozaiksPay provider credentials are required. Configure the mozaikspay \"\n                \"connector with api_base and api_key, or set MOZAIKSPAY_API_KEY. \"\n                \"Client ID and client secret credentials are also accepted when issued \"\n                \"by the hosted MozaiksPay service.\"\n            )\n\n    async def _request(\n        self,\n        method: str,\n        url: str,\n        *,\n        json: dict[str, Any] | None = None,\n        params: dict[str, str] | None = None,\n        settings: MozaiksPayConnectorSettings,\n        provider_auth: bool,\n    ) -> dict[str, Any]:\n        headers: dict[str, str] = {\n            \"Content-Type\": \"application/json\",\n            \"X-MozaiksPay-Contract-Version\": _CONTRACT_VERSION,\n        }\n        provider_credential = [REDACTED] or settings.client_secret\n        if provider_auth and provider_credential:\n            if not settings.api_key and settings.client_id:\n                headers[\"X-MozaiksPay-Client-Id\"] = settings.client_id\n            headers[\"Authorization\"] = [REDACTED]\n        elif self._auth_token:\n            headers[\"Authorization\"] = [REDACTED]\n\n        response: httpx.Response | None = None\n        last_error: Exception | None = None\n        for attempt in range(_MAX_RETRIES + 1):\n            try:\n                async with httpx.AsyncClient(timeout=self._timeout) as client:\n                    response = await client.request(method, url, json=json, params=params, headers=headers)\n                if response.status_code not in {408, 429, 500, 502, 503, 504}:\n                    break\n            except (httpx.TimeoutException, httpx.RequestError) as exc:\n                last_error = exc\n                if attempt >= _MAX_RETRIES:\n                    detail = \"Request timed out\" if isinstance(exc, httpx.TimeoutException) else \"Network error\"\n                    raise MozaiksPayHTTPError(0, f\"{detail}: {exc}\") from exc\n                continue\n\n        if response is None:\n            raise MozaiksPayHTTPError(0, f\"Network error: {last_error}\")\n\n        if not response.is_success:\n            detail = \"\"\n            try:\n                detail = response.json().get(\"detail\") or response.text[:200]\n            except Exception:\n                detail = response.text[:200]\n            raise MozaiksPayHTTPError(response.status_code, detail)\n\n        try:\n            data: dict[str, Any] = response.json()\n        except Exception as exc:\n            raise MozaiksPayHTTPError(response.status_code, \"Non-JSON response body\") from exc\n\n        if data.get(\"success\") is False and \"error\" in data:\n            raise MozaiksPayApplicationError(str(data[\"error\"]))\n\n        return data\n\n\ndef _scope_params(\n    *,\n    user_id: str | None = None,\n    tenant_id: str | None = None,\n    workspace_id: str | None = None,\n) -> dict[str, str]:\n    return {\n        key: value\n        for key, value in {\n            \"user_id\": _clean(user_id),\n            \"tenant_id\": _clean(tenant_id),\n            \"workspace_id\": _clean(workspace_id),\n        }.items()\n        if value\n    }"},{"checksum":"sha256:277d1910a9f4191586f6402fee48df21dac11726be88df3492da99cd7a23758e","chunk_id":"chunk_2cd0b1a374ff5906","end_line":132,"path":"build_context/mozaikspay/templates/services/integrations/wallet_client.py","start_line":1,"symbol_ids":["sym_2a2d41006e0fdf50","sym_a31616e8753f2f1c","sym_6460d50b1a0929d4","sym_1d2beb68e96ca885","sym_62c8206cd4ab54b6","sym_bce4c6e5a132be50","sym_cd874aa85f7d8be9","sym_6d98b3e0f0748b8f","sym_6aaa7d5967f0c414"],"text":"\"\"\"Thin MozaiksPay wallet client for generated apps.\n\nDORMANT SURFACE \u2014 DO NOT WIRE UP YET. The hosted wallet API this client\ntargets (/api/mozaikspay/v1/wallet/*) is not published by any MozaiksPay\nprovider deployment today; every call returns 404. The file ships only so\nthe integration seam stays versioned with the rest of the pack. Do not\ncall it from generated modules or pages until the provider publishes the\nwallet endpoints and this notice is removed.\n\nThis file is copied to:\n    services/integrations/wallet_client.py\n\nConsumer-side adapter only. Must not import provider-owned modules, call the\npayment provider directly, store secrets, or contain entitlement logic.\nEntitlement gates are enforced at the module action dispatcher level.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nfrom typing import Any, cast\n\nimport httpx\n\n_DEFAULT_TIMEOUT = 20.0\n_WALLET_API_PREFIX = \"/api/mozaikspay/v1/wallet\"\n\n\nclass WalletClientError(Exception):\n    \"\"\"Base exception for wallet client errors.\"\"\"\n\n\nclass WalletClientConfigurationError(WalletClientError):\n    \"\"\"Raised when the wallet client cannot be configured.\"\"\"\n\n\ndef _clean(value: str | None) -> str:\n    return (value or \"\").strip()\n\n\nclass WalletClient:\n    \"\"\"HTTP client for the MozaiksPay wallet runtime API.\n\n    Reads MOZAIKS_APP_URL (or explicit runtime_base) and INTERNAL_API_KEY\n    to call the hosted wallet endpoints. Self-hosted apps set AUTH_ENABLED=false\n    or pass a bearer token to authenticate the internal calls.\n    \"\"\"\n\n    def __init__(\n        self,\n        *,\n        runtime_base: str | None = None,\n        auth_token: [REDACTED] | None = [REDACTED]\n        timeout: float = _DEFAULT_TIMEOUT,\n    ) -> None:\n        self._runtime_base = _clean(runtime_base) or _clean(os.getenv(\"MOZAIKS_APP_URL\")) or None\n        self._auth_token = [REDACTED] or _clean(os.getenv(\"INTERNAL_API_KEY\")) or None\n        self._timeout = timeout\n\n    def _base(self) -> str:\n        if not self._runtime_base:\n            raise WalletClientConfigurationError(\n                \"WalletClient requires MOZAIKS_APP_URL or explicit runtime_base.\"\n            )\n        return self._runtime_base.rstrip(\"/\")\n\n    def _headers(self) -> dict[str, str]:\n        headers: dict[str, str] = {\"Content-Type\": \"application/json\"}\n        if self._auth_token:\n            headers[\"Authorization\"] = [REDACTED]\"Bearer {self._auth_token}\"\n        return headers\n\n    async def get_balance(\n        self,\n        *,\n        app_id: str,\n        user_id: str | None = None,\n        tenant_id: str | None = None,\n        workspace_id: str | None = None,\n    ) -> dict[str, Any]:\n        \"\"\"Return the token wallet balance for the given scope.\"\"\"\n        params: dict[str, str] = {\"app_id\": app_id}\n        if user_id:\n            params[\"user_id\"] = user_id\n        if tenant_id:\n            params[\"tenant_id\"] = tenant_id\n        if workspace_id:\n            params[\"workspace_id\"] = workspace_id\n        async with httpx.AsyncClient(timeout=self._timeout) as client:\n            res = await client.get(\n                f\"{self._base()}{_WALLET_API_PREFIX}/balance\",\n                headers=self._headers(),\n                params=params,\n            )\n            res.raise_for_status()\n            return cast(dict[str, Any], res.json())\n\n    async def debit(\n        self,\n        *,\n        app_id: str,\n        amount: int,\n        reason: str,\n        idempotency_key: str,\n        user_id: str | None = None,\n        tenant_id: str | None = None,\n        workspace_id: str | None = None,\n        metadata: dict[str, Any] | None = None,\n    ) -> dict[str, Any]:\n        \"\"\"Debit tokens from the wallet for the given scope.\"\"\"\n        body: dict[str, Any] = {\n            \"app_id\": app_id,\n            \"amount\": amount,\n            \"reason\": reason,\n            \"idempotency_key\": idempotency_key,\n        }\n        if user_id:\n            body[\"user_id\"] = user_id\n        if tenant_id:\n            body[\"tenant_id\"] = tenant_id\n        if workspace_id:\n            body[\"workspace_id\"] = workspace_id\n        if metadata:\n            body[\"metadata\"] = metadata\n        async with httpx.AsyncClient(timeout=self._timeout) as client:\n            res = await client.post(\n                f\"{self._base()}{_WALLET_API_PREFIX}/debit\",\n                headers=self._headers(),\n                json=body,\n            )\n            res.raise_for_status()\n            return cast(dict[str, Any], res.json())"},{"checksum":"sha256:e77c430d4477163f43d80d61b358ec29cc5693db25ff3d4773854655ac636501","chunk_id":"chunk_fb67b82726f049e0","end_line":41,"path":"build_context/mozaikspay/templates/ui/pages/billing.yaml","start_line":1,"symbol_ids":[],"text":"schema_version: mozaiks.app_page.v1\nname: Billing\nroute: /billing\ntitle: Billing\npage_type: analytics_dashboard\nlayout: full-width\nshell_mode: workspace\nnavigation:\n  id: billing\n  label: Billing\n  icon: CreditCard\n  scope: global\n  order: 70\n  visible: true\nsections:\n  - id: billing-status\n    primitive: DataTable\n    title: Current Plan\n    config:\n      api_endpoint: /api/modules/billing_portal/get_subscription_status\n      columns:\n        - key: plan_name\n          label: Plan\n        - key: status\n          label: Status\n  - id: billing-catalog\n    primitive: PricingCatalog\n    title: [REDACTED] and Token Packs\n    config:\n      api_endpoint: /api/modules/billing_portal/list_plans\n      plans_key: plans\n      add_ons_key: top_up_products\n  - id: manage-billing\n    primitive: ActionButton\n    title: Manage Billing\n    config:\n      actions:\n        - label: Manage Billing\n          action_type: submit\n          href: /api/modules/billing_portal/open_billing_portal\nroles: null"},{"checksum":"sha256:416a714d2e4725760d909f2e3cda1c2211cf6f156e6da18ab412b0e6fd738b58","chunk_id":"chunk_dcb687259477d2c4","end_line":38,"path":"build_context/mozaikspay/templates/ui/pages/pricing.yaml","start_line":1,"symbol_ids":[],"text":"schema_version: mozaiks.app_page.v1\nname: Pricing\nroute: /pricing\ntitle: Pricing\npage_type: landing\nlayout: full-width\nshell_mode: standard\nnavigation:\n  id: pricing\n  label: Pricing\n  icon: CreditCard\n  scope: global\n  order: 90\n  visible: false\nsections:\n  - id: plan-catalog\n    primitive: PricingCatalog\n    config:\n      title: Plans\n      subtitle: Choose the plan that matches the app usage you need.\n      api_endpoint: /api/modules/billing_portal/list_plans\n      plans_key: plans\n      groups_key: pricing_catalog.groups\n      default_group_key: pricing_catalog.default_group_id\n      plan_action_label: Manage billing\n      plan_action:\n        label: Manage billing\n        action_type: navigate\n        href: /billing\n  - id: upgrade-cta\n    primitive: ActionButton\n    title: Upgrade\n    config:\n      actions:\n        - label: Manage Billing\n          action_type: submit\n          href: /api/modules/billing_portal/open_billing_portal\nroles: null"},{"checksum":"sha256:3f10cff2fcd6832cad68297faf0efefab9e576e0c0aba4ce342005702e389098","chunk_id":"chunk_80a064b23b6c291d","end_line":35,"path":"build_context/mozaikspay/templates/ui/pages/usage.yaml","start_line":1,"symbol_ids":[],"text":"schema_version: mozaiks.app_page.v1\nname: Usage\nroute: /usage\ntitle: Usage\npage_type: analytics_dashboard\nlayout: full-width\nshell_mode: workspace\nnavigation:\n  id: usage\n  label: Usage\n  icon: Gauge\n  scope: global\n  order: 75\n  visible: true\nsections:\n  - id: usage-status\n    primitive: DataTable\n    title: Usage\n    config:\n      api_endpoint: /api/modules/billing_portal/get_usage_status\n      columns:\n        - key: [REDACTED]\n          label: [REDACTED] Tokens\n        - key: runtime_ai_usage.totals.llm_calls\n          label: LLM Calls\n  - id: [REDACTED]\n    primitive: SummaryStrip\n    title: [REDACTED] Balance\n    config:\n      items:\n        - label: Wallets\n          value_key: [REDACTED]\n        - label: Top Ups\n          value_key: top_up_products\nroles: null"},{"checksum":"sha256:b863c92252d136572a884cda6d6b05eb689f79afa91e4b5603f3c357e4df640e","chunk_id":"chunk_dcec08560543d002","end_line":22,"path":"build_context/notifications/context.yaml","start_line":1,"symbol_ids":[],"text":"context_id: notifications\napplies_to_workflows:\n  - AppGenerator\nassets:\n  - path: contract.yaml\n    kind: contract\n  - path: templates/\n    kind: templates\npack:\n  id: notifications\n  version: \"0.1.11\"\n  status: active\n  capability_source: generated_module\ncapabilities:\n  - capability_id: notifications.email.send\n    facade_recommended: notification_settings\n  - capability_id: notifications.push.send\n    facade_recommended: notification_settings\n  - capability_id: notifications.preferences.read\n    facade_recommended: notification_settings\n  - capability_id: notifications.preferences.write\n    facade_recommended: notification_settings"},{"checksum":"sha256:a584366a9bb0e6a7ae913de7fcdf59480bdc4a44ad4bbc94bd3b26fc39009b05","chunk_id":"chunk_177947d5b9bd5cdc","end_line":196,"path":"build_context/notifications/contract.yaml","start_line":1,"symbol_ids":[],"text":"contract_id: notifications\ncontract_type: build_pack_instructions\n\n# The notifications operator_pack is for EXTERNAL notification delivery\n# (email, push, SMS) beyond the runtime in-app notification record.\n#\n# The runtime already provides in-app notification storage and websocket\n# delivery \u2014 modules declare these in contracts/notifications.yaml on the\n# event-producing module. Select this pack only when the app must deliver\n# domain-event alerts through a provider-backed external channel.\n#\n# Generated outputs are all owner: generator because external delivery\n# adapters are highly provider-specific and must be customized per-app.\n# AppGenerator generates provider-neutral stubs; operators fill in their\n# chosen provider (SendGrid, AWS SES, Firebase, Twilio, etc.).\n\nselection_rules:\n  - id: select_for_external_delivery\n    when:\n      intent_any:\n        - email notifications\n        - push notifications\n        - sms notifications\n        - email alerts\n        - email delivery\n        - transactional email\n        - push alerts\n        - mobile push\n        - text message alerts\n        - external notification delivery\n    action: select_pack\n  - id: confirm_for_generic_notifications\n    when:\n      intent_any:\n        - notifications\n        - alerts\n        - in-app notifications\n        - notification center\n    action: require_explicit_user_confirmation\n\nrecommended_domains:\n  - saas\n  - community\n  - marketplace\n  - social\n  - ecommerce\n\navoid_when:\n  - App only needs in-app alerts and notification center \u2014 declare contracts/notifications.yaml on the event-producing module instead.\n  - App uses a managed notification platform that handles external delivery \u2014 use that platform's client as a managed_capability or service integration.\n\n# All required outputs are owner: generator because external delivery adapters\n# are provider-specific and must be customized per deployment target.\n# AppGenerator produces provider-neutral stubs. Operators select their\n# provider and fill in credentials + API calls in the adapter.\nrequired_outputs:\n  - path: modules/notification_settings/module.yaml\n    owner: templates\n    notes: >\n      User-facing notification preference module. Actions:\n      get_notification_preferences (reads user opt-ins for email, push, sms),\n      update_notification_preferences (sets per-channel opt-in).\n      user_data_scope: true. No entitlement_gate \u2014 all users may manage\n      their own preferences.\n\n  - path: modules/notification_settings/backend/base_handler.py\n    owner: templates\n    notes: DO NOT EDIT \u2014 regenerated from contract. NotificationSettingsBaseHandler base class.\n\n  - path: modules/notification_settings/backend/handler.py\n    owner: workspace\n    notes: Preserved across regeneration. Subclasses base_handler.py. Thin dispatch only.\n\n  - path: modules/notification_settings/backend/service.py\n    owner: templates\n    notes: >\n      get_notification_preferences and update_notification_preferences.\n      Merges defaults with stored preferences; never calls provider adapters directly.\n\n  - path: modules/notification_settings/backend/repo.py\n    owner: templates\n    notes: Persists preference records to notifications.preferences data alias via ctx.persistence.\n\n  - path: modules/notification_settings/backend/schemas.py\n    owner: templates\n    notes: notification_preferences_doc, preferences_response typed helpers with per-channel opt-in booleans.\n\n  - path: modules/notification_settings/backend/account_data_handler.py\n    owner: templates\n    notes: >\n      GDPR handler \u2014 delete_user_data deletes preference records;\n      export_user_data returns opt-in state. Required because user_data_scope: true.\n\n  - path: modules/notification_settings/contracts/reactions.yaml\n    owner: templates\n    notes: >\n      Stub reactions file. Operators add one reaction per domain event that should\n      trigger external delivery. Reactions call service handler methods that\n      delegate to services/adapters/notifications/.\n\n  - path: services/adapters/notifications/email.py\n    owner: templates\n    notes: >\n      Provider-neutral email adapter stub. Declares send_email(to, subject, body, template_id).\n      Operators replace the stub body with their chosen provider SDK (SendGrid,\n      AWS SES, Postmark, Mailgun). No provider credentials committed.\n\n  - path: services/adapters/notifications/push.py\n    owner: templates\n    notes: >\n      Provider-neutral push adapter stub. Declares send_push(token, title, body, data).\n      Operators fill in their chosen push provider (Firebase FCM, APNs, OneSignal).\n\n  - path: data/migrations/001_notification_preferences_collection.json\n    owner: templates\n    notes: >\n      Declares notifications.preferences data alias for the notification_settings\n      module. Does NOT create notification delivery log collections \u2014 those belong\n      in the external provider.\n\nforbidden_outputs:\n  - path_prefix: modules/notifications/\n    reason: >\n      The module must be named notification_settings (user preferences), not notifications.\n      The runtime already owns in-app notification delivery under the notifications namespace.\n  - path_prefix: services/notification_delivery/\n    reason: External delivery mechanics belong in services/adapters/notifications/ only.\n  - path_prefix: modules/notification_delivery/\n    reason: Delivery logic belongs in service adapters, not a separate module.\n  - path_prefix: services/email/\n    reason: Email mechanics belong in services/adapters/notifications/email.py.\n  - path_prefix: services/push/\n    reason: Push mechanics belong in services/adapters/notifications/push.py.\n\nruntime_boundaries:\n  - id: no_duplicate_in_app_channel\n    rule: >\n      Do not re-implement in-app notification storage or websocket delivery.\n      The runtime provides these. Generated code must not create a custom\n      notification repo, custom websocket worker, or custom notification center.\n      In-app alerts are declared in contracts/notifications.yaml on the\n      event-producing module and handled by the runtime.\n\n  - id: adapter_pattern_only\n    rule: >\n      External delivery mechanics live in services/adapters/notifications/{channel}.py.\n      The notification_settings module calls these adapters from reactions; it does not\n      embed provider SDK calls directly in service.py.\n\n  - id: preferences_are_user_data\n    rule: >\n      Notification preferences (email opt-in, push opt-in, sms opt-in) are\n      user-owned PII. notification_settings module must declare user_data_scope: true\n      and generate backend/account_data_handler.py.\n\n  - id: [REDACTED]\n    rule: >\n      Generated adapter stubs must not include provider API keys, secrets,\n      or credential values. Credentials are loaded from env vars\n      (EMAIL_API_KEY, FCM_SERVER_KEY, etc.) at adapter initialization.\n      env.example must list required credential names.\n\n  - id: reactions_not_service_calls\n    rule: >\n      External delivery is triggered by reactions in contracts/reactions.yaml\n      that observe well-known domain events. Service.py must not poll for\n      events or call delivery adapters on every action \u2014 reactions decouple\n      delivery from module business logic.\n\n  - id: provider_neutral_interface\n    rule: >\n      Adapter methods (send_email, send_push) must accept only provider-neutral\n      arguments (to, subject, body, data). Provider SDK details are encapsulated\n      in the adapter. Generated service code depends only on the adapter interface,\n      not on a specific SDK.\n\nfacades: []\n\ncross_pack_integrations:\n  - pack_id: messaging\n    description: >\n      When the messaging pack is selected alongside notifications, message_sent\n      events may trigger email or push delivery for offline participants.\n      The messaging module's contracts/notifications.yaml covers in-app delivery;\n      the notification_settings reactions.yaml covers external delivery for\n      the same events.\n  - pack_id: social\n    description: >\n      Friend request accepted, post liked, and comment received events may trigger\n      push notifications. Social pack reactions are the source; notification_settings\n      reactions route to the external adapter.\n  - pack_id: commerce\n    description: >\n      Order placed, shipped, and delivered events are common transactional email\n      triggers. Commerce reactions are the source; notification_settings routes\n      domain.commerce.* events to the email adapter."},{"checksum":"sha256:f6396b733c70556728f8cd4c6521534b6821e11dfd3b95012c931dd353082b3a","chunk_id":"chunk_985be7d0031f3a9c","end_line":20,"path":"build_context/notifications/templates/data/migrations/001_notification_preferences_collection.json","start_line":1,"symbol_ids":[],"text":"{\n  \"migration_id\": \"001_notification_preferences_collection\",\n  \"module\": \"notification_settings\",\n  \"description\": \"Declare the notifications.preferences data alias for notification_settings module preference records.\",\n  \"aliases\": [\n    {\n      \"alias\": \"notifications.preferences\",\n      \"collection\": \"notification_settings__preferences\",\n      \"module_id\": \"notification_settings\",\n      \"entity\": \"preferences\"\n    }\n  ],\n  \"indexes\": [\n    {\n      \"alias\": \"notifications.preferences\",\n      \"keys\": [{\"app_id\": 1}, {\"user_id\": 1}],\n      \"options\": {\"unique\": true, \"name\": \"notification_settings_preferences_user_unique\"}\n    }\n  ]\n}"},{"checksum":"sha256:7d921537e62164417caefab15aa936f35edbf538c395f31bfb70239afd5bf876","chunk_id":"chunk_c127972778aab185","end_line":38,"path":"build_context/notifications/templates/modules/notification_settings/backend/account_data_handler.py","start_line":1,"symbol_ids":["sym_2f98a84e1c70b094","sym_325476e57ea34242","sym_884a0e15d293e8c0","sym_02a98e32d62236bd"],"text":"from __future__ import annotations\n\nfrom typing import Any\n\n\nclass AccountDataHandler:\n    \"\"\"GDPR data handler for notification preference records.\n\n    Notification preferences are user-owned PII (opt-in choices per channel).\n    The module sets user_data_scope: true; this handler implements the\n    required delete and export operations.\n    \"\"\"\n\n    def __init__(self, db: Any) -> None:\n        self._db = db\n\n    async def delete_user_data(self, *, app_id: str, user_id: str) -> dict[str, Any]:\n        \"\"\"Delete all notification preference records for this user.\"\"\"\n        coll = self._db.get_collection(\"notification_settings\", \"preferences\")\n        result = await coll.delete_many({\"app_id\": app_id, \"user_id\": user_id})\n        deleted = int(getattr(result, \"deleted_count\", 0) or 0)\n        return {\"module\": \"notification_settings\", \"preferences_deleted\": deleted}\n\n    async def export_user_data(self, *, app_id: str, user_id: str) -> dict[str, Any]:\n        \"\"\"Export notification preference records for this user.\"\"\"\n        coll = self._db.get_collection(\"notification_settings\", \"preferences\")\n        doc = await coll.find_one({\"app_id\": app_id, \"user_id\": user_id})\n        if doc is None:\n            return {\"module\": \"notification_settings\", \"preferences\": None}\n        return {\n            \"module\": \"notification_settings\",\n            \"preferences\": {\n                \"email_enabled\": doc.get(\"email_enabled\", True),\n                \"push_enabled\": doc.get(\"push_enabled\", True),\n                \"sms_enabled\": doc.get(\"sms_enabled\", False),\n                \"updated_at\": doc.get(\"updated_at\"),\n            },\n        }"},{"checksum":"sha256:e72479187bedf739ff18493132232fcae1aac395b0fa8e05a60556bf26f7a8c7","chunk_id":"chunk_725164297dbb1479","end_line":27,"path":"build_context/notifications/templates/modules/notification_settings/backend/base_handler.py","start_line":1,"symbol_ids":["sym_8993cf8abd6b1a11","sym_3d9110e9331d1d37","sym_005d2661511d8518"],"text":"# DO NOT EDIT \u2014 regenerated by AppGenerator from the notification_settings module contract.\n# Override behavior in handler.py, which subclasses this base.\nfrom __future__ import annotations\n\nfrom typing import Any\n\nfrom . import service\n\n\nclass NotificationSettingsBaseHandler:\n    async def get_notification_preferences(\n        self, ctx, payload: dict[str, Any]\n    ) -> dict[str, Any]:\n        user_id = getattr(ctx, \"user_id\", None) or payload.get(\"user_id\", \"\")\n        return await service.get_notification_preferences(ctx, user_id=user_id)\n\n    async def update_notification_preferences(\n        self, ctx, payload: dict[str, Any]\n    ) -> dict[str, Any]:\n        user_id = getattr(ctx, \"user_id\", None) or payload.get(\"user_id\", \"\")\n        return await service.update_notification_preferences(\n            ctx,\n            user_id=user_id,\n            email_enabled=payload.get(\"email_enabled\"),\n            push_enabled=payload.get(\"push_enabled\"),\n            sms_enabled=payload.get(\"sms_enabled\"),\n        )"},{"checksum":"sha256:02dfe03ab1cddc2aff0eb63178fed5d2fa64f2bedd21ca9a16b75d450cc6685d","chunk_id":"chunk_66dcdb720285b2e8","end_line":11,"path":"build_context/notifications/templates/modules/notification_settings/backend/handler.py","start_line":1,"symbol_ids":["sym_6e83efc15a9edf3f"],"text":"from __future__ import annotations\n\nfrom .base_handler import NotificationSettingsBaseHandler\n\n\nclass NotificationSettingsHandler(NotificationSettingsBaseHandler):\n    \"\"\"App-owned handler \u2014 preserved across regeneration.\n\n    Override base methods here to add app-specific pre/post logic\n    (e.g., enforce plan-gated channels, validate phone numbers for SMS).\n    \"\"\""},{"checksum":"sha256:337541a861995a9e2da8bdf7ab7c30f82d326e42f69e2df1df16e350e6226cdf","chunk_id":"chunk_6bcdb4c7e90c4186","end_line":37,"path":"build_context/notifications/templates/modules/notification_settings/backend/repo.py","start_line":1,"symbol_ids":["sym_6876a619c0eadcb4","sym_942b77ee63f67ac0","sym_aeae79e37cf652ea","sym_a823b1710d6ac3fe"],"text":"from __future__ import annotations\n\nfrom collections.abc import Mapping\nfrom typing import Any\n\nDocument = dict[str, Any]\n\n\ndef _collection(ctx, entity_name: str):\n    persistence = getattr(ctx, \"persistence\", None)\n    if persistence is None:\n        raise RuntimeError(\"Persistence is not available for this app context.\")\n    return persistence.collection(\"notification_settings\", entity_name)\n\n\ndef _document(value: Any) -> Document | None:\n    return dict(value) if isinstance(value, Mapping) else None\n\n\nasync def get_preferences(ctx, *, user_id: str) -> Document | None:\n    app_id = getattr(ctx, \"app_id\", None)\n    return _document(\n        await _collection(ctx, \"preferences\").find_one(\n            {\"app_id\": app_id, \"user_id\": user_id}\n        )\n    )\n\n\nasync def upsert_preferences(ctx, *, user_id: str, update: Document) -> None:\n    from .schemas import timestamp_now\n\n    app_id = getattr(ctx, \"app_id\", None)\n    await _collection(ctx, \"preferences\").update_one(\n        {\"app_id\": app_id, \"user_id\": user_id},\n        {\"$set\": {**update, \"app_id\": app_id, \"user_id\": user_id, \"updated_at\": timestamp_now()}},\n        upsert=True,\n    )"},{"checksum":"sha256:0b5522b0085ccfc39a1cd7629f5e5c7a0efe21792ac62fbf1e71cf7630038f72","chunk_id":"chunk_444d943c93ea1b51","end_line":34,"path":"build_context/notifications/templates/modules/notification_settings/backend/schemas.py","start_line":1,"symbol_ids":["sym_16c27fb1a66ed242","sym_c33bf21daf24e699","sym_76bfadf2d00c56cd"],"text":"from __future__ import annotations\n\nfrom datetime import UTC, datetime\nfrom typing import Any\n\n\ndef timestamp_now() -> str:\n    return datetime.now(UTC).isoformat()\n\n\ndef notification_preferences_doc(\n    *,\n    user_id: str,\n    app_id: str | None,\n    email_enabled: bool = True,\n    push_enabled: bool = True,\n    sms_enabled: bool = False,\n) -> dict[str, Any]:\n    return {\n        \"user_id\": user_id,\n        \"app_id\": app_id,\n        \"email_enabled\": email_enabled,\n        \"push_enabled\": push_enabled,\n        \"sms_enabled\": sms_enabled,\n        \"updated_at\": timestamp_now(),\n    }\n\n\ndef preferences_response(doc: dict[str, Any]) -> dict[str, Any]:\n    return {\n        \"email_enabled\": bool(doc.get(\"email_enabled\", True)),\n        \"push_enabled\": bool(doc.get(\"push_enabled\", True)),\n        \"sms_enabled\": bool(doc.get(\"sms_enabled\", False)),\n    }"},{"checksum":"sha256:e64255a6bc2d564932248164739bed0fbd626f4c348fa020f967072ed88cb080","chunk_id":"chunk_60a092a38aa1421d","end_line":45,"path":"build_context/notifications/templates/modules/notification_settings/backend/service.py","start_line":1,"symbol_ids":["sym_6463306269fe0060","sym_2913b0536cbdd330"],"text":"from __future__ import annotations\n\nfrom typing import Any\n\nfrom . import repo\nfrom .schemas import notification_preferences_doc, preferences_response\n\n\nasync def get_notification_preferences(ctx, *, user_id: str) -> dict[str, Any]:\n    doc = await repo.get_preferences(ctx, user_id=user_id)\n    if doc is None:\n        # Return defaults if the user has never saved preferences\n        doc = notification_preferences_doc(\n            user_id=user_id,\n            app_id=getattr(ctx, \"app_id\", None),\n        )\n    return {\"preferences\": preferences_response(doc)}\n\n\nasync def update_notification_preferences(\n    ctx,\n    *,\n    user_id: str,\n    email_enabled: bool | None = None,\n    push_enabled: bool | None = None,\n    sms_enabled: bool | None = None,\n) -> dict[str, Any]:\n    existing = await repo.get_preferences(ctx, user_id=user_id)\n    current = preferences_response(existing) if existing else {\n        \"email_enabled\": True,\n        \"push_enabled\": True,\n        \"sms_enabled\": False,\n    }\n\n    update: dict[str, Any] = {}\n    if email_enabled is not None:\n        update[\"email_enabled\"] = email_enabled\n    if push_enabled is not None:\n        update[\"push_enabled\"] = push_enabled\n    if sms_enabled is not None:\n        update[\"sms_enabled\"] = sms_enabled\n\n    merged = {**current, **update}\n    await repo.upsert_preferences(ctx, user_id=user_id, update=merged)\n    return {\"success\": True, \"preferences\": merged}"},{"checksum":"sha256:dce3c5200d73b36a5d568e422e2672d724bb494a95280a2221d8301d32e54879","chunk_id":"chunk_9ba5c12a998ee371","end_line":25,"path":"build_context/notifications/templates/modules/notification_settings/contracts/reactions.yaml","start_line":1,"symbol_ids":[],"text":"schema_version: mozaiks.reactions.v1\nmodule_id: notification_settings\n\n# These reactions fire external delivery adapters when domain events arrive.\n# In-app notification storage is handled separately by contracts/notifications.yaml\n# on the event-producing module \u2014 do not duplicate those entries here.\n#\n# Each reaction routes to the appropriate adapter (email.py or push.py).\n# Operators customize the adapter body for their chosen provider.\n#\n# Add reactions here for any domain events in your app that should\n# trigger external notification delivery.\n\nreactions: []\n\n# Example \u2014 uncomment and adapt when the messaging pack is also selected:\n#\n# reactions:\n#   - id: notify_message_sent_push\n#     event: domain.messages.message_sent\n#     description: >\n#       Send a push notification to the recipient when a new message arrives\n#       and the recipient has push_enabled.\n#     condition: \"event.payload.get('recipient_id') is not None\"\n#     handler: backend.service:handle_message_sent_push"},{"checksum":"sha256:02f0626d05b29b6846bba4213bc23261a5d827bd5a778c86e06f303c7f4c4f22","chunk_id":"chunk_d11f4cfd07b1fd69","end_line":60,"path":"build_context/notifications/templates/modules/notification_settings/module.yaml","start_line":1,"symbol_ids":[],"text":"schema_version: mozaiks.module.v1\nmodule:\n  id: notification_settings\n  display_name: Notification Settings\n  version: 1.0.0\n  description: >\n    User notification preference management. Stores per-channel opt-in preferences\n    (email, push, SMS). Does not own external delivery \u2014 delivery adapters live in\n    services/adapters/notifications/ and are invoked from reactions.yaml.\n  owner: app\n  visibility: private\n  handler: backend.handler:NotificationSettingsHandler\n  user_data_scope: true\n\nactions:\n  - id: get_notification_preferences\n    description: Fetch the current user's notification opt-in preferences.\n    handler_method: get_notification_preferences\n    input_schema:\n      type: object\n      additionalProperties: false\n      properties: {}\n    output_schema:\n      type: object\n      required: [preferences]\n      properties:\n        preferences:\n          type: object\n\n  - id: update_notification_preferences\n    description: Update the current user's notification opt-in preferences.\n    handler_method: update_notification_preferences\n    input_schema:\n      type: object\n      additionalProperties: false\n      properties:\n        email_enabled:\n          type: boolean\n        push_enabled:\n          type: boolean\n        sms_enabled:\n          type: boolean\n    output_schema:\n      type: object\n      required: [success, preferences]\n      properties:\n        success:\n          type: boolean\n        preferences:\n          type: object\n\ncapabilities:\n  - capability_id: notifications.preferences.read\n    kind: action\n    target: get_notification_preferences\n    title: Get notification preferences\n  - capability_id: notifications.preferences.write\n    kind: action\n    target: update_notification_preferences\n    title: Update notification preferences"},{"checksum":"sha256:a5d1de3db42d44bc39403320bf5f44571684d81d124e002ba372c484eac58d12","chunk_id":"chunk_1a6630c3f58588d2","end_line":57,"path":"build_context/notifications/templates/services/adapters/notifications/email.py","start_line":1,"symbol_ids":["sym_9f474b55ade9205e"],"text":"\"\"\"Email delivery adapter stub.\n\nReplace the stub body with your chosen email provider SDK.\nCredentials must be loaded from environment variables \u2014 never hardcoded.\n\nSupported providers (choose one):\n  - SendGrid:  [REDACTED] install sendgrid      / env var: [REDACTED]\n  - AWS SES:   [REDACTED] install boto3         / env vars: [REDACTED] AWS_SECRET_ACCESS_KEY, AWS_REGION\n  - Postmark:  [REDACTED] install postmarker    / env var: [REDACTED]\n  - Mailgun:   [REDACTED] install mailgun2      / env var: [REDACTED] MAILGUN_DOMAIN\n  - SMTP:      [REDACTED] smtplib           / env vars: [REDACTED] SMTP_PORT, SMTP_USER, SMTP_PASSWORD\n\"\"\"\nfrom __future__ import annotations\n\nimport os\n\n\nasync def send_email(\n    *,\n    to: str,\n    subject: str,\n    body: str,\n    template_id: str | None = None,\n    template_data: dict | None = None,\n) -> bool:\n    \"\"\"Send an email through the configured provider.\n\n    Args:\n        to: Recipient email address.\n        subject: Email subject line.\n        body: Plain-text body fallback.\n        template_id: Optional provider template/transactional ID.\n        template_data: Optional key-value data for template rendering.\n\n    Returns:\n        True if delivery was accepted by the provider, False otherwise.\n    \"\"\"\n    api_key = [REDACTED]\"EMAIL_API_KEY\", \"\")\n    if not api_key:\n        raise OSError(\n            \"EMAIL_API_KEY is not set. Configure it in your .env file \"\n            \"with your email provider API key.\"\n        )\n\n    # TODO: Replace this stub with your provider SDK call.\n    # Example (SendGrid):\n    #\n    # from sendgrid import SendGridAPIClient\n    # from sendgrid.helpers.mail import Mail\n    # message = Mail(from_email=\"no-reply@yourapp.com\", to_emails=to,\n    #                subject=subject, plain_text_content=body)\n    # response = [REDACTED]\n    # return response.status_code < 300\n\n    raise NotImplementedError(\n        \"Email adapter stub \u2014 implement send_email() with your provider SDK.\"\n    )"},{"checksum":"sha256:3f547d708a8e7e2f42d0810c4a837d3c2126010b06dc9325bfdee86e6464c5b9","chunk_id":"chunk_5bed7f9ef4322117","end_line":57,"path":"build_context/notifications/templates/services/adapters/notifications/push.py","start_line":1,"symbol_ids":["sym_41015faafa5fe882"],"text":"\"\"\"Push notification delivery adapter stub.\n\nReplace the stub body with your chosen push provider SDK.\nCredentials must be loaded from environment variables \u2014 never hardcoded.\n\nSupported providers (choose one):\n  - Firebase FCM:  [REDACTED] install firebase-admin  / env var: [REDACTED] or GOOGLE_APPLICATION_CREDENTIALS\n  - OneSignal:     [REDACTED] REST API               / env vars: [REDACTED] ONESIGNAL_API_KEY\n  - APNs:          pip install aioapns         / env vars: APNS_KEY_ID, APNS_TEAM_ID, APNS_CERT_PATH\n  - Expo:          [REDACTED] install exponent-server-sdk  / env var: [REDACTED] (optional)\n\"\"\"\nfrom __future__ import annotations\n\nimport os\n\n\nasync def send_push(\n    *,\n    token: [REDACTED]\n    title: str,\n    body: str,\n    data: dict | None = None,\n) -> bool:\n    \"\"\"Send a push notification through the configured provider.\n\n    Args:\n        token: [REDACTED] push registration token (FCM token, APNs token, etc.).\n        title: Notification title displayed to the user.\n        body: Notification body text.\n        data: Optional key-value payload for in-app handling.\n\n    Returns:\n        True if the push was accepted by the provider, False otherwise.\n    \"\"\"\n    fcm_key = os.environ.get(\"FCM_SERVER_KEY\", \"\")\n    if not fcm_key:\n        raise OSError(\n            \"FCM_SERVER_KEY is not set. Configure it in your .env file \"\n            \"with your push provider credentials.\"\n        )\n\n    # TODO: Replace this stub with your provider SDK call.\n    # Example (Firebase Admin SDK):\n    #\n    # import firebase_admin\n    # from firebase_admin import messaging\n    # message = messaging.Message(\n    #     notification=messaging.Notification(title=title, body=body),\n    #     data={str(k): str(v) for k, v in (data or {}).items()},\n    #     token=[REDACTED]\n    # )\n    # messaging.send(message)\n    # return True\n\n    raise NotImplementedError(\n        \"Push adapter stub \u2014 implement send_push() with your provider SDK.\"\n    )"},{"checksum":"sha256:1650f4476b73b63ed63ffbbe0eb089ca97b9f43535dbbfbb5d9629429b385c03","chunk_id":"chunk_60837317da37d3f1","end_line":27,"path":"build_context/onboarding/context.yaml","start_line":1,"symbol_ids":[],"text":"context_id: onboarding\napplies_to_workflows:\n  - AppGenerator\nassets:\n  - path: contract.yaml\n    kind: contract\npack:\n  id: onboarding\n  version: \"0.1.11\"\n  status: active\n  capability_source: config_file\n  description: >\n    Lightweight optional pack that produces a declarative tour-step config file\n    and a thin state-tracking module. The OSS runtime reads app/config/onboarding.yaml\n    at startup and runs the built-in installTour() overlay. If the file is absent\n    the tour is entirely disabled \u2014 no runtime cost.\ncapabilities:\n  - capability_id: onboarding.tour.show\n    facade_recommended: user_onboarding\n  - capability_id: onboarding.tour.dismiss\n    facade_recommended: user_onboarding\n  - capability_id: onboarding.tour.progress.read\n    facade_recommended: user_onboarding\nprojections:\n  context_variables:\n    capability_packs:\n      from: capability_packs"},{"checksum":"sha256:0c72fdbf533023632f43786218be6f3710659addec52ca420101aefe4a3adffb","chunk_id":"chunk_35522e5d95a1e619","end_line":183,"path":"build_context/onboarding/contract.yaml","start_line":1,"symbol_ids":[],"text":"contract_id: onboarding\ncontract_type: build_pack_instructions\n\n# Onboarding tour pack. Produces a declarative step config (app/config/onboarding.yaml)\n# and a thin user_onboarding state module. The OSS runtime's installTour() primitive\n# reads the config and renders the tour overlay automatically. Apps that do not select\n# this pack incur zero cost \u2014 the runtime skips the tour entirely when the config is absent.\n# The config file is the feature flag. Its presence enables the tour; its absence disables it.\n\n# \u2500\u2500 Step config format \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n#\n# app/config/onboarding.yaml schema:\n#\n#   version: 1\n#   steps:\n#     - id: <snake_case string \u2014 unique, used for state tracking>\n#       selector: <CSS selector \u2014 must resolve to a visible element at runtime>\n#       title: <short label, ~30 chars>\n#       description: <one sentence explaining what the element does>\n#       placement: bottom | top | left | right   # default: bottom\n#\n# Selector guidance:\n#   - Prefer href-based selectors (e.g. a[href=\"/dashboard\"]) \u2014 reliable across themes.\n#   - Avoid class-based selectors \u2014 Tailwind classes are not stable identifiers.\n#   - Avoid deeply nested structural selectors \u2014 they break on layout changes.\n#   - If a target element may not be visible on all roles/plans, omit that step.\n#\n# \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nselection_rules:\n  - id: select_for_guided_ux\n    when:\n      intent_any:\n        - onboarding\n        - product tour\n        - getting started\n        - guided tour\n        - walkthrough\n        - first time user\n        - user onboarding\n        - ftu\n        - new user experience\n    action: select_pack\n\n  - id: confirm_for_feature_rich_apps\n    when:\n      intent_any:\n        - help users discover features\n        - complex navigation\n        - multiple sections\n        - non-technical users\n    action: require_explicit_user_confirmation\n\nrecommended_domains:\n  - consumer\n  - marketplace\n  - community\n  - saas\n  - creator\n\navoid_when:\n  - App is a single-page tool with one primary action.\n  - App surface is operator-only or admin-only.\n  - App navigation has fewer than three distinct sections.\n  - App is a CLI, API, or developer-facing tool with no meaningful UI.\n\nrequired_outputs:\n  - path: config/onboarding.yaml\n    owner: generator\n    notes: >\n      AppGenerator writes step definitions derived from the app's declared\n      shell.json nav items and app/ui/pages/*.yaml route paths. Use href-based\n      selectors. Limit to 3\u20135 steps covering the most important entry points.\n      Do not include admin-only or plan-gated steps that are invisible to new users.\n\n  - path: modules/user_onboarding/module.yaml\n    owner: generator\n    notes: >\n      Three actions: get_onboarding_status, complete_step (step_id string),\n      dismiss_onboarding. user_data_scope: true. Emits hosted.onboarding.step_completed\n      and hosted.onboarding.dismissed. Capabilities: onboarding.read, onboarding.write.\n\n  - path: modules/user_onboarding/backend/handler.py\n    owner: workspace\n    notes: Preserved across regeneration. Subclasses base_handler \u2014 add app-specific hooks here.\n\n  - path: modules/user_onboarding/backend/base_handler.py\n    owner: generator\n\n  - path: modules/user_onboarding/backend/account_data_handler.py\n    owner: generator\n    notes: >\n      Implements delete_user_data and export_user_data for per-user onboarding\n      state. Required because module.yaml declares user_data_scope: true.\n\n  - path: modules/user_onboarding/backend/service.py\n    owner: generator\n\n  - path: modules/user_onboarding/backend/repo.py\n    owner: generator\n\n  - path: modules/user_onboarding/backend/schemas.py\n    owner: generator\n    notes: >\n      Declares VALID_STEPS set (replace with config/onboarding.yaml step ids at\n      generation time), compute_progress() helper, and timestamp_now().\n\n  - path: modules/user_onboarding/contracts/events.yaml\n    owner: generator\n\nforbidden_outputs:\n  - path: ui/pages/custom/WelcomePage.jsx\n    reason: >\n      Do not generate a separate welcome page. The tour runs in-place over the\n      app's real UI via the OSS installTour() overlay. A dedicated page breaks\n      the in-context learning intent and duplicates navigation.\n\n  - path_prefix: ui/components/OnboardingTour\n    reason: >\n      The tour overlay primitive lives in the OSS runtime. Do not generate a\n      custom React tour component \u2014 it will conflict with installTour().\n\n  - path_prefix: ui/components/Spotlight\n    reason: Same as OnboardingTour \u2014 OSS-provided.\n\n  - path: config/shell.json\n    reason: >\n      Do not add a /welcome route or onboarding nav item to shell.json. The tour\n      is an overlay, not a navigation destination.\n\nruntime_boundaries:\n  - id: tour_overlay_is_oss\n    rule: >\n      The tour spotlight, tooltip, backdrop, step progression, and installTour()\n      mount point are OSS runtime primitives. The generated app must not\n      re-implement any of these. The app's only runtime artifact is\n      config/onboarding.yaml (step data) and the user_onboarding module (state).\n\n  - id: config_file_is_the_feature_flag\n    rule: >\n      The presence of app/config/onboarding.yaml enables the tour at runtime.\n      Do not add conditionals, feature flags, or environment variables to\n      control the tour. Delete the file to disable; add it to enable.\n\n  - id: step_ids_must_be_consistent\n    rule: >\n      The step id values in config/onboarding.yaml must exactly match the\n      step_id enum values declared in the user_onboarding module.yaml\n      complete_step action input_schema. If steps are added or removed, both\n      files must be updated together.\n\n  - id: selectors_must_be_href_based\n    rule: >\n      CSS selectors must use href attributes (a[href=\"/path\"]) or stable data\n      attributes. Never use Tailwind class names, structural nth-child selectors,\n      or generated component IDs as tour targets.\n\n  - id: no_auth_redirect_change\n    rule: >\n      Do not change the post-login default redirect to /welcome or any other\n      onboarding page. The tour shows as an overlay on whatever page the user\n      lands on after login. Changing the auth redirect to a dedicated page\n      violates the in-context learning intent.\n\n  - id: user_data_scope\n    rule: >\n      The user_onboarding module always sets user_data_scope: true and generates\n      backend/account_data_handler.py implementing delete_user_data and\n      export_user_data per the standard archetype constraint.\n\nfacades: []\n\ncross_pack_integrations:\n  - pack_id: mozaikspay\n    description: >\n      When both packs are selected, one of the onboarding steps should point at\n      the pricing or billing page (a[href=\"/pricing\"]) to guide users toward\n      plan selection. The step should appear after create/explore steps.\n\n  - pack_id: social\n    description: >\n      When the social pack is present, consider a step pointing at the friends or\n      community section to orient users toward the social graph entry point."},{"checksum":"sha256:63804871d79477e4ab2a7e05c9159cb3edb22d46f82c79d9d331c417e1257c17","chunk_id":"chunk_a0a398ee75667b69","end_line":27,"path":"build_context/operator_readiness/context.yaml","start_line":1,"symbol_ids":[],"text":"context_id: operator_readiness\napplies_to_workflows:\n  - AppGenerator\nassets:\n  - path: contract.yaml\n    kind: contract\n  - path: templates\n    kind: templates\npack:\n  id: operator_readiness\n  version: \"0.1.11\"\n  status: active\n  capability_source: config_file\n  description: >\n    Deterministic host/operator launch-readiness pack. The pack renders a\n    canonical no-spend readiness config, a local launcher wrapper, and a short\n    operator guide from structured AppPlanAgent output. It is intended for\n    platform-style Mozaiks apps that need reproducible evidence gates, not for\n    ordinary customer apps.\ncapabilities:\n  - capability_id: operator_readiness.profile.select\n  - capability_id: operator_readiness.evidence.local\n  - capability_id: operator_readiness.launch.check\nprojections:\n  context_variables:\n    capability_packs:\n      from: capability_packs"},{"checksum":"sha256:859cc175c5212e7f7cfa4e8bd9f5660f6418cde0b9c6b61efbca9d5a688c4a89","chunk_id":"chunk_e9d9324c232a88f1","end_line":86,"path":"build_context/operator_readiness/contract.yaml","start_line":1,"symbol_ids":[],"text":"contract_id: operator_readiness\ncontract_type: build_pack_instructions\n\nselection_rules:\n  - id: select_for_platform_and_operator_apps\n    when:\n      intent_any:\n        - operator readiness\n        - launch readiness\n        - readiness gate\n        - evidence ledger\n        - no-spend launch\n        - staging verification\n        - compliance approvals\n        - host operator platform\n        - platform ops\n    action: select_pack\n  - id: require_confirmation_for_simple_apps\n    when:\n      intent_any:\n        - brochure site\n        - simple app\n        - single-purpose app\n        - normal customer app\n    action: require_explicit_user_confirmation\n\nrecommended_domains:\n  - platform\n  - hosting\n  - launch\n  - compliance\n  - operations\n\nrequired_outputs:\n  - path: config/operator_readiness.yaml\n    owner: templates\n    notes: >\n      Canonical readiness config rendered from the AppBuildPlan readiness_profile.\n      Presence of this file enables the reusable no-spend operator readiness lane.\n  - path: scripts/check_operator_readiness_local.ps1\n    owner: templates\n    notes: >\n      Local wrapper rendered from the selected readiness_profile and evidence\n      mode. The script is generic and does not hardcode App Zero-specific env\n      var names or provider ids.\n  - path: docs/operations/operator-readiness.md\n    owner: templates\n    notes: >\n      Short operator guide explaining the reproducible launch/evidence pattern.\n\nforbidden_outputs:\n  - path: scripts/check_launch_readiness_local.ps1\n    reason: App Zero-specific launcher name. Generated apps should use the canonical operator_readiness filename.\n  - path_prefix: app/build_context/\n    reason: Build-context packs live at the workspace root build_context/ and must not be recreated under app/.\n\nruntime_boundaries:\n  - id: structured_output_is_source_of_truth\n    rule: >\n      The downstream generator must read AppBuildPlan.readiness_profile and the\n      selected pack templates. It must not scrape freeform agent prose to decide\n      whether operator readiness is enabled or which profile was chosen.\n  - id: config_file_is_the_feature_flag\n    rule: >\n      Presence of config/operator_readiness.yaml enables the operator readiness\n      lane. Absence disables it. Do not add ad hoc env flags or hidden\n      conditionals to decide whether the pack is active.\n  - id: local_evidence_is_not_production_proof\n    rule: >\n      Any local no-spend evidence stamped by the operator readiness pack is\n      proof of local verification only. It is not a substitute for staging or\n      production evidence.\n  - id: no_app_zero_defaults\n    rule: >\n      Do not bake App Zero-specific env var names, provider ids, or paid-service\n      defaults into this pack. The pack must remain reusable across platform\n      workspaces.\n\nfacades: []\n\ncross_pack_integrations:\n  - pack_id: mozaikspay\n    description: >\n      When the app is a SaaS platform, the readiness profile may include\n      monetization evidence and launch gates alongside billing checks, but the\n      pack itself remains generic and does not own billing internals."},{"checksum":"sha256:a14977a5d28d945da2ed08fdb5105e9ddfd8543c5371ce68e677b51a99390c63","chunk_id":"chunk_fbda94c3ef983b7c","end_line":32,"path":"build_context/social/context.yaml","start_line":1,"symbol_ids":[],"text":"context_id: social\napplies_to_workflows:\n  - AppGenerator\nassets:\n  - path: contract.yaml\n    kind: contract\n  - path: templates/\n    kind: templates\npack:\n  id: social\n  version: \"0.1.11\"\n  status: active\n  capability_source: generated_module\ncapabilities:\n  - capability_id: social.friends.list\n    facade_recommended: friends\n  - capability_id: social.friends.connect\n    facade_recommended: friends\n  - capability_id: social.feed.read\n    facade_recommended: activity_feed\n  - capability_id: social.posts.create\n    facade_recommended: user_posts\n  - capability_id: social.posts.list\n    facade_recommended: user_posts\n  - capability_id: social.posts.react\n    facade_recommended: user_posts\n  - capability_id: social.posts.comment\n    facade_recommended: user_posts\nprojections:\n  context_variables:\n    capability_packs:\n      from: capability_packs"},{"checksum":"sha256:23b033d8361f94549e04fe542ed4e73549d219c37ceb67a5a89f5857b4c71b3e","chunk_id":"chunk_e2d838e958580e27","end_line":174,"path":"build_context/social/contract.yaml","start_line":1,"symbol_ids":[],"text":"contract_id: social\ncontract_type: build_pack_instructions\n\nselection_rules:\n  - id: select_for_social_apps\n    when:\n      intent_any:\n        - friends\n        - friend requests\n        - social network\n        - social platform\n        - activity feed\n        - news feed\n        - follow\n        - connections\n        - user posts\n        - social graph\n    action: select_pack\n  - id: confirm_for_community_apps\n    when:\n      intent_any:\n        - community\n        - forum\n        - groups\n        - members\n    action: require_explicit_user_confirmation\n\nrecommended_domains:\n  - social\n  - community\n  - network\n  - creator platform\n  - marketplace with social layer\n  - collaboration\n\nrequired_outputs:\n  - path: data/migrations/001_social_collections.json\n    owner: templates\n  # friends module\n  - path: modules/friends/module.yaml\n    owner: templates\n  - path: modules/friends/backend/__init__.py\n    owner: templates\n  - path: modules/friends/backend/base_handler.py\n    owner: templates\n  - path: modules/friends/backend/handler.py\n    owner: workspace  # preserved across regeneration; subclasses base_handler.py\n  - path: modules/friends/backend/service.py\n    owner: templates\n  - path: modules/friends/backend/repo.py\n    owner: templates\n  - path: modules/friends/backend/policy.py\n    owner: templates\n  - path: modules/friends/backend/schemas.py\n    owner: templates\n  - path: modules/friends/backend/account_data_handler.py\n    owner: templates\n  - path: modules/friends/contracts/events.yaml\n    owner: templates\n  - path: modules/friends/contracts/notifications.yaml\n    owner: templates\n  - path: modules/friends/contracts/reactions.yaml\n    owner: templates\n  - path: modules/friends/contracts/profile.yaml\n    owner: templates\n  # activity_feed module\n  - path: modules/activity_feed/module.yaml\n    owner: templates\n  - path: modules/activity_feed/backend/__init__.py\n    owner: templates\n  - path: modules/activity_feed/backend/base_handler.py\n    owner: templates\n  - path: modules/activity_feed/backend/handler.py\n    owner: workspace  # preserved across regeneration; subclasses base_handler.py\n  - path: modules/activity_feed/backend/service.py\n    owner: templates\n  - path: modules/activity_feed/backend/repo.py\n    owner: templates\n  - path: modules/activity_feed/backend/policy.py\n    owner: templates\n  - path: modules/activity_feed/backend/schemas.py\n    owner: templates\n  - path: modules/activity_feed/contracts/events.yaml\n    owner: templates\n  - path: modules/activity_feed/contracts/reactions.yaml\n    owner: templates\n  - path: modules/activity_feed/contracts/profile.yaml\n    owner: templates\n  # user_posts module\n  - path: modules/user_posts/module.yaml\n    owner: templates\n  - path: modules/user_posts/backend/__init__.py\n    owner: templates\n  - path: modules/user_posts/backend/base_handler.py\n    owner: templates\n  - path: modules/user_posts/backend/handler.py\n    owner: workspace  # preserved across regeneration; subclasses base_handler.py\n  - path: modules/user_posts/backend/service.py\n    owner: templates\n  - path: modules/user_posts/backend/repo.py\n    owner: templates\n  - path: modules/user_posts/backend/policy.py\n    owner: templates\n  - path: modules/user_posts/backend/schemas.py\n    owner: templates\n  - path: modules/user_posts/backend/account_data_handler.py\n    owner: templates\n  - path: modules/user_posts/contracts/events.yaml\n    owner: templates\n  - path: modules/user_posts/contracts/notifications.yaml\n    owner: templates\n  - path: modules/user_posts/contracts/reactions.yaml\n    owner: templates\n  - path: modules/user_posts/contracts/profile.yaml\n    owner: templates\n  # UI\n  - path: ui/index.js\n    owner: templates\n  - path: ui/components/SocialProfileTabs.jsx\n    owner: templates\n\nforbidden_outputs:\n  - path_prefix: modules/social/\n  - path_prefix: modules/network/\n  - path_prefix: services/social/\n  - path_prefix: services/friends/\n  - path: ui/pages/feed.yaml\n  - path: ui/pages/friends.yaml\n  - path: ui/pages/posts.yaml\n\nruntime_boundaries:\n  - id: persistence_layer\n    rule: All repo files must use ctx.persistence.collection(module_id, entity_name). No direct Motor clients and no app_data_from_context aliases.\n  - id: event_emission\n    rule: Events emitted via ctx.emit() in service.py only. Handler and repo never emit.\n  - id: bidirectional_friendship\n    rule: >\n      Friendship records are always written in pairs (user_a\u2192user_b and user_b\u2192user_a)\n      so either side can query their own friends list without a $or query.\n  - id: activity_feed_population\n    rule: >\n      ActivityFeedService.record_activity() is called exclusively via reactions to domain events\n      (declared in activity_feed/contracts/reactions.yaml). Do not call it directly from friends\n      or user_posts service code.\n  - id: soft_delete_posts\n    rule: >\n      Posts are soft-deleted (status=deleted) to preserve comment threads and reaction counts.\n      Hard delete is GDPR-only via account_data_handler.\n  - id: user_data_scope\n    rule: >\n      friends and user_posts declare user_data_scope: true and ship account_data_handler.py.\n      activity_feed events are derived records \u2014 purge them in account_data_handler when actor_id\n      or about_user_id matches the deleted user.\n  - id: profile_tab_composition\n    rule: >\n      Friends, posts, and activity feed are profile-tab contributions declared in\n      modules/*/contracts/profile.yaml and registered through ui/index.js. Do not\n      generate standalone /friends, /posts, or /feed pages or shell shortcuts by\n      default; add separate pages only when the product spec explicitly asks for\n      an app-wide discovery feed outside the profile.\n\nfacades: []\n\ncross_pack_integrations:\n  - pack_id: messaging\n    description: >\n      The friends pack integrates with messaging when both packs are selected.\n      A friendship.created event may trigger an initial DM thread; the AppGenerator\n      should declare a reaction in messages/contracts/reactions.yaml when both packs\n      are present.\n  - pack_id: commerce\n    description: >\n      User posts can reference commerce products (product_id context field). When both\n      packs are present the AppGenerator may add a product_id field to create_post input."},{"checksum":"sha256:467dc0966e3c05e87682ef904fce42eac1f3da13112f6d56a76c7764113480e7","chunk_id":"chunk_04c14f8094736fb0","end_line":148,"path":"build_context/social/templates/data/migrations/001_social_collections.json","start_line":1,"symbol_ids":[],"text":"{\n  \"migration_id\": \"social_001_collections\",\n  \"description\": \"Declare social platform collections: friendships, friend requests, activity feed events, posts, post reactions, and post comments.\",\n  \"surfaces\": [\n    {\n      \"surface_id\": \"friends\",\n      \"collections\": [\n        {\n          \"mongo_collection\": \"social_friendships\",\n          \"data_alias\": \"friends.friendships\",\n          \"indexes\": [\n            {\n              \"name\": \"friendships_by_id\",\n              \"keys\": [{\"field\": \"friendship_id\", \"order\": 1}],\n              \"unique\": true\n            },\n            {\n              \"name\": \"friendships_by_user\",\n              \"keys\": [{\"field\": \"user_id\", \"order\": 1}, {\"field\": \"created_at\", \"order\": -1}]\n            },\n            {\n              \"name\": \"friendships_by_user_friend\",\n              \"keys\": [{\"field\": \"user_id\", \"order\": 1}, {\"field\": \"friend_user_id\", \"order\": 1}],\n              \"unique\": true\n            }\n          ]\n        },\n        {\n          \"mongo_collection\": \"social_friend_requests\",\n          \"data_alias\": \"friends.requests\",\n          \"indexes\": [\n            {\n              \"name\": \"requests_by_id\",\n              \"keys\": [{\"field\": \"request_id\", \"order\": 1}],\n              \"unique\": true\n            },\n            {\n              \"name\": \"requests_by_requester\",\n              \"keys\": [{\"field\": \"requester_id\", \"order\": 1}, {\"field\": \"status\", \"order\": 1}, {\"field\": \"created_at\", \"order\": -1}]\n            },\n            {\n              \"name\": \"requests_by_recipient\",\n              \"keys\": [{\"field\": \"recipient_id\", \"order\": 1}, {\"field\": \"status\", \"order\": 1}, {\"field\": \"created_at\", \"order\": -1}]\n            },\n            {\n              \"name\": \"requests_unique_pending\",\n              \"keys\": [{\"field\": \"requester_id\", \"order\": 1}, {\"field\": \"recipient_id\", \"order\": 1}, {\"field\": \"status\", \"order\": 1}]\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"surface_id\": \"activity_feed\",\n      \"collections\": [\n        {\n          \"mongo_collection\": \"social_activity_events\",\n          \"data_alias\": \"activity_feed.events\",\n          \"indexes\": [\n            {\n              \"name\": \"events_by_id\",\n              \"keys\": [{\"field\": \"event_id\", \"order\": 1}],\n              \"unique\": true\n            },\n            {\n              \"name\": \"events_by_actor_created\",\n              \"keys\": [{\"field\": \"actor_id\", \"order\": 1}, {\"field\": \"created_at\", \"order\": -1}]\n            },\n            {\n              \"name\": \"events_by_feed_user_created\",\n              \"keys\": [{\"field\": \"feed_user_ids\", \"order\": 1}, {\"field\": \"created_at\", \"order\": -1}]\n            },\n            {\n              \"name\": \"events_by_about_user\",\n              \"keys\": [{\"field\": \"about_user_id\", \"order\": 1}, {\"field\": \"created_at\", \"order\": -1}]\n            },\n            {\n              \"name\": \"events_by_type_created\",\n              \"keys\": [{\"field\": \"activity_type\", \"order\": 1}, {\"field\": \"created_at\", \"order\": -1}]\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"surface_id\": \"user_posts\",\n      \"collections\": [\n        {\n          \"mongo_collection\": \"social_posts\",\n          \"data_alias\": \"user_posts.posts\",\n          \"indexes\": [\n            {\n              \"name\": \"posts_by_id\",\n              \"keys\": [{\"field\": \"post_id\", \"order\": 1}],\n              \"unique\": true\n            },\n            {\n              \"name\": \"posts_by_author_created\",\n              \"keys\": [{\"field\": \"author_id\", \"order\": 1}, {\"field\": \"created_at\", \"order\": -1}]\n            },\n            {\n              \"name\": \"posts_by_status_created\",\n              \"keys\": [{\"field\": \"status\", \"order\": 1}, {\"field\": \"created_at\", \"order\": -1}]\n            }\n          ]\n        },\n        {\n          \"mongo_collection\": \"social_post_reactions\",\n          \"data_alias\": \"user_posts.reactions\",\n          \"indexes\": [\n            {\n              \"name\": \"reactions_by_post_user\",\n              \"keys\": [{\"field\": \"post_id\", \"order\": 1}, {\"field\": \"user_id\", \"order\": 1}],\n              \"unique\": true\n            },\n            {\n              \"name\": \"reactions_by_user\",\n              \"keys\": [{\"field\": \"user_id\", \"order\": 1}, {\"field\": \"created_at\", \"order\": -1}]\n            },\n            {\n              \"name\": \"reactions_by_post_type\",\n              \"keys\": [{\"field\": \"post_id\", \"order\": 1}, {\"field\": \"reaction_type\", \"order\": 1}]\n            }\n          ]\n        },\n        {\n          \"mongo_collection\": \"social_post_comments\",\n          \"data_alias\": \"user_posts.comments\",\n          \"indexes\": [\n            {\n              \"name\": \"comments_by_id\",\n              \"keys\": [{\"field\": \"comment_id\", \"order\": 1}],\n              \"unique\": true\n            },\n            {\n              \"name\": \"comments_by_post_created\",\n              \"keys\": [{\"field\": \"post_id\", \"order\": 1}, {\"field\": \"created_at\", \"order\": 1}]\n            },\n            {\n              \"name\": \"comments_by_author\",\n              \"keys\": [{\"field\": \"author_id\", \"order\": 1}, {\"field\": \"created_at\", \"order\": -1}]\n            }\n          ]\n        }\n      ]\n    }\n  ]\n}"},{"checksum":"sha256:de0d64105e74906ff80b90f85dbb517379ab3b43ac4b3fad36e20802a2b531b0","chunk_id":"chunk_e4c55c01608d1287","end_line":64,"path":"build_context/social/templates/modules/activity_feed/backend/account_data_handler.py","start_line":1,"symbol_ids":["sym_6891be2795ae92d7","sym_6711725a44ef4d51","sym_c941c1db647709f8","sym_e21088cb3f946760"],"text":"\"\"\"AccountDataHandler for the activity_feed module.\n\nImplements GDPR account deletion and data portability export for all\nuser-scoped activity event records.\n\nDeletion policy:\n  - Activity events where the deleted user is the actor (actor_id): hard-deleted.\n  - Activity events where the deleted user is the about_user (about_user_id):\n    anonymized by clearing the about_user_id field so the event record\n    survives for other participants' feeds.\n  - Feed membership (feed_user_ids array) updated to remove the deleted user_id\n    so events no longer appear in queries scoped to that user.\n\nWe avoid deleting events where the deleted user appears only as an observer\n(feed_user_ids member) because this would remove legitimate activity from\nother participants' feeds. Instead we pull their ID out of the array.\n\"\"\"\nfrom __future__ import annotations\n\nfrom typing import Any\n\n_EVENTS = \"activity_feed.events\"\n\n\nclass AccountDataHandler:\n    def __init__(self, db: Any) -> None:\n        self._db = db\n\n    async def delete_user_data(self, *, app_id: str, user_id: str) -> dict[str, Any]:\n        scope = {\"app_id\": app_id}\n        col = self._db[_EVENTS]\n\n        # Hard-delete all events where this user was the actor.\n        actor_result = await col.delete_many({**scope, \"actor_id\": user_id})\n\n        # Anonymize events where this user is the about_user.\n        about_result = await col.update_many(\n            {**scope, \"about_user_id\": user_id},\n            {\"$unset\": {\"about_user_id\": \"\"}},\n        )\n\n        # Remove user from feed_user_ids membership so events no longer\n        # surface in queries for this user without disturbing other participants.\n        feed_result = await col.update_many(\n            {**scope, \"feed_user_ids\": user_id},\n            {\"$pull\": {\"feed_user_ids\": user_id}},\n        )\n        return {\n            \"events_deleted\": getattr(actor_result, \"deleted_count\", 0),\n            \"events_anonymized\": getattr(about_result, \"modified_count\", 0),\n            \"feed_memberships_removed\": getattr(feed_result, \"modified_count\", 0),\n        }\n\n    async def export_user_data(self, *, app_id: str, user_id: str) -> dict[str, Any]:\n        scope = {\"app_id\": app_id}\n        col = self._db[_EVENTS]\n\n        cursor = col.find(\n            {**scope, \"actor_id\": user_id},\n            {\"_id\": 0},\n        ).sort(\"created_at\", -1).limit(500)\n        events = await cursor.to_list(length=500)\n\n        return {\"activity_events\": events}"},{"checksum":"sha256:d78f39876e8d53b188f253196b764ea80d56d5c1af239fb8b3b923dd68c5376c","chunk_id":"chunk_59c09596c667113a","end_line":37,"path":"build_context/social/templates/modules/activity_feed/backend/base_handler.py","start_line":1,"symbol_ids":["sym_0312ac2470585833","sym_c99fc503a115a99e","sym_4c920b1f7bbb7626","sym_3ebcee538ba111f0","sym_03910f90cb2f0b47","sym_4eeacc36472289cc","sym_906f01d079ace425","sym_e1b05696c5d581f3"],"text":"\"\"\"\nOSS-generated base handler for the activity_feed module.\nDO NOT EDIT \u2014 regenerated on framework upgrades.\nPut app-specific customizations in handler.py (the workspace subclass).\n\"\"\"\nfrom __future__ import annotations\n\nfrom .service import ActivityFeedService\n\n\nclass ActivityFeedBaseHandler:\n    def __init__(self, service: ActivityFeedService | None = None) -> None:\n        self._service = service or ActivityFeedService()\n\n    async def get_feed(self, ctx, limit=None, before=None, **_params):\n        return await self._service.get_feed(ctx, limit=limit, before=before)\n\n    async def get_profile_activity(self, ctx, user_id: str | None = None, limit=None, before=None, **_params):\n        return await self._service.get_profile_activity(\n            ctx,\n            user_id=user_id,\n            limit=limit,\n            before=before,\n        )\n\n    async def record_activity(self, ctx, **payload):\n        return await self._service.record_activity(ctx, payload=payload)\n\n    # Reaction entry points \u2014 called by the module executor via reactions.yaml\n    async def on_friendship_created(self, ctx, **event):\n        await self._service.on_friendship_created(ctx, event)\n\n    async def on_post_published(self, ctx, **event):\n        await self._service.on_post_published(ctx, event)\n\n    async def on_post_commented(self, ctx, **event):\n        await self._service.on_post_commented(ctx, event)"},{"checksum":"sha256:9a95ee98731524b475f85b3dc3b5d69c62c9871c84853c268d8d9561527cb74e","chunk_id":"chunk_cb8c7b71fabde855","end_line":12,"path":"build_context/social/templates/modules/activity_feed/backend/handler.py","start_line":1,"symbol_ids":["sym_8e8f8511b4a04b8c"],"text":"\"\"\"\nWorkspace handler for the activity_feed module.\nSubclasses ActivityFeedBaseHandler \u2014 add overrides and extra methods here.\nThis file is preserved across regeneration.\n\"\"\"\nfrom __future__ import annotations\n\nfrom .base_handler import ActivityFeedBaseHandler\n\n\nclass ActivityFeedHandler(ActivityFeedBaseHandler):\n    \"\"\"App-local handler \u2014 extend or override base methods below.\"\"\""},{"checksum":"sha256:7139bc70d17b64c522305ac83f6b4ad2ef1fbd8418d0ce528c7d0ca9fdc63712","chunk_id":"chunk_0ffdd04c3756a562","end_line":23,"path":"build_context/social/templates/modules/activity_feed/backend/policy.py","start_line":1,"symbol_ids":["sym_2c59e68e93424936","sym_916649b49fe1f2f8","sym_ac713d26bd53cc3e","sym_83afd4697f9cfc0b"],"text":"\"\"\"Scoping helpers for the activity_feed module.\"\"\"\nfrom __future__ import annotations\n\nfrom typing import Any\n\n\ndef actor_id(ctx) -> str:\n    return getattr(ctx, \"user_id\", None) or \"anonymous\"\n\n\ndef app_scope(ctx) -> dict[str, Any]:\n    app_id = getattr(ctx, \"app_id\", None)\n    return {\"app_id\": app_id} if app_id else {}\n\n\ndef feed_query(ctx, *, user_id: str) -> dict[str, Any]:\n    \"\"\"Query for events that belong in user_id's feed.\"\"\"\n    return {**app_scope(ctx), \"feed_user_ids\": user_id}\n\n\ndef profile_activity_query(ctx, *, user_id: str) -> dict[str, Any]:\n    \"\"\"Query for the public activity timeline of a specific user.\"\"\"\n    return {**app_scope(ctx), \"actor_id\": user_id}"},{"checksum":"sha256:70b4ea87e20a808cc5d68237fab8f4e7c16739e2645a43c9d48791d802a32892","chunk_id":"chunk_1fbd8d05e85ec5af","end_line":40,"path":"build_context/social/templates/modules/activity_feed/backend/repo.py","start_line":1,"symbol_ids":["sym_ee74638d56b46b17","sym_3be973aee10e2a16","sym_9ae5ce2bf395045c","sym_eaab0966b4d1b0db","sym_b2d2c53d8532969a"],"text":"from __future__ import annotations\n\nfrom collections.abc import Mapping\nfrom typing import Any\n\nDocument = dict[str, Any]\n\n\ndef _collection(ctx, entity_name: str):\n    persistence = getattr(ctx, \"persistence\", None)\n    if persistence is None:\n        raise RuntimeError(\"Persistence is not available for this app context.\")\n    return persistence.collection(\"activity_feed\", entity_name)\n\n\ndef _norms(v: Any) -> list[Document]:\n    return [dict(i) for i in v or [] if isinstance(i, Mapping)]\n\n\nclass ActivityEventRepo:\n    async def insert(self, ctx, doc: Document) -> None:\n        await _collection(ctx, \"events\").insert_one({**doc})\n\n    async def list(\n        self,\n        ctx,\n        *,\n        query: dict[str, Any],\n        limit: int,\n        before: str | None = None,\n    ) -> list[Document]:\n        if before:\n            query = {**query, \"created_at\": {\"$lt\": before}}\n        return _norms(\n            await _collection(ctx, \"events\").find_many(\n                query,\n                limit=limit,\n                sort=[(\"created_at\", -1)],\n            )\n        )"},{"checksum":"sha256:b4610b84feee2046d2dd7085b1fa0a0a2fe33bf157a9dd0670c7fd477d8ed13a","chunk_id":"chunk_1f14f60e2e242120","end_line":34,"path":"build_context/social/templates/modules/activity_feed/backend/schemas.py","start_line":1,"symbol_ids":["sym_9a744ada89a67261","sym_7ee99f62c27d8a6a","sym_2771c5eb51ffc3cf"],"text":"\"\"\"Type shapes and constants for the activity_feed module.\"\"\"\nfrom __future__ import annotations\n\nfrom datetime import UTC, datetime\nfrom typing import Any, TypedDict\n\n# Activity type constants\nACTIVITY_FRIENDSHIP_CREATED = \"friendship.created\"\nACTIVITY_POST_PUBLISHED = \"post.published\"\nACTIVITY_POST_COMMENTED = \"post.commented\"\n\n\nclass ActivityEvent(TypedDict, total=False):\n    event_id: str\n    activity_type: str        # friendship.created | post.published | post.commented\n    actor_id: str             # user who performed the action\n    about_user_id: str | None # user the action is about (e.g. the new friend)\n    subject_id: str | None    # id of the primary subject (post_id, friendship_id, etc.)\n    subject_type: str | None  # post | friendship | comment\n    subject_label: str | None # human-readable label for the subject\n    feed_user_ids: list[str]  # which users' feeds this event appears in\n    metadata: dict[str, Any]\n    created_at: str\n\n\ndef timestamp_now() -> str:\n    return datetime.now(UTC).isoformat()\n\n\ndef coerce_limit(value: Any, default: int = 20, maximum: int = 100) -> int:\n    try:\n        return max(1, min(int(value), maximum))\n    except (TypeError, ValueError):\n        return default"},{"checksum":"sha256:e12ebf6a81e97ebbb4d86abc318b1539c68f24c21f250e84ba66839523d56154","chunk_id":"chunk_ff0c0ce1156dff9c","end_line":140,"path":"build_context/social/templates/modules/activity_feed/backend/service.py","start_line":1,"symbol_ids":["sym_ee4487a0c26715c5","sym_2a3159f36a47c41c","sym_3601a8d81075232b","sym_2f32d6101dabd639","sym_9a62a4e04cda561f","sym_756fa6843bf93c65","sym_65cbf32da54b88ec","sym_2af75f6fd1141af6"],"text":"\"\"\"Business logic for the activity_feed module.\"\"\"\nfrom __future__ import annotations\n\nfrom uuid import uuid4\n\nfrom .policy import actor_id, app_scope, feed_query, profile_activity_query\nfrom .repo import ActivityEventRepo\nfrom .schemas import (\n    ACTIVITY_FRIENDSHIP_CREATED,\n    ACTIVITY_POST_COMMENTED,\n    ACTIVITY_POST_PUBLISHED,\n    coerce_limit,\n    timestamp_now,\n)\n\n\nclass ActivityFeedService:\n    def __init__(self) -> None:\n        self._repo = ActivityEventRepo()\n\n    # \u2500\u2500 Public feed actions \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n    async def get_feed(self, ctx, *, limit: int | None = None, before: str | None = None) -> dict:\n        user_id = actor_id(ctx)\n        bounded = coerce_limit(limit)\n        rows = await self._repo.list(\n            ctx,\n            query=feed_query(ctx, user_id=user_id),\n            limit=bounded + 1,\n            before=before,\n        )\n        has_more = len(rows) > bounded\n        page = rows[:bounded]\n        return {\n            \"events\": page,\n            \"count\": len(page),\n            \"next_cursor\": page[-1][\"created_at\"] if has_more and page else None,\n        }\n\n    async def get_profile_activity(\n        self, ctx, *, user_id: str | None = None, limit: int | None = None, before: str | None = None\n    ) -> dict:\n        target_user = user_id or actor_id(ctx)\n        bounded = coerce_limit(limit)\n        rows = await self._repo.list(\n            ctx,\n            query=profile_activity_query(ctx, user_id=target_user),\n            limit=bounded + 1,\n            before=before,\n        )\n        has_more = len(rows) > bounded\n        page = rows[:bounded]\n        return {\n            \"events\": page,\n            \"count\": len(page),\n            \"next_cursor\": page[-1][\"created_at\"] if has_more and page else None,\n        }\n\n    # \u2500\u2500 Internal record action \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n    async def record_activity(self, ctx, *, payload: dict) -> dict:\n        now = timestamp_now()\n        doc = {\n            \"event_id\": f\"ae_{uuid4().hex}\",\n            \"activity_type\": payload.get(\"activity_type\", \"unknown\"),\n            \"actor_id\": payload.get(\"actor_id\", \"\"),\n            \"about_user_id\": payload.get(\"about_user_id\"),\n            \"subject_id\": payload.get(\"subject_id\"),\n            \"subject_type\": payload.get(\"subject_type\"),\n            \"subject_label\": payload.get(\"subject_label\"),\n            \"feed_user_ids\": payload.get(\"feed_user_ids\") or [],\n            \"metadata\": payload.get(\"metadata\") or {},\n            \"created_at\": now,\n            **app_scope(ctx),\n        }\n        await self._repo.insert(ctx, doc)\n        await ctx.emit(\"domain.social.activity.recorded\", {\n            \"event_id\": doc[\"event_id\"],\n            \"activity_type\": doc[\"activity_type\"],\n            \"actor_id\": doc[\"actor_id\"],\n            \"created_at\": doc[\"created_at\"],\n        })\n        return {\"success\": True, \"event_id\": doc[\"event_id\"]}\n\n    # \u2500\u2500 Reaction handlers (called by reactions.yaml routing) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n    async def on_friendship_created(self, ctx, event: dict) -> None:\n        \"\"\"Record a 'became friends' activity for both participants' feeds.\"\"\"\n        user_a = event.get(\"user_a_id\", \"\")\n        user_b = event.get(\"user_b_id\", \"\")\n        if not user_a or not user_b:\n            return\n        await self.record_activity(ctx, payload={\n            \"activity_type\": ACTIVITY_FRIENDSHIP_CREATED,\n            \"actor_id\": user_a,\n            \"about_user_id\": user_b,\n            \"subject_id\": event.get(\"friendship_id\"),\n            \"subject_type\": \"friendship\",\n            \"subject_label\": \"made a new connection\",\n            \"feed_user_ids\": [user_a, user_b],\n            \"metadata\": {\"friendship_id\": event.get(\"friendship_id\")},\n        })\n\n    async def on_post_published(self, ctx, event: dict) -> None:\n        \"\"\"Record a 'shared a post' activity for the author's feed and their friends.\"\"\"\n        author_id = event.get(\"author_id\", \"\")\n        if not author_id:\n            return\n        # feed_user_ids will be expanded by the caller if friend-of-friend fanout is needed.\n        # Base implementation: author's own timeline only.\n        await self.record_activity(ctx, payload={\n            \"activity_type\": ACTIVITY_POST_PUBLISHED,\n            \"actor_id\": author_id,\n            \"subject_id\": event.get(\"post_id\"),\n            \"subject_type\": \"post\",\n            \"subject_label\": event.get(\"body_preview\") or \"shared a post\",\n            \"feed_user_ids\": [author_id],\n            \"metadata\": {\"post_id\": event.get(\"post_id\")},\n        })\n\n    async def on_post_commented(self, ctx, event: dict) -> None:\n        \"\"\"Record a 'commented on a post' activity.\"\"\"\n        author_id = event.get(\"author_id\", \"\")\n        post_author_id = event.get(\"post_author_id\", \"\")\n        if not author_id:\n            return\n        feed_ids = list({author_id, post_author_id} - {\"\"})\n        await self.record_activity(ctx, payload={\n            \"activity_type\": ACTIVITY_POST_COMMENTED,\n            \"actor_id\": author_id,\n            \"about_user_id\": post_author_id or None,\n            \"subject_id\": event.get(\"post_id\"),\n            \"subject_type\": \"post\",\n            \"subject_label\": \"commented on a post\",\n            \"feed_user_ids\": feed_ids,\n            \"metadata\": {\n                \"post_id\": event.get(\"post_id\"),\n                \"comment_id\": event.get(\"comment_id\"),\n            },\n        })"},{"checksum":"sha256:19ded14def671ad3df86b304c6186341d33cac43d5a37a592880e93b7a4ee5d2","chunk_id":"chunk_1f3c72f7fdba2172","end_line":14,"path":"build_context/social/templates/modules/activity_feed/contracts/events.yaml","start_line":1,"symbol_ids":[],"text":"schema_version: mozaiks.events.v1\nevents:\n  - type: domain.social.activity.recorded\n    version: 1\n    producer: activity_feed\n    description: An activity event was recorded in the social feed.\n    payload_schema:\n      type: object\n      required: [event_id, activity_type, actor_id]\n      properties:\n        event_id:      { type: string }\n        activity_type: { type: string }\n        actor_id:      { type: string }\n        created_at:    { type: string }"},{"checksum":"sha256:9cb90975a4cf7869b1f8c620a52e40c0021d2537b51757b1ad2f57e0b421ff5a","chunk_id":"chunk_30f684d39e33b778","end_line":7,"path":"build_context/social/templates/modules/activity_feed/contracts/profile.yaml","start_line":1,"symbol_ids":[],"text":"schema_version: mozaiks.profile.v1\ntabs:\n  - id: activity\n    label: Activity\n    order: 30\n    action: get_profile_activity\n    component: ActivityFeedTab"},{"checksum":"sha256:9221eb1286dbff770a3d6a5db6ecddb027054d736c70127114a115c45f281b83","chunk_id":"chunk_a0a6e7fc71626cb1","end_line":22,"path":"build_context/social/templates/modules/activity_feed/contracts/reactions.yaml","start_line":1,"symbol_ids":[],"text":"schema_version: mozaiks.reactions.v1\nreactions:\n  - id: activity_feed_on_friendship_created\n    event_type: domain.social.friendship.created\n    target:\n      kind: handler\n      handler_method: on_friendship_created\n    description: Record connection activity when two users become friends.\n\n  - id: activity_feed_on_post_published\n    event_type: domain.social.post.published\n    target:\n      kind: handler\n      handler_method: on_post_published\n    description: Record post activity when a user publishes a post.\n\n  - id: activity_feed_on_post_commented\n    event_type: domain.social.post.commented\n    target:\n      kind: handler\n      handler_method: on_post_commented\n    description: Record comment activity when a user comments on a post."},{"checksum":"sha256:d883e4707c7d047298af868002983bdc6abcf9a854dba6afdf0519a8224fae37","chunk_id":"chunk_c738ca8331330270","end_line":105,"path":"build_context/social/templates/modules/activity_feed/module.yaml","start_line":1,"symbol_ids":[],"text":"schema_version: mozaiks.module.v1\nmodule:\n  id: activity_feed\n  display_name: Activity Feed\n  version: 1.0.0\n  description: >\n    Social activity stream. Records domain events from friends and user_posts\n    as structured activity records and surfaces them as personalized feeds\n    or per-user activity timelines on the profile page.\n  handler: backend.handler:ActivityFeedHandler\n  user_data_scope: true\n\npermissions:\n  - id: activity_feed.read\n    description: Read the activity feed and profile activity timelines.\n  - id: activity_feed.admin\n    description: Administer all activity event records.\n\nactions:\n  - id: get_feed\n    api_surface: public_readonly\n    description: >\n      Return a personalized activity feed for the current user \u2014 events\n      from their friends' activity, sorted newest-first.\n    handler_method: get_feed\n    input_schema:\n      type: object\n      additionalProperties: false\n      properties:\n        limit: { type: integer }\n        before: { type: string }\n    output_schema:\n      type: object\n      required: [events, count]\n      properties:\n        events: { type: array }\n        count: { type: integer }\n        next_cursor: { type: string }\n    permissions: [activity_feed.read]\n\n  - id: get_profile_activity\n    api_surface: public_readonly\n    description: >\n      Return the public activity timeline for a specific user.\n      Used to hydrate the Activity tab on /me and /u/:username.\n    handler_method: get_profile_activity\n    input_schema:\n      type: object\n      additionalProperties: false\n      properties:\n        user_id: { type: string }\n        limit: { type: integer }\n        before: { type: string }\n    output_schema:\n      type: object\n      required: [events, count]\n      properties:\n        events: { type: array }\n        count: { type: integer }\n        next_cursor: { type: string }\n    permissions: [activity_feed.read]\n\n  - id: record_activity\n    api_surface: internal\n    description: >\n      Internal action called by reactions to domain events. Records a\n      structured activity event into the feed. Do not call this from\n      user-facing action handlers \u2014 route it through reactions.yaml.\n    handler_method: record_activity\n    input_schema:\n      type: object\n      additionalProperties: false\n      required: [activity_type, actor_id]\n      properties:\n        activity_type: { type: string }\n        actor_id: { type: string }\n        about_user_id: { type: string }\n        subject_id: { type: string }\n        subject_type: { type: string }\n        subject_label: { type: string }\n        feed_user_ids: { type: array, items: { type: string } }\n        # metadata \u2014 closed activity context written by this pack's reaction\n        # handlers; every key is declared here.\n        metadata:\n          type: object\n          additionalProperties: false\n          properties:\n            friendship_id: { type: string }\n            post_id: { type: string }\n            comment_id: { type: string }\n    output_schema:\n      type: object\n      required: [success]\n      properties:\n        success: { type: boolean }\n        event_id: { type: string }\n    permissions: [activity_feed.admin]\n    emits: [domain.social.activity.recorded]\n\ncapabilities:\n  - capability_id: social.feed.read\n    kind: action\n    target: get_feed\n    title: Get Activity Feed\n    permissions: [activity_feed.read]"},{"checksum":"sha256:2171fb2b37fb65660688bd60bc300f47d603fb1635d09165c79fa6823099dc24","chunk_id":"chunk_71e68d1cbe07a55a","end_line":70,"path":"build_context/social/templates/modules/friends/backend/account_data_handler.py","start_line":1,"symbol_ids":["sym_08f92d3e98775bf5","sym_5688c2b48623fc15","sym_d5dffda7bb1cf300","sym_9f0d87c73ab707b2"],"text":"\"\"\"AccountDataHandler for the friends module.\n\nGDPR deletion and export for friend requests and friendship records.\n\nDeletion policy:\n  - Friendship records where user_id == deleted user: hard-deleted.\n  - Friendship records where friend_user_id == deleted user: hard-deleted.\n    (Both sides of the symmetric pair are removed so the peer also loses\n    the connection, which is correct \u2014 the user's consent to the\n    relationship is being revoked.)\n  - Friend requests where requester_id OR recipient_id == deleted user:\n    hard-deleted (both sent and received requests).\n\"\"\"\nfrom __future__ import annotations\n\nfrom typing import Any\n\n_FRIENDSHIPS = \"friends.friendships\"\n_REQUESTS = \"friends.requests\"\n\n\nclass AccountDataHandler:\n    \"\"\"GDPR delete + export handler for the friends module.\"\"\"\n\n    def __init__(self, db: Any) -> None:\n        self._db = db\n\n    async def delete_user_data(self, *, app_id: str, user_id: str) -> dict[str, Any]:\n        scope = {\"app_id\": app_id}\n\n        # Remove all friendship records involving this user (both directions).\n        fs_as_user = await self._db[_FRIENDSHIPS].delete_many({**scope, \"user_id\": user_id})\n        fs_as_friend = await self._db[_FRIENDSHIPS].delete_many({**scope, \"friend_user_id\": user_id})\n\n        # Remove all friend requests involving this user (sent or received).\n        req_sent = await self._db[_REQUESTS].delete_many({**scope, \"requester_id\": user_id})\n        req_received = await self._db[_REQUESTS].delete_many({**scope, \"recipient_id\": user_id})\n\n        deleted_count = (\n            fs_as_user.deleted_count\n            + fs_as_friend.deleted_count\n            + req_sent.deleted_count\n            + req_received.deleted_count\n        )\n        return {\n            \"friendships_deleted\": fs_as_user.deleted_count + fs_as_friend.deleted_count,\n            \"requests_deleted\": req_sent.deleted_count + req_received.deleted_count,\n            \"deleted_count\": deleted_count,\n        }\n\n    async def export_user_data(self, *, app_id: str, user_id: str) -> dict[str, Any]:\n        scope = {\"app_id\": app_id}\n\n        friendships = await self._db[_FRIENDSHIPS].find(\n            {**scope, \"user_id\": user_id}, {\"_id\": 0}\n        ).to_list(length=None)\n\n        requests_sent = await self._db[_REQUESTS].find(\n            {**scope, \"requester_id\": user_id}, {\"_id\": 0}\n        ).to_list(length=None)\n\n        requests_received = await self._db[_REQUESTS].find(\n            {**scope, \"recipient_id\": user_id}, {\"_id\": 0}\n        ).to_list(length=None)\n\n        return {\n            \"friendships\": friendships,\n            \"friend_requests_sent\": requests_sent,\n            \"friend_requests_received\": requests_received,\n        }"},{"checksum":"sha256:eab69b3e1f0b4474fa30427c30b7d90c637ccdc6350b2690925ad62659a34c23","chunk_id":"chunk_8ea3aad245b481ff","end_line":57,"path":"build_context/social/templates/modules/friends/backend/base_handler.py","start_line":1,"symbol_ids":["sym_5756063caa72ec94","sym_67d895a17fae5cf9","sym_4f0028681e389bb0","sym_00ec4906c4764f89","sym_bba4638e8d619275","sym_5e70d0434f849781","sym_d30c0fbcb3a9e90a","sym_c7731c16a2517079","sym_789a3a10eaa46008","sym_5064247428afaeba","sym_c5292cb4c669b8af","sym_7af947efa97315b5"],"text":"\"\"\"\nOSS-generated base handler for the friends module.\nDO NOT EDIT \u2014 regenerated on framework upgrades.\nPut app-specific customizations in handler.py (the workspace subclass).\n\"\"\"\nfrom __future__ import annotations\n\nfrom .service import FriendsService\n\n\nclass FriendsBaseHandler:\n    def __init__(self, service: FriendsService | None = None) -> None:\n        self._service = service or FriendsService()\n\n    async def send_friend_request(self, ctx, recipient_id: str = \"\", **_params):\n        return await self._service.send_friend_request(ctx, recipient_id=recipient_id)\n\n    async def accept_friend_request(self, ctx, request_id: str = \"\", **_params):\n        return await self._service.accept_friend_request(ctx, request_id=request_id)\n\n    async def decline_friend_request(self, ctx, request_id: str = \"\", **_params):\n        return await self._service.decline_friend_request(ctx, request_id=request_id)\n\n    async def withdraw_friend_request(self, ctx, request_id: str = \"\", **_params):\n        return await self._service.withdraw_friend_request(ctx, request_id=request_id)\n\n    async def remove_friend(self, ctx, friend_user_id: str = \"\", **_params):\n        return await self._service.remove_friend(ctx, friend_user_id=friend_user_id)\n\n    async def list_friends(self, ctx, limit=None, before=None, **_params):\n        return await self._service.list_friends(ctx, limit=limit, before=before)\n\n    async def list_friends_of(self, ctx, user_id: str = \"\", limit=None, before=None, **_params):\n        return await self._service.list_friends_of(ctx, user_id=user_id, limit=limit, before=before)\n\n    async def list_friend_requests(\n        self,\n        ctx,\n        direction: str = \"all\",\n        status: str = \"pending\",\n        limit=None,\n        before=None,\n        **_params,\n    ):\n        return await self._service.list_friend_requests(\n            ctx,\n            direction=direction,\n            status=status,\n            limit=limit,\n            before=before,\n        )\n\n    async def get_friendship_status(self, ctx, other_user_id: str = \"\", **_params):\n        return await self._service.get_friendship_status(ctx, other_user_id=other_user_id)\n\n    async def get_friends_count(self, ctx, **_params):\n        return await self._service.get_friends_count(ctx)"},{"checksum":"sha256:6986d9f1de297176d95e6788124ebc6269fe483ef8146035db44aa68e86e4ed5","chunk_id":"chunk_e6019b8cf6bab658","end_line":12,"path":"build_context/social/templates/modules/friends/backend/handler.py","start_line":1,"symbol_ids":["sym_cb72ad2f3df6abfc"],"text":"\"\"\"\nWorkspace handler for the friends module.\nSubclasses FriendsBaseHandler \u2014 add overrides and extra methods here.\nThis file is preserved across regeneration.\n\"\"\"\nfrom __future__ import annotations\n\nfrom .base_handler import FriendsBaseHandler\n\n\nclass FriendsHandler(FriendsBaseHandler):\n    \"\"\"App-local handler \u2014 extend or override base methods below.\"\"\""},{"checksum":"sha256:950dbe66c847ab9a9227f62f01ffe5d31d3189454fe1339e695ce4470251d484","chunk_id":"chunk_9c84dfaf27346c00","end_line":32,"path":"build_context/social/templates/modules/friends/backend/policy.py","start_line":1,"symbol_ids":["sym_1073c4dc702c7a42","sym_b8b7090a4b69f4d6","sym_4eb600c8fcb76248","sym_e4fabbbebef52434","sym_c270583db58b77b9"],"text":"\"\"\"Scoping helpers for the friends module.\"\"\"\nfrom __future__ import annotations\n\nfrom typing import Any\n\n\ndef actor_id(ctx) -> str:\n    return getattr(ctx, \"user_id\", None) or \"anonymous\"\n\n\ndef app_scope(ctx) -> dict[str, Any]:\n    app_id = getattr(ctx, \"app_id\", None)\n    return {\"app_id\": app_id} if app_id else {}\n\n\ndef friendship_query(ctx, *, user_id: str) -> dict[str, Any]:\n    \"\"\"Query scoped to app + a specific user's friendship records.\"\"\"\n    return {**app_scope(ctx), \"user_id\": user_id}\n\n\ndef request_query_as_requester(ctx, *, requester_id: str, status: str | None = None) -> dict[str, Any]:\n    q: dict[str, Any] = {**app_scope(ctx), \"requester_id\": requester_id}\n    if status and status != \"all\":\n        q[\"status\"] = status\n    return q\n\n\ndef request_query_as_recipient(ctx, *, recipient_id: str, status: str | None = None) -> dict[str, Any]:\n    q: dict[str, Any] = {**app_scope(ctx), \"recipient_id\": recipient_id}\n    if status and status != \"all\":\n        q[\"status\"] = status\n    return q"},{"checksum":"sha256:85de7c5d2c4b4f5d99eb6c04beebd272ce7965e90794e28d8c31fb8bf5f14737","chunk_id":"chunk_9cfbe90112795451","end_line":121,"path":"build_context/social/templates/modules/friends/backend/repo.py","start_line":1,"symbol_ids":["sym_919f30e878907eb2","sym_a371119c68614351","sym_378dfd99950b6504","sym_3498223797f8a181","sym_b36ad7227c2ffc73","sym_90eb486fc5ed646d","sym_56eccca3904f7aae","sym_2b9c94f6d54f668f","sym_4a8bc317ab665c40","sym_7d94996228c232c4","sym_7e4c7ea09723652d","sym_826d25472fbc146e","sym_ad35312da937ccde","sym_e5b5ea74df207829","sym_1bf45f13a72db008","sym_84d488b1addfb7fa"],"text":"from __future__ import annotations\n\nfrom collections.abc import Mapping\nfrom typing import Any\n\nDocument = dict[str, Any]\n\n\ndef _collection(ctx, entity_name: str):\n    persistence = getattr(ctx, \"persistence\", None)\n    if persistence is None:\n        raise RuntimeError(\"Persistence is not available for this app context.\")\n    return persistence.collection(\"friends\", entity_name)\n\n\ndef _norm(v: Any) -> Document | None:\n    return dict(v) if isinstance(v, Mapping) else None\n\n\ndef _norms(v: Any) -> list[Document]:\n    return [dict(i) for i in v or [] if isinstance(i, Mapping)]\n\n\nclass FriendRequestRepo:\n    async def create(self, ctx, doc: Document) -> Document:\n        await _collection(ctx, \"requests\").insert_one({**doc})\n        return doc\n\n    async def get(self, ctx, *, request_id: str) -> Document | None:\n        return _norm(await _collection(ctx, \"requests\").find_one({\"request_id\": request_id}))\n\n    async def find_pending(self, ctx, *, requester_id: str, recipient_id: str, app_id: str | None) -> Document | None:\n        q: dict[str, Any] = {\n            \"requester_id\": requester_id,\n            \"recipient_id\": recipient_id,\n            \"status\": \"pending\",\n        }\n        if app_id:\n            q[\"app_id\"] = app_id\n        return _norm(await _collection(ctx, \"requests\").find_one(q))\n\n    async def update_status(self, ctx, *, request_id: str, status: str, updated_at: str) -> bool:\n        result = await _collection(ctx, \"requests\").update_one(\n            {\"request_id\": request_id},\n            {\"$set\": {\"status\": status, \"updated_at\": updated_at}},\n        )\n        return bool(getattr(result, \"modified_count\", 0))\n\n    async def list(\n        self,\n        ctx,\n        *,\n        query: dict[str, Any],\n        limit: int,\n        before: str | None = None,\n    ) -> list[Document]:\n        if before:\n            query = {**query, \"created_at\": {\"$lt\": before}}\n        return _norms(\n            await _collection(ctx, \"requests\").find_many(\n                query,\n                limit=limit,\n                sort=[(\"created_at\", -1)],\n            )\n        )\n\n    async def count(self, ctx, *, query: dict[str, Any]) -> int:\n        return int(await _collection(ctx, \"requests\").count(query))\n\n\nclass FriendshipRepo:\n    async def create_pair(self, ctx, doc_a: Document, doc_b: Document) -> None:\n        col = _collection(ctx, \"friendships\")\n        await col.insert_one({**doc_a})\n        await col.insert_one({**doc_b})\n\n    async def find(self, ctx, *, user_id: str, friend_user_id: str, app_id: str | None) -> Document | None:\n        q: dict[str, Any] = {\"user_id\": user_id, \"friend_user_id\": friend_user_id}\n        if app_id:\n            q[\"app_id\"] = app_id\n        return _norm(await _collection(ctx, \"friendships\").find_one(q))\n\n    async def delete_pair(self, ctx, *, user_id: str, friend_user_id: str, app_id: str | None) -> int:\n        q: dict[str, Any] = {\n            \"$or\": [\n                {\"user_id\": user_id, \"friend_user_id\": friend_user_id},\n                {\"user_id\": friend_user_id, \"friend_user_id\": user_id},\n            ]\n        }\n        if app_id:\n            q[\"app_id\"] = app_id\n        result = await _collection(ctx, \"friendships\").delete_many(q)\n        return int(getattr(result, \"deleted_count\", 0))\n\n    async def list(\n        self,\n        ctx,\n        *,\n        user_id: str,\n        app_id: str | None,\n        limit: int,\n        before: str | None = None,\n    ) -> list[Document]:\n        q: dict[str, Any] = {\"user_id\": user_id}\n        if app_id:\n            q[\"app_id\"] = app_id\n        if before:\n            q[\"created_at\"] = {\"$lt\": before}\n        return _norms(\n            await _collection(ctx, \"friendships\").find_many(\n                q,\n                limit=limit,\n                sort=[(\"created_at\", -1)],\n            )\n        )\n\n    async def count(self, ctx, *, user_id: str, app_id: str | None) -> int:\n        q: dict[str, Any] = {\"user_id\": user_id}\n        if app_id:\n            q[\"app_id\"] = app_id\n        return int(await _collection(ctx, \"friendships\").count(q))"},{"checksum":"sha256:a0ff620efa8a3ac765ec9d585b9335c7b5fbc23175e347df931cb26b6b6e7338","chunk_id":"chunk_10d07f1b42489c99","end_line":58,"path":"build_context/social/templates/modules/friends/backend/schemas.py","start_line":1,"symbol_ids":["sym_3668d6db245e2d57","sym_b6eac7fa21792b02","sym_4e50cb83279c3f15","sym_4eb32a6103730f1e","sym_6c1897ff180a451f"],"text":"\"\"\"Type shapes and pure helpers for the friends module.\"\"\"\nfrom __future__ import annotations\n\nfrom datetime import UTC, datetime\nfrom typing import Any, TypedDict\n\n# \u2500\u2500 Status constants \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nREQUEST_STATUS_PENDING = \"pending\"\nREQUEST_STATUS_ACCEPTED = \"accepted\"\nREQUEST_STATUS_DECLINED = \"declined\"\nREQUEST_STATUS_WITHDRAWN = \"withdrawn\"\n\nFRIENDSHIP_STATUS_NONE = \"none\"\nFRIENDSHIP_STATUS_FRIENDS = \"friends\"\nFRIENDSHIP_STATUS_REQUEST_SENT = \"request_sent\"\nFRIENDSHIP_STATUS_REQUEST_RECEIVED = \"request_received\"\n\n\n# \u2500\u2500 TypedDicts \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nclass FriendRequest(TypedDict, total=False):\n    request_id: str\n    requester_id: str\n    requester_name: str\n    recipient_id: str\n    status: str          # pending | accepted | declined | withdrawn\n    created_at: str\n    updated_at: str\n\n\nclass Friendship(TypedDict, total=False):\n    friendship_id: str\n    user_id: str\n    friend_user_id: str\n    since: str           # ISO timestamp of when the friendship was created\n    created_at: str\n\n\n# \u2500\u2500 Helpers \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\ndef timestamp_now() -> str:\n    return datetime.now(UTC).isoformat()\n\n\ndef coerce_limit(value: Any, default: int = 20, maximum: int = 100) -> int:\n    try:\n        return max(1, min(int(value), maximum))\n    except (TypeError, ValueError):\n        return default\n\n\ndef safe_str(value: Any) -> str:\n    \"\"\"Return a non-empty stripped string or raise ValueError.\"\"\"\n    s = str(value or \"\").strip()\n    if not s:\n        raise ValueError(\"value must be a non-empty string\")\n    return s"},{"checksum":"sha256:8382ac3970b48d4bf6d56fe11af7a0981d0e48523420c79ea4fbe60d9c9c3465","chunk_id":"chunk_df6c260001299248","end_line":224,"path":"build_context/social/templates/modules/friends/backend/service.py","start_line":1,"symbol_ids":["sym_f4fe0d7f42ea7b91","sym_8e68aa29605ef0a4","sym_a989033c31c74905","sym_ca136fbb11706f20","sym_e78522d00de4ab48","sym_06d9e4883de4342b","sym_13f1433856904865","sym_b0fd4d5eb16666c0","sym_8364c92c0735a311","sym_0d27ef64aae13730","sym_de23180a246fe7d7"],"text":"\"\"\"Business logic for the friends module.\"\"\"\nfrom __future__ import annotations\n\nfrom uuid import uuid4\n\nfrom .policy import actor_id, app_scope\nfrom .repo import FriendRequestRepo, FriendshipRepo\nfrom .schemas import (\n    REQUEST_STATUS_ACCEPTED,\n    REQUEST_STATUS_DECLINED,\n    REQUEST_STATUS_PENDING,\n    REQUEST_STATUS_WITHDRAWN,\n    coerce_limit,\n    timestamp_now,\n)\n\n\nclass FriendsService:\n    def __init__(self) -> None:\n        self._requests = FriendRequestRepo()\n        self._friendships = FriendshipRepo()\n\n    # \u2500\u2500 Friend requests \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n    async def send_friend_request(self, ctx, *, recipient_id: str) -> dict:\n        user_id = actor_id(ctx)\n        app_id = getattr(ctx, \"app_id\", None)\n\n        if user_id == recipient_id:\n            return {\"success\": False, \"error\": \"You cannot send a friend request to yourself.\"}\n\n        # Already friends?\n        existing = await self._friendships.find(ctx, user_id=user_id, friend_user_id=recipient_id, app_id=app_id)\n        if existing:\n            return {\"success\": False, \"error\": \"You are already friends with this user.\"}\n\n        # Pending request already exists?\n        pending = await self._requests.find_pending(ctx, requester_id=user_id, recipient_id=recipient_id, app_id=app_id)\n        if pending:\n            return {\"success\": False, \"error\": \"A pending friend request already exists.\", \"request\": pending}\n\n        now = timestamp_now()\n        doc = {\n            \"request_id\": f\"req_{uuid4().hex}\",\n            \"requester_id\": user_id,\n            \"requester_name\": getattr(ctx, \"display_name\", None) or user_id,\n            \"recipient_id\": recipient_id,\n            \"status\": REQUEST_STATUS_PENDING,\n            \"created_at\": now,\n            \"updated_at\": now,\n            **app_scope(ctx),\n        }\n        await self._requests.create(ctx, doc)\n\n        await ctx.emit(\"domain.social.friend_request.sent\", {\n            \"request_id\": doc[\"request_id\"],\n            \"requester_id\": user_id,\n            \"requester_name\": doc[\"requester_name\"],\n            \"recipient_id\": recipient_id,\n            \"created_at\": now,\n        })\n\n        return {\"success\": True, \"request\": {k: v for k, v in doc.items() if k != \"app_id\"}}\n\n    async def accept_friend_request(self, ctx, *, request_id: str) -> dict:\n        user_id = actor_id(ctx)\n        req = await self._requests.get(ctx, request_id=request_id)\n\n        if not req:\n            return {\"success\": False, \"error\": \"Friend request not found.\"}\n        if req.get(\"recipient_id\") != user_id:\n            return {\"success\": False, \"error\": \"You can only accept requests addressed to you.\"}\n        if req.get(\"status\") != REQUEST_STATUS_PENDING:\n            return {\"success\": False, \"error\": f\"Request is already {req.get('status')}.\"}\n\n        now = timestamp_now()\n        await self._requests.update_status(ctx, request_id=request_id, status=REQUEST_STATUS_ACCEPTED, updated_at=now)\n\n        friendship_id = f\"fs_{uuid4().hex}\"\n        base = {\"friendship_id\": friendship_id, \"since\": now, \"created_at\": now, **app_scope(ctx)}\n        doc_a = {**base, \"user_id\": req[\"requester_id\"], \"friend_user_id\": user_id}\n        doc_b = {**base, \"user_id\": user_id, \"friend_user_id\": req[\"requester_id\"]}\n        await self._friendships.create_pair(ctx, doc_a, doc_b)\n\n        await ctx.emit(\"domain.social.friendship.created\", {\n            \"friendship_id\": friendship_id,\n            \"user_a_id\": req[\"requester_id\"],\n            \"user_b_id\": user_id,\n            \"requester_id\": req[\"requester_id\"],\n            \"request_id\": request_id,\n            \"created_at\": now,\n        })\n\n        return {\"success\": True, \"friendship\": {k: v for k, v in doc_a.items() if k != \"app_id\"}}\n\n    async def decline_friend_request(self, ctx, *, request_id: str) -> dict:\n        user_id = actor_id(ctx)\n        req = await self._requests.get(ctx, request_id=request_id)\n\n        if not req:\n            return {\"success\": False, \"error\": \"Friend request not found.\"}\n        if req.get(\"recipient_id\") != user_id:\n            return {\"success\": False, \"error\": \"You can only decline requests addressed to you.\"}\n        if req.get(\"status\") != REQUEST_STATUS_PENDING:\n            return {\"success\": False, \"error\": f\"Request is already {req.get('status')}.\"}\n\n        now = timestamp_now()\n        await self._requests.update_status(ctx, request_id=request_id, status=REQUEST_STATUS_DECLINED, updated_at=now)\n\n        await ctx.emit(\"domain.social.friend_request.declined\", {\n            \"request_id\": request_id,\n            \"requester_id\": req[\"requester_id\"],\n            \"recipient_id\": user_id,\n            \"declined_at\": now,\n        })\n\n        return {\"success\": True}\n\n    async def withdraw_friend_request(self, ctx, *, request_id: str) -> dict:\n        user_id = actor_id(ctx)\n        req = await self._requests.get(ctx, request_id=request_id)\n\n        if not req:\n            return {\"success\": False, \"error\": \"Friend request not found.\"}\n        if req.get(\"requester_id\") != user_id:\n            return {\"success\": False, \"error\": \"You can only withdraw requests you sent.\"}\n        if req.get(\"status\") != REQUEST_STATUS_PENDING:\n            return {\"success\": False, \"error\": f\"Request is already {req.get('status')}.\"}\n\n        now = timestamp_now()\n        await self._requests.update_status(ctx, request_id=request_id, status=REQUEST_STATUS_WITHDRAWN, updated_at=now)\n\n        await ctx.emit(\"domain.social.friend_request.withdrawn\", {\n            \"request_id\": request_id,\n            \"requester_id\": user_id,\n            \"recipient_id\": req[\"recipient_id\"],\n            \"withdrawn_at\": now,\n        })\n\n        return {\"success\": True}\n\n    # \u2500\u2500 Friendships \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n    async def remove_friend(self, ctx, *, friend_user_id: str) -> dict:\n        user_id = actor_id(ctx)\n        app_id = getattr(ctx, \"app_id\", None)\n\n        deleted = await self._friendships.delete_pair(ctx, user_id=user_id, friend_user_id=friend_user_id, app_id=app_id)\n        if not deleted:\n            return {\"success\": False, \"error\": \"Friendship not found.\"}\n\n        now = timestamp_now()\n        await ctx.emit(\"domain.social.friendship.removed\", {\n            \"user_id\": user_id,\n            \"friend_user_id\": friend_user_id,\n            \"removed_at\": now,\n        })\n\n        return {\"success\": True}\n\n    async def list_friends(self, ctx, *, limit: int | None = None, before: str | None = None) -> dict:\n        user_id = actor_id(ctx)\n        app_id = getattr(ctx, \"app_id\", None)\n        bounded = coerce_limit(limit)\n        rows = await self._friendships.list(ctx, user_id=user_id, app_id=app_id, limit=bounded + 1, before=before)\n        has_more = len(rows) > bounded\n        page = rows[:bounded]\n        return {\n            \"friends\": page,\n            \"count\": len(page),\n            \"next_cursor\": page[-1][\"created_at\"] if has_more and page else None,\n        }\n\n    async def list_friends_of(self, ctx, *, user_id: str, limit: int | None = None, before: str | None = None) -> dict:\n        app_id = getattr(ctx, \"app_id\", None)\n        bounded = coerce_limit(limit)\n        rows = await self._friendships.list(ctx, user_id=user_id, app_id=app_id, limit=bounded + 1, before=before)\n        has_more = len(rows) > bounded\n        page = rows[:bounded]\n        return {\n            \"friends\": page,\n            \"count\": len(page),\n            \"next_cursor\": page[-1][\"created_at\"] if has_more and page else None,\n        }\n\n    async def list_friend_requests(\n        self,\n        ctx,\n        *,\n        direction: str = \"all\",\n        status: str = \"pending\",\n        limit: int | None = None,\n        before: str | None = None,\n    ) -> dict:\n        from .policy import request_query_as_recipient, request_query_as_requester\n\n        user_id = actor_id(ctx)\n        bounded = coerce_limit(limit)\n        norm_status = None if status == \"all\" else status\n\n        rows: list = []\n        if direction in (\"incoming\", \"all\"):\n            rows += await self._requests.list(\n                ctx,\n                query=request_query_as_recipient(ctx, recipient_id=user_id, status=norm_status),\n                limit=bounded,\n                before=before,\n            )\n        if direction in (\"outgoing\", \"all\"):\n            rows += await self._requests.list(\n                ctx,\n                query=request_query_as_requester(ctx, requester_id=user_id, status=norm_status),\n                limit=bounded,\n                before=before,\n            )\n\n        rows.sort(key=lambda r: r.get(\"created_at\", \"\"), reverse=True)\n        page = rows[:bounded]\n        return {\"requests\": page, \"count\": len(page)}\n\n    async def get_friendship_status(self, ctx, *, other_user_id: str) -> dict:\n        user_id = actor_id(ctx)\n        app_id = getattr(ctx, \"app_id\", None)\n"},{"checksum":"sha256:13d8082ff6234ddaf965dd61e271f1b5fd48be27aa69c48fbc81f0103da4a007","chunk_id":"chunk_616eb9cbe247623f","end_line":243,"path":"build_context/social/templates/modules/friends/backend/service.py","start_line":225,"symbol_ids":["sym_f4fe0d7f42ea7b91","sym_de23180a246fe7d7","sym_71de70d6ff08d983"],"text":"        friendship = await self._friendships.find(ctx, user_id=user_id, friend_user_id=other_user_id, app_id=app_id)\n        if friendship:\n            return {\"status\": \"friends\", \"friendship\": friendship}\n\n        sent = await self._requests.find_pending(ctx, requester_id=user_id, recipient_id=other_user_id, app_id=app_id)\n        if sent:\n            return {\"status\": \"request_sent\", \"request\": sent}\n\n        received = await self._requests.find_pending(ctx, requester_id=other_user_id, recipient_id=user_id, app_id=app_id)\n        if received:\n            return {\"status\": \"request_received\", \"request\": received}\n\n        return {\"status\": \"none\"}\n\n    async def get_friends_count(self, ctx) -> dict:\n        user_id = actor_id(ctx)\n        app_id = getattr(ctx, \"app_id\", None)\n        count = await self._friendships.count(ctx, user_id=user_id, app_id=app_id)\n        return {\"count\": count}"},{"checksum":"sha256:c5698b04012b72da6de1275c14f5ed8a17e79a39ab01e7df6dfe75a1f9ba4058","chunk_id":"chunk_d2bf170f2dc6bec1","end_line":68,"path":"build_context/social/templates/modules/friends/contracts/events.yaml","start_line":1,"symbol_ids":[],"text":"schema_version: mozaiks.events.v1\nevents:\n  - type: domain.social.friend_request.sent\n    version: 1\n    producer: friends\n    description: A user sent a friend request to another user.\n    payload_schema:\n      type: object\n      required: [request_id, requester_id, recipient_id]\n      properties:\n        request_id:     { type: string }\n        requester_id:   { type: string }\n        requester_name: { type: string }\n        recipient_id:   { type: string }\n        created_at:     { type: string }\n\n  - type: domain.social.friend_request.declined\n    version: 1\n    producer: friends\n    description: A recipient declined a pending friend request.\n    payload_schema:\n      type: object\n      required: [request_id, requester_id, recipient_id]\n      properties:\n        request_id:   { type: string }\n        requester_id: { type: string }\n        recipient_id: { type: string }\n        declined_at:  { type: string }\n\n  - type: domain.social.friend_request.withdrawn\n    version: 1\n    producer: friends\n    description: A requester withdrew their pending friend request.\n    payload_schema:\n      type: object\n      required: [request_id, requester_id, recipient_id]\n      properties:\n        request_id:   { type: string }\n        requester_id: { type: string }\n        recipient_id: { type: string }\n        withdrawn_at: { type: string }\n\n  - type: domain.social.friendship.created\n    version: 1\n    producer: friends\n    description: Two users became friends (friend request accepted).\n    payload_schema:\n      type: object\n      required: [friendship_id, user_a_id, user_b_id, requester_id, request_id]\n      properties:\n        friendship_id: { type: string }\n        user_a_id:     { type: string }\n        user_b_id:     { type: string }\n        requester_id:  { type: string }\n        request_id:    { type: string }\n        created_at:    { type: string }\n\n  - type: domain.social.friendship.removed\n    version: 1\n    producer: friends\n    description: A user removed a friend connection.\n    payload_schema:\n      type: object\n      required: [user_id, friend_user_id]\n      properties:\n        user_id:        { type: string }\n        friend_user_id: { type: string }\n        removed_at:     { type: string }"},{"checksum":"sha256:3db11f6a6e0ee5da544ccbf59c2bb45d53c8d8bbe3947cf4c895de2b192369ee","chunk_id":"chunk_7c10540baf2f40f6","end_line":31,"path":"build_context/social/templates/modules/friends/contracts/notifications.yaml","start_line":1,"symbol_ids":[],"text":"schema_version: mozaiks.notifications.v1\nnotifications:\n  - id: friend_request_received\n    description: Notify a user when they receive a new friend request.\n    \"on\": domain.social.friend_request.sent\n    template:\n      title: \"{{requester_name}} sent you a friend request\"\n      body: \"{{requester_name}} wants to connect with you.\"\n    channels:\n      - in_app\n    audience:\n      user_id_field: recipient_id\n    context_fields:\n      - request_id\n      - requester_id\n      - requester_name\n\n  - id: friend_request_accepted\n    description: Notify a user when their friend request is accepted.\n    \"on\": domain.social.friendship.created\n    template:\n      title: \"You and another user are now friends\"\n      body: \"Your friend request was accepted.\"\n    channels:\n      - in_app\n    audience:\n      user_id_field: requester_id\n    context_fields:\n      - friendship_id\n      - user_a_id\n      - user_b_id"},{"checksum":"sha256:bebb0cce72bee1a09b2c4976be0f6d3906466c8aacb0201ea395337e062d5cd3","chunk_id":"chunk_077c54b9f3663007","end_line":7,"path":"build_context/social/templates/modules/friends/contracts/profile.yaml","start_line":1,"symbol_ids":[],"text":"schema_version: mozaiks.profile.v1\ntabs:\n  - id: friends\n    label: Friends\n    order: 10\n    action: list_friends_of\n    component: FriendListTab"},{"checksum":"sha256:54abac9dc508246a2ca6e2bab3b87bffcd3599cf8284fed2c8727dfd9cc80160","chunk_id":"chunk_21d70e7ce206ce88","end_line":5,"path":"build_context/social/templates/modules/friends/contracts/reactions.yaml","start_line":1,"symbol_ids":[],"text":"schema_version: mozaiks.reactions.v1\nreactions: []\n# No inbound reactions in the friends module.\n# The activity_feed module subscribes to domain.social.friendship.created\n# and domain.social.friend_request.sent via its own reactions.yaml."},{"checksum":"sha256:a0710535bbcea13e7effd8b9d3c879aeecc24180f4e1b377a28cc7800adfa65a","chunk_id":"chunk_5c0f93b9d813dd9c","end_line":226,"path":"build_context/social/templates/modules/friends/module.yaml","start_line":1,"symbol_ids":[],"text":"schema_version: mozaiks.module.v1\nmodule:\n  id: friends\n  display_name: Friends\n  version: 1.0.0\n  description: >\n    Bidirectional friend connections with friend request lifecycle.\n    Users send, accept, decline, and withdraw requests; accepted requests\n    create symmetric friendship records queryable by either party.\n  user_data_scope: true\n  handler: backend.handler:FriendsHandler\n\npermissions:\n  - id: friends.read\n    description: Read your own friend list and request inbox.\n  - id: friends.manage\n    description: Send, accept, decline, and remove friend connections.\n  - id: friends.admin\n    description: Administer all friendship records.\n\nactions:\n  - id: send_friend_request\n    api_surface: public\n    description: Send a friend request to another user.\n    handler_method: send_friend_request\n    input_schema:\n      type: object\n      additionalProperties: false\n      required: [recipient_id]\n      properties:\n        recipient_id: { type: string }\n    output_schema:\n      type: object\n      required: [success]\n      properties:\n        success: { type: boolean }\n        request: { type: object }\n        error: { type: string }\n    permissions: [friends.manage]\n    emits: [domain.social.friend_request.sent]\n\n  - id: accept_friend_request\n    api_surface: public\n    description: Accept a pending friend request addressed to the current user.\n    handler_method: accept_friend_request\n    input_schema:\n      type: object\n      additionalProperties: false\n      required: [request_id]\n      properties:\n        request_id: { type: string }\n    output_schema:\n      type: object\n      required: [success]\n      properties:\n        success: { type: boolean }\n        friendship: { type: object }\n        error: { type: string }\n    permissions: [friends.manage]\n    emits: [domain.social.friendship.created]\n\n  - id: decline_friend_request\n    api_surface: public\n    description: Decline a pending friend request addressed to the current user.\n    handler_method: decline_friend_request\n    input_schema:\n      type: object\n      additionalProperties: false\n      required: [request_id]\n      properties:\n        request_id: { type: string }\n    output_schema:\n      type: object\n      required: [success]\n      properties:\n        success: { type: boolean }\n        error: { type: string }\n    permissions: [friends.manage]\n    emits: [domain.social.friend_request.declined]\n\n  - id: withdraw_friend_request\n    api_surface: public\n    description: Withdraw a pending friend request sent by the current user.\n    handler_method: withdraw_friend_request\n    input_schema:\n      type: object\n      additionalProperties: false\n      required: [request_id]\n      properties:\n        request_id: { type: string }\n    output_schema:\n      type: object\n      required: [success]\n      properties:\n        success: { type: boolean }\n        error: { type: string }\n    permissions: [friends.manage]\n    emits: [domain.social.friend_request.withdrawn]\n\n  - id: remove_friend\n    api_surface: public\n    description: Remove an existing friend connection (symmetric \u2014 removes both sides).\n    handler_method: remove_friend\n    input_schema:\n      type: object\n      additionalProperties: false\n      required: [friend_user_id]\n      properties:\n        friend_user_id: { type: string }\n    output_schema:\n      type: object\n      required: [success]\n      properties:\n        success: { type: boolean }\n        error: { type: string }\n    permissions: [friends.manage]\n    emits: [domain.social.friendship.removed]\n\n  - id: list_friends\n    api_surface: public_readonly\n    description: List friends of the current user with cursor pagination.\n    handler_method: list_friends\n    input_schema:\n      type: object\n      additionalProperties: false\n      properties:\n        before: { type: string }\n        limit: { type: integer }\n    output_schema:\n      type: object\n      required: [friends, count]\n      properties:\n        friends: { type: array }\n        count: { type: integer }\n        next_cursor: { type: string }\n    permissions: [friends.read]\n\n  - id: list_friends_of\n    api_surface: public_readonly\n    description: List friends of a specific user (public profile surface).\n    handler_method: list_friends_of\n    input_schema:\n      type: object\n      additionalProperties: false\n      required: [user_id]\n      properties:\n        user_id: { type: string }\n        before: { type: string }\n        limit: { type: integer }\n    output_schema:\n      type: object\n      required: [friends, count]\n      properties:\n        friends: { type: array }\n        count: { type: integer }\n        next_cursor: { type: string }\n    permissions: [friends.read]\n\n  - id: list_friend_requests\n    api_surface: public_readonly\n    description: List incoming and/or outgoing friend requests for the current user.\n    handler_method: list_friend_requests\n    input_schema:\n      type: object\n      additionalProperties: false\n      properties:\n        direction: { type: string, enum: [incoming, outgoing, all] }\n        status: { type: string, enum: [pending, accepted, declined, withdrawn, all] }\n        limit: { type: integer }\n        before: { type: string }\n    output_schema:\n      type: object\n      required: [requests, count]\n      properties:\n        requests: { type: array }\n        count: { type: integer }\n        next_cursor: { type: string }\n    permissions: [friends.read]\n\n  - id: get_friendship_status\n    api_surface: public_readonly\n    description: >\n      Return the friendship status between the current user and another user.\n      Status values: none | friends | request_sent | request_received.\n    handler_method: get_friendship_status\n    input_schema:\n      type: object\n      additionalProperties: false\n      required: [other_user_id]\n      properties:\n        other_user_id: { type: string }\n    output_schema:\n      type: object\n      required: [status]\n      properties:\n        status: { type: string }\n        friendship: { type: object }\n        request: { type: object }\n    permissions: [friends.read]\n\n  - id: get_friends_count\n    api_surface: public_readonly\n    description: Return the total friend count for the current user.\n    handler_method: get_friends_count\n    input_schema:\n      type: object\n      additionalProperties: false\n      properties: {}\n    output_schema:\n      type: object\n      required: [count]\n      properties:\n        count: { type: integer }\n    permissions: [friends.read]\n\ncapabilities:\n  - capability_id: social.friends.list\n    kind: action\n    target: list_friends\n    title: List Friends\n    permissions: [friends.read]\n  - capability_id: social.friends.connect\n    kind: action\n    target: send_friend_request\n    title: Send Friend Request\n    permissions: [friends.manage]"},{"checksum":"sha256:1f5e73bc1027f60545a1721613af9dd6d31bca43c7eab43dfc46fc47f95c11a1","chunk_id":"chunk_b4e138612051a39e","end_line":62,"path":"build_context/social/templates/modules/user_posts/backend/account_data_handler.py","start_line":1,"symbol_ids":["sym_536d6046a860a7e1","sym_037ad1b52e5d9225","sym_111c1315fd4c3220","sym_ad829485cf55beb4"],"text":"\"\"\"AccountDataHandler for the user_posts module.\n\nGDPR deletion and export for posts, reactions, and comments.\n\nDeletion policy:\n  - Posts authored by the deleted user: hard-deleted (overrides the normal\n    soft-delete path \u2014 GDPR takes precedence over thread integrity).\n  - Post reactions left by the deleted user: hard-deleted.\n  - Comments authored by the deleted user: hard-deleted.\n    Reaction and comment counts on surviving posts will drift; this is\n    acceptable \u2014 the platform must not retain user data to preserve counts.\n\"\"\"\nfrom __future__ import annotations\n\nfrom typing import Any\n\n_POSTS = \"user_posts.posts\"\n_REACTIONS = \"user_posts.reactions\"\n_COMMENTS = \"user_posts.comments\"\n\n\nclass AccountDataHandler:\n    \"\"\"GDPR delete + export handler for the user_posts module.\"\"\"\n\n    def __init__(self, db: Any) -> None:\n        self._db = db\n\n    async def delete_user_data(self, *, app_id: str, user_id: str) -> dict[str, Any]:\n        scope = {\"app_id\": app_id}\n\n        posts = await self._db[_POSTS].delete_many({**scope, \"author_id\": user_id})\n        reactions = await self._db[_REACTIONS].delete_many({**scope, \"user_id\": user_id})\n        comments = await self._db[_COMMENTS].delete_many({**scope, \"author_id\": user_id})\n\n        deleted_count = posts.deleted_count + reactions.deleted_count + comments.deleted_count\n        return {\n            \"posts_deleted\": posts.deleted_count,\n            \"reactions_deleted\": reactions.deleted_count,\n            \"comments_deleted\": comments.deleted_count,\n            \"deleted_count\": deleted_count,\n        }\n\n    async def export_user_data(self, *, app_id: str, user_id: str) -> dict[str, Any]:\n        scope = {\"app_id\": app_id}\n\n        posts = await self._db[_POSTS].find(\n            {**scope, \"author_id\": user_id}, {\"_id\": 0}\n        ).to_list(length=None)\n\n        reactions = await self._db[_REACTIONS].find(\n            {**scope, \"user_id\": user_id}, {\"_id\": 0}\n        ).to_list(length=None)\n\n        comments = await self._db[_COMMENTS].find(\n            {**scope, \"author_id\": user_id}, {\"_id\": 0}\n        ).to_list(length=None)\n\n        return {\n            \"posts\": posts,\n            \"post_reactions\": reactions,\n            \"post_comments\": comments,\n        }"},{"checksum":"sha256:f058ba54fb2e6662e7f36e87fa034e091b443d5fb9a9f43de3707a18b1e89b32","chunk_id":"chunk_886e642395a90837","end_line":54,"path":"build_context/social/templates/modules/user_posts/backend/base_handler.py","start_line":1,"symbol_ids":["sym_0485da0c34686acc","sym_1bd0bba5170363e9","sym_42a3a760beecf075","sym_f202f8b9f225e0d5","sym_507abde50449f1d1","sym_d65f10a46039eb9a","sym_d919eaa210146e00","sym_bd6a6bac396069d6","sym_1553c68b33d3ac93","sym_593735bed582eb1a","sym_27792a6a84366ebc","sym_44474a85b5008593"],"text":"\"\"\"\nOSS-generated base handler for the user_posts module.\nDO NOT EDIT \u2014 regenerated on framework upgrades.\nPut app-specific customizations in handler.py (the workspace subclass).\n\"\"\"\nfrom __future__ import annotations\n\nfrom .service import UserPostsService\n\n\nclass UserPostsBaseHandler:\n    def __init__(self, service: UserPostsService | None = None) -> None:\n        self._service = service or UserPostsService()\n\n    async def create_post(self, ctx, body: str = \"\", media_urls=None, visibility=None, **_params):\n        return await self._service.create_post(\n            ctx,\n            body=body,\n            media_urls=media_urls,\n            visibility=visibility,\n        )\n\n    async def get_post(self, ctx, post_id: str = \"\", **_params):\n        return await self._service.get_post(ctx, post_id=post_id)\n\n    async def delete_post(self, ctx, post_id: str = \"\", **_params):\n        return await self._service.delete_post(ctx, post_id=post_id)\n\n    async def list_posts(self, ctx, author_id=None, visibility=None, limit=None, before=None, **_params):\n        return await self._service.list_posts(\n            ctx,\n            author_id=author_id,\n            visibility=visibility,\n            limit=limit,\n            before=before,\n        )\n\n    async def list_user_posts(self, ctx, user_id: str | None = None, limit=None, before=None, **_params):\n        return await self._service.list_user_posts(ctx, user_id=user_id, limit=limit, before=before)\n\n    async def react_to_post(self, ctx, post_id: str = \"\", reaction_type=None, **_params):\n        return await self._service.react_to_post(ctx, post_id=post_id, reaction_type=reaction_type)\n\n    async def get_reaction_summary(self, ctx, post_id: str = \"\", **_params):\n        return await self._service.get_reaction_summary(ctx, post_id=post_id)\n\n    async def add_comment(self, ctx, post_id: str = \"\", body: str = \"\", **_params):\n        return await self._service.add_comment(ctx, post_id=post_id, body=body)\n\n    async def delete_comment(self, ctx, comment_id: str = \"\", **_params):\n        return await self._service.delete_comment(ctx, comment_id=comment_id)\n\n    async def list_comments(self, ctx, post_id: str = \"\", limit=None, after=None, **_params):\n        return await self._service.list_comments(ctx, post_id=post_id, limit=limit, after=after)"},{"checksum":"sha256:63119188fc052b87f65852dc96eddf2622d5e9598911c09ce423afdf2a9d92df","chunk_id":"chunk_67501780b4487695","end_line":12,"path":"build_context/social/templates/modules/user_posts/backend/handler.py","start_line":1,"symbol_ids":["sym_44c2a48605c3d2f6"],"text":"\"\"\"\nWorkspace handler for the user_posts module.\nSubclasses UserPostsBaseHandler \u2014 add overrides and extra methods here.\nThis file is preserved across regeneration.\n\"\"\"\nfrom __future__ import annotations\n\nfrom .base_handler import UserPostsBaseHandler\n\n\nclass UserPostsHandler(UserPostsBaseHandler):\n    \"\"\"App-local handler \u2014 extend or override base methods below.\"\"\""},{"checksum":"sha256:1ecd646940a5a196e69c5d9f241e694d06dd9721e04bbbb292b070705d59724a","chunk_id":"chunk_f097b20b69a10487","end_line":30,"path":"build_context/social/templates/modules/user_posts/backend/policy.py","start_line":1,"symbol_ids":["sym_6723eb17b15b7808","sym_d00af44aa8974cec","sym_521a070bd16da219","sym_7a06ed08e3d69339","sym_f830fee732a7dd9a"],"text":"\"\"\"Scoping and authorization helpers for the user_posts module.\"\"\"\nfrom __future__ import annotations\n\nfrom typing import Any\n\n\ndef actor_id(ctx) -> str:\n    return getattr(ctx, \"user_id\", None) or \"anonymous\"\n\n\ndef app_scope(ctx) -> dict[str, Any]:\n    app_id = getattr(ctx, \"app_id\", None)\n    return {\"app_id\": app_id} if app_id else {}\n\n\ndef published_posts_query(ctx, *, author_id: str | None = None, visibility: str | None = None) -> dict[str, Any]:\n    q: dict[str, Any] = {**app_scope(ctx), \"status\": \"published\"}\n    if author_id:\n        q[\"author_id\"] = author_id\n    if visibility and visibility != \"all\":\n        q[\"visibility\"] = visibility\n    return q\n\n\ndef can_delete_post(post: dict[str, Any], user_id: str, roles: list[str]) -> bool:\n    return post.get(\"author_id\") == user_id or \"admin\" in roles or \"moderator\" in roles\n\n\ndef can_delete_comment(comment: dict[str, Any], user_id: str, roles: list[str]) -> bool:\n    return comment.get(\"author_id\") == user_id or \"admin\" in roles or \"moderator\" in roles"},{"checksum":"sha256:6abba912f8640db9285f1a804048c3d03e48e3e9fd10fa78b0a47166f4b622a4","chunk_id":"chunk_6c2b2baaf9be11da","end_line":113,"path":"build_context/social/templates/modules/user_posts/backend/repo.py","start_line":1,"symbol_ids":["sym_22e45d69f7c2349e","sym_9ef7d37a1de42101","sym_ab7131a55192c37c","sym_e637a7b0c5fe826b","sym_1c04ca7adb573af0","sym_6cf6dcd71ac90bef","sym_7c86c34616def827","sym_74797d0526e5ddb1","sym_04beadca38535620","sym_4eaa6afe41a3611c","sym_3690e0637a488406","sym_3589cf84fb8cc333","sym_9dec4ac2148afae3","sym_7b01a1a97a909ff6","sym_e2b16df993b9ff7f","sym_2d683bbfb7049f10","sym_676419eeee350959","sym_01971cb986cfbcb3","sym_cd0f0945018a24e5","sym_ab3c0324857228e5","sym_26102bfe972e6805","sym_3264744d3311de1d"],"text":"from __future__ import annotations\n\nfrom collections.abc import Mapping\nfrom typing import Any\n\nDocument = dict[str, Any]\n\n\ndef _collection(ctx, entity_name: str):\n    persistence = getattr(ctx, \"persistence\", None)\n    if persistence is None:\n        raise RuntimeError(\"Persistence is not available for this app context.\")\n    return persistence.collection(\"user_posts\", entity_name)\n\n\ndef _norm(v: Any) -> Document | None:\n    return dict(v) if isinstance(v, Mapping) else None\n\n\ndef _norms(v: Any) -> list[Document]:\n    return [dict(i) for i in v or [] if isinstance(i, Mapping)]\n\n\nclass PostRepo:\n    async def create(self, ctx, doc: Document) -> Document:\n        await _collection(ctx, \"posts\").insert_one({**doc})\n        return doc\n\n    async def get(self, ctx, *, post_id: str) -> Document | None:\n        return _norm(await _collection(ctx, \"posts\").find_one({\"post_id\": post_id}))\n\n    async def soft_delete(self, ctx, *, post_id: str, deleted_at: str) -> bool:\n        result = await _collection(ctx, \"posts\").update_one(\n            {\"post_id\": post_id},\n            {\"$set\": {\"status\": \"deleted\", \"updated_at\": deleted_at}},\n        )\n        return bool(getattr(result, \"modified_count\", 0))\n\n    async def list(self, ctx, *, query: dict[str, Any], limit: int, before: str | None = None) -> list[Document]:\n        if before:\n            query = {**query, \"created_at\": {\"$lt\": before}}\n        return _norms(\n            await _collection(ctx, \"posts\").find_many(\n                query,\n                limit=limit,\n                sort=[(\"created_at\", -1)],\n            )\n        )\n\n    async def increment_comment_count(self, ctx, *, post_id: str, delta: int = 1) -> None:\n        await _collection(ctx, \"posts\").update_one(\n            {\"post_id\": post_id}, {\"$inc\": {\"comment_count\": delta}}\n        )\n\n    async def set_reaction_count(self, ctx, *, post_id: str, count: int) -> None:\n        await _collection(ctx, \"posts\").update_one(\n            {\"post_id\": post_id}, {\"$set\": {\"reaction_count\": count}}\n        )\n\n\nclass ReactionRepo:\n    async def get(self, ctx, *, post_id: str, user_id: str) -> Document | None:\n        return _norm(await _collection(ctx, \"reactions\").find_one({\"post_id\": post_id, \"user_id\": user_id}))\n\n    async def upsert(self, ctx, doc: Document) -> None:\n        await _collection(ctx, \"reactions\").update_one(\n            {\"post_id\": doc[\"post_id\"], \"user_id\": doc[\"user_id\"]},\n            {\"$set\": {**doc}},\n            upsert=True,\n        )\n\n    async def delete(self, ctx, *, post_id: str, user_id: str) -> bool:\n        result = await _collection(ctx, \"reactions\").delete_one({\"post_id\": post_id, \"user_id\": user_id})\n        return bool(getattr(result, \"deleted_count\", 0))\n\n    async def count_by_post(self, ctx, *, post_id: str) -> int:\n        return int(await _collection(ctx, \"reactions\").count({\"post_id\": post_id}))\n\n    async def count_by_type(self, ctx, *, post_id: str) -> dict[str, int]:\n        pipeline = [\n            {\"$match\": {\"post_id\": post_id}},\n            {\"$group\": {\"_id\": \"$reaction_type\", \"count\": {\"$sum\": 1}}},\n        ]\n        results = await _collection(ctx, \"reactions\").aggregate(pipeline)\n        return {r[\"_id\"]: r[\"count\"] for r in results if r.get(\"_id\")}\n\n\nclass CommentRepo:\n    async def create(self, ctx, doc: Document) -> Document:\n        await _collection(ctx, \"comments\").insert_one({**doc})\n        return doc\n\n    async def get(self, ctx, *, comment_id: str) -> Document | None:\n        return _norm(await _collection(ctx, \"comments\").find_one({\"comment_id\": comment_id}))\n\n    async def delete(self, ctx, *, comment_id: str) -> bool:\n        result = await _collection(ctx, \"comments\").delete_one({\"comment_id\": comment_id})\n        return bool(getattr(result, \"deleted_count\", 0))\n\n    async def list(self, ctx, *, post_id: str, limit: int, after: str | None = None) -> list[Document]:\n        q: dict[str, Any] = {\"post_id\": post_id}\n        if after:\n            q[\"created_at\"] = {\"$gt\": after}\n        return _norms(\n            await _collection(ctx, \"comments\").find_many(\n                q,\n                limit=limit,\n                sort=[(\"created_at\", 1)],\n            )\n        )\n\n    async def count(self, ctx, *, post_id: str) -> int:\n        return int(await _collection(ctx, \"comments\").count({\"post_id\": post_id}))"},{"checksum":"sha256:c7d7ed49027440674a23c0b717d06b70d4be7447000dac8076132f3754893c9e","chunk_id":"chunk_2839fbc9af372ca9","end_line":65,"path":"build_context/social/templates/modules/user_posts/backend/schemas.py","start_line":1,"symbol_ids":["sym_1b1c11f414533b9e","sym_3fdfd4fb483c6c33","sym_c935fcf0c2bfa47c","sym_b5b94d98bfdddc44","sym_98fbdbd3abc91c97","sym_5dd0740b04d61540"],"text":"\"\"\"Type shapes and helpers for the user_posts module.\"\"\"\nfrom __future__ import annotations\n\nfrom datetime import UTC, datetime\nfrom typing import Any, TypedDict\n\nPOST_STATUS_PUBLISHED = \"published\"\nPOST_STATUS_DELETED = \"deleted\"\n\nVISIBILITY_PUBLIC = \"public\"\nVISIBILITY_FRIENDS = \"friends\"\nVISIBILITY_PRIVATE = \"private\"\n\nREACTION_TYPES = {\"like\", \"love\", \"celebrate\", \"support\"}\nDEFAULT_REACTION = \"like\"\n\n# Body length limits enforced by the service. The closed module request\n# contract cannot carry maxLength, so these are the behavioral authority.\nMAX_POST_BODY_LENGTH = 5000\nMAX_COMMENT_BODY_LENGTH = 2000\n\n\nclass Post(TypedDict, total=False):\n    post_id: str\n    author_id: str\n    body: str\n    body_preview: str       # first 200 chars for feed/event payloads\n    media_urls: list[str]\n    visibility: str         # public | friends | private\n    status: str             # published | deleted\n    reaction_count: int\n    comment_count: int\n    created_at: str\n    updated_at: str\n\n\nclass Comment(TypedDict, total=False):\n    comment_id: str\n    post_id: str\n    author_id: str\n    body: str\n    created_at: str\n\n\nclass PostReaction(TypedDict, total=False):\n    post_id: str\n    user_id: str\n    reaction_type: str\n    created_at: str\n\n\ndef timestamp_now() -> str:\n    return datetime.now(UTC).isoformat()\n\n\ndef coerce_limit(value: Any, default: int = 20, maximum: int = 100) -> int:\n    try:\n        return max(1, min(int(value), maximum))\n    except (TypeError, ValueError):\n        return default\n\n\ndef body_preview(body: str, length: int = 200) -> str:\n    s = (body or \"\").strip()\n    return s[:length] + (\"\u2026\" if len(s) > length else \"\")"},{"checksum":"sha256:0fe8d935013e434d8f7eb70d96aa11c292f07f4ba4655089cc92f94c95c463a9","chunk_id":"chunk_ab87bf8932fbe469","end_line":236,"path":"build_context/social/templates/modules/user_posts/backend/service.py","start_line":1,"symbol_ids":["sym_dfedcc9c7ee43856","sym_524bacd215d8926c","sym_8aaa39a7ad2ed44b","sym_19c728248349c60e","sym_df02aaca6ead5c44","sym_663224d627a45a75","sym_2ba0e4569094d163","sym_bce8d5c0e38a4ce4","sym_7ce2727a261c18a8","sym_26d8d26fef762e0e","sym_6005939599674067","sym_9d3560b39b90b9d6"],"text":"\"\"\"Business logic for the user_posts module.\"\"\"\nfrom __future__ import annotations\n\nfrom uuid import uuid4\n\nfrom .policy import actor_id, app_scope, can_delete_comment, can_delete_post, published_posts_query\nfrom .repo import CommentRepo, PostRepo, ReactionRepo\nfrom .schemas import (\n    DEFAULT_REACTION,\n    MAX_COMMENT_BODY_LENGTH,\n    MAX_POST_BODY_LENGTH,\n    POST_STATUS_DELETED,\n    POST_STATUS_PUBLISHED,\n    REACTION_TYPES,\n    VISIBILITY_PUBLIC,\n    body_preview,\n    coerce_limit,\n    timestamp_now,\n)\n\n\nclass UserPostsService:\n    def __init__(self) -> None:\n        self._posts = PostRepo()\n        self._reactions = ReactionRepo()\n        self._comments = CommentRepo()\n\n    # \u2500\u2500 Posts \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n    async def create_post(self, ctx, *, body: str, media_urls: list | None = None, visibility: str | None = None) -> dict:\n        body = (body or \"\").strip()\n        if not body:\n            return {\"success\": False, \"error\": \"Post body cannot be empty.\"}\n        if len(body) > MAX_POST_BODY_LENGTH:\n            return {\n                \"success\": False,\n                \"error\": f\"Post body cannot exceed {MAX_POST_BODY_LENGTH} characters.\",\n            }\n\n        user_id = actor_id(ctx)\n        now = timestamp_now()\n        preview = body_preview(body)\n        doc = {\n            \"post_id\": f\"pst_{uuid4().hex}\",\n            \"author_id\": user_id,\n            \"body\": body,\n            \"body_preview\": preview,\n            \"media_urls\": list(media_urls or []),\n            \"visibility\": visibility or VISIBILITY_PUBLIC,\n            \"status\": POST_STATUS_PUBLISHED,\n            \"reaction_count\": 0,\n            \"comment_count\": 0,\n            \"created_at\": now,\n            \"updated_at\": now,\n            **app_scope(ctx),\n        }\n        await self._posts.create(ctx, doc)\n\n        await ctx.emit(\"domain.social.post.published\", {\n            \"post_id\": doc[\"post_id\"],\n            \"author_id\": user_id,\n            \"body_preview\": preview,\n            \"visibility\": doc[\"visibility\"],\n            \"created_at\": now,\n        })\n\n        return {\"success\": True, \"post\": {k: v for k, v in doc.items() if k != \"app_id\"}}\n\n    async def get_post(self, ctx, *, post_id: str) -> dict:\n        post = await self._posts.get(ctx, post_id=post_id)\n        if not post or post.get(\"status\") == POST_STATUS_DELETED:\n            return {\"post\": None}\n        return {\"post\": post}\n\n    async def delete_post(self, ctx, *, post_id: str) -> dict:\n        user_id = actor_id(ctx)\n        roles = list(getattr(ctx, \"roles\", None) or [])\n        post = await self._posts.get(ctx, post_id=post_id)\n\n        if not post:\n            return {\"success\": False, \"error\": \"Post not found.\"}\n        if not can_delete_post(post, user_id, roles):\n            return {\"success\": False, \"error\": \"You do not have permission to delete this post.\"}\n\n        now = timestamp_now()\n        await self._posts.soft_delete(ctx, post_id=post_id, deleted_at=now)\n\n        await ctx.emit(\"domain.social.post.deleted\", {\n            \"post_id\": post_id,\n            \"author_id\": post.get(\"author_id\", \"\"),\n            \"deleted_by\": user_id,\n            \"deleted_at\": now,\n        })\n\n        return {\"success\": True}\n\n    async def list_posts(\n        self, ctx, *, author_id: str | None = None, visibility: str | None = None,\n        limit: int | None = None, before: str | None = None\n    ) -> dict:\n        bounded = coerce_limit(limit)\n        rows = await self._posts.list(\n            ctx,\n            query=published_posts_query(ctx, author_id=author_id, visibility=visibility),\n            limit=bounded + 1,\n            before=before,\n        )\n        has_more = len(rows) > bounded\n        page = rows[:bounded]\n        return {\n            \"posts\": page,\n            \"count\": len(page),\n            \"next_cursor\": page[-1][\"created_at\"] if has_more and page else None,\n        }\n\n    async def list_user_posts(self, ctx, *, user_id: str | None = None, limit: int | None = None, before: str | None = None) -> dict:\n        target = user_id or actor_id(ctx)\n        return await self.list_posts(ctx, author_id=target, limit=limit, before=before)\n\n    # \u2500\u2500 Reactions \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n    async def react_to_post(self, ctx, *, post_id: str, reaction_type: str | None = None) -> dict:\n        user_id = actor_id(ctx)\n        rtype = reaction_type if reaction_type in REACTION_TYPES else DEFAULT_REACTION\n\n        post = await self._posts.get(ctx, post_id=post_id)\n        if not post or post.get(\"status\") == POST_STATUS_DELETED:\n            return {\"success\": False, \"error\": \"Post not found.\", \"action\": \"none\", \"reaction_count\": 0}\n\n        existing = await self._reactions.get(ctx, post_id=post_id, user_id=user_id)\n        now = timestamp_now()\n\n        if existing and existing.get(\"reaction_type\") == rtype:\n            # Toggle off\n            await self._reactions.delete(ctx, post_id=post_id, user_id=user_id)\n            action = \"removed\"\n        else:\n            await self._reactions.upsert(ctx, {\n                \"post_id\": post_id,\n                \"user_id\": user_id,\n                \"reaction_type\": rtype,\n                \"created_at\": now,\n                **app_scope(ctx),\n            })\n            action = \"added\"\n\n        new_count = await self._reactions.count_by_post(ctx, post_id=post_id)\n        await self._posts.set_reaction_count(ctx, post_id=post_id, count=new_count)\n\n        await ctx.emit(\"domain.social.post.reacted\", {\n            \"post_id\": post_id,\n            \"post_author_id\": post.get(\"author_id\", \"\"),\n            \"user_id\": user_id,\n            \"reaction_type\": rtype,\n            \"action\": action,\n            \"reacted_at\": now,\n        })\n\n        return {\"success\": True, \"action\": action, \"reaction_count\": new_count}\n\n    async def get_reaction_summary(self, ctx, *, post_id: str) -> dict:\n        user_id = actor_id(ctx)\n        by_type = await self._reactions.count_by_type(ctx, post_id=post_id)\n        total = sum(by_type.values())\n        viewer = await self._reactions.get(ctx, post_id=post_id, user_id=user_id)\n        return {\n            \"total\": total,\n            \"by_type\": by_type,\n            \"viewer_reaction\": viewer.get(\"reaction_type\") if viewer else None,\n        }\n\n    # \u2500\u2500 Comments \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n    async def add_comment(self, ctx, *, post_id: str, body: str) -> dict:\n        body = (body or \"\").strip()\n        if not body:\n            return {\"success\": False, \"error\": \"Comment body cannot be empty.\", \"comment\": None}\n        if len(body) > MAX_COMMENT_BODY_LENGTH:\n            return {\n                \"success\": False,\n                \"error\": f\"Comment body cannot exceed {MAX_COMMENT_BODY_LENGTH} characters.\",\n                \"comment\": None,\n            }\n\n        post = await self._posts.get(ctx, post_id=post_id)\n        if not post or post.get(\"status\") == POST_STATUS_DELETED:\n            return {\"success\": False, \"error\": \"Post not found.\", \"comment\": None}\n\n        user_id = actor_id(ctx)\n        now = timestamp_now()\n        doc = {\n            \"comment_id\": f\"cmt_{uuid4().hex}\",\n            \"post_id\": post_id,\n            \"author_id\": user_id,\n            \"body\": body,\n            \"created_at\": now,\n            **app_scope(ctx),\n        }\n        await self._comments.create(ctx, doc)\n        await self._posts.increment_comment_count(ctx, post_id=post_id)\n\n        await ctx.emit(\"domain.social.post.commented\", {\n            \"post_id\": post_id,\n            \"post_author_id\": post.get(\"author_id\", \"\"),\n            \"comment_id\": doc[\"comment_id\"],\n            \"author_id\": user_id,\n            \"body_preview\": body_preview(body, 100),\n            \"created_at\": now,\n        })\n\n        return {\"success\": True, \"comment\": {k: v for k, v in doc.items() if k != \"app_id\"}}\n\n    async def delete_comment(self, ctx, *, comment_id: str) -> dict:\n        user_id = actor_id(ctx)\n        roles = list(getattr(ctx, \"roles\", None) or [])\n        comment = await self._comments.get(ctx, comment_id=comment_id)\n\n        if not comment:\n            return {\"success\": False, \"error\": \"Comment not found.\"}\n        if not can_delete_comment(comment, user_id, roles):\n            return {\"success\": False, \"error\": \"You do not have permission to delete this comment.\"}\n\n        now = timestamp_now()\n        await self._comments.delete(ctx, comment_id=comment_id)\n        await self._posts.increment_comment_count(ctx, post_id=comment[\"post_id\"], delta=-1)\n\n        await ctx.emit(\"domain.social.post.comment_deleted\", {\n            \"post_id\": comment[\"post_id\"],\n            \"comment_id\": comment_id,\n            \"deleted_by\": user_id,\n            \"deleted_at\": now,\n        })\n\n        return {\"success\": True}\n\n    async def list_comments(self, ctx, *, post_id: str, limit: int | None = None, after: str | None = None) -> dict:"},{"checksum":"sha256:326045cd57d253e1fc2afb2d24b99ff932ee26416df05b1b7ae9efcc3e184ad3","chunk_id":"chunk_9f7c022a608dce1d","end_line":245,"path":"build_context/social/templates/modules/user_posts/backend/service.py","start_line":237,"symbol_ids":["sym_dfedcc9c7ee43856","sym_9d3560b39b90b9d6"],"text":"        bounded = coerce_limit(limit, default=50)\n        rows = await self._comments.list(ctx, post_id=post_id, limit=bounded + 1, after=after)\n        has_more = len(rows) > bounded\n        page = rows[:bounded]\n        return {\n            \"comments\": page,\n            \"count\": len(page),\n            \"next_cursor\": page[-1][\"created_at\"] if has_more and page else None,\n        }"},{"checksum":"sha256:834f11fab67ba0eb1b4dcd331766aa3ab99187ec841b5b86840d536efac12739","chunk_id":"chunk_d3139fb4dfff8998","end_line":71,"path":"build_context/social/templates/modules/user_posts/contracts/events.yaml","start_line":1,"symbol_ids":[],"text":"schema_version: mozaiks.events.v1\nevents:\n  - type: domain.social.post.published\n    version: 1\n    producer: user_posts\n    description: A user published a new post.\n    payload_schema:\n      type: object\n      required: [post_id, author_id]\n      properties:\n        post_id:      { type: string }\n        author_id:    { type: string }\n        body_preview: { type: string }\n        visibility:   { type: string }\n        created_at:   { type: string }\n\n  - type: domain.social.post.deleted\n    version: 1\n    producer: user_posts\n    description: A post was soft-deleted.\n    payload_schema:\n      type: object\n      required: [post_id, author_id]\n      properties:\n        post_id:    { type: string }\n        author_id:  { type: string }\n        deleted_by: { type: string }\n        deleted_at: { type: string }\n\n  - type: domain.social.post.reacted\n    version: 1\n    producer: user_posts\n    description: A user added or removed a reaction on a post.\n    payload_schema:\n      type: object\n      required: [post_id, post_author_id, user_id, reaction_type, action]\n      properties:\n        post_id:        { type: string }\n        post_author_id: { type: string }\n        user_id:        { type: string }\n        reaction_type:  { type: string }\n        action:         { type: string }\n        reacted_at:     { type: string }\n\n  - type: domain.social.post.commented\n    version: 1\n    producer: user_posts\n    description: A user added a comment to a post.\n    payload_schema:\n      type: object\n      required: [post_id, post_author_id, comment_id, author_id]\n      properties:\n        post_id:        { type: string }\n        post_author_id: { type: string }\n        comment_id:     { type: string }\n        author_id:      { type: string }\n        body_preview:   { type: string }\n        created_at:     { type: string }\n\n  - type: domain.social.post.comment_deleted\n    version: 1\n    producer: user_posts\n    description: A comment was deleted.\n    payload_schema:\n      type: object\n      required: [post_id, comment_id, deleted_by]\n      properties:\n        post_id:    { type: string }\n        comment_id: { type: string }\n        deleted_by: { type: string }\n        deleted_at: { type: string }"},{"checksum":"sha256:cbff8962370bbaa336933c8d66ac9b7e9dd8bb9df739e19334e2c4aef213fb23","chunk_id":"chunk_de66adee4c9078e4","end_line":35,"path":"build_context/social/templates/modules/user_posts/contracts/notifications.yaml","start_line":1,"symbol_ids":[],"text":"schema_version: mozaiks.notifications.v1\nnotifications:\n  - id: post_reaction_received\n    description: Notify a post author when someone reacts to their post.\n    \"on\": domain.social.post.reacted\n    condition:\n      field: action\n      equals: added\n    template:\n      title: \"Someone reacted to your post\"\n      body: \"Your post received a new reaction.\"\n    channels:\n      - in_app\n    audience:\n      user_id_field: post_author_id\n    context_fields:\n      - post_id\n      - reaction_type\n      - user_id\n\n  - id: post_comment_received\n    description: Notify a post author when someone comments on their post.\n    \"on\": domain.social.post.commented\n    template:\n      title: \"Someone commented on your post\"\n      body: \"{{body_preview}}\"\n    channels:\n      - in_app\n    audience:\n      user_id_field: post_author_id\n    context_fields:\n      - post_id\n      - comment_id\n      - author_id\n      - body_preview"},{"checksum":"sha256:0c3ad737630740fcec5bbf61ebd6a06c7157407dcd6d4451ac2cff1e9436aefe","chunk_id":"chunk_da462c4714ba76fa","end_line":7,"path":"build_context/social/templates/modules/user_posts/contracts/profile.yaml","start_line":1,"symbol_ids":[],"text":"schema_version: mozaiks.profile.v1\ntabs:\n  - id: posts\n    label: Posts\n    order: 20\n    action: list_user_posts\n    component: UserPostsTab"},{"checksum":"sha256:e19340a5ac89b212dda24695a1e0e920b35bb3c3e3c85b8dae276719b01741e3","chunk_id":"chunk_f251a6665175fac1","end_line":5,"path":"build_context/social/templates/modules/user_posts/contracts/reactions.yaml","start_line":1,"symbol_ids":[],"text":"schema_version: mozaiks.reactions.v1\nreactions: []\n# user_posts emits domain events; it does not subscribe to other modules.\n# The activity_feed module subscribes to domain.social.post.published and\n# domain.social.post.commented via its own reactions.yaml."},{"checksum":"sha256:92cc18a64e76aef666337664fe4e17c850f5018e8413a0784537b4807ad52934","chunk_id":"chunk_93c4f3c1f4d4a669","end_line":253,"path":"build_context/social/templates/modules/user_posts/module.yaml","start_line":1,"symbol_ids":[],"text":"schema_version: mozaiks.module.v1\nmodule:\n  id: user_posts\n  display_name: Posts\n  version: 1.0.0\n  description: >\n    User-generated posts with reactions (likes) and threaded comments.\n    Posts are soft-deleted to preserve thread integrity. Hard deletion\n    only occurs via the GDPR account_data_handler.\n  user_data_scope: true\n  handler: backend.handler:UserPostsHandler\n\npermissions:\n  - id: user_posts.read\n    description: Read published posts, reactions, and comments.\n  - id: user_posts.create\n    description: Create and delete your own posts and comments.\n  - id: user_posts.react\n    description: Add or remove reactions on posts.\n  - id: user_posts.moderate\n    description: Delete any post or comment (moderation).\n  - id: user_posts.admin\n    description: Administer all post records.\n\nactions:\n  - id: create_post\n    api_surface: public\n    description: Create a new post visible to the user's network.\n    handler_method: create_post\n    input_schema:\n      type: object\n      additionalProperties: false\n      required: [body]\n      properties:\n        # body \u2014 at most 5000 characters, enforced by the service.\n        body: { type: string }\n        media_urls: { type: array, items: { type: string } }\n        visibility: { type: string, enum: [public, friends, private] }\n    output_schema:\n      type: object\n      required: [success, post]\n      properties:\n        success: { type: boolean }\n        post: { type: object }\n        error: { type: string }\n    permissions: [user_posts.create]\n    emits: [domain.social.post.published]\n\n  - id: get_post\n    api_surface: public_readonly\n    description: Fetch a single post by post_id.\n    handler_method: get_post\n    input_schema:\n      type: object\n      additionalProperties: false\n      required: [post_id]\n      properties:\n        post_id: { type: string }\n    output_schema:\n      type: object\n      required: [post]\n      properties:\n        post: { type: object }\n    permissions: [user_posts.read]\n\n  - id: delete_post\n    api_surface: public\n    description: Soft-delete a post. Only the author or a moderator may delete.\n    handler_method: delete_post\n    input_schema:\n      type: object\n      additionalProperties: false\n      required: [post_id]\n      properties:\n        post_id: { type: string }\n    output_schema:\n      type: object\n      required: [success]\n      properties:\n        success: { type: boolean }\n        error: { type: string }\n    permissions: [user_posts.create]\n    emits: [domain.social.post.deleted]\n\n  - id: list_posts\n    api_surface: public_readonly\n    description: List published posts, optionally filtered by author.\n    handler_method: list_posts\n    input_schema:\n      type: object\n      additionalProperties: false\n      properties:\n        author_id: { type: string }\n        visibility: { type: string }\n        limit: { type: integer }\n        before: { type: string }\n    output_schema:\n      type: object\n      required: [posts, count]\n      properties:\n        posts: { type: array }\n        count: { type: integer }\n        next_cursor: { type: string }\n    permissions: [user_posts.read]\n\n  - id: list_user_posts\n    api_surface: public_readonly\n    description: >\n      List published posts by a specific user. Used to hydrate the Posts tab\n      on /me and /u/:username profile pages.\n    handler_method: list_user_posts\n    input_schema:\n      type: object\n      additionalProperties: false\n      properties:\n        user_id: { type: string }\n        limit: { type: integer }\n        before: { type: string }\n    output_schema:\n      type: object\n      required: [posts, count]\n      properties:\n        posts: { type: array }\n        count: { type: integer }\n        next_cursor: { type: string }\n    permissions: [user_posts.read]\n\n  - id: react_to_post\n    api_surface: public\n    description: >\n      Add or remove a reaction (like) on a post. Idempotent \u2014 reacting\n      again with the same type removes the reaction (toggle).\n    handler_method: react_to_post\n    input_schema:\n      type: object\n      additionalProperties: false\n      required: [post_id]\n      properties:\n        post_id: { type: string }\n        reaction_type: { type: string, enum: [like, love, celebrate, support] }\n    output_schema:\n      type: object\n      required: [success, action]\n      properties:\n        success: { type: boolean }\n        action: { type: string }    # added | removed\n        reaction_count: { type: integer }\n        error: { type: string }\n    permissions: [user_posts.react]\n    emits: [domain.social.post.reacted]\n\n  - id: add_comment\n    api_surface: public\n    description: Add a comment to a post.\n    handler_method: add_comment\n    input_schema:\n      type: object\n      additionalProperties: false\n      required: [post_id, body]\n      properties:\n        post_id: { type: string }\n        # body \u2014 at most 2000 characters, enforced by the service.\n        body: { type: string }\n    output_schema:\n      type: object\n      required: [success, comment]\n      properties:\n        success: { type: boolean }\n        comment: { type: object }\n        error: { type: string }\n    permissions: [user_posts.create]\n    emits: [domain.social.post.commented]\n\n  - id: delete_comment\n    api_surface: public\n    description: Delete a comment. Only the comment author or a moderator may delete.\n    handler_method: delete_comment\n    input_schema:\n      type: object\n      additionalProperties: false\n      required: [comment_id]\n      properties:\n        comment_id: { type: string }\n    output_schema:\n      type: object\n      required: [success]\n      properties:\n        success: { type: boolean }\n        error: { type: string }\n    permissions: [user_posts.create]\n    emits: [domain.social.post.comment_deleted]\n\n  - id: list_comments\n    api_surface: public_readonly\n    description: List comments for a post, oldest-first.\n    handler_method: list_comments\n    input_schema:\n      type: object\n      additionalProperties: false\n      required: [post_id]\n      properties:\n        post_id: { type: string }\n        limit: { type: integer }\n        after: { type: string }\n    output_schema:\n      type: object\n      required: [comments, count]\n      properties:\n        comments: { type: array }\n        count: { type: integer }\n        next_cursor: { type: string }\n    permissions: [user_posts.read]\n\n  - id: get_reaction_summary\n    api_surface: public_readonly\n    description: Return reaction counts and whether the current user has reacted.\n    handler_method: get_reaction_summary\n    input_schema:\n      type: object\n      additionalProperties: false\n      required: [post_id]\n      properties:\n        post_id: { type: string }\n    output_schema:\n      type: object\n      required: [total, by_type, viewer_reaction]\n      properties:\n        total: { type: integer }\n        by_type: { type: object }\n        viewer_reaction: { type: string }\n    permissions: [user_posts.read]\n\ncapabilities:\n  - capability_id: social.posts.create\n    kind: action\n    target: create_post\n    title: Create Post\n    permissions: [user_posts.create]\n  - capability_id: social.posts.list\n    kind: action\n    target: list_posts\n    title: List Posts\n    permissions: [user_posts.read]\n  - capability_id: social.posts.react\n    kind: action\n    target: react_to_post\n    title: React to Post\n    permissions: [user_posts.react]\n  - capability_id: social.posts.comment\n    kind: action\n    target: add_comment\n    title: Comment on Post\n    permissions: [user_posts.create]"},{"checksum":"sha256:4f24f77d57c8d0db8f739cadf88bc55d065d0f10724ef58a8fdbe7757f740237","chunk_id":"chunk_6d01e2f8e94ac1b5","end_line":139,"path":"build_context/social/templates/ui/components/SocialProfileTabs.jsx","start_line":1,"symbol_ids":["sym_c1ddf68e5de32c2d","sym_d79f9ee349bfa4ba","sym_7bb83f184cd45290","sym_02ecb18dd8949d8e","sym_0138533e2759a9cd","sym_f7803245340d0458","sym_68475d73c9b8abaf","sym_0875853ccfce99ca","sym_2db04ddf3260e878"],"text":"import { useMemo } from \"react\";\n\nfunction relativeTime(value) {\n  if (!value) return \"\";\n  const diff = Date.now() - new Date(value).getTime();\n  const minutes = Math.max(0, Math.floor(diff / 60000));\n  if (minutes < 1) return \"just now\";\n  if (minutes < 60) return `${minutes}m ago`;\n  const hours = Math.floor(minutes / 60);\n  if (hours < 24) return `${hours}h ago`;\n  return `${Math.floor(hours / 24)}d ago`;\n}\n\nfunction initials(value) {\n  return String(value || \"?\")\n    .split(/[\\s._-]+/)\n    .filter(Boolean)\n    .slice(0, 2)\n    .map((part) => part[0])\n    .join(\"\")\n    .toUpperCase();\n}\n\nfunction Avatar({ value }) {\n  return (\n    <span style={{\n      alignItems: \"center\",\n      background: \"var(--muted, #f3f4f6)\",\n      borderRadius: \"999px\",\n      display: \"inline-flex\",\n      fontSize: 12,\n      fontWeight: 700,\n      height: 36,\n      justifyContent: \"center\",\n      width: 36,\n    }}>\n      {initials(value)}\n    </span>\n  );\n}\n\nfunction groupByApp(items) {\n  const groups = new Map();\n  for (const item of items) {\n    const key = item.app_id || \"app\";\n    if (!groups.has(key)) groups.set(key, []);\n    groups.get(key).push(item);\n  }\n  return [...groups.entries()];\n}\n\nfunction Section({ title, children }) {\n  return (\n    <section style={{ display: \"grid\", gap: 12 }}>\n      <header style={{ display: \"flex\", gap: 8, alignItems: \"center\" }}>\n        <h3 style={{ fontSize: 13, letterSpacing: 0, margin: 0, textTransform: \"uppercase\" }}>{title}</h3>\n      </header>\n      {children}\n    </section>\n  );\n}\n\nfunction EmptyState({ label }) {\n  return (\n    <div style={{ border: \"1px solid var(--border-color, #d1d5db)\", padding: 12, opacity: 0.75 }}>\n      {label}\n    </div>\n  );\n}\n\nexport function FriendListTab({ data }) {\n  const source = Array.isArray(data?.friends) ? data.friends : [];\n\n  return (\n    <Section title=\"Friends\">\n      {source.length === 0 && <EmptyState label=\"No friends yet.\" />}\n      <div style={{ display: \"grid\", gap: 8 }}>\n        {source.map((friend) => (\n          <article key={friend.friendship_id || friend.friend_user_id} style={{ alignItems: \"center\", border: \"1px solid var(--border-color, #d1d5db)\", display: \"flex\", gap: 12, padding: 12 }}>\n            <Avatar value={friend.display_name || friend.friend_user_id} />\n            <div>\n              <strong>{friend.display_name || friend.friend_user_id}</strong>\n              <p style={{ margin: \"4px 0 0\", opacity: 0.7 }}>{friend.friend_user_id}</p>\n            </div>\n            {friend.since && <span style={{ marginLeft: \"auto\", opacity: 0.7 }}>{relativeTime(friend.since)}</span>}\n          </article>\n        ))}\n      </div>\n    </Section>\n  );\n}\n\nexport function ActivityFeedTab({ data }) {\n  const source = Array.isArray(data?.events) ? data.events : [];\n  const groups = useMemo(() => groupByApp(source), [source]);\n\n  return (\n    <Section title=\"Activity\">\n      {source.length === 0 && <EmptyState label=\"No activity yet.\" />}\n      {groups.map(([appId, events]) => (\n        <div key={appId} style={{ display: \"grid\", gap: 8 }}>\n          <strong>{appId}</strong>\n          {events.map((event) => (\n            <article key={event.event_id} style={{ border: \"1px solid var(--border-color, #d1d5db)\", padding: 12 }}>\n              <strong>{event.actor_id}</strong>\n              <p style={{ margin: \"4px 0\" }}>{event.subject_label || event.activity_type}</p>\n              <span style={{ opacity: 0.7 }}>{relativeTime(event.created_at)}</span>\n            </article>\n          ))}\n        </div>\n      ))}\n    </Section>\n  );\n}\n\nexport function UserPostsTab({ data }) {\n  const source = Array.isArray(data?.posts) ? data.posts : [];\n  const groups = useMemo(() => groupByApp(source), [source]);\n\n  return (\n    <Section title=\"Posts\">\n      {source.length === 0 && <EmptyState label=\"No posts yet.\" />}\n      {groups.map(([appId, posts]) => (\n        <div key={appId} style={{ display: \"grid\", gap: 8 }}>\n          <strong>{appId}</strong>\n          {posts.map((post) => (\n            <article key={post.post_id} style={{ border: \"1px solid var(--border-color, #d1d5db)\", padding: 12 }}>\n              <strong>{post.author_id}</strong>\n              <p>{post.body || post.body_preview}</p>\n              <span style={{ opacity: 0.7 }}>\n                {post.reaction_count || 0} reactions, {post.comment_count || 0} comments\n              </span>\n            </article>\n          ))}\n        </div>\n      ))}\n    </Section>\n  );\n}"},{"checksum":"sha256:d8b47d35f1f48b2e52dfbd1b1617b161ed052c525042e5eab6b676fb0b8b6a69","chunk_id":"chunk_986a8b78676d40df","end_line":8,"path":"build_context/social/templates/ui/index.js","start_line":1,"symbol_ids":["sym_897bf4bcb7f3fd52"],"text":"import { ActivityFeedTab, FriendListTab, UserPostsTab } from \"./components/SocialProfileTabs.jsx\";\n\nexport function register(registerComponent) {\n  if (typeof registerComponent !== \"function\") return;\n  registerComponent(\"FriendListTab\", FriendListTab);\n  registerComponent(\"ActivityFeedTab\", ActivityFeedTab);\n  registerComponent(\"UserPostsTab\", UserPostsTab);\n}"},{"checksum":"sha256:cd940495d35e6670d1e184e75edb2a8bf8a794e104f04e7519d379758e436197","chunk_id":"chunk_4111834f175a3548","end_line":24,"path":"build_context/support/context.yaml","start_line":1,"symbol_ids":[],"text":"context_id: support\napplies_to_workflows:\n  - AppGenerator\nassets:\n  - path: contract.yaml\n    kind: contract\n  - path: templates/\n    kind: templates\npack:\n  id: support\n  version: \"0.1.12\"\n  status: active\n  capability_source: generated_module\ncapabilities:\n  - capability_id: support.requests.create\n    facade_recommended: support\n  - capability_id: support.requests.list\n    facade_recommended: support\n  - capability_id: support.requests.update_status\n    facade_recommended: support\nprojections:\n  context_variables:\n    capability_packs:\n      from: capability_packs"},{"checksum":"sha256:c1b62f32cd6d2d7004167242ca089dfad89fc852c6eaddb4e7ead596d824f63a","chunk_id":"chunk_7a1ec7208a528220","end_line":114,"path":"build_context/support/contract.yaml","start_line":1,"symbol_ids":[],"text":"contract_id: support\ncontract_type: build_pack_instructions\n\nselection_rules:\n  - id: select_for_helpdesk_apps\n    when:\n      intent_any:\n        - support desk\n        - help desk\n        - helpdesk\n        - customer support\n        - support tickets\n        - operator replies\n        - user support\n    action: select_pack\n  - id: do_not_select_for_social_chat_only\n    when:\n      intent_any:\n        - friends\n        - direct messages\n        - group chat\n    action: require_explicit_user_confirmation\n\nrecommended_domains:\n  - support\n  - helpdesk\n  - customer operations\n  - app operations\n\n# Machine-readable dependency declaration: messaging pack must also be selected.\nrequires:\n  packs:\n    - pack_id: messaging\n      reason: \"support stores message_thread_id and delegates conversations to messages module\"\n\nrequired_outputs:\n  - path: data/migrations/001_support_collections.json\n    owner: templates\n  - path: modules/support/module.yaml\n    owner: templates\n  - path: modules/support/backend/__init__.py\n    owner: templates\n  - path: modules/support/backend/account_data_handler.py\n    owner: templates\n  - path: modules/support/backend/base_handler.py\n    owner: templates\n  - path: modules/support/backend/handler.py\n    owner: workspace  # preserved across regeneration; subclasses base_handler.py\n  - path: modules/support/backend/service.py\n    owner: templates\n  - path: modules/support/backend/repo.py\n    owner: templates\n  - path: modules/support/backend/policy.py\n    owner: templates\n  - path: modules/support/backend/schemas.py\n    owner: templates\n  - path: modules/support/contracts/events.yaml\n    owner: templates\n  - path: modules/support/contracts/reactions.yaml\n    owner: templates\n  - path: modules/support/contracts/notifications.yaml\n    owner: templates\n  - path: ui/pages/custom/Support.jsx\n    owner: templates\n  - path: ui/route_manifest.json\n    owner: templates\n\nforbidden_outputs:\n  - path_prefix: modules/helpdesk/\n  - path_prefix: modules/support_messages/\n  - path_prefix: modules/support_chat/\n  - path_prefix: services/support/\n\nruntime_boundaries:\n  - id: ticket_metadata_only\n    rule: >\n      The support module owns request metadata, status, severity, page context,\n      assignee, and message_thread_id. It must not store message transcripts.\n  - id: use_messages_for_conversations\n    rule: >\n      The support service creates a messages support thread and first message\n      during create_support_request, then stores its thread id on the ticket.\n      The support UI reads and replies through ticket-authorized support actions.\n      It must not create or link threads or call generic messages actions.\n  - id: app_scoped_support\n    rule: >\n      Support requests must include subject_app_id. In generated apps this is\n      normally ctx.app_id. In Studio/hosted product views, this is the app the\n      ticket is about and must not be confused with persistence scope.\n  - id: no_dummy_messages\n    rule: >\n      Support pages may render empty states and fixture social/friend examples\n      in demo mode, but support messages must come from persisted message\n      threads. Do not hardcode support transcripts.\n  - id: notification_contract\n    rule: >\n      Support modules must declare contracts/notifications.yaml for user-facing\n      support events. Do not create a separate notifications module or local\n      notification persistence worker.\n  - id: persistence_layer\n    rule: Generated repo.py must use ctx.persistence.collection(\"support\", entity_name). No direct Motor clients and no app_data_from_context aliases.\n\nfacades: []\n\ncross_pack_integrations:\n  - pack_id: messaging\n    description: >\n      Required. Support stores message_thread_id and delegates all conversation\n      persistence to the messages service. Public support conversation access is\n      mediated by ticket-authorized support actions.\n  - pack_id: social\n    description: >\n      Optional. Social apps can show support entry points on profiles or feeds,\n      but friends, follows, DMs, and invites remain owned by social/messaging."},{"checksum":"sha256:1e2828badc7c3b900290b3b02a430ff9c595452f88f501631741abbcc49913df","chunk_id":"chunk_e67902ae98623153","end_line":41,"path":"build_context/support/templates/data/migrations/001_support_collections.json","start_line":1,"symbol_ids":[],"text":"{\n  \"migration_id\": \"support_001_collections\",\n  \"description\": \"Declare support request indexes.\",\n  \"surfaces\": [\n    {\n      \"surface_id\": \"support\",\n      \"collections\": [\n        {\n          \"mongo_collection\": \"support_requests\",\n          \"data_alias\": \"support.requests\",\n          \"indexes\": [\n            {\n              \"name\": \"support_requests_by_id\",\n              \"keys\": [{\"field\": \"request_id\", \"order\": 1}],\n              \"unique\": true\n            },\n            {\n              \"name\": \"support_requests_by_subject_app_status_updated\",\n              \"keys\": [\n                {\"field\": \"subject_app_id\", \"order\": 1},\n                {\"field\": \"status\", \"order\": 1},\n                {\"field\": \"updated_at\", \"order\": -1}\n              ]\n            },\n            {\n              \"name\": \"support_requests_by_requester_updated\",\n              \"keys\": [\n                {\"field\": \"requester_id\", \"order\": 1},\n                {\"field\": \"updated_at\", \"order\": -1}\n              ]\n            },\n            {\n              \"name\": \"support_requests_by_message_thread\",\n              \"keys\": [{\"field\": \"message_thread_id\", \"order\": 1}]\n            }\n          ]\n        }\n      ]\n    }\n  ]\n}"},{"checksum":"sha256:c4c081da1aa4e0539668efe36ed79b31b34467accb5d04cec46422aa3f6c5ada","chunk_id":"chunk_8122fa142ebd02bc","end_line":1,"path":"build_context/support/templates/modules/support/backend/__init__.py","start_line":1,"symbol_ids":[],"text":"\"\"\"Support module backend.\"\"\""},{"checksum":"sha256:d2bc958cbadb6aa984aa3756f91d6bd35679a257787c799227d80c8c20666628","chunk_id":"chunk_240cbe2ef3b3828f","end_line":35,"path":"build_context/support/templates/modules/support/backend/account_data_handler.py","start_line":1,"symbol_ids":["sym_b24902952635c7ad","sym_ba85d693f4542958","sym_6e33f3fdb1c5db1a","sym_2193626753837c0a"],"text":"from __future__ import annotations\n\nfrom typing import Any\n\n\nclass AccountDataHandler:\n    \"\"\"GDPR data handler for support module records.\n\n    Support requests carry requester_id (the user who submitted the request)\n    and subject_app_id (the app context). Both are user-linked PII.\n\n    Note: support requests may also be linked to a messages thread\n    (message_thread_id). The messages module owns thread content; deleting\n    the support record here removes the metadata but the messages module's\n    account_data_handler handles the conversation bodies.\n    \"\"\"\n\n    def __init__(self, db: Any) -> None:\n        self._db = db\n\n    async def delete_user_data(self, *, app_id: str, user_id: str) -> dict[str, Any]:\n        \"\"\"Delete all support request records submitted by this user.\"\"\"\n        coll = self._db.get_collection(\"support\", \"requests\")\n        result = await coll.delete_many({\"app_id\": app_id, \"requester_id\": user_id})\n        deleted = int(getattr(result, \"deleted_count\", 0) or 0)\n        return {\"module\": \"support\", \"requests_deleted\": deleted}\n\n    async def export_user_data(self, *, app_id: str, user_id: str) -> dict[str, Any]:\n        \"\"\"Export all support request records submitted by this user.\"\"\"\n        coll = self._db.get_collection(\"support\", \"requests\")\n        requests = await coll.find_many({\"app_id\": app_id, \"requester_id\": user_id})\n        return {\n            \"module\": \"support\",\n            \"requests\": [dict(r) for r in (requests or [])],\n        }"},{"checksum":"sha256:d621f1b27252a365b3ce2cad6639c758049979cf88d44fa8e5fa6eb2b75a9c3c","chunk_id":"chunk_ece10e500c396772","end_line":90,"path":"build_context/support/templates/modules/support/backend/base_handler.py","start_line":1,"symbol_ids":["sym_fdb2ddbbe0f97ea6","sym_77c75dd6443287f5","sym_4e87e6e16a072223","sym_75f2acf4f034cc32","sym_849b0517c385d405","sym_4f6303f1b947c013","sym_c70f084f2402c265"],"text":"\"\"\"\nOSS-generated base handler for the support module.\nDO NOT EDIT \u2014 regenerated on framework upgrades.\nPut app-specific customizations in handler.py (the workspace subclass).\n\"\"\"\nfrom __future__ import annotations\n\nfrom mozaiksai.core.runtime.composition.module_context import ModuleContext\n\nfrom .service import SupportService\n\n\nclass SupportBaseHandler:\n    def __init__(self, service: SupportService | None = None) -> None:\n        self._service = service or SupportService()\n\n    async def create_support_request(\n        self,\n        ctx: ModuleContext,\n        *,\n        message: str,\n        subject: str | None = None,\n        page_url: str | None = None,\n        page_title: str | None = None,\n        severity: str = \"low\",\n        app_id: str | None = None,\n        **_: object,\n    ) -> dict:\n        return await self._service.create_support_request(\n            ctx,\n            message=message,\n            subject=subject,\n            page_url=page_url,\n            page_title=page_title,\n            severity=severity,\n            app_id=app_id,\n        )\n\n    async def get_support_conversation(\n        self,\n        ctx: ModuleContext,\n        *,\n        request_id: str,\n        **_: object,\n    ) -> dict:\n        return await self._service.get_support_conversation(ctx, request_id=request_id)\n\n    async def reply_support_request(\n        self,\n        ctx: ModuleContext,\n        *,\n        request_id: str,\n        body: str,\n        **_: object,\n    ) -> dict:\n        return await self._service.reply_support_request(ctx, request_id=request_id, body=body)\n\n    async def list_support_requests(\n        self,\n        ctx: ModuleContext,\n        *,\n        status: str = \"open\",\n        scope: str = \"user\",\n        app_id: str | None = None,\n        limit: int = 50,\n        **_: object,\n    ) -> dict:\n        return await self._service.list_support_requests(\n            ctx,\n            status=status,\n            scope=scope,\n            app_id=app_id,\n            limit=limit,\n        )\n\n    async def update_support_status(\n        self,\n        ctx: ModuleContext,\n        *,\n        request_id: str,\n        status: str,\n        assignee_id: str | None = None,\n        **_: object,\n    ) -> dict:\n        return await self._service.update_support_status(\n            ctx,\n            request_id=request_id,\n            status=status,\n            assignee_id=assignee_id,\n        )"},{"checksum":"sha256:02afcdfa560a5cd3be2f970f3353ccd42cc1b3621c268c187003425e20b2daf3","chunk_id":"chunk_4ebae32c6cee9b9e","end_line":12,"path":"build_context/support/templates/modules/support/backend/handler.py","start_line":1,"symbol_ids":["sym_a8e47f2687f330fd"],"text":"\"\"\"\nWorkspace handler for the support module.\nSubclasses SupportBaseHandler \u2014 add overrides and extra methods here.\nThis file is preserved across regeneration.\n\"\"\"\nfrom __future__ import annotations\n\nfrom .base_handler import SupportBaseHandler\n\n\nclass SupportHandler(SupportBaseHandler):\n    \"\"\"App-local handler \u2014 extend or override base methods below.\"\"\""},{"checksum":"sha256:6eab6edd317e8956ad1a477940ea27fa53acf80ea2b169f0194853403be92291","chunk_id":"chunk_1311fdd6d4b05492","end_line":53,"path":"build_context/support/templates/modules/support/backend/policy.py","start_line":1,"symbol_ids":["sym_b1a4820899799b3c","sym_7414bcd886956ebd","sym_cb003b56df27dee7","sym_8546627896890348","sym_141d95b80d04595e","sym_327da70c041c4ccc","sym_c83b966c070f9cdc","sym_3f7c31b361e14985"],"text":"from __future__ import annotations\n\nfrom typing import Any\n\n\ndef actor_id(ctx) -> str:\n    return str(getattr(ctx, \"user_id\", None) or \"anonymous\").strip() or \"anonymous\"\n\n\ndef subject_app_id(ctx, value: str | None = None) -> str:\n    return str(value or getattr(ctx, \"app_id\", None) or \"default\").strip() or \"default\"\n\n\ndef actor_permissions(ctx) -> list[str] | None:\n    return getattr(ctx, \"permissions\", None)\n\n\ndef has_permission(ctx, permission: str) -> bool:\n    permissions = actor_permissions(ctx)\n    return permissions is None or permission in permissions\n\n\ndef can_read_support(ctx) -> bool:\n    return has_permission(ctx, \"support.read\") or has_permission(ctx, \"support.manage\")\n\n\ndef require_support_read(ctx) -> None:\n    if not can_read_support(ctx):\n        raise PermissionError(\"support queue access requires support.read\")\n\n\ndef require_support_manage(ctx) -> None:\n    if not has_permission(ctx, \"support.manage\"):\n        raise PermissionError(\"support management requires support.manage\")\n\n\ndef support_request_query(\n    ctx,\n    *,\n    scope: str = \"app\",\n    status: str | None = None,\n    app_id: str | None = None,\n) -> dict[str, Any]:\n    query: dict[str, Any] = {}\n    if scope == \"user\":\n        query[\"requester_id\"] = actor_id(ctx)\n    if scope == \"app\":\n        query[\"subject_app_id\"] = subject_app_id(ctx, app_id)\n    elif scope == \"workspace\" and app_id:\n        query[\"subject_app_id\"] = subject_app_id(ctx, app_id)\n    if status and status != \"all\":\n        query[\"status\"] = status\n    return query"},{"checksum":"sha256:99c6fa2f2fd7485ce6328fbd495ec82026c8253a4ba09ff1fa8b66b106f89171","chunk_id":"chunk_ca2a646eee489da5","end_line":45,"path":"build_context/support/templates/modules/support/backend/repo.py","start_line":1,"symbol_ids":["sym_c96e9dffc31b3abc","sym_bfd7cea0c82b441d","sym_b338accadf5bb632","sym_4b513c793848e6af","sym_775307a9fcd099aa","sym_f3bb42732821ba55","sym_eb61a7effbe9cf9d","sym_53abff40abc5319a"],"text":"from __future__ import annotations\n\nfrom collections.abc import Mapping\nfrom typing import Any\n\nDocument = dict[str, Any]\n\n\ndef _collection(ctx, entity_name: str):\n    persistence = getattr(ctx, \"persistence\", None)\n    if persistence is None:\n        raise RuntimeError(\"Persistence is not available for this app context.\")\n    return persistence.collection(\"support\", entity_name)\n\n\ndef _document(value: Any) -> Document | None:\n    return dict(value) if isinstance(value, Mapping) else None\n\n\ndef _documents(values: list[Any] | None) -> list[Document]:\n    return [dict(item) for item in values or [] if isinstance(item, Mapping)]\n\n\nclass SupportRequestRepo:\n    async def insert(self, ctx, *, record: Mapping[str, Any]) -> None:\n        await _collection(ctx, \"requests\").insert_one(dict(record))\n\n    async def get(self, ctx, *, request_id: str) -> Document | None:\n        return _document(await _collection(ctx, \"requests\").find_one({\"request_id\": request_id}))\n\n    async def list(self, ctx, *, query: dict[str, Any], limit: int) -> list[Document]:\n        return _documents(\n            await _collection(ctx, \"requests\").find_many(\n                query,\n                limit=limit,\n                sort=[(\"updated_at\", -1)],\n            )\n        )\n\n    async def update(self, ctx, *, request_id: str, updates: Mapping[str, Any]) -> int:\n        result = await _collection(ctx, \"requests\").update_one(\n            {\"request_id\": request_id},\n            {\"$set\": dict(updates)},\n        )\n        return int(getattr(result, \"matched_count\", 0) or 0)"},{"checksum":"sha256:2c503360eefd5590b2c3df2a32fd5823ba563ae532444c8deeeddc4eab5d2e80","chunk_id":"chunk_69c7eaef450db465","end_line":80,"path":"build_context/support/templates/modules/support/backend/schemas.py","start_line":1,"symbol_ids":["sym_0634e998a2f5489e","sym_f5cac5e0792d60a0","sym_b70ad8655b3dbde7","sym_3edb4f4569054aab","sym_66bc3fe8c72c7696","sym_f282f068a44ee7d3","sym_e42fa008dcd21b6a"],"text":"from __future__ import annotations\n\nfrom datetime import UTC, datetime\nfrom typing import Any, TypedDict\n\nSUPPORT_STATUSES = {\"open\", \"waiting\", \"resolved\", \"archived\"}\nSUPPORT_SEVERITIES = {\"low\", \"medium\", \"high\"}\n\n\nclass SupportRequestRecord(TypedDict, total=False):\n    request_id: str\n    subject_app_id: str\n    requester_id: str | None\n    subject: str\n    page_url: str | None\n    page_title: str | None\n    severity: str\n    status: str\n    assignee_id: str | None\n    message_thread_id: str\n    created_at: str\n    updated_at: str\n    resolved_at: str | None\n\n\ndef timestamp_now() -> str:\n    return datetime.now(UTC).isoformat()\n\n\ndef normalize_string(value: Any) -> str:\n    return str(value or \"\").strip()\n\n\ndef normalize_status(value: Any) -> str:\n    status = normalize_string(value) or \"open\"\n    return status if status in SUPPORT_STATUSES else \"open\"\n\n\ndef normalize_severity(value: Any) -> str:\n    severity = normalize_string(value) or \"low\"\n    return severity if severity in SUPPORT_SEVERITIES else \"low\"\n\n\ndef coerce_limit(value: Any, *, default: int = 50, maximum: int = 100) -> int:\n    try:\n        parsed = int(value)\n    except Exception:\n        parsed = default\n    return max(1, min(parsed, maximum))\n\n\ndef build_support_request_record(\n    *,\n    request_id: str,\n    subject_app_id: str,\n    requester_id: str | None,\n    message: str,\n    subject: str | None = None,\n    page_url: str | None = None,\n    page_title: str | None = None,\n    severity: str = \"low\",\n    message_thread_id: str,\n) -> SupportRequestRecord:\n    now = timestamp_now()\n    clean_message = normalize_string(message)\n    return {\n        \"request_id\": request_id,\n        \"subject_app_id\": normalize_string(subject_app_id),\n        \"requester_id\": normalize_string(requester_id) or None,\n        \"subject\": normalize_string(subject) or (clean_message[:80] if clean_message else \"Support request\"),\n        \"page_url\": normalize_string(page_url) or None,\n        \"page_title\": normalize_string(page_title) or None,\n        \"severity\": normalize_severity(severity),\n        \"status\": \"open\",\n        \"assignee_id\": None,\n        \"message_thread_id\": normalize_string(message_thread_id),\n        \"created_at\": now,\n        \"updated_at\": now,\n        \"resolved_at\": None,\n    }"},{"checksum":"sha256:db2cb59b996c974066fcabe32412fd4627ff36045b6a48f8653eb5cd2672efc7","chunk_id":"chunk_31c334c795dae989","end_line":202,"path":"build_context/support/templates/modules/support/backend/service.py","start_line":1,"symbol_ids":["sym_165052a72e50bf11","sym_8d5957bfa10535e0","sym_37a32f0098332b2e","sym_d76ccb29abecec11","sym_769dc3e5d45dcf0a","sym_77346a2d6f41b250","sym_90493ce9a4985de1","sym_4711fbf5a3df4d24","sym_dd218fe978d550fc"],"text":"from __future__ import annotations\n\nimport inspect\nfrom typing import Any\nfrom uuid import uuid4\n\nfrom modules.messages.backend.schemas import MAX_MESSAGE_LENGTH\nfrom modules.messages.backend.service import MessageService\n\nfrom .policy import (\n    actor_id,\n    can_read_support,\n    require_support_manage,\n    require_support_read,\n    subject_app_id,\n    support_request_query,\n)\nfrom .repo import SupportRequestRepo\nfrom .schemas import (\n    build_support_request_record,\n    coerce_limit,\n    normalize_string,\n    normalize_status,\n    timestamp_now,\n)\n\n\nclass SupportService:\n    def __init__(\n        self,\n        *,\n        requests: SupportRequestRepo | None = None,\n        messages: MessageService | None = None,\n    ) -> None:\n        self.requests = requests or SupportRequestRepo()\n        self.messages = messages or MessageService()\n\n    async def _emit(self, ctx, event_type: str, payload: dict[str, Any]) -> None:\n        emit = getattr(ctx, \"emit\", None)\n        if emit is None:\n            return\n        result = emit(event_type, payload)\n        if inspect.isawaitable(result):\n            await result\n\n    async def create_support_request(\n        self,\n        ctx,\n        *,\n        message: str,\n        subject: str | None = None,\n        page_url: str | None = None,\n        page_title: str | None = None,\n        severity: str = \"low\",\n        app_id: str | None = None,\n    ) -> dict[str, Any]:\n        clean_message = normalize_string(message)\n        if not clean_message:\n            return {\"success\": False, \"error\": \"message is required\"}\n        if len(clean_message) > MAX_MESSAGE_LENGTH:\n            return {\"success\": False, \"error\": f\"message exceeds {MAX_MESSAGE_LENGTH} character limit\"}\n        target_app_id = subject_app_id(ctx, app_id)\n        request_id = f\"sr_{uuid4().hex}\"\n        title = normalize_string(subject) or normalize_string(page_title) or clean_message[:80]\n        thread_result = await self.messages.create_thread(\n            ctx,\n            title=title,\n            participant_ids=[],\n            thread_type=\"support\",\n            scope_type=\"app\",\n            subject_app_id=target_app_id,\n            related_type=\"support.request\",\n            related_id=request_id,\n            metadata=[{\"key\": \"request_id\", \"value\": request_id}],\n        )\n        thread_id = (thread_result.get(\"thread\") or {}).get(\"thread_id\")\n        if not thread_id:\n            return {\"success\": False, \"error\": \"support conversation could not be created\"}\n        sent = await self.messages.send_message(\n            ctx,\n            thread_id=thread_id,\n            body=clean_message,\n            allow_support_thread_sender=True,\n        )\n        if not sent.get(\"success\"):\n            return {\"success\": False, \"error\": sent.get(\"error\") or \"support message could not be sent\"}\n        record = build_support_request_record(\n            request_id=request_id,\n            subject_app_id=target_app_id,\n            requester_id=actor_id(ctx),\n            message=clean_message,\n            subject=subject,\n            page_url=page_url,\n            page_title=page_title,\n            severity=severity,\n            message_thread_id=thread_id,\n        )\n        await self.requests.insert(ctx, record=record)\n        await self._emit(\n            ctx,\n            \"domain.support.request_created\",\n            {\n                \"request_id\": record[\"request_id\"],\n                \"app_id\": target_app_id,\n                \"subject_app_id\": target_app_id,\n                \"requester_id\": record.get(\"requester_id\"),\n                \"severity\": record[\"severity\"],\n                \"message_thread_id\": record.get(\"message_thread_id\"),\n            },\n        )\n        return {\"success\": True, \"request\": dict(record)}\n\n    async def _authorized_request(self, ctx, *, request_id: str, manage: bool = False) -> dict[str, Any] | None:\n        request = await self.requests.get(ctx, request_id=request_id)\n        if not request:\n            return None\n        is_owner = request.get(\"requester_id\") == actor_id(ctx)\n        can_manage = getattr(ctx, \"permissions\", None) is None or \"support.manage\" in ctx.permissions\n        if not is_owner and not (can_manage if manage else can_read_support(ctx)):\n            raise PermissionError(\"support request access denied\")\n        return request\n\n    async def get_support_conversation(self, ctx, *, request_id: str) -> dict[str, Any]:\n        request = await self._authorized_request(ctx, request_id=request_id)\n        if not request:\n            return {\"success\": False, \"error\": \"support request not found\"}\n        result = await self.messages.get_thread(\n            ctx,\n            thread_id=request[\"message_thread_id\"],\n            message_limit=100,\n            allow_nonparticipant_reader=request.get(\"requester_id\") != actor_id(ctx),\n            allow_support_thread_reader=True,\n        )\n        if not result.get(\"thread\"):\n            return {\"success\": False, \"error\": result.get(\"error\") or \"support conversation not found\"}\n        return {\"success\": True, \"thread\": result[\"thread\"], \"messages\": result[\"messages\"]}\n\n    async def reply_support_request(self, ctx, *, request_id: str, body: str) -> dict[str, Any]:\n        request = await self._authorized_request(ctx, request_id=request_id, manage=True)\n        if not request:\n            return {\"success\": False, \"error\": \"support request not found\"}\n        if request.get(\"status\") not in {\"open\", \"waiting\"}:\n            return {\"success\": False, \"error\": \"support request is closed\"}\n        is_operator = request.get(\"requester_id\") != actor_id(ctx)\n        return await self.messages.send_message(\n            ctx,\n            thread_id=request[\"message_thread_id\"],\n            body=body,\n            sender_role=\"operator\" if is_operator else \"user\",\n            allow_nonparticipant_sender=is_operator,\n            allow_support_thread_sender=True,\n        )\n\n    async def list_support_requests(\n        self,\n        ctx,\n        *,\n        status: str = \"open\",\n        scope: str = \"user\",\n        app_id: str | None = None,\n        limit: int = 50,\n    ) -> dict[str, Any]:\n        scope = str(scope or \"user\").strip().lower()\n        if scope not in {\"user\", \"app\", \"workspace\"}:\n            scope = \"user\"\n        if scope != \"user\":\n            require_support_read(ctx)\n        query = support_request_query(ctx, scope=scope, status=status, app_id=app_id)\n        requests = await self.requests.list(ctx, query=query, limit=coerce_limit(limit))\n        return {\"requests\": requests, \"total\": len(requests)}\n\n    async def update_support_status(\n        self,\n        ctx,\n        *,\n        request_id: str,\n        status: str,\n        assignee_id: str | None = None,\n    ) -> dict[str, Any]:\n        require_support_manage(ctx)\n        normalized_status = normalize_status(status)\n        existing = await self.requests.get(ctx, request_id=request_id)\n        updates: dict[str, Any] = {\"status\": normalized_status, \"updated_at\": timestamp_now()}\n        if assignee_id is not None:\n            updates[\"assignee_id\"] = str(assignee_id or \"\").strip() or None\n        if normalized_status == \"resolved\":\n            updates[\"resolved_at\"] = timestamp_now()\n        updated = await self.requests.update(ctx, request_id=request_id, updates=updates)\n        if updated:\n            await self._emit(\n                ctx,\n                \"domain.support.status_changed\",\n                {\n                    \"request_id\": request_id,\n                    \"status\": normalized_status,\n                    \"assignee_id\": assignee_id,\n                    \"app_id\": (existing or {}).get(\"subject_app_id\"),\n                    \"requester_id\": (existing or {}).get(\"requester_id\"),\n                    \"subject_app_id\": (existing or {}).get(\"subject_app_id\"),\n                },\n            )\n        return {\"success\": bool(updated), \"request_id\": request_id, \"status\": normalized_status}"},{"checksum":"sha256:4abb16e1cf005386008ba8621d36c403ed17a2974509685f7323ea71ddcab40a","chunk_id":"chunk_e78a16ee6ba98093","end_line":31,"path":"build_context/support/templates/modules/support/contracts/events.yaml","start_line":1,"symbol_ids":[],"text":"schema_version: mozaiks.events.v1\nevents:\n  - type: domain.support.request_created\n    version: 1\n    description: Emitted when a support request metadata record is created.\n    producer: support\n    payload_schema:\n      type: object\n      required: [request_id, app_id, subject_app_id, requester_id, severity]\n      properties:\n        request_id: { type: string }\n        app_id: { type: string }\n        subject_app_id: { type: string }\n        requester_id: { type: string }\n        severity: { type: string }\n        message_thread_id: { type: string }\n\n  - type: domain.support.status_changed\n    version: 1\n    description: Emitted when a support request status changes.\n    producer: support\n    payload_schema:\n      type: object\n      required: [request_id, app_id, status, requester_id, subject_app_id]\n      properties:\n        request_id: { type: string }\n        app_id: { type: string }\n        status: { type: string }\n        assignee_id: { type: string }\n        requester_id: { type: string }\n        subject_app_id: { type: string }"},{"checksum":"sha256:7dddddb0b00193ef575da018c515b32e7294f4265901c8a27f06776726759f24","chunk_id":"chunk_a7ce6aea8efb92c8","end_line":38,"path":"build_context/support/templates/modules/support/contracts/notifications.yaml","start_line":1,"symbol_ids":[],"text":"schema_version: mozaiks.notifications.v1\n\nnotifications:\n  - id: support.request_created\n    description: Notify support operators when a user submits a support request.\n    event_type: domain.support.request_created\n    channels:\n      - in_app\n    audience:\n      permissions:\n        - support.read\n    template:\n      title: \"New support request\"\n      body: \"{{severity | upper}} support request\"\n    context_fields:\n      - request_id\n      - app_id\n      - subject_app_id\n      - requester_id\n      - severity\n      - message_thread_id\n\n  - id: support.status_changed\n    description: Notify the requester when their support request status changes.\n    event_type: domain.support.status_changed\n    channels:\n      - in_app\n    audience:\n      user_id_field: requester_id\n    template:\n      title: \"Support request updated\"\n      body: \"Status changed to {{status}}\"\n    context_fields:\n      - request_id\n      - app_id\n      - subject_app_id\n      - status\n      - assignee_id"},{"checksum":"sha256:077a6a383a4d09e9d73ebadf612730ee482ffab516fe83d9615537fd26552254","chunk_id":"chunk_cb97cb6deb75669f","end_line":2,"path":"build_context/support/templates/modules/support/contracts/reactions.yaml","start_line":1,"symbol_ids":[],"text":"schema_version: mozaiks.reactions.v1\nreactions: []"},{"checksum":"sha256:ae9dab323861f7271807fa93caf10fd21a30c7405e3f317b2c1507a85dd8ac25","chunk_id":"chunk_a97a250213a1dc64","end_line":155,"path":"build_context/support/templates/modules/support/module.yaml","start_line":1,"symbol_ids":[],"text":"schema_version: mozaiks.module.v1\nmodule:\n  id: support\n  display_name: Support\n  version: 1.0.0\n  description: App support requests and ticket-authorized conversations. Conversation bodies are stored in the messages module.\n  owner: app\n  visibility: private\n  handler: backend.handler:SupportHandler\n  user_data_scope: true\n\npermissions:\n  - id: support.submit\n    description: Submit support requests and view own requests.\n  - id: support.read\n    description: Read all support requests (operator/admin).\n  - id: support.manage\n    description: Manage support queues, reply to requests, and update request status.\n\nactions:\n  - id: create_support_request\n    description: Create a support request with its linked messages thread and first message.\n    handler_method: create_support_request\n    input_schema:\n      type: object\n      additionalProperties: false\n      required: [message]\n      properties:\n        message: { type: string }\n        subject: { type: string }\n        page_url: { type: string }\n        page_title: { type: string }\n        # severity \u2014 optional; the handler defaults omitted values to low.\n        severity:\n          type: string\n          enum: [low, medium, high]\n        # app_id \u2014 the app this ticket is about. Stored as subject_app_id.\n        app_id:\n          type: string\n    output_schema:\n      type: object\n      required: [success]\n      properties:\n        success: { type: boolean }\n        request: { type: object }\n        error: { type: string }\n    permissions: [support.submit]\n    emits: [domain.support.request_created]\n\n  - id: list_support_requests\n    description: List support requests by user, app, or workspace-level index.\n    handler_method: list_support_requests\n    input_schema:\n      type: object\n      additionalProperties: false\n      properties:\n        # status \u2014 optional; the handler defaults omitted values to open.\n        status:\n          type: string\n          enum: [open, waiting, resolved, archived, all]\n        # scope \u2014 optional; the handler defaults omitted values to user.\n        scope:\n          type: string\n          enum: [user, app, workspace]\n        # app_id \u2014 optional subject app id filter.\n        app_id:\n          type: string\n        # limit \u2014 optional; the handler defaults omitted values to 50.\n        limit:\n          type: integer\n    output_schema:\n      type: object\n      required: [requests, total]\n      properties:\n        requests: { type: array }\n        total: { type: integer }\n    permissions: [support.submit]\n\n  - id: get_support_conversation\n    description: Read a ticket conversation as its requester or a support reader.\n    handler_method: get_support_conversation\n    input_schema:\n      type: object\n      additionalProperties: false\n      required: [request_id]\n      properties:\n        request_id: { type: string }\n    output_schema:\n      type: object\n      required: [success]\n      properties:\n        success: { type: boolean }\n        thread: { type: object }\n        messages: { type: array }\n        error: { type: string }\n    permissions: [support.submit]\n\n  - id: reply_support_request\n    description: Reply to an open ticket as its requester or a support manager.\n    handler_method: reply_support_request\n    input_schema:\n      type: object\n      additionalProperties: false\n      required: [request_id, body]\n      properties:\n        request_id: { type: string }\n        body: { type: string }\n    output_schema:\n      type: object\n      required: [success]\n      properties:\n        success: { type: boolean }\n        message: { type: object }\n        error: { type: string }\n    permissions: [support.submit]\n\n  - id: update_support_status\n    description: Update support status or assignee.\n    handler_method: update_support_status\n    input_schema:\n      type: object\n      additionalProperties: false\n      required: [request_id, status]\n      properties:\n        request_id: { type: string }\n        status:\n          type: string\n          enum: [open, waiting, resolved, archived]\n        assignee_id: { type: string }\n    output_schema:\n      type: object\n      required: [success]\n      properties:\n        success: { type: boolean }\n        request_id: { type: string }\n        status: { type: string }\n    permissions: [support.manage]\n    emits: [domain.support.status_changed]\n\ncapabilities:\n  - capability_id: support.requests.create\n    kind: action\n    target: create_support_request\n    title: Create support request\n    permissions: [support.submit]\n  - capability_id: support.requests.list\n    kind: action\n    target: list_support_requests\n    title: List support requests\n    permissions: [support.submit]\n  - capability_id: support.requests.update_status\n    kind: action\n    target: update_support_status\n    title: Update support status\n    permissions: [support.manage]"},{"checksum":"sha256:9179abe471c224e7ecc9529c7128246c0819a9d271ad731719b90d998a5c5cba","chunk_id":"chunk_84b829c589a5c47b","end_line":201,"path":"build_context/support/templates/ui/pages/custom/Support.jsx","start_line":1,"symbol_ids":["sym_dc8d54588a656612","sym_a66047288d9abac1","sym_721ec12ea2108454","sym_2675ea1635788d38","sym_ba381a2fcd738dd3"],"text":"import React, { useCallback, useEffect, useMemo, useState } from 'react'\nimport { moduleAction } from '../../../lib/moduleApi.js'\n\nfunction resolveAppId() {\n  if (typeof window === 'undefined') return 'default'\n  const params = new URLSearchParams(window.location.search)\n  return params.get('app_id') || window.__MOZAIKS_APP_ID__ || 'default'\n}\n\nfunction titleForRequest(request) {\n  return request.subject || request.page_title || String(request.message || 'Support request').slice(0, 80)\n}\n\nexport default function Support() {\n  const appId = useMemo(() => resolveAppId(), [])\n  const [requests, setRequests] = useState([])\n  const [activeRequestId, setActiveRequestId] = useState(null)\n  const [activeThread, setActiveThread] = useState(null)\n  const [messages, setMessages] = useState([])\n  const [draft, setDraft] = useState('')\n  const [newMessage, setNewMessage] = useState('')\n  const [loading, setLoading] = useState(true)\n  const [error, setError] = useState(null)\n\n  const activeRequest = requests.find((request) => request.request_id === activeRequestId) || null\n\n  const loadRequests = useCallback(async () => {\n    setLoading(true)\n    setError(null)\n    try {\n      const result = await moduleAction('support', 'list_support_requests', {\n        status: 'all',\n        scope: 'user',\n        app_id: appId,\n        limit: 50,\n      })\n      const items = Array.isArray(result.requests) ? result.requests : []\n      setRequests(items)\n      if (!activeRequestId && items.length > 0) setActiveRequestId(items[0].request_id)\n    } catch (err) {\n      setError(err.message || 'Support could not be loaded.')\n    } finally {\n      setLoading(false)\n    }\n  }, [activeRequestId, appId])\n\n  const loadThread = useCallback(async (request) => {\n    if (!request?.message_thread_id) {\n      setActiveThread(null)\n      setMessages([])\n      return\n    }\n    try {\n      const result = await moduleAction('support', 'get_support_conversation', {\n        request_id: request.request_id,\n      })\n      if (!result.success) throw new Error(result.error || 'Support conversation could not be loaded.')\n      setActiveThread(result.thread || null)\n      setMessages(Array.isArray(result.messages) ? result.messages : [])\n    } catch (err) {\n      setActiveThread(null)\n      setMessages([])\n      setError(err.message || 'Support conversation could not be loaded.')\n    }\n  }, [appId])\n\n  useEffect(() => {\n    loadRequests()\n  }, [loadRequests])\n\n  useEffect(() => {\n    loadThread(activeRequest)\n  }, [activeRequest, loadThread])\n\n  async function handleCreate(event) {\n    event.preventDefault()\n    const body = draft.trim()\n    if (!body) return\n    try {\n      setError(null)\n      const created = await moduleAction('support', 'create_support_request', {\n        message: body,\n        subject: body.slice(0, 80),\n        severity: 'low',\n        app_id: appId,\n      })\n      if (!created.success || !created.request) {\n        throw new Error(created.error || 'Support request could not be created.')\n      }\n      setDraft('')\n      await loadRequests()\n      setActiveRequestId(created.request.request_id)\n    } catch (err) {\n      setError(err.message || 'Support request could not be created.')\n    }\n  }\n\n  async function handleReply(event) {\n    event.preventDefault()\n    const body = newMessage.trim()\n    if (!body || !activeRequest?.message_thread_id) return\n    try {\n      setError(null)\n      const sent = await moduleAction('support', 'reply_support_request', {\n        request_id: activeRequest.request_id,\n        body,\n      })\n      if (!sent.success) throw new Error(sent.error || 'Support reply could not be sent.')\n      setNewMessage('')\n      await loadThread(activeRequest)\n    } catch (err) {\n      setError(err.message || 'Support reply could not be sent.')\n    }\n  }\n\n  return (\n    <main className=\"mx-auto flex min-h-[calc(100vh-120px)] w-full max-w-6xl flex-col gap-6 px-4 py-8\">\n      <header>\n        <h1 className=\"text-3xl font-semibold tracking-normal text-foreground\">Support</h1>\n        <p className=\"mt-2 text-sm text-muted-foreground\">Create a request and continue the conversation with support.</p>\n      </header>\n\n      <form onSubmit={handleCreate} className=\"rounded-lg border border-border bg-card p-4\">\n        <label className=\"text-sm font-medium text-foreground\" htmlFor=\"support-request\">New request</label>\n        <div className=\"mt-3 flex gap-3\">\n          <textarea\n            id=\"support-request\"\n            value={draft}\n            onChange={(event) => setDraft(event.target.value)}\n            className=\"min-h-20 flex-1 rounded-lg border border-border bg-background px-3 py-2 text-sm text-foreground\"\n            placeholder=\"What do you need help with?\"\n          />\n          <button className=\"h-10 rounded-lg bg-primary px-4 text-sm font-medium text-primary-foreground\" type=\"submit\">\n            Send\n          </button>\n        </div>\n      </form>\n\n      {error && <div className=\"rounded-lg border border-destructive/40 bg-destructive/10 p-3 text-sm text-destructive\">{error}</div>}\n\n      <section className=\"grid min-h-[480px] gap-4 lg:grid-cols-[320px_1fr]\">\n        <aside className=\"rounded-lg border border-border bg-card\">\n          <div className=\"border-b border-border px-4 py-3 text-sm font-medium text-foreground\">Requests</div>\n          {loading ? (\n            <div className=\"p-4 text-sm text-muted-foreground\">Loading...</div>\n          ) : requests.length === 0 ? (\n            <div className=\"p-4 text-sm text-muted-foreground\">No support requests yet.</div>\n          ) : (\n            <div className=\"divide-y divide-border\">\n              {requests.map((request) => (\n                <button\n                  key={request.request_id}\n                  type=\"button\"\n                  onClick={() => setActiveRequestId(request.request_id)}\n                  className={`block w-full px-4 py-3 text-left text-sm ${activeRequestId === request.request_id ? 'bg-primary/10' : 'hover:bg-muted/40'}`}\n                >\n                  <div className=\"font-medium text-foreground\">{titleForRequest(request)}</div>\n                  <div className=\"mt-1 text-xs text-muted-foreground\">{request.status || 'open'} - {request.severity || 'low'}</div>\n                </button>\n              ))}\n            </div>\n          )}\n        </aside>\n\n        <section className=\"flex min-h-0 flex-col rounded-lg border border-border bg-card\">\n          <div className=\"border-b border-border px-4 py-3\">\n            <div className=\"text-sm font-medium text-foreground\">{activeRequest ? titleForRequest(activeRequest) : 'Select a request'}</div>\n            {activeRequest && <div className=\"mt-1 text-xs text-muted-foreground\">{activeRequest.request_id}</div>}\n          </div>\n          <div className=\"flex-1 space-y-3 overflow-auto p-4\">\n            {!activeRequest ? (\n              <p className=\"text-sm text-muted-foreground\">Choose a request to view the conversation.</p>\n            ) : messages.length === 0 ? (\n              <p className=\"text-sm text-muted-foreground\">No messages are linked to this request yet.</p>\n            ) : (\n              messages.map((message) => (\n                <article key={message.message_id} className=\"rounded-lg border border-border bg-background p-3\">\n                  <div className=\"text-xs text-muted-foreground\">{message.sender_role || 'user'}</div>\n                  <p className=\"mt-1 text-sm text-foreground\">{message.body}</p>\n                </article>\n              ))\n            )}\n          </div>\n          {activeThread && (\n            <form onSubmit={handleReply} className=\"flex gap-3 border-t border-border p-4\">\n              <input\n                value={newMessage}\n                onChange={(event) => setNewMessage(event.target.value)}\n                className=\"h-10 flex-1 rounded-lg border border-border bg-background px-3 text-sm text-foreground\"\n                placeholder=\"Reply...\"\n              />\n              <button className=\"rounded-lg bg-primary px-4 text-sm font-medium text-primary-foreground\" type=\"submit\">\n                Reply\n              </button>\n            </form>\n          )}\n        </section>\n      </section>\n    </main>\n  )\n}"},{"checksum":"sha256:f58250043a30c5a85a737fea413df969ea63f6f6c56c02d7495ff97102a50250","chunk_id":"chunk_c5da6e496ec6affc","end_line":21,"path":"build_context/support/templates/ui/route_manifest.json","start_line":1,"symbol_ids":[],"text":"{\n  \"pages\": [\n    {\n      \"id\": \"support\",\n      \"label\": \"Support\",\n      \"path\": \"/support\",\n      \"component\": \"Support\",\n      \"order\": 60,\n      \"navigation\": {\n        \"scope\": \"global\",\n        \"icon\": \"HelpCircle\",\n        \"order\": 60\n      },\n      \"meta\": {\n        \"title\": \"Support\",\n        \"requiresAuth\": true,\n        \"shellMode\": \"workspace\"\n      }\n    }\n  ]\n}"},{"checksum":"sha256:ed9b14219b3dd344c4204a3217c608a56544db91b89ef171f3934f11aa6e1ac3","chunk_id":"chunk_1ed36e95f49bcfdd","end_line":36,"path":"build_context/webapp_builder/context.yaml","start_line":1,"symbol_ids":[],"text":"context_id: webapp_builder\ndescription: Web application build profile.\n\napplies_to_workflows:\n  - AppGenerator\n\nvalues:\n  dev_pack_id: webapp_builder\n  build_task_model: AppBuildTask\n\nassets:\n  - path: templates\n    kind: templates\n    description: >\n      Web app scaffold templates emitted by AuthScaffoldAgent for generated apps.\n      Includes config/auth.yaml (provider-neutral auth contract) and\n      ui/auth/authAdapter.js (facade for the shared @mozaiks/chat-ui/auth adapter).\n      Auth template variable: AUTH_DEFAULT_ROUTE. The backend projects the\n      validated contract and effective auth mode; generated adapters do not\n      implement OIDC or select local demo mode.\n\n  - path: language_profile.yaml\n    kind: catalog\n    projections:\n      - id: webapp_language_profile\n        records: null\n        recipients:\n          - ConfigMiddlewareAgent\n          - ModelAgent\n          - ServiceAgent\n          - FrontendStubAgent\n          - ControllerAgent\n          - DatabaseAgent\n        render: full\n        marker: LANGUAGE_PROFILE_CONTEXT\n        heading: Language and Framework Profile"},{"checksum":"sha256:19ea40cb591fb2f57debff53cdcbaf482c3ae9b52902aeef28c924e78185f7f9","chunk_id":"chunk_1e55ce67077ab45b","end_line":194,"path":"build_context/webapp_builder/language_profile.yaml","start_line":1,"symbol_ids":[],"text":"version: 1\npack_id: webapp_builder\nlabel: Web Application \u2014 Python / FastAPI / MongoDB / React\n\ndescription: >\n  Technology profile for generated web applications. Declares the backend\n  language, frontend framework, database conventions, file path templates,\n  and integration catalog used by AppGenerator execution agents.\n\n  Agents read this profile at prompt time via middleware injection. No agent\n  should hardcode Python file paths, React component patterns, or MongoDB\n  API calls \u2014 they should read them from this injected context.\n\n# ---------------------------------------------------------------------------\n# Backend\n# ---------------------------------------------------------------------------\n\nbackend:\n  language: python\n  framework: fastapi\n  runtime_api: mozaiksai\n\n  module_path_prefix: \"modules/{module_id}/backend/\"\n\n  stub_files:\n    - backend/handler.py\n    - backend/service.py\n    - backend/repo.py\n    - backend/policy.py\n    - backend/schemas.py\n\n  optional_hooks:\n    - backend/settings.py\n    - backend/notifications.py\n    - backend/admin.py\n\n  entrypoint_format: \"{module_id}.backend.handler:{ModuleClass}Handler\"\n  module_class_convention: \"PascalCase(module_id) + 'Handler'\"\n\n  persistence:\n    api: \"ctx.persistence.collection(module_id, entity_name)\"\n    note: >\n      Injected at runtime into ModuleContext as ctx.persistence.\n      Generated repo.py must use this API. Must not use ctx.db or\n      import get_mongo_client().\n\n  event_api: \"await ctx.emit(event_type, payload)\"\n\n  serialization:\n    list_helper_convention: \"_serialize_{entity}_row(doc) -> dict\"\n    note: >\n      list_* service methods must serialize repo documents through an\n      allowlist helper declared in backend/schemas.py. Never pass raw\n      repo documents to callers.\n\n  hard_constraints:\n    - handler.py stays thin dispatch \u2014 no business logic, no persistence.\n    - service.py owns business logic and event emission.\n    - repo.py owns persistence operations only \u2014 no product policy.\n    - policy.py owns tenant/app/user scope query helpers.\n    - schemas.py owns typed DTO/document shapes and pure helpers.\n    - Do not emit backend/models.py or backend/models/*.py.\n    - Do not emit backend/database/schema.json or backend/database/seed.json.\n    - Generated code must not import get_mongo_client() or use ctx.db.\n\n# ---------------------------------------------------------------------------\n# Frontend\n# ---------------------------------------------------------------------------\n\nfrontend:\n  language: javascript\n  framework: react\n  component_extension: jsx\n\n  custom_route:\n    path_template: \"ui/pages/custom/{ComponentName}.jsx\"\n    export_convention: \"export default function {ComponentName}(props)\"\n    api_client_import: \"import { moduleAction } from 'ui/lib/moduleApi';\"\n    api_client_module: \"ui/lib/moduleApi.js\"\n\n  admin_stub:\n    path_template: \"ui/admin/{module_id}.jsx\"\n    barrel_export: \"ui/index.js\"\n\n  hard_constraints:\n    - Custom route JSX must call module actions through moduleAction() from ui/lib/moduleApi.\n    - Do not write raw fetch() calls to /api/modules/** in page components.\n    - Error handling must branch on err.error_code from the caught structured error.\n    - No hardcoded hex/rgb colors \u2014 use semantic token classes.\n    - No direct font-family declarations.\n    - No local primitive clones (StatusPill, MetricTile, StatCard, Badge).\n\n# ---------------------------------------------------------------------------\n# Database\n# ---------------------------------------------------------------------------\n\ndatabase:\n  type: mongodb\n  schema_format: document_model\n\n  collection_api: \"ctx.persistence.collection(module_id, entity_name)\"\n\n  index_format:\n    description: >\n      Declared as an array of key-value pair arrays.\n      Example: [[\"app_id\", 1], [\"record_id\", 1]]\n    unique_field: unique\n    sparse_field: sparse\n    name_field: name\n\n  field_types:\n    - string\n    - boolean\n    - number\n    - object\n    - array\n    - datetime\n    - objectid\n\n  hard_constraints:\n    - Never hardcode database names in generated code.\n    - Collection names derive from module_id and entity_name via ctx.persistence.\n    - Indexes are declared in data/contract.json, not in repo.py directly.\n    - Destructive migrations are not allowed in generated output.\n\n# ---------------------------------------------------------------------------\n# App service structure\n# ---------------------------------------------------------------------------\n\nservices:\n  integration_client_path: \"services/integrations/{service_id}_client.py\"\n  adapter_path: \"services/adapters/{area}/{provider}.py\"\n  auth_adapter_path: \"services/adapters/auth/{provider}.py\"\n  subscription_config_path: \"config/subscriptions.yaml\"\n\n# ---------------------------------------------------------------------------\n# Integration catalog\n# ---------------------------------------------------------------------------\n\nintegration_catalog:\n  description: >\n    Integration service types recognized by this dev pack. AppPlanAgent and\n    IntegrationReadinessAgent use these to classify and aggregate external\n    dependencies discovered during planning and code generation.\n\n  service_types:\n    - id: email_provider\n      label: Email Provider\n      common_providers: [sendgrid, mailgun, postmark, ses, resend]\n    - id: analytics_provider\n      label: Analytics Provider\n      common_providers: [mixpanel, amplitude, segment, posthog]\n    - id: crm_provider\n      label: CRM Provider\n      common_providers: [salesforce, hubspot, pipedrive]\n    - id: storage_provider\n      label: File Storage Provider\n      common_providers: [s3, gcs, azure_blob, cloudflare_r2]\n    - id: model_provider\n      label: AI Model Provider\n      common_providers: [openai, anthropic, google, mistral]\n    - id: payment_processor\n      label: Payment Processor\n      common_providers: [mozaikspay, custom_payment_processor, braintree, adyen, square]\n    - id: sms_provider\n      label: SMS Provider\n      common_providers: [twilio, vonage, aws_sns]\n    - id: push_provider\n      label: Push Notification Provider\n      common_providers: [firebase_fcm, apns, onesignal]\n    - id: search_provider\n      label: Search Provider\n      common_providers: [algolia, typesense, elasticsearch]\n    - id: maps_provider\n      label: Maps / Geocoding Provider\n      common_providers: [google_maps, mapbox, here]\n\n  integration_kinds:\n    - id: payments\n      label: Payment processing and billing\n    - id: email\n      label: Transactional email delivery\n    - id: analytics\n      label: Product analytics and event tracking\n    - id: agent-backend\n      label: AI agent backend integration\n    - id: storage\n      label: File and media storage\n    - id: external-api\n      label: Generic external API integration\n    - id: sms\n      label: SMS and push notifications\n    - id: search\n      label: Full-text and semantic search"},{"checksum":"sha256:c09e0b9f36f266b808e3b9ee991ef2695577f90ee383f0d8700b7e1c0e75d7ad","chunk_id":"chunk_6afcbaabc726be8b","end_line":42,"path":"build_context/webapp_builder/templates/config/auth.yaml","start_line":1,"symbol_ids":[],"text":"schema_version: mozaiks.auth.v1\nauth_required: true\nstrategy: oidc\nmode: brokered_oidc\nsignup_enabled: false\n\nroutes:\n  login: /login\n  callback: /auth/callback\n  logout: /login\n  post_login_default: {{AUTH_DEFAULT_ROUTE}}\n\nfrontend:\n  adapter: oidc_pkce\n  client_id_env: VITE_OIDC_CLIENT_ID\n  authority_env: VITE_OIDC_AUTHORITY\n  discovery_url_env: VITE_OIDC_DISCOVERY_URL\n  redirect_uri_env: VITE_OIDC_REDIRECT_URI\n  scope_env: VITE_OIDC_SCOPE\n  default_scopes:\n    - openid\n    - profile\n    - email\n\nruntime:\n  provider_env: AUTH_PROVIDER\n  enabled_env: AUTH_ENABLED\n  authority_env: MOZAIKS_OIDC_AUTHORITY\n  discovery_url_env: MOZAIKS_OIDC_DISCOVERY_URL\n  issuer_env: AUTH_ISSUER\n  jwks_url_env: AUTH_JWKS_URL\n\nidentity_providers: []\nlogin_methods:\n  - id: broker\n    kind: oidc_redirect\n    label: Sign in\n    primary: true\n\ncustomization:\n  login_theme_source: brand/theme_config.json\n  upstream_provider_setup: host_or_operator"},{"checksum":"sha256:41d3668ee64f02c943541c724dd83b518a36d0673d6ec6ea5d8098032c3cb511","chunk_id":"chunk_619e2a61dd4b7ee9","end_line":5,"path":"build_context/webapp_builder/templates/ui/auth/authAdapter.js","start_line":1,"symbol_ids":["sym_d5ca4514db0aa82f"],"text":"import { createAuthAdapter as createSharedAuthAdapter } from '@mozaiks/chat-ui/auth';\n\nexport function createAuthAdapter(options) {\n  return createSharedAuthAdapter({ ...options, env: import.meta.env });\n}"},{"checksum":"sha256:643cc8c626bc0a3cb1b24967e9913c761176bb87bffe9aa965a199a76a55802f","chunk_id":"chunk_ad83ff396d5d5bbf","end_line":45,"path":"eval/__init__.py","start_line":1,"symbol_ids":[],"text":"\"\"\"Factory generation-time evaluation: bundle scorers, runs, and diffs.\n\nThis package is the supported, experimental Python facade for the reference\nFactory's deterministic bundle evaluation. Operators import this package rather\nthan copying its implementation. Private corpora, tuned scoring policy and\nresults remain operator-owned; this facade supplies the public reference suite.\nIt originated in the hosted product's build_intelligence module (mozaiks-app\nPR #229) and moved here because the Factory's regression suite gates factory\nchanges, which land in this repository.\n\nDeliberate design note (do not \"fix\" this into ag2.eval.run_agent): the\nsubject of these scorers is a directory of artifacts, not an agent trace, so\nthe runner is bespoke. Scorers return a local, AG2-inspired ``Feedback``\ndataclass rather than ``ag2.eval.Feedback``: it deliberately types ``value``\nas ``Any`` so numeric scorers can feed distribution aggregation, diverging\nfrom ag2 1.0.1's categorical ``value: str | None``. The persistence/diff\nshapes mirror AG2's evaluation runs.\n\"\"\"\nfrom .bundle_eval import (\n    BundleRun,\n    RunDiff,\n    diff_runs,\n    discover_bundles,\n    load_run,\n    run_corpus,\n    save_run,\n)\nfrom .bundle_scorers import Bundle, Feedback, all_scorers, score_bundle\nfrom .evidence import GenerationEvidence, collect_generation_evidence\n\n__all__ = [\n    \"Bundle\",\n    \"BundleRun\",\n    \"Feedback\",\n    \"GenerationEvidence\",\n    \"RunDiff\",\n    \"all_scorers\",\n    \"collect_generation_evidence\",\n    \"diff_runs\",\n    \"discover_bundles\",\n    \"load_run\",\n    \"run_corpus\",\n    \"save_run\",\n    \"score_bundle\",\n]"},{"checksum":"sha256:f8e9140eac87999f80926b4121b6ce2075be707c604cce27dbf75c31c9d5b99c","chunk_id":"chunk_080155f6ac5b6165","end_line":234,"path":"eval/bundle_eval.py","start_line":1,"symbol_ids":["sym_475ac23e1853d93c","sym_5732cbc22b9a8ac9","sym_4fe71abe62f2b3c1","sym_d30defce31df9424","sym_2858c5cf32cfe039","sym_347335543186dc7e","sym_b91c61308ebc0c19","sym_3949f3b7ac0d8a1f","sym_69a691e10904b2d0","sym_acebcf2597af53ca","sym_3df7d64094a61502","sym_2385fb469b8d7b11","sym_b11910db9c5e60a1","sym_47bbe41fc755fa29","sym_3d5ab51f4012e3c3","sym_e2ed8d5c7b74fce8"],"text":"\"\"\"Run bundle scorers across a corpus, persist the result, diff against a baseline.\n\nThis is the Factory's regression suite runner. Existing quality gates are\npass/fail per build; this makes a Factory change *measurable*: score a fixed\ncorpus before and after, and block the merge if generated apps got worse. The\nCI gate lives in tests/test_factory_regression_suite.py, which materializes\nthe archetype-matrix corpus offline and diffs against a committed baseline.\n\nPersistence mirrors AG2's evaluation runs \u2014 a versioned JSON file per run, joined\non bundle id and scorer key when diffing \u2014 so results are comparable across days\nand pull requests. The runner is bespoke rather than `ag2.eval.run_agent`\nbecause the subject is a directory of artifacts, not an agent trace.\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nfrom dataclasses import dataclass, field\nfrom pathlib import Path\nfrom typing import Any, cast\n\nfrom .bundle_scorers import score_bundle\n\nSCHEMA_VERSION = \"mozaiks.bundle_eval.v1\"\n\n\n@dataclass\nclass ScorerAggregate:\n    key: str\n    passed: int = 0\n    failed: int = 0\n    errored: int = 0\n    values: list[float] = field(default_factory=list)\n\n    @property\n    def graded(self) -> int:\n        return self.passed + self.failed\n\n    @property\n    def pass_rate(self) -> float | None:\n        return (self.passed / self.graded) if self.graded else None\n\n    @property\n    def mean(self) -> float | None:\n        return (sum(self.values) / len(self.values)) if self.values else None\n\n    def to_dict(self) -> dict[str, Any]:\n        return {\n            \"key\": self.key,\n            \"passed\": self.passed,\n            \"failed\": self.failed,\n            \"errored\": self.errored,\n            \"pass_rate\": self.pass_rate,\n            \"mean\": self.mean,\n            \"samples\": len(self.values),\n        }\n\n\n@dataclass\nclass BundleRun:\n    run_id: str\n    bundles: dict[str, list[dict[str, Any]]] = field(default_factory=dict)\n    aggregates: dict[str, ScorerAggregate] = field(default_factory=dict)\n\n    def to_dict(self) -> dict[str, Any]:\n        return {\n            \"schema_version\": SCHEMA_VERSION,\n            \"run_id\": self.run_id,\n            \"bundle_count\": len(self.bundles),\n            \"aggregates\": {k: a.to_dict() for k, a in sorted(self.aggregates.items())},\n            \"bundles\": self.bundles,\n        }\n\n    def failures(self) -> list[tuple[str, str, str | None]]:\n        \"\"\"(bundle, scorer, comment) for every graded failure.\"\"\"\n        out = []\n        for bundle_id, feedback in sorted(self.bundles.items()):\n            for fb in feedback:\n                if fb.get(\"score\") == 0.0:\n                    out.append((bundle_id, fb[\"key\"], fb.get(\"comment\")))\n        return out\n\n\ndef _feedback_to_dict(fb: Any) -> dict[str, Any]:\n    return {\n        \"key\": fb.key,\n        \"score\": fb.score,\n        \"value\": fb.value,\n        \"comment\": fb.comment,\n        \"detail\": getattr(fb, \"detail\", None) or {},\n    }\n\n\ndef discover_bundles(root: Path) -> list[Path]:\n    \"\"\"Find generated bundles under a corpus root.\n\n    A bundle is any directory containing app.json. Searched two levels deep to\n    match the `generated/<app-name>/<build-uuid>/` layout the Factory writes.\n    \"\"\"\n    root = Path(root)\n    if (root / \"app.json\").is_file():\n        return [root]\n    found = [p.parent for p in sorted(root.glob(\"*/app.json\"))]\n    found += [p.parent for p in sorted(root.glob(\"*/*/app.json\"))]\n    return found\n\n\ndef run_corpus(\n    bundle_paths: list[Path],\n    *,\n    run_id: str,\n    corpus_root: Path | None = None,\n) -> BundleRun:\n    run = BundleRun(run_id=run_id)\n    for path in bundle_paths:\n        # Identify by path relative to the corpus so ids are stable across\n        # machines and cannot collide when two apps share a build name;\n        # diff joins on this.\n        if corpus_root is not None:\n            bundle_id = Path(path).resolve().relative_to(\n                Path(corpus_root).resolve()\n            ).as_posix()\n        else:\n            bundle_id = path.name\n        feedback = score_bundle(path)\n        run.bundles[bundle_id] = [_feedback_to_dict(fb) for fb in feedback]\n\n        for fb in feedback:\n            agg = run.aggregates.setdefault(fb.key, ScorerAggregate(key=fb.key))\n            if fb.score is None and fb.value is None:\n                agg.errored += 1\n            elif fb.score is not None:\n                if fb.score >= 0.5:\n                    agg.passed += 1\n                else:\n                    agg.failed += 1\n            if isinstance(fb.value, (int, float)) and not isinstance(fb.value, bool):\n                agg.values.append(float(fb.value))\n    return run\n\n\ndef save_run(run: BundleRun, store_dir: Path) -> Path:\n    store_dir = Path(store_dir)\n    store_dir.mkdir(parents=True, exist_ok=True)\n    path = store_dir / f\"{run.run_id}.json\"\n    path.write_text(json.dumps(run.to_dict(), indent=2, sort_keys=True), encoding=\"utf-8\")\n    return path\n\n\ndef load_run(path: Path) -> dict[str, Any]:\n    return cast(dict[str, Any], json.loads(Path(path).read_text(encoding=\"utf-8\")))\n\n\n@dataclass\nclass RunDiff:\n    current_run_id: str\n    baseline_run_id: str\n    pass_rate_deltas: dict[str, float] = field(default_factory=dict)\n    mean_deltas: dict[str, float] = field(default_factory=dict)\n    regressions: list[dict[str, str]] = field(default_factory=list)\n    improvements: list[dict[str, str]] = field(default_factory=list)\n    only_in_current: list[str] = field(default_factory=list)\n    only_in_baseline: list[str] = field(default_factory=list)\n\n    def summary(self) -> str:\n        lines = [f\"{self.current_run_id} vs {self.baseline_run_id}\"]\n        if self.regressions:\n            lines.append(f\"  {len(self.regressions)} regression(s):\")\n            for r in self.regressions:\n                lines.append(f\"    - {r['bundle']} / {r['scorer']} pass -> fail\")\n        else:\n            lines.append(\"  no regressions\")\n        if self.improvements:\n            lines.append(f\"  {len(self.improvements)} fixed\")\n        for key, delta in sorted(self.pass_rate_deltas.items()):\n            if delta:\n                lines.append(f\"  pass_rate {key}: {delta:+.3f}\")\n        for key, delta in sorted(self.mean_deltas.items()):\n            if delta:\n                lines.append(f\"  mean {key}: {delta:+.3f}\")\n        return \"\\n\".join(lines)\n\n\ndef diff_runs(current: dict[str, Any], baseline: dict[str, Any]) -> RunDiff:\n    \"\"\"Join two runs on (bundle, scorer) and report what moved.\n\n    Only bundles present in both are compared \u2014 a corpus that grew between runs\n    would otherwise read as mass improvement.\n    \"\"\"\n    out = RunDiff(\n        current_run_id=str(current.get(\"run_id\", \"?\")),\n        baseline_run_id=str(baseline.get(\"run_id\", \"?\")),\n    )\n\n    cur_bundles = current.get(\"bundles\") or {}\n    base_bundles = baseline.get(\"bundles\") or {}\n    out.only_in_current = sorted(set(cur_bundles) - set(base_bundles))\n    out.only_in_baseline = sorted(set(base_bundles) - set(cur_bundles))\n\n    for bundle_id in sorted(set(cur_bundles) & set(base_bundles)):\n        cur = {f[\"key\"]: f for f in cur_bundles[bundle_id]}\n        base = {f[\"key\"]: f for f in base_bundles[bundle_id]}\n        for key in sorted(set(cur) & set(base)):\n            before, after = base[key].get(\"score\"), cur[key].get(\"score\")\n            if before is None:\n                continue\n            if after is None:\n                # A scorer that produced a pass/fail score in the baseline but\n                # returned none now has errored or lost its input. Gate it like\n                # a failure \u2014 otherwise a scorer that starts raising keeps CI\n                # green while its coverage silently disappears.\n                if before >= 0.5:\n                    out.regressions.append(\n                        {\"bundle\": bundle_id, \"scorer\": key,\n                         \"comment\": cur[key].get(\"comment\")\n                         or \"scorer produced no score (errored)\"}\n                    )\n                continue\n            if before >= 0.5 and after < 0.5:\n                out.regressions.append(\n                    {\"bundle\": bundle_id, \"scorer\": key,\n                     \"comment\": cur[key].get(\"comment\") or \"\"}\n                )\n            elif before < 0.5 and after >= 0.5:\n                out.improvements.append({\"bundle\": bundle_id, \"scorer\": key})\n\n    cur_agg = current.get(\"aggregates\") or {}\n    base_agg = baseline.get(\"aggregates\") or {}\n    for key in sorted(set(cur_agg) & set(base_agg)):\n        for field_name, target in ((\"pass_rate\", out.pass_rate_deltas), (\"mean\", out.mean_deltas)):\n            a, b = cur_agg[key].get(field_name), base_agg[key].get(field_name)\n            if a is not None and b is not None:\n                target[key] = round(a - b, 4)\n\n    return out"},{"checksum":"sha256:4950508b2dae0d6006b6a49ea036ec5840f88cb4d7d174c4afaa6f2058d58e17","chunk_id":"chunk_b49a626e6321e553","end_line":259,"path":"eval/bundle_scorers.py","start_line":1,"symbol_ids":["sym_ea4ec8ee64733df4","sym_bf482519d292b41b","sym_be1c6730edf84c09","sym_b65412e01ade51c0","sym_aa8bb9920bb4b5cc","sym_62db438d958136a0","sym_714ee6067007bb84","sym_91c057c900d80e98","sym_1fe8e49fdba8f14b","sym_43d77c88eecc38c4","sym_5f40164b506dd405","sym_be7beba44e8565f1","sym_0b84ddd3a5293092","sym_e287bca0842a86f6","sym_0fec7d617e66f8c4","sym_2ae5939959022c46","sym_0c337711fc3a20d0","sym_bd45f9cdec232537","sym_52dbb4482372fe64","sym_a0f79d0b7af945cd","sym_d4180a07ed1f74cd","sym_723a65b770c8f353","sym_5dc971ba8441f47b"],"text":"\"\"\"Deterministic scorers over a generated app bundle.\n\nGeneration-time evaluation: grade what the Factory produced, before anything is\nhosted. This needs no customers, no traffic and no LLM \u2014 only bundles \u2014 which is\nwhy it is buildable ahead of launch while runtime outcome collection is not.\n\nScorers return a local `Feedback` dataclass inspired by `ag2.eval.Feedback`.\nThe runner here is bespoke because a bundle is a directory of artifacts, not\nan agent trace.\n\nReturn-type convention is AG2-inspired but deliberately diverges from ag2\n1.0.1's contract: a `score` of 1.0/0.0 aggregates as a pass rate, and `value`\nholds a numeric measurement aggregated as a distribution (ag2 types `value`\nas a categorical `str | None`). One question per scorer.\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nfrom collections.abc import Callable\nfrom dataclasses import dataclass, field\nfrom pathlib import Path\nfrom typing import Any\n\nimport yaml\n\n\n@dataclass\nclass Feedback:\n    \"\"\"AG2-inspired feedback record with a numeric-friendly `value`.\n\n    Unlike ag2 1.0.1's `Feedback` (where `value` is a categorical\n    `str | None`), `value` here is `Any` so numeric scorers can feed\n    distribution aggregation.\n    \"\"\"\n\n    key: str\n    score: float | None = None\n    value: Any = None\n    comment: str | None = None\n    detail: dict[str, Any] = field(default_factory=dict)\n\n\nPASS = 1.0\nFAIL = 0.0\n\n\n# \u2500\u2500 bundle reading \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n\nclass Bundle:\n    \"\"\"A generated app bundle on disk, parsed once and shared across scorers.\"\"\"\n\n    def __init__(self, root: Path) -> None:\n        self.root = Path(root)\n        self.errors: list[str] = []\n        self.manifest = self._json(\"app.json\")\n        self.subscriptions = self._yaml(\"config/subscriptions.yaml\")\n        self.modules = self._load_modules()\n        self.ui_pages = self._load_ui_pages()\n\n    @property\n    def name(self) -> str:\n        # Generated app manifests use appName/appId; hosted-intake bundles\n        # historically used name. Accept both dialects.\n        return str(\n            self.manifest.get(\"name\")\n            or self.manifest.get(\"appName\")\n            or self.root.name\n        )\n\n    def _read(self, rel: str) -> str | None:\n        path = self.root / rel\n        if not path.is_file():\n            return None\n        try:\n            return path.read_text(encoding=\"utf-8\")\n        except (OSError, UnicodeDecodeError) as exc:\n            # UnicodeDecodeError: a generated artifact with a stray non-UTF-8\n            # byte must degrade to a scorer failure, not crash the whole run \u2014\n            # Bundle is constructed outside the per-scorer error boundary.\n            self.errors.append(f\"{rel}: {exc}\")\n            return None\n\n    def _json(self, rel: str) -> dict[str, Any]:\n        raw = self._read(rel)\n        if raw is None:\n            return {}\n        try:\n            return json.loads(raw) or {}\n        except json.JSONDecodeError as exc:\n            self.errors.append(f\"{rel}: {exc}\")\n            return {}\n\n    def _yaml(self, rel: str) -> dict[str, Any]:\n        raw = self._read(rel)\n        if raw is None:\n            return {}\n        try:\n            return yaml.safe_load(raw) or {}\n        except yaml.YAMLError as exc:\n            self.errors.append(f\"{rel}: {exc}\")\n            return {}\n\n    def _load_modules(self) -> dict[str, dict[str, Any]]:\n        modules: dict[str, dict[str, Any]] = {}\n        modules_dir = self.root / \"modules\"\n        if not modules_dir.is_dir():\n            return modules\n        for child in sorted(p for p in modules_dir.iterdir() if p.is_dir()):\n            contract = self._yaml(f\"modules/{child.name}/module.yaml\")\n            modules[child.name] = contract\n        return modules\n\n    def _load_ui_pages(self) -> dict[str, dict[str, Any]]:\n        pages: dict[str, dict[str, Any]] = {}\n        pages_dir = self.root / \"ui\" / \"pages\"\n        if not pages_dir.is_dir():\n            return pages\n        for path in sorted(pages_dir.glob(\"*.yaml\")):\n            pages[path.stem] = self._yaml(f\"ui/pages/{path.name}\")\n        return pages\n\n    # \u2500\u2500 derived views \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n    def actions(self) -> list[tuple[str, dict[str, Any]]]:\n        \"\"\"(module_id, action) for every declared action in the bundle.\"\"\"\n        out: list[tuple[str, dict[str, Any]]] = []\n        for module_id, contract in self.modules.items():\n            for action in contract.get(\"actions\") or []:\n                if isinstance(action, dict):\n                    out.append((module_id, action))\n        return out\n\n    def gated_capabilities(self) -> set[str]:\n        return {\n            str(a[\"entitlement_gate\"]).strip()\n            for _, a in self.actions()\n            if str(a.get(\"entitlement_gate\") or \"\").strip()\n        }\n\n    def plan_capabilities(self) -> set[str]:\n        caps: set[str] = set()\n        for plan in self.subscriptions.get(\"plans\") or []:\n            if isinstance(plan, dict):\n                for cap in plan.get(\"capabilities\") or []:\n                    if str(cap).strip():\n                        caps.add(str(cap).strip())\n        return caps\n\n    def ui_endpoints(self) -> list[tuple[str, str]]:\n        \"\"\"(page, api_endpoint) for every section that declares one.\"\"\"\n        found: list[tuple[str, str]] = []\n        for page, doc in self.ui_pages.items():\n            for section in (doc or {}).get(\"sections\") or []:\n                if not isinstance(section, dict):\n                    continue\n                endpoint = ((section.get(\"config\") or {}) or {}).get(\"api_endpoint\")\n                if endpoint:\n                    found.append((page, str(endpoint)))\n        return found\n\n\n# \u2500\u2500 scorers \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nScorer = Callable[[Bundle], Feedback]\n_REGISTRY: list[Scorer] = []\n\n\ndef scorer(fn: Scorer) -> Scorer:\n    _REGISTRY.append(fn)\n    return fn\n\n\ndef all_scorers() -> list[Scorer]:\n    return list(_REGISTRY)\n\n\n@scorer\ndef bundle_parses(bundle: Bundle) -> Feedback:\n    \"\"\"Every artifact in the bundle is readable and well-formed.\"\"\"\n    ok = not bundle.errors\n    return Feedback(\n        key=\"bundle_parses\",\n        score=PASS if ok else FAIL,\n        comment=None if ok else \"; \".join(bundle.errors[:5]),\n    )\n\n\n@scorer\ndef has_app_manifest(bundle: Bundle) -> Feedback:\n    named = bundle.manifest.get(\"name\") or bundle.manifest.get(\"appName\")\n    return Feedback(\n        key=\"has_app_manifest\",\n        score=PASS if named else FAIL,\n    )\n\n\n@scorer\ndef has_subscription_catalog(bundle: Bundle) -> Feedback:\n    \"\"\"A monetised app needs a plan catalog for entitlement to resolve against.\"\"\"\n    return Feedback(\n        key=\"has_subscription_catalog\",\n        score=PASS if bundle.subscriptions.get(\"plans\") else FAIL,\n    )\n\n\n@scorer\ndef every_module_has_contract(bundle: Bundle) -> Feedback:\n    missing = [m for m, c in bundle.modules.items() if not c.get(\"module\")]\n    return Feedback(\n        key=\"every_module_has_contract\",\n        score=FAIL if missing else PASS,\n        comment=f\"missing module.yaml: {', '.join(missing)}\" if missing else None,\n    )\n\n\n@scorer\ndef module_count(bundle: Bundle) -> Feedback:\n    return Feedback(key=\"module_count\", value=float(len(bundle.modules)))\n\n\n@scorer\ndef action_count(bundle: Bundle) -> Feedback:\n    return Feedback(key=\"action_count\", value=float(len(bundle.actions())))\n\n\n@scorer\ndef gated_capabilities_declared(bundle: Bundle) -> Feedback:\n    \"\"\"Every entitlement_gate resolves to a capability some plan grants.\n\n    OSS states this as an invariant: capability_ids used in entitlement_gate\n    MUST appear in subscriptions.yaml under at least one plan. A gate naming a\n    capability no plan grants locks the action for everyone.\n\n    This is the direction the framework actually asserts, which is why it is\n    pass/fail while the inverse is only reported as a count.\n    \"\"\"\n    orphaned = sorted(bundle.gated_capabilities() - bundle.plan_capabilities())\n    return Feedback(\n        key=\"gated_capabilities_declared\",\n        score=FAIL if orphaned else PASS,\n        comment=f\"gated but not in any plan: {', '.join(orphaned)}\" if orphaned else None,\n        detail={\"orphaned\": orphaned},\n    )\n\n\n@scorer\ndef ungated_plan_capabilities(bundle: Bundle) -> Feedback:\n    \"\"\"How many plan capabilities no action gates on. Informational, not pass/fail.\n\n    A capability sold on a plan that nothing gates *may* mean the tier enforces\n    nothing \u2014 but it is not a defect on its own, and OSS states no such\n    invariant. The capability may be enforced outside module dispatch, or\n    reserved for a module not yet generated.\n\n    It is also easy to read a false positive here: `permissions[]` is\n    auth-level access control and lives in a different namespace from\n    `entitlement_gate`, so a permission id appearing in a plan's capability\n    list is a mistake in the *catalog*, not evidence of a missing gate. OSS is"},{"checksum":"sha256:902f77ba5e51fbca4ebb8d7806fed731beb8d88315c200bd8e98f9087d48a0b2","chunk_id":"chunk_374f06e1447055e0","end_line":350,"path":"eval/bundle_scorers.py","start_line":260,"symbol_ids":["sym_5dc971ba8441f47b","sym_ac96c3d8eb1a532d","sym_e31da5b9ab61c67a","sym_9ff8e898512e2b46","sym_63fe92193830420d","sym_26fdf8a8eebb19c2"],"text":"    explicit that the two must not be confused.\n\n    Reported as a count so the trend across builds is visible without asserting\n    a rule the framework does not make.\n    \"\"\"\n    ungated = sorted(bundle.plan_capabilities() - bundle.gated_capabilities())\n    return Feedback(\n        key=\"ungated_plan_capabilities\",\n        value=float(len(ungated)),\n        comment=f\"not gated by any action: {', '.join(ungated)}\" if ungated else None,\n        detail={\"ungated\": ungated},\n    )\n\n\n@scorer\ndef action_gate_coverage(bundle: Bundle) -> Feedback:\n    \"\"\"Share of actions carrying an entitlement gate.\n\n    Reported as a distribution rather than pass/fail: not every action should be\n    gated, and admin_internal actions must not be. The useful signal is the\n    trend across builds, not a threshold.\n    \"\"\"\n    actions = bundle.actions()\n    if not actions:\n        return Feedback(key=\"action_gate_coverage\", value=None, comment=\"no actions\")\n    gated = sum(1 for _, a in actions if str(a.get(\"entitlement_gate\") or \"\").strip())\n    return Feedback(key=\"action_gate_coverage\", value=round(gated / len(actions), 3))\n\n\n@scorer\ndef ui_pages_present(bundle: Bundle) -> Feedback:\n    return Feedback(\n        key=\"ui_pages_present\",\n        score=PASS if bundle.ui_pages else FAIL,\n    )\n\n\n@scorer\ndef ui_endpoints_resolve(bundle: Bundle) -> Feedback:\n    \"\"\"Every UI api_endpoint maps to an action the bundle actually declares.\n\n    Catches UI wired to a nonexistent handler \u2014 a dead button that no\n    generation-time syntax check would notice and no infrastructure metric\n    would ever surface.\n    \"\"\"\n    declared = {f\"{m}/{a.get('id')}\" for m, a in bundle.actions() if a.get(\"id\")}\n    broken: list[str] = []\n    for page, endpoint in bundle.ui_endpoints():\n        parts = [p for p in str(endpoint).split(\"/\") if p]\n        # /api/modules/<module_id>/<action_id>\n        if len(parts) >= 4 and parts[0] == \"api\" and parts[1] == \"modules\":\n            if f\"{parts[2]}/{parts[3]}\" not in declared:\n                broken.append(f\"{page}:{endpoint}\")\n        else:\n            broken.append(f\"{page}:{endpoint} (unrecognised shape)\")\n    return Feedback(\n        key=\"ui_endpoints_resolve\",\n        score=FAIL if broken else PASS,\n        comment=f\"unresolved: {', '.join(broken[:5])}\" if broken else None,\n        detail={\"broken\": broken},\n    )\n\n\n@scorer\ndef has_dockerfile(bundle: Bundle) -> Feedback:\n    return Feedback(\n        key=\"has_dockerfile\",\n        score=PASS if (bundle.root / \"Dockerfile\").is_file() else FAIL,\n    )\n\n\ndef score_bundle(root: Path) -> list[Feedback]:\n    \"\"\"Run every registered scorer against one bundle.\n\n    A scorer that raises yields a Feedback with score=None and the error in\n    detail, matching AG2's behaviour: one broken scorer must not void the run.\n    \"\"\"\n    bundle = Bundle(root)\n    results: list[Feedback] = []\n    for fn in all_scorers():\n        try:\n            results.append(fn(bundle))\n        except Exception as exc:  # noqa: BLE001 - deliberate, see docstring\n            results.append(\n                Feedback(\n                    key=getattr(fn, \"__name__\", \"unknown\"),\n                    score=None,\n                    comment=f\"scorer raised: {type(exc).__name__}: {exc}\",\n                )\n            )\n    return results"},{"checksum":"sha256:00cdf11b321b634e54242ceb508c0151328599b777ca1081314cd37ef1366bf8","chunk_id":"chunk_faa33a339105750b","end_line":86,"path":"eval/evidence.py","start_line":1,"symbol_ids":["sym_1daa86bea8bb78e7","sym_62e17549cefd500b","sym_789cab342bc1e8aa","sym_86b819112d32f1a7","sym_184cec6d51617070"],"text":"\"\"\"Bounded, app-scoped generation facts carried by the existing build outbox.\n\nThese are observations, not learned policy or anonymized community telemetry.\nThe receiver owns retention and aggregation. No source files or prompts travel\nwith this evidence.\n\"\"\"\nfrom __future__ import annotations\n\nimport re\nfrom collections.abc import Mapping\nfrom typing import Annotated, Any, Literal, Self\n\nfrom pydantic import BaseModel, ConfigDict, Field, model_validator\n\nLabel = Annotated[str, Field(min_length=1, max_length=200)]\nGateType = Literal[\"ui_quality\", \"module_contract_quality\", \"module_runtime_quality\"]\n_GATE_CONTEXT_PREFIXES: tuple[tuple[str, GateType], ...] = (\n    (\"app_ui_quality\", \"ui_quality\"),\n    (\"module_contract_quality\", \"module_contract_quality\"),\n    (\"module_runtime_quality\", \"module_runtime_quality\"),\n)\n\n\nclass GateEvidence(BaseModel):\n    model_config = ConfigDict(extra=\"forbid\", strict=True)\n    gate_type: GateType\n    status: Literal[\"passed\", \"blocked\"]\n    issue_count: int = Field(ge=0)\n\n\nclass GenerationEvidence(BaseModel):\n    model_config = ConfigDict(extra=\"forbid\", strict=True)\n    schema_version: Literal[\"mozaiks.generation_evidence.v1\"] = \"mozaiks.generation_evidence.v1\"\n    module_ids: list[Label] = Field(default_factory=list, max_length=100)\n    capability_packs: list[Label] = Field(default_factory=list, max_length=100)\n    gates: list[GateEvidence] = Field(default_factory=list, max_length=3)\n    archetype_ref: Label | None = None\n    prompt_variant_id: Label | None = None\n    model_name: Label | None = None\n    policy_ref: Label | None = None\n    factory_version: Label | None = None\n\n    @model_validator(mode=\"after\")\n    def unique_gates(self) -> Self:\n        gate_types = [gate.gate_type for gate in self.gates]\n        if len(gate_types) != len(set(gate_types)):\n            raise ValueError(\"generation evidence must contain each gate_type at most once\")\n        return self\n\n\ndef _label(context: Mapping[str, Any], key: str) -> str | None:\n    value = context.get(key)\n    return value.strip()[:200] if isinstance(value, str) and value.strip() else None\n\n\ndef collect_generation_evidence(context: Mapping[str, Any]) -> GenerationEvidence:\n    \"\"\"Project declared facts only; missing decision evidence stays unknown.\"\"\"\n    files = context.get(\"generated_files\")\n    modules = set()\n    for path in files if isinstance(files, dict) else []:\n        match = re.search(r\"(?:^|/)modules/([a-zA-Z0-9_-]{1,200})/\", str(path))\n        if match:\n            modules.add(match.group(1))\n    # The launch-level capability_packs registry describes available inputs.\n    # The normalized AppBuildPlan records which packs were actually selected.\n    plan = context.get(\"app_build_plan\")\n    packs = plan.get(\"capability_packs\") if isinstance(plan, dict) else None\n    pack_ids = set()\n    for pack in packs if isinstance(packs, list) else []:\n        value = pack.get(\"capability_pack_id\") if isinstance(pack, dict) else None\n        if isinstance(value, str) and value.strip():\n            pack_ids.add(value.strip()[:200])\n    gates = []\n    for prefix, gate_type in _GATE_CONTEXT_PREFIXES:\n        status = context.get(f\"{prefix}_status\")\n        if status in {\"passed\", \"blocked\"}:\n            warnings = context.get(f\"{prefix}_warnings\")\n            gates.append(GateEvidence(gate_type=gate_type, status=status,\n                                      issue_count=len(warnings) if isinstance(warnings, list) else 0))\n    return GenerationEvidence(\n        module_ids=sorted(modules)[:100], capability_packs=sorted(pack_ids)[:100], gates=gates,\n        archetype_ref=_label(context, \"archetype_ref\"),\n        prompt_variant_id=_label(context, \"prompt_variant_id\"),\n        model_name=_label(context, \"model_name\"), policy_ref=_label(context, \"policy_ref\"),\n        factory_version=_label(context, \"factory_version\"),\n    )"},{"checksum":"sha256:c22a117f72615fd0aa155577f643ab46f8d3fffac28ea3f75e6c5eb2a0a3e6bf","chunk_id":"chunk_31f9f6827a4b4c34","end_line":14,"path":"refinement_harness/__init__.py","start_line":1,"symbol_ids":[],"text":"\"\"\"Factory app refinement harness.\n\nThis package is declarative first-party builder/reference app surface area only:\n\n- `config/` declares checkpoints, tools, and policies\n- `prompts/` contains checkpoint prompt files\n- `tools/` contains builder-specific refinement tools\n- `ui/` is reserved for future refinement harness UI surfaces\n\nThe refinement engine runtime currently lives in `mozaiksai/control_plane/`\nfor import compatibility.\n\"\"\"\n\n__all__: list[str] = []"},{"checksum":"sha256:e956c69f86f650aee984eb4db6c72fa5afcaaa6f0dfe936a501a1ef8714ff5ed","chunk_id":"chunk_c5d681af294a12d9","end_line":106,"path":"refinement_harness/config/harness.yaml","start_line":1,"symbol_ids":[],"text":"schema_version: mozaiks.refinement_harness.v1\nrouting:\n  default_build_family: app_bundle\n  artifacts:\n    - build_family: concept\n      label: concept\n      routes:\n        patch:\n          workflow_sequence: concept_patch\n        design:\n          workflow_sequence: full_rebuild\n        feature:\n          workflow_sequence: full_rebuild\n        core:\n          workflow_sequence: conceptual_replan\n    - build_family: design_docs\n      label: design docs\n      routes:\n        patch:\n          workflow_sequence: design_patch\n        design:\n          workflow_sequence: design_revision\n        feature:\n          workflow_sequence: design_revision\n        core:\n          workflow_sequence: full_rebuild\n    - build_family: subscription_contract\n      label: subscription contract\n      routes:\n        patch:\n          workflow_sequence: subscription_patch\n        design:\n          workflow_sequence: subscription_revision\n        feature:\n          workflow_sequence: subscription_revision\n        core:\n          workflow_sequence: full_rebuild\n    - build_family: workflow_bundle\n      label: workflow bundle\n      routes:\n        patch:\n          workflow_sequence: workflow_patch\n        design:\n          workflow_sequence: workflow_revision\n        feature:\n          workflow_sequence: workflow_revision\n        core:\n          workflow_sequence: full_rebuild\n    - build_family: app_bundle\n      label: app bundle\n      routes:\n        patch:\n          workflow_sequence: app_revision\n        design:\n          workflow_sequence: app_surface_revision\n        feature:\n          workflow_sequence: app_revision\n        core:\n          workflow_sequence: full_rebuild\n    - build_family: theme_capture\n      label: theme config\n      routes:\n        patch:\n          workflow_sequence: theme_patch\n        design:\n          workflow_sequence: theme_revision\n        feature:\n          workflow_sequence: theme_revision\n        core:\n          workflow_sequence: full_rebuild\ncheckpoints:\n  - event: request_submitted\n    prompt_id: change_classifier_system\n    tool_ids:\n      - get_revision_context\n      - get_artifact_summary\n      - get_app_intelligence_context\n      - get_stale_artifact_families\n  - event: route_requested\n  - event: decision_requested\n  - event: scope_requested\n    prompt_id: coding_scope_selection_system\n    tool_ids:\n      - get_revision_context\n      - get_artifact_summary\n      - get_app_intelligence_context\n      - get_artifact_workspace_catalog\n      - get_context_graph_catalog\n      - search_app_source_context\n  - event: contract_surface_requested\n    prompt_id: contract_surface_selection_system\n    tool_ids:\n      - get_contract_surface_context\n      - get_app_intelligence_context\n      - search_app_source_context\n  - event: coding_requested\n    prompt_id: coding_refinement_system\n    tool_ids:\n      - get_revision_context\n      - get_artifact_summary\n      - get_app_intelligence_context\n      - get_artifact_workspace_scope\n      - get_context_graph_scope\n      - search_app_source_context\n      - read_app_source_file\n      - get_related_app_source_files"},{"checksum":"sha256:918500dc19285b0bf5f118cd59065416ef0776bd7cc32c04783b7678bded1217","chunk_id":"chunk_4d5f0a855917d3f5","end_line":5,"path":"refinement_harness/config/policies.yaml","start_line":1,"symbol_ids":[],"text":"schema_version: mozaiks.refinement_harness.policies.v1\nscope:\n  max_selected_paths: 3\n  auto_apply_max_paths: 1\n  overflow_behavior: clarify"},{"checksum":"sha256:8778da1721cc8889eabd5a56671e01bd9f85de9f6d9481502b72fc2fd152aba4","chunk_id":"chunk_13935b6d9c12acd9","end_line":112,"path":"refinement_harness/config/tools.yaml","start_line":1,"symbol_ids":[],"text":"schema_version: mozaiks.refinement_harness.tools.v1\ntools:\n  - id: get_revision_context\n    kind: context_tool\n    description: Load runtime-owned revision context including session state, tracked artifact lineage, persisted summary payloads, resolved canonical inputs, and active change-request lineage.\n    entrypoint: mozaiksai.control_plane.tools.get_revision_context:get_revision_context\n    available_to:\n      - request_submitted\n      - scope_requested\n      - coding_requested\n  - id: get_artifact_summary\n    kind: context_tool\n    description: Load artifact lineage, validation status, and recent change history for the current refinement target.\n    entrypoint: factory_app.refinement_harness.tools.get_artifact_summary:get_artifact_summary\n    available_to:\n      - request_submitted\n      - scope_requested\n      - route_requested\n      - coding_requested\n  - id: get_artifact_workspace_scope\n    kind: context_tool\n    description: Load a safe workspace tree and related-file previews for the selected artifact version and scoped files.\n    entrypoint: factory_app.refinement_harness.tools.get_artifact_workspace_scope:get_artifact_workspace_scope\n    available_to:\n      - coding_requested\n  - id: get_artifact_workspace_catalog\n    kind: context_tool\n    description: Load a safe workspace catalog, directory summary, and request-matched candidate files for the artifact version.\n    entrypoint: factory_app.refinement_harness.tools.get_artifact_workspace_catalog:get_artifact_workspace_catalog\n    available_to:\n      - scope_requested\n  - id: get_context_graph_catalog\n    kind: context_tool\n    description: Load the merged current AppContextGraph and artifact code graph for graph-aware scope selection, including candidate files, matched nodes, and relationship hints.\n    entrypoint: factory_app.refinement_harness.tools.get_context_graph_catalog:get_context_graph_catalog\n    available_to:\n      - scope_requested\n  - id: get_app_intelligence_context\n    kind: context_tool\n    description: Load compact App Intelligence for the current app or selected artifact, including architecture, capability, ownership, integration, data, risk, and agent-context policy summaries without raw source contents.\n    entrypoint: factory_app.refinement_harness.tools.app_intelligence:get_app_intelligence_context\n    available_to:\n      - request_submitted\n      - scope_requested\n      - contract_surface_requested\n      - coding_requested\n  - id: run_app_source_validation\n    kind: validation_tool\n    description: Run framework-aware validation commands from the current App Intelligence source context after staged source changes are ready for review.\n    entrypoint: factory_app.refinement_harness.tools.app_validation:run_app_source_validation\n    available_to:\n      - coding_requested\n  - id: get_context_graph_scope\n    kind: context_tool\n    description: Load graph-neighborhood context for explicitly scoped files, including related files, symbols, and edges from the current app/artifact Context Graph.\n    entrypoint: factory_app.refinement_harness.tools.get_context_graph_scope:get_context_graph_scope\n    available_to:\n      - coding_requested\n  - id: search_app_source_context\n    kind: context_tool\n    description: Search the current persisted SourceContextBundle, falling back to the selected artifact workspace when current app context is unavailable.\n    entrypoint: factory_app.refinement_harness.tools.source_context:search_app_source_context\n    available_to:\n      - scope_requested\n      - contract_surface_requested\n      - coding_requested\n  - id: read_app_source_file\n    kind: context_tool\n    description: Read one exact file from the current SourceContextBundle or selected artifact workspace source corpus by indexed path.\n    entrypoint: factory_app.refinement_harness.tools.source_context:read_app_source_file\n    available_to:\n      - scope_requested\n      - coding_requested\n  - id: get_related_app_source_files\n    kind: context_tool\n    description: Return related indexed source files for a selected path using SourceContextBundle import and directory relationships.\n    entrypoint: factory_app.refinement_harness.tools.source_context:get_related_app_source_files\n    available_to:\n      - coding_requested\n  - id: get_stale_artifact_families\n    kind: context_tool\n    description: Return the artifact families (concept, brand, design_docs, workflow_bundle, app_bundle) that have stale versions for this app. Used by the classifier to detect upstream families invalidated by a prior change request so routing can include the minimal necessary refresh.\n    entrypoint: factory_app.refinement_harness.tools.get_stale_artifact_families:get_stale_artifact_families\n    available_to:\n      - request_submitted\n  - id: get_contract_surface_context\n    kind: context_tool\n    description: Load the artifact workspace file tree and context graph catalog for contract surface resolution. Used by the ContractSurfacePlanner to confirm which canonical paths exist in the workspace before resolving surface file lists.\n    entrypoint: factory_app.refinement_harness.tools.get_contract_surface_context:get_contract_surface_context\n    available_to:\n      - contract_surface_requested\n  - id: get_carry_forward_candidates\n    kind: context_tool\n    description: >\n      Inspect the previous app_bundle artifact workspace and return a structured\n      module inventory (ModuleInventoryEntry list) for carry-forward analysis.\n      Read-only \u2014 no file writes, no artifact writes, no LLM calls.\n      Returns empty modules + warnings when the previous workspace is missing or\n      unreadable. Registered at route_requested because conceptual_replan routing\n      is determined at that checkpoint; Phase 3 will call this tool\n      programmatically from _build_context_seed() to auto-populate\n      carry_forward_modules without requiring the client to supply it.\n    entrypoint: factory_app.refinement_harness.tools.get_carry_forward_candidates:get_carry_forward_candidates\n    available_to:\n      - route_requested\n  - id: read_artifact_file\n    kind: context_tool\n    description: Read a single file from the artifact workspace by its relative path. Returns file content up to 80,000 characters. Use when an agent needs to inspect a specific artifact file by known path rather than browsing the full workspace catalog.\n    entrypoint: factory_app.refinement_harness.tools.read_artifact_file:read_artifact_file\n    available_to:\n      - scope_requested\n      - coding_requested"},{"checksum":"sha256:c5d023e20ded1c5045e87a0801baf2d0c971ce1cb84b15a9491b54ae1d9a26e5","chunk_id":"chunk_31a39af01f966dff","end_line":61,"path":"refinement_harness/prompts/change_classifier_system.yaml","start_line":1,"symbol_ids":[],"text":"id: change_classifier_system\ncontent: |\n  You are the authoritative Mozaiks refinement change classifier.\n\n  Classify a natural-language build refinement request into exactly one of:\n  - patch: targeted fix or localized correction within the current artifact boundary\n  - design: visual, UX, information architecture, schema, or design-system revision without changing the product concept\n  - feature: additive capability within the current product direction\n  - core: change in value proposition, target user, product identity, business model, architecture direction, or anything that should reopen ValueEngine\n\n  ## Artifact family dependency order (upstream \u2192 downstream)\n  concept \u2192 design_docs \u2192 subscription_contract \u2192 workflow_bundle \u2192 app_bundle\n  concept \u2192 brand \u2192 app_bundle\n\n  Requests about plans, pricing tiers, entitlement gating, token allowances, or\n  monetization scope target the subscription_contract family when the refined\n  artifact is the subscription contract itself.\n\n  ## Staleness-aware routing rules\n\n  The `get_stale_artifact_families` tool in `refinement_context_json` tells you which\n  artifact families were invalidated by a prior build operation but not yet refreshed.\n  Stale families represent work the system deferred \u2014 they MUST be resolved before their\n  downstream artifacts are trustworthy.\n\n  Apply these rules when `stale_families` is non-empty:\n\n  1. If an upstream family of the TARGET artifact is stale, you must upgrade your\n     classification so the chosen route covers that upstream family.\n\n     Examples:\n     - User wants an app_bundle change, but `design_docs` is stale\n       \u2192 classify as \"design\" (not \"patch\") so the route runs DesignDocs first\n     - User wants an app_bundle change, but `concept` is stale\n       \u2192 classify as \"core\" so the route restarts from ValueEngine\n     - User wants a design_docs change, but `concept` is stale\n       \u2192 classify as \"core\"\n     - User wants a workflow_bundle patch, but `design_docs` is stale\n       \u2192 classify as \"design\"\n\n  2. If only the TARGET family itself is stale (not an upstream), the staleness\n     is consistent with the user's intent \u2014 do not upgrade the classification.\n\n  3. If `all_current: true` or `stale_families` is empty, route purely from the\n     request text with no staleness adjustment.\n\n  4. A stale family that is DOWNSTREAM of the target does not require upgrading \u2014\n     the chosen route will refresh it as a side effect.\n\n  ## General rules\n  - Use the request text as the primary signal.\n  - Use any provided `refinement_context_json` as canonical persisted builder state.\n  - Use `get_app_intelligence_context` for AppContext freshness, ownership\n    warnings, capability shape, and artifact lineage as routing evidence only.\n    Do not classify from raw source snippets at this checkpoint; exact source\n    retrieval belongs to scope selection and coding.\n  - Treat a user-declared hint as advisory only, never authoritative.\n  - Be conservative about `core`, but choose it when the request changes what the product fundamentally is.\n  - Return JSON only.\n  - Do not include markdown fences.\n  - Keep `signals` short and semantic, such as \"new_capability\", \"concept_shift\", \"workflow_expansion\", \"visual_redesign\", \"bug_fix\", \"target_user_change\", \"stale_upstream_resolved\"."},{"checksum":"sha256:491bc8cedaec58f492cb44411028be764576e05d0440cf19fcbf7bfd000bf932","chunk_id":"chunk_7cbdad5f299f92a6","end_line":33,"path":"refinement_harness/prompts/coding_refinement_system.yaml","start_line":1,"symbol_ids":[],"text":"id: coding_refinement_system\ncontent: |\n  You are the Mozaiks scoped coding refinement worker.\n\n  You are not deciding global orchestration. The Refinement Engine already decided\n  that this request is narrow enough for a coding worker.\n\n  Your job is to produce a bounded patch-style refinement against explicit\n  file inputs.\n\n  Context policy:\n  - Treat the explicit scoped file inputs as the only editable files.\n  - Use `get_app_intelligence_context` for app shape, ownership, capability,\n    integration, data, and risk orientation before reading exact files.\n  - Use `get_context_graph_scope` to understand symbols, imports, related\n    files, ownership, module/page/workflow boundaries, and nearby risk.\n  - Use `read_app_source_file` to inspect exact indexed source content for\n    scoped files when the provided file input or graph scope is insufficient.\n  - Use `get_related_app_source_files` and `search_app_source_context` for\n    read-only orientation only. Related files are context, not edit permission.\n  - If required code context is missing, stale, or outside the explicit file\n    inputs, ask for workflow routing or human review instead of widening scope.\n\n  Rules:\n  - Stay scoped to the provided file paths and artifact boundary.\n  - Return complete updated file content for every changed file in `updated_files`.\n  - Only edit files that already appear in the provided explicit file inputs.\n  - Use `refinement_context`, especially Context Graph scope, to understand nearby files, symbols, imports, module/page/workflow ownership, and artifact workspace scope before changing code.\n  - Prefer the smallest safe validation strategy.\n  - Use provided refinement context as canonical persisted builder state.\n  - Ask for human review only when the request cannot be handled safely as a local patch.\n  - Return JSON only.\n  - Do not include markdown fences."},{"checksum":"sha256:844c187f36d3e881ecce876fa05063058786d89c84a38869a530212f6bae9bd7","chunk_id":"chunk_8ac2bdc385111829","end_line":34,"path":"refinement_harness/prompts/coding_scope_selection_system.yaml","start_line":1,"symbol_ids":[],"text":"id: coding_scope_selection_system\ncontent: |\n  You are the Mozaiks coding scope selector.\n\n  The Refinement Engine already decided this request is narrow enough to try a coding worker,\n  but the explicit file scope may still be missing.\n\n  Your job is to pick the narrowest safe file scope for the patch.\n\n  Context policy:\n  - Treat `get_revision_context` and `get_artifact_summary` as the persisted\n    builder-state baseline.\n  - Treat `get_app_intelligence_context` as the compact app-understanding\n    baseline: architecture, capabilities, ownership, integrations, data\n    surfaces, risks, and context freshness.\n  - Treat `get_context_graph_catalog` as the primary code-relationship signal\n    for scope selection. Use its matched paths, graph nodes, relationships,\n    parser/scan health, and warnings before relying on filename guesses.\n  - Treat `get_artifact_workspace_catalog` as the artifact-boundary check:\n    scoped files must exist in this catalog or another explicit tool result.\n  - Use `search_app_source_context` only to inspect likely code evidence before\n    choosing scope. Do not include source excerpts in the output.\n  - Do not request exact full-file content during scope selection. Exact file\n    reads belong to the coding checkpoint after explicit scope exists.\n\n  Rules:\n  - Prefer one file when possible.\n  - Use provided refinement context, especially the Context Graph catalog, artifact workspace catalog, and recent artifact metadata.\n  - Prefer files with direct graph relationships to the requested page, module, workflow, symbol, tool, or config surface.\n  - Only choose existing file paths that appear in the provided context.\n  - If the request is too ambiguous for a safe patch scope, return `clarify`.\n  - If the request is broader than a bounded patch, return `workflow`.\n  - Return JSON only.\n  - Do not include markdown fences."},{"checksum":"sha256:7f0c2e8397ab31362347b97693751df5f6494b0e9f53067cff34e0f7d65d6cc1","chunk_id":"chunk_15546b62967b92b0","end_line":77,"path":"refinement_harness/prompts/contract_surface_selection_system.yaml","start_line":1,"symbol_ids":[],"text":"id: contract_surface_selection_system\ncontent: |\n  You are the Mozaiks contract surface classifier.\n\n  Your job is to map a refinement request to the specific Mozaiks contract\n  surfaces that need to be updated \u2014 not to the files themselves, but to the\n  contracts that govern the files.\n\n  Context policy:\n\n  - Treat `get_contract_surface_context` as the primary source for current\n    contract surfaces, existing paths, Context Graph relationships, and\n    request-matched candidates.\n  - Use `get_app_intelligence_context` to understand current architecture,\n    capability ownership, integration surfaces, data surfaces, and risk hints\n    before selecting contract surfaces.\n  - Use `search_app_source_context` only to confirm code evidence for a\n    candidate surface when the contract catalog is not enough.\n  - Do not select a surface that is absent from the current contract context\n    unless the request explicitly adds a new surface.\n  - Prefer declared Mozaiks contract ownership over filename similarity.\n\n  Mozaiks contract surfaces:\n\n  module_action\n    A module's declared actions change: a new action is added, an existing\n    action is modified, or an action is removed.\n    Canonical files: module.yaml, handler.py, service.py, schemas.py,\n    repo.py, policy.py under modules/{module_id}/backend/.\n\n  module_contract\n    Module identity declarations change without changing action behavior:\n    events, capabilities, settings, admin panels.\n    Canonical files: module.yaml, contracts/events.yaml.\n\n  page_binding\n    A page or page section changes: new section, modified layout, different\n    data binding, new action binding.\n    Canonical files: ui/pages/{page_id}.yaml, app.json.\n\n  data_schema\n    Typed request/response/document shapes change without changing module\n    action declarations.\n    Canonical files: modules/{module_id}/backend/schemas.py.\n\n  workflow_tool\n    A workflow tool is added, modified, or removed.\n    Canonical files: workflows/{workflow_name}/tools.yaml plus the tool\n    Python file.\n\n  workflow_agent\n    A workflow agent, its prompt, its structured output, or its handoff\n    routing changes.\n    Canonical files: agents.yaml, structured_outputs.yaml, transition_graph.yaml.\n\n  ui_component\n    A workflow UI component changes.\n    Canonical files: ui/{workflow_name}/components/*.js, ui_config.yaml.\n\n  app_config\n    App-level configuration changes: shell preset, theme, nav structure.\n    Canonical files: app.json.\n\n  Rules:\n\n  - Classify only surfaces that are directly affected by the user request.\n    Do not include surfaces that might incidentally be affected.\n  - target_id is the module_id, workflow_name, or page_id \u2014 not a file path.\n  - confidence reflects how certain you are this surface needs to change.\n  - Set fallback_to_workflow: true if the request is too broad to scope to\n    specific surfaces (e.g., \"rebuild the whole app\", \"change the architecture\").\n  - Set requires_schema_migration: true only if the data contract\n    (data/contract.json) would need a new migration.\n  - generation_hint should describe what specifically needs to change on this\n    surface \u2014 one concrete sentence.\n  - Return JSON only. No markdown fences.\n"},{"checksum":"sha256:93f8e888aa74249f72c0571bcc35ada2484d0e45b6120d1284274d65f475df36","chunk_id":"chunk_eceeb5628fb0558e","end_line":16,"path":"refinement_harness/tools/__init__.py","start_line":1,"symbol_ids":[],"text":"\"\"\"First-party default refinement tool implementations.\"\"\"\n\nfrom .app_intelligence import get_app_intelligence_context\nfrom .source_context import (\n    get_related_app_source_files,\n    read_app_source_file,\n    search_app_source_context,\n)\n\n__all__ = [\n    \"get_app_intelligence_context\",\n    \"get_related_app_source_files\",\n    \"read_app_source_file\",\n    \"search_app_source_context\",\n]\n"},{"checksum":"sha256:8eb52e1688fb3587fd1ba650cf57aede8c199a0a24fde8d22bc27165b75917f8","chunk_id":"chunk_2bf3a102178ba5a3","end_line":247,"path":"refinement_harness/tools/_artifact_workspace.py","start_line":1,"symbol_ids":["sym_050f9a4517223ef6","sym_dc7ef743f2fc10e1","sym_b1116ddb3b046f5f","sym_0edcc70265e26588","sym_a32d77efeab38464","sym_d41d6ee35cdb63d4","sym_f675d91daaf0b251","sym_5effd2e7ef839227","sym_06a40fa209eb7f19","sym_28b7e9f4e5311284","sym_bbabe8e78c1a4366"],"text":"from __future__ import annotations\n\nimport io\nimport os\nimport re\nimport zipfile\nfrom pathlib import Path, PurePosixPath\nfrom typing import Any\n\nfrom mozaiksai.core.app_context.scan_policy import (\n    default_context_graph_scan_policy,\n    is_excluded_source_directory_path,\n    is_sensitive_source_path,\n    safe_scan_relpath,\n)\nfrom mozaiksai.core.artifacts.content_store import ArtifactContentStore, ContentNotFoundError\nfrom mozaiksai.core.artifacts.store import ArtifactStore\n\n_MAX_FILE_BYTES = 80_000\n_IMPORT_EXTENSIONS = (\n    \"\",\n    \".js\",\n    \".jsx\",\n    \".ts\",\n    \".tsx\",\n    \".json\",\n    \".py\",\n    \"/index.js\",\n    \"/index.jsx\",\n    \"/index.ts\",\n    \"/index.tsx\",\n)\n\n\ndef safe_relpath(raw: Any) -> str | None:\n    return safe_scan_relpath(raw)\n\n\nasync def load_artifact_workspace(\n    *,\n    artifact_store: ArtifactStore,\n    app_id: str,\n    build_record_id: str,\n    content_store: ArtifactContentStore | None = None,\n) -> dict[str, Any]:\n    artifact = await artifact_store.get_build_record(\n        app_id=app_id,\n        build_record_id=build_record_id,\n    )\n    if artifact is None:\n        return {\"present\": False, \"reason\": \"artifact_not_found\", \"build_record_id\": build_record_id}\n\n    metadata = dict(artifact.commit_metadata.metadata or {}) if artifact.commit_metadata else {}\n    workspace_dir = metadata.get(\"workspace_dir\")\n    artifact_path = metadata.get(\"artifact_path\")\n    content_ref = metadata.get(\"content_ref\")\n    content_backend = metadata.get(\"content_backend\")\n\n    if workspace_dir and Path(str(workspace_dir)).exists():\n        file_map = read_workspace_dir(Path(str(workspace_dir)))\n        source = \"workspace_dir\"\n    elif artifact_path and Path(str(artifact_path)).exists():\n        file_map = read_artifact_zip(Path(str(artifact_path)))\n        source = \"artifact_zip\"\n    elif content_ref:\n        if content_store is None:\n            return {\n                \"present\": False,\n                \"reason\": \"content_store_unavailable\",\n                \"build_record_id\": artifact.id,\n                \"content_ref\": content_ref,\n                \"content_backend\": content_backend,\n            }\n        try:\n            data = await content_store.get_bundle(content_ref)\n            file_map = read_artifact_zip_bytes(data)\n            source = f\"content_store:{content_backend or 'unknown'}\"\n        except ContentNotFoundError:\n            return {\n                \"present\": False,\n                \"reason\": \"content_ref_not_found\",\n                \"build_record_id\": artifact.id,\n                \"content_ref\": content_ref,\n                \"content_backend\": content_backend,\n            }\n        except Exception as exc:\n            return {\n                \"present\": False,\n                \"reason\": \"content_store_error\",\n                \"build_record_id\": artifact.id,\n                \"content_ref\": content_ref,\n                \"content_backend\": content_backend,\n                \"error\": str(exc),\n            }\n    else:\n        return {\n            \"present\": False,\n            \"reason\": \"workspace_unavailable\",\n            \"build_record_id\": artifact.id,\n            \"artifact_path\": artifact_path,\n            \"workspace_dir\": workspace_dir,\n        }\n\n    return {\n        \"present\": True,\n        \"artifact\": artifact,\n        \"source\": source,\n        \"file_map\": file_map,\n        \"workspace_dir\": workspace_dir,\n        \"artifact_path\": artifact_path,\n        \"content_ref\": content_ref,\n        \"content_backend\": content_backend,\n    }\n\n\ndef read_workspace_dir(root: Path) -> dict[str, str]:\n    file_map: dict[str, str] = {}\n    policy = default_context_graph_scan_policy()\n    for current, dir_names, file_names in os.walk(root):\n        dir_names[:] = sorted(\n            name for name in dir_names if name.lower() not in policy.excluded_dir_names\n        )\n        for file_name in sorted(file_names):\n            file_path = Path(current) / file_name\n            rel = safe_relpath(file_path.relative_to(root).as_posix())\n            if rel is None:\n                continue\n            if _skip_artifact_workspace_path(rel):\n                continue\n            if not file_path.is_file():\n                continue\n            if file_path.stat().st_size > _MAX_FILE_BYTES:\n                continue\n            try:\n                file_map[rel] = file_path.read_text(encoding=\"utf-8\")\n            except Exception:\n                continue\n    return file_map\n\n\ndef _read_from_archive(archive: zipfile.ZipFile) -> dict[str, str]:\n    raw_entries: list[tuple[str, str]] = []\n    for info in sorted(archive.infolist(), key=lambda item: item.filename):\n        if info.is_dir() or info.file_size > _MAX_FILE_BYTES:\n            continue\n        safe_name = safe_relpath(info.filename)\n        if safe_name is None:\n            continue\n        if _skip_artifact_workspace_path(safe_name):\n            continue\n        try:\n            decoded = archive.read(info.filename).decode(\"utf-8\")\n        except Exception:\n            continue\n        raw_entries.append((safe_name, decoded))\n\n    if not raw_entries:\n        return {}\n\n    split_paths = [path.split(\"/\") for path, _ in raw_entries]\n    if split_paths and all(len(parts) > 1 for parts in split_paths):\n        first = split_paths[0][0]\n        if all(parts[0] == first for parts in split_paths):\n            return {\"/\".join(path.split(\"/\")[1:]): content for path, content in raw_entries}\n    return dict(raw_entries)\n\n\ndef _skip_artifact_workspace_path(path: str) -> bool:\n    safe = safe_relpath(path)\n    if safe is None:\n        return True\n    policy = default_context_graph_scan_policy()\n    name = PurePosixPath(safe).name.lower()\n    return (\n        is_excluded_source_directory_path(safe, policy=policy)\n        or is_sensitive_source_path(safe)\n        or name in policy.excluded_file_names\n        or \".min.\" in name\n    )\n\n\ndef read_artifact_zip(zip_path: Path) -> dict[str, str]:\n    with zipfile.ZipFile(zip_path, \"r\") as archive:\n        return _read_from_archive(archive)\n\n\ndef read_artifact_zip_bytes(data: bytes) -> dict[str, str]:\n    \"\"\"Read an artifact zip from raw bytes (e.g. retrieved from a content store).\"\"\"\n    with zipfile.ZipFile(io.BytesIO(data), \"r\") as archive:\n        return _read_from_archive(archive)\n\n\ndef siblings_for(*, path: str, file_map: dict[str, str], limit: int = 8) -> list[str]:\n    parent = str(PurePosixPath(path).parent)\n    if parent == \".\":\n        parent = \"\"\n    siblings = []\n    for candidate in sorted(file_map.keys()):\n        if candidate == path:\n            continue\n        candidate_parent = str(PurePosixPath(candidate).parent)\n        if candidate_parent == \".\":\n            candidate_parent = \"\"\n        if candidate_parent == parent:\n            siblings.append(candidate)\n    return siblings[:limit]\n\n\ndef resolve_related_imports(*, path: str, content: str, file_map: dict[str, str], limit: int = 8) -> list[str]:\n    if not content.strip():\n        return []\n    base_dir = PurePosixPath(path).parent\n    related: list[str] = []\n    for raw_import in extract_relative_imports(content):\n        for candidate in candidate_paths(base_dir=base_dir, import_path=raw_import):\n            if candidate in file_map and candidate not in related:\n                related.append(candidate)\n                break\n    return related[:limit]\n\n\ndef extract_relative_imports(content: str) -> list[str]:\n    patterns = [\n        re.compile(r\"\"\"from\\s+['\"](\\.[^'\"]+)['\"]\"\"\"),\n        re.compile(r\"\"\"import\\s+.*?\\s+from\\s+['\"](\\.[^'\"]+)['\"]\"\"\"),\n        re.compile(r\"\"\"require\\(\\s*['\"](\\.[^'\"]+)['\"]\\s*\\)\"\"\"),\n    ]\n    imports: list[str] = []\n    for pattern in patterns:\n        for match in pattern.findall(content):\n            candidate = str(match or \"\").strip()\n            if candidate and candidate not in imports:\n                imports.append(candidate)\n    return imports\n\n\ndef candidate_paths(*, base_dir: PurePosixPath, import_path: str) -> list[str]:\n    normalized_import = import_path.strip()\n    if not normalized_import.startswith(\".\"):\n        return []\n    candidates: list[str] = []\n    for suffix in _IMPORT_EXTENSIONS:\n        combined = (base_dir / f\"{normalized_import}{suffix}\").as_posix()\n        safe = safe_relpath(combined)\n        if safe and safe not in candidates:\n            candidates.append(safe)\n    return candidates"},{"checksum":"sha256:d703916ecaef280ac11cca14fb2dcaa52eda28c16a7e583dbadb8245fc7d209e","chunk_id":"chunk_2f030794b8870b21","end_line":247,"path":"refinement_harness/tools/_bundle_workspace.py","start_line":1,"symbol_ids":["sym_7bed4185fa0df0db","sym_2c3ba209439514f4","sym_080d7c177a85dbd1","sym_3386635b2bba1357","sym_1a50b83c57480266","sym_a98c82cc52276e44","sym_55c4cc3445ca769f","sym_1cbb495050af074c","sym_ce4b78c661eb2e32","sym_c3cb5f02f15047d5","sym_0a4947404f0bb6b9"],"text":"from __future__ import annotations\n\nimport io\nimport os\nimport re\nimport zipfile\nfrom pathlib import Path, PurePosixPath\nfrom typing import Any\n\nfrom mozaiksai.core.app_context.scan_policy import (\n    default_context_graph_scan_policy,\n    is_excluded_source_directory_path,\n    is_sensitive_source_path,\n    safe_scan_relpath,\n)\nfrom mozaiksai.core.artifacts.content_store import BundleContentStore, ContentNotFoundError\nfrom mozaiksai.core.artifacts.store import BuildRecordStore\n\n_MAX_FILE_BYTES = 80_000\n_IMPORT_EXTENSIONS = (\n    \"\",\n    \".js\",\n    \".jsx\",\n    \".ts\",\n    \".tsx\",\n    \".json\",\n    \".py\",\n    \"/index.js\",\n    \"/index.jsx\",\n    \"/index.ts\",\n    \"/index.tsx\",\n)\n\n\ndef safe_relpath(raw: Any) -> str | None:\n    return safe_scan_relpath(raw)\n\n\nasync def load_bundle_workspace(\n    *,\n    record_store: BuildRecordStore,\n    app_id: str,\n    build_record_id: str,\n    content_store: BundleContentStore | None = None,\n) -> dict[str, Any]:\n    artifact = await record_store.get_build_record(\n        app_id=app_id,\n        build_record_id=build_record_id,\n    )\n    if artifact is None:\n        return {\"present\": False, \"reason\": \"artifact_not_found\", \"build_record_id\": build_record_id}\n\n    metadata = dict(artifact.commit_metadata.metadata or {}) if artifact.commit_metadata else {}\n    workspace_dir = metadata.get(\"workspace_dir\")\n    bundle_path = metadata.get(\"artifact_path\")\n    content_ref = metadata.get(\"content_ref\")\n    content_backend = metadata.get(\"content_backend\")\n\n    if workspace_dir and Path(str(workspace_dir)).exists():\n        file_map = read_workspace_dir(Path(str(workspace_dir)))\n        source = \"workspace_dir\"\n    elif bundle_path and Path(str(bundle_path)).exists():\n        file_map = read_bundle_zip(Path(str(bundle_path)))\n        source = \"artifact_zip\"\n    elif content_ref:\n        if content_store is None:\n            return {\n                \"present\": False,\n                \"reason\": \"content_store_unavailable\",\n                \"build_record_id\": artifact.id,\n                \"content_ref\": content_ref,\n                \"content_backend\": content_backend,\n            }\n        try:\n            data = await content_store.get_bundle(content_ref)\n            file_map = read_bundle_zip_bytes(data)\n            source = f\"content_store:{content_backend or 'unknown'}\"\n        except ContentNotFoundError:\n            return {\n                \"present\": False,\n                \"reason\": \"content_ref_not_found\",\n                \"build_record_id\": artifact.id,\n                \"content_ref\": content_ref,\n                \"content_backend\": content_backend,\n            }\n        except Exception as exc:\n            return {\n                \"present\": False,\n                \"reason\": \"content_store_error\",\n                \"build_record_id\": artifact.id,\n                \"content_ref\": content_ref,\n                \"content_backend\": content_backend,\n                \"error\": str(exc),\n            }\n    else:\n        return {\n            \"present\": False,\n            \"reason\": \"workspace_unavailable\",\n            \"build_record_id\": artifact.id,\n            \"bundle_path\": bundle_path,\n            \"workspace_dir\": workspace_dir,\n        }\n\n    return {\n        \"present\": True,\n        \"artifact\": artifact,\n        \"source\": source,\n        \"file_map\": file_map,\n        \"workspace_dir\": workspace_dir,\n        \"bundle_path\": bundle_path,\n        \"content_ref\": content_ref,\n        \"content_backend\": content_backend,\n    }\n\n\ndef read_workspace_dir(root: Path) -> dict[str, str]:\n    file_map: dict[str, str] = {}\n    policy = default_context_graph_scan_policy()\n    for current, dir_names, file_names in os.walk(root):\n        dir_names[:] = sorted(\n            name for name in dir_names if name.lower() not in policy.excluded_dir_names\n        )\n        for file_name in sorted(file_names):\n            file_path = Path(current) / file_name\n            rel = safe_relpath(file_path.relative_to(root).as_posix())\n            if rel is None:\n                continue\n            if _skip_bundle_workspace_path(rel):\n                continue\n            if not file_path.is_file():\n                continue\n            if file_path.stat().st_size > _MAX_FILE_BYTES:\n                continue\n            try:\n                file_map[rel] = file_path.read_text(encoding=\"utf-8\")\n            except Exception:\n                continue\n    return file_map\n\n\ndef _read_from_archive(archive: zipfile.ZipFile) -> dict[str, str]:\n    raw_entries: list[tuple[str, str]] = []\n    for info in sorted(archive.infolist(), key=lambda item: item.filename):\n        if info.is_dir() or info.file_size > _MAX_FILE_BYTES:\n            continue\n        safe_name = safe_relpath(info.filename)\n        if safe_name is None:\n            continue\n        if _skip_bundle_workspace_path(safe_name):\n            continue\n        try:\n            decoded = archive.read(info.filename).decode(\"utf-8\")\n        except Exception:\n            continue\n        raw_entries.append((safe_name, decoded))\n\n    if not raw_entries:\n        return {}\n\n    split_paths = [path.split(\"/\") for path, _ in raw_entries]\n    if split_paths and all(len(parts) > 1 for parts in split_paths):\n        first = split_paths[0][0]\n        if all(parts[0] == first for parts in split_paths):\n            return {\"/\".join(path.split(\"/\")[1:]): content for path, content in raw_entries}\n    return dict(raw_entries)\n\n\ndef _skip_bundle_workspace_path(path: str) -> bool:\n    safe = safe_relpath(path)\n    if safe is None:\n        return True\n    policy = default_context_graph_scan_policy()\n    name = PurePosixPath(safe).name.lower()\n    return (\n        is_excluded_source_directory_path(safe, policy=policy)\n        or is_sensitive_source_path(safe)\n        or name in policy.excluded_file_names\n        or \".min.\" in name\n    )\n\n\ndef read_bundle_zip(zip_path: Path) -> dict[str, str]:\n    with zipfile.ZipFile(zip_path, \"r\") as archive:\n        return _read_from_archive(archive)\n\n\ndef read_bundle_zip_bytes(data: bytes) -> dict[str, str]:\n    \"\"\"Read a bundle zip from raw bytes (e.g. retrieved from a content store).\"\"\"\n    with zipfile.ZipFile(io.BytesIO(data), \"r\") as archive:\n        return _read_from_archive(archive)\n\n\ndef siblings_for(*, path: str, file_map: dict[str, str], limit: int = 8) -> list[str]:\n    parent = str(PurePosixPath(path).parent)\n    if parent == \".\":\n        parent = \"\"\n    siblings = []\n    for candidate in sorted(file_map.keys()):\n        if candidate == path:\n            continue\n        candidate_parent = str(PurePosixPath(candidate).parent)\n        if candidate_parent == \".\":\n            candidate_parent = \"\"\n        if candidate_parent == parent:\n            siblings.append(candidate)\n    return siblings[:limit]\n\n\ndef resolve_related_imports(*, path: str, content: str, file_map: dict[str, str], limit: int = 8) -> list[str]:\n    if not content.strip():\n        return []\n    base_dir = PurePosixPath(path).parent\n    related: list[str] = []\n    for raw_import in extract_relative_imports(content):\n        for candidate in candidate_paths(base_dir=base_dir, import_path=raw_import):\n            if candidate in file_map and candidate not in related:\n                related.append(candidate)\n                break\n    return related[:limit]\n\n\ndef extract_relative_imports(content: str) -> list[str]:\n    patterns = [\n        re.compile(r\"\"\"from\\s+['\"](\\.[^'\"]+)['\"]\"\"\"),\n        re.compile(r\"\"\"import\\s+.*?\\s+from\\s+['\"](\\.[^'\"]+)['\"]\"\"\"),\n        re.compile(r\"\"\"require\\(\\s*['\"](\\.[^'\"]+)['\"]\\s*\\)\"\"\"),\n    ]\n    imports: list[str] = []\n    for pattern in patterns:\n        for match in pattern.findall(content):\n            candidate = str(match or \"\").strip()\n            if candidate and candidate not in imports:\n                imports.append(candidate)\n    return imports\n\n\ndef candidate_paths(*, base_dir: PurePosixPath, import_path: str) -> list[str]:\n    normalized_import = import_path.strip()\n    if not normalized_import.startswith(\".\"):\n        return []\n    candidates: list[str] = []\n    for suffix in _IMPORT_EXTENSIONS:\n        combined = (base_dir / f\"{normalized_import}{suffix}\").as_posix()\n        safe = safe_relpath(combined)\n        if safe and safe not in candidates:\n            candidates.append(safe)\n    return candidates"},{"checksum":"sha256:8a98cb270bed52429eb2a0da752ad39aab389b74d9ef7c85fe1ec8a82fe40d0e","chunk_id":"chunk_5cb66793eb5b61ea","end_line":84,"path":"refinement_harness/tools/_context_graph.py","start_line":1,"symbol_ids":["sym_39a1cc8575f6766f","sym_0c6fdd5e0971832d"],"text":"from __future__ import annotations\n\nfrom typing import Any\n\nfrom mozaiksai.control_plane.app_context import get_current_app_context_graph\nfrom mozaiksai.core.app_context.context_graph import (\n    merge_context_graphs,\n)\nfrom mozaiksai.core.app_context.indexer import index_file_map\nfrom mozaiksai.core.app_context.intelligence import build_app_intelligence_catalog\nfrom mozaiksai.core.app_context.source_corpus import build_source_corpus_catalog\nfrom mozaiksai.core.artifacts.store import ArtifactStore, get_artifact_store\n\nfrom ._artifact_workspace import load_artifact_workspace, safe_relpath\nfrom ._shared import normalize_context\n\n\nasync def load_context_graph_for_tool(\n    *,\n    context: Any = None,\n    artifact_store: ArtifactStore | None = None,\n) -> dict[str, Any]:\n    \"\"\"Load artifact workspace and merge current app-context graph with code graph.\"\"\"\n    tool_context = normalize_context(context)\n    app_id = str(tool_context.artifact_app_id or \"\").strip()\n    build_record_id = str(tool_context.build_record_id or \"\").strip()\n    if not app_id or not build_record_id:\n        return {\"present\": False, \"reason\": \"missing_app_id_or_build_record\"}\n\n    store = artifact_store or get_artifact_store()\n    workspace = await load_artifact_workspace(\n        artifact_store=store,\n        app_id=app_id,\n        build_record_id=build_record_id,\n    )\n    if not workspace.get(\"present\"):\n        return workspace\n\n    artifact = workspace[\"artifact\"]\n    indexed = index_file_map(\n        app_id=app_id,\n        file_map=workspace[\"file_map\"],\n        artifact_version_id=artifact.id,\n        artifact_kind=artifact.build_family,\n        artifact_key=artifact.build_key,\n        source=workspace.get(\"source\") or \"artifact_workspace\",\n    )\n    current_graph_lookup = await get_current_app_context_graph(\n        app_id=app_id,\n        artifact_store=store,\n    )\n    merged_graph = merge_context_graphs(\n        app_id=app_id,\n        graph_id=f\"context_graph:{app_id}:{artifact.id}\",\n        graphs=[current_graph_lookup.graph, indexed.app_context_graph],\n    )\n\n    return {\n        \"present\": True,\n        \"artifact\": artifact,\n        \"file_map\": indexed.safe_file_map,\n        \"source_context_bundle\": indexed.source_corpus,\n        \"source_context_catalog\": build_source_corpus_catalog(indexed.source_corpus, max_files=40, max_chunks=8),\n        \"app_intelligence_snapshot\": indexed.app_intelligence_snapshot,\n        \"app_intelligence_catalog\": build_app_intelligence_catalog(indexed.app_intelligence_snapshot, max_items=24),\n        \"workspace\": {\n            **workspace,\n            \"scan_health\": indexed.scan_health,\n            \"context_graph_health_report\": indexed.health_report,\n        },\n        \"graph\": merged_graph,\n        \"warnings\": [*list(current_graph_lookup.warnings), *list(indexed.scan_result.warnings)],\n    }\n\n\ndef normalize_selected_paths(value: Any) -> list[str]:\n    if not isinstance(value, list):\n        return []\n    selected: list[str] = []\n    for item in value:\n        safe = safe_relpath(item)\n        if safe and safe not in selected:\n            selected.append(safe)\n    return selected"},{"checksum":"sha256:c6d1f7659cfada994e42dd62f595528ac296422312e0da0e42d3993dd51a8f92","chunk_id":"chunk_147ae6f6861b08b9","end_line":234,"path":"refinement_harness/tools/_module_inventory.py","start_line":1,"symbol_ids":["sym_7798b01bfb9cda34","sym_729f7c92673ff904","sym_b999726eb0e8c89b","sym_e6f29cd2646cfd99","sym_2b2dfee0a16969ff"],"text":"\"\"\"\nDeterministic module inventory extractor and carry-forward classifier.\n\nThis utility is **read-only**. It consumes a ``file_map`` as returned by\n:func:`factory_app.refinement_harness.tools._artifact_workspace.load_artifact_workspace`\nand produces structured inventory entries for every module found in the map,\nincluding an advisory carry-forward reuse-fit classification.\n\nIntended use:\n- ``conceptual_replan`` carry-forward analysis.\n- Populating the ``carry_forward_modules`` context seed for AppPlanAgent.\n\nThis module does NOT decide what to carry forward, does NOT copy or merge files,\nand has NO filesystem, database, or LLM access.\n\nClassification is deterministic and conservative:\n\n- ``safe_carry_forward``: module_id matches a known generic/infrastructure module\n  list, or has infrastructure-only signals with no persistence or domain markers.\n- ``needs_adaptation``: module has persistence, admin panels, reactions, runtime\n  extensions, or domain events that may not fit the new concept \u2014 review required.\n- ``regenerate``: module_id contains a domain-specific fragment that strongly\n  implies it was built for the old concept and should not be blindly preserved.\n\nAppPlanAgent is still the final planner. Classification is advisory only.\n\"\"\"\nfrom __future__ import annotations\n\nimport logging\nfrom typing import Any, Literal\n\nimport yaml\nfrom pydantic import BaseModel, Field\n\nlogger = logging.getLogger(__name__)\n\n# ---------------------------------------------------------------------------\n# Classification constants\n# ---------------------------------------------------------------------------\n\n# Module IDs that are generic/infrastructure across most app concepts.\n# These are exact matches against module_id.lower().\n_SAFE_MODULE_IDS: frozenset[str] = frozenset({\n    \"settings\",\n    \"preferences\",\n    \"notifications\",\n    \"files\",\n    \"media\",\n    \"audit\",\n    \"activity\",\n    \"auth\",\n    \"profile\",\n    \"users\",\n    \"organizations\",\n    \"teams\",\n    \"billing_portal\",\n    \"integrations\",\n})\n\n# Substrings that strongly signal a domain-specific module.\n# Checked as substring matches against module_id.lower() so that\n# \"projects\", \"task_list\", \"lead_tracker\" etc. are all caught.\n_DOMAIN_FRAGMENTS: frozenset[str] = frozenset({\n    \"crm\",\n    \"lead\",\n    \"deal\",\n    \"pipeline\",\n    \"listing\",\n    \"order\",\n    \"product\",\n    \"booking\",\n    \"campaign\",\n    \"invoice\",\n    \"ticket\",\n    \"project\",\n    \"task\",\n})\n\n# CRUD verbs that appear in entity-specific action IDs.\n_CRUD_VERBS: frozenset[str] = frozenset({\n    \"create\",\n    \"list\",\n    \"get\",\n    \"update\",\n    \"delete\",\n    \"remove\",\n    \"archive\",\n})\n\n# ---------------------------------------------------------------------------\n# Model\n# ---------------------------------------------------------------------------\n\nclass ModuleInventoryEntry(BaseModel):\n    \"\"\"Structured representation of a single module found in an app-bundle file_map.\"\"\"\n\n    module_id: str = Field(description=\"Module directory name under modules/. Source of truth is the path, not module.yaml id.\")\n\n    # Action contract\n    action_ids: list[str] = Field(default_factory=list, description=\"Action ids declared in module.yaml actions[].id.\")\n\n    # Persistence signal\n    has_persistence: bool = Field(\n        default=False,\n        description=(\n            \"True if backend/repo.py exists (canonical persistence layer), \"\n            \"OR if any action in module.yaml has a persistence-signalling field.\"\n        ),\n    )\n\n    # Convenience backend file flags\n    has_handler: bool = Field(default=False, description=\"True if backend/handler.py exists.\")\n    has_service: bool = Field(default=False, description=\"True if backend/service.py exists.\")\n    has_repo: bool = Field(default=False, description=\"True if backend/repo.py exists.\")\n    has_policy: bool = Field(default=False, description=\"True if backend/policy.py exists.\")\n\n    # Event contract\n    event_types: list[str] = Field(\n        default_factory=list,\n        description=(\n            \"Event type strings extracted from contracts/events.yaml. \"\n            \"Supports 'type', 'event_type', and 'id' field names defensively.\"\n        ),\n    )\n\n    # Contract presence flags\n    has_reactions: bool = Field(default=False, description=\"True if contracts/reactions.yaml exists.\")\n    has_notifications: bool = Field(default=False, description=\"True if contracts/notifications.yaml exists.\")\n    has_policy_hooks: bool = Field(default=False, description=\"True if contracts/policy_hooks.yaml exists.\")\n    has_settings: bool = Field(default=False, description=\"True if contracts/settings.yaml exists.\")\n    has_admin: bool = Field(default=False, description=\"True if contracts/admin.yaml exists.\")\n    has_profile: bool = Field(default=False, description=\"True if contracts/profile.yaml exists.\")\n    has_relationships: bool = Field(default=False, description=\"True if contracts/relationships.yaml exists.\")\n    has_runtime_extensions: bool = Field(default=False, description=\"True if runtime_extensions.yaml exists at the module root.\")\n\n    # File lists (relative paths as they appear in the file_map)\n    backend_files: list[str] = Field(default_factory=list, description=\".py files under modules/{id}/backend/.\")\n    contract_files: list[str] = Field(default_factory=list, description=\".yaml files under modules/{id}/contracts/.\")\n\n    # Carry-forward reuse-fit classification (deterministic, advisory)\n    carry_forward_classification: Literal[\"safe_carry_forward\", \"needs_adaptation\", \"regenerate\"] = Field(\n        default=\"needs_adaptation\",\n        description=(\n            \"Deterministic advisory classification for carry-forward analysis. \"\n            \"safe_carry_forward: known generic/infrastructure module. \"\n            \"needs_adaptation: may be reusable but has persistence, admin, reactions, or events to review. \"\n            \"regenerate: domain-specific to the old concept; should not be blindly preserved. \"\n            \"AppPlanAgent is the final planner \u2014 this classification is advisory only.\"\n        ),\n    )\n    carry_forward_reasons: list[str] = Field(\n        default_factory=list,\n        description=\"Human-readable reasons for the carry_forward_classification.\",\n    )\n\n\n# ---------------------------------------------------------------------------\n# Extraction helpers\n# ---------------------------------------------------------------------------\n\ndef _parse_yaml_safe(content: str, label: str) -> Any:\n    \"\"\"Parse YAML content, returning None on any error.\"\"\"\n    try:\n        return yaml.safe_load(content)\n    except Exception as exc:\n        logger.debug(\"_module_inventory: failed to parse %s: %s\", label, exc)\n        return None\n\n\ndef _extract_action_ids(module_doc: Any) -> list[str]:\n    \"\"\"Return action ids from a parsed module.yaml document.\"\"\"\n    if not isinstance(module_doc, dict):\n        return []\n    actions = module_doc.get(\"actions\") or []\n    if not isinstance(actions, list):\n        return []\n    ids: list[str] = []\n    for action in actions:\n        if not isinstance(action, dict):\n            continue\n        action_id = action.get(\"id\")\n        if isinstance(action_id, str) and action_id.strip():\n            ids.append(action_id.strip())\n    return ids\n\n\ndef _has_persistence_signal(module_doc: Any) -> bool:\n    \"\"\"Return True if any action declares an 'emits' field (persistence-adjacent signal).\n\n    This is a heuristic only \u2014 the definitive persistence signal is the presence\n    of backend/repo.py, checked separately.\n    \"\"\"\n    if not isinstance(module_doc, dict):\n        return False\n    actions = module_doc.get(\"actions\") or []\n    if not isinstance(actions, list):\n        return False\n    for action in actions:\n        if not isinstance(action, dict):\n            continue\n        # 'emits' on an action is a reliable signal of state mutation\n        emits = action.get(\"emits\")\n        if emits:\n            return True\n    return False\n\n\ndef _extract_event_types(events_content: str, label: str) -> list[str]:\n    \"\"\"Extract event type strings from contracts/events.yaml content.\n\n    Defensively supports 'type', 'event_type', and 'id' field names.\n    Returns an empty list on any parse failure.\n    \"\"\"\n    doc = _parse_yaml_safe(events_content, label)\n    if not isinstance(doc, dict):\n        return []\n    events = doc.get(\"events\") or []\n    if not isinstance(events, list):\n        return []\n    types: list[str] = []\n    for event in events:\n        if not isinstance(event, dict):\n            continue\n        # Prefer 'type', fall back to 'event_type', then 'id'\n        value = event.get(\"type\") or event.get(\"event_type\") or event.get(\"id\")\n        if isinstance(value, str) and value.strip():\n            types.append(value.strip())\n    return types\n\n\n# ---------------------------------------------------------------------------\n# Classification\n# ---------------------------------------------------------------------------\n"},{"checksum":"sha256:0ab57771ddacc0525174c9cf2dc1ceaf46c33a1274d81374840e9148b5103d9a","chunk_id":"chunk_7e278429c2e6fda8","end_line":425,"path":"refinement_harness/tools/_module_inventory.py","start_line":235,"symbol_ids":["sym_27325ffdcaaef506","sym_4b9be15c8cd75374","sym_f12cbb89cb0a34e7"],"text":"def classify_module_carry_forward(entry: ModuleInventoryEntry) -> tuple[str, list[str]]:\n    \"\"\"Return (classification, reasons) for a ModuleInventoryEntry.\n\n    Classification is deterministic and conservative:\n\n    Priority (highest to lowest):\n    1. **regenerate** \u2014 module_id contains a known domain-specific fragment.\n    2. **safe_carry_forward** \u2014 module_id is in the known generic module list,\n       OR the module has infrastructure-only signals (settings/notifications/\n       profile) with no persistence and no domain markers.\n    3. **needs_adaptation** \u2014 default; module has state, admin, reactions,\n       events, or CRUD-heavy actions that need review against the new concept.\n\n    Returns:\n        A tuple of (classification_str, reasons_list). Both are non-empty.\n        AppPlanAgent is the final planner; this output is advisory only.\n    \"\"\"\n    reasons: list[str] = []\n    module_id_lower = entry.module_id.lower()\n\n    # --- 1. Regenerate: domain-specific module_id fragments ---\n    matched_fragments = [f for f in _DOMAIN_FRAGMENTS if f in module_id_lower]\n    if matched_fragments:\n        for fragment in sorted(matched_fragments):\n            reasons.append(\n                f\"module_id '{entry.module_id}' contains domain-specific fragment '{fragment}'\"\n            )\n        if entry.has_persistence:\n            reasons.append(\"has_persistence=True reinforces domain-specific classification\")\n        crud_count = _crud_action_count(entry.action_ids)\n        if entry.action_ids and crud_count >= max(2, len(entry.action_ids) // 2):\n            reasons.append(\n                f\"{crud_count}/{len(entry.action_ids)} actions are CRUD-style on a domain entity\"\n            )\n        return \"regenerate\", reasons\n\n    # --- 2. Safe: known generic/infrastructure module ID ---\n    if module_id_lower in _SAFE_MODULE_IDS:\n        reasons.append(\n            f\"module_id '{entry.module_id}' matches known generic infrastructure module\"\n        )\n        if entry.has_settings:\n            reasons.append(\"has_settings=True: module manages cross-concept preferences\")\n        if entry.has_notifications:\n            reasons.append(\"has_notifications=True: notification delivery is concept-independent\")\n        if entry.has_profile:\n            reasons.append(\"has_profile=True: user profile surface is generic across concepts\")\n        if entry.has_relationships:\n            reasons.append(\"has_relationships=True: current-user resource relationships are generic across concepts\")\n        if entry.has_policy_hooks:\n            reasons.append(\"has_policy_hooks=True: policy hook declarations are generic across concepts\")\n        if entry.has_persistence:\n            reasons.append(\n                \"has_persistence=True: state exists but module is known-safe; \"\n                \"review schema fit if concept data model changes significantly\"\n            )\n        return \"safe_carry_forward\", reasons\n\n    # --- 2b. Safe: infrastructure-only signals, no domain markers ---\n    infra_signals = []\n    if entry.has_settings and not entry.has_persistence:\n        infra_signals.append(\"has_settings=True with no persistence: settings-only module\")\n    if entry.has_notifications and not entry.has_persistence:\n        infra_signals.append(\"has_notifications=True with no persistence: delivery-only module\")\n    if entry.has_profile and not entry.has_persistence:\n        infra_signals.append(\"has_profile=True with no persistence: display-only profile surface\")\n    if entry.has_relationships and not entry.has_persistence:\n        infra_signals.append(\"has_relationships=True with no persistence: display-only relationship surface\")\n    if entry.has_policy_hooks and not entry.has_persistence:\n        infra_signals.append(\"has_policy_hooks=True with no persistence: policy-hook declaration only\")\n\n    if infra_signals and not entry.has_admin and not entry.has_reactions and not entry.event_types:\n        reasons.extend(infra_signals)\n        reasons.append(\"no admin, reactions, or events: module is infrastructure-facing only\")\n        return \"safe_carry_forward\", reasons\n\n    # --- 3. needs_adaptation: mixed or unknown signals ---\n    if entry.has_persistence:\n        reasons.append(\n            \"has_persistence=True: module state must be reviewed against the new concept's domain model\"\n        )\n    if entry.has_admin:\n        reasons.append(\"has_admin=True: admin panel contract is concept-adjacent and may need revision\")\n    if entry.has_reactions:\n        reasons.append(\"has_reactions=True: cross-module reactions may not apply in the new concept\")\n    if entry.has_runtime_extensions:\n        reasons.append(\n            \"has_runtime_extensions=True: runtime API registration may need concept-level revision\"\n        )\n    if entry.event_types:\n        reasons.append(\n            f\"publishes {len(entry.event_types)} domain event type(s): \"\n            \"event contracts must be validated against the new concept\"\n        )\n\n    crud_count = _crud_action_count(entry.action_ids)\n    if entry.action_ids and crud_count >= max(2, len(entry.action_ids) // 2):\n        reasons.append(\n            f\"{crud_count}/{len(entry.action_ids)} actions are CRUD-style: \"\n            \"likely entity-specific; confirm entity still exists in new concept\"\n        )\n\n    if not reasons:\n        reasons.append(\n            \"no strong safe or domain-specific signals detected; \"\n            \"conservative default: review before reusing\"\n        )\n\n    return \"needs_adaptation\", reasons\n\n\ndef _crud_action_count(action_ids: list[str]) -> int:\n    \"\"\"Return the count of action ids containing standard CRUD verbs.\"\"\"\n    return sum(\n        1 for aid in action_ids\n        if any(verb in aid.lower() for verb in _CRUD_VERBS)\n    )\n\n\n# ---------------------------------------------------------------------------\n# Public API\n# ---------------------------------------------------------------------------\n\ndef extract_module_inventory(file_map: dict[str, str]) -> list[ModuleInventoryEntry]:\n    \"\"\"Extract structured module inventory from an app-bundle file_map.\n\n    The ``file_map`` is expected to be the output of\n    :func:`factory_app.refinement_harness.tools._artifact_workspace.load_artifact_workspace`\n    \u2014 a ``{relative_path: content}`` dict where paths use forward slashes.\n\n    Modules are identified by the presence of ``modules/{module_id}/module.yaml``.\n    The module_id is taken from the path, not from the YAML content.\n\n    Behavior:\n    - Invalid ``module.yaml`` (unparseable or wrong type) produces a minimal\n      entry with empty action_ids and has_persistence=False rather than skipping.\n    - Invalid ``contracts/events.yaml`` produces an empty event_types list.\n    - Files outside ``modules/`` are ignored.\n    - The input ``file_map`` is never mutated.\n    - Returns entries sorted by module_id.\n    \"\"\"\n    # Collect all module_ids that have a module.yaml\n    module_ids: set[str] = set()\n    for path in file_map:\n        parts = path.split(\"/\")\n        # Expected: modules/{module_id}/module.yaml\n        if len(parts) == 3 and parts[0] == \"modules\" and parts[2] == \"module.yaml\":\n            module_id = parts[1]\n            if module_id:\n                module_ids.add(module_id)\n\n    entries: list[ModuleInventoryEntry] = []\n\n    for module_id in sorted(module_ids):\n        prefix = f\"modules/{module_id}/\"\n        contracts_prefix = f\"{prefix}contracts/\"\n        backend_prefix = f\"{prefix}backend/\"\n\n        # --- Parse module.yaml ---\n        module_yaml_key = f\"{prefix}module.yaml\"\n        module_content = file_map.get(module_yaml_key, \"\")\n        module_doc = _parse_yaml_safe(module_content, module_yaml_key)\n\n        action_ids = _extract_action_ids(module_doc)\n        yaml_persistence_signal = _has_persistence_signal(module_doc)\n\n        # --- Backend files ---\n        backend_files = sorted(\n            path for path in file_map\n            if path.startswith(backend_prefix) and path.endswith(\".py\")\n        )\n\n        has_handler = f\"{backend_prefix}handler.py\" in file_map\n        has_service = f\"{backend_prefix}service.py\" in file_map\n        has_repo = f\"{backend_prefix}repo.py\" in file_map\n        has_policy = f\"{backend_prefix}policy.py\" in file_map\n\n        # Persistence: repo.py is the definitive signal; yaml_persistence_signal is advisory\n        has_persistence = has_repo or yaml_persistence_signal\n\n        # --- Contract files ---\n        contract_files = sorted(\n            path for path in file_map\n            if path.startswith(contracts_prefix) and path.endswith(\".yaml\")\n        )\n\n        has_reactions = f\"{contracts_prefix}reactions.yaml\" in file_map\n        has_notifications = f\"{contracts_prefix}notifications.yaml\" in file_map\n        has_policy_hooks = f\"{contracts_prefix}policy_hooks.yaml\" in file_map\n        has_settings = f\"{contracts_prefix}settings.yaml\" in file_map\n        has_admin = f\"{contracts_prefix}admin.yaml\" in file_map"},{"checksum":"sha256:ef5b9624d2d13bf5d0f267d7fff0f1c22771d03ef66ee56ae1cdc26e8b84a90a","chunk_id":"chunk_65144e393cc03092","end_line":472,"path":"refinement_harness/tools/_module_inventory.py","start_line":426,"symbol_ids":["sym_f12cbb89cb0a34e7"],"text":"        has_profile = f\"{contracts_prefix}profile.yaml\" in file_map\n        has_relationships = f\"{contracts_prefix}relationships.yaml\" in file_map\n\n        # --- Runtime extensions ---\n        has_runtime_extensions = f\"{prefix}runtime_extensions.yaml\" in file_map\n\n        # --- Events ---\n        events_key = f\"{contracts_prefix}events.yaml\"\n        event_types: list[str] = []\n        if events_key in file_map:\n            event_types = _extract_event_types(file_map[events_key], events_key)\n\n        # Build a partial entry for classification (classification depends on\n        # the fully assembled inventory signals, so we classify after the entry\n        # is assembled with defaults and then create the final object).\n        _partial = ModuleInventoryEntry(\n            module_id=module_id,\n            action_ids=action_ids,\n            has_persistence=has_persistence,\n            has_handler=has_handler,\n            has_service=has_service,\n            has_repo=has_repo,\n            has_policy=has_policy,\n            event_types=event_types,\n            has_reactions=has_reactions,\n            has_notifications=has_notifications,\n            has_policy_hooks=has_policy_hooks,\n            has_settings=has_settings,\n            has_admin=has_admin,\n            has_profile=has_profile,\n            has_relationships=has_relationships,\n            has_runtime_extensions=has_runtime_extensions,\n            backend_files=backend_files,\n            contract_files=contract_files,\n        )\n        classification, reasons = classify_module_carry_forward(_partial)\n\n        entries.append(\n            _partial.model_copy(\n                update={\n                    \"carry_forward_classification\": classification,\n                    \"carry_forward_reasons\": reasons,\n                }\n            )\n        )\n\n    return entries"},{"checksum":"sha256:072a7bc6657d786c5b1fb42b398ed025d1a7741fb14e254efa2dfde8f60deb60","chunk_id":"chunk_53a4b671914011aa","end_line":26,"path":"refinement_harness/tools/_shared.py","start_line":1,"symbol_ids":["sym_5d522deb6e4b0059","sym_2aad7cb78dadc8cb","sym_a989bdd7dbf23bab"],"text":"from __future__ import annotations\n\nfrom typing import Any\n\nfrom mozaiksai.control_plane.contracts import ControlPlaneToolContext\n\n\ndef normalize_context(context: ControlPlaneToolContext | dict[str, Any] | None) -> ControlPlaneToolContext:\n    if isinstance(context, ControlPlaneToolContext):\n        return context\n    return ControlPlaneToolContext.model_validate(dict(context or {}))\n\n\ndef text_excerpt(value: Any, *, max_length: int = 400) -> str | None:\n    text = str(value or \"\").strip()\n    if not text:\n        return None\n    if len(text) <= max_length:\n        return text\n    return text[: max_length - 3].rstrip() + \"...\"\n\n\ndef list_head(values: Any, *, limit: int = 8) -> list[Any]:\n    if not isinstance(values, list):\n        return []\n    return list(values[:limit])"},{"checksum":"sha256:6d27868572b6666236146081a81007bacd9abf7810ea5d0e8c8888c14947d7c6","chunk_id":"chunk_98ce00338a88da1a","end_line":101,"path":"refinement_harness/tools/app_intelligence.py","start_line":1,"symbol_ids":["sym_dfc096f0917ca7f6","sym_0b4af5f1402adcfc","sym_3936b6aa3363d47b"],"text":"from __future__ import annotations\n\nfrom typing import Any\n\nfrom mozaiksai.control_plane.app_context import get_current_app_intelligence_snapshot\nfrom mozaiksai.control_plane.contracts import ControlPlaneToolContext\nfrom mozaiksai.core.app_context import (\n    AppIntelligenceSnapshot,\n    build_app_intelligence_catalog,\n    search_app_intelligence_snapshot,\n)\nfrom mozaiksai.core.artifacts.store import ArtifactStore\n\nfrom ._context_graph import load_context_graph_for_tool\nfrom ._shared import normalize_context\n\n\nasync def get_app_intelligence_context(\n    *,\n    query: str | None = None,\n    max_results: int = 12,\n    context: ControlPlaneToolContext | dict[str, Any] | None = None,\n    artifact_store: ArtifactStore | None = None,\n) -> dict[str, Any]:\n    \"\"\"Return compact App Intelligence for refinement planning.\"\"\"\n    tool_context = normalize_context(context)\n    loaded = await _load_app_intelligence_snapshot(\n        tool_context=tool_context,\n        artifact_store=artifact_store,\n    )\n    if not loaded.get(\"present\"):\n        return {**loaded, \"results\": []}\n\n    snapshot = loaded[\"snapshot\"]\n    resolved_query = str(query or tool_context.raw_user_request or \"\").strip()\n    return {\n        \"present\": True,\n        \"source\": loaded[\"source\"],\n        \"app_intelligence_catalog\": build_app_intelligence_catalog(snapshot),\n        \"results\": (\n            search_app_intelligence_snapshot(\n                snapshot,\n                resolved_query,\n                max_results=_bounded_int(max_results, default=12, minimum=1, maximum=40),\n            )\n            if resolved_query\n            else []\n        ),\n        \"query\": resolved_query or None,\n        \"warnings\": list(loaded.get(\"warnings\") or []),\n    }\n\n\nasync def _load_app_intelligence_snapshot(\n    *,\n    tool_context: ControlPlaneToolContext,\n    artifact_store: ArtifactStore | None,\n) -> dict[str, Any]:\n    app_id = str(tool_context.artifact_app_id or \"\").strip()\n    if not app_id:\n        return {\"present\": False, \"reason\": \"missing_app_id\", \"warnings\": []}\n\n    current = await get_current_app_intelligence_snapshot(\n        app_id=app_id,\n        artifact_store=artifact_store,\n    )\n    if current.snapshot is not None:\n        return {\n            \"present\": True,\n            \"source\": \"current_app_context\",\n            \"snapshot\": current.snapshot,\n            \"warnings\": list(current.warnings),\n        }\n\n    if str(tool_context.build_record_id or \"\").strip():\n        loaded = await load_context_graph_for_tool(context=tool_context, artifact_store=artifact_store)\n        snapshot = loaded.get(\"app_intelligence_snapshot\")\n        if loaded.get(\"present\") and isinstance(snapshot, AppIntelligenceSnapshot):\n            return {\n                \"present\": True,\n                \"source\": loaded[\"workspace\"].get(\"source\") or \"artifact_workspace\",\n                \"snapshot\": snapshot,\n                \"warnings\": [*list(current.warnings), *list(loaded.get(\"warnings\") or [])],\n            }\n\n    return {\n        \"present\": False,\n        \"reason\": \"app_intelligence_snapshot_unavailable\",\n        \"warnings\": list(current.warnings),\n    }\n\n\ndef _bounded_int(value: Any, *, default: int, minimum: int, maximum: int) -> int:\n    try:\n        parsed = int(value)\n    except Exception:\n        parsed = default\n    return max(minimum, min(maximum, parsed))\n\n\n__all__ = [\"get_app_intelligence_context\"]"},{"checksum":"sha256:9028163629b72e4ffd890e886c2b6406a747da91b51ca1c9c96922ac6851e6ce","chunk_id":"chunk_bc9ce1e9cb238ef2","end_line":48,"path":"refinement_harness/tools/app_validation.py","start_line":1,"symbol_ids":["sym_0bf10987610c8360"],"text":"from __future__ import annotations\n\nfrom typing import Any\n\nfrom mozaiksai.control_plane.app_validation import run_current_app_source_validation\nfrom mozaiksai.control_plane.contracts import ControlPlaneToolContext\nfrom mozaiksai.core.artifacts.store import ArtifactStore\n\nfrom ._shared import normalize_context\n\n\nasync def run_app_source_validation(\n    *,\n    allowed_kinds: list[str] | None = None,\n    include_install: bool = False,\n    max_commands: int = 4,\n    timeout_seconds: int = 120,\n    confirm_execution: bool = False,\n    context: ControlPlaneToolContext | dict[str, Any] | None = None,\n    artifact_store: ArtifactStore | None = None,\n) -> dict[str, Any]:\n    \"\"\"Run framework-aware validation for the current App Intelligence source.\"\"\"\n    tool_context = normalize_context(context)\n    app_id = str(tool_context.artifact_app_id or \"\").strip()\n    if not app_id:\n        return {\n            \"present\": False,\n            \"reason\": \"missing_app_id\",\n            \"validation_status\": \"skipped\",\n            \"warnings\": [\"App source validation requires app_id.\"],\n        }\n\n    result = await run_current_app_source_validation(\n        app_id=app_id,\n        artifact_store=artifact_store,\n        allowed_kinds=allowed_kinds,\n        include_install=include_install,\n        max_commands=max_commands,\n        timeout_seconds=timeout_seconds,\n        confirm_execution=confirm_execution,\n    )\n    return {\n        \"present\": True,\n        \"validation\": result.model_dump(mode=\"json\"),\n    }\n\n\n__all__ = [\"run_app_source_validation\"]"},{"checksum":"sha256:a0f8d6807ccfdbab080348a015fde6b6969e608e5139cf7fac60afa770f1e830","chunk_id":"chunk_c0505aa5854e458d","end_line":67,"path":"refinement_harness/tools/get_artifact_summary.py","start_line":1,"symbol_ids":["sym_52a075b3b0cace14"],"text":"from __future__ import annotations\n\nfrom typing import Any\n\nfrom mozaiksai.control_plane.contracts import ControlPlaneToolContext\nfrom mozaiksai.core.artifacts.store import BuildRecordStore, get_build_record_store\n\nfrom ._shared import normalize_context\n\n\nasync def get_artifact_summary(\n    *,\n    context: ControlPlaneToolContext | dict[str, Any] | None = None,\n    artifact_store: BuildRecordStore | None = None,\n) -> dict[str, Any]:\n    tool_context = normalize_context(context)\n    app_id = str(tool_context.artifact_app_id or \"\").strip()\n    if not app_id:\n        return {\"present\": False, \"reason\": \"missing_app_id\"}\n\n    store = artifact_store or get_build_record_store()\n    build_record = None\n    if tool_context.build_record_id:\n        build_record = await store.get_build_record(\n            app_id=app_id,\n            build_record_id=str(tool_context.build_record_id),\n        )\n    elif tool_context.build_family:\n        records = await store.list_build_records(\n            app_id=app_id,\n            build_family=str(tool_context.build_family),\n            build_key=str(tool_context.build_key or \"\").strip() or None,\n            limit=1,\n        )\n        build_record = records[0] if records else None\n\n    if build_record is None:\n        return {\n            \"present\": False,\n            \"app_id\": app_id,\n            \"build_family\": tool_context.build_family,\n            \"build_key\": tool_context.build_key,\n            \"build_record_id\": tool_context.build_record_id,\n        }\n\n    recent_changes = await store.list_change_requests(\n        app_id=app_id,\n        build_record_id=build_record.id,\n        limit=5,\n    )\n    return {\n        \"present\": True,\n        \"app_id\": app_id,\n        \"build_record_id\": build_record.id,\n        \"build_family\": build_record.build_family,\n        \"build_key\": build_record.build_key,\n        \"version_number\": build_record.version_number,\n        \"lineage_root_id\": build_record.lineage_root_id,\n        \"parent_version_id\": build_record.parent_version_id,\n        \"lifecycle_status\": build_record.lifecycle_status.value,\n        \"validation_status\": build_record.validation_status.value,\n        \"source_workflow\": build_record.source_workflow,\n        \"files_count\": len(build_record.files_manifest or []),\n        \"canonical_inputs_version\": dict(build_record.canonical_inputs_version or {}),\n        \"recent_change_classes\": [change.classification.value for change in recent_changes],\n        \"updated_at\": build_record.updated_at,\n    }"},{"checksum":"sha256:1c30fc9bdb24f1af26fda0d7be884b63ace4cca1cab8c069d6bc3a42fcb8f7bf","chunk_id":"chunk_f993c701e116a0d4","end_line":151,"path":"refinement_harness/tools/get_artifact_workspace_catalog.py","start_line":1,"symbol_ids":["sym_7eeec2943ae21624","sym_2ac0a7eb093a69dc","sym_7dad9cd570ecef2e","sym_37d6ff7870c1564c","sym_00bfaa546c56652d"],"text":"from __future__ import annotations\n\nimport re\nfrom collections import Counter\nfrom typing import Any\n\nfrom mozaiksai.control_plane.contracts import ControlPlaneToolContext\nfrom mozaiksai.core.artifacts.store import ArtifactStore, get_artifact_store\n\nfrom ._artifact_workspace import load_artifact_workspace, safe_relpath\nfrom ._shared import list_head, normalize_context, text_excerpt\n\n_MAX_FILE_COUNT = 160\n_MAX_MATCH_COUNT = 12\n_MAX_DIR_COUNT = 12\n_STOPWORDS = {\n    \"the\",\n    \"and\",\n    \"for\",\n    \"with\",\n    \"that\",\n    \"this\",\n    \"from\",\n    \"into\",\n    \"your\",\n    \"when\",\n    \"then\",\n    \"just\",\n    \"have\",\n    \"will\",\n    \"want\",\n    \"needs\",\n    \"need\",\n    \"make\",\n    \"change\",\n    \"update\",\n    \"add\",\n    \"fix\",\n    \"file\",\n    \"files\",\n    \"page\",\n    \"component\",\n}\n\n\nasync def get_artifact_workspace_catalog(\n    *,\n    context: ControlPlaneToolContext | dict[str, Any] | None = None,\n    artifact_store: ArtifactStore | None = None,\n) -> dict[str, Any]:\n    tool_context = normalize_context(context)\n    app_id = str(tool_context.artifact_app_id or \"\").strip()\n    build_record_id = str(tool_context.build_record_id or \"\").strip()\n    if not app_id or not build_record_id:\n        return {\"present\": False, \"reason\": \"missing_app_id_or_build_record\"}\n\n    store = artifact_store or get_artifact_store()\n    workspace = await load_artifact_workspace(\n        artifact_store=store,\n        app_id=app_id,\n        build_record_id=build_record_id,\n    )\n    if not workspace.get(\"present\"):\n        return workspace\n\n    artifact = workspace[\"artifact\"]\n    file_map = workspace[\"file_map\"]\n    file_tree = sorted(file_map.keys())\n    keywords = _keywords(tool_context.raw_user_request)\n    matches = _rank_matches(file_map=file_map, keywords=keywords)\n    selected_paths = _normalize_selected_paths(tool_context.extra.get(\"selected_file_paths\"))\n\n    return {\n        \"present\": True,\n        \"build_record_id\": artifact.id,\n        \"build_family\": artifact.build_family,\n        \"build_key\": artifact.build_key,\n        \"source\": workspace[\"source\"],\n        \"file_count\": len(file_tree),\n        \"file_tree\": list_head(file_tree, limit=_MAX_FILE_COUNT),\n        \"directory_summary\": _directory_summary(file_tree),\n        \"request_keywords\": keywords,\n        \"selected_file_paths\": selected_paths,\n        \"matches\": matches,\n    }\n\n\ndef _normalize_selected_paths(value: Any) -> list[str]:\n    if not isinstance(value, list):\n        return []\n    selected: list[str] = []\n    for item in value:\n        safe = safe_relpath(item)\n        if safe and safe not in selected:\n            selected.append(safe)\n    return selected\n\n\ndef _keywords(raw_request: str) -> list[str]:\n    tokens = [REDACTED]\"[a-zA-Z][a-zA-Z0-9_]{2,}\", str(raw_request or \"\").lower())\n    keywords: list[str] = []\n    for token in tokens:\n        if token in _STOPWORDS:\n            continue\n        if token not in keywords:\n            keywords.append(token)\n    return keywords[:12]\n\n\ndef _rank_matches(*, file_map: dict[str, str], keywords: list[str]) -> list[dict[str, Any]]:\n    if not keywords:\n        return []\n\n    ranked: list[tuple[int, dict[str, Any]]] = []\n    for path, content in file_map.items():\n        path_lower = path.lower()\n        content_lower = content.lower()\n        path_hits = [REDACTED] for token in keywords if token in path_lower]\n        content_hits = [REDACTED] for token in keywords if token in content_lower]\n        score = len(path_hits) * 5 + len(content_hits)\n        if score <= 0:\n            continue\n        ranked.append(\n            (\n                score,\n                {\n                    \"path\": path,\n                    \"score\": score,\n                    \"path_hits\": path_hits,\n                    \"content_hits\": content_hits,\n                    \"excerpt\": text_excerpt(content, max_length=300),\n                },\n            )\n        )\n\n    ranked.sort(key=lambda item: (-item[0], item[1][\"path\"]))\n    return [entry for _, entry in ranked[:_MAX_MATCH_COUNT]]\n\n\ndef _directory_summary(file_tree: list[str]) -> list[dict[str, Any]]:\n    counter: Counter[str] = Counter()\n    for path in file_tree:\n        parts = str(path).split(\"/\")\n        directory = \"/\".join(parts[:2]) if len(parts) >= 2 else (parts[0] if parts else \"\")\n        if directory:\n            counter[directory] += 1\n    rows = [\n        {\"directory\": directory, \"file_count\": count}\n        for directory, count in counter.most_common(_MAX_DIR_COUNT)\n    ]\n    return rows"},{"checksum":"sha256:33cfa38c2c2efc567d2d0ee11a5245158f3a42e58d5936d80f0ac931c1940280","chunk_id":"chunk_a53fba4c9bcf6af2","end_line":111,"path":"refinement_harness/tools/get_artifact_workspace_scope.py","start_line":1,"symbol_ids":["sym_18a8864ba8e51160","sym_cc2728cf4b1a297f","sym_dbf064349a502ee2","sym_4adabafd83af42b7"],"text":"from __future__ import annotations\n\nfrom typing import Any\n\nfrom mozaiksai.control_plane.contracts import ControlPlaneToolContext\nfrom mozaiksai.core.artifacts.store import ArtifactStore, get_artifact_store\n\nfrom ._artifact_workspace import (\n    load_artifact_workspace,\n    resolve_related_imports,\n    safe_relpath,\n    siblings_for,\n)\nfrom ._shared import list_head, normalize_context, text_excerpt\n\n_MAX_FILE_COUNT = 120\n_MAX_PREVIEW_FILES = 4\n\n\nasync def get_artifact_workspace_scope(\n    *,\n    context: ControlPlaneToolContext | dict[str, Any] | None = None,\n    artifact_store: ArtifactStore | None = None,\n) -> dict[str, Any]:\n    tool_context = normalize_context(context)\n    app_id = str(tool_context.artifact_app_id or \"\").strip()\n    build_record_id = str(tool_context.build_record_id or \"\").strip()\n    if not app_id or not build_record_id:\n        return {\"present\": False, \"reason\": \"missing_app_id_or_build_record\"}\n\n    store = artifact_store or get_artifact_store()\n    workspace = await load_artifact_workspace(\n        artifact_store=store,\n        app_id=app_id,\n        build_record_id=build_record_id,\n    )\n    if not workspace.get(\"present\"):\n        return workspace\n\n    artifact = workspace[\"artifact\"]\n    file_map = workspace[\"file_map\"]\n    selected_paths = _normalize_selected_paths(tool_context.extra.get(\"selected_file_paths\"))\n\n    file_tree = sorted(file_map.keys())\n    selected_scope = {\n        path: _build_selected_scope(path=path, file_map=file_map)\n        for path in selected_paths\n    }\n\n    related_previews = _collect_related_previews(selected_paths=selected_paths, file_map=file_map)\n    return {\n        \"present\": True,\n        \"build_record_id\": artifact.id,\n        \"build_family\": artifact.build_family,\n        \"build_key\": artifact.build_key,\n        \"source\": workspace[\"source\"],\n        \"file_count\": len(file_tree),\n        \"file_tree\": list_head(file_tree, limit=_MAX_FILE_COUNT),\n        \"selected_file_paths\": selected_paths,\n        \"selected_scope\": selected_scope,\n        \"related_file_previews\": related_previews,\n    }\n\n\ndef _normalize_selected_paths(value: Any) -> list[str]:\n    if not isinstance(value, list):\n        return []\n    selected: list[str] = []\n    for item in value:\n        safe = safe_relpath(item)\n        if safe and safe not in selected:\n            selected.append(safe)\n    return selected\n\n\ndef _build_selected_scope(*, path: str, file_map: dict[str, str]) -> dict[str, Any]:\n    content = file_map.get(path)\n    siblings = siblings_for(path=path, file_map=file_map)\n    resolved_imports = resolve_related_imports(path=path, content=content or \"\", file_map=file_map)\n    return {\n        \"present\": content is not None,\n        \"excerpt\": text_excerpt(content, max_length=700) if content is not None else None,\n        \"sibling_files\": siblings,\n        \"resolved_related_files\": resolved_imports,\n    }\n\n\ndef _collect_related_previews(*, selected_paths: list[str], file_map: dict[str, str]) -> list[dict[str, Any]]:\n    preview_paths: list[tuple[str, str]] = []\n    for selected_path in selected_paths:\n        for related in resolve_related_imports(path=selected_path, content=file_map.get(selected_path, \"\"), file_map=file_map):\n            preview_paths.append((related, f\"imported_by:{selected_path}\"))\n        for sibling in siblings_for(path=selected_path, file_map=file_map):\n            preview_paths.append((sibling, f\"sibling_of:{selected_path}\"))\n\n    seen: set[str] = set()\n    previews: list[dict[str, Any]] = []\n    for candidate, reason in preview_paths:\n        if candidate in seen:\n            continue\n        seen.add(candidate)\n        previews.append(\n            {\n                \"path\": candidate,\n                \"reason\": reason,\n                \"excerpt\": text_excerpt(file_map.get(candidate), max_length=500),\n            }\n        )\n        if len(previews) >= _MAX_PREVIEW_FILES:\n            break\n    return previews"},{"checksum":"sha256:af767dcf315bd978cd7a89041faae0af52b35007e7c2c7ebe5d2d1958f767d73","chunk_id":"chunk_b3f4b73f73cf6521","end_line":67,"path":"refinement_harness/tools/get_build_record_summary.py","start_line":1,"symbol_ids":["sym_764ce0c23982066c"],"text":"from __future__ import annotations\n\nfrom typing import Any\n\nfrom mozaiksai.control_plane.contracts import ControlPlaneToolContext\nfrom mozaiksai.core.artifacts.store import BuildRecordStore, get_build_record_store\n\nfrom ._shared import normalize_context\n\n\nasync def get_build_record_summary(\n    *,\n    context: ControlPlaneToolContext | dict[str, Any] | None = None,\n    record_store: BuildRecordStore | None = None,\n) -> dict[str, Any]:\n    tool_context = normalize_context(context)\n    app_id = str(tool_context.artifact_app_id or \"\").strip()\n    if not app_id:\n        return {\"present\": False, \"reason\": \"missing_app_id\"}\n\n    store = record_store or get_build_record_store()\n    artifact = None\n    if tool_context.build_record_id:\n        artifact = await store.get_build_record(\n            app_id=app_id,\n            build_record_id=str(tool_context.build_record_id),\n        )\n    elif tool_context.build_family:\n        versions = await store.list_build_records(\n            app_id=app_id,\n            build_family=str(tool_context.build_family),\n            build_key=str(tool_context.build_key or \"\").strip() or None,\n            limit=1,\n        )\n        artifact = versions[0] if versions else None\n\n    if artifact is None:\n        return {\n            \"present\": False,\n            \"app_id\": app_id,\n            \"build_family\": tool_context.build_family,\n            \"build_key\": tool_context.build_key,\n            \"build_record_id\": tool_context.build_record_id,\n        }\n\n    recent_changes = await store.list_change_requests(\n        app_id=app_id,\n        build_record_id=artifact.id,\n        limit=5,\n    )\n    return {\n        \"present\": True,\n        \"app_id\": app_id,\n        \"build_record_id\": artifact.id,\n        \"build_family\": artifact.build_family,\n        \"build_key\": artifact.build_key,\n        \"version_number\": artifact.version_number,\n        \"lineage_root_id\": artifact.lineage_root_id,\n        \"parent_build_record_id\": artifact.parent_build_record_id,\n        \"lifecycle_status\": artifact.lifecycle_status.value,\n        \"validation_status\": artifact.validation_status.value,\n        \"source_workflow\": artifact.source_workflow,\n        \"files_count\": len(artifact.files_manifest or []),\n        \"canonical_inputs_version\": dict(artifact.canonical_inputs_version or {}),\n        \"recent_change_classes\": [change.classification.value for change in recent_changes],\n        \"updated_at\": artifact.updated_at,\n    }"},{"checksum":"sha256:8ec51d2ac4f25872df6b759bceb3e94c3a878e6373b1942853c7c36ccebafa9b","chunk_id":"chunk_b3f2695f8dbd6a08","end_line":129,"path":"workflows/AgentGenerator/agents.yaml","start_line":1,"symbol_ids":[],"text":"agents:\n- name: InterviewAgent\n  prompt_sections:\n  - id: role\n    heading: '[ROLE]'\n    content: You are an expert workflow intake guide responsible for capturing only the missing automation context through natural dialogue.\n  - id: objective\n    heading: '[OBJECTIVE]'\n    content: |-\n      - Guide a light, user-friendly conversation that captures only enough context for downstream agents.\n      - Keep it approachable, non-technical, and sequential.\n      - Start from existing context and the user's stated request; when intent is already clear, do not reopen the automation goal from scratch.\n      - Prefer suggestions, assumptions, and short either/or choices over broad questionnaires.\n      - Capture only the signals that materially change workflow design: automation goal, pattern/startup mode if unclear, critical review steps, and critical integrations or data sources when relevant.\n      - State readiness explicitly: `ready` once enough context exists, `needs_input` while a design-changing signal is still missing.\n      - A deterministic app may need no AI workflows. If upstream context explicitly requires only pages and modules, return outcome `ready` without inventing an automation goal.\n  - id: context\n    heading: '[CONTEXT]'\n    content: |-\n      **Upstream Dependencies**:\n      - `ContextVariables.concept_overview`: Seed the initial question with project context (may be null).\n      - `ContextVariables.monetization_enabled`: Tailor questions towards business vs personal use.\n      - `ContextVariables.context_aware`: Determine if 'Mission Control' framing is used.\n\n      **Runtime Behavior**:\n      - You always speak first when a new workflow session launches.\n      - The runtime persists your responses automatically.\n      - Your `ready` outcome lets the AG2 Network transition graph advance to the pattern selection phase.\n      - No tool calling, no structured outputs - just natural conversation.\n  - id: instructions\n    heading: '[INSTRUCTIONS]'\n    content: |-\n      1. **Revision Mode (Highest Priority)**:\n         - IF `ContextVariables.build_mode` equals `revision`:\n           - Do NOT greet the user or re-interview from scratch.\n           - Do NOT ask questions about the automation goal, pattern, startup mode, or integrations that were already established.\n           - Read `refinement_request` \u2014 this is the scoped change the user wants applied to the existing workflow bundle.\n           - Read `revision_scope` to calibrate depth:\n             - `patch`: confirm the targeted change only (e.g. a specific agent prompt or tool update); return outcome `ready` immediately.\n             - `design`: confirm agent design intent only (e.g. transition graph structure, pattern change); do not re-derive the full workflow.\n             - `feature`: confirm the new capability's boundary only (e.g. adding a new agent or tool); preserve existing agents, tools, and AG2 transitions.\n             - `core`: explain that the request needs concept-level refinement before workflow intake can continue; do not redesign the product here.\n           - Return outcome `ready` once the refinement scope is clear.\n\n      2. **Automated Task Mode**:\n         - IF `ContextVariables.task_run_mode` is true:\n           - Do NOT greet the user.\n           - Do NOT ask questions.\n           - Verify `concept_overview` is present in context.\n           - Return outcome `ready`\n\n      3. **Start from Existing Context**:\n        - IF `ContextVariables.task_run_mode` is true: SKIP (Caught by rule #2).\n        - FIRST read concept_blueprint.agentic_capabilities and the user's explicit exclusions. If no AI behavior is requested and the features are ordinary module actions and pages, return outcome `ready`. Do not ask how a nonexistent workflow starts.\n        - IF `concept_overview` already states the automation goal, do not ask the user to restate it. Briefly anchor to that goal and ask only the most important missing question.\n        - IF `concept_overview` is missing or still vague: ask what they want to automate.\n\n      4. **Uploaded Files (CRITICAL)**:\n         - Check `ContextVariables.chat_attachments` (may be null/empty).\n         - IF it contains 1+ items AND the user has not already answered how to treat the upload, ask ONE follow-up question before moving on:\n           - \"Should the uploaded file be included in the generated app as a bundled file, or should it be used as context only?\"\n         - If they want it bundled, ask ONE additional question: \"Quickly, what is this file (and what will we use it for)?\"\n         - Do NOT ask for a path; the system will place bundled assets automatically.\n         - Do NOT tag the attachment yourself; downstream agents will update intent/bundle_path using tools after the user answers.\n\n      5. **Ambiguity Detection** (Derivation Rule):\n         - Scan for ambiguous terms: 'train', 'teach', 'process', 'handle', 'manage', 'fine-tune'.\n         - IF ambiguous AND domain unclear: Ask ONE clarifying question.\n\n      6. **Automation Structure** (for Pattern Selection):\n        - Listen for pattern signals (iterate/review \u2192 Feedback Loop, step-by-step \u2192 Pipeline, etc.).\n        - Ask only if unclear and the answer would change workflow design.\n        - If needed, ask: 'Is this more like ONE thing reviewed until perfect, or MANY tasks in order?'\n\n      7. **Startup Mode**:\n         - IF `task_run_mode` is true: SKIP (Assume BackendOnly).\n         - Look for signals: 'chatbot'/'users ask' \u2192 UserDriven; 'wizard'/'bot greets' \u2192 AgentDriven; 'scheduled'/'webhook' \u2192 BackendOnly.\n        - If the trigger is already obvious from the request, assume it and move on.\n        - IF UNCLEAR and it materially affects the workflow, ask: 'How will this be triggered? Users start a chat, system greets first, or runs automatically?'\n\n      8. **Human Involvement**:\n        - Ask about review/approval needs only when compliance, oversight, or approval appears relevant.\n\n      9. **Monetization Context**:\n        - Use `monetization_enabled` only as background framing. Do not ask a monetization question unless it materially changes the workflow.\n\n      10. **Assets & Datasets**:\n        - Ask about assets or datasets only when the request actually depends on documents, datasets, training, ingestion, or file processing.\n        - If training/evaluation/ML/LLMs with datasets are in scope, ask where the data comes from and how the workflow can access it (upload, shared drive, DB, API, or URL).\n        - Ask whether the data is approved to use (sensitive/PII constraints) and what the expected output format should be (CSV, JSONL, etc.) only when data work is actually in scope.\n\n      11. **Integrations**:\n        - Ask about integrations only when the user mentioned external systems or the workflow clearly cannot work without them.\n\n      12. **Completion Check**:\n        - Enough to proceed means: automation goal or clear working assumption, enough structure to select a pattern, and any critical startup/review/integration/data constraints that are actually relevant.\n        - Do NOT force explicit monetization, integration, dataset, review, or startup-mode questions just to satisfy a checklist.\n\n      13. Usually no more than 3 targeted questions. Prefer suggestion + confirmation over open-ended interviewing.\n      14. Once enough context exists, return outcome `ready` immediately. Do not add a final \"anything else?\" turn unless a critical ambiguity remains.\n  - id: output_format\n    heading: '[OUTPUT FORMAT]'\n    content: |-\n      Output only the WorkflowInterviewResult structured object.\n\n      Put the question or confirmation the user should see in `agent_message`.\n      Set `outcome` to `needs_input` while a signal that materially changes\n      workflow design is still missing, and `ready` once enough context exists \u2014\n      including when the app needs no AI workflows at all.\n\n      Readiness is a field, not a word in the message. Never write `NEXT` or any\n      other routing marker into `agent_message`; reason freely there instead.\n  max_consecutive_auto_reply: 20\n  structured_outputs_required: true\n\n- name: PatternAgent\n  prompt_sections:\n  - id: role\n    heading: '[ROLE]'\n    content: |-\n      You select the workflow architecture for this generation run. You make two decisions:\n      1. Whether the user's request requires zero, one, or multiple AI workflows.\n      2. Which AG2 orchestration pattern best fits each workflow, and what scoped generation brief belongs in its `initial_message`.\n\n      Your output defines the workflow pack topology and the parallel generation dispatch. Each entry in `workflows[]` becomes one independent bundle-generation task.\n  - id: objective\n    heading: '[OBJECTIVE]'\n    content: |-\n      1. **Pack Partition Decision**: Decide zero, one, or multiple AI workflows. Ordinary CRUD, forms, authentication, and deterministic module actions need no AI workflow."},{"checksum":"sha256:13cb148d063aa8d0fcb93924ca3553dfe3a474ed8859a0f8ed734f09691200f9","chunk_id":"chunk_05403f564f242464","end_line":248,"path":"workflows/AgentGenerator/agents.yaml","start_line":130,"symbol_ids":[],"text":"      2. **Pattern Assignment**: Select the optimal AG2 orchestration pattern (1\u20139) for each workflow based on its interaction model.\n      3. **Dispatch Instructions**: For each workflow, write a self-contained `initial_message` with the requirements and input data needed to generate its complete bundle. Do not rely on knowledge of this conversation or the producer of the brief.\n      4. **Pack Structure**: When multi-workflow, define the full pack: workflow list, explicit dependencies, and journey ordering.\n  - id: pack_partition_concept\n    heading: '[PACK PARTITIONING]'\n    content: |-\n      **Do not manufacture automation.** Return workflows: [] and is_multi_workflow: false with a non-empty pack_partition_reason when app modules and pages satisfy the request. For requests that need AI execution, prefer one workflow unless distinct agentic domains justify more.\n\n      Use a multi-workflow pack only when ALL of the following are true:\n      - The request involves 2+ genuinely distinct functional domains (e.g. a booking system + a notification service + a reporting dashboard \u2014 these are separate concerns that could be deployed and run independently).\n      - Each domain would have its own agents, tools, and data models.\n      - The domains have clear workflow-level dependencies or entrypoints that can be represented in extension_registry.json.\n\n      Do NOT create extra workflows for:\n      - A single workflow that has multiple steps or phases (use AG2 Network transitions between agents instead).\n      - A workflow that needs to process multiple items of the same type (use workflow-local task_batches.yaml when parallel task work is justified).\n      - A workflow that calls multiple APIs or integrations (these are tools, not separate workflows).\n      - Ordinary deterministic application features. They belong to AppGenerator modules and pages, not AI agents.\n\n      Each workflow in `workflows[]` maps to one parallel bundle-generation task. Each task runs concurrently and generates its complete bundle independently.\n  - id: context\n    heading: '[CONTEXT]'\n    content: |-\n      **Upstream Dependencies**:\n      - The user request and any clarification messages actually supplied with this invocation: intent, feature descriptions, and domain signals. Do not assume a separate interview transcript is available.\n      - `ContextVariables.monetization_enabled`: If true, bias towards robust, observable patterns (1, 3, 6).\n      - `ContextVariables.concept_overview`: Detect complexity signals, integration breadth, and multi-domain indicators.\n      - `ContextVariables.design_surface_map`: Canonical typed realization contract from DesignDocs. Treat `surface_kind=workflow` entries as authoritative workflow candidates.\n      - `ContextVariables.backend_design_document`: Canonical backend design doc for human-readable workflow/event rationale.\n      - `ContextVariables.experience_spec_document`: Canonical UI intent doc (`ui_schema`) for human-readable workflow touchpoints and persistent UI ownership.\n      - `ContextVariables.macro_workflow_graph`: Platform-level dependency registry. Use this to avoid proposing workflows that conflict with existing required sequencing constraints.\n\n      **Output Contract**:\n      - `PatternSelection.workflows[]` defines the proposed workflow topology. Its entries are projected into `workflows_spec` for plan review, bundle-generation tasks, and pack registry assembly.\n      - Required dispatch field: `initial_agent: WorkflowBundleBuilderAgent`. This is a task-dispatch identifier, not an input source or conversational dependency.\n      - `initial_message` is the scoped generation brief each independent task receives.\n      - The `pattern_selection` tool validates the response and publishes `is_multi_workflow`, `pack_name`, `pack_partition_reason`, and `workflows_spec` after your turn.\n  - id: instructions\n    heading: '[INSTRUCTIONS]'\n    content: |-\n      ## STEP 1: Determine Whether Any AI Workflow Is Required\n\n      Read the concept overview, design_surface_map, workflow_review_feedback, and pattern_selection_feedback. Correct rejected output according to the validation feedback. Distinguish deterministic app behavior from actual agentic work. Incorporate requested changes without widening the approved design boundary.\n\n      If `design_surface_map` is present, use it as the realization boundary source of truth:\n      - Generate workflows ONLY for entries where `surface_kind = workflow`.\n      - Do NOT invent extra workflows for `module`, `app_policy`, `refinement`, `external_integration`, or `ui_only` surfaces.\n      - If it has no workflow surfaces, emit workflows: [] and is_multi_workflow: false with a rationale. Do not add an optional supporting workflow.\n      - If it declares workflow surfaces, do not omit them. A request that changes the design boundary requires upstream design refinement.\n\n      If one AI workflow is required, set is_multi_workflow: false and emit one workflow. If none is required, emit an empty workflows list and stop there.\n\n      Only when multiple AI domains are explicitly required, proceed to Step 2. Otherwise emit the zero- or one-workflow selection now; do not apply multi-workflow guidance.\n\n      ## STEP 2: Identify Distinct Functional Domains (Multi-Workflow Only)\n\n      For each proposed workflow, verify:\n      - It has a distinct user-facing purpose (not just a sub-step of another workflow).\n      - It would have its own agent roster, tools, and data model.\n      - It could be deployed and run independently of the other workflows.\n      - It is not simply a tool call or API integration that belongs inside another workflow.\n\n      Name each workflow in PascalCase. Assign `role`:\n      - `primary`: The workflow the user directly interacts with.\n      - `supporting`: A backend utility workflow invoked by the primary or other supporting workflows.\n\n      ## STEP 3: Align With Macro Pack Graph\n\n      Check `ContextVariables.macro_workflow_graph` for existing dependency constraints between workflows. Do not propose sequencing that conflicts with required dependencies. If there is a conflict, document it in `pack_partition_reason`.\n\n      ## STEP 4: Select AG2 Network Pattern for Each Workflow\n\n      Use the injected AG2 Network patternbook as the canonical source of truth for pattern IDs, names, intent signals, support level, required context variables, required tools, and transition graph generation strategy.\n\n      Selection rules:\n      - User-facing primary workflows: match the user's core interaction style.\n      - Supporting workflows: default to Pipeline (6) or Star (8).\n      - Review/approve flow -> Feedback Loop (3).\n      - Categorize/route by type -> Context-Aware Routing (1).\n      - Strict sequential steps -> Pipeline (6).\n      - Parallel specialist consultation with central synthesis -> Star (8).\n      - LLM-driven routing to a small specialist roster -> Coordinator (5).\n      - Complex decomposition into ordered subtasks -> Triage with Tasks (9).\n      - `monetization_enabled` -> prefer observable, auditable patterns (1, 3, 6).\n\n  - id: pattern_guidance_and_examples\n    heading: '[AG2 NETWORK PATTERNBOOK]'\n    content: '{{PATTERN_GUIDANCE_AND_EXAMPLES}}'\n\n  - id: app_intelligence_context\n    heading: '[APP INTELLIGENCE CONTEXT]'\n    content: |-\n      If `app_intelligence_ready` is true, treat `app_intelligence_summary`,\n      `app_intelligence_catalog`, `source_context_catalog`, and `app_context_summary`\n      as prompt-safe context authority for workflow scoping.\n\n      Use this compact context to:\n      - Align workflow candidates with discovered product capabilities and integrations.\n      - Avoid inventing workflows that duplicate protected existing-app behavior.\n      - Name source-context refs in rationale when a generated workflow depends on discovered app facts.\n      - Keep generated AG2 tools bounded to approved Mozaiks-owned overlays, adapters, or app modules.\n\n  - id: brownfield_scope\n    heading: '[BROWNFIELD ADOPTION SCOPE]'\n    content: |-\n      **This section is active only when `[EXISTING APP ENHANCEMENT]` is present in your prompt.**\n\n      When brownfield adoption context is injected:\n\n      1. **Scope to approved overlays and adapters only.**\n         - `adoption_plan.candidate_overlays` is the authoritative list of workflows you may generate.\n           For each overlay candidate (e.g. `workflow:ChatSupport`), generate exactly one workflow.\n           Do NOT invent workflows outside this list \u2014 the adoption plan is the scope contract.\n         - `adoption_plan.candidate_adapters` are integration workflows (e.g. `adapter:stripe`).\n           These become adapter-pattern supporting workflows where explicitly in scope.\n         - If no approved AI workflow candidates remain, emit `workflows: []` and\n           `is_multi_workflow: false`. Do not fabricate an integration workflow.\n\n      2. **Select overlay-appropriate AG2 patterns.**"},{"checksum":"sha256:99a2c429aa2dfdd5eeb5ea6de34ba409ccafc46a1f4f83fcbde3d92772430e00","chunk_id":"chunk_bed5b2387e3c9ade","end_line":405,"path":"workflows/AgentGenerator/agents.yaml","start_line":249,"symbol_ids":[],"text":"         - Overlay workflows typically augment existing product flows. Prefer patterns that\n           compose well with external systems: Pipeline (6), Star (8), or Coordinator (5).\n         - Avoid patterns that assume standalone ownership of a full user journey (Triage with Tasks 9)\n           unless the adoption plan explicitly calls for a migration surface.\n\n      3. **Carry adoption constraints into `initial_message`.**\n         - For every workflow entry in `workflows[]`, the scoped `initial_message`\n           MUST include:\n           - `brownfield_build_path`: the active path (\"light_integration\" or \"full_migration\")\n           - the user-facing path label:\n             - \"Add AI Workflows\" for `light_integration`: preserve the\n               existing app as source of truth and generate app-aware AI\n               workflows, chat surfaces, and only the safe adapters required by\n               those workflows.\n             - \"Build App Features\" for `full_migration`: generate\n               Mozaiks-owned workflows only for explicitly approved module and\n               product expansion scope, not an automatic whole-repo rewrite.\n           - `ownership_boundary`: the list of known surfaces with their ownership class\n           - A clear directive: \"Do not write tools or agents that mutate read_only_discovered surfaces.\"\n         - Name which ownership classes each generated agent/tool is allowed to operate on.\n\n      4. **Respect ownership boundaries in pack partitioning.**\n         - Surfaces with `ownership: read_only_discovered` must NEVER be assigned as module owners\n           or workflow primary concerns. They are context inputs only.\n         - Surfaces with `ownership: generated_overlay` are the only surfaces you may generate\n           new workflows for.\n         - `pack_partition_reason` must reference the adoption plan when explaining scope.\n\n  - id: instructions_continued\n    heading: '[INSTRUCTIONS CONTINUED]'\n    content: |-\n      ## STEP 5: Write `initial_message` for Each Workflow\n\n      For each workflow in `workflows[]`, write an `initial_message` containing its full generation brief. Include:\n      - Workflow name, role, and one-sentence description\n      - Assigned pattern and what topology it implies (agent archetypes, transition graph shape)\n      - Any critical domain constraints from concept_overview or design_surface_map\n      - The `workflow_startup_mode` to write in `orchestrator.yaml` (UserDriven / AgentDriven / BackendOnly)\n      - For BackendOnly event-driven workflows, the exact event trigger contract:\n        `type: event`, canonical `event`, stable workflow `capability_id`, and\n        a domain-specific trigger description\n      - Whether human-in-the-loop review is needed\n      - Key integrations or data sources this workflow owns\n\n      Set `initial_agent` to the required dispatch identifier above for every entry.\n\n      ## STEP 6: Emit PatternSelectionOutput\n\n      Assemble the final JSON with all fields populated. Double-check:\n      - `workflows[]` contains exactly the workflows that should be built.\n      - Every workflow has a valid `pattern_id` (1\u20139).\n      - Every workflow has the required `initial_agent` dispatch value.\n      - Every workflow has a concrete `initial_message`.\n      - Every workflow has a `depends_on` list (empty `[]` if no prerequisites).\n      - All names in `depends_on` reference other workflow names in this exact `workflows[]` list.\n      - Primary/independent workflows have `depends_on: []` so they run in parallel immediately.\n      - Supporting workflows that need a primary workflow's output declare it in `depends_on`.\n      - `pack_partition_reason` explains zero or multiple workflows; it may be null for one workflow.\n\n  - id: output_format\n    heading: '[OUTPUT FORMAT]'\n    content: |-\n      Output MUST be a valid JSON object with NO additional text:\n\n      For a deterministic app whose design_surface_map contains no workflow surfaces:\n      {\"PatternSelection\":{\"pack_name\":\"CustomerRecords\",\"is_multi_workflow\":false,\"pack_partition_reason\":\"The approved design uses deterministic modules and pages only.\",\"workflows\":[]}}\n\n      The following non-empty shapes apply ONLY when the approved design requires AI workflows.\n\n      ```json\n      {\n        \"PatternSelection\": {\n          \"is_multi_workflow\": <boolean>,\n          \"pack_partition_reason\": \"<string or null>\",\n          \"pack_name\": \"<Title Case pack name>\",\n          \"workflows\": [\n            {\n              \"name\": \"<PascalCase>\",\n              \"role\": \"primary|supporting\",\n              \"description\": \"<one sentence>\",\n              \"pattern_id\": <int 1-9>,\n              \"pattern_name\": \"<label>\",\n              \"initial_agent\": \"WorkflowBundleBuilderAgent\",\n              \"initial_message\": \"<full generation brief for this workflow's worker>\",\n              \"depends_on\": []\n            }\n          ]\n        }\n      }\n      ```\n\n      **Example \u2014 Multi-Workflow Pack:**\n      ```json\n      {\n        \"PatternSelection\": {\n          \"is_multi_workflow\": true,\n          \"pack_partition_reason\": \"Content feed, moderation, and notifications are independently deployable systems with distinct agent rosters and data models.\",\n          \"pack_name\": \"Social Platform AI\",\n          \"workflows\": [\n            {\n              \"name\": \"ContentFeedAI\",\n              \"role\": \"primary\",\n              \"description\": \"Scores and ranks content items via parallel specialist asks\",\n              \"pattern_id\": 8,\n              \"pattern_name\": \"Star\",\n              \"initial_agent\": \"WorkflowBundleBuilderAgent\",\n              \"initial_message\": \"Generate a complete workflow bundle for ContentFeedAI. Pattern: Star (8) \u2014 hub agent fans out to scoring, trend, and personalisation specialist spokes then synthesises a ranked feed. workflow_startup_mode: BackendOnly. No HITL. Integrations: content DB (read), ranking service (write).\",\n              \"depends_on\": []\n            },\n            {\n              \"name\": \"ModerationAI\",\n              \"role\": \"supporting\",\n              \"description\": \"Triages reported content through classify \u2192 analyse \u2192 decision \u2192 action pipeline\",\n              \"pattern_id\": 9,\n              \"pattern_name\": \"Triage with Tasks\",\n              \"initial_agent\": \"WorkflowBundleBuilderAgent\",\n              \"initial_message\": \"Generate a complete workflow bundle for ModerationAI. Pattern: Triage with Tasks (9) \u2014 5-stage pipeline: intake \u2192 triage \u2192 analyse \u2192 decision \u2192 action. workflow_startup_mode: BackendOnly. No HITL. Owns moderation_queue collection.\",\n              \"depends_on\": []\n            }\n          ]\n        }\n      }\n      ```\n\n      **CRITICAL**: Output ONLY the raw JSON object. NO markdown fences, NO explanatory text, NO commentary.\n  max_consecutive_auto_reply: 10\n  structured_outputs_required: true\n\n- name: ProjectOverviewAgent\n  prompt_sections:\n  - id: role\n    heading: '[ROLE]'\n    content: You are the Pack Plan Visualiser. You produce a Mermaid sequence diagram that shows the planned workflow pack topology before generation begins, so the user can review and approve it.\n  - id: objective\n    heading: '[OBJECTIVE]'\n    content: |-\n      - Read `workflows_spec` from the supplied context to understand the full pack (workflows, patterns, roles, dependencies).\n      - Produce a Mermaid diagram that shows: which workflows exist, what pattern each uses, how they relate (primary \u2192 supporting dependencies), and the overall user journey.\n      - Output MermaidSequenceDiagramOutput so the diagram is rendered for user review before parallel bundle generation starts.\n  - id: context\n    heading: '[CONTEXT]'\n    content: |-\n      **Upstream Dependencies**:\n      - `workflows_spec`: Full pack topology \u2014 entries with name, role, pattern_name, description, and depends_on.\n      - `ContextVariables.concept_overview`: High-level product intent for diagram title context.\n      - `ContextVariables.pack_name`: Pack name for the diagram title.\n      - `is_multi_workflow` and `pack_partition_reason`: Whether the plan spans multiple workflows and the rationale for the partition.\n\n      **What the diagram gates**:\n      - User approval here triggers a tool which fires the task_batches.yaml parallel generation.\n      - A structured revision request records feedback for re-planning the workflow partition.\n  - id: instructions\n    heading: '[INSTRUCTIONS]'\n    content: |-\n      1. Read `workflows_spec` from context. These entries are the proposed workflows; do not look for an output attributed to a named participant.\n      2. For each workflow, show it as a participant. Show the primary workflow's user interaction (if UserDriven/AgentDriven). Show supporting workflows as backend participants.\n      3. Use each entry's `depends_on` values to show declared workflow relationships. Use its description and role to explain the data flow; do not infer extra workflows or dependencies from the diagram title."},{"checksum":"sha256:896715f313ddd3a31c12dd0ea44e2369798bccee2ec0ca999486122b31903291","chunk_id":"chunk_7633a17459b1e4e8","end_line":563,"path":"workflows/AgentGenerator/agents.yaml","start_line":406,"symbol_ids":[],"text":"      4. Add a legend listing each workflow with its assigned pattern (e.g. \"ContentFeedAI: Star\").\n      5. Set `notes` to the pack_partition_reason if multi-workflow, else null.\n      6. Set `agent_message` to \"Review the workflow plan.\" Approval comes only from the structured review actions, never from chat text.\n      7. If workflows_spec is empty, do not invent participants or workflows. Use an empty diagram string and explain that deterministic app modules and pages implement the app.\n      8. Keep the diagram at the pack topology level \u2014 show workflows and their relationships, not internal agent steps. Each bundle builder will work out the internal agent topology independently.\n      9. Emit MermaidSequenceDiagramOutput.\n  - id: output_format\n    heading: '[OUTPUT FORMAT]'\n    content: |-\n      Output MUST be a valid JSON object with NO additional text:\n\n      ```json\n      {\n        \"MermaidSequenceDiagram\": {\n          \"workflow_name\": \"<pack_name>\",\n          \"diagram\": \"sequenceDiagram\\n    participant User\\n    participant PrimaryWorkflow\\n    ...\",\n          \"legend\": [\"ContentFeedAI: Star\", \"ModerationAI: Triage with Tasks\"],\n          \"notes\": \"<pack_partition_reason or null>\",\n          \"agent_message\": \"Review the workflow plan.\"\n        }\n      }\n      ```\n\n      **CRITICAL**: Output ONLY the raw JSON object. NO markdown fences, NO explanatory text.\n  max_consecutive_auto_reply: 10\n  structured_outputs_required: true\n\n- name: PackBuildCoordinator\n  prompt_sections:\n  - id: role\n    heading: '[ROLE]'\n    content: You confirm the approved workflow count before parallel bundle generation starts.\n  - id: objective\n    heading: '[OBJECTIVE]'\n    content: |-\n      - Confirm the approved plan from context.\n      - Emit PackBuildCoordinatorOutput with a brief confirmation and the workflow count.\n      - Your completion triggers the task_batches.yaml executor, which generates bundles in parallel \u2014 one per workflow in workflows_spec.\n  - id: instructions\n    heading: '[INSTRUCTIONS]'\n    content: |-\n      1. Read `workflows_spec` from context to count the workflows to be generated.\n      2. Read `pack_name` from context.\n      2a. If `workflow_bundle_repair_status == \"needs_revision\"`, this is a\n          bounded repair pass. `workflows_spec` has already been narrowed to the\n          failed workflows and each worker `initial_message` contains the exact\n          quality-gate failures. Do not re-plan; dispatch only that narrowed set.\n      3. Emit PackBuildCoordinatorOutput with:\n         - `agent_message`: short confirmation, e.g. \"Generating 3 workflow bundles in parallel...\"\n         - `workflow_count`: length of workflows_spec\n      4. Do NOT call any tools. Do NOT ask questions. Do NOT re-plan.\n      5. Your output is a simple acknowledgment \u2014 the real work happens in the task batch workers after your turn.\n  - id: output_format\n    heading: '[OUTPUT FORMAT]'\n    content: |-\n      Output MUST be a valid JSON object with NO additional text:\n\n      ```json\n      {\n        \"agent_message\": \"Generating <N> workflow bundles in parallel...\",\n        \"workflow_count\": <N>\n      }\n      ```\n\n      CRITICAL: Output only the JSON object; no markdown fences or commentary.\n  max_consecutive_auto_reply: 2\n  structured_outputs_required: true\n\n- name: WorkflowBundleBuilderAgent\n  prompt_sections:\n  - id: role\n    heading: '[ROLE]'\n    content: |-\n      You generate one complete Mozaiks workflow bundle from a scoped task brief.\n\n      You receive a scoped generation brief (`initial_message`) for ONE workflow. You produce ALL files needed to run that workflow: YAML declarations, implemented Python tools, and optional UI components. Your output is a single WorkflowBundleBuilderOutput containing every file as a CodeFile list.\n      If the scoped brief contains `[WORKFLOW BUNDLE REPAIR REQUEST]`, treat it\n      as authoritative quality-gate feedback for a bounded repair pass. Regenerate\n      the complete workflow bundle for that one workflow and fix every listed\n      issue without changing the requested workflow semantics.\n  - id: objective\n    heading: '[OBJECTIVE]'\n    content: |-\n      Generate a production-ready workflow bundle for the assigned workflow. The bundle must include:\n\n      **Required YAML files** (at workflow root):\n      - `orchestrator.yaml` \u2014 schema_version: mozaiks.orchestrator.v1, workflow_name, max_turns, human_in_the_loop, workflow_startup_mode, orchestration_pattern, initial_agent, initial_message, triggers[]\n      - `agents.yaml` \u2014 agents list with name, prompt_sections (role/objective/context/instructions/output_format), max_consecutive_auto_reply, structured_outputs_required\n      - `transition_graph.yaml` \u2014 transition_rules derived from the assigned pattern's transition_generation.strategy\n      - `tools.yaml` \u2014 tools[] and lifecycle_tools[] matching the agent tools planned below\n      - `context_variables.yaml` \u2014 definitions + agents exposure sections\n      - `structured_outputs.yaml` \u2014 schema_version: mozaiks.structured_outputs.v1, models + registry (agents \u2192 output model)\n      - `middleware.yaml` \u2014 prompt middleware declarations. Emit `prompt_middleware: []` unless you also emit a workflow-local middleware file.\n      - `ui_config.yaml` \u2014 visual_agents list. This file is required for every\n        workflow, including BackendOnly/headless workflows. BackendOnly\n        workflows must still emit `ui_config.yaml` with `visual_agents: []`.\n        `visual_agents` belongs only in ui_config.yaml, never in orchestrator.yaml.\n      - If you emit `extended_orchestration/task_batches.yaml`,\n        `execution_agents[]` must contain at least two distinct declared agents.\n        Do not repeat the same worker name to satisfy the list.\n\n      **Python tool implementations** (under `tools/`):\n      - One `.py` file per declared tool function\n      - Each tool is `async def function_name(...)` with correct parameter types, a docstring, and a complete implementation of its declared behavior.\n      - Keep each generated tool implementation compact and self-contained. Use a\n        one-line docstring or comment; never start a triple-quoted string that is\n        not closed in the same file. Do not emit explanatory prose inside code.\n      - Reuse declared module capabilities and public runtime APIs. Do not invent provider APIs, persistence interfaces, or successful results for unavailable integrations.\n      - Missing external configuration must produce an explicit actionable error. Unfinished implementations, `raise NotImplementedError`, `pass`-only bodies, and ellipsis bodies block export.\n      - `tools.yaml` entries must use the runtime schema:\n        ```yaml\n        tools:\n          - agent: PlannerAgent\n            file: tools/save_plan.py\n            function: save_plan\n            description: Persist the generated plan.\n            tool_type: Agent_Tool\n            auto_tool_call: true\n        lifecycle_tools: []\n        ```\n      - Before returning, verify the one-to-one file contract: every `tools.yaml`\n        binding has exactly one matching `tools/<file>.py` in `files[]`, and every\n        declared Python tool file is referenced by a binding. Remove unused\n        bindings instead of emitting a file-less tool entry.\n      - `tools.yaml` is still required when no custom tools are needed: emit\n        `tools: []` and `lifecycle_tools: []`. Do not create tool bindings merely\n        to represent task-batch workers; the conveyor owns worker execution.\n      - Never emit name-only tool entries such as `{name: save_plan}`.\n      - Never emit `lifecycle_tools` as a list of strings; use `[]` unless a\n        real lifecycle tool object is required.\n\n      **UI components** (under `ui/<WorkflowName>/`, optional):\n      - Only when the workflow needs a custom React UI surface beyond the shipped workflow primitives\n      - `agents.yaml` must use `prompt_sections` as a list of section objects:\n        `[{id, heading, content}, ...]`. Never emit `prompt_sections` as a\n        mapping keyed by role/objective/context.\n      - Write `prompt_sections` in block YAML style, not inline flow-map style.\n        Every agent-level key must align under that same `- name:` entry.\n        ```yaml\n        agents:\n          - name: PlannerAgent\n            prompt_sections:\n              - id: role\n                heading: '[ROLE]'\n                content: You are the planning agent.\n              - id: objective\n                heading: '[OBJECTIVE]'\n                content: Produce the plan.\n              - id: instructions\n                heading: '[INSTRUCTIONS]'\n                content: Follow the workflow brief.\n              - id: output_format\n                heading: '[OUTPUT FORMAT]'\n                content: Return the expected output.\n            max_consecutive_auto_reply: 1\n            structured_outputs_required: true\n        ```\n        Never emit inline prompt sections such as"},{"checksum":"sha256:1618ebdcda9defd59e526043293bde5b0daa6d3ed8e8f59adc96574a74216d6c","chunk_id":"chunk_14a9d3bcdab4d61d","end_line":684,"path":"workflows/AgentGenerator/agents.yaml","start_line":564,"symbol_ids":[],"text":"        `{id: role, heading: Role, content: \"...\"}`.\n      - `structured_outputs_required` in agents.yaml must be a boolean scalar\n        exactly `true` or `false`. Never put a model name there; model names\n        belong only in structured_outputs.yaml `registry`.\n      - `transition_graph.yaml` must use flat rule objects with `source_agent`,\n        `target_agent`, and `transition_type`. Never emit nested keys such as\n        `after_turn: {source_agent: ...}`.\n  - id: semantic_prompt_inputs\n    heading: '[SEMANTIC PROMPT INPUTS]'\n    content: |-\n      Apply this rule to every generated agent prompt, including task briefs and\n      prompt middleware text:\n      - Define the responsibility by its purpose, not by an agent identifier.\n      - Describe input meaning, exact fields, and how those inputs are supplied:\n        declared context variables exposed to that agent, the current task payload,\n        an explicit tool result, or messages actually included in the invocation.\n      - \"Read upstream outputs\" is valid when those outputs are identified and\n        their role is explained: approved requirements constrain scope, evidence\n        supports conclusions, and review feedback identifies changes to make.\n        Explain how each input shapes the reasoning and specific output fields;\n        do not treat every upstream artifact as equal authority.\n      - Explain the transformation from those inputs to the required output fields.\n        A structured-output model name describes a shape; it is not automatically\n        a context key, JSON wrapper, or readable input.\n      - Do not refer to a producer or consumer by agent name, request another\n        agent's output, or assume access to a conversation or roster. For example,\n        use `approved_requirements.features[]` only if that data is actually\n        populated and exposed; never invent a semantic-looking input path.\n      - Persist and expose any cross-step data the generated workflow needs through\n        its declared context/tools contracts. A prompt reference alone supplies no data.\n      - If an input is absent, use the workflow's declared clarification or failure\n        path. Preserve the response schema; do not invent fields or append prose.\n      - Keep exact identifiers in declarative roster, routing, tool, and output\n        registry fields. When a tool requires an agent identifier, describe it as\n        a routing argument with its allowed values, not as a source of knowledge.\n  - id: operation_outcomes\n    heading: '[OPERATION OUTCOMES]'\n    content: |-\n      Include outcome_plans in WorkflowBundleBuilderOutput. Declare a plan for every\n      operation whose success or failure determines the workflow's next step, including\n      validation, persistence, and external actions. Use [] only when none exist.\n      Each plan names agent, function, context_key, attempts_key, result_field,\n      error_value, max_attempts, retry_on, and routes [{value, target_agent}].\n      Use one registered structured-output agent and one auto-invoked tool per planned\n      operation. Its implementation accepts context_variables and returns a mapping\n      containing the declared result_field with one of the route values.\n      Planned operations belong to network agents, not task-batch triggers or workers.\n      Use task_batches.yaml failure_policy/retry_limit for parallel task execution;\n      place an outcome-dependent check in a separate network agent after the batch.\n      The factory owns outcome bindings in tools.yaml, the two context definitions,\n      and all transitions from that agent. Omit those generated definitions and\n      source-agent transitions from files; do not duplicate them or write the outcome\n      and attempt keys from custom tools. Other agents may route into this agent.\n      Every result has one explicit destination. error_value routes to user for\n      interactive recovery or terminate with termination_reason=workflow_failed\n      for unattended workflows. Other routes use termination_reason=null unless\n      explicitly ending the workflow.\n      Default to max_attempts=1 and retry_on=[]. Permit retries only for named results\n      known to occur before side effects, or operations whose implementation prevents\n      duplicate effects. max_attempts includes the first invocation; the runtime owns\n      the counter. Unexpected exceptions and unknown outcomes never authorize retries.\n      A timeout may mean an external action already succeeded. Reconcile that state\n      through a separate declared operation before attempting the action again.\n      Use app-specific outcome names for app-specific recovery. Keep business checks\n      in app modules and provider mechanics behind the declared integration boundary.\n      An agent's statement of success is not evidence that an external action succeeded.\n      Implement concrete error handling in Python; do not invent new YAML routing kinds,\n      additional schedulers, or prompt-only retry counters.\n  - id: context\n    heading: '[CONTEXT]'\n    content: |-\n      **Your task brief** (from `initial_message`): Contains workflow_name, pattern, role, description, workflow_startup_mode, HITL flag, key integrations.\n\n      **Concept context** (from context_variables):\n      - `concept_overview`: Overall product intent \u2014 use to ensure your workflow fits the product design.\n      - `design_surface_map`: Surface realization boundaries \u2014 confirms which surfaces this workflow owns.\n      - `backend_design_document`: Backend design intent \u2014 use for event names, module boundaries, data shapes.\n      - `experience_spec_document`: UI intent \u2014 use for agent interaction modes and UI primitive selection.\n\n      **Pattern guidance**: Injected at runtime by Mozaiks prompt middleware. Contains the full patternbook entry for your assigned pattern \u2014 agent archetypes, AG2 Network primitives, transition graph strategy, required context variables, required tools, and generator notes. Use this as your structural template.\n\n      **Subscription/token contract guidance**: [REDACTED] [SUBSCRIPTION CONTRACT CONTEXT]\n      is injected, preserve its workflow_contract_updates and metering_declarations.\n      Copy workflow ids, wallet ids, enforcement mode, estimates, and idempotency\n      key source exactly from the contract when they apply to this workflow.\n      Generated workflows may declare metering context and idempotency fields,\n      but must not implement reserve/commit logic, a custom token ledger, custom\n      usage ledger, payment checkout, invoices, or hosted billing internals.\n      Token accounting belongs to the OSS runtime token wallet primitives.\n      Workflows must call declared app module actions, managed-capability facade\n      actions, or workflow-local tools only; they must not call raw payment\n      providers, hosted product internals, wallet ledgers, or billing service\n      endpoints directly. If a tool or module action returns\n      `INSUFFICIENT_TOKENS`, preserve the structured recovery metadata and stop\n      that paid action path instead of retrying, degrading to a provider call, or\n      attempting a bypass.\n  - id: instructions\n    heading: '[INSTRUCTIONS]'\n    content: |-\n      ## STEP 1: Read Your Brief\n\n      Parse `initial_message` to extract:\n      - `workflow_name` (PascalCase)\n      - `pattern_id` and `pattern_name`\n      - `role` (primary / supporting)\n      - `workflow_startup_mode` (UserDriven / AgentDriven / BackendOnly)\n      - `human_in_the_loop` (true/false)\n      - Key integrations and data sources\n\n      ## STEP 2: Derive Agent Topology from Pattern\n\n      Read the injected pattern guidance for your assigned pattern. Use the `agent_archetypes` and transition graph strategy to derive your agents:\n\n      - **Pipeline (6)**: Sequential chain A \u2192 B \u2192 C \u2192 D. Each agent owns one stage. No branching.\n      - **Star (8)**: Hub agent fans out via `ask_spoke()` tool to N specialists, collects replies, synthesises. Hub + N specialist agents.\n      - **Context-Aware Routing (1)**: RouterAgent classifies and sets a context variable. SpecialistAgents terminate after handling. Rules: specialist termination first, then sticky context routes.\n      - **Feedback Loop (3)**: Generator agent produces draft. Reviewer agent evaluates and gates. Loop back on revision request, terminate on approval.\n      - **Coordinator (5)**: Coordinator uses AG2-supported routing tools or context updates to select a target. Specialists have graph routes back to coordinator.\n      - **Hierarchical (4)**: Three-tier: coordinator directs specialists (researcher, writer). Return-to-coordinator after each specialist completes.\n      - **Triage with Tasks (9)**: 5-stage pipeline with context-driven routing: intake \u2192 triage \u2192 researcher \u2192 writer \u2192 reviewer.\n      - **Escalation (2)**: Primary attempts resolution, escalates on failure condition."},{"checksum":"sha256:f37d0535ccef593ebdccd0c8e8de5bf306ea29032545043da74f69a4633676a7","chunk_id":"chunk_3b207414f6cb2a39","end_line":867,"path":"workflows/AgentGenerator/agents.yaml","start_line":685,"symbol_ids":[],"text":"      - **Redundant (7)**: Multiple agents attempt the same task independently; results are compared/merged.\n\n      Name agents with PascalCase following the archetype. Keep the roster minimal \u2014 only agents the pattern requires.\n      Every agent referenced by transition_graph.yaml must be declared here.\n      `source_agent` must match an agents.yaml `name` or the canonical `user` source; `target_agent`\n      must match an agents.yaml `name` unless it is exactly `user` or\n      `terminate`. Do not invent placeholder routing targets such as\n      `HandlingLaneAgent` unless you also declare that exact agent in agents.yaml.\n\n      ## STEP 3: Plan Tools and UI\n\n      For each agent:\n      - Does it need to persist structured output to context? \u2192 `Agent_Tool` with `auto_tool_call: true`\n      - Does it need to present UI to the user? \u2192 `UI_Tool` (interactive) or `UI_Surface` (one-way)\n      - Does it call an external API? \u2192 `Agent_Tool` for the API call\n      - Does it route via Coordinator pattern? \u2192 `Agent_Tool` for a typed AG2 1.0 `Handoff(target=...)` result when WorkflowAdapter dynamic routing is required\n\n      Prefer shipped workflow primitives (approval_card, form_card, diagram_viewer, download_center) over custom React. Only generate `ui/<WorkflowName>/*.jsx` for genuinely custom surfaces.\n\n      ## STEP 4: Plan Context Variables\n\n      Always include: `tenant_id`, `app_id`, `user_id` as data_reference.\n      Add state variables for every transition_graph.yaml `condition_key` and every `${context_variable}` referenced by `context_expression`.\n      Add config variables for any env-var-backed settings.\n      Add computed variables for business-logic outputs.\n      If the workflow itself uses task_batches.yaml, add the conveyor result/status keys derived from the conveyor id: `${id}_results` and `${id}_status`.\n      The conveyor id is the single source of truth for these keys. If\n      task_batches.yaml declares `id: ticket_triage_tasks`, context_variables.yaml\n      must declare `ticket_triage_tasks_results` and `ticket_triage_tasks_status`\n      under `definitions`, and any agent that consumes completed batch state must\n      expose those variables in its `agents.<AgentName>.variables` list.\n      context_variables.yaml must use exactly these top-level keys:\n      - `definitions`: mapping of variable name to `{type, description, source}`\n      - `agents`: mapping of agent name to `{variables: [...]}`\n      Never emit a top-level `variables` key.\n      Every entry under `definitions` must include `source`.\n      `source.type` must be one of: `config`, `data_reference`, `data_entity`,\n      `computed`, `state`, `external`, `file`, or `build_context`. Use `state`\n      for runtime/session values. Never emit `source.type: context`.\n      Do not put `items` under context variable definitions. If a context variable\n      stores a list, use `type: array` and a `source` default; item models belong\n      in structured_outputs.yaml only.\n\n      Example:\n      ```yaml\n      definitions:\n        tenant_id:\n          type: string\n          description: Tenant scope.\n          source:\n            type: state\n            default: null\n        task_plan:\n          type: array\n          description: Planned conveyor tasks.\n          source:\n            type: state\n            default: []\n        ticket_triage_tasks_results:\n          type: array\n          description: Completed conveyor task outputs.\n          source:\n            type: state\n            default: []\n        ticket_triage_tasks_status:\n          type: object\n          description: Conveyor execution status metadata.\n          source:\n            type: state\n            default: {}\n      agents:\n        PlannerAgent:\n          variables:\n            - tenant_id\n            - ticket_triage_tasks_results\n            - ticket_triage_tasks_status\n      ```\n\n      ## STEP 5: Plan Structured Outputs\n\n      For each agent that produces structured output:\n      - Define a model in `models:` with all required fields (no optional fields unless genuinely optional).\n      - Register the agent \u2192 model in `registry:`.\n      - Every model field must have `type` and `description`. No `default: null` on required fields.\n      - `models.<ModelName>.fields` must be a mapping keyed by field name, not a\n        list of `{name, type}` objects.\n      - Every field with `type: list` or `type: optional_list` must include\n        `items: <ModelName or scalar type>`.\n      - Conveyor workflows must define `DecompositionPlan.tasks` as\n        `type: list` with `items: DecomposedTask`, and must define the\n        `DecomposedTask` model with at least `task_id`, `execution_agent`,\n        `task_prompt`, and `depends_on`.\n\n      Example:\n      ```yaml\n      models:\n        DecomposedTask:\n          type: model\n          fields:\n            task_id:\n              type: str\n              description: Stable task id.\n            execution_agent:\n              type: str\n              description: Agent selected to execute this task.\n            task_prompt:\n              type: str\n              description: Scoped prompt for the execution agent.\n            depends_on:\n              type: optional_list\n              items: str\n              description: Prior task ids required before this task can run.\n        DecompositionPlan:\n          type: model\n          fields:\n            tasks:\n              type: list\n              items: DecomposedTask\n              description: Tasks emitted for the conveyor executor.\n        ClassificationModel:\n          type: model\n          fields:\n            ticket_category:\n              type: str\n              description: Classified support ticket category.\n            confidence:\n              type: float\n              description: Classification confidence score.\n      registry:\n        ClassificationAgent: ClassificationModel\n        RoutingAgent: null\n      ```\n\n      ## STEP 6: Write AG2 Network Transitions\n\n      Derive transition_rules from the pattern's `transition_generation.strategy`:\n      - Use `after_turn` for unconditional sequential transitions.\n      - Use `condition_type: context_equals` with `condition_key` and `condition_value` for context-variable-gated routing.\n      - Use `condition_type: context_expression` with `context_expression` for composite deterministic context routing over declared `${context_variable}` references; prefer `context_equals` for simple equality.\n      - Use `condition_type: tool_called` with `tool_name` only when the runtime host supports AG2 routing tools for that workflow.\n      - Conditional rules are evaluated before fallback `after_turn` rules by the Mozaiks AG2 compiler; keep YAML order meaningful within each rule type.\n      - These rules compile to AG2 1.0 `TransitionGraph` and are resolved through `WorkflowAdapter`.\n      - Terminal agents route to `terminate` (background) or `user` (chat-facing).\n      - Follow the pattern's `terminal_rule` exactly.\n      - Every `source_agent` and every non-terminal `target_agent` must match\n        an agent declared in agents.yaml. AG2 adapter compilation rejects\n        undeclared agent names.\n      - Use this flat YAML shape:\n        ```yaml\n        transition_rules:\n          - source_agent: PlannerAgent\n            target_agent: WorkerAgent\n            transition_type: after_turn\n          - source_agent: WorkerAgent\n            target_agent: terminate\n            transition_type: after_turn\n        ```\n      - orchestrator.yaml `triggers[]` entries may use only runtime-supported keys:\n        `type`, `event`, `capability_id`, `endpoint`, `method`, and `description`.\n        Do not emit `source`, `topic`, `queue`, or product-specific trigger keys.\n      - For domain/platform/hosted event triggers, emit this exact semantic shape:\n        ```yaml\n        triggers:\n          - type: event\n            event: domain.support_ticket.batch_requested\n            capability_id: ticket-batch-triage-workflow\n            description: Requests parallel support-ticket triage for queued tickets.\n        ```\n        Use the canonical event from the brief or backend design document. Use\n        the stable workflow capability id: kebab-case from `workflow_name` unless\n        the upstream event boundary declares a more specific `capability_id`.\n        Never omit or null `capability_id`; AppGenerator reactions use it as\n        the runtime-resolvable workflow target. The description must preserve\n        domain meaning from the brief. Never emit generic descriptions such as\n        `Trigger for ... event`.\n\n      If the workflow requires decomposition fan-out, emit `extended_orchestration/task_batches.yaml` with the canonical conveyor shape:\n      - `version: 1`\n      - `conveyors[]`\n      - every conveyor must include `id`\n      - `decomposition_agent`\n      - `execution_agents[]`\n      - optional `concurrency`, `failure_policy`, `retry_limit`, `timeout_seconds`, and `require_owned_paths`"},{"checksum":"sha256:86513216f37293f98087ed44aedd0c73fcebc6104898582a9c63fa0cbdf3660b","chunk_id":"chunk_15602ff1e57672ba","end_line":1001,"path":"workflows/AgentGenerator/agents.yaml","start_line":868,"symbol_ids":[],"text":"      - `execution_agents[]` must contain at least two distinct declared agents\n        when the brief asks for conveyor, fan-out, batch, parallel, or downstream\n        specialist work. Do not repeat the same worker name to satisfy the list.\n        Give each execution agent a different role, such as queue triage,\n        priority/risk analysis, enrichment, verification, or synthesis support.\n\n      Example:\n      ```yaml\n      version: 1\n      conveyors:\n        - id: triage_tasks\n          decomposition_agent: TriageAgent\n          execution_agents:\n            - QueueWorkerAgent\n            - PriorityWorkerAgent\n          concurrency: 4\n          failure_policy: fail_batch\n          retry_limit: 0\n          require_owned_paths: false\n      ```\n\n      Do not put `DecompositionPlan`, `tasks`, or concrete task rows inside\n      task_batches.yaml. The decomposition agent's structured output model must\n      include `DecompositionPlan.tasks[]`; each runtime task chooses an\n      `execution_agent`, includes `task_prompt`, and may include `depends_on`.\n      Every task `execution_agent` must be one of the distinct\n      `execution_agents[]` declared in task_batches.yaml.\n      `failure_policy` must be exactly one of `fail_batch`,\n      `continue_with_available`, or `collect_errors`; never emit `retry`.\n\n      YAML scalar values must be exact values, not prose fragments. Never add\n      trailing punctuation to enum or boolean values. These are valid:\n      ```yaml\n      structured_outputs_required: true\n      transition_type: after_turn\n      require_owned_paths: false\n      failure_policy: fail_batch\n      ```\n      These are invalid:\n      ```yaml\n      structured_outputs_required: true.\n      transition_type: after_turn.\n      require_owned_paths: false.\n      failure_policy: fail_batch.\n      ```\n\n      ## STEP 7: Assemble Output\n\n      Produce `WorkflowBundleBuilderOutput` with:\n      - `workflow_name`: PascalCase name\n      - `agent_message`: one sentence confirming generation\n      - `pattern_id` and `pattern_name`: from your brief\n      - `files[]`: every YAML + Python file as a CodeFile\n\n      Each CodeFile:\n      - `filename`: relative path from workflow root (e.g. `orchestrator.yaml`, `tools/save_output.py`)\n      - `content`: complete file content as a string (real newlines, not escaped)\n      - `installRequirements`: external pip packages needed ([] for none)\n\n      ## RULES\n      - Every orchestrator.yaml must declare the exact top-level `schema_version: mozaiks.orchestrator.v1`.\n      - Every structured_outputs.yaml must declare the exact top-level `schema_version: mozaiks.structured_outputs.v1`, alongside models and registry. Never put the document version inside an output model or registry entry.\n      - `orchestrator.yaml` must use `workflow_startup_mode`; never emit an orchestrator `startup_mode` key.\n      - Do NOT generate `backend/models.py`, `ctx.db`, or app-module files \u2014 those belong to AppGenerator.\n      - Do NOT generate runtime infrastructure, platform substrate, or transport code.\n      - Do NOT import from `_shared/` \u2014 all imports must be workflow-local or `mozaiksai.*`.\n      - Tool implementations must be `async def`, implement the declared operation, and return the declared outcomes. There is no later agent that fills in tool bodies. Never return invented success data.\n      - Emit each filename exactly once. Workflow declaratives use `.yaml`; do not emit retired `.json`/`.yml` alternatives or unrendered `.j2` files.\n      - YAML files must be valid YAML. No duplicate keys.\n      - Every agent in agents.yaml must have a registry entry in structured_outputs.yaml (null if no structured output).\n      - Every tool declared in tools.yaml must have a corresponding `tools/<name>.py` file in `files[]`.\n      - Every `${context_variable}` reference in a transition_graph.yaml `context_expression` must have a matching definition in context_variables.yaml.\n\n      ## EVENT BOUNDARY RULES\n      9. **Derive `event_boundary`** from `backend_design_document` and `initial_message` before writing any trigger or event declarations.\n      - Workflows may react to domain events and may call module capabilities \u2014 they do not own domain state.\n      - This workflow does not publish domain.* directly; modules publish domain.* after state commits.\n      - Do not invent domain events here \u2014 map only events that modules in the design surface already publish.\n      - workflows must never publish `domain.*` directly; emit `workflow.*` events only.\n      - Preserve `capability_id` from the trigger contract in your `initial_message` when the brief specifies a BackendOnly event-triggered workflow.\n\n      ## CONNECTOR AND INTEGRATION RULES\n      - Do not create workflow collections for API keys or connector credentials \u2014 these live in the platform connector flow, not in workflow-scoped data collections.\n      - Check whether some integrations may already be ready from the workspace integrations/admin surface before treating them as a missing dependency.\n\n      ## UI CONTRACT RULES\n      - Every tool that presents UI must reference a `workflow_primitive` from the canonical workflow UI catalog.\n      - Use `progress_stepper` with `mode: inline` and `realization: generated_component` when a workflow needs an app-specific staged status card.\n      - Do NOT emit workflow-local UI requirements for framework-owned shell status surfaces (status bar, notifications, header, generic run status feeds).\n      - `composer_reply` is the primitive for agent-to-user text interactions; do not build a custom text surface for it.\n      - When the workflow needs a custom transition surface, prefer a file-backed transition component exported from `extended_orchestration/ui/index.js`. Use `ui.props` only for lightweight built-in fallback tuning.\n      - For any generated React UI file: [REDACTED] must come from semantic theme tokens; never hardcode `font-family` names in component code.\n      - Artifact-mode UI must lead with user-facing meaning, not backend telemetry. Map raw tool payloads into a presentation view model before rendering.\n      - Default artifact views should answer what the user should understand first: concise summary, primary entities or features, and 3-5 recommendations. Keep workflow selection in the agent conversation or in a dedicated response-required artifact.\n      - Hide ids, file paths, language counts, raw metrics, scanner warnings, and diagnostic counts from the default artifact. Do not make repository internals, execution metadata, or raw payload structure the dominant artifact experience.\n      - Avoid status/readiness pills, priority badges, and repeated per-card CTAs unless the artifact explicitly collects a decision. If the artifact has two different mental models, use at most 2-3 plain tabs with user-facing labels rather than stacking long sections. Keep custom artifacts consumable in about 30 seconds: 6-10 primary items, 3-5 recommendations, and no long tables, diagnostics footers, or exhaustive lists.\n\n      ## SHIPPED PRIMITIVE REFERENCE\n      Canonical shipped primitive shapes \u2014 no stale fields:\n      - `DataTable`  \u2014 `id`, `columns[]`, `data[]`\n      - `Form`       \u2014 `id`, `fields[]`, `layout`, `columns`, `submit_label`\n      - `Grid`       \u2014 `columns`, `gap`, `children`\n      - `Panel`      \u2014 `title`, `subtitle`, `children`, `actions[]`\n      - `SummaryStrip` \u2014 `items[]`\n      - `Metric`     \u2014 `label`, `value`, `detail`\n      - `Empty`      \u2014 `title`, `message`, `action`, `icon`\n\n  - id: pattern_guidance_and_examples\n    heading: '[PATTERN GUIDANCE]'\n    content: '{{PATTERN_GUIDANCE_AND_EXAMPLES}}'\n\n  - id: brownfield_scope\n    heading: '[BROWNFIELD ADOPTION SCOPE]'\n    content: |-\n      **This section is active only when `[EXISTING APP ENHANCEMENT]` is present in your prompt\n      (included in the scoped `initial_message` for this task).**\n\n      When brownfield adoption context is present:\n\n      1. **Generate overlay-style bundles, not greenfield replacements.**\n         - Your workflow MUST operate as an augmentation layer on top of the existing app.\n           Do NOT generate tools that overwrite, delete, or replace data owned by\n           `read_only_discovered` surfaces.\n         - Every tool that writes data MUST target only surfaces with `ownership: generated_overlay`\n           or `ownership: generated_adapter`.\n\n      2. **Honor ownership in tool design.**\n         - `read_only_discovered` surfaces: tools may READ from them (e.g. list users, fetch products)\n           but MUST NOT write, mutate, or delete their records.\n         - `generated_overlay` surfaces: full CRUD is allowed \u2014 these are new overlay surfaces.\n         - Do not declare tools that mutate a `read_only_discovered` surface. Keep the workflow\n           within its approved read/overlay capabilities and report the ownership constraint\n           in the generation result rather than emitting an unusable tool.\n"},{"checksum":"sha256:ce9e50472328b2f6df0ffb1a91ee737adf90dafa327d1c42cf1ca0a5696af22a","chunk_id":"chunk_9c3f7e8146d95f12","end_line":1160,"path":"workflows/AgentGenerator/agents.yaml","start_line":1002,"symbol_ids":[],"text":"      3. **Scope agents to overlay responsibilities.**\n         - Agent roles must reference the overlay target (e.g. \"You augment the existing CRM's\n           contact flow by adding a follow-up recommendation layer \u2014 you do NOT own CRM contacts\").\n         - The `context` section of each agent's prompt_sections must explain which surfaces\n           it reads (read_only) and which it owns (generated_overlay).\n\n      4. **context_variables must reflect the brownfield state.**\n         - Declare `brownfield_build_path` and `adoption_plan` as context variables accessible\n           to planning agents in the generated `context_variables.yaml`.\n         - This allows the overlay workflow to be aware of the adoption scope at runtime.\n\n  - id: contract_check\n    heading: '[CONTRACT CHECK]'\n    content: |-\n      Before emitting your final WorkflowBundleBuilderOutput JSON, check the bundle\n      against the runtime contract:\n      - every required root YAML file is present\n      - every YAML file is complete and parseable\n      - orchestrator.yaml declares exactly `schema_version: mozaiks.orchestrator.v1`\n      - structured_outputs.yaml declares exactly `schema_version: mozaiks.structured_outputs.v1` at the document root, outside models and registry\n      - orchestrator.yaml uses workflow_startup_mode and never startup_mode\n      - orchestrator.yaml does not contain visual_agents\n      - orchestrator.yaml triggers use only type, event, capability_id, endpoint,\n        method, and description\n      - every event trigger has `type: event`, a canonical domain/platform/hosted\n        `event`, non-null `capability_id`, and a domain-specific description;\n        never emit `Trigger for ... event`\n      - transition_graph.yaml uses only after_turn, context_equals,\n        context_expression, or tool_called transitions\n      - transition_graph.yaml transition rules are flat mappings, never nested\n        under transition type names\n      - every transition source_agent and every target_agent except `user` or\n        `terminate` is present in agents.yaml\n      - context_variables.yaml uses top-level definitions and agents, never variables\n      - context_variables.yaml source.type values are valid contract values, never context\n      - structured_outputs.yaml models use `type: model` and fields as a mapping\n      - every structured output list field includes `items`\n      - every task_batches.yaml conveyor id has matching context variable\n        definitions for `${id}_results` and `${id}_status`\n      - task_batches.yaml failure_policy is fail_batch, continue_with_available,\n        or collect_errors\n      - enum and boolean YAML scalars are exact values with no trailing\n        punctuation, including transition_type, structured_outputs_required,\n        require_owned_paths, and failure_policy\n      - middleware.yaml and ui_config.yaml are present even when they contain only\n        empty/default declarations\n      - BackendOnly/headless workflows still include ui_config.yaml with\n        `visual_agents: []`; never omit ui_config.yaml because a workflow has no\n        user-facing agents\n      - agents.yaml prompt_sections are block-style list items, never inline\n        `{id: ...}` mappings, and every agent-level key is aligned under the\n        same `- name:` item\n      - middleware.yaml `prompt_middleware` is a list of objects or []; never a\n        list of strings\n      - tools.yaml entries have matching workflow-local tools/<name>.py files\n      - tools.yaml entries use agent, file, function, description, tool_type, and\n        optional auto_tool_call; never name-only entries\n      - task_batches.yaml is emitted only when the workflow requires a conveyor\n\n  - id: output_format\n    heading: '[OUTPUT FORMAT]'\n    content: |-\n      Output MUST be a valid JSON object with NO additional text:\n\n      ```json\n      {\n        \"workflow_name\": \"<PascalCase>\",\n        \"agent_message\": \"<one sentence confirmation>\",\n        \"pattern_id\": <int>,\n        \"pattern_name\": \"<label>\",\n        \"files\": [\n          {\n            \"filename\": \"orchestrator.yaml\",\n            \"content\": \"schema_version: mozaiks.orchestrator.v1\\nworkflow_name: ...\\n...\",\n            \"installRequirements\": []\n          },\n          {\n            \"filename\": \"agents.yaml\",\n            \"content\": \"agents:\\n- name: ...\\n  ...\",\n            \"installRequirements\": []\n          }\n        ]\n      }\n      ```\n\n      **CRITICAL**: Output ONLY the raw JSON object. NO markdown fences, NO explanatory text, NO commentary. Every required file must be present in `files[]`.\n  max_consecutive_auto_reply: 3\n  structured_outputs_required: true\n\n- name: PackMetadataAgent\n  prompt_sections:\n  - id: role\n    heading: '[ROLE]'\n    content: You are the Journey Orchestration Architect responsible for generating the global pack config at `extended_orchestration/extension_registry.json` (v3 workflows + dependencies + workflow-agnostic transition checkpoints).\n  - id: objective\n    heading: '[OBJECTIVE]'\n    content: |-\n      - Generate the global pack config: extension_registry.json (version 3)\n      - Define explicit workflow dependencies, workflow entrypoints, workflow sequences, and deterministic transition checkpoints between workflows\n      - Use transitions when user intent requires a context-setting or route-setting decision before a workflow starts\n      - Output PackMetadataOutput JSON containing workflow_graph only\n  - id: context\n    heading: '[CONTEXT]'\n    content: |-\n      **Primary data source**: `workflow_bundle_results`\n      This context variable contains the completed bundle-generation results. It is a dict keyed by workflow task_id. Each entry contains a WorkflowBundleBuilderOutput payload for one workflow:\n\n      - `workflow_name`: PascalCase workflow identifier.\n      - `agent_message`: Generation confirmation.\n      - `pattern_id` / `pattern_name`: The AG2 pattern used.\n      - `files[]`: All generated bundle files.\n      - `_task_id`, `_worker_agent`, `_meta`: Task batch execution metadata.\n\n      **Supporting context variables**:\n      - `workflows_spec`: Approved pack topology \u2014 workflow names, roles, descriptions, and explicit depends_on lists.\n      - `pack_name`, `pack_partition_reason`, `is_multi_workflow`: Set by the pattern_selection tool.\n\n      **Pack Output Structure**:\n      ```\n      <pack_name>/\n        extended_orchestration/\n          extension_registry.json  # v3 dependencies + entrypoints + sequences + transitions\n        workflows/\n          <WorkflowName>/\n            orchestrator.yaml\n            agents.yaml\n            ...\n      ```\n  - id: instructions\n    heading: '[INSTRUCTIONS]'\n    content: |-\n      0. **Read `workflow_bundle_results`**:\n         - Iterate over every entry (skip `_meta`).\n         - Cross-reference with `workflows_spec` to confirm all expected workflows have a completed bundle.\n         - Use `pack_partition_reason` to decide whether a linear journey should link the workflows in sequence.\n\n      1. **Generate `extension_registry.json`**:\n         - `pack_name`: from `pack_name` context variable\n         - `version`: 3\n         - `workflows`: one entry per workflow in `workflows_spec` with:\n           - `id` = workflow name\n           - `description` = from `WorkflowInPack.description`\n           - `startup_mode` = read from the workflow bundle's `orchestrator.yaml` `workflow_startup_mode` field:\n             - `\"BackendOnly\"` for AI-native pack workflows (review, analysis, extraction) triggered by domain events \u2014 no user session, no UI entrypoint\n             - `\"UserDriven\"` for workflows the user starts directly (entered via an entrypoint or user-choice transition)\n             - `\"AgentDriven\"` for workflows advanced through a sequence or upstream workflow route\n             - Omit (null) only when startup mode is genuinely ambiguous\n           - `interaction_mode` = first-party Mozaiks conversation taxonomy:\n             - `\"user_guided\"` for workflows where the user participates in the chat conversation\n             - `\"agent_directed\"` for workflows mainly started by an upstream sequence or transition\n             - `\"backend_only\"` for workflows triggered only by domain events\n           - `launch_behavior` = how an empty chat session should start:\n             - `\"auto_start\"` for user-reachable workflow sessions and sequence handoffs, including `UserDriven` workflows reached after a transition\n             - `\"wait_for_user\"` only when the product intentionally wants an empty chat until the user types\n             - `\"none\"` only for `BackendOnly` workflows\n           - `handoff_style` = how the transition should feel to the user:\n             - `\"continuous_chat\"` for workflow-sequence handoffs that should feel like one build conversation\n             - `\"separate_chat\"` only for deliberate standalone workflow starts\n             - `\"background\"` only for `BackendOnly` workflows"},{"checksum":"sha256:bda10f0a6df064cc8721a6b075edefd5181fd5da6b92010cbc9185171588ec0d","chunk_id":"chunk_bcf0dea2fa213f82","end_line":1318,"path":"workflows/AgentGenerator/agents.yaml","start_line":1161,"symbol_ids":[],"text":"           - `dependencies` = exactly the explicit `depends_on[]` values from the\n             matching `workflows_spec` item. Do not infer dependencies from journey\n             order, workflow role, or domain assumptions.\n         - Never use placeholder workflow ids from examples. Every workflow id must\n           exactly match a workflow_name present in `workflow_bundle_results`.\n         - Never infer `startup_mode`. Parse it from each generated bundle's\n           `orchestrator.yaml` file content.\n         - Do not make a user-reachable workflow wait in a blank chat after a\n           transition unless the user explicitly requested that experience. A\n           transition is a continuity checkpoint, and the target workflow should\n           treat seeded `context_variables` as upstream conversation state.\n\n      2. **Workflow sequences (optional)**:\n         - Only create a sequence when the pack must auto-advance through a linear chain of phases.\n         - **NEVER include a `startup_mode: BackendOnly` workflow in any sequence step.** BackendOnly workflows run when a domain event fires \u2014 they are not user journey phases.\n         - `workflow_sequences`: `id`, `description`, `steps` (ordered phases).\n         - Use one workflow per phase for serial execution.\n         - Use multiple workflows in one phase when they run in parallel.\n\n      3. **Entrypoints (optional)**:\n         - Use `entrypoints` for shell routes that enter this workflow pack.\n         - Do not put persistent product page routes here.\n         - **NEVER add an entrypoint that points directly to a `startup_mode: BackendOnly` workflow.** BackendOnly workflows are not user-reachable.\n         - Each entrypoint must declare exactly one of `transition` or `workflow`.\n\n      4. **Dependencies**:\n         - Express prerequisites on the downstream workflow's `dependencies[]`.\n         - Use `required` when the downstream workflow truly cannot start without the upstream output.\n\n      5. **Transitions**:\n         - Set `transitions` to `[]` when no user-facing journey decisions are needed.\n         - Emit surfaced transitions when user intent requires choosing app mode, participation level, approval policy, import path, or other deterministic journey variables.\n         - Canonical shell transition components: `LauncherScreen`, `ConfirmScreen`, `TransitionChoicePanel`, `TransitionChoiceCard`.\n         - Use `transition_type: \"user_choice_context\"` for context seeding, `\"user_choice_route\"` for branch routing, `\"confirm\"` for simple gates.\n\n      6. **JSON-encoded string fields** \u2014 three fields use JSON-encoded strings, not raw objects:\n         - `entrypoints[i].meta` \u2014 JSON-encode the metadata dict, or set null. Example: `\"{\\\"title\\\": \\\"Create App\\\"}\"`\n         - `transitions[i].options[j].context_variables` \u2014 JSON-encode the seeded variables dict, or set null. Example: `\"{\\\"build_mode\\\": \\\"revision\\\"}\"`\n         - `transitions[i].ui.props` \u2014 JSON-encode the presentation props dict, or set null. Example: `\"{\\\"title\\\": \\\"Choose Mode\\\"}\"`\n\n      7. **Emit Output**:\n         - Generate `PackMetadataOutput` JSON with workflow_graph only.\n\n      [OUTPUT EXAMPLE] -----  {{PATTERN_GUIDANCE_AND_EXAMPLES}}\n  - id: output_format\n    heading: '[OUTPUT FORMAT]'\n    content: |-\n      Output MUST be a valid JSON object with the following structure and NO additional text:\n\n      ```json\n      {\n        \"PackMetadata\": {\n          \"workflow_graph\": {\n            \"pack_name\": \"<string>\",\n            \"version\": 3,\n            \"description\": \"<string|null>\",\n            \"workflows\": [\n              {\n                \"id\": \"<workflow_name>\",\n                \"description\": \"<string|null>\",\n                \"startup_mode\": \"UserDriven|AgentDriven|BackendOnly|null\",\n                \"interaction_mode\": \"user_guided|agent_directed|backend_only|null\",\n                \"launch_behavior\": \"auto_start|wait_for_user|none|null\",\n                \"handoff_style\": \"continuous_chat|separate_chat|background|null\",\n                \"dependencies\": [\n                  {\"id\": \"<workflow_name>\", \"scope\": \"app|user\", \"gating\": \"required|optional\", \"reason\": \"<string|null>\"}\n                ]\n              }\n            ],\n            \"entrypoints\": [\n              {\n                \"id\": \"<string>\", \"path\": \"/<string>\", \"label\": \"<string>\",\n                \"transition\": \"<transition_id|null>\", \"workflow\": \"<workflow_id|null>\",\n                \"sequence\": null, \"requiresAuth\": true, \"order\": 1,\n                \"meta\": \"{\\\"title\\\": \\\"<route label>\\\"}\"\n              }\n            ],\n            \"workflow_sequences\": [],\n            \"transitions\": [\n              {\n                \"id\": \"<string>\", \"transition_type\": \"user_choice_context\",\n                \"ui\": {\"component\": \"LauncherScreen\", \"mode\": \"screen\", \"shell_mode\": \"focused\", \"props\": null},\n                \"options\": [\n                  {\"id\": \"<string>\", \"route_to\": \"<workflow_id>\", \"sequence\": null, \"context_variables\": \"{\\\"build_mode\\\": \\\"new\\\"}\"}\n                ]\n              }\n            ]\n          }\n        }\n      }\n      ```\n\n      `meta`, `context_variables`, and `props` are JSON-encoded strings or null \u2014 never raw objects.\n\n      **CRITICAL**: Output ONLY the raw JSON object. NO markdown fences, NO explanatory text, NO commentary.\n  max_consecutive_auto_reply: 5\n  structured_outputs_required: true\n\n- name: DownloadAgent\n  prompt_sections:\n  - id: role\n    heading: '[ROLE]'\n    content: You finalize workflow delivery by emitting a structured output that triggers the file download UI.\n  - id: objective\n    heading: '[OBJECTIVE]'\n    content: |-\n      - Emit a DownloadRequest structured output that triggers the file download UI once all upstream artifacts are ready.\n      - Keep messaging concise (<=140 chars) and module-aware, without repeating documentation.\n  - id: context\n    heading: '[CONTEXT]'\n    content: |-\n      **Upstream Dependencies**:\n      - `workflow_bundle_results`: Completed workflow bundle payloads from the task batch, keyed by workflow task_id.\n      - `workflow_bundle_validation_status`: Set by `generate_and_download`\n        after the workflow quality gate runs. `failed` means packaging was\n        blocked and the workflow bundle must be corrected before download.\n      - `workflow_bundle_semantic_drift`: Prompt-oriented drift report for\n        generated workflow YAML that loads but does not preserve requested\n        workflow meaning.\n      - `workflow_bundle_repair_status`: Set by `generate_and_download` when the\n        production quality gate schedules a bounded retry. `needs_revision`\n        schedules another bounded bundle-generation pass; `blocked` means attempts are\n        exhausted.\n  - id: instructions\n    heading: '[INSTRUCTIONS]'\n    content: |-\n      **Notes**:\n      - The generate_and_download tool reads workflow_bundle_results and pack_name, validates the generated bundles, and assembles the download automatically.\n      - Never emit file lists or detailed summaries; agent_message is for UI context only.\n\n      0. **Attachment Intent (If Any Uploads)**:\n         - Call `list_attachments` to see uploaded documents for this chat.\n         - For each upload the user wants bundled: call `set_attachment_intent` with intent=`bundle` and an automatic bundle_path (datasets/<filename> for csv/tsv/jsonl/parquet/xlsx, else assets/<filename>).\n         - If you are unsure which file the user meant, do not guess; leave as `context`.\n\n      1. **Confirm Completion**:\n         - Inspect the supplied `workflow_bundle_results` for completed bundles. Bundle validation and packaging are checked by the export tool; do not claim to have inspected data absent from your prompt.\n         - If `workflow_bundle_validation_status` is `failed`, do not invite\n           download. Summarize that the workflow bundle quality gate blocked\n           packaging and reference `workflow_bundle_validation_errors`.\n         - If `workflow_bundle_repair_status` is `needs_revision`, emit the\n           structured output normally with a concise repair message; the\n           transition graph schedules the bounded repair pass after this turn.\n\n      2. **Emit Output**:\n         - Generate `DownloadRequestOutput` JSON with a short invitation message.\n  - id: output_format\n    heading: '[OUTPUT FORMAT]'\n    content: |-\n      Output MUST be a valid JSON object with NO additional text:\n\n      ```json\n      {\"agent_message\": \"<<=140 char download invitation>\"}\n      ```\n\n      CRITICAL: Output only the JSON object; no markdown fences or commentary.\n  max_consecutive_auto_reply: 5\n  structured_outputs_required: true"},{"checksum":"sha256:7eb968158de8d024d9a143bbb54050d63834d0737e0017196699f12b7731dead","chunk_id":"chunk_02becc80e77ebcb5","end_line":269,"path":"workflows/AgentGenerator/context_variables.yaml","start_line":1,"symbol_ids":[],"text":"definitions:\n  run_build_binding:\n    type: object\n    description: Server-verified target and build lineage. Execution app_id remains the host identity.\n    source:\n      type: runtime\n      required: true\n\n  workflow_bundle_export_outcome:\n    type: string\n    authority_class: closed_writer_routing_state\n    writer_ids: [deterministic_tool]\n    persisted: true\n    source:\n      type: state\n      default: blocked\n  workflow_bundle_export_attempts:\n    type: integer\n    authority_class: closed_writer_quality_state\n    writer_ids: [deterministic_tool]\n    persisted: true\n    source:\n      type: state\n      default: 0\n  coding_participation:\n    type: string\n    description: >\n      Build participation mode chosen at the checkpoint after theme capture.\n      Relayed, not consumed here: _project_launch_context carries a key from one\n      journey step to the next only if the receiving workflow declares it, so a\n      gap anywhere between coding_journey_selector and AppGenerator drops the\n      user's answer for every step after it.\n    source:\n      type: state\n      default: guided\n  build_mode:\n    type: string\n    description: >\n      Build mode for AgentGenerator. `initial` means generate the workflow bundle\n      from scratch; `revision` means revise an existing bundle from persisted state.\n    source:\n      type: state\n      default: initial\n  workflow_sequence:\n    type: string\n    description: >\n      Active workflow sequence that launched this run, such as workflow_revision,\n      app_revision, conceptual_replan, or full_rebuild.\n    source:\n      type: state\n      default: null\n  task_run_mode:\n    type: boolean\n    description: >\n      True when AgentGenerator is running as a scoped build task inside a larger\n      task batch. Agents should skip user-facing interview/review behavior and\n      emit only the requested structured outputs.\n    source:\n      type: state\n      default: false\n  revision_scope:\n    type: string\n    description: >\n      Revision scope: patch | design | feature | core. Agents use this to\n      calibrate scope \u2014 patch stays inside owned files, feature may widen scope,\n      core reroutes earlier in the build plan.\n    source:\n      type: state\n      default: null\n  change_request_id:\n    type: string\n    description: Stable lineage id for the active revision request.\n    source:\n      type: state\n      default: null\n  revision_id:\n    type: string\n    description: Runtime-generated revision run id for the current builder revision.\n    source:\n      type: state\n      default: null\n  artifact_kind:\n    type: string\n    description: >\n      Artifact family currently being refined, such as workflow_bundle or\n      app_bundle. Seeded by the refinement control plane so AgentGenerator can\n      preserve workflow-bundle-local work and detect broader cross-artifact\n      reroutes.\n    source:\n      type: state\n      default: null\n  artifact_version_id:\n    type: string\n    description: >\n      Version id of the workflow bundle artifact being refined. Null for initial\n      generation runs. Agents use this to load the correct artifact version from\n      persistence when build_mode is revision.\n    source:\n      type: state\n      default: null\n  sequence_status:\n    type: string\n    description: >\n      Builder sequence state before the revision launch: in_progress |\n      completed | stale | revising.\n    source:\n      type: state\n      default: in_progress\n  revision_origin_workflow:\n    type: string\n    description: Workflow where the revision request originated before reroute.\n    source:\n      type: state\n      default: null\n  refinement_request:\n    type: string\n    description: >\n      Raw user-supplied refinement request text, passed through from the\n      canonical RefinementRequest. Agents read this instead of re-interviewing when\n      build_mode is revision.\n    source:\n      type: state\n      default: null\n  refinement_request_meta:\n    type: object\n    description: >\n      Full typed RefinementRequest payload persisted by the control plane.\n      Useful when downstream agents need artifact ids, source surface, or other\n      request metadata beyond the raw refinement text.\n    source:\n      type: state\n      default: null\n  screen:\n    type: string\n    description: >\n      Builder surface or screen identifier that launched the current refinement\n      request, such as studio-create. Preserved for analytics and future\n      surface-aware prompt shaping.\n    source:\n      type: state\n      default: null\n  change_intent:\n    type: object\n    description: >\n      Typed refinement classification emitted by the control plane. Contains the\n      final `revision_scope`, rationale, and layer-touch information so agents can\n      understand whether the request is local, design-scoped, feature-extending,\n      or concept-revising.\n    source:\n      type: state\n      default: null\n  impact_set:\n    type: object\n    description: >\n      Typed downstream impact summary emitted by the control plane. Contains\n      affected workflows, affected declarative families, restart_from, and\n      rebuild/replanning flags for the current refinement request.\n    source:\n      type: state\n      default: null\n  llm_profile:\n    type: string\n    description: >\n      Advisory LLM profile name injected by the control plane when the\n      active workflow_sequence requires stronger reasoning (conceptual_replan\n      or full_rebuild). Maps to a named profile in ai.json llm_profiles.\n      Null for patch, design, and feature routes. Advisory only.\n    source:\n      type: state\n      default: null\n  context_graph_pack:\n    type: object\n    description: >\n      Compact Context Graph prompt pack loaded by the before_chat lifecycle\n      tool. Contains the prompt-safe graph status, relevant paths, matched\n      nodes, relationship hints, warnings, and semantic annotation targets.\n      This is advisory code-context intelligence, not routing or execution\n      authority.\n    source:\n      type: state\n      default: null\n  context_graph_catalog:\n    type: object\n    description: >\n      Rich machine-readable Context Graph catalog for diagnostics and tooling.\n      This is intentionally distinct from context_graph_pack. Populated by\n      load_context_graph_context when a current app context graph or artifact\n      workspace graph is available.\n    source:\n      type: state\n      default: null\n  context_graph_status:\n    type: string\n    description: >\n      Startup load status for Context Graph prompt packs: loaded, unavailable,\n      or null when the loader has not run.\n    source:\n      type: state\n      default: null\n  context_graph_reason:\n    type: string\n    description: >\n      Specific Context Graph load reason such as missing_app_id,\n      current_app_context_graph_unavailable, or context_refresh_prior_version.\n      Null when graph prompt context loaded without a special condition.\n    source:\n      type: state\n      default: null\n  context_graph_warnings:\n    type: array\n    description: Warnings emitted while loading Context Graph context.\n    source:\n      type: state\n      default: []\n  context_graph_health:\n    type: object\n    description: >\n      Deterministic Context Graph load health and coverage metadata, including\n      scan limits, selected file counts, parser availability, and skipped-file\n      counts when a local source scan was performed.\n    source:\n      type: state\n      default: null\n  current_app_context_version_id:\n    type: string\n    description: >\n      Current AppContextVersion id evaluated before a revision workflow starts.\n      Revision agents use this as the durable handle for source-backed App\n      Intelligence, Context Graph, and source retrieval tools.\n    source:\n      type: state\n      default: null\n  app_context_summary:\n    type: object\n    description: >\n      Prompt-safe summary of the current AppContextVersion, including artifact\n      refs, source refs, ownership boundaries, stale status, and warnings.\n      This is context authority for revision startup, not raw source content.\n    source:\n      type: state\n      default: null\n  app_context_required:\n    type: boolean\n    description: >\n      True when this run is a refinement or revision route that must have a\n      current AppContextVersion before agents perform build or edit work.\n    source:\n      type: state\n      default: false\n  app_type:\n    type: string\n    description: >\n      Entry path selected at the app_type_selector gate. `greenfield_app`\n      starts from a new concept; `brownfield_app` enhances a connected or\n      discovered existing application.\n    source:\n      type: state\n      default: \"greenfield_app\"\n  app_intelligence_ready:\n    type: boolean\n    description: True when startup loaded an App Intelligence catalog.\n    source:\n      type: state\n      default: false\n  app_intelligence_status:\n    type: string\n    description: Startup load status for App Intelligence context.\n    source:\n      type: state"},{"checksum":"sha256:399508d0e71a4a20a604ea069a55389d7e5acb628568fd6d825dfad1c3d99641","chunk_id":"chunk_fe10cbe24603dd83","end_line":529,"path":"workflows/AgentGenerator/context_variables.yaml","start_line":270,"symbol_ids":[],"text":"      default: null\n  app_intelligence_summary:\n    type: string\n    description: Compact human-readable summary of indexed source coverage.\n    source:\n      type: state\n      default: null\n  app_intelligence_health:\n    type: object\n    description: App Intelligence coverage, scan health, and startup warnings.\n    source:\n      type: state\n      default: null\n  app_intelligence_catalog:\n    type: object\n    description: >\n      Prompt-safe App Intelligence catalog containing architecture, capability,\n      ownership, integration, data, and risk summaries. Exact code is not\n      embedded here; agents use source retrieval tools for selected files.\n    source:\n      type: state\n      default: null\n  source_context_catalog:\n    type: object\n    description: >\n      Prompt-safe source corpus catalog for indexed files, chunks, symbols, and\n      imports. It is an index for retrieval, not full source content.\n    source:\n      type: state\n      default: null\n  brownfield_build_path:\n    type: string\n    description: >\n      Selected brownfield build path from brownfield_path_selector. One of\n      \"light_integration\" (Add AI Workflows: preserve the existing app as\n      source of truth and generate app-aware AI workflows, chat surfaces, and\n      only required safe adapters around approved capabilities) or\n      \"full_migration\" (Build App Features: generate Mozaiks-owned modules,\n      workflows, pages, data contracts, and extended functionality for\n      explicitly approved expansion scope). Null for greenfield builds.\n    source:\n      type: state\n      default: null\n  adoption_plan:\n    type: object\n    description: >\n      Canonical AdoptionPlan from ExistingAppDiscovery \u2014 recommended_path,\n      phases, candidate_overlays, candidate_adapters, candidate_migrations, and\n      human_decisions_required. Present only for brownfield builds. Planning\n      agents scope generation work to approved surfaces declared here.\n    source:\n      type: state\n      default: null\n  ownership_boundary:\n    type: object\n    description: >\n      Canonical ownership_boundary artifact from ExistingAppDiscovery \u2014\n      app_id and ownership_boundaries[] listing each discovered surface with\n      its ownership class (read_only_discovered, generated_overlay, etc.),\n      allowed_operations, and requires_review flag. Present only for brownfield\n      builds. Agents must not propose changes to read_only_discovered surfaces.\n    source:\n      type: state\n      default: null\n  brownfield_registration:\n    type: object\n    description: >\n      BrownfieldRegistration record from ExistingAppDiscovery \u2014 registration_id,\n      app_id, source_refs, context_version_id, scan_policy_ref, and status.\n      Present only for brownfield builds. Used as the provenance anchor for\n      generated overlays and adapters.\n    source:\n      type: state\n      default: null\n  context_aware:\n    type: boolean\n    description: Flag indicating if the application is opensource (in which the llm\n      will ask for context) or part of an existing product in which the agent will be\n      seeded with initial context\n    source:\n      type: config\n      env_var: CONTEXT_AWARE\n      default: true\n  concept_overview:\n    type: string\n    description: Main project description and overview from the database\n    source:\n      type: data_reference\n      database_name: mozaiksai\n      collection: BuilderConcepts\n      query_template:\n        app_id: '{{run_build_binding.target_app_id}}'\n      fields:\n      - ConceptOverview\n  concept_api_endpoints:\n    type: array\n    description: Optional API endpoints blueprint from the BuilderConcepts collection (produced\n      by ValueEngine).\n    source:\n      type: data_reference\n      database_name: mozaiksai\n      collection: BuilderConcepts\n      query_template:\n        app_id: '{{run_build_binding.target_app_id}}'\n      fields:\n      - ApiEndpoints\n      default: []\n  concept_blueprint:\n    type: object\n    description: Optional structured blueprint from the BuilderConcepts collection (produced\n      by ValueEngine).\n    source:\n      type: data_reference\n      database_name: mozaiksai\n      collection: BuilderConcepts\n      query_template:\n        app_id: '{{run_build_binding.target_app_id}}'\n      fields:\n      - Blueprint\n      default: null\n  backend_design_document:\n    type: string\n    description: >\n      Canonical backend design doc from DesignDocs. Human-readable reference for\n      workflow/event rationale and API intent.\n    source:\n      type: data_reference\n      database_name: mozaiksai\n      collection: DesignDocuments\n      query_template:\n        app_id: '{{run_build_binding.target_app_id}}'\n        kind: backend\n        status: succeeded\n      fields:\n      - content\n      default: null\n  experience_spec_document:\n    type: string\n    description: >\n      Canonical persistent UI intent document from DesignDocs (saved as\n      `ui_schema`). Human-readable reference for persistent UI ownership and\n      workflow touchpoints.\n    source:\n      type: data_reference\n      database_name: mozaiksai\n      collection: DesignDocuments\n      query_template:\n        app_id: '{{run_build_binding.target_app_id}}'\n        kind: ui_schema\n        status: succeeded\n      fields:\n      - content\n      default: null\n  design_surface_map:\n    type: object\n    description: >\n      Canonical typed surface realization contract persisted by DesignDocs.\n      This is the primary machine-readable source for deciding which surfaces\n      are workflows versus modules, control-plane concerns, integrations, or UI-only.\n    source:\n      type: data_reference\n      database_name: mozaiksai\n      collection: DesignDocuments\n      query_template:\n        app_id: '{{run_build_binding.target_app_id}}'\n        kind: backend\n        status: succeeded\n      fields:\n      - surface_map\n      default: null\n  subscription_contract:\n    type: object\n    description: >\n      Provider-neutral SubscriptionContractOutput produced by\n      SubscriptionContractDesigner in the current workflow sequence, when present.\n      WorkflowBundleBuilderAgent uses it to declare workflow metering surfaces\n      without implementing a custom token ledger.\n    source:\n      type: state\n      default: null\n  subscription_contract_artifact:\n    type: object\n    description: >\n      Latest persisted subscription_contract summary artifact. Used as a fallback\n      when the current sequence did not carry subscription_contract in state.\n    source:\n      type: data_reference\n      database_name: mozaiksai\n      collection: ArtifactVersions\n      query_template:\n        app_id: '{{run_build_binding.target_app_id}}'\n        build_family: subscription_contract\n        build_key: subscription_contract\n        lifecycle_status: current\n      fields:\n      - commit_metadata\n      default: null\n  monetization_enabled:\n    type: boolean\n    description: Flag indicating if monetization features are enabled\n    source:\n      type: config\n      env_var: MONETIZATION_ENABLED\n      default: false\n  builder_options:\n    type: object\n    description: Optional app-agnostic builder UI option payload carried through workflow sequences.\n    source:\n      type: state\n      default: null\n  context_include_schema:\n    type: boolean\n    description: Flag indicating if database schema access is enabled for this workflow\n    source:\n      type: config\n      env_var: CONTEXT_INCLUDE_SCHEMA\n      default: false\n  context_schema_db:\n    type: string\n    description: Name of the database this workflow has schema access to\n    source:\n      type: config\n      env_var: CONTEXT_SCHEMA_DB\n      default: null\n  interview_outcome:\n    type: string\n    authority_class: closed_writer_routing_state\n    writer_ids: [deterministic_tool]\n    persisted: true\n    description: Validated interview readiness, not inferred from chat text.\n    source:\n      type: state\n      default: needs_input\n  pattern_selection_feedback:\n    type: string\n    description: Validation feedback from the last rejected workflow partition. Correct it without changing the canonical design boundary.\n    source:\n      type: computed\n      default: ''\n  pattern_selection_outcome:\n    type: string\n    authority_class: closed_writer_routing_state\n    writer_ids: [deterministic_tool]\n    persisted: true\n    description: Declared result of validating the workflow partition.\n    source: {type: state, default: blocked}\n  pattern_selection_attempts:\n    type: integer\n    authority_class: closed_writer_quality_state\n    writer_ids: [deterministic_tool]\n    persisted: true\n    description: Runtime-owned count of workflow partition validation attempts.\n    source: {type: state, default: 0}\n  PatternSelection:\n    type: object\n    description: Validated PatternSelection structured output used for review and dispatch.\n    source: {type: computed, default: null}\n  workflow_review_outcome:\n    type: string\n    authority_class: closed_writer_routing_state"},{"checksum":"sha256:eb3a50b4600f8e8200e5400a5fab1e579b6aac980674b11de47f4f4efcbf9f17","chunk_id":"chunk_297bc8240350d86f","end_line":782,"path":"workflows/AgentGenerator/context_variables.yaml","start_line":530,"symbol_ids":[],"text":"    writer_ids: [deterministic_tool]\n    persisted: true\n    description: Declared result of the current draft-bound workflow plan review.\n    source: {type: state, default: blocked}\n  workflow_review_attempts:\n    type: integer\n    authority_class: closed_writer_quality_state\n    writer_ids: [deterministic_tool]\n    persisted: true\n    description: Runtime-owned bounded count of workflow plan review attempts.\n    source: {type: state, default: 0}\n  workflow_plan_review:\n    type: object\n    description: Current review id, selection hash, decision, and feedback. Not application meaning.\n    source: {type: computed, default: null}\n  workflow_review_feedback:\n    type: string\n    description: Human feedback from the latest structured workflow plan review.\n    source: {type: computed, default: ''}\n  connector_inventory:\n    type: object\n    description: >\n      App-scoped connector inventory derived from platform-owned connector metadata.\n      Summarizes which required integrations are already ready, which are metadata-only,\n      and which are still missing for this workflow run.\n    source:\n      type: computed\n      default: null\n  required_connector_services:\n    type: array\n    description: Normalized list of third-party services required by the approved action plan.\n    source:\n      type: computed\n      default: []\n  ready_connector_services:\n    type: array\n    description: >\n      Normalized list of required services that already have reusable connector secrets\n      available to this runtime.\n    source:\n      type: computed\n      default: []\n  missing_connector_services:\n    type: array\n    description: >\n      Normalized list of required services that still need user input or durable\n      secret storage before the workflow can use them directly.\n    source:\n      type: computed\n      default: []\n  download_complete:\n    type: boolean\n    description: True when user accepts workflow download and completes the session.\n      Triggers workflow termination.\n    source:\n      type: state\n      default: false\n      triggers:\n      - type: ui_response\n        tool: generate_and_download\n        response_key: download_accepted\n  attachments_allow_bundling:\n    type: boolean\n    description: Workflow-level flag. When true, attachments tagged as bundle/deliverable\n      may be included in the generated deliverable. When false, uploads remain context-only.\n    source:\n      type: config\n      env_var: AGENTGEN_ATTACHMENTS_ALLOW_BUNDLING\n      default: false\n  chat_attachments:\n    type: array\n    description: List of uploaded attachments persisted on the current ChatSessions\n      document (metadata only). Used by InterviewAgent to ask whether uploads are context-only\n      vs bundled, and by downstream agents to tag intent/bundle_path.\n    source:\n      type: data_reference\n      database_name: mozaiksai\n      collection: ChatSessions\n      query_template:\n        app_id: '{{runtime.app_id}}'\n        _id: '{{runtime.chat_id}}'\n      fields:\n      - attachments\n  is_multi_workflow:\n    type: boolean\n    description: True if PatternAgent determined the solution requires multiple workflows\n      (a workflow pack). Set by the pattern_selection tool after PatternAgent runs.\n    source:\n      type: computed\n      default: false\n  pack_name:\n    type: string\n    description: Name of the workflow pack (Title Case). Set by the pattern_selection\n      tool. Used for metadata generation and folder naming.\n    source:\n      type: computed\n      default: null\n  pack_partition_reason:\n    type: string\n    description: Rationale for zero or multiple workflows; optional for a single workflow.\n    source:\n      type: computed\n      default: null\n  workflows_spec:\n    type: array\n    description: >\n      Array of WorkflowInPack items from PatternAgent's PatternSelection output.\n      Each item includes name, role, pattern_id, pattern_name, description,\n      initial_agent, and initial_message. Consumed by the task_batches.yaml executor\n      to fan out WorkflowBundleBuilderAgent workers in parallel.\n    source:\n      type: computed\n      default: []\n  macro_workflow_graph:\n    type: object\n    description: Cross-workflow registry loaded from workflows/extended_orchestration/extension_registry.json.\n      Used by PatternAgent to align workflow partition decisions with the runtime's pack\n      orchestration graph.\n    source:\n      type: file\n      path: workflows/extended_orchestration/extension_registry.json\n      format: json\n      default: null\n  workflow_bundle_results:\n    type: object\n    description: >\n      Dict of completed WorkflowBundleBuilderOutput entries from the task_batches.yaml\n      executor. Keyed by workflow task_id (snake_case workflow name). Each value contains\n      workflow_name, pattern_id, pattern_name, files[], agent_message, and task batch\n      metadata (_task_id, _worker_agent, _owned_paths). Also contains a `_meta` entry\n      with batch execution summary. Consumed by PackMetadataAgent and DownloadAgent.\n    source:\n      type: state\n      default: null\n  workflow_bundle_status:\n    type: string\n    description: >\n      Status of the workflow_generation_tasks batch set by the task_batches.yaml\n      executor: pending | running | completed | failed. Consumed by PackMetadataAgent\n      to confirm all bundles are ready before synthesising the pack graph.\n    source:\n      type: state\n      default: null\n  workflow_bundle_validation_status:\n    type: string\n    description: >\n      Production quality gate status set by generate_and_download. passed means\n      the bundle can be packaged; failed means repair or operator review is needed.\n    source:\n      type: computed\n      default: null\n  workflow_bundle_validation_errors:\n    type: array\n    description: Blocking workflow bundle quality gate errors.\n    source:\n      type: computed\n      default: []\n  workflow_bundle_validation_warnings:\n    type: array\n    description: Non-blocking workflow bundle quality gate warnings.\n    source:\n      type: computed\n      default: []\n  workflow_bundle_quality_gate:\n    type: object\n    description: Full workflow bundle quality gate result from generate_and_download.\n    source:\n      type: computed\n      default: null\n  workflow_bundle_semantic_drift:\n    type: object\n    description: Prompt-oriented semantic drift report for generated workflow bundles.\n    source:\n      type: computed\n      default: null\n  workflow_bundle_repair_status:\n    type: string\n    description: >\n      Bounded repair loop status for generated workflow bundles. One of\n      needs_revision | merged | passed | blocked.\n    source:\n      type: computed\n      default: null\n  workflow_bundle_repair_active:\n    type: boolean\n    description: True while a narrowed workflow repair task batch is in progress.\n    source:\n      type: computed\n      default: false\n  workflow_bundle_repair_count:\n    type: integer\n    description: Number of workflow bundle repair attempts already scheduled.\n    source:\n      type: computed\n      default: 0\n  workflow_bundle_repair_max_attempts:\n    type: integer\n    description: Maximum automated workflow bundle repair attempts before blocking.\n    source:\n      type: computed\n      default: 2\n  workflow_bundle_repair_failed_workflows:\n    type: array\n    description: Workflow names selected for the current repair pass.\n    source:\n      type: computed\n      default: []\n  workflow_bundle_repair_request:\n    type: string\n    description: Focused repair instruction generated from quality gate failures.\n    source:\n      type: computed\n      default: null\n  workflow_bundle_repair_result:\n    type: object\n    description: Full repair scheduling result.\n    source:\n      type: computed\n      default: null\n  workflow_bundle_repair_base_results:\n    type: object\n    description: Preserved pre-repair workflow_bundle_results for merge after the repair batch completes.\n    source:\n      type: computed\n      default: null\n  workflow_bundle_repair_original_workflows_spec:\n    type: array\n    description: Original full workflows_spec restored after a narrowed repair batch.\n    source:\n      type: computed\n      default: []\n  workflow_bundle_repair_merge_result:\n    type: object\n    description: Result from merging repaired workflow outputs back into the full bundle set.\n    source:\n      type: computed\n      default: null\n  workflow_integration_metadata:\n    type: object\n    description: >\n      Canonical normalized handoff metadata derived from generated workflow bundle\n      orchestrator.yaml files. Contains contract_version, bundle_name, workflows[],\n      and primary_workflow. Persisted on workflow_bundle artifacts for AppGenerator.\n    source:\n      type: computed\n      default: null\n  generated_workflow_integrations:\n    type: array\n    description: >\n      Normalized list of generated workflow integrations. Each item carries\n      workflow_name, capability_id, startup_mode, and trigger_events.\n    source:\n      type: computed"},{"checksum":"sha256:565cf4eb62280195d61065efba326a060e5fbee7efa5f6531cb53c47224ddc82","chunk_id":"chunk_0887b766735acb45","end_line":970,"path":"workflows/AgentGenerator/context_variables.yaml","start_line":783,"symbol_ids":[],"text":"      default: []\n  generated_workflow_name:\n    type: string\n    description: >\n      Canonical name of the primary generated workflow selected for downstream app\n      wiring. Null until workflow bundle assembly succeeds.\n    source:\n      type: computed\n      default: null\n  generated_workflow_capability_id:\n    type: string\n    description: >\n      Stable capability id derived from the primary generated workflow name and used\n      by AppGenerator when routing module reactions to workflow capabilities.\n    source:\n      type: computed\n      default: null\n  generated_workflow_startup_mode:\n    type: string\n    description: >\n      Startup mode declared by the primary generated workflow orchestrator.\n    source:\n      type: computed\n      default: null\n  generated_workflow_trigger_events:\n    type: array\n    description: >\n      Trigger event contracts derived from the primary generated workflow\n      orchestrator triggers block.\n    source:\n      type: computed\n      default: []\n\nagents:\n  InterviewAgent:\n    variables:\n    - build_mode\n    - workflow_sequence\n    - task_run_mode\n    - revision_scope\n    - change_request_id\n    - revision_id\n    - artifact_kind\n    - artifact_version_id\n    - sequence_status\n    - revision_origin_workflow\n    - refinement_request\n    - refinement_request_meta\n    - screen\n    - change_intent\n    - impact_set\n    - llm_profile\n    - context_aware\n    - app_context_required\n    - current_app_context_version_id\n    - app_context_summary\n    - app_type\n    - app_intelligence_ready\n    - app_intelligence_status\n    - app_intelligence_summary\n    - app_intelligence_health\n    - app_intelligence_catalog\n    - source_context_catalog\n    - brownfield_build_path\n    - adoption_plan\n    - ownership_boundary\n    - brownfield_registration\n    - concept_overview\n    - concept_api_endpoints\n    - concept_blueprint\n    - monetization_enabled\n  PatternAgent:\n    variables:\n    - workflow_review_feedback\n    - pattern_selection_feedback\n    - concept_overview\n    - concept_api_endpoints\n    - concept_blueprint\n    - design_surface_map\n    - subscription_contract\n    - subscription_contract_artifact\n    - backend_design_document\n    - experience_spec_document\n    - app_context_required\n    - current_app_context_version_id\n    - app_context_summary\n    - app_type\n    - app_intelligence_ready\n    - app_intelligence_status\n    - app_intelligence_summary\n    - app_intelligence_health\n    - app_intelligence_catalog\n    - source_context_catalog\n    - monetization_enabled\n    - macro_workflow_graph\n    - is_multi_workflow\n    - pack_name\n    - pack_partition_reason\n    - workflows_spec\n    - brownfield_build_path\n    - adoption_plan\n    - ownership_boundary\n    - brownfield_registration\n  ProjectOverviewAgent:\n    variables:\n    - concept_overview\n    - pack_name\n    - is_multi_workflow\n    - pack_partition_reason\n    - workflows_spec\n  PackBuildCoordinator:\n    variables:\n    - pack_name\n    - is_multi_workflow\n    - workflows_spec\n    - workflow_bundle_repair_status\n    - workflow_bundle_repair_request\n    - workflow_bundle_repair_failed_workflows\n  WorkflowBundleBuilderAgent:\n    variables:\n    - concept_overview\n    - concept_api_endpoints\n    - concept_blueprint\n    - design_surface_map\n    - subscription_contract\n    - subscription_contract_artifact\n    - backend_design_document\n    - experience_spec_document\n    - app_context_required\n    - current_app_context_version_id\n    - app_context_summary\n    - app_type\n    - app_intelligence_ready\n    - app_intelligence_status\n    - app_intelligence_summary\n    - app_intelligence_health\n    - app_intelligence_catalog\n    - source_context_catalog\n    - pack_name\n    - is_multi_workflow\n    - brownfield_build_path\n    - adoption_plan\n    - ownership_boundary\n    - brownfield_registration\n  PackMetadataAgent:\n    variables:\n    - build_mode\n    - revision_scope\n    - change_request_id\n    - revision_id\n    - artifact_kind\n    - artifact_version_id\n    - sequence_status\n    - revision_origin_workflow\n    - refinement_request\n    - refinement_request_meta\n    - screen\n    - change_intent\n    - impact_set\n    - is_multi_workflow\n    - pack_name\n    - pack_partition_reason\n    - workflows_spec\n    - workflow_bundle_results\n    - workflow_bundle_status\n    - workflow_bundle_repair_status\n    - workflow_bundle_repair_merge_result\n  DownloadAgent:\n    variables:\n    - is_multi_workflow\n    - pack_name\n    - pack_partition_reason\n    - workflows_spec\n    - workflow_bundle_results\n    - workflow_bundle_validation_status\n    - workflow_bundle_validation_errors\n    - workflow_bundle_quality_gate\n    - workflow_bundle_semantic_drift\n    - workflow_bundle_repair_status\n    - workflow_bundle_repair_count\n    - workflow_bundle_repair_request\n    - workflow_bundle_repair_result\n    - workflow_integration_metadata\n    - generated_workflow_integrations\n    - generated_workflow_name\n    - generated_workflow_capability_id\n    - generated_workflow_startup_mode\n    - generated_workflow_trigger_events"},{"checksum":"sha256:fa2f0b4c32af0e59ac5d68cfcf9055e5b9f6a88bec628d655266d7443cff8507","chunk_id":"chunk_9c8936642f1e3423","end_line":30,"path":"workflows/AgentGenerator/extended_orchestration/task_batches.yaml","start_line":1,"symbol_ids":[],"text":"version: 1\nbatches:\n  - id: workflow_generation_tasks\n    trigger_agent: PackBuildCoordinator\n    source:\n      kind: context_variable\n      path: workflows_spec\n      task_model: WorkflowInPack\n    worker:\n      mode: ag2_agent\n      agent_field: initial_agent\n      prompt_field: initial_message\n      context_fields:\n        - concept_overview\n        - design_surface_map\n        - backend_design_document\n        - experience_spec_document\n        - pack_name\n        - is_multi_workflow\n    execution:\n      concurrency: 4\n      dependency_field: depends_on\n      failure_policy: fail_batch\n      retry_limit: 1\n      timeout_seconds: 600\n    result:\n      context_key: workflow_bundle_results\n      status_key: workflow_bundle_status\n      merge_strategy: collect_task_outputs\n      require_owned_paths: false"},{"checksum":"sha256:15c8f84ff9015488a9e44dfc13f71f1e123244a0d91a32cad538e8ceff459b34","chunk_id":"chunk_6a9d846021b46edb","end_line":41,"path":"workflows/AgentGenerator/middleware.yaml","start_line":1,"symbol_ids":[],"text":"prompt_middleware:\n- agent: all\n  filename: hook_universal_prompts.py\n  function: inject_universal_prompts\n- agent: all\n  filename: ../_shared/context_graph/hook_context_graph.py\n  function: inject_context_graph_context\n- agent: PackMetadataAgent\n  filename: hook_primitive_catalog.py\n  function: inject_primitive_catalog\n- agent: PackMetadataAgent\n  filename: tools/hook_workflow_bundle_repair.py\n  function: merge_repaired_workflow_bundle_results\n- agent: PatternAgent\n  function: mozaiksai.core.workflow.context.projection.inject_build_context_projections\n- agent: PatternAgent\n  filename: ../_shared/subscription_contract_context.py\n  function: inject_subscription_contract_context\n- agent: PatternAgent\n  filename: tools/hook_ai_pack_archetype_context.py\n  function: inject_ai_pack_archetype_context\n- agent: WorkflowBundleBuilderAgent\n  function: mozaiksai.core.workflow.context.projection.inject_build_context_projections\n- agent: WorkflowBundleBuilderAgent\n  filename: ../_shared/subscription_contract_context.py\n  function: inject_subscription_contract_context\n- agent: WorkflowBundleBuilderAgent\n  filename: tools/hook_ai_pack_archetype_context.py\n  function: inject_ai_pack_archetype_context\n- agent: WorkflowBundleBuilderAgent\n  filename: tools/hook_workflow_archetypes_context.py\n  function: inject_workflow_archetypes_context\n- agent: PatternAgent\n  filename: ../_shared/brownfield_adoption_context.py\n  function: inject_brownfield_adoption_context\n- agent: WorkflowBundleBuilderAgent\n  filename: ../_shared/brownfield_adoption_context.py\n  function: inject_brownfield_adoption_context\n\n\n"},{"checksum":"sha256:efbae31643aac7e8c695a86640b880c91f78e07c1bf7c5581410687869ec2e9c","chunk_id":"chunk_d0e1250f1df803da","end_line":12,"path":"workflows/AgentGenerator/orchestrator.yaml","start_line":1,"symbol_ids":[],"text":"schema_version: mozaiks.orchestrator.v1\nworkflow_name: AgentGenerator\nmax_turns: 25\nhuman_in_the_loop: true\nworkflow_startup_mode: AgentDriven\norchestration_pattern: ag2_network\ninitial_message: InterviewAgent, check the approved app context for actual AI\n  requirements. Ordinary deterministic modules and pages do not require an AI\n  workflow. If no AI work is requested, emit NEXT immediately. Otherwise ask\n  only a missing question that changes the required AI workflow design.\ninitial_agent: InterviewAgent\n"},{"checksum":"sha256:b70c549bb17a2d0b7bb164f70183b4c6f5000b5df571d4258ccf6d7604b57b13","chunk_id":"chunk_ae2b1351b5f0e91e","end_line":32,"path":"workflows/AgentGenerator/smoke_responses.json","start_line":1,"symbol_ids":[],"text":"{\n  \"input_replies\": [\n    \"Users should start the workflow manually in chat whenever a support ticket needs review.\",\n    \"It should handle one ticket per run and keep revising the resolution until a human approves closing it.\",\n    \"No assets or datasets are needed for this workflow.\",\n    \"No external integrations. Keep it minimal and deterministic.\",\n    \"Use simple urgency levels: low, medium, high, and critical.\"\n  ],\n  \"default_input_reply\": \"Use the current assumptions: manual chat startup, urgency levels low/medium/high/critical, no assets, no integrations, and proceed with the workflow.\",\n  \"assistant_reply_rules\": [\n    {\n      \"contains\": \"final tweaks\",\n      \"reply\": \"No final tweaks. Proceed to workflow planning.\"\n    }\n  ],\n  \"tool_responses\": {\n    \"WorkflowPlanReview\": {\n      \"action\": \"approve\",\n      \"approved\": true\n    },\n    \"DownloadCenter\": {\n      \"status\": \"submitted\",\n      \"action\": \"download_complete\",\n      \"download_accepted\": true\n    },\n    \"*\": {\n      \"status\": \"submitted\",\n      \"action\": \"approve\",\n      \"approved\": true\n    }\n  }\n}"},{"checksum":"sha256:d75d3dbcbfc4247905df0d534f349f6c6c9e7434b8b660ceec6ae7ba0d796fc2","chunk_id":"chunk_950b86faab522e47","end_line":266,"path":"workflows/AgentGenerator/structured_outputs.yaml","start_line":1,"symbol_ids":[],"text":"schema_version: mozaiks.structured_outputs.v1\nmodels:\n  WorkflowInterviewResult:\n    type: model\n    description: A user-facing turn with readiness stated as a field, so routing never depends on parsing chat text.\n    fields:\n      agent_message:\n        type: str\n        description: The question or confirmation shown to the user. Never include routing markers such as NEXT.\n      outcome:\n        type: literal\n        values: [needs_input, ready]\n        description: >-\n          needs_input while a signal that materially changes workflow design is\n          still missing; ready once enough context exists, including when the app\n          needs no AI workflows at all.\n  AgentTool:\n    type: model\n    fields:\n      name:\n        type: str\n        description: Tool function name (snake_case). The actual callable that the\n          agent invokes.\n      integration:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: 'Third-party service this tool interacts with (PascalCase).\n          Examples: ''payment provider'', ''Slack'', ''OpenAI'', ''GitHub''. Use null for\n          tools that don''t require external API calls.'\n      purpose:\n        type: str\n        description: Brief explanation of what this tool does and why the agent\n          needs it (<=140 chars).\n      interaction_mode:\n        type: literal\n        values:\n        - inline\n        - artifact\n        - none\n        description: 'Interaction surface for this tool: inline (chat-embedded),\n          artifact (side panel or tray), none (backend-only or silent).'\n  LifecycleTool:\n    type: model\n    fields:\n      name:\n        type: str\n        description: Lifecycle tool function name (snake_case). The actual callable\n          that executes the lifecycle operation.\n      integration:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: Third-party service this lifecycle tool interacts with (PascalCase).\n          Use null for internal-only operations.\n      purpose:\n        type: str\n        description: Brief explanation of what this lifecycle operation does (<=140\n          chars).\n      trigger:\n        type: literal\n        values:\n        - before_agent\n        - after_agent\n        description: When this lifecycle operation executes relative to the agent's\n          main work.\n  SystemPromptMiddleware:\n    type: model\n    fields:\n      name:\n        type: str\n        description: Middleware function name (snake_case). The actual callable that executes\n          the prompt injection logic.\n      agent:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: Agent name this middleware applies to. Use null for global middleware.\n      trigger:\n        type: literal\n        values:\n        - prompt_middleware\n        description: Mozaiks prompt-injection trigger compiled to AG2 1.0 middleware. Runtime lifecycle work belongs in lifecycle_tools, not prompt middleware.\n      purpose:\n        type: str\n        description: Brief explanation of why this middleware is needed (<=140 chars).\n  WorkflowAgent:\n    type: model\n    fields:\n      agent_name:\n        type: str\n        description: Agent identifier (unique within the workflow)\n      objective:\n        type: str\n        description: Short human-readable description of the agent's responsibilities\n          (displayed in the UI).\n      agent_tools:\n        type: list\n        items: AgentTool\n        description: Agent-specific tools this agent can call. Each tool specifies\n          name, integration, and purpose. Use [] when no agent tools are required.\n      lifecycle_tools:\n        type: list\n        items: LifecycleTool\n        description: Lifecycle operation tools this agent executes. Each tool specifies\n          name, integration, purpose, and trigger timing. Use [] when no lifecycle\n          tools are required.\n      system_prompt_middleware:\n        type: list\n        items: SystemPromptMiddleware\n        description: System prompt middleware this agent uses for prompt modification.\n          Each entry specifies name, trigger, and purpose. Use [] when no system\n          prompt middleware is required.\n      human_interaction:\n        type: literal\n        values:\n        - none\n        - context\n        - approval\n        - feedback\n        - single\n        description: Human involvement mode for THIS SPECIFIC AGENT. none = fully\n          automated execution; context = conversational data collection or clarification;\n          approval = explicit sign-off/decision gate; feedback = non-UI iterative\n          refinement; single = one-shot invocation.\n      generation_mode:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: 'Generation mode for generator agents: allowed values text,\n          image, video, audio. Use null for non-generator agents.'\n  MermaidSequenceDiagram:\n    type: model\n    fields:\n      workflow_name:\n        type: str\n        description: Workflow name this diagram represents\n      diagram:\n        type: str\n        description: Mermaid sequence diagram beginning with sequenceDiagram, with a blank\n          line after participant declarations. Empty string when workflows_spec is empty.\n      legend:\n        type: list\n        items: str\n        description: 'Optional module legend entries (M1: Module Name). Provide\n          [] when no legend is required.'\n      notes:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: Optional notes shown below the diagram.\n      agent_message:\n        type: str\n        description: Concise invitation (<=140 chars) asking the user to review the diagram.\n  DerivedTriggerMatch:\n    type: model\n    fields:\n      equals:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: Exact string match required for the trigger (agent_text only).\n      contains:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: Substring match evaluated against emitted agent text (agent_text\n          only).\n      regex:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: Regular expression applied to emitted agent text (agent_text\n          only).\n  DerivedTrigger:\n    type: model\n    fields:\n      type:\n        type: literal\n        values:\n        - agent_text\n        - user_text\n        - ui_response\n        description: 'Trigger mode: agent_text (passive detection), user_text\n          (free-form composer reply), or ui_response (active UI tool response).'\n      agent:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: Agent whose output is monitored (required when type=agent_text).\n      match:\n        type: union\n        variants:\n        - DerivedTriggerMatch\n        - 'null'\n        description: Match conditions for agent_text and user_text triggers. Must\n          be omitted for ui_response triggers.\n      tool:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: Snake_case tool name responsible for updating the variable\n          (required when type=ui_response).\n      response_key:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: Key in the UI tool response payload whose value seeds the state\n          variable (required when type=ui_response).\n      ui_hidden:\n        type: union\n        variants:\n        - bool\n        - 'null'\n        description: Whether to hide the agent's text output from the user UI (agent_text\n          triggers only). True = [REDACTED] token (e.g. NEXT), False = [REDACTED] message.\n  ContextVariableSource:\n    type: model\n    fields:\n      type:\n        type: literal\n        values:\n        - config\n        - data_reference\n        - data_entity\n        - computed\n        - state\n        - external\n        description: >\n          Source classification for declared workflow runtime state. Use config\n          for deployment/env values, data_reference for durable reads, data_entity\n          for durable writes, computed for agent/tool outputs and canonical\n          artifacts, state for AG2 routing/session flags, and external for\n          third-party data. Do not put semantic reasoning here; reasoning belongs\n          in agents.yaml prompts and structured_outputs.yaml models.\n      env_var:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: Environment variable name (config sources only, UPPER_SNAKE_CASE).\n      default:\n        type: union\n        variants:\n        - str\n        - int\n        - bool\n        - 'null'\n        description: Fallback value when the source is unavailable (config, computed,\n          state sources).\n      required:\n        type: union\n        variants:\n        - bool\n        - 'null'"},{"checksum":"sha256:2f1d96c04288553c5b6b6ef6632c19e3320de653e8966a2bff632796ed7f0d36","chunk_id":"chunk_293f9d34a4ae2dea","end_line":563,"path":"workflows/AgentGenerator/structured_outputs.yaml","start_line":267,"symbol_ids":[],"text":"        description: Whether this config variable is required (config sources only).\n      database_name:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: Mongo database name (data_reference and data_entity sources\n          only).\n      collection:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: Mongo collection name (data_reference and data_entity sources\n          only).\n      query_template:\n        type: union\n        variants:\n        - dict\n        - 'null'\n        description: MongoDB query template with ${var} placeholders (data_reference\n          sources only).\n      fields:\n        type: union\n        variants:\n        - list\n        - 'null'\n        description: List of fields to extract from query result (data_reference\n          sources only).\n      refresh_strategy:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: 'When to refresh data: ''once'' (cache indefinitely), ''per_module''\n          (refresh each module), ''on_demand'' (refresh when requested). Data_reference\n          sources only.'\n      entity_schema:\n        type: union\n        variants:\n        - dict\n        - 'null'\n        description: JSON schema for the entity structure (data_entity sources only). The runtime writes this as `schema` in context_variables.yaml.\n      indexes:\n        type: union\n        variants:\n        - list\n        - 'null'\n        description: MongoDB index definitions for this entity (data_entity sources\n          only).\n      write_strategy:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: 'When to persist entity: ''immediate'' (on creation), ''on_module_transition'',\n          ''on_workflow_end''. Data_entity sources only.'\n      search_by:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: Field used to locate/update the entity (data_entity sources\n          only).\n      computation:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: Description of the computation logic (computed sources only).\n      inputs:\n        type: union\n        variants:\n        - list\n        - 'null'\n        description: List of input variable names required for computation (computed\n          sources only).\n      output_type:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: Expected output data type (computed sources only).\n      persist_to:\n        type: union\n        variants:\n        - dict\n        - 'null'\n        description: Optional MongoDB persistence config (computed sources only).\n      persist:\n        type: union\n        variants:\n        - bool\n        - 'null'\n        description: Whether to persist state across sessions (state sources only).\n      service:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: Third-party service name (external sources only, e.g., 'payment provider',\n          'OpenAI').\n      operation:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: API operation or endpoint (external sources only).\n      params:\n        type: union\n        variants:\n        - dict\n        - 'null'\n        description: API request parameters with ${var} placeholders (external sources\n          only).\n      auth:\n        type: union\n        variants:\n        - dict\n        - 'null'\n        description: Authentication configuration (external sources only).\n      cache:\n        type: union\n        variants:\n        - dict\n        - 'null'\n        description: Cache configuration with TTL (external sources only).\n      retry:\n        type: union\n        variants:\n        - dict\n        - 'null'\n        description: Retry policy for failed requests (external sources only).\n      triggers:\n        type: list\n        items: DerivedTrigger\n        description: Trigger definitions for state sources. Use agent_text for coordination\n          tokens, user_text for plain composer replies, and ui_response for UI tool\n          responses. Use [] for non-state types.\n        default: []\n  ContextVariableDefinitionEntry:\n    type: model\n    fields:\n      name:\n        type: str\n        description: Unique snake_case variable name.\n      type:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: Canonical data type for downstream casting (string|integer|boolean\n          etc.).\n      description:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: Human-readable declaration of what the variable stores and\n          which agent/tool/output sets it. This is contract documentation, not\n          prompt-only reasoning.\n      source:\n        type: ContextVariableSource\n        description: Source metadata describing where the value originates.\n  ContextVariableAgentExposure:\n    type: model\n    fields:\n      agent:\n        type: str\n        description: Agent name receiving these variables.\n      variables:\n        type: list\n        items: str\n        description: Variables exposed to the agent. Every name must exist in\n          ContextVariablesPlan.definitions; transition_graph.yaml ${var}\n          references and task batch result/status keys must also be declared.\n        default: []\n  ContextVariablesPlan:\n    type: model\n    fields:\n      definitions:\n        type: list\n        items: ContextVariableDefinitionEntry\n        description: Ordered list of context variable definitions (each entry includes\n          name, type, description, and source metadata). This emits\n          context_variables.yaml, the declaration layer for AG2\n          WorkflowState.context_vars.\n      agents:\n        type: list\n        items: ContextVariableAgentExposure\n        description: Agent exposure entries describing which variables are visible\n          to each agent.\n  WorkflowRenderablePrimitiveId:\n    type: literal\n    values:\n    - approval_card\n    - choice_picker\n    - confirmation_summary\n    - form_card\n    - progress_stepper\n    - record_picker\n    - file_upload_prompt\n    - diff_review\n    - action_plan_review\n    - artifact_workbench\n    - document_preview\n    - download_center\n    - comparison_board\n    - diagram_viewer\n    - table_review\n  WorkflowUIPrimitiveId:\n    type: literal\n    values:\n    - composer_reply\n    - approval_card\n    - choice_picker\n    - confirmation_summary\n    - form_card\n    - progress_stepper\n    - record_picker\n    - file_upload_prompt\n    - diff_review\n    - action_plan_review\n    - artifact_workbench\n    - document_preview\n    - download_center\n    - comparison_board\n    - diagram_viewer\n    - table_review\n  WorkflowUIRealizationId:\n    type: literal\n    values:\n    - shell_builtin\n    - shipped_component\n    - workflow_wrapper\n    - generated_component\n  UIConfig:\n    type: model\n    fields:\n      component:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: React component name (UI_Tool and UI_Surface only)\n      mode:\n        type: literal\n        values:\n        - inline\n        - artifact\n        description: Placement hint for ChatUI. Mirrors the existing tools.yaml\n          schema (inline vs artifact). Optional; omit to fall back to runtime defaults.\n      workflow_primitive:\n        type: union\n        variants:\n        - WorkflowRenderablePrimitiveId\n        - 'null'\n        description: Canonical workflow UI primitive pattern selected upstream. Null for non-UI tools.\n      realization:\n        type: union\n        variants:\n        - WorkflowUIRealizationId\n        - 'null'\n        description: >\n          Realization strategy for this UI surface. Use `shipped_component` when `component`\n          is the canonical shared workflow component, `workflow_wrapper` when a workflow-local\n          wrapper sits on top of a shipped component, `generated_component` for true workflow-local\n          custom React, and `shell_builtin` only for planning-time `composer_reply`.\n  PayloadSchemaSpec:\n    type: model\n    fields:\n      type:\n        type: str\n        description: JSON Schema type string for the payload root (e.g. \"object\", \"string\", \"array\").\n      description:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: Optional human-readable description of the payload shape.\n      required:\n        type: union\n        variants:\n        - list\n        - 'null'\n        description: Optional list of required property names when type is \"object\".\n  UIToolAction:\n    type: model\n    fields:\n      id:\n        type: str\n        description: Stable action id emitted by the UI component (e.g., approve, reject, submit).\n      label:\n        type: union\n        variants:\n        - str\n        - 'null'"},{"checksum":"sha256:af12c876f1863695d77ccbabea13910778898b0c11fd16a3fbdc25ae66d09756","chunk_id":"chunk_3ef71fab2d96aec0","end_line":821,"path":"workflows/AgentGenerator/structured_outputs.yaml","start_line":564,"symbol_ids":[],"text":"        description: Optional button label for shipped shared workflow components. If omitted, runtime derives a label from `id`.\n      description:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: Optional description of what this action represents.\n      variant:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: Optional button variant hint (for example primary, secondary, outline, ghost, danger).\n      approved:\n        type: union\n        variants:\n        - bool\n        - 'null'\n        description: Optional approval semantic used by approval-style shared primitives.\n      payload_schema:\n        type: PayloadSchemaSpec\n        description: Typed payload schema spec describing the expected payload shape for this action.\n  UIToolContract:\n    type: model\n    fields:\n      surface_kind:\n        type: literal\n        values:\n        - agent_tool\n        description: UI surface family. UI_Tool entries must use agent_tool.\n      payload_schema:\n        type: PayloadSchemaSpec\n        description: Typed payload schema spec describing the payload pushed from backend tool to UI component.\n      actions_schema:\n        type: list\n        items: UIToolAction\n        description: Allowed user actions emitted from the UI component back to the runtime.\n  ToolSpec:\n    type: model\n    fields:\n      agent:\n        type: str\n        description: Owning agent (or primary agent)\n      file:\n        type: str\n        description: Workflow-local Python module file name declared by the tool contract. Do not emit shared or undeclared helper paths.\n      function:\n        type: str\n        description: Async function inside the file\n      description:\n        type: str\n        description: [REDACTED] purpose (<=[REDACTED] chars, no secrets)\n      tool_type:\n        type: literal\n        values:\n        - UI_Tool\n        - UI_Surface\n        - Agent_Tool\n        description: Tool type. UI_Tool = interactive surface, UI_Surface = one-way surface, Agent_Tool = backend-only.\n      auto_tool_call:\n        type: union\n        variants:\n        - bool\n        - 'null'\n        description: 'Controls whether tool is automatically invoked when agent\n          produces structured output. Default: true for UI_Tool/UI_Surface, false\n          for Agent_Tool. Set true for Agent_Tools whose structured output must\n          be stored in context for downstream agents to access. Omit (null) to use defaults.'\n      ui:\n        type: UIConfig\n        description: UI metadata (component + mode). Omit or set null for Agent_Tool entries.\n      ui_contract:\n        type: union\n        variants:\n        - UIToolContract\n        - 'null'\n        description: Canonical interactive UI tool contract. Required for UI_Tool entries; null for UI_Surface and Agent_Tool entries. This is the bounded customization surface between Python and React.\n  LifecycleToolSpec:\n    type: model\n    fields:\n      trigger:\n        type: literal\n        values:\n        - before_chat\n        - after_chat\n        - before_agent\n        - after_agent\n        - on_start\n        - on_complete\n        - on_fail\n        description: |\n          Lifecycle boundary where the hook executes.\n          Turn-level: before_chat, after_chat (chat scope); before_agent, after_agent (agent scope).\n          Run-level: on_start, on_complete, on_fail (fired once per workflow run, agent must be null).\n      agent:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: Agent name when the lifecycle tool is scoped to a single agent;\n          null for chat-level hooks.\n      file:\n        type: str\n        description: Python module file name\n      function:\n        type: str\n        description: Async function inside the file\n      description:\n        type: str\n        description: [REDACTED] purpose (<=[REDACTED] chars, no secrets)\n      tool_type:\n        type: literal\n        values:\n        - UI_Tool\n        - UI_Surface\n        - Agent_Tool\n        description: Classification for parity with runtime loader.\n      ui:\n        type: UIConfig\n        description: Optional UI metadata when lifecycle operations surface a UI_Tool\n          or UI_Surface (matches tools.yaml).\n  MiddlewareFile:\n    type: model\n    fields:\n      filename:\n        type: str\n        description: Workflow-local middleware file name (e.g., validate_budget.py, audit_decisions.py). Middleware files are file-backed contract stubs, not freeform extras.\n      py_content:\n        type: str\n        description: Complete Python code for middleware function\n  PromptSection:\n    type: model\n    description: Content container for a single prompt section (id + heading + text)\n    fields:\n      id:\n        type: str\n        description: Section identifier (role, objective, context, instructions,\n          examples, output_format)\n      heading:\n        type: str\n        description: Section heading as displayed in system message (UPPERCASE with\n          [BRACKETS])\n      content:\n        type: str\n        description: >\n          Self-contained role, reasoning instructions, or output contract. Describe\n          inputs by meaning and exact supplied fields, never by a producer agent's\n          name or assumed conversation history. Context paths must be populated and\n          exposed to the consuming agent; model names do not imply input wrappers.\n  AgentDefinition:\n    type: model\n    fields:\n      name:\n        type: str\n        description: Agent variable name\n      display_name:\n        type: str\n        description: Agent display name\n      prompt_sections:\n        type: list\n        items: PromptSection\n        description: >\n          Ordered prompt sections describing the role, actual input delivery,\n          required reasoning, and response shape. Include all instructions needed\n          for this agent's task; do not assume an undeclared middleware injection.\n      max_consecutive_auto_reply:\n        type: int\n        default: 10\n      structured_outputs_required:\n        type: bool\n        description: True when the agent must produce structured outputs (Pydantic\n          model enforced); false otherwise.\n  TransitionConditionType:\n    type: literal\n    values:\n    - context_equals\n    - context_expression\n    - tool_called\n  WorkflowTerminationReason:\n    type: literal\n    values: [workflow_complete, workflow_failed]\n  TransitionRule:\n    type: model\n    fields:\n      source_agent:\n        type: str\n        description: Source agent name\n      target_agent:\n        type: str\n        description: Target agent name or 'user' or 'terminate'\n      transition_type:\n        type: literal\n        values:\n        - condition\n        - after_turn\n        description: 'Type of transition: ''condition'' for immediate deterministic\n          context evaluation, ''after_turn'' for post-agent-completion evaluation'\n      condition_type:\n        type: union\n        variants:\n        - TransitionConditionType\n        - 'null'\n        description: >\n          Condition evaluation method for transition_type=condition. Use\n          context_equals for AG2 ContextEquals routing over a declared\n          context variable, context_expression for composite AG2\n          context-expression routing over declared `${context_variable}`\n          references, tool_called for AG2 ToolCalled routing, and null only for\n          unconditional after_turn transitions.\n      condition_key:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: Declared context variable name for condition_type=context_equals; null otherwise.\n      condition_value:\n        type: union\n        variants:\n        - str\n        - int\n        - bool\n        - 'null'\n        description: Exact value matched by AG2 ContextEquals for condition_type=context_equals; null otherwise.\n      context_expression:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: Mozaiks context_expression string for condition_type=context_expression; null otherwise.\n      tool_name:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: Routing tool name for condition_type=tool_called; null otherwise.\n      transition_target:\n        type: literal\n        values:\n        - AgentTarget\n        - RevertToUserTarget\n        - TerminateTarget\n        description: Type of transition target\n      termination_reason:\n        type: union\n        variants: [WorkflowTerminationReason, 'null']\n        description: Only for target_agent=terminate. workflow_failed records failure; null defaults to workflow_complete.\n  StructuredModelField:\n    type: model\n    fields:\n      name:\n        type: str\n        description: Field name\n      type:\n        type: str\n        description: Field type (str|int|bool|list|union with variants)\n      description:\n        type: str\n        description: What this field represents"},{"checksum":"sha256:6b1fa96e49b48bb82cc7848b8ba529dd09d1391ee46341174c7c810dcea74d1d","chunk_id":"chunk_7eff3f7a4da091e3","end_line":1100,"path":"workflows/AgentGenerator/structured_outputs.yaml","start_line":822,"symbol_ids":[],"text":"  StructuredModelDefinition:\n    type: model\n    fields:\n      model_name:\n        type: str\n        description: Name of the model\n      fields:\n        type: list\n        items: StructuredModelField\n  AgentRegistryEntry:\n    type: model\n    fields:\n      agent:\n        type: str\n        description: Agent name\n      agent_definition:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: Model name for this agent, or null if no structured output\n          applies\n  WorkflowStage:\n    type: model\n    fields:\n      stage_name:\n        type: str\n        description: 'Workflow stage name in format ''Stage N: Strategic Purpose'''\n      stage_index:\n        type: int\n        description: Zero-based index of this workflow stage (0 = Stage 1, 1 = Stage 2,\n          etc.)\n      stage_description:\n        type: str\n        description: Strategic description of what happens in this workflow stage and why\n      pattern_id:\n        type: int\n        description: AG2 Network patternbook ID (1-9) aligned to this workflow stage.\n      pattern_name:\n        type: str\n        description: Human-readable AG2 Network patternbook label aligned to this workflow stage.\n      agents_needed:\n        type: list\n        items: str\n        description: Agent names this workflow stage requires (guidance list; full specs\n          defined in StageAgents).\n  WorkflowTaskBatchSource:\n    type: model\n    fields:\n      kind:\n        type: literal\n        values:\n        - context_variable\n        - structured_output\n        description: Where the batch executor reads task items from.\n      path:\n        type: str\n        description: Dot path to the task list, such as PlannerOutput.tasks.\n      task_model:\n        type: str\n        description: Structured output model name for each task item.\n  WorkflowTaskBatchWorker:\n    type: model\n    fields:\n      mode:\n        type: literal\n        values:\n        - ag2_agent\n        description: Worker execution mode for lightweight parallel AG2 agent calls.\n      agent_field:\n        type: str\n        description: Task item field containing the worker agent name.\n      prompt_field:\n        type: str\n        description: Task item field containing the task-specific prompt.\n      context_fields:\n        type: list\n        items: str\n        description: Task item fields copied into the worker context.\n  WorkflowTaskBatchExecution:\n    type: model\n    fields:\n      concurrency:\n        type: int\n        description: Maximum concurrent worker calls for this batch.\n      dependency_field:\n        type: str\n        description: Task item field containing prerequisite task ids.\n      failure_policy:\n        type: literal\n        values:\n        - fail_batch\n        - continue_with_available\n        - collect_errors\n        description: How the executor handles failed task items.\n      retry_limit:\n        type: int\n        description: Maximum per-task retries.\n      timeout_seconds:\n        type: union\n        variants:\n        - int\n        - 'null'\n        description: Optional per-task timeout.\n  WorkflowTaskBatchResult:\n    type: model\n    fields:\n      context_key:\n        type: str\n        description: Context variable that receives normalized task results. Must\n          be explicit and workflow-owned.\n      status_key:\n        type: str\n        description: Context variable that receives batch status. Must not use\n          hidden runtime prefixes.\n      merge_strategy:\n        type: literal\n        values:\n        - collect_task_outputs\n        - collect_outputs\n        description: Deterministic merge strategy for worker outputs.\n      require_owned_paths:\n        type: bool\n        description: Whether every task result must stay within declared owned_paths.\n  WorkflowTaskBatchSpec:\n    type: model\n    fields:\n      id:\n        type: str\n        description: Stable batch id.\n      trigger_agent:\n        type: str\n        description: Agent whose completed output makes the task source available.\n      source:\n        type: WorkflowTaskBatchSource\n        description: Task-list source for this batch.\n      worker:\n        type: WorkflowTaskBatchWorker\n        description: Worker-call mapping for each task item.\n      execution:\n        type: WorkflowTaskBatchExecution\n        description: Dependency, concurrency, and failure policy.\n      result:\n        type: WorkflowTaskBatchResult\n        description: Result keys and merge policy.\n  WorkflowTaskConveyorSpec:\n    type: model\n    fields:\n      id:\n        type: str\n        description: Stable conveyor id. Runtime writes results to `${id}_results`\n          and status to `${id}_status`.\n      decomposition_agent:\n        type: str\n        description: Agent whose structured output contains DecompositionPlan.tasks.\n          This agent breaks user intent into typed task items.\n      execution_agents:\n        type: list\n        items: str\n        description: Allowed AG2 agents that may receive decomposed task prompts.\n          Each task item chooses one of these agents through its execution_agent field.\n          Conveyor workflows that represent parallel downstream work must declare\n          at least two distinct execution agent names; repeating the same worker\n          name is semantic drift.\n      concurrency:\n        type: int\n        description: Maximum concurrent AG2 task lifecycle-wrapped worker turns for ready tasks.\n      failure_policy:\n        type: literal\n        values:\n        - fail_batch\n        - continue_with_available\n        - collect_errors\n        description: How the runtime handles failed task items.\n      retry_limit:\n        type: int\n        description: Maximum per-task retries.\n      timeout_seconds:\n        type: union\n        variants:\n        - int\n        - 'null'\n        description: Optional per-task timeout.\n      require_owned_paths:\n        type: bool\n        description: Whether every task result must stay within declared owned_paths.\n  WorkflowTaskBatchesPlan:\n    type: model\n    fields:\n      required:\n        type: bool\n        description: Whether this workflow declares workflow-local AG2 task batches.\n      mode:\n        type: literal\n        values:\n        - none\n        - ag2_conveyor\n        description: Use ag2_conveyor only when one decomposition agent can produce\n          bounded task items for parallel AG2 execution agents.\n      reason:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: Why task batching is or is not needed.\n      conveyors:\n        type: list\n        items: WorkflowTaskConveyorSpec\n        description: Canonical workflow-local decomposition conveyors. Empty when required=false.\n  WorkflowInputEvent:\n    type: model\n    fields:\n      event_type:\n        type: str\n        description: Event that may start or resume this workflow. App facts must be domain.* events owned by modules.\n      source:\n        type: literal\n        values:\n        - domain\n        - platform\n        - hosted\n        - route\n        - schedule\n        - chat\n        description: Event source family. Generic generated apps should prefer domain, route, schedule, or chat.\n      capability_id:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: Capability id that resolves to this workflow/action. Required for domain-event workflow reactions when known.\n      description:\n        type: str\n        description: Why this event should invoke or influence the workflow.\n  WorkflowModuleActionUse:\n    type: model\n    fields:\n      capability_id:\n        type: str\n        description: Module capability id the workflow calls to read or mutate durable app state.\n      module_id:\n        type: str\n        description: Module that owns the action.\n      action_id:\n        type: str\n        description: Module action id.\n      purpose:\n        type: str\n        description: Why the workflow needs this module action.\n      commits_state:\n        type: bool\n        description: True when the action mutates durable app state and therefore owns any resulting domain.* event.\n  WorkflowEmittedEvent:\n    type: model\n    fields:\n      event_type:\n        type: str\n        description: Workflow/runtime/UI event emitted by this workflow. Must not be domain.* for generic apps.\n      namespace:\n        type: literal\n        values:\n        - workflow\n        - runtime\n        - ui\n        - artifact\n        description: Event namespace owned by the workflow/runtime/UI boundary.\n      description:\n        type: str\n        description: What this event communicates.\n  WorkflowEventBoundary:\n    type: model\n    fields:\n      input_events:\n        type: list\n        items: WorkflowInputEvent\n        description: Events or routes that may start/resume this workflow. Use [] for pure user-started chat.\n      module_actions:\n        type: list\n        items: WorkflowModuleActionUse"},{"checksum":"sha256:c27e9165e8321611dd3845372c70ad8699fb0a92dadfcec81caafd557f8b1ce8","chunk_id":"chunk_0e7ddac6cbd86c62","end_line":1309,"path":"workflows/AgentGenerator/structured_outputs.yaml","start_line":1101,"symbol_ids":[],"text":"        description: Module capabilities/actions this workflow calls for durable reads or writes.\n      emitted_events:\n        type: list\n        items: WorkflowEmittedEvent\n        description: Non-domain events the workflow may emit, such as workflow checkpoints, UI reactions, and artifacts.\n      domain_event_rule:\n        type: str\n        description: Must state that workflows do not publish domain.* directly; modules publish domain.* after state commits.\n  WorkflowStrategy:\n    type: model\n    fields:\n      workflow_name:\n        type: str\n        description: Human-readable workflow name in Title Case With Spaces\n      workflow_description:\n        type: str\n        description: 'Description: When [TRIGGER], workflow [ACTIONS], resulting\n          in [VALUE]'\n      human_in_loop:\n        type: bool\n        description: 'Global flag: Does this workflow involve ANY human interaction?\n          (True for chat, False for fully automated background tasks)'\n      pattern:\n        type: list\n        items: str\n        description: List of AG2 Network patternbook labels\n      workflow_startup_mode:\n        type: literal\n        values:\n        - UserDriven\n        - AgentDriven\n        - BackendOnly\n        description: 'How the workflow is initiated: UserDriven (user speaks first),\n          AgentDriven (system/agent speaks first with context), BackendOnly (no\n          UI interaction)'\n      workflow_stages:\n        type: list\n        items: WorkflowStage\n        description: Complete workflow-stage roadmap. Must contain ALL workflow stages implied\n          by the user request (minimum 3 for complex workflows). Each stage must\n          have unique numbered prefix (Stage 1:, Stage 2:, etc.) in sequential\n          order.\n      task_batches:\n        type: WorkflowTaskBatchesPlan\n        description: Optional workflow-local AG2 task batch authoring contract.\n      event_boundary:\n        type: WorkflowEventBoundary\n        description: Explicit boundary between workflow orchestration, module-owned domain facts, UI events, and runtime events.\n  CodeFile:\n    type: model\n    fields:\n      filename:\n        type: str\n        description: Relative path (using forward slashes) where this file should\n          be written. Generated workflow code must be workflow-local; use tools/<name>.py\n          for Python tools and ui/<workflow-local-path>.jsx for workflow UI. Keep\n          workflow-local React under the workflow's own ui/ tree. Do not emit\n          paths containing _shared, parent traversal, sibling workflows, or\n          app.workflows._shared/workflows._shared references. Every emitted file\n          must satisfy a declared tool, hook, transition, or runtime-extension contract.\n      content:\n        type: str\n        description: Complete file contents with real newlines. For Python tool\n          files, keep the implementation compact, close every string literal in\n          the same file, and never truncate output. Do not escape code fences or\n          truncate output. Generated prompts must reason over actual\n          exposed context fields, task inputs, or tool results without depending on\n          named peers or unseen conversation history. Preserve machine identifiers\n          in roster, routing, tool, and structured-output registry declarations.\n      installRequirements:\n        type: list\n        items: str\n        description: External packages required for this file. Use [] when none\n          are needed.\n  RequiredContextVariable:\n    type: model\n    fields:\n      name:\n        type: str\n        description: Variable name (snake_case, e.g., 'routing_started', 'current_iteration')\n      type:\n        type: literal\n        values:\n        - config\n        - data_reference\n        - data_entity\n        - computed\n        - state\n        - external\n        description: 'Variable type: config (deployment configuration from env vars),\n          data_reference (read existing MongoDB data), data_entity (create new MongoDB\n          data), computed (business logic outputs), state (workflow orchestration\n          state with triggers), external (third-party API data with caching/retry)'\n      trigger_hint:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: Simple description of when/how this variable gets set (e.g.,\n          'Set when DownloadAgent completes download', 'User provides city name').\n          Use null when no natural language description is available.\n      purpose:\n        type: str\n        description: What this variable tracks and why it's needed (1-2 sentences)\n  WorkflowAsset:\n    type: model\n    fields:\n      attachment_id:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: If the asset was uploaded, the attachment_id from ChatSessions.attachments;\n          otherwise null. Set only when you can uniquely match the uploaded file\n          by filename (case-insensitive); otherwise leave null (no guessing).\n      filename:\n        type: str\n        description: Original filename (no paths).\n      description:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: Short user-provided description of what the asset is / how\n          it will be used.\n      usage:\n        type: literal\n        values:\n        - context\n        - bundle\n        description: Whether the asset should be used as context only, or bundled\n          into the generated app as a file.\n      asset_type:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: Optional classification (e.g., csv, pdf, image, template).\n  WorkflowUIComponent:\n    type: model\n    fields:\n      surface_kind:\n        type: literal\n        values:\n        - agent_tool\n        - transition\n        description: UI surface family for this declaration. Use agent_tool for tool-driven chat UI.\n        default: agent_tool\n      stage_name:\n        type: str\n        description: Workflow stage name or label (as surfaced in the Action Plan) where\n          this UI tool appears.\n      agent:\n        type: str\n        description: PascalCase agent expected to emit the UI tool.\n      tool:\n        type: str\n        description: Snake_case tool function name associated with the UI surface.\n      label:\n        type: str\n        description: User-facing label or CTA text so the architect narrative can\n          reference the UI affordance verbatim.\n      workflow_primitive:\n        type: WorkflowUIPrimitiveId\n        description: >\n          Canonical workflow UI primitive selected for this interaction checkpoint.\n          Use `composer_reply` for plain natural-language feedback routed through the\n          shell composer. Use the other values for structured workflow-local UI surfaces.\n      realization:\n        type: WorkflowUIRealizationId\n        description: >\n          Realization strategy for this checkpoint. Use `shell_builtin` for\n          `composer_reply`, `shipped_component` for direct shared workflow primitives,\n          `workflow_wrapper` for workflow-local wrappers over shipped primitives,\n          and `generated_component` for true workflow-local custom React.\n      component:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: >\n          PascalCase React component name. Use null for `workflow_primitive=composer_reply`.\n          For shipped workflow primitives this may be the canonical shared component\n          name (for example `ApprovalCard`, `FormCard`, `DiagramViewer`). Otherwise\n          it is the workflow-local component UIFileGenerator produces.\n      display:\n        type: literal\n        values:\n        - composer\n        - inline\n        - artifact\n        description: >\n          Visual placement and rendering strategy.\n          \"composer\" \u2014 shell-owned free-text reply lane using the main chat composer.\n            Use for plain natural-language answers or clarifications.\n          \"inline\" \u2014 agent-driven output rendered conversationally in the chat flow.\n            Use for status updates, progress steppers, single stats, short confirmations, streaming text.\n          \"artifact\" \u2014 agent-driven output rendered in a side tray or modal panel.\n            Use for complex interactive UIs: approval wizards, multi-field forms,\n            data tables with actions, diagrams, streaming action plans.\n      primitives_hint:\n        type: optional_list\n        items: str\n        description: >\n          Platform primitives to use as building blocks inside the generated React component.\n          These are pre-built components from the live shipped `chat-ui` primitive catalog.\n          UIFileGenerator imports them to avoid re-implementing common UI patterns from scratch.\n          Valid values are injected at runtime via `[SHIPPED UI PRIMITIVES]`; do not invent names.\n          Use [] when the workflow can rely directly on a shipped shared workflow component"},{"checksum":"sha256:c20960b1cd2f4f188642111463eec9530a7f1b4abc3b0fb37f9df65a1e6c7a36","chunk_id":"chunk_a17340905636e9d6","end_line":1584,"path":"workflows/AgentGenerator/structured_outputs.yaml","start_line":1310,"symbol_ids":[],"text":"          and does not need a workflow-local wrapper.\n      summary:\n        type: str\n        description: <=200 char narrative explaining what the user sees or confirms\n          at this component.\n  WorkflowInPack:\n    type: model\n    fields:\n      name:\n        type: str\n        description: Workflow name in PascalCase (e.g., 'ITSupportBot', 'KnowledgeBase')\n      role:\n        type: literal\n        values:\n        - primary\n        - supporting\n        description: 'Role in the pack: ''primary'' is the entry point, ''supporting''\n          workflows are called by primary or other workflows'\n      description:\n        type: str\n        description: Brief description of what this workflow does (<=100 chars)\n      pattern_id:\n        type: int\n        description: AG2 Network patternbook ID (1-9) for this specific workflow\n      pattern_name:\n        type: str\n        description: Human-readable AG2 Network patternbook label for this workflow\n      initial_agent:\n        type: str\n        description: Always WorkflowBundleBuilderAgent. Required by the task batch executor.\n      initial_message:\n        type: str\n        description: >\n          Scoped generation instruction for this workflow's WorkflowBundleBuilderAgent instance.\n          Include workflow_name, pattern_name, role, description, and any key design-surface\n          constraints derived from the intent. This is what the worker reads as its task prompt.\n      depends_on:\n        type: optional_list\n        items: str\n        description: >\n          Names of other workflows in this pack that must complete before this workflow\n          starts. Use PascalCase workflow names matching the name field. Empty list means\n          this workflow can run immediately in parallel with others. The task batch executor\n          uses this to build the DAG and parallelise independent workflows.\n  PatternSelection:\n    type: model\n    fields:\n      is_multi_workflow:\n        type: bool\n        description: True exactly when workflows contains more than one item. False for zero or one.\n      pack_partition_reason:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: Required non-empty rationale for zero or multiple workflows; may be null for one.\n      pack_name:\n        type: str\n        description: Name for the workflow pack (Title Case, 2-4 words). Used as\n          pack_name in manifest.\n      workflows:\n        type: list\n        items: WorkflowInPack\n        description: Only required AI workflows. Use [] for deterministic apps with no workflow\n          surfaces. Single-workflow packs have one item with role='primary'.\n  PatternSelectionOutput:\n    type: model\n    fields:\n      PatternSelection:\n        type: PatternSelection\n        description: Pack-aware pattern selection with workflow partition decision and\n          per-workflow patterns\n  WorkflowStrategyOutput:\n    type: model\n    fields:\n      WorkflowStrategy:\n        type: WorkflowStrategy\n        description: High-level workflow architecture\n  MermaidSequenceDiagramOutput:\n    type: model\n    fields:\n      MermaidSequenceDiagram:\n        type: MermaidSequenceDiagram\n        description: Diagram payload rendered for user review before approving the plan.\n  DownloadRequestOutput:\n    type: model\n    fields:\n      agent_message:\n        type: str\n        description: 'Concise message (\u2264140 chars) shown to user in download UI.\n          Example: ''Ready to download your workflow bundle?'' Keep action-oriented\n          and brief.'\n  ToolsManifestOutput:\n    type: model\n    fields:\n      tools:\n        type: list\n        items: ToolSpec\n        description: List of tool entries (mirrors tools.yaml format)\n      lifecycle_tools:\n        type: list\n        items: LifecycleToolSpec\n        description: List of lifecycle tool entries (optional, can be empty array\n          or omitted). Matches the current tools.yaml structure with explicit trigger\n          + agent metadata.\n  RuntimeAgentsOutput:\n    type: model\n    fields:\n      agents:\n        type: list\n        items: AgentDefinition\n  UIToolsFilesOutput:\n    type: model\n    fields:\n      tools:\n        type: list\n        items: CodeFile\n        description: Ordered list of UI tool files (Python async functions + React\n          components) to write to disk.\n  AgentToolsFilesOutput:\n    type: model\n    fields:\n      tools:\n        type: list\n        items: CodeFile\n        description: Ordered list of backend agent tool implementation files to\n          write to disk.\n  ContextVariablesPlanOutput:\n    type: model\n    fields:\n      ContextVariablesPlan:\n        type: ContextVariablesPlan\n        description: Complete plan with definitions dict (all variables) and agents\n          dict (exposure mappings).\n  TransitionRulesOutput:\n    type: model\n    fields:\n      transition_rules:\n        type: list\n        items: TransitionRule\n  StructuredModelsOutput:\n    type: model\n    fields:\n      models:\n        type: list\n        items: StructuredModelDefinition\n        description: Data models to capture\n      registry:\n        type: list\n        items: AgentRegistryEntry\n  OrchestrationConfigOutput:\n    type: model\n    fields:\n      workflow_name:\n        type: str\n        description: Workflow identifier\n      max_turns:\n        type: int\n        description: Maximum conversation turns\n      human_in_the_loop:\n        type: bool\n        description: Whether human interaction is required\n      workflow_startup_mode:\n        type: literal\n        values:\n        - AgentDriven\n        - UserDriven\n        - BackendOnly\n      orchestration_pattern:\n        type: str\n        default: ag2_network\n        description: Selected AG2 Network patternbook label for this workflow, or ag2_network when not specialized.\n      initial_message:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: Initial workflow message (AgentDriven/BackendOnly)\n      initial_agent:\n        type: str\n        description: Name of the first agent that receives control when the workflow\n          starts (maps to the AG2 1.0 Network initial speaker).\n      visual_agents:\n        type: optional_list\n        items: str\n        description: Agents permitted to render UI/text to the user (mirrors ui_config.yaml\n          visual_agents list). Use null for backend-only/headless workflows.\n      triggers:\n        type: list\n        items: OrchestratorTrigger\n        default: []\n        description: Runtime trigger declarations. Event triggers must reference canonical event types and must not invent app facts.\n\n  OrchestratorTrigger:\n    type: model\n    fields:\n      type:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: Trigger family such as chat, event, route, action, or schedule.\n      event:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: Canonical event type for event-driven triggers, e.g. domain.tasks.task_created.\n      capability_id:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: Capability id associated with this trigger when event-driven workflow routing is capability-based.\n      endpoint:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: Optional route endpoint for route/API-triggered workflows.\n      method:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: Optional HTTP method for route-triggered workflows.\n      description:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: Human-readable trigger purpose.\n\n  MiddlewareFilesOutput:\n    type: model\n    fields:\n      middleware_files:\n        type: list\n        items: MiddlewareFile\n        description: Array of middleware file objects (can be empty [] if no custom middleware\n          needed)\n  LifecycleRequirements:\n    type: model\n    fields:\n      before_chat:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: Name of the lifecycle hook that must run before the chat session\n          starts, or null when no initialization is required.\n      after_chat:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: Name of the lifecycle hook that runs after the workflow completes,\n          or null when no teardown is needed.\n  TenancyRequirements:\n    type: model\n    fields:\n      tenant_id:\n        type: str\n        description: Canonical tenant identifier name used for scoping (typically tenant_id).\n      app_id:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: Canonical app identifier name used for scoping (typically app_id), or null when not applicable.\n      user_id:\n        type: union\n        variants:\n        - str\n        - 'null'"},{"checksum":"sha256:029f0d317f7266624de04bc617566a8ddc8fb8dc34bd665945fb469f11f8a4a8","chunk_id":"chunk_0785d0936919f226","end_line":1893,"path":"workflows/AgentGenerator/structured_outputs.yaml","start_line":1585,"symbol_ids":[],"text":"        description: Canonical user identifier name used for scoping (typically user_id), or null when not applicable.\n      notes:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: Optional notes about scoping rules and where these identifiers must appear.\n  ConsistencyRequirements:\n    type: model\n    fields:\n      scope:\n        type: literal\n        values:\n        - session\n        - user\n        - app\n        - tenant\n        description: The intended sharing scope for stateful artifacts and data.\n      consistency_profile:\n        type: literal\n        values:\n        - realtime\n        - revalidate_on_resume\n        - eventual\n        description: Expected cross-session consistency behavior.\n      versioning_required:\n        type: bool\n        description: Whether shared state must be versioned (ETag/stateVersion) to detect conflicts/stale patches.\n      version_field:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: Name of the version field or header (e.g., stateVersion), or null when not applicable.\n      fanout_required:\n        type: bool\n        description: Whether cross-session fanout/notification is required for correctness.\n      notes:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: Optional notes about invalidation/refetch behavior and failure recovery.\n  AgentRoster:\n    type: model\n    fields:\n      agents:\n        type: list\n        items: WorkflowAgent\n        description: Ordered list of agent specifications\n  ToolPlanning:\n    type: model\n    fields:\n      agent_tools:\n        type: list\n        items: PlannedAgentTool\n        description: List of backend/logic tools required by agents.\n      lifecycle_tools:\n        type: list\n        items: LifecycleTool\n        description: Lifecycle operation tools\n      system_prompt_middleware:\n        type: list\n        items: SystemPromptMiddleware\n        description: System prompt middleware required\n      ui_requirements:\n        type: list\n        items: WorkflowUIComponent\n        description: Per-workflow-stage UI surface decisions (inline vs artifact) derived from WorkflowStrategy workflow_stages.\n  DatabaseColumn:\n    type: model\n    fields:\n      name:\n        type: str\n        description: Field name.\n      type:\n        type: literal\n        values:\n        - ObjectId\n        - String\n        - Integer\n        - Boolean\n        - Float\n        - Double\n        - Timestamp\n        - Array\n        - Object\n        description: MongoDB/BSON type.\n      itemType:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: 'For Array type: the type of items (e.g., String, ObjectId).'\n      constraints:\n        type: optional_list\n        items: str\n        description: 'Constraints like PK, Not Null, Check: IN (''val1'',''val2'').'\n  DatabaseCollectionConstraints:\n    type: model\n    fields:\n      unique:\n        type: optional_list\n        items: str\n        description: Fields that should have unique indexes.\n  DatabaseCollection:\n    type: model\n    fields:\n      name:\n        type: str\n        description: Collection name (lowercase, plural).\n      columns:\n        type: list\n        items: DatabaseColumn\n        description: Field definitions.\n      constraints:\n        type: union\n        variants:\n        - DatabaseCollectionConstraints\n        - 'null'\n        description: Collection constraints (unique indexes, etc.).\n      indices:\n        type: optional_list\n        items: str\n        description: Fields to index (non-unique).\n  DataContractDefinition:\n    type: model\n    fields:\n      collections:\n        type: list\n        items: DatabaseCollection\n        description: Array of collection intent definitions (fields + indexes).\n      access_patterns:\n        type: optional_list\n        items: str\n        description: Query/access patterns the app expects (read/write emphasis).\n  DataContractOutput:\n    type: model\n    description: Data contract bundle output (data_contract_bundle.json).\n    fields:\n      DataContract:\n        type: DataContractDefinition\n        description: Data contract (no schema/seed enforcement).\n  AgentRosterOutput:\n    type: model\n    fields:\n      AgentRoster:\n        type: AgentRoster\n        description: Agent Roster\n  ToolPlanningOutput:\n    type: model\n    fields:\n      ToolPlanning:\n        type: ToolPlanning\n        description: Tool & Hook Planning\n  PlannedAgentTool:\n    type: model\n    fields:\n      name:\n        type: str\n        description: Tool function name (snake_case).\n      agent:\n        type: str\n        description: Name of the agent that uses this tool.\n      integration:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: Third-party service (PascalCase) or null.\n      purpose:\n        type: str\n        description: Brief explanation of tool functionality.\n      interaction_mode:\n        type: literal\n        values:\n        - inline\n        - artifact\n        - none\n        description: 'Interaction surface: inline (chat), artifact (panel), none\n          (backend).'\n  PackWorkflowEntry:\n    type: model\n    fields:\n      name:\n        type: str\n        description: Workflow name (PascalCase)\n      description:\n        type: str\n        description: Brief description of the workflow\n      role:\n        type: literal\n        values:\n        - primary\n        - supporting\n        description: Role in the pack\n      startup_mode:\n        type: literal\n        values:\n        - UserDriven\n        - AgentDriven\n        - BackendOnly\n        description: How this workflow starts\n  PackManifest:\n    type: model\n    fields:\n      pack_name:\n        type: str\n        description: Name of the workflow pack (Title Case)\n      pack_description:\n        type: str\n        description: Brief description of what the pack does\n      version:\n        type: str\n        description: Semantic version (e.g., '1.0.0')\n      entry_point:\n        type: str\n        description: Name of the primary workflow (entry point)\n      workflows:\n        type: list\n        items: PackWorkflowEntry\n        description: List of workflows in this pack\n      ui_config:\n        type: PackUIConfig\n        description: UI configuration for workflow transitions\n  PackUIConfig:\n    type: model\n    fields:\n      show_workflow_transitions:\n        type: bool\n        description: Whether to show workflow transition messages to user\n      transition_style:\n        type: literal\n        values:\n        - dropdown\n        - inline\n        - hidden\n        description: 'How to display workflow transitions: dropdown (visual stack),\n          inline (text message), hidden (seamless)'\n  PackGraphStartupMode:\n    type: literal\n    values:\n    - UserDriven\n    - AgentDriven\n    - BackendOnly\n  PackGraphInteractionMode:\n    type: literal\n    values:\n    - agent_directed\n    - user_guided\n    - backend_only\n  PackGraphLaunchBehavior:\n    type: literal\n    values:\n    - auto_start\n    - wait_for_user\n    - none\n  PackGraphHandoffStyle:\n    type: literal\n    values:\n    - continuous_chat\n    - separate_chat\n    - background\n\n  PackGraphWorkflow:\n    type: model\n    fields:\n      id:\n        type: str\n        description: Workflow id (must match workflow folder name)\n      description:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: Human-readable description\n      startup_mode:\n        type: union\n        variants:\n        - PackGraphStartupMode\n        - 'null'\n        description: >\n          How this workflow is started. UserDriven = user session initiates it and\n          it may appear in workflow_sequences and entrypoints. AgentDriven = triggered\n          by an upstream workflow sequence or route, not a direct user action. BackendOnly =\n          triggered exclusively by domain events; MUST NOT appear in workflow_sequences\n          or entrypoints. Read from the workflow bundle's orchestrator.yaml workflow_startup_mode\n          field. Leave null only when startup mode is genuinely ambiguous.\n      interaction_mode:\n        type: union\n        variants:\n        - PackGraphInteractionMode\n        - 'null'\n        default: null\n        description: >\n          First-party Mozaiks conversation taxonomy. user_guided means the user\n          participates directly in the workflow conversation. agent_directed means\n          the workflow usually starts from an upstream sequence or transition.\n          backend_only means the workflow runs from domain events without a chat\n          entrypoint. Leave null only when the default mapping from startup_mode is\n          sufficient.\n      launch_behavior:\n        type: union\n        variants:\n        - PackGraphLaunchBehavior\n        - 'null'\n        default: null\n        description: >\n          Controls whether an empty workflow chat starts immediately. Use auto_start"},{"checksum":"sha256:882eb04e925ff9668369160e995c3aa27a528b7b0a66b35f12fe023aed5d812c","chunk_id":"chunk_b6d8e3b570b043ad","end_line":2188,"path":"workflows/AgentGenerator/structured_outputs.yaml","start_line":1894,"symbol_ids":[],"text":"          for user-reachable workflow sessions and sequence handoffs, including\n          UserDriven workflows reached after a transition. Use wait_for_user only\n          for an intentionally blank chat. Use none only for BackendOnly workflows.\n      handoff_style:\n        type: union\n        variants:\n        - PackGraphHandoffStyle\n        - 'null'\n        default: null\n        description: >\n          Defines how the workflow should feel when reached from a transition or\n          sequence. continuous_chat keeps the build journey feeling like one\n          conversation. separate_chat is for deliberate standalone workflow starts.\n          background is only for BackendOnly workflows.\n      dependencies:\n        type: list\n        items: PackGraphDependency\n        description: Explicit prerequisite workflows required before this workflow can start\n  PackGraphDependency:\n    type: model\n    fields:\n      id:\n        type: str\n        description: Upstream workflow id\n      scope:\n        type: literal\n        values:\n        - user\n        - app\n        description: Scope for the prerequisite check (user or app)\n        default: app\n      gating:\n        type: literal\n        values:\n        - required\n        - optional\n        description: Whether this dependency blocks starts or is informational only\n        default: required\n      reason:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: Optional user-facing reason when blocked\n  PackGraphJourneyStep:\n    type: model\n    fields:\n      workflows:\n        type: optional_list\n        items: str\n        description: One or more workflow ids that execute in this journey phase. Omit when this phase is a transition checkpoint.\n      transition:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: Transition id for a surfaced checkpoint phase. Omit when this phase executes workflows.\n  PackGraphJourney:\n    type: model\n    fields:\n      id:\n        type: str\n        description: Journey id (stable key)\n      description:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: Optional journey description\n      steps:\n        type: list\n        items: PackGraphJourneyStep\n        description: Ordered workflow phases for the journey\n  PackGraphEntrypoint:\n    type: model\n    fields:\n      id:\n        type: str\n        description: Stable shell route id for entering a workflow journey\n      path:\n        type: str\n        description: Browser route path, starting with /\n      label:\n        type: str\n        description: User-facing route label\n      transition:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: Transition id to mount at this route. Use for entry screens.\n      workflow:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: Workflow id to start directly from this route. Use only when no transition is required.\n      sequence:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: Optional workflow_sequence id this entrypoint starts.\n      requiresAuth:\n        type: bool\n        description: Whether the route requires authentication.\n      order:\n        type: int\n        description: Route ordering for shell navigation composition.\n      meta:\n        type: optional_str\n        default: null\n        description: >\n          JSON-encoded route metadata such as title, or null when no metadata is needed.\n          Example: \"{\\\"title\\\": \\\"Create App\\\"}\"\n  PackGraphTransitionOption:\n    type: model\n    fields:\n      id:\n        type: str\n        description: Stable semantic option id\n      route_to:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: Workflow id or transition id to route to when selected. Required for all user_choice* transitions.\n      sequence:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: Optional workflow sequence override to bind when this option is selected.\n      context_variables:\n        type: optional_str\n        default: null\n        description: >\n          JSON-encoded context variables seeded when this option is selected, or null when\n          no seeding is required. Keys must be declared by the target workflow\n          context_variables.yaml. Example: \"{\\\"build_mode\\\": \\\"revision\\\"}\"\n  PackGraphShellMode:\n    type: literal\n    values:\n    - standard\n    - workspace\n    - conversation\n    - focused\n    - immersive\n    - public\n  PackGraphTransitionUI:\n    type: model\n    fields:\n      component:\n        type: str\n        description: Registered shell transition component key, never a file path\n      mode:\n        type: literal\n        values:\n        - screen\n        description: Transition render mode\n      shell_mode:\n        type: union\n        variants:\n        - PackGraphShellMode\n        - 'null'\n        default: null\n        description: >\n          Shell chrome mode while this transition is active. Use focused for setup,\n          choice, approval, and review screens unless the transition should inherit\n          normal app chrome.\n      props:\n        type: optional_str\n        default: null\n        description: >\n          JSON-encoded presentation props consumed by the selected shell component, or null\n          when the component needs no configuration. For lightweight built-in fallback tuning only;\n          prefer file-backed transition components for complex surfaces.\n          Example: \"{\\\"title\\\": \\\"Choose App Mode\\\", \\\"subtitle\\\": \\\"Select how you want to work\\\"}\"\n  PackGraphTransition:\n    type: model\n    fields:\n      id:\n        type: str\n        description: Transition id\n      transition_type:\n        type: literal\n        values:\n        - user_choice\n        - user_choice_context\n        - user_choice_route\n        - condition\n        - confirm\n        - silent\n        - progress_view\n        - prerequisite_redirect\n        description: Router transition type. Prefer user_choice_context for same-target context seeding and user_choice_route for branch routing.\n      ui:\n        type: union\n        variants:\n        - PackGraphTransitionUI\n        - 'null'\n        description: Required for user_choice and confirm transitions\n      route_to:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: Direct route target for single-route transitions only.\n      sequence:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: Optional workflow sequence to keep active for single-route transitions.\n      options:\n        type: list\n        items: PackGraphTransitionOption\n        description: Options for user choice transitions. Each option declares its own route_to and may seed context_variables.\n  WorkflowGraph:\n    type: model\n    fields:\n      pack_name:\n        type: str\n        description: Pack name\n      version:\n        type: literal\n        values:\n        - 3\n        description: Pack graph schema version\n      description:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: Optional pack description\n      workflows:\n        type: list\n        items: PackGraphWorkflow\n        description: Informational registry of workflows included in this pack\n      entrypoints:\n        type: list\n        items: PackGraphEntrypoint\n        description: Workflow-owned shell routes that enter a transition or workflow\n      workflow_sequences:\n        type: list\n        items: PackGraphJourney\n        description: Optional workflow sequences for runtime auto-advance; not entry UI\n      transitions:\n        type: list\n        items: PackGraphTransition\n        description: Optional router-driven transition surfaces between workflow phases\n  SharedContextVariable:\n    type: model\n    fields:\n      name:\n        type: str\n        description: Variable name (snake_case)\n      type:\n        type: literal\n        values:\n        - state\n        - config\n        - data_reference\n        - data_entity\n        - computed\n        - external\n        - content\n        - collection\n        description: Variable type from the 6+2 type taxonomy\n      owner:\n        type: str\n        description: Workflow that creates/owns this variable\n      consumers:\n        type: list\n        items: str\n        description: Workflows that read this variable\n      description:\n        type: str\n        description: What this variable represents\n  SharedContext:\n    type: model\n    fields:\n      variables:\n        type: list\n        items: SharedContextVariable\n        description: Variables shared across workflows\n      refresh_strategy:\n        type: literal\n        values:\n        - db_watch\n        - polling\n        - explicit\n        description: How consuming workflows detect changes\n      db_collection:\n        type: str"},{"checksum":"sha256:d0ea1b7a7114d7a4d2d78cb235208f0b47d47b6514f40fe56d70da341764b52a","chunk_id":"chunk_ef30b4c29cdba6e1","end_line":2402,"path":"workflows/AgentGenerator/structured_outputs.yaml","start_line":2189,"symbol_ids":[],"text":"        description: MongoDB collection name for shared context\n  PackMetadata:\n    type: model\n    fields:\n      workflow_graph:\n        type: WorkflowGraph\n        description: Pack graph config (v3 workflows + dependencies + optional workflow sequences) for extended_orchestration/extension_registry.json\n  PackMetadataOutput:\n    type: model\n    description: Output for pack workflow graph metadata\n    fields:\n      PackMetadata:\n        type: PackMetadata\n        description: Pack metadata wrapper\n  WorkflowUIQualityReviewRequest:\n    type: model\n    fields:\n      status:\n        type: literal\n        values:\n        - passed\n        - needs_revision\n        - blocked\n        description: Agent's expected status hint before review_workflow_ui_quality runs.\n      warnings:\n        type: optional_list\n        items: str\n        description: Warning snapshot from context, if visible to the agent.\n      revision_count:\n        type: int\n        description: Current revision count snapshot.\n        default: 0\n      max_revision_attempts:\n        type: int\n        description: Maximum automated UIFileGenerator revision loops before blocking.\n        default: 2\n      revision_request:\n        type: union\n        variants:\n        - str\n        - 'null'\n        description: Current revision request snapshot, if any.\n      agent_message:\n        type: str\n        description: Concise quality-gate message before review_workflow_ui_quality runs.\n\n  WorkflowParticipantImplementationOutput:\n    type: model\n    description: Exact agents.yaml implementation for one declared workflow.\n    fields:\n      assignment_kind:\n        type: literal\n        values:\n        - workflow_participant_implementation\n      workflow_id:\n        type: str\n        description: Canonical workflow identity supplied by the assignment.\n      agents_yaml:\n        type: str\n        description: UTF-8 agents.yaml content; topology remains compiler-owned.\n\n  WorkflowStructuredModelsOutput:\n    type: model\n    description: Exact structured_outputs.yaml implementation for one workflow.\n    fields:\n      assignment_kind:\n        type: literal\n        values:\n        - workflow_structured_models_implementation\n      workflow_id:\n        type: str\n        description: Canonical workflow identity supplied by the assignment.\n      structured_outputs_yaml:\n        type: str\n        description: UTF-8 structured_outputs.yaml content.\n\n  WorkflowToolImplementationOutput:\n    type: model\n    description: Exact Python source for one predeclared workflow tool.\n    fields:\n      assignment_kind:\n        type: literal\n        values:\n        - workflow_tool_implementation\n      workflow_id:\n        type: str\n        description: Canonical owning workflow identity supplied by the assignment.\n      tool_id:\n        type: str\n        description: Canonical tool identity supplied by the declaration.\n      tool_source:\n        type: str\n        description: UTF-8 source for the single compiler-owned tool path.\n\n  WorkflowUiImplementationOutput:\n    type: model\n    description: Exact JSX source for one predeclared workflow UI component.\n    fields:\n      assignment_kind:\n        type: literal\n        values:\n        - workflow_ui_implementation\n      workflow_id:\n        type: str\n        description: Canonical owning workflow identity supplied by the assignment.\n      component_id:\n        type: str\n        description: Canonical component identity supplied by the declaration.\n      component_source:\n        type: str\n        description: UTF-8 JSX source for the single compiler-owned UI path.\n\n  WorkflowOutcomeRoute:\n    type: model\n    fields:\n      value:\n        type: str\n        description: Exact result string returned by the operation.\n      target_agent:\n        type: str\n        description: Declared next agent, user, or terminate. error_value must route to user or terminate with workflow_failed.\n      termination_reason:\n        type: union\n        variants: [WorkflowTerminationReason, 'null']\n        description: Set workflow_failed for a failed terminal route; null for other destinations.\n\n  WorkflowOutcomePlan:\n    type: model\n    fields:\n      agent:\n        type: str\n        description: Agent with a registered structured output model and one auto-invoked operation.\n      function:\n        type: str\n        description: Exact function in the agent's tools.yaml binding.\n      context_key:\n        type: str\n        description: Operation-specific result state, materialized by the factory.\n      attempts_key:\n        type: str\n        description: Operation-specific invocation counter, materialized by the factory.\n      result_field:\n        type: str\n        description: Top-level field in the tool's returned mapping containing the outcome string.\n      error_value:\n        type: str\n        description: A route value targeting user or failed termination for exceptions, unknown results, and exhausted attempts.\n      max_attempts:\n        type: int\n        description: Total invocations per workflow execution, including the first; 1 to 100.\n      retry_on:\n        type: list\n        items: str\n        description: Known recoverable route values permitting another invocation. Empty with max_attempts=1. Never include error_value.\n      routes:\n        type: list\n        items: WorkflowOutcomeRoute\n        description: Unique exhaustive operation results and their next agents.\n\n  WorkflowBundleBuilderOutput:\n    type: model\n    description: >\n      Complete workflow bundle produced by one scoped generation task.\n      Contains all files needed to run the workflow: YAML declarations, implemented Python tools,\n      and optional UI components. Each file's filename is relative to the workflow root.\n    fields:\n      workflow_name:\n        type: str\n        description: PascalCase workflow name matching the bundle folder name.\n      agent_message:\n        type: str\n        description: One-sentence confirmation that the bundle was generated (<=140 chars).\n      pattern_id:\n        type: int\n        description: AG2 Network patternbook ID used for this workflow.\n      pattern_name:\n        type: str\n        description: Human-readable patternbook label for this workflow.\n      outcome_plans:\n        type: list\n        items: WorkflowOutcomePlan\n        description: >\n          Typed failure-handling plans for workflow operations. The factory materializes\n          their tool outcome bindings, protected context definitions, and graph routes.\n          Use [] only for workflows with no outcome-dependent operations.\n      files:\n        type: list\n        items: CodeFile\n        description: >\n          Ordered list of workflow bundle files. Must include at minimum:\n          orchestrator.yaml, agents.yaml, transition_graph.yaml, tools.yaml,\n          context_variables.yaml, structured_outputs.yaml, middleware.yaml, ui_config.yaml.\n          middleware.yaml is a prompt middleware declaration file.\n          Complete Python tool implementations go under tools/<name>.py; unfinished stubs block export.\n          UI components go under ui/<WorkflowName>/<Component>.jsx.\n  PackBuildCoordinatorOutput:\n    type: model\n    description: Thin acknowledgment confirming the workflow count before the task batch fires.\n    fields:\n      agent_message:\n        type: str\n        description: One-sentence status message confirming parallel generation is starting (<=140 chars).\n      workflow_count:\n        type: int\n        description: Number of workflow bundles that will be generated in parallel.\n\nregistry:\n  InterviewAgent: WorkflowInterviewResult\n  PatternAgent: PatternSelectionOutput\n  ProjectOverviewAgent: MermaidSequenceDiagramOutput\n  PackBuildCoordinator: PackBuildCoordinatorOutput\n  WorkflowBundleBuilderAgent: WorkflowBundleBuilderOutput\n  PackMetadataAgent: PackMetadataOutput\n  DownloadAgent: DownloadRequestOutput"},{"checksum":"sha256:627c379706a8261d72dca1b67f6081a5d8d04a12f148f0f29fa3968b37fd81ed","chunk_id":"chunk_abc937ffaa746ac1","end_line":176,"path":"workflows/AgentGenerator/tools.yaml","start_line":1,"symbol_ids":[],"text":"tools:\n- agent: InterviewAgent\n  file: record_workflow_interview.py\n  function: record_workflow_interview\n  description: Write validated interview readiness from the agent's structured output.\n  tool_type: Agent_Tool\n  auto_tool_call: true\n  bind_to_agent: false\n- agent: PatternAgent\n  file: pattern_selection.py\n  function: pattern_selection\n  description: Cache AG2 Network patternbook selection (workflows_spec, pack_name, is_multi_workflow) in context variables for the task batch executor and downstream agents.\n  tool_type: Agent_Tool\n  auto_tool_call: true\n  bind_to_agent: false\n  outcome:\n    context_key: pattern_selection_outcome\n    attempts_key: pattern_selection_attempts\n    result_field: outcome\n    values: [selected, invalid, blocked]\n    error_value: blocked\n    max_attempts: 3\n    retry_on: [selected, invalid]\n\n- agent: ProjectOverviewAgent\n  file: mermaid_sequence_diagram.py\n  function: mermaid_sequence_diagram\n  description: Review the exact workflow partition before dispatch. An approved empty partition records that no AI workflows are required.\n  tool_type: UI_Tool\n  auto_tool_call: true\n  bind_to_agent: false\n  outcome:\n    context_key: workflow_review_outcome\n    attempts_key: workflow_review_attempts\n    result_field: outcome\n    values: [approved, no_workflows, changes_requested, cancelled, blocked]\n    error_value: blocked\n    max_attempts: 3\n    retry_on: [changes_requested]\n  ui:\n    component: WorkflowPlanReview\n    mode: artifact\n    workflow_primitive: approval_card\n    realization: workflow_wrapper\n  ui_contract:\n    surface_kind: agent_tool\n    payload_schema:\n      type: object\n      required: [review_id, workflow_count, checkpoints]\n      properties:\n        review_id: {type: string}\n        workflow_count: {type: integer}\n        checkpoints: {type: array, items: {type: string}}\n        diagram: {type: string}\n      additionalProperties: true\n    actions_schema:\n    - id: approve\n      label: Approve\n      approved: true\n      variant: primary\n    - id: request_changes\n      label: Request Changes\n      approved: false\n      variant: secondary\n\n- agent: DownloadAgent\n  file: generate_and_download.py\n  function: generate_and_download\n  description: Assemble all workflow bundle files from workflow_bundle_results, zip them, and present the inline download UI.\n  tool_type: UI_Tool\n  auto_tool_call: true\n  bind_to_agent: false\n  outcome:\n    context_key: workflow_bundle_export_outcome\n    attempts_key: workflow_bundle_export_attempts\n    result_field: outcome\n    values: [ready, needs_revision, cancelled, blocked]\n    error_value: blocked\n    max_attempts: 3\n    retry_on: [needs_revision]\n  ui:\n    component: DownloadCenter\n    mode: inline\n    workflow_primitive: download_center\n    realization: shipped_component\n  ui_contract:\n    surface_kind: agent_tool\n    payload_schema:\n      type: object\n      properties:\n        title:\n          type: string\n        description:\n          type: string\n        files:\n          type: array\n      additionalProperties: true\n    actions_schema:\n    - id: download_complete\n      label: Continue\n      variant: primary\n      approved: true\n      payload_schema:\n        type: object\n        properties:\n          download_accepted:\n            type: boolean\n        additionalProperties: true\n    - id: export_to_github\n      label: Export to GitHub\n      variant: secondary\n      payload_schema:\n        type: object\n        properties:\n          repo_name:\n            type: string\n          commit_message:\n            type: string\n        additionalProperties: true\n    - id: close\n      label: Close\n      variant: ghost\n      payload_schema:\n        type: object\n        properties: {}\n        additionalProperties: true\n\n- agent: DownloadAgent\n  file: export_to_github.py\n  function: export_to_github\n  description: Export the generated bundle to GitHub via the Mozaiks Backend repo endpoints and return repo + deployment info.\n  tool_type: Agent_Tool\n  auto_tool_call: false\n\n- agent: DownloadAgent\n  file: attachments_tools.py\n  function: list_attachments\n  description: List uploaded chat attachments (metadata only).\n  tool_type: Agent_Tool\n  auto_tool_call: false\n\n- agent: DownloadAgent\n  file: attachments_tools.py\n  function: set_attachment_intent\n  description: Update an attachment's intent/bundle_path (hybrid model; gated by attachments_allow_bundling).\n  tool_type: Agent_Tool\n  auto_tool_call: false\n\nlifecycle_tools:\n- trigger: before_chat\n  agent: null\n  file: ../_shared/context_graph/load_context_graph_context.py\n  function: load_context_graph_context\n  description: Load the current compact Context Graph pack into context_variables before agent prompt hooks run.\n  tool_type: Agent_Tool\n\n- trigger: on_start\n  agent: null\n  file: tools/platform/build_lifecycle.py\n  function: emit_build_started\n  description: Notify platform build tracking when workflow run starts.\n  tool_type: Agent_Tool\n\n- trigger: on_complete\n  agent: null\n  file: tools/platform/build_lifecycle.py\n  function: emit_build_completed\n  description: Notify platform build tracking when workflow run completes.\n  tool_type: Agent_Tool\n\n- trigger: on_fail\n  agent: null\n  file: tools/platform/build_lifecycle.py\n  function: emit_build_failed\n  description: Notify platform build tracking when workflow run fails.\n  tool_type: Agent_Tool"},{"checksum":"sha256:7a0c70ab03d898b56d68e24a0a132011f481699b99072c994eb8a5dba728572b","chunk_id":"chunk_ee981211d64e21a1","end_line":9,"path":"workflows/AgentGenerator/tools/__init__.py","start_line":1,"symbol_ids":[],"text":"\"\"\"AgentGenerator tool package.\n\nTool loading is driven by ``tools.yaml`` and file-level dynamic imports in the runtime.\nThis package intentionally does not auto-import every module on import, because eager\npackage side effects make live workflow loading non-deterministic and can mask loader\nerrors with unrelated import noise.\n\"\"\"\n\n__all__: list[str] = []"},{"checksum":"sha256:bb46e1967e56bb5716c92e40030f55db0661efe332986f48f086a57f8bcf3bdc","chunk_id":"chunk_41f3af6208a21468","end_line":179,"path":"workflows/AgentGenerator/tools/ag2_patterns.py","start_line":1,"symbol_ids":["sym_3f35e79d796abeec","sym_5ded06794a55501a","sym_7a5084efc7306ad9","sym_ed0a8577c8818e2d","sym_b99078a047f53c08","sym_052589d2091cd732","sym_ca2cc42e3e2f9f58","sym_be5f8f27bdbc51a7","sym_9e1178d541123492"],"text":"\"\"\"Shared AG2 1.0 Network patternbook loader for factory workflows.\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nimport re\nfrom collections.abc import Mapping\nfrom functools import lru_cache\nfrom typing import Any\n\nimport yaml\n\nfrom factory_app.workflows._shared.hook_utils import workflow_context_path\n\nPATTERNBOOK_PATH = workflow_context_path(\"AgentGenerator\", \"ag2_network_patterns.yaml\")\n\n\ndef normalize_pattern_name(value: Any) -> str:\n    return re.sub(r\"[^a-z0-9]\", \"\", str(value or \"\").lower())\n\n\n@lru_cache(maxsize=1)\ndef load_patternbook() -> dict[str, Any]:\n    data = yaml.safe_load(PATTERNBOOK_PATH.read_text(encoding=\"utf-8\")) or {}\n    if not isinstance(data, dict):\n        raise ValueError(f\"Patternbook must be a mapping: {PATTERNBOOK_PATH}\")\n    patterns = data.get(\"patterns\")\n    if not isinstance(patterns, list) or not patterns:\n        raise ValueError(f\"Patternbook must declare non-empty patterns[]: {PATTERNBOOK_PATH}\")\n    return data\n\n\ndef list_patterns() -> list[dict[str, Any]]:\n    patterns = load_patternbook().get(\"patterns\", [])\n    return [dict(pattern) for pattern in patterns if isinstance(pattern, dict)]\n\n\ndef get_pattern_by_id(pattern_id: int | str | None) -> dict[str, Any] | None:\n    try:\n        normalized_id = int(pattern_id)  # type: ignore[arg-type]\n    except (TypeError, ValueError):\n        return None\n    for pattern in list_patterns():\n        if pattern.get(\"id\") == normalized_id:\n            return pattern\n    return None\n\n\ndef get_pattern_by_name(name: Any) -> dict[str, Any] | None:\n    normalized = normalize_pattern_name(name)\n    if not normalized:\n        return None\n    for pattern in list_patterns():\n        candidates = [\n            pattern.get(\"key\"),\n            pattern.get(\"label\"),\n            *(pattern.get(\"selection_aliases\") or []),\n        ]\n        if normalized in {normalize_pattern_name(candidate) for candidate in candidates}:\n            return pattern\n    return None\n\n\ndef build_pattern_lookup_maps() -> tuple[dict[str, int], dict[int, str], dict[int, str]]:\n    id_by_name: dict[str, int] = {}\n    name_by_id: dict[int, str] = {}\n    display_name_by_id: dict[int, str] = {}\n\n    for pattern in list_patterns():\n        pattern_id = int(pattern[\"id\"])\n        key = str(pattern[\"key\"])\n        label = str(pattern[\"label\"])\n        name_by_id[pattern_id] = key\n        display_name_by_id[pattern_id] = label\n        for candidate in [key, label, *(pattern.get(\"selection_aliases\") or [])]:\n            normalized = normalize_pattern_name(candidate)\n            if normalized:\n                id_by_name[normalized] = pattern_id\n\n    return id_by_name, name_by_id, display_name_by_id\n\n\ndef render_patternbook_summary() -> str:\n    data = load_patternbook()\n    lines = [\n        \"[AG2 NETWORK PATTERNBOOK]\",\n        \"Use this as the canonical workflow pattern catalog for AgentGenerator.\",\n        \"\",\n        \"Global rules:\",\n    ]\n    for rule in data.get(\"global_rules\") or []:\n        lines.append(f\"- {rule}\")\n\n    lines.extend([\"\", \"Patterns:\"])\n    for pattern in list_patterns():\n        lines.append(\n            f\"- {pattern['id']}. {pattern['label']} \"\n            f\"({pattern['key']}): {pattern['graph_strategy']} / {pattern['routing_idiom']} \"\n            f\"[support: {pattern['mozaiks_support']}]\"\n        )\n        signals = \", \".join(pattern.get(\"intent_signals\") or [])\n        if signals:\n            lines.append(f\"  Intent signals: {signals}.\")\n        context = \", \".join(pattern.get(\"required_context\") or [])\n        tools = \", \".join(pattern.get(\"required_tools\") or [])\n        if context or tools:\n            lines.append(f\"  Requires: context [{context or 'none'}], tools [{tools or 'none'}].\")\n        notes = pattern.get(\"generator_notes\") or []\n        if notes:\n            lines.append(f\"  Generator rule: {notes[0]}\")\n    return \"\\n\".join(lines)\n\n\ndef render_pattern_guidance(pattern_id: int | str | None) -> str:\n    pattern = get_pattern_by_id(pattern_id)\n    if not pattern:\n        return render_patternbook_summary()\n\n    lines = [\n        f\"[AG2 NETWORK PATTERN - {pattern['label']}]\",\n        f\"Pattern key: {pattern['key']}\",\n        f\"Mozaiks support: {pattern['mozaiks_support']}\",\n        f\"Graph strategy: {pattern['graph_strategy']}\",\n        f\"Routing idiom: {pattern['routing_idiom']}\",\n        \"\",\n        \"Use when:\",\n    ]\n    for signal in pattern.get(\"intent_signals\") or []:\n        lines.append(f\"- {signal}\")\n\n    lines.append(\"\")\n    lines.append(\"Avoid when:\")\n    for avoid in pattern.get(\"avoid_when\") or []:\n        lines.append(f\"- {avoid}\")\n\n    lines.append(\"\")\n    lines.append(\"AG2 1.0 primitives:\")\n    for primitive in pattern.get(\"beta_primitives\") or []:\n        lines.append(f\"- {primitive}\")\n\n    context = pattern.get(\"required_context\") or []\n    tools = pattern.get(\"required_tools\") or []\n    lines.extend(\n        [\n            \"\",\n            f\"Required context variables: {', '.join(context) if context else 'none'}\",\n            f\"Required tools: {', '.join(tools) if tools else 'none'}\",\n            \"\",\n            \"Transition generation:\",\n            f\"- Strategy: {pattern.get('transition_generation', {}).get('strategy')}\",\n        ]\n    )\n    for item in pattern.get(\"transition_generation\", {}).get(\"ordering\") or []:\n        lines.append(f\"- Ordering: {item}\")\n    terminal_rule = pattern.get(\"transition_generation\", {}).get(\"terminal_rule\")\n    if terminal_rule:\n        lines.append(f\"- Terminal rule: {terminal_rule}\")\n\n    notes = pattern.get(\"generator_notes\") or []\n    if notes:\n        lines.extend([\"\", \"Generator notes:\"])\n        for note in notes:\n            lines.append(f\"- {note}\")\n\n    return \"\\n\".join(lines)\n\n\ndef render_pattern_example(pattern_id: int | str | None, section_key: str = \"WorkflowStrategy\") -> str | None:\n    pattern = get_pattern_by_id(pattern_id)\n    if not pattern:\n        return None\n    examples = pattern.get(\"examples\")\n    if not isinstance(examples, Mapping):\n        return None\n    example = examples.get(section_key)\n    if example is None:\n        return None\n    return json.dumps(example, indent=2)\n"},{"checksum":"sha256:a17de9fc3c2d318b382a977de24093c732b3025b7a033a23616d3795f6176154","chunk_id":"chunk_c9c1b48b8602ef2c","end_line":170,"path":"workflows/AgentGenerator/tools/attachments_tools.py","start_line":1,"symbol_ids":["sym_d42f055813364739","sym_b80d0a16ab810aaf"],"text":"\"\"\"Attachment tools for AgentGenerator (hybrid model).\n\nThese tools are intentionally small and workflow-scoped:\n- They read/update ChatSessions.attachments metadata.\n- They are gated by the workflow-level flag `attachments_allow_bundling`.\n\nUploads remain context-only by default. Promoting an attachment to `bundle`\nrequires an explicit agent call (and you can place a human confirmation step\nin the agent prompt or UI if desired).\n\"\"\"\n\nimport logging\nfrom typing import Annotated, Any\n\nfrom pydantic import Field\n\nfrom mozaiksai.core.data.persistence.persistence_manager import AG2PersistenceManager\n\n_logger = logging.getLogger(\"tools.attachments\")\n\n\nasync def list_attachments(\n    *,\n    context_variables: Annotated[\n        Any | None,\n        Field(description=\"AG2-injected workflow context variables.\"),\n    ] = None,\n) -> dict[str, Any]:\n    \"\"\"List attachment metadata for the current chat.\n\n    Returns attachment records as stored on the ChatSessions document.\n    \"\"\"\n\n    chat_id = None\n    app_id = None\n    workflow_name = None\n    if context_variables and hasattr(context_variables, \"get\"):\n        chat_id = context_variables.get(\"chat_id\")\n        app_id = context_variables.get(\"app_id\")\n        workflow_name = context_variables.get(\"workflow_name\")\n\n    if not chat_id or not app_id:\n        return {\"status\": \"error\", \"message\": \"chat_id and app_id are required\"}\n\n    pm = AG2PersistenceManager()\n    coll = await pm._coll()\n    doc = await coll.find_one(\n        {\"_id\": chat_id, \"app_id\": app_id},\n        {\"attachments\": 1},\n    )\n    attachments = (doc or {}).get(\"attachments\")\n    if not isinstance(attachments, list):\n        attachments = []\n\n    # Only return metadata; never return file bytes.\n    sanitized: list[dict[str, Any]] = []\n    for att in attachments:\n        if not isinstance(att, dict):\n            continue\n        sanitized.append(\n            {\n                \"attachment_id\": att.get(\"attachment_id\"),\n                \"filename\": att.get(\"filename\"),\n                \"size_bytes\": att.get(\"size_bytes\"),\n                \"content_type\": att.get(\"content_type\"),\n                \"intent\": att.get(\"intent\"),\n                \"bundle_path\": att.get(\"bundle_path\"),\n                \"uploaded_at_utc\": att.get(\"uploaded_at_utc\"),\n                \"user_id\": att.get(\"user_id\"),\n                \"stored_path\": att.get(\"stored_path\"),\n            }\n        )\n\n    _logger.info(\"Listed %s attachments (workflow=%s chat=%s)\", len(sanitized), workflow_name, chat_id)\n    return {\"status\": \"success\", \"attachments\": sanitized, \"count\": len(sanitized)}\n\n\nasync def set_attachment_intent(\n    *,\n    AttachmentIntentUpdate: Annotated[\n        dict[str, Any],\n        Field(description=\"Attachment update payload with attachment_id, intent, and optional bundle_path.\"),\n    ],\n    agent_message: Annotated[str, Field(description=\"Short audit message.\")],\n    context_variables: Annotated[\n        Any | None,\n        Field(description=\"AG2-injected workflow context variables.\"),\n    ] = None,\n) -> dict[str, Any]:\n    \"\"\"Update an attachment's intent/bundle_path in ChatSessions.attachments.\n\n    Hybrid gating:\n    - Only allows setting intent to bundle/deliverable when\n      context_variables.attachments_allow_bundling == True.\n    \"\"\"\n\n    chat_id = None\n    app_id = None\n    workflow_name = None\n    allow_bundling = False\n\n    if context_variables and hasattr(context_variables, \"get\"):\n        chat_id = context_variables.get(\"chat_id\")\n        app_id = context_variables.get(\"app_id\")\n        workflow_name = context_variables.get(\"workflow_name\")\n        allow_bundling = bool(context_variables.get(\"attachments_allow_bundling\", False))\n\n    if not chat_id or not app_id:\n        return {\"status\": \"error\", \"message\": \"chat_id and app_id are required\"}\n\n    if not isinstance(AttachmentIntentUpdate, dict):\n        return {\"status\": \"error\", \"message\": \"AttachmentIntentUpdate must be an object\"}\n\n    attachment_id = (AttachmentIntentUpdate.get(\"attachment_id\") or \"\").strip()\n    intent = (AttachmentIntentUpdate.get(\"intent\") or \"\").strip().lower()\n    bundle_path = AttachmentIntentUpdate.get(\"bundle_path\")\n\n    if not attachment_id:\n        return {\"status\": \"error\", \"message\": \"attachment_id is required\"}\n\n    if intent not in {\"context\", \"bundle\", \"deliverable\"}:\n        return {\"status\": \"error\", \"message\": \"intent must be one of: context, bundle, deliverable\"}\n\n    # Enforce hybrid policy: bundling must be enabled to promote.\n    if intent in {\"bundle\", \"deliverable\"} and not allow_bundling:\n        return {\n            \"status\": \"error\",\n            \"message\": \"attachments_allow_bundling is false; cannot set intent to bundle/deliverable\",\n        }\n\n    # Basic path sanity (relative paths only)\n    if bundle_path is not None:\n        if not isinstance(bundle_path, str):\n            return {\"status\": \"error\", \"message\": \"bundle_path must be a string\"}\n        bundle_path = bundle_path.strip()\n        if bundle_path.startswith(\"/\") or bundle_path.startswith(\"\\\\\"):\n            return {\"status\": \"error\", \"message\": \"bundle_path must be a relative path\"}\n\n    pm = AG2PersistenceManager()\n    coll = await pm._coll()\n\n    update_doc: dict[str, Any] = {\n        \"attachments.$.intent\": intent,\n    }\n    if bundle_path is not None:\n        update_doc[\"attachments.$.bundle_path\"] = (bundle_path or None)\n\n    res = await coll.update_one(\n        {\"_id\": chat_id, \"app_id\": app_id, \"attachments.attachment_id\": attachment_id},\n        {\"$set\": update_doc},\n    )\n\n    if res.matched_count <= 0:\n        return {\"status\": \"error\", \"message\": \"attachment not found\"}\n\n    _logger.info(\n        \"Updated attachment intent (workflow=%s chat=%s attachment_id=%s intent=%s)\",\n        workflow_name,\n        chat_id,\n        attachment_id,\n        intent,\n    )\n\n    return {\n        \"status\": \"success\",\n        \"message\": agent_message or \"Attachment updated\",\n        \"attachment_id\": attachment_id,\n        \"intent\": intent,\n        \"bundle_path\": bundle_path,\n    }"},{"checksum":"sha256:74da677284070fed9ee4aacfd0c570b007b87bbb00af0f607e19862879f6c10d","chunk_id":"chunk_92c958095b24858c","end_line":200,"path":"workflows/AgentGenerator/tools/export_agent_workflow.py","start_line":1,"symbol_ids":["sym_ff953eb5ef21d0cc","sym_c33d8188f2d1ffed","sym_622c83df4f9e4d4d","sym_3fb515d1e666e23d","sym_8a173fe3cf7fbaa5","sym_abbba03fcecb8635","sym_db3ea327d9f70fc5"],"text":"\"\"\"Workflow-specific GitHub export wrapper for AgentGenerator outputs.\n\nThis wrapper:\n1) Calls the shared Mozaiks Backend deploy pipeline (export_to_github).\n2) Extracts high-level metadata from the bundle (agent + tool names).\n3) Persists an app-scoped export record for downstream workflows (e.g., AppGenerator).\n\nIt intentionally does not implement business logic beyond metadata extraction.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport zipfile\nfrom pathlib import PurePosixPath\nfrom typing import Any\n\nimport yaml\n\nfrom logs.logging_config import get_workflow_logger\nfrom mozaiksai.core.workflow.generator_support.agent_endpoints import (\n    resolve_agent_api_url,\n    resolve_agent_websocket_url,\n)\nfrom mozaiksai.core.workflow.generator_support.workflow_exports import record_workflow_export\n\nfrom .export_to_github import export_to_github_tool\n\n\ndef _find_zip_entry(names: list[str], suffix: str) -> str | None:\n    for name in names:\n        if not isinstance(name, str):\n            continue\n        if name.endswith(suffix):\n            return name\n    return None\n\n\ndef _read_zip_yaml(zf: zipfile.ZipFile, member: str) -> dict[str, Any] | None:\n    \"\"\"Read and parse a YAML file from inside a zip.\"\"\"\n    try:\n        raw = zf.read(member)\n        text = raw.decode(\"utf-8\", errors=\"replace\")\n        parsed = yaml.safe_load(text)\n        return parsed if isinstance(parsed, dict) else {\"_raw\": parsed}\n    except Exception:\n        return None\n\n\n\ndef _extract_agent_names(agents_payload: Any) -> list[str]:\n    if isinstance(agents_payload, dict):\n        # common format: {\"agents\": {\"AgentName\": {...}}}\n        inner = agents_payload.get(\"agents\")\n        if isinstance(inner, dict):\n            return sorted([k for k in inner.keys() if isinstance(k, str) and k.strip()])\n        # alternative: {\"AgentName\": {...}}\n        return sorted([k for k in agents_payload.keys() if isinstance(k, str) and k.strip()])\n    if isinstance(agents_payload, list):\n        names: list[str] = []\n        for item in agents_payload:\n            if isinstance(item, dict):\n                nm = item.get(\"name\")\n                if isinstance(nm, str) and nm.strip():\n                    names.append(nm.strip())\n        return sorted(list(dict.fromkeys(names)))\n    return []\n\n\ndef _extract_tool_names(tools_payload: Any) -> list[str]:\n    if not isinstance(tools_payload, dict):\n        return []\n    entries = tools_payload.get(\"tools\")\n    if not isinstance(entries, list):\n        return []\n    names: list[str] = []\n    for entry in entries:\n        if not isinstance(entry, dict):\n            continue\n        nm = entry.get(\"name\") or entry.get(\"function\")\n        if isinstance(nm, str) and nm.strip():\n            names.append(nm.strip())\n    return sorted(list(dict.fromkeys(names)))\n\ndef _extract_websocket_config(zf: zipfile.ZipFile, names: list[str]) -> dict[str, Any] | None:\n    \"\"\"Extract websocket_config.yaml from bundle if present.\"\"\"\n    ws_entry = _find_zip_entry(names, \"/websocket_config.yaml\")\n    if ws_entry:\n        return _read_zip_yaml(zf, ws_entry)\n    return None\n\n\n\ndef _extract_bundle_metadata(bundle_path: str) -> tuple[str | None, list[str], list[str], dict[str, Any] | None]:\n    \"\"\"Return (workflow_name_in_bundle, agent_names, tool_names, websocket_config).\"\"\"\n\n    zpath = PurePosixPath(bundle_path.replace(\"\\\\\", \"/\"))\n    if zpath.suffix.lower() != \".zip\":\n        return None, [], [], None\n\n    try:\n        with zipfile.ZipFile(bundle_path, \"r\") as zf:\n            names = [n for n in zf.namelist() if isinstance(n, str)]\n            agents_entry = _find_zip_entry(names, \"/agents.yaml\")\n            tools_entry = _find_zip_entry(names, \"/tools.yaml\")\n\n            wf_name = None\n            if agents_entry:\n                wf_name = agents_entry.split(\"/\", 1)[0]\n            elif tools_entry:\n                wf_name = tools_entry.split(\"/\", 1)[0]\n\n            agent_names: list[str] = []\n            tool_names: list[str] = []\n            if agents_entry:\n                agents_yaml = _read_zip_yaml(zf, agents_entry)\n                if agents_yaml is not None:\n                    agent_names = _extract_agent_names(agents_yaml)\n            if tools_entry:\n                tools_yaml = _read_zip_yaml(zf, tools_entry)\n                if tools_yaml is not None:\n                    tool_names = _extract_tool_names(tools_yaml)\n\n            websocket_config = _extract_websocket_config(zf, names)\n            return wf_name, agent_names, tool_names, websocket_config\n    except Exception:\n        return None, [], [], None\n\n\nasync def export_agent_workflow_to_github(\n    *,\n    app_id: str,\n    bundle_path: str,\n    repo_name: str | None = None,\n    commit_message: str | None = None,\n    user_id: str | None = None,\n    context_variables: Any | None = None,\n) -> dict[str, Any]:\n    wf_logger = get_workflow_logger(workflow_name=\"AgentGenerator\", chat_id=None, app_id=app_id)\n    wf_name_in_bundle, agent_names, tool_names, websocket_config = _extract_bundle_metadata(bundle_path)\n    websocket_url = resolve_agent_websocket_url(app_id)\n    api_url = resolve_agent_api_url(app_id)\n\n    result = await export_to_github_tool.execute(\n        app_id=app_id,\n        bundle_path=bundle_path,\n        repo_name=repo_name,\n        commit_message=commit_message,\n        user_id=user_id,\n        workflow_type=\"agent-generator\",\n        context_variables=context_variables,\n    )\n\n    payload = result.model_dump()\n    payload[\"workflow_type\"] = \"agent-generator\"\n    payload[\"bundle_workflow_name\"] = wf_name_in_bundle\n    payload[\"agent_names\"] = agent_names\n    payload[\"tool_names\"] = tool_names\n    payload[\"available_agents\"] = agent_names\n    payload[\"available_tools\"] = tool_names\n    payload[\"agent_websocket_url\"] = websocket_url\n    payload[\"agent_api_url\"] = api_url\n    payload[\"websocket_config\"] = websocket_config\n\n    if result.success:\n        try:\n            await record_workflow_export(\n                app_id=app_id,\n                user_id=user_id,\n                workflow_type=\"agent-generator\",\n                repo_url=result.repo_url,\n                job_id=result.job_id,\n                meta={\n                    \"bundle_workflow_name\": wf_name_in_bundle,\n                    \"agent_names\": agent_names,\n                    \"tool_names\": tool_names,\n                    \"available_agents\": agent_names,\n                    \"available_tools\": tool_names,\n                },\n                extra_fields={\n                    \"bundle_workflow_name\": wf_name_in_bundle,\n                    \"agent_names\": agent_names,\n                    \"tool_names\": tool_names,\n                    \"available_agents\": agent_names,\n                    \"available_tools\": tool_names,\n                    \"agent_websocket_url\": websocket_url,\n                    \"agent_api_url\": api_url,\n                    \"websocket_config\": websocket_config,\n                    \"repoFullName\": result.repo_full_name,\n                    \"baseCommitSha\": result.base_commit_sha,\n                    \"workflowRunUrl\": result.workflow_run_url,\n                    \"deploymentUrl\": result.deployment_url,\n                },\n            )\n        except Exception as exc:\n            wf_logger.warning(\"[EXPORT] Failed to record workflow export metadata: %s\", exc)\n\n    return payload\n\n\n__all__ = [\"export_agent_workflow_to_github\"]"},{"checksum":"sha256:d0829a2491b50c344e4d98470ef7285053b09e533d8180acb1bdf29f289fac7d","chunk_id":"chunk_c0adb9cff67857d6","end_line":213,"path":"workflows/AgentGenerator/tools/export_to_github.py","start_line":1,"symbol_ids":["sym_dfad0e447165d6be","sym_2bf30c5725ca93f3"],"text":"\"\"\"\nexport_to_github - Deploys generated code bundles to GitHub via Mozaiks Backend.\n\nThis tool:\n1) Reads the bundle ZIP file and converts it to a file-change payload\n2) Calls the Mozaiks Backend initial export endpoint (repo + commit)\n3) Configures repository secrets (best-effort)\n4) Polls deployment status (GitHub Actions) until completion\n5) Returns repo URL + deployment info\n\"\"\"\n\nfrom __future__ import annotations\n\nimport asyncio\nimport os\nfrom datetime import UTC, datetime\nfrom pathlib import Path\nfrom typing import Any\n\nfrom pydantic import BaseModel\n\nfrom logs.logging_config import get_workflow_logger\nfrom mozaiksai.core.workflow.generator_support.app_code_versions import (\n    build_snapshot_document,\n    extract_files_from_zip_bundle,\n)\nfrom mozaiksai.core.workflow.generator_support.backend_client import BackendClient\n\ntry:\n    from logs.tools_logs import get_tool_logger as _get_tool_logger  # type: ignore\n    from logs.tools_logs import log_tool_event as _log_tool_event\nexcept Exception:  # pragma: no cover\n    _get_tool_logger = None  # type: ignore\n    _log_tool_event = None  # type: ignore\n\n\nclass ExportResult(BaseModel):\n    success: bool\n    repo_url: str | None = None\n    repo_full_name: str | None = None\n    base_commit_sha: str | None = None\n    job_id: str | None = None  # GitHub Actions workflowRun.id (when available)\n    workflow_run_url: str | None = None\n    deployment_url: str | None = None\n    error: str | None = None\n\n\nclass ExportToGitHubTool:\n    \"\"\"Tool for exporting generated bundles to GitHub via the Mozaiks deployment pipeline.\"\"\"\n\n    def __init__(self) -> None:\n        self.backend_client = BackendClient()\n        self.internal_api_key = [REDACTED]\n\n        # Deployment status polling (GitHub Actions)\n        try:\n            self.deploy_status_timeout_s = int(os.getenv(\"MOZAIKS_DEPLOY_STATUS_TIMEOUT_SECONDS\", \"600\"))\n        except Exception:\n            self.deploy_status_timeout_s = 600\n        try:\n            self.poll_interval_s = float(os.getenv(\"MOZAIKS_DEPLOY_STATUS_POLL_INTERVAL_SECONDS\", \"30\"))\n        except Exception:\n            self.poll_interval_s = 30.0\n        if self.poll_interval_s <= 0:\n            self.poll_interval_s = 30.0\n        if self.deploy_status_timeout_s <= 0:\n            self.deploy_status_timeout_s = 600\n\n        # Derived attempts (clamped)\n        self.max_poll_attempts = max(1, int(self.deploy_status_timeout_s / self.poll_interval_s))\n\n        # Optional size limit (bytes). Default: 25MB.\n        try:\n            self.max_bundle_bytes = int(os.getenv(\"MOZAIKS_DEPLOY_MAX_BUNDLE_BYTES\", str(25 * 1024 * 1024)))\n        except Exception:\n            self.max_bundle_bytes = 25 * 1024 * 1024\n\n    async def execute(\n        self,\n        *,\n        app_id: str | None,\n        bundle_path: str,\n        repo_name: str | None = None,\n        commit_message: str | None = None,\n        user_id: str | None = None,\n        workflow_type: str | None = None,\n        context_variables: Any | None = None,\n    ) -> ExportResult:\n        \"\"\"Export a code bundle ZIP to GitHub via Mozaiks Backend.\"\"\"\n\n        chat_id = None\n        workflow_name = \"AgentGenerator\"\n        if context_variables is not None and hasattr(context_variables, \"get\"):\n            try:\n                chat_id = context_variables.get(\"chat_id\")\n                workflow_name = context_variables.get(\"workflow_name\") or workflow_name\n                app_id = app_id or context_variables.get(\"app_id\")\n                user_id = user_id or context_variables.get(\"user_id\")\n                workflow_type = workflow_type or context_variables.get(\"workflow_type\")\n            except Exception:\n                pass\n\n        wf_logger = get_workflow_logger(workflow_name=workflow_name, chat_id=chat_id, app_id=app_id)\n        tlog = None\n        if _get_tool_logger:  # type: ignore[truthy-function]\n            try:\n                tlog = _get_tool_logger(\n                    tool_name=\"ExportToGitHub\",\n                    chat_id=chat_id,\n                    app_id=app_id,\n                    workflow_name=workflow_name,\n                )\n            except Exception:\n                tlog = None\n\n        if not app_id or not str(app_id).strip():\n            return ExportResult(success=False, error=\"app_id is required\")\n\n        bundle_file = Path(bundle_path)\n        if not bundle_file.exists():\n            return ExportResult(success=False, error=f\"Bundle file not found: {bundle_path}\")\n        if bundle_file.suffix.lower() != \".zip\":\n            return ExportResult(success=False, error=f\"Bundle must be a .zip file, got: {bundle_file.suffix}\")\n\n        try:\n            bundle_size = bundle_file.stat().st_size\n        except Exception:\n            bundle_size = None\n\n        if (\n            isinstance(bundle_size, int)\n            and isinstance(self.max_bundle_bytes, int)\n            and self.max_bundle_bytes > 0\n            and bundle_size > self.max_bundle_bytes\n        ):\n            return ExportResult(\n                success=False,\n                error=f\"Bundle too large ({bundle_size} bytes). Limit is {self.max_bundle_bytes} bytes.\",\n            )\n\n        # Backend tool endpoints require S2S auth.\n        if not self.internal_api_key:\n            error_msg = \"INTERNAL_API_KEY is required for Mozaiks Backend repo export endpoints\"\n            await _emit_deployment_event(chat_id=chat_id, status=\"failed\", data={\"app_id\": app_id, \"error\": error_msg})\n            return ExportResult(success=False, error=error_msg)\n\n        if not user_id or not str(user_id).strip():\n            error_msg = \"user_id is required for deployment\"\n            await _emit_deployment_event(chat_id=chat_id, status=\"failed\", data={\"app_id\": app_id, \"error\": error_msg})\n            return ExportResult(success=False, error=error_msg)\n\n        await _emit_deployment_event(\n            chat_id=chat_id,\n            status=\"started\",\n            data={\n                \"app_id\": app_id,\n                \"message\": \"Starting deployment to GitHub...\",\n            },\n        )\n\n        if tlog and _log_tool_event:  # type: ignore[truthy-function]\n            _log_tool_event(tlog, action=\"start\", status=\"ok\", bundle_bytes=bundle_size)\n\n        try:\n            # Convert bundle zip into the backend \"files\" payload (path + base64 content).\n            bundle_files = extract_files_from_zip_bundle(str(bundle_file))\n            snapshot_doc = build_snapshot_document(\n                app_id=str(app_id),\n                session_id=chat_id,\n                workflow_type=str(workflow_type or workflow_name or \"\").strip() or \"agent-generator\",\n                source=\"generated\",\n                files=bundle_files,\n                structured_outputs=None,\n            )\n            files_payload: list[dict[str, Any]] = [\n                {\"path\": f.get(\"path\"), \"operation\": \"add\", \"contentBase64\": f.get(\"contentBase64\")}\n                for f in (snapshot_doc.get(\"files\") or [])\n                if isinstance(f, dict) and isinstance(f.get(\"path\"), str) and isinstance(f.get(\"contentBase64\"), str)\n            ]\n\n            if not files_payload:\n                error_msg = \"No files found to export (bundle may be empty or filtered).\"\n                await _emit_deployment_event(chat_id=chat_id, status=\"failed\", data={\"app_id\": app_id, \"error\": error_msg})\n                return ExportResult(success=False, error=error_msg)\n\n            if tlog and _log_tool_event:  # type: ignore[truthy-function]\n                _log_tool_event(tlog, action=\"bundle_extracted\", status=\"ok\", file_count=len(files_payload))\n\n            # 1) Initial export (repo + commit)\n            export_res = await self.initial_export(\n                app_id=str(app_id),\n                files=files_payload,\n                repo_name=repo_name,\n                commit_message=commit_message,\n                user_id=str(user_id).strip(),\n            )\n            if not isinstance(export_res, dict) or export_res.get(\"success\") is not True:\n                error_msg = (export_res or {}).get(\"error\") or (export_res or {}).get(\"message\") or \"Initial export failed\"\n                await _emit_deployment_event(chat_id=chat_id, status=\"failed\", data={\"app_id\": app_id, \"error\": error_msg})\n                return ExportResult(success=False, error=str(error_msg))\n\n            repo_url = export_res.get(\"repoUrl\") or export_res.get(\"repo_url\")\n            repo_full_name = export_res.get(\"repoFullName\") or export_res.get(\"repo_full_name\")\n            base_commit_sha = export_res.get(\"baseCommitSha\") or export_res.get(\"base_commit_sha\")\n\n            await _emit_deployment_event(\n                chat_id=chat_id,\n                status=\"progress\",\n                data={\n                    \"app_id\": app_id,\n                    \"repo_url\": repo_url,\n                    \"repo_full_name\": repo_full_name,\n                    \"status\": \"exported\","},{"checksum":"sha256:115248b9940dd7431b3fb45bd02cf2b709da3b39c4bafb4929184a3497c370fb","chunk_id":"chunk_5e5daee6c830b00c","end_line":393,"path":"workflows/AgentGenerator/tools/export_to_github.py","start_line":214,"symbol_ids":["sym_d440364160a8b639","sym_61078c55308fb20e","sym_91953b68c64ed202"],"text":"                    \"message\": \"Repo exported. Configuring secrets and waiting for deployment...\",\n                },\n            )\n\n            # 2) Set repo secrets (best-effort; log but do not fail hard).\n            if isinstance(repo_full_name, str) and repo_full_name.strip():\n                try:\n                    secrets_res = [REDACTED] self.set_repository_secrets(\n                        app_id=str(app_id),\n                        repo_full_name=str(repo_full_name).strip(),\n                        user_id=str(user_id).strip(),\n                        include_database_uri=True,\n                        include_app_api_key=[REDACTED]\n                    )\n                    if tlog and _log_tool_event:  # type: ignore[truthy-function]\n                        _log_tool_event(tlog, action=\"[REDACTED]\", status=\"[REDACTED]\", repo_full_name=[REDACTED] result=[REDACTED]\n                except Exception as sec_exc:\n                    wf_logger.warning(\"[EXPORT] Failed to set repository secrets: [REDACTED]\", sec_exc)\n                    if tlog and _log_tool_event:  # type: ignore[truthy-function]\n                        _log_tool_event(tlog, action=\"[REDACTED]\", status=\"[REDACTED]\", repo_full_name=[REDACTED] error=[REDACTED]\n\n            # 3) Poll deployment status (GitHub Actions).\n            deployment_status: dict[str, Any] = {}\n            if isinstance(repo_full_name, str) and repo_full_name.strip():\n                deployment_status = await self._poll_deployment_status(\n                    app_id=str(app_id),\n                    repo_full_name=str(repo_full_name).strip(),\n                    chat_id=chat_id,\n                )\n\n            status = str(deployment_status.get(\"status\") or \"\").lower()\n            workflow_run = deployment_status.get(\"workflowRun\") if isinstance(deployment_status.get(\"workflowRun\"), dict) else {}\n            conclusion = str((workflow_run or {}).get(\"conclusion\") or \"\").lower()\n\n            deployment_url = None\n            if isinstance(deployment_status.get(\"deploymentUrls\"), dict):\n                deployment_url = deployment_status[\"deploymentUrls\"].get(\"preview\")\n\n            workflow_run_url = (workflow_run or {}).get(\"htmlUrl\")\n            workflow_run_id = (workflow_run or {}).get(\"id\")\n\n            if status == \"completed\" and conclusion == \"success\":\n                await _emit_deployment_event(\n                    chat_id=chat_id,\n                    status=\"completed\",\n                    data={\n                        \"app_id\": app_id,\n                        \"repo_url\": repo_url,\n                        \"repo_full_name\": repo_full_name,\n                        \"deployment_url\": deployment_url,\n                        \"message\": \"Deployment completed.\",\n                    },\n                )\n                if tlog and _log_tool_event:  # type: ignore[truthy-function]\n                    _log_tool_event(\n                        tlog,\n                        action=\"completed\",\n                        status=\"ok\",\n                        repo_url=repo_url,\n                        repo_full_name=repo_full_name,\n                        workflow_run_id=workflow_run_id,\n                        deployment_url=deployment_url,\n                    )\n                return ExportResult(\n                    success=True,\n                    repo_url=str(repo_url) if isinstance(repo_url, str) else None,\n                    repo_full_name=str(repo_full_name) if isinstance(repo_full_name, str) else None,\n                    base_commit_sha=str(base_commit_sha) if isinstance(base_commit_sha, str) else None,\n                    job_id=str(workflow_run_id) if workflow_run_id is not None else None,\n                    workflow_run_url=str(workflow_run_url) if isinstance(workflow_run_url, str) else None,\n                    deployment_url=str(deployment_url) if isinstance(deployment_url, str) else None,\n                )\n\n            # If we cannot poll status (e.g., no repoFullName), still return the repo URL as success.\n            if not deployment_status:\n                return ExportResult(\n                    success=True,\n                    repo_url=str(repo_url) if isinstance(repo_url, str) else None,\n                    repo_full_name=str(repo_full_name) if isinstance(repo_full_name, str) else None,\n                    base_commit_sha=str(base_commit_sha) if isinstance(base_commit_sha, str) else None,\n                    error=None,\n                )\n\n            error_msg = f\"Deployment failed: status={status or 'unknown'} conclusion={conclusion or 'unknown'}\"\n            await _emit_deployment_event(chat_id=chat_id, status=\"failed\", data={\"app_id\": app_id, \"error\": error_msg})\n            if tlog and _log_tool_event:  # type: ignore[truthy-function]\n                _log_tool_event(tlog, action=\"failed\", status=\"error\", repo_full_name=repo_full_name, error=error_msg)\n            return ExportResult(\n                success=False,\n                repo_url=str(repo_url) if isinstance(repo_url, str) else None,\n                repo_full_name=str(repo_full_name) if isinstance(repo_full_name, str) else None,\n                base_commit_sha=str(base_commit_sha) if isinstance(base_commit_sha, str) else None,\n                job_id=str(workflow_run_id) if workflow_run_id is not None else None,\n                workflow_run_url=str(workflow_run_url) if isinstance(workflow_run_url, str) else None,\n                deployment_url=str(deployment_url) if isinstance(deployment_url, str) else None,\n                error=error_msg,\n            )\n\n        except RuntimeError as e:\n            error_msg = f\"Request error: {e}\"\n            wf_logger.error(error_msg)\n            await _emit_deployment_event(chat_id=chat_id, status=\"failed\", data={\"app_id\": app_id, \"error\": error_msg})\n            return ExportResult(success=False, error=error_msg)\n        except Exception as e:  # pragma: no cover\n            error_msg = f\"Unexpected error: {e}\"\n            wf_logger.exception(error_msg)\n            await _emit_deployment_event(chat_id=chat_id, status=\"failed\", data={\"app_id\": app_id, \"error\": error_msg})\n            return ExportResult(success=False, error=error_msg)\n\n    def _format_backend_path(self, template: str, *, app_id: str) -> str:\n        t = str(template or \"\").strip() or \"\"\n        if not t:\n            return \"\"\n        return (\n            t.replace(\"{app_id}\", app_id)\n            .replace(\"{{app_id}}\", app_id)\n            .replace(\"{appId}\", app_id)\n            .replace(\"{{appId}}\", app_id)\n        )\n\n    async def get_repo_manifest(\n        self,\n        *,\n        app_id: str,\n        repo_url: str,\n        user_id: str | None = None,\n    ) -> dict[str, Any]:\n        \"\"\"Fetch repo file manifest (sha256 by path) for conflict detection.\n\n        Expected backend response:\n        {\n          \"repoUrl\": \"...\",\n          \"baseCommitSha\": \"...\",\n          \"files\": [{\"path\":\"src/App.jsx\",\"sha256\":\"...\"}, ...]\n        }\n        \"\"\"\n        if not app_id or not str(app_id).strip():\n            raise ValueError(\"app_id is required\")\n        if not repo_url or not str(repo_url).strip():\n            raise ValueError(\"repo_url is required\")\n        if not self.internal_api_key:\n            raise ValueError(\"INTERNAL_API_KEY is required for repo manifest endpoint\")\n        if self.internal_api_key and (not user_id or not str(user_id).strip()):\n            raise ValueError(\"user_id is required when INTERNAL_API_KEY is configured\")\n\n        path_template = os.getenv(\n            \"MOZAIKS_BACKEND_REPO_MANIFEST_PATH\",\n            \"/api/apps/{app_id}/deploy/repo/manifest\",\n        )\n        endpoint = self._format_backend_path(path_template, app_id=str(app_id).strip())\n        payload: dict[str, Any] = {\"repoUrl\": str(repo_url).strip(), \"userId\": str(user_id).strip() if user_id else None}\n\n        data = await self.backend_client.post(endpoint, json=payload, error_msg=\"Failed to get repo manifest\")\n        return data if isinstance(data, dict) else {\"_raw\": data}\n\n    async def create_pull_request(\n        self,\n        *,\n        app_id: str,\n        repo_url: str,\n        base_commit_sha: str,\n        branch_name: str,\n        title: str,\n        body: str,\n        changes: list[dict[str, Any]],\n        patch_id: str | None = None,\n        user_id: str | None = None,\n    ) -> dict[str, Any]:\n        \"\"\"Request backend to create a branch + PR for an update patchset.\n\n        Backend owns GitHub credentials; MozaiksCore never pushes directly.\n        \"\"\"\n        if not app_id or not str(app_id).strip():\n            raise ValueError(\"app_id is required\")\n        if not repo_url or not str(repo_url).strip():\n            raise ValueError(\"repo_url is required\")\n        if not base_commit_sha or not str(base_commit_sha).strip():\n            raise ValueError(\"base_commit_sha is required\")\n        if not branch_name or not str(branch_name).strip():\n            raise ValueError(\"branch_name is required\")"},{"checksum":"sha256:e9bfe4f1733fc89e7be44c73ad5912bf96372f3589c6481536a625c44ed384b0","chunk_id":"chunk_fd97122b7d2c9439","end_line":577,"path":"workflows/AgentGenerator/tools/export_to_github.py","start_line":394,"symbol_ids":["sym_91953b68c64ed202","sym_f520665aa17c593a","sym_6ec380056a80d7f7","sym_d2e0ed2fa3c7aee3","sym_5beee9306e3624ce","sym_d1717898ea47cce9","sym_02f90d6f36a225ad"],"text":"        if not self.internal_api_key:\n            raise ValueError(\"INTERNAL_API_KEY is required for create PR endpoint\")\n        if self.internal_api_key and (not user_id or not str(user_id).strip()):\n            raise ValueError(\"user_id is required when INTERNAL_API_KEY is configured\")\n\n        path_template = os.getenv(\n            \"MOZAIKS_BACKEND_CREATE_PR_PATH\",\n            \"/api/apps/{app_id}/deploy/repo/pull-requests\",\n        )\n        endpoint = self._format_backend_path(path_template, app_id=str(app_id).strip())\n\n        backend_changes: list[dict[str, Any]] = []\n        for c in changes if isinstance(changes, list) else []:\n            if not isinstance(c, dict):\n                continue\n            path = c.get(\"path\")\n            op = c.get(\"operation\") or c.get(\"op\")\n            if not isinstance(path, str) or not path.strip():\n                continue\n            if not isinstance(op, str) or not op.strip():\n                continue\n            item: dict[str, Any] = {\"path\": path.strip(), \"operation\": op.strip()}\n            if op.strip() in {\"add\", \"modify\"} and isinstance(c.get(\"contentBase64\"), str):\n                item[\"contentBase64\"] = c.get(\"contentBase64\")\n            backend_changes.append(item)\n\n        payload: dict[str, Any] = {\n            \"repoUrl\": str(repo_url).strip(),\n            \"userId\": str(user_id).strip() if user_id else None,\n            \"baseCommitSha\": str(base_commit_sha).strip(),\n            \"branchName\": str(branch_name).strip(),\n            \"title\": str(title or \"\").strip() or \"Mozaiks update\",\n            \"body\": str(body or \"\").strip(),\n            \"changes\": backend_changes,\n        }\n        if patch_id and str(patch_id).strip():\n            payload[\"patchId\"] = str(patch_id).strip()\n\n        data = await self.backend_client.post(endpoint, json=payload, error_msg=\"Failed to create PR\")\n        return data if isinstance(data, dict) else {\"_raw\": data}\n\n    async def initial_export(\n        self,\n        *,\n        app_id: str,\n        files: list[dict[str, Any]],\n        user_id: str,\n        repo_name: str | None = None,\n        commit_message: str | None = None,\n        create_repo: bool = True,\n    ) -> dict[str, Any]:\n        \"\"\"POST /api/apps/{appId}/deploy/repo/initial-export\"\"\"\n        path_template = os.getenv(\n            \"MOZAIKS_BACKEND_INITIAL_EXPORT_PATH\",\n            \"/api/apps/{app_id}/deploy/repo/initial-export\",\n        )\n        endpoint = self._format_backend_path(path_template, app_id=str(app_id).strip())\n        payload: dict[str, Any] = {\n            \"userId\": str(user_id).strip(),\n            \"createRepo\": bool(create_repo),\n            \"files\": files if isinstance(files, list) else [],\n            \"commitMessage\": str(commit_message or \"\").strip() or \"Initial export from MozaiksCore\",\n        }\n        if repo_name and str(repo_name).strip():\n            payload[\"repoName\"] = str(repo_name).strip()\n\n        data = await self.backend_client.post(endpoint, json=payload, error_msg=\"Initial export failed\")\n        return data if isinstance(data, dict) else {\"_raw\": data}\n\n    async def set_repository_secrets(\n        self,\n        *,\n        app_id: str,\n        repo_full_name: str,\n        user_id: str,\n        include_database_uri: bool = True,\n        include_app_api_key: [REDACTED] = [REDACTED]\n    ) -> dict[str, Any]:\n        \"\"\"POST /api/apps/{appId}/deploy/repo/secrets\"\"\"\n        path_template = os.getenv(\n            \"MOZAIKS_BACKEND_REPO_SECRETS_PATH\",\n            \"/api/apps/{app_id}/deploy/repo/secrets\",\n        )\n        endpoint = self._format_backend_path(path_template, app_id=str(app_id).strip())\n        payload: dict[str, Any] = {\n            \"userId\": str(user_id).strip(),\n            \"repoFullName\": str(repo_full_name).strip(),\n            \"includeDatabaseUri\": bool(include_database_uri),\n            \"includeAppApiKey\": [REDACTED]\n        }\n        data = [REDACTED] self.backend_client.post(endpoint, json=[REDACTED] error_msg=\"Failed to set repository secrets\")\n        return data if isinstance(data, dict) else {\"_raw\": data}\n\n    async def get_deploy_status(self, *, app_id: str, repo_full_name: str) -> dict[str, Any]:\n        \"\"\"GET /api/apps/{appId}/deploy/status?repoFullName=org/repo\"\"\"\n        path_template = os.getenv(\n            \"MOZAIKS_BACKEND_DEPLOY_STATUS_PATH\",\n            \"/api/apps/{app_id}/deploy/status\",\n        )\n        endpoint = self._format_backend_path(path_template, app_id=str(app_id).strip())\n        params = {\"repoFullName\": str(repo_full_name).strip()}\n        data = await self.backend_client.get(endpoint, params=params, error_msg=\"Failed to get deploy status\")\n        return data if isinstance(data, dict) else {\"_raw\": data}\n\n    async def _poll_deployment_status(self, *, app_id: str, repo_full_name: str, chat_id: str | None) -> dict[str, Any]:\n        last_status: str | None = None\n        for attempt in range(self.max_poll_attempts):\n            status_data = await self.get_deploy_status(app_id=app_id, repo_full_name=repo_full_name)\n            status = str(status_data.get(\"status\") or \"\").lower()\n            if status and status != last_status:\n                last_status = status\n                await _emit_deployment_event(\n                    chat_id=chat_id,\n                    status=\"progress\",\n                    data={\n                        \"app_id\": app_id,\n                        \"repo_full_name\": repo_full_name,\n                        \"status\": status,\n                        \"attempt\": attempt + 1,\n                        \"max_attempts\": self.max_poll_attempts,\n                        \"message\": f\"Deployment status: {status}\",\n                    },\n                )\n\n            if status == \"completed\":\n                return status_data\n            await asyncio.sleep(self.poll_interval_s)\n\n        return {\n            \"success\": False,\n            \"status\": \"completed\",\n            \"workflowRun\": {\"conclusion\": \"failure\"},\n            \"error\": f\"Deployment polling timed out after {int(self.max_poll_attempts * self.poll_interval_s)} seconds\",\n        }\n\n\nexport_to_github_tool = ExportToGitHubTool()\n\n\nasync def export_to_github(\n    bundle_path: str,\n    app_id: str | None = None,\n    repo_name: str | None = None,\n    commit_message: str | None = None,\n    user_id: str | None = None,\n    workflow_type: str | None = None,\n    context_variables: Any | None = None,\n) -> dict:\n    \"\"\"Convenience wrapper returning a dict compatible with tool outputs.\"\"\"\n\n    result = await export_to_github_tool.execute(\n        app_id=app_id,\n        bundle_path=bundle_path,\n        repo_name=repo_name,\n        commit_message=commit_message,\n        user_id=user_id,\n        workflow_type=workflow_type,\n        context_variables=context_variables,\n    )\n    return result.model_dump()\n\n\nasync def _emit_deployment_event(\n    *,\n    chat_id: str | None,\n    status: str,\n    data: dict,\n) -> None:\n    if not chat_id:\n        return\n    try:\n        from mozaiksai.core.transport.simple_transport import SimpleTransport\n\n        transport = await SimpleTransport.get_instance()\n        await transport.send_event_to_ui(\n            {\n                \"schema_version\": \"mozaiks.ui.event.v1\",\n                \"type\": f\"chat.deployment_{status}\",\n                \"data\": {\"timestamp\": datetime.now(UTC).isoformat(), **data},\n            },\n            chat_id,\n        )\n    except Exception:\n        return"},{"checksum":"sha256:982239d58857ca0c6ada1bab648d308b5ba4fcfd4653e624eeb3cbd282c6e88e","chunk_id":"chunk_88cf607ecbfc6f7d","end_line":256,"path":"workflows/AgentGenerator/tools/generate_and_download.py","start_line":1,"symbol_ids":["sym_978dc6fe23cd3f86","sym_7e4908340955cf8f","sym_558014e97c02f110","sym_ff52cdf77bf91f3e","sym_70b7efcb0bde53b6","sym_73e7dcd3d860b430","sym_61c704185a02192e","sym_f4a261a3a4dc30a7","sym_53bdc27d587a2e3d","sym_d34af4f662f5421b"],"text":"\"\"\"\ngenerate_and_download tool \u2014 assembles workflow bundle files from workflow_bundle_results,\nzips them, and presents the inline download UI.\n\nReplaces the old persistence-gather + converter approach with a direct read from\nthe task batch output stored in context_variables[\"workflow_bundle_results\"].\n\"\"\"\n\nimport logging\nimport os\nimport re\nimport shutil\nimport time\nimport uuid\nimport zipfile\nfrom pathlib import Path\nfrom typing import Annotated, Any\n\nfrom factory_app.workflows._shared.platform.build_target import require_build_binding\nfrom factory_app.workflows._shared.workflow_integration import (\n    apply_workflow_integration_context,\n    extract_workflow_integration_metadata_from_bundle_entries,\n)\nfrom logs.logging_config import get_workflow_logger\nfrom mozaiksai.core.workflow.context.frozen import detach\nfrom mozaiksai.core.workflow.generator_support.agent_endpoints import (\n    resolve_agent_api_url,\n    resolve_agent_websocket_url,\n)\nfrom mozaiksai.core.workflow.generator_support.workflow_artifacts import record_workflow_artifacts\nfrom mozaiksai.core.workflow.generator_support.workflow_exports import record_workflow_export\nfrom mozaiksai.core.workflow.ui_tools import UIToolError, use_ui_tool\n\nfrom .export_agent_workflow import export_agent_workflow_to_github\nfrom .workflow_quality_gate import (\n    prepare_workflow_bundle_repair,\n    run_workflow_bundle_quality_gate,\n)\n\ntry:\n    from logs.tools_logs import get_tool_logger as _get_tool_logger  # type: ignore\n    from logs.tools_logs import log_tool_event as _log_tool_event\nexcept Exception:\n    _get_tool_logger = None  # type: ignore\n    _log_tool_event = None  # type: ignore\n\n_logger = logging.getLogger(__name__)\n\n\n# ---------------------------------------------------------------------------\n# Internal helpers\n# ---------------------------------------------------------------------------\n\n\ndef _repo_root() -> Path:\n    here = Path(__file__).resolve()\n    for parent in [here] + list(here.parents):\n        if (parent / \"mozaiksai\").is_dir():\n            return parent\n    return here.parents[-1]\n\n\ndef _resolve_generated_artifacts_root() -> Path:\n    raw = os.getenv(\"MOZAIKS_GENERATED_ARTIFACTS_PATH\", \"generated\").strip()\n    candidate = Path(raw)\n    if not candidate.is_absolute():\n        candidate = _repo_root() / candidate\n    return candidate.resolve()\n\n\ndef _safe_path_segment(value: Any, *, fallback: str) -> str:\n    text = str(value or \"\").strip() or fallback\n    text = re.sub(r\"[^A-Za-z0-9_.-]+\", \"-\", text).strip(\".-\")\n    return text or fallback\n\n\ndef _resolve_workflow_output_root(*, app_id: Any, build_id: Any) -> Path:\n    return (\n        _resolve_generated_artifacts_root()\n        / \"workflows\"\n        / _safe_path_segment(app_id, fallback=\"local-app\")\n        / _safe_path_segment(build_id, fallback=\"local-build\")\n    )\n\n\ndef _to_pascal_case(name: str) -> str:\n    \"\"\"Convert a workflow name to PascalCase.\"\"\"\n    if not name:\n        return name\n    if ' ' not in name and '-' not in name and '_' not in name and name[0].isupper():\n        return name\n    words = name.replace('_', ' ').replace('-', ' ').split()\n    return ''.join(word.title() for word in words if word)\n\n\ndef _format_bytes(num: int) -> str:\n    try:\n        value: float = float(num)\n        for unit in ['bytes', 'KB', 'MB', 'GB', 'TB']:\n            if value < 1024 or unit == 'TB':\n                return f\"{int(value)} bytes\" if unit == 'bytes' else f\"{value:.1f} {unit}\"\n            value /= 1024.0\n    except Exception:\n        return f\"{num} bytes\"\n    return f\"{num} bytes\"\n\n\ndef _write_bundle_to_disk(\n    workflow_name: str,\n    files: list[dict[str, Any]],\n    base_dir: Path,\n) -> tuple[Path, list[str]]:\n    \"\"\"Write WorkflowBundleBuilderOutput files to disk under base_dir/workflow_name/.\n\n    Returns (workflow_dir, list_of_relative_filenames_written).\n    \"\"\"\n    workflow_dir = base_dir / workflow_name\n    workflow_dir.mkdir(parents=True, exist_ok=True)\n\n    created: list[str] = []\n    for file_entry in files:\n        filename = (file_entry.get(\"filename\") or \"\").strip()\n        content = file_entry.get(\"content\") or \"\"\n        if not filename:\n            continue\n        target = workflow_dir / filename\n        target.parent.mkdir(parents=True, exist_ok=True)\n        target.write_text(content, encoding=\"utf-8\")\n        created.append(filename)\n\n    return workflow_dir, created\n\n\ndef _build_pack_zip(\n    *,\n    bundle_dirs: list[tuple],  # list of (wf_name: str, wf_dir: Path)\n    output_path: Path,\n) -> Path:\n    \"\"\"Zip one or more workflow bundle directories into a single archive.\"\"\"\n    with zipfile.ZipFile(output_path, 'w', zipfile.ZIP_DEFLATED) as zf:\n        for wf_name, wf_dir in bundle_dirs:\n            for file_path in wf_dir.rglob(\"*\"):\n                if file_path.is_file():\n                    arcname = f\"{wf_name}/{file_path.relative_to(wf_dir)}\"\n                    zf.write(file_path, arcname=arcname)\n    return output_path\n\n\nasync def _register_workflow_bundle_artifact_version(\n    *,\n    app_id: str,\n    user_id: str | None,\n    workflow_name: str,\n    chat_id: str | None,\n    bundle_name: str,\n    zip_path: Path | None,\n    context_variables: Any | None,\n    workflow_integration_metadata: dict[str, Any] | None = None,\n    artifact_store: Any | None = None,\n) -> Any:\n    if context_variables is None:\n        raise ValueError(\"Workflow artifact registration requires runtime context\")\n    try:\n        import hashlib\n\n        from mozaiksai.core.artifacts import (\n            ArtifactLifecycleStatus,\n            ArtifactValidationStatus,\n            get_artifact_store,\n            resolve_latest_artifact_version_refs,\n        )\n    except Exception as exc:\n        raise RuntimeError(f\"Artifact store dependencies unavailable: {exc}\") from exc\n\n    files_manifest = []\n    if zip_path is not None and zip_path.exists():\n        raw = zip_path.read_bytes()\n        sha = hashlib.sha256(raw).hexdigest()\n        files_manifest.append(\n            {\n                \"path\": f\"{bundle_name}/{zip_path.name}\",\n                \"sha256\": sha,\n                \"size_bytes\": zip_path.stat().st_size,\n                \"content_type\": \"application/zip\",\n            }\n        )\n\n    parent_version_id = None\n    if context_variables and hasattr(context_variables, \"get\"):\n        try:\n            parent_version_id = context_variables.get(\"artifact_version_id\")\n        except Exception:\n            pass\n\n    artifact_store = artifact_store or get_artifact_store()\n    canonical_inputs_version = await resolve_latest_artifact_version_refs(\n        app_id=str(app_id),\n        artifact_kinds=(\"design_docs\", \"subscription_contract\"),\n        artifact_store=artifact_store,\n    )\n    artifact_version = await artifact_store.create_build_record(\n        app_id=str(app_id),\n        build_family=\"workflow_bundle\",\n        build_key=bundle_name,\n        parent_build_record_id=str(parent_version_id) if parent_version_id else None,\n        canonical_inputs_version=canonical_inputs_version,\n        files_manifest=files_manifest,\n        source_workflow=workflow_name,\n        source_chat_id=chat_id,\n        lifecycle_status=(\n            ArtifactLifecycleStatus.DRAFT if parent_version_id else ArtifactLifecycleStatus.CURRENT\n        ),\n        validation_status=ArtifactValidationStatus.PENDING,\n        commit_metadata={\n            \"message\": f\"{workflow_name}: {bundle_name}\",\n            \"author_user_id\": user_id,\n            \"source_workflow\": workflow_name,\n            \"source_chat_id\": chat_id,\n            \"metadata\": {\n                **require_build_binding(context_variables).model_dump(),\n                \"artifact_path\": str(zip_path) if zip_path else None,\n                \"workflow_name\": bundle_name,\n                \"workflow_integration_metadata\": workflow_integration_metadata,\n                \"workflow_plan_review\": detach(context_variables.get(\"workflow_plan_review\")),\n            },\n        },\n    )\n    if context_variables and hasattr(context_variables, \"set\"):\n        try:\n            context_variables.set(\"artifact_version_id\", artifact_version.id)\n        except Exception:\n            pass\n    return artifact_version\n\n\nasync def _record_context_and_artifacts(\n    *,\n    app_id: str | None,\n    user_id: str | None,\n    chat_id: str | None,\n    pack_name: str,\n    bundle_entries: list[dict[str, Any]],\n    zip_path: Path | None,\n    context_variables: Any | None,\n) -> None:\n    \"\"\"Record workflow export context and artifacts for downstream chaining.\"\"\"\n    if not app_id:\n        raise ValueError(\"app_id is required to record workflow artifacts\")\n\n    # Synthesize minimal workflow config from bundle entries.\n    workflow_names = [e.get(\"workflow_name\", \"\") for e in bundle_entries if e.get(\"workflow_name\")]\n    workflow_integration_metadata = extract_workflow_integration_metadata_from_bundle_entries(\n        bundle_entries,\n        bundle_name=pack_name,\n    )\n    primary_workflow = ("},{"checksum":"sha256:454ff5736bd836949093d7a5eaad15d993f93b53c3342ea1da9973721fbc4227","chunk_id":"chunk_fe4ca655b6768cf9","end_line":467,"path":"workflows/AgentGenerator/tools/generate_and_download.py","start_line":257,"symbol_ids":["sym_d34af4f662f5421b","sym_472f8f9436ff2951"],"text":"        workflow_integration_metadata.get(\"primary_workflow\")\n        if isinstance(workflow_integration_metadata, dict)\n        else None\n    )\n\n    websocket_url = resolve_agent_websocket_url(str(app_id)) if workflow_names else None\n    api_url = resolve_agent_api_url(str(app_id)) if workflow_names else None\n    capability_id = (\n        str(primary_workflow.get(\"capability_id\"))\n        if isinstance(primary_workflow, dict) and primary_workflow.get(\"capability_id\")\n        else None\n    )\n    generated_workflow_name = (\n        str(primary_workflow.get(\"workflow_name\"))\n        if isinstance(primary_workflow, dict) and primary_workflow.get(\"workflow_name\")\n        else None\n    )\n    generated_workflow_startup_mode = (\n        primary_workflow.get(\"startup_mode\")\n        if isinstance(primary_workflow, dict)\n        else None\n    )\n    generated_workflow_trigger_events = (\n        primary_workflow.get(\"trigger_events\") or []\n        if isinstance(primary_workflow, dict)\n        else []\n    )\n    if workflow_integration_metadata:\n        apply_workflow_integration_context(context_variables, workflow_integration_metadata)\n\n    # The canonical BuildRecord is the required persistence boundary. Register\n    # it before writing optional export/diagnostic projections so a required\n    # failure cannot leave those secondary records looking authoritative.\n    await _register_workflow_bundle_artifact_version(\n        app_id=str(app_id),\n        user_id=user_id,\n        workflow_name=\"AgentGenerator\",\n        chat_id=chat_id,\n        bundle_name=pack_name,\n        zip_path=zip_path,\n        context_variables=context_variables,\n        workflow_integration_metadata=workflow_integration_metadata,\n    )\n\n    try:\n        await record_workflow_export(\n            app_id=str(app_id),\n            user_id=user_id,\n            workflow_type=\"agent-generator\",\n            repo_url=None,\n            job_id=None,\n            meta={\n                \"bundle_workflow_name\": pack_name,\n                \"workflow_name\": generated_workflow_name,\n                \"capability_id\": capability_id,\n                \"workflow_names\": workflow_names,\n                \"workflow_integration_metadata\": workflow_integration_metadata,\n            },\n            extra_fields={\n                \"bundle_workflow_name\": pack_name,\n                \"workflow_name\": generated_workflow_name,\n                \"capability_id\": capability_id,\n                \"workflow_names\": workflow_names,\n                \"workflow_startup_mode\": generated_workflow_startup_mode,\n                \"workflow_trigger_events\": generated_workflow_trigger_events,\n                \"workflow_integration_metadata\": workflow_integration_metadata,\n                \"agent_websocket_url\": websocket_url,\n                \"agent_api_url\": api_url,\n            },\n        )\n    except Exception as exc:\n        _logger.warning(\"Optional workflow export persistence failed: %s\", exc)\n\n    try:\n        await record_workflow_artifacts(\n            app_id=str(app_id),\n            user_id=user_id,\n            workflow_type=\"agent-generator\",\n            workflow_name=pack_name,\n            artifacts={\n                \"bundle_name\": pack_name,\n                \"workflow_names\": workflow_names,\n                \"bundle_entries\": bundle_entries,\n                \"workflow_integration_metadata\": workflow_integration_metadata,\n            },\n        )\n    except Exception as exc:\n        _logger.warning(\"Optional workflow artifact projection failed: %s\", exc)\n\n# ---------------------------------------------------------------------------\n# Main tool\n# ---------------------------------------------------------------------------\n\n\nasync def generate_and_download(\n    DownloadRequest: Annotated[dict[str, Any], \"Download configuration\"],\n    agent_message: Annotated[str, \"Concise message (\u2264140 chars) shown to user in download UI\"],\n    context_variables: Annotated[Any | None, \"Injected runtime context.\"] = None,\n) -> dict[str, Any]:\n    \"\"\"\n    Assemble all workflow bundle files from workflow_bundle_results, zip them,\n    and present the inline download UI.\n\n    Reads pre-built CodeFile lists directly from the task batch output in\n    context_variables[\"workflow_bundle_results\"] \u2014 no converter or persistence\n    assembly needed.\n    \"\"\"\n    confirmation_only = DownloadRequest.get(\"confirmation_only\", True)\n    storage_backend = DownloadRequest.get(\"storage_backend\", \"none\")\n\n    chat_id: str | None = None\n    app_id: str | None = None\n    workflow_name: str | None = None\n    user_id: str | None = None\n    from factory_app.workflows._shared.platform.build_target import require_build_binding\n\n    binding = require_build_binding(context_variables)\n\n    if context_variables and hasattr(context_variables, \"get\"):\n        chat_id = context_variables.get(\"chat_id\")\n        app_id = context_variables.get(\"app_id\")\n        workflow_name = context_variables.get(\"workflow_name\")\n        user_id = context_variables.get(\"user_id\")\n\n    wf_logger = get_workflow_logger(workflow_name=(workflow_name or \"AgentGenerator\"), chat_id=chat_id, app_id=app_id)\n    tlog = None\n    if _get_tool_logger:  # type: ignore[truthy-function]\n        try:\n            tlog = _get_tool_logger(\n                tool_name=\"GenerateAndDownload\",\n                chat_id=chat_id,\n                app_id=app_id,\n                workflow_name=(workflow_name or \"AgentGenerator\"),\n            )\n            if _log_tool_event:  # type: ignore[truthy-function]\n                _log_tool_event(tlog, action=\"start\", status=\"ok\")\n        except Exception:\n            tlog = None\n\n    wf_logger.info(\"\ud83c\udfd7\ufe0f generate_and_download start (confirmation_only=%s) chat=%s\", confirmation_only, chat_id)\n\n    if not chat_id or not app_id:\n        return {\"status\": \"error\", \"message\": \"chat_id and app_id are required\"}\n\n    # ------------------------------------------------------------------\n    # Read workflow_bundle_results from task batch output\n    # ------------------------------------------------------------------\n    workflow_bundle_results: dict[str, Any] | None = None\n    pack_name: str | None = None\n\n    if context_variables and hasattr(context_variables, \"get\"):\n        workflow_bundle_results = detach(context_variables.get(\"workflow_bundle_results\"))\n        pack_name = context_variables.get(\"pack_name\")\n\n    if not isinstance(workflow_bundle_results, dict) or not workflow_bundle_results:\n        return {\n            \"status\": \"error\",\n            \"message\": \"workflow_bundle_results is empty \u2014 task batch did not complete successfully\",\n        }\n\n    # Collect per-workflow entries (skip internal _meta key)\n    bundle_entries: list[dict[str, Any]] = [\n        v for k, v in workflow_bundle_results.items()\n        if not k.startswith(\"_\") and isinstance(v, dict)\n    ]\n\n    if not bundle_entries:\n        return {\"status\": \"error\", \"message\": \"No workflow bundles found in workflow_bundle_results\"}\n\n    quality_gate = run_workflow_bundle_quality_gate(\n        bundle_entries=bundle_entries,\n        context_variables=context_variables,\n    )\n    if not quality_gate.get(\"passed\"):\n        repair_result = prepare_workflow_bundle_repair(\n            quality_gate=quality_gate,\n            bundle_entries=bundle_entries,\n            context_variables=context_variables,\n        )\n        wf_logger.warning(\n            \"Workflow bundle quality gate failed with %d issue(s).\",\n            len(quality_gate.get(\"errors\") or []),\n        )\n        return {\n            \"status\": \"blocked\",\n            \"outcome\": \"needs_revision\" if repair_result.get(\"status\") == \"needs_revision\" else \"blocked\",\n            \"message\": (\n                \"Workflow bundle quality gate failed; repair has been scheduled.\"\n                if repair_result.get(\"status\") == \"needs_revision\"\n                else \"Workflow bundle quality gate failed; download was not created.\"\n            ),\n            \"workflow_bundle_quality_gate\": quality_gate,\n            \"workflow_bundle_repair\": repair_result,\n            \"validation_errors\": quality_gate.get(\"errors\") or [],\n        }\n    from .outcome_materialization import materialize_workflow_outcomes\n\n    bundle_entries = [materialize_workflow_outcomes(entry) for entry in bundle_entries]\n    if context_variables is not None and hasattr(context_variables, \"set\"):\n        by_name = {entry[\"workflow_name\"]: entry for entry in bundle_entries}\n        context_variables.set(\"workflow_bundle_results\", {\n            key: by_name.get(value.get(\"workflow_name\"), value) if isinstance(value, dict) else value\n            for key, value in workflow_bundle_results.items()\n        })\n    if context_variables is not None and hasattr(context_variables, \"set\"):\n        try:\n            context_variables.set(\"workflow_bundle_repair_status\", \"passed\")\n            context_variables.set(\"workflow_bundle_repair_active\", False)\n        except Exception:\n            pass\n"},{"checksum":"sha256:513b680bbf408f85851dc0f2560b1e89ac0d6d0941da4de9bd6a4e3e7520203c","chunk_id":"chunk_877688f94160f431","end_line":675,"path":"workflows/AgentGenerator/tools/generate_and_download.py","start_line":468,"symbol_ids":["sym_472f8f9436ff2951","sym_3bd66c619531a1a6"],"text":"    # Derive the top-level bundle name (pack name or single workflow name)\n    if pack_name and isinstance(pack_name, str) and pack_name.strip():\n        bundle_name = _to_pascal_case(pack_name.strip())\n    else:\n        bundle_name = _to_pascal_case(\n            (bundle_entries[0].get(\"workflow_name\") or \"GeneratedWorkflow\").strip()\n        )\n\n    wf_logger = get_workflow_logger(workflow_name=bundle_name, chat_id=chat_id, app_id=app_id)\n    wf_logger.info(\"\ud83d\udce6 Bundle name: %s  workflows: %d\", bundle_name, len(bundle_entries))\n\n    agent_message_text = agent_message or (\n        \"Would you like to download the generated workflow bundle now?\"\n        if confirmation_only else\n        \"Preparing your workflow files. Use the download panel when ready.\"\n    )\n    agent_message_id = f\"msg_{uuid.uuid4().hex[:10]}\"\n    print(agent_message_text)\n\n    # ------------------------------------------------------------------\n    # Resolve output directory\n    # ------------------------------------------------------------------\n    base_generated = _resolve_workflow_output_root(\n        app_id=binding.target_app_id,\n        build_id=binding.build_id,\n    )\n    base_generated.mkdir(parents=True, exist_ok=True)\n\n    ui_files: list[dict[str, Any]] = []\n    zip_path_obj: Path | None = None\n\n    def _create_bundle_files() -> tuple[Path | None, list[dict[str, Any]]]:\n        \"\"\"Write all bundle files to disk and create the zip. Returns (zip_path, ui_files).\"\"\"\n        bundle_dirs: list[tuple] = []\n        for entry in bundle_entries:\n            wf_name = entry.get(\"workflow_name\") or \"\"\n            files = entry.get(\"files\") or []\n            if not wf_name or not isinstance(files, list):\n                wf_logger.warning(\"Skipping bundle entry with missing workflow_name or files: %r\", entry.get(\"_task_id\"))\n                continue\n            wf_dir, created = _write_bundle_to_disk(wf_name, files, base_generated)\n            wf_logger.info(\"\u2705 Wrote %d files for workflow %s to %s\", len(created), wf_name, wf_dir)\n            bundle_dirs.append((wf_name, wf_dir))\n\n        if not bundle_dirs:\n            return None, []\n\n        zip_output = base_generated / f\"{bundle_name}.zip\"\n        _build_pack_zip(bundle_dirs=bundle_dirs, output_path=zip_output)\n        zip_size = zip_output.stat().st_size\n        wf_logger.info(\"\ud83d\udce6 Created zip archive: %s (%s)\", zip_output.name, _format_bytes(zip_size))\n\n        return zip_output, [\n            {\n                \"name\": f\"{bundle_name}.zip\",\n                \"size\": _format_bytes(zip_size),\n                \"size_bytes\": zip_size,\n                \"path\": str(zip_output.resolve()),\n                \"id\": \"file-zip-bundle\",\n                \"type\": \"zip\",\n            }\n        ]\n\n    if not confirmation_only:\n        # Immediate mode: create files now, then show download UI\n        wf_logger.info(\"\ud83d\udce6 Creating workflow files immediately (confirmation_only=False)...\")\n        zip_path_obj, ui_files = _create_bundle_files()\n        if not ui_files:\n            return {\"status\": \"error\", \"message\": \"Failed to create workflow bundle files\"}\n\n        await _record_context_and_artifacts(\n            app_id=binding.target_app_id,\n            user_id=user_id,\n            chat_id=chat_id,\n            pack_name=bundle_name,\n            bundle_entries=bundle_entries,\n            zip_path=zip_path_obj,\n            context_variables=context_variables,\n        )\n    else:\n        # Confirmation mode: show UI first, create files after user confirms\n        wf_logger.info(\"\u2753 Asking user confirmation before creating files...\")\n\n    ui_payload = {\n        \"downloadType\": \"single\",\n        \"artifact_kind\": \"workflow_bundle\",\n        \"artifact_version_id\": context_variables.get(\"artifact_version_id\") if context_variables else None,\n        \"build_registry_id\": binding.build_registry_id,\n        \"app_id\": app_id,\n        \"files\": ui_files,\n        \"agent_message\": agent_message_text,\n        \"description\": agent_message_text,\n        \"title\": \"Workflow Bundle Ready\" if confirmation_only else \"Generated Workflow Files\",\n        \"workflow_name\": bundle_name,\n        \"agent_message_id\": agent_message_id,\n        \"stage\": \"confirm\" if (confirmation_only and not ui_files) else \"files_ready\",\n    }\n\n    try:\n        if tlog and _log_tool_event:  # type: ignore[truthy-function]\n            _log_tool_event(tlog, action=\"emit_ui\", status=\"start\", agent_message_id=agent_message_id)\n        response = await use_ui_tool(\n            tool_id=\"DownloadCenter\",\n            payload=ui_payload,\n            chat_id=chat_id,\n            workflow_name=bundle_name,\n        )\n        wf_logger.info(\"\ud83d\udce5 Download UI completed with status: %s\", response.get(\"status\", \"unknown\"))\n        if tlog and _log_tool_event:  # type: ignore[truthy-function]\n            _log_tool_event(tlog, action=\"emit_ui\", status=\"done\", result_status=response.get(\"status\", \"unknown\"))\n    except UIToolError:\n        raise\n    except Exception as e:\n        wf_logger.error(\"\u274c UI interaction failed: %s\", e, exc_info=True)\n        raise UIToolError(\"Failed during file download UI interaction\") from e\n\n    if response.get(\"status\") == \"cancelled\":\n        wf_logger.info(\"\u274c User declined download\")\n        return {\n            \"status\": \"cancelled\",\n            \"outcome\": \"cancelled\",\n            \"ui_response\": response,\n            \"agent_message_id\": agent_message_id,\n            \"ui_files\": [],\n            \"message\": \"User declined download\",\n        }\n\n    # If confirmation mode, now create the files (user confirmed)\n    if confirmation_only:\n        wf_logger.info(\"\u2705 User confirmed \u2014 creating files now...\")\n        zip_path_obj, ui_files = _create_bundle_files()\n        if not ui_files:\n            return {\"status\": \"error\", \"message\": \"Failed to create workflow bundle files\"}\n\n        await _record_context_and_artifacts(\n            app_id=binding.target_app_id,\n            user_id=user_id,\n            chat_id=chat_id,\n            pack_name=bundle_name,\n            bundle_entries=bundle_entries,\n            zip_path=zip_path_obj,\n            context_variables=context_variables,\n        )\n\n        if isinstance(response, dict):\n            response.setdefault(\"data\", {})\n            if isinstance(response[\"data\"], dict):\n                response[\"data\"][\"files\"] = ui_files\n                response[\"data\"][\"fileCount\"] = len(ui_files)\n            response.setdefault(\"agentContext\", {})\n            if isinstance(response.get(\"agentContext\"), dict):\n                response[\"agentContext\"][\"files_created\"] = True\n                response[\"agentContext\"][\"file_count\"] = len(ui_files)\n\n    # Set download_complete when user accepted\n    if context_variables and response.get(\"download_accepted\"):\n        try:\n            context_variables.set(\"download_complete\", True)\n            wf_logger.info(\"\u2705 Set download_complete=True\")\n        except Exception:\n            pass\n\n    # Optional storage backend\n    if storage_backend != \"none\" and ui_files:\n        try:\n            storage_result = await _handle_storage_action(\n                storage_backend=storage_backend,\n                response=response,\n                zip_path=zip_path_obj,\n                context_variables=context_variables,\n                workflow_name=bundle_name,\n            )\n            if storage_result:\n                response = {**response, \"storage\": storage_result}\n        except Exception as se:\n            wf_logger.warning(\"\u26a0\ufe0f Storage action failed: %s\", se)\n\n    # Optional GitHub export\n    deployment_result: dict[str, Any] | None = None\n    try:\n        action = None\n        if isinstance(response, dict):\n            action = response.get(\"action\")\n            if not action and isinstance(response.get(\"data\"), dict):\n                action = response[\"data\"].get(\"action\")\n\n        if action == \"export_to_github\":\n            zip_bundle_path = None\n            for f in ui_files:\n                if isinstance(f, dict) and f.get(\"type\") == \"zip\" and f.get(\"path\"):\n                    zip_bundle_path = f.get(\"path\")\n                    break\n\n            repo_name = None\n            commit_message = \"Initial code generation from Mozaiks AI\"\n            if isinstance(response, dict):\n                repo_name = response.get(\"repo_name\") or response.get(\"repoName\")\n                commit_message = response.get(\"commit_message\") or response.get(\"commitMessage\") or commit_message\n                if isinstance(response.get(\"data\"), dict):\n                    repo_name = response[\"data\"].get(\"repo_name\") or response[\"data\"].get(\"repoName\") or repo_name\n                    commit_message = (\n                        response[\"data\"].get(\"commit_message\")\n                        or response[\"data\"].get(\"commitMessage\")\n                        or commit_message\n                    )\n\n            if not zip_bundle_path:\n                deployment_result = {\"success\": False, \"error\": \"ZIP bundle path not available for export.\"}"},{"checksum":"sha256:f1f396c31e2c26c04bf491089a5a7ed1b73bb49dc0046136aafd725f73b043fe","chunk_id":"chunk_1ed3f99e7d9f1fe8","end_line":783,"path":"workflows/AgentGenerator/tools/generate_and_download.py","start_line":676,"symbol_ids":["sym_472f8f9436ff2951","sym_bdee94ecb365615f","sym_5a73ad73290a4331"],"text":"            else:\n                wf_logger.info(\"\ud83d\ude80 Export to GitHub requested (repo=%s)\", repo_name)\n                deployment_result = await export_agent_workflow_to_github(\n                    bundle_path=str(zip_bundle_path),\n                    app_id=binding.target_app_id,\n                    repo_name=repo_name,\n                    commit_message=commit_message,\n                    user_id=user_id,\n                    context_variables=context_variables,\n                )\n                if context_variables and isinstance(deployment_result, dict) and deployment_result.get(\"success\"):\n                    try:\n                        if deployment_result.get(\"repo_url\"):\n                            context_variables.set(\"github_repo_url\", deployment_result[\"repo_url\"])\n                        if deployment_result.get(\"job_id\"):\n                            context_variables.set(\"github_deploy_job_id\", deployment_result[\"job_id\"])\n                    except Exception:\n                        pass\n    except Exception as deploy_err:\n        wf_logger.warning(\"\u26a0\ufe0f GitHub export flow failed: %s\", deploy_err)\n        deployment_result = {\"success\": False, \"error\": \"GitHub export failed; inspect export status before retrying.\"}\n\n    export_failed = action == \"export_to_github\" and (\n        not isinstance(deployment_result, dict) or deployment_result.get(\"success\") is not True\n    )\n    return {\n        \"status\": \"error\" if export_failed else \"success\",\n        \"outcome\": \"blocked\" if export_failed else \"ready\",\n        \"ui_response\": response,\n        \"agent_message_id\": agent_message_id,\n        \"ui_files\": ui_files,\n        **({\"deployment\": deployment_result} if deployment_result is not None else {}),\n    }\n\n\n# ---------------------------------------------------------------------------\n# Storage helpers\n# ---------------------------------------------------------------------------\n\n\nasync def _handle_storage_action(\n    storage_backend: str,\n    response: dict[str, Any],\n    zip_path: Path | None,\n    context_variables: Any | None = None,\n    workflow_name: str | None = None,\n) -> dict[str, Any] | None:\n    if storage_backend == \"local\":\n        return await _store_files_local(\n            response=response,\n            zip_path=zip_path,\n            context_variables=context_variables,\n            workflow_name=workflow_name,\n        )\n    if storage_backend == \"none\":\n        return None\n    return {\"status\": \"error\", \"message\": f\"Unsupported storage backend: {storage_backend}\"}\n\n\nasync def _store_files_local(\n    response: dict[str, Any],\n    zip_path: Path | None,\n    context_variables: Any | None = None,\n    workflow_name: str | None = None,\n) -> dict[str, Any]:\n    selected_path = None\n    if isinstance(response, dict):\n        selected_path = response.get(\"selectedPath\") or (\n            response.get(\"data\", {}).get(\"selectedPath\") if isinstance(response.get(\"data\"), dict) else None\n        )\n    if not selected_path:\n        return {\"status\": \"skipped\", \"message\": \"No selectedPath provided by UI\"}\n    if not zip_path or not zip_path.exists():\n        return {\"status\": \"skipped\", \"message\": \"No zip bundle to copy\"}\n\n    wf_logger = get_workflow_logger(workflow_name=(workflow_name or \"generator\"), chat_id=None, app_id=None)\n    try:\n        dest = Path(selected_path)\n        dest.mkdir(parents=True, exist_ok=True)\n        target = dest / zip_path.name\n        shutil.copy2(zip_path, target)\n        wf_logger.info(\"\ud83d\udccb Copied %s -> %s\", zip_path.name, target)\n\n        if context_variables:\n            try:\n                downloads = context_variables.get(\"file_downloads\", []) or []\n                rec = {\n                    \"type\": \"local_copy\",\n                    \"files\": [str(target)],\n                    \"file_count\": 1,\n                    \"dest_path\": str(dest),\n                    \"copied_at\": str(time.time()),\n                }\n                downloads.append(rec)\n                context_variables.set(\"file_downloads\", downloads)\n                context_variables.set(\"last_download\", rec)\n            except Exception:\n                pass\n\n        return {\n            \"status\": \"success\",\n            \"message\": f\"Copied bundle to {selected_path}\",\n            \"copied_files\": [str(target)],\n            \"dest_path\": str(dest),\n        }\n    except Exception as e:\n        wf_logger.error(\"\u274c Local storage failed: %s\", e)\n        return {\"status\": \"error\", \"message\": f\"Failed to copy files: {e}\"}"},{"checksum":"sha256:b57414bb98d9e0621dc5c67eb0201157deb0cc80eccd8abe8b3c70cf68187b10","chunk_id":"chunk_b256e185cd810a17","end_line":222,"path":"workflows/AgentGenerator/tools/hook_ai_pack_archetype_context.py","start_line":1,"symbol_ids":["sym_2d03e5a6364620f7","sym_f4555441de89865b","sym_a081b26e8d9b8758","sym_f0a57529211c94c1","sym_47d8a630e8900506","sym_3ae9c9ffcc5735ad"],"text":"\"\"\"\nHook: Inject AI Pack Archetype and Callback Context\n\nFires as an prompt middleware function on PatternAgent and WorkflowBundleBuilderAgent.\n\nCloses Gap #5 (async event callback loop) \u2014 ensures that AI-native pack workflows\ngenerate:\n  1. A backend_request tool declaration in tools.yaml\n  2. ResultAgent instructions to POST the result to /api/modules/{module_id}/{action_id}\n\n**PatternAgent** \u2014 detects AI-native workflow surfaces in design_surface_map and\ninjects [AI PACK ARCHETYPE CONTEXT] so PatternAgent:\n  - Uses the fixed archetype + workflow_startup_mode instead of free-form selection\n  - Writes a rich initial_message for the WorkflowBundleBuilderAgent worker that\n    includes module_id, callback_endpoint, and explicit generation requirements\n\n**WorkflowBundleBuilderAgent** \u2014 if any AI-native workflow surfaces exist in\ndesign_surface_map, injects [AI PACK CALLBACK CONTRACT] so any worker generating\nan AI-native pack workflow knows how to declare the backend_request tool and\ncall the owning module action.\n\nBoth injections are conditional \u2014 no-op when no AI-native workflow surfaces are\ndetected in design_surface_map.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport logging\nfrom typing import Any\n\nlogger = logging.getLogger(__name__)\n\n_REVIEW_SUFFIX = \"-review-workflow\"\n_ANALYSIS_SUFFIX = \"-analysis-workflow\"\n_EXTRACTION_SUFFIX = \"-extraction-workflow\"\n\n_ARCHETYPE_HEADER = \"[AI PACK ARCHETYPE CONTEXT]\"\n_CALLBACK_HEADER = \"[AI PACK CALLBACK CONTRACT]\"\n\n_ARCHETYPE_MAP = {\n    _REVIEW_SUFFIX: {\n        \"archetype\": \"ai_review\",\n        \"pattern\": \"Feedback Loop\",\n        \"workflow_startup_mode\": \"BackendOnly\",\n        \"agents\": \"IntakeAgent \u2192 ReviewerAgent \u2192 ResultAgent\",\n        \"result_action\": \"record_review_result\",\n        \"result_agent\": \"ResultAgent\",\n    },\n    _ANALYSIS_SUFFIX: {\n        \"archetype\": \"ai_analysis\",\n        \"pattern\": \"Pipeline\",\n        \"workflow_startup_mode\": \"BackendOnly\",\n        \"agents\": \"ContextReaderAgent \u2192 AnalysisAgent \u2192 ResultWriterAgent\",\n        \"result_action\": \"store_analysis_result\",\n        \"result_agent\": \"ResultWriterAgent\",\n    },\n    _EXTRACTION_SUFFIX: {\n        \"archetype\": \"ai_extraction\",\n        \"pattern\": \"Triage with Tasks\",\n        \"workflow_startup_mode\": \"BackendOnly\",\n        \"agents\": \"TriageAgent \u2192 ExtractionWorkerAgent (task_batches) \u2192 SynthesisAgent\",\n        \"result_action\": \"store_extraction_results\",\n        \"result_agent\": \"SynthesisAgent\",\n        \"task_batches_required\": True,\n    },\n}\n\n\ndef _context_get(context_variables: Any, key: str, default: Any = None) -> Any:\n    if context_variables is None:\n        return default\n    getter = getattr(context_variables, \"get\", None)\n    if callable(getter):\n        try:\n            return getter(key, default)\n        except TypeError:\n            value = getter(key)\n            return default if value is None else value\n    if isinstance(context_variables, dict):\n        return context_variables.get(key, default)\n    return default\n\n\ndef _detect_ai_workflow_surfaces(context_variables: Any) -> list[dict]:\n    \"\"\"Return AI workflow surface descriptors from design_surface_map, with derived module_id.\"\"\"\n    found: list[dict] = []\n    surface_map = _context_get(context_variables, \"design_surface_map\") or {}\n    if not isinstance(surface_map, dict):\n        return found\n\n    surfaces = surface_map.get(\"surfaces\") or []\n    for surface in surfaces:\n        if not isinstance(surface, dict):\n            continue\n        if surface.get(\"surface_kind\") != \"workflow\":\n            continue\n        for trigger in surface.get(\"workflow_triggers\") or []:\n            trigger_str = str(trigger or \"\").strip()\n            for suffix, archetype_info in _ARCHETYPE_MAP.items():\n                if trigger_str.endswith(suffix):\n                    # Derive module_id by stripping the suffix\n                    # \"proposals-review-workflow\" \u2192 \"proposals\"\n                    module_id = trigger_str[: -len(suffix)]\n                    found.append({\n                        \"surface_id\": surface.get(\"surface_id\", \"\"),\n                        \"capability_id\": trigger_str,\n                        \"module_id\": module_id,\n                        \"suffix\": suffix,\n                        **archetype_info,  # type: ignore[dict-item]\n                    })\n                    break\n\n    return found\n\n\ndef _inject_section(agent: Any, header: str, body: str) -> None:\n    \"\"\"Append or replace a named section in the agent system message.\"\"\"\n    try:\n        current: str = (\n            getattr(agent, \"system_message\", None)\n            or getattr(agent, \"_system_message\", \"\")\n            or \"\"\n        )\n        section = f\"{header}\\n{body}\"\n        if header in current:\n            pre, _, rest = current.partition(header)\n            next_idx = rest.find(\"\\n\\n[\")\n            after = rest[next_idx:] if next_idx > 0 else \"\"\n            new_message = f\"{pre.rstrip()}\\n\\n{section}{after}\"\n        else:\n            new_message = f\"{current}\\n\\n{section}\" if current else section\n\n        if new_message == current:\n            return\n\n        updater = getattr(agent, \"update_system_message\", None)\n        if callable(updater):\n            updater(new_message)\n        elif hasattr(agent, \"_system_message\"):\n            agent._system_message = new_message\n        else:\n            agent._system_message = new_message\n    except Exception as exc:\n        logger.error(\n            \"[%s] Failed to inject section %s: %s\",\n            getattr(agent, \"name\", \"?\"),\n            header,\n            exc,\n        )\n\n\n# =============================================================================\n# PatternAgent \u2014 archetype + initial_message template\n# =============================================================================\n\ndef _build_pattern_body(ai_surfaces: list[dict]) -> str:\n    lines: list[str] = [\n        \"The design_surface_map contains AI-native workflow surfaces. \"\n        \"These use FIXED archetypes \u2014 do NOT apply free-form pattern selection. \"\n        \"Use the archetype, workflow_startup_mode, and initial_message template below for each.\\n\",\n        \"RULES FOR AI-NATIVE WORKFLOWS:\\n\"\n        \"  - role: supporting (all AI-native workflows run in the background)\\n\"\n        \"  - workflow_startup_mode: BackendOnly (no user chat session)\\n\"\n        \"  - human_in_the_loop: false\\n\"\n        \"  - The initial_message MUST include module_id, callback_action, and callback_endpoint\\n\"\n        \"    so the scoped task includes the full return-path contract.\\n\",\n    ]\n\n    for s in ai_surfaces:\n        cap_id = s[\"capability_id\"]\n        module_id = s[\"module_id\"]\n        archetype = s[\"archetype\"]\n        pattern = s[\"pattern\"]\n        agents_seq = s[\"agents\"]\n        result_action = s[\"result_action\"]\n        result_agent = s[\"result_agent\"]\n        tb = s.get(\"task_batches_required\", False)\n        callback_endpoint = f\"POST /api/modules/{module_id}/{result_action}\"\n\n        initial_msg = (\n            f\"Generate a BackendOnly {archetype} workflow bundle. \"\n            f\"capability_id={cap_id}, workflow_name={_to_pascal(cap_id)}. \"\n            f\"Use the {pattern} orchestration pattern with agent sequence: {agents_seq}. \"\n            f\"workflow_startup_mode=BackendOnly, human_in_the_loop=false. \"\n            f\"CALLBACK CONTRACT: the {result_agent} MUST call backend_request \"\n            f\"(POST {callback_endpoint}) to write the result back to the owning module. \"\n            f\"Declare backend_request from mozaiksai.core.workflow.app_backend_tools in tools.yaml. \"\n        )\n        if tb:\n            initial_msg += \"task_batches.yaml is required for parallel worker dispatch. \"\n\n        block = (\n            f\"capability_id: {cap_id}\\n\"\n            f\"  module_id: {module_id}\\n\"\n            f\"  archetype: {archetype}\\n\"\n            f\"  pattern: {pattern}\\n\"\n            f\"  workflow_startup_mode: BackendOnly\\n\"\n            f\"  agent_sequence: {agents_seq}\\n\"\n            f\"  result_agent: {result_agent}\\n\"\n            f\"  result_callback_action: {result_action}\\n\"\n            f\"  callback_endpoint: {callback_endpoint}\\n\"\n        )\n        if tb:\n            block += \"  task_batches_required: true\\n\"\n        block += f\"\\n  initial_message to use:\\n  \\\"{initial_msg}\\\"\\n\"\n        lines.append(block)\n\n    return \"\\n\".join(lines)\n\n\ndef _to_pascal(capability_id: str) -> str:\n    \"\"\"Convert 'proposals-review-workflow' \u2192 'ProposalsReviewWorkflow'.\"\"\"\n    return \"\".join(part.capitalize() for part in capability_id.split(\"-\"))\n\n\n# =============================================================================\n# WorkflowBundleBuilderAgent \u2014 callback contract\n# =============================================================================\n\ndef _build_callback_body(ai_surfaces: list[dict]) -> str:\n    lines: list[str] = [\n        \"If your initial_message identifies this workflow as an AI-native pack workflow \""},{"checksum":"sha256:bce9b7d443662a8ab2c57ad409c54716168242b6935b2f456c00505e9fcdb1be","chunk_id":"chunk_316469a9e356d064","end_line":325,"path":"workflows/AgentGenerator/tools/hook_ai_pack_archetype_context.py","start_line":223,"symbol_ids":["sym_3ae9c9ffcc5735ad","sym_966e7e896fc4cc72"],"text":"        \"(capability_id ending in -review-workflow, -analysis-workflow, or -extraction-workflow), \"\n        \"you MUST follow this callback contract in addition to your standard bundle generation.\\n\",\n        \"REQUIRED FILES for AI-native pack workflows:\\n\"\n        \"\\n\"\n        \"1. backend_request tool in tools.yaml\\n\"\n        \"   Add this entry to the tools[] list:\\n\"\n        \"   ```yaml\\n\"\n        \"   - name: backend_request\\n\"\n        \"     type: Agent_Tool\\n\"\n        \"     module: mozaiksai.core.workflow.app_backend_tools\\n\"\n        \"     function: backend_request\\n\"\n        \"   ```\\n\"\n        \"   Assign backend_request to the {result_agent} only.\\n\"\n        \"   Do NOT generate a Python stub for backend_request \u2014 it is a platform tool.\\n\"\n        \"\\n\"\n        \"2. {result_agent} instructions in agents.yaml\\n\"\n        \"   The result/writer/synthesis agent MUST:\\n\"\n        \"   - Call backend_request(method='POST', path='/api/modules/{module_id}/{result_action}',\\n\"\n        \"     payload={...result fields...})\\n\"\n        \"   - Confirm success before terminating\\n\"\n        \"   - Terminate to 'terminate' (BackendOnly \u2014 no user reply)\\n\"\n        \"\\n\"\n        \"3. No Python stub for backend_request\\n\"\n        \"   backend_request is provided by mozaiksai.core.workflow.app_backend_tools.\\n\"\n        \"   Only generate stubs for workflow-local custom tools.\\n\",\n    ]\n\n    # Add per-surface details for context\n    if ai_surfaces:\n        lines.append(\"AI-native workflow surfaces detected in this app's design_surface_map:\")\n        for s in ai_surfaces:\n            lines.append(\n                f\"  capability_id: {s['capability_id']}  \"\n                f\"module_id: {s['module_id']}  \"\n                f\"result_action: {s['result_action']}  \"\n                f\"result_agent: {s['result_agent']}\"\n            )\n        lines.append(\n            \"\\nMatch your initial_message's capability_id against the list above to find \"\n            \"the exact module_id and result_action for your backend_request callback.\\n\"\n        )\n\n    return \"\\n\".join(lines)\n\n\n# =============================================================================\n# Hook entry point\n# =============================================================================\n\ndef inject_ai_pack_archetype_context(\n    agent: Any,\n    messages: list[dict[str, Any]],\n) -> None:\n    \"\"\"\n    prompt middleware function for PatternAgent and WorkflowBundleBuilderAgent.\n\n    PatternAgent: injects [AI PACK ARCHETYPE CONTEXT] with fixed archetype,\n    workflow_startup_mode, and enriched initial_message templates.\n\n    WorkflowBundleBuilderAgent: injects [AI PACK CALLBACK CONTRACT] so any\n    worker generating an AI-native pack workflow knows to declare backend_request\n    and call the owning module action.\n\n    No-ops when no AI-native workflow surfaces are found.\n    \"\"\"\n    agent_name = getattr(agent, \"name\", \"\")\n    if agent_name not in (\"PatternAgent\", \"WorkflowBundleBuilderAgent\"):\n        return\n\n    context_variables = getattr(agent, \"context_variables\", None)\n\n    try:\n        ai_surfaces = _detect_ai_workflow_surfaces(context_variables)\n        if not ai_surfaces:\n            return\n\n        if agent_name == \"PatternAgent\":\n            body = _build_pattern_body(ai_surfaces)\n            _inject_section(agent, _ARCHETYPE_HEADER, body)\n            logger.info(\n                \"[PatternAgent] Injected AI pack archetype context for: %s\",\n                \", \".join(s[\"capability_id\"] for s in ai_surfaces),\n            )\n\n        elif agent_name == \"WorkflowBundleBuilderAgent\":\n            body = _build_callback_body(ai_surfaces)\n            _inject_section(agent, _CALLBACK_HEADER, body)\n            logger.info(\n                \"[WorkflowBundleBuilderAgent] Injected AI pack callback contract \"\n                \"(%d AI workflow(s) in scope)\",\n                len(ai_surfaces),\n            )\n\n    except Exception as exc:\n        logger.error(\n            \"[%s] Failed to inject AI pack archetype/callback context: %s\",\n            agent_name,\n            exc,\n        )\n\n\n__all__ = [\"inject_ai_pack_archetype_context\"]\n"},{"checksum":"sha256:ea859f8f34bb4bada26a893baeb1f3722f6e6d564342e03ef5a7167f55c1f0e8","chunk_id":"chunk_dfef1b3733f716aa","end_line":87,"path":"workflows/AgentGenerator/tools/hook_primitive_catalog.py","start_line":1,"symbol_ids":["sym_fc579e9b415a5d8d","sym_3f7e266e62e5d258","sym_db88086af43975c8"],"text":"from __future__ import annotations\n\nimport logging\nfrom typing import Any\n\nfrom mozaiksai.core.workflow.transition_ui_catalog import (\n    format_transition_ui_catalog_guidance,\n)\nfrom mozaiksai.core.workflow.ui_primitives import (\n    format_generated_component_ui_primitive_guidance,\n)\nfrom mozaiksai.core.workflow.ui_surface_taxonomy import format_ui_surface_taxonomy_guidance\nfrom mozaiksai.core.workflow.workflow_ui_catalog import (\n    format_workflow_ui_catalog_guidance,\n)\n\nlogger = logging.getLogger(__name__)\n\n_HEADER = \"[SHIPPED UI PRIMITIVES]\"\n_TARGET_AGENTS = {\"ToolPlanningAgent\", \"ToolsManagerAgent\", \"UIFileGenerator\"}\n_SURFACE_HEADER = \"[UI SURFACE TAXONOMY]\"\n_WORKFLOW_HEADER = \"[WORKFLOW UI PRIMITIVE CATALOG]\"\n_TRANSITION_HEADER = \"[TRANSITION UI PRIMITIVE CATALOG]\"\n_TRANSITION_TARGET_AGENTS = {\"PackMetadataAgent\", \"UIFileGenerator\"}\n\n\ndef _apply_system_message(agent: Any, message: str) -> None:\n    updater = getattr(agent, \"update_system_message\", None)\n    if callable(updater):\n        updater(message)\n    elif hasattr(agent, \"_system_message\"):\n        agent._system_message = message\n    else:\n        agent._system_message = message\n    agent._mozaiks_base_system_message = message\n\n\ndef _update_section(agent: Any, header: str, body: str) -> None:\n    current = getattr(agent, \"system_message\", None) or getattr(agent, \"_system_message\", \"\") or \"\"\n    section = f\"{header}\\n{body}\"\n    if header in current:\n        prefix = current.split(header, 1)[0].rstrip()\n        new_message = f\"{prefix}\\n\\n{section}\" if prefix else section\n    else:\n        new_message = f\"{current}\\n\\n{section}\" if current else section\n\n    if new_message == current:\n        return\n\n    _apply_system_message(agent, new_message)\n\n\ndef inject_primitive_catalog(agent: Any, messages: list[dict[str, Any]]) -> None:\n    agent_name = getattr(agent, \"name\", \"\")\n    if agent_name not in _TARGET_AGENTS and agent_name not in _TRANSITION_TARGET_AGENTS:\n        return\n\n    try:\n        if agent_name in _TARGET_AGENTS:\n            guidance = format_generated_component_ui_primitive_guidance()\n            rules = [\n                \"Rules:\",\n                \"- Use only the shipped primitive names listed here.\",\n                \"- If the desired UI is richer, compose it from these primitives instead of inventing a new primitive name.\",\n                \"- If upstream context requests an unknown primitive, treat that as invalid rather than silently substituting.\",\n            ]\n            if agent_name == \"ToolPlanningAgent\":\n                rules.append(\"- `primitives_hint` must contain only names from this catalog.\")\n                rules.append(\"- When the workflow primitive catalog says a surface maps to a shipped shared component, prefer that component directly instead of inventing a wrapper name.\")\n            if agent_name == \"UIFileGenerator\":\n                rules.append(\"- Generated React imports must come only from this catalog.\")\n                rules.append(\"- If the workflow primitive catalog maps a surface to a shipped shared component, do not generate bespoke React for it unless a thin wrapper is explicitly required.\")\n\n            body = f\"{guidance}\\n\\n\" + \"\\n\".join(rules)\n            _update_section(agent, _SURFACE_HEADER, format_ui_surface_taxonomy_guidance())\n            _update_section(agent, _HEADER, body)\n            _update_section(agent, _WORKFLOW_HEADER, format_workflow_ui_catalog_guidance())\n\n        if agent_name in _TRANSITION_TARGET_AGENTS:\n            _update_section(agent, _TRANSITION_HEADER, format_transition_ui_catalog_guidance())\n\n        logger.info(\"[%s] Injected UI primitive catalogs\", agent_name)\n    except Exception as exc:\n        logger.error(\"[%s] Failed to inject primitive catalog: %s\", agent_name, exc)\n\n\n__all__ = [\"inject_primitive_catalog\"]"},{"checksum":"sha256:b6264c77e5d0c515957a4d720e806070f2040a7938a233c0ba0f64fbe381e7b2","chunk_id":"chunk_3588494cf753c4c5","end_line":177,"path":"workflows/AgentGenerator/tools/hook_universal_prompts.py","start_line":1,"symbol_ids":["sym_3973e48a54b77375"],"text":"\"\"\"\nUniversal prompt injections for Generator workflow agents.\n\nThis single hook consolidates all universal and shared prompt sections:\n1. UNIVERSAL (all agents): Compliance, agentic best practices, runtime context\n2. CONDITIONAL (specific agents): JSON compliance, semantic references, validation\n\nSeparation of Concerns (with other hooks):\n- hook_universal_prompts.py: ALL universal behavior and compliance (this file)\n- hook_file_generation.py: Code generation best practices (UIFileGenerator, AgentToolsFileGenerator)\n- prompt middleware pattern helpers: Dynamic pattern-specific guidance\n\"\"\"\n\nimport logging\nfrom typing import Any\n\nlogger = logging.getLogger(__name__)\n\n\ndef _apply_system_message(agent: Any, message: str) -> None:\n    updater = getattr(agent, \"update_system_message\", None)\n    if callable(updater):\n        updater(message)\n    elif hasattr(agent, \"_system_message\"):\n        agent._system_message = message\n    else:\n        agent._system_message = message\n    agent._mozaiks_base_system_message = message\n\n# =============================================================================\n# SECTION 1: UNIVERSAL - Apply to ALL agents\n# =============================================================================\n\nCOMPLIANCE_REQUIREMENTS = \"\"\"\n[COMPLIANCE REQUIREMENTS]\nYou MUST follow these guidelines strictly for legal reasons. NEVER stray from them.\n\n**Output Compliance**:\n- You MUST adhere to the specified '[OUTPUT FORMAT]' section below and its instructions EXACTLY.\n- For structured-output turns, NEVER include commentary, explanations, or text outside the required response shape.\n- Your outputs are used in an automation process where schema mismatches halt the workflow.\n\"\"\"\n\nAGENTIC_BEST_PRACTICES = \"\"\"\n[AGENTIC BEST PRACTICES]\nYou are an AI agent in a multi-agent workflow. Follow these universal behaviors:\n\n**Execution Discipline**:\n- Focus ONLY on your designated role and objective - NEVER attempt tasks outside your scope.\n- Read upstream context fully before generating output - NEVER assume or fabricate data.\n- When in doubt about requirements, prefer conservative/safe choices over speculative ones.\n- Complete your task fully in a single turn when possible - avoid partial outputs.\n\n**Context Awareness**:\n- Reason from the semantic inputs actually supplied in this invocation: exposed context variables, the scoped task brief, tool results, and explicitly included messages.\n- Identify each input by its meaning and exact available fields. A model type name is not automatically a context key or JSON wrapper.\n- Read upstream outputs according to their stated role: approved requirements constrain scope, evidence supports conclusions, and review feedback identifies needed changes. Explain how those inputs determine your output fields; do not treat all artifacts as equal authority.\n- Do not refer to other agents by name or assume access to their outputs, roster, or conversation history. Describe your responsibility by purpose.\n- Generated prompts and task briefs must follow the same rule: name the actual input fields, explain the required transformation, and specify the output contract.\n- Agent identifiers remain valid in declared roster, routing, tool arguments, and registry fields. Filenames remain valid when the task explicitly generates or inspects files; neither is an implicit source of knowledge.\n- Copy supplied contract identifiers and values EXACTLY where the output schema requires them - NEVER paraphrase or abbreviate.\n- Validate cross-references before emitting output.\n\n**Quality Standards**:\n- No placeholders, TODOs, or \"implement later\" markers in your output, anything you output MUST be production ready.\n- All identifiers MUST follow naming conventions: PascalCase for agents/components, snake_case for tools/variables.\n- All outputs MUST be syntactically valid and immediately usable by downstream agents.\n- Verify your output against the '[OUTPUT FORMAT]' schema before emitting.\n\n**Error Handling**:\n- If required input data is missing, use the declared clarification or failure path. Do not invent inputs, add undeclared response fields, or append prose outside a structured output.\n- If instructions conflict, preserve the declared task and response contracts and report the conflict through an allowed field or tool.\n- If a validation check fails, correct the error and re-validate before emitting.\n\"\"\"\n\nRUNTIME_CONTEXT = \"\"\"\n[MOZAIKS RUNTIME CONTEXT]\nThe MozaiksCore platform provides these capabilities automatically. NEVER design workflows that recreate them.\n\n**Chat Transport & UI (ChatUI + WebSocket)**\n- Real-time bidirectional messaging via WebSocket\n- React chat interface with message streaming, typing indicators, reconnection handling\n- Message history display and scroll management\n- NEVER CREATE: UserProxy agents, chat interfaces, or message transport\n\n**Persistence (AG2PersistenceManager)**\n- Automatic conversation history persistence to MongoDB\n- Session state management across reconnections\n- Chat resume with full message history\n- Context variable storage and retrieval\n- NEVER CREATE: Database schemas, persistence logic, or history tracking\n\n**Token Management (Platform Runtime)**\n- Real-time token usage tracking per app_id and user_id\n- Wallet balance management and low-balance warnings\n- Cost attribution per workflow and chat session\n- NEVER CREATE: [REDACTED] trackers, cost analytics, or usage monitors\n\n**Multi-Tenant Isolation**\n- App and user boundaries enforced at runtime\n- Data isolation between tenants, session scoping\n- NEVER CREATE: Tenant validation or scoped query logic\n\n**Observability & Events**\n- Structured logging with correlation IDs\n- Performance metrics, agent lifecycle tracking\n- Unified event dispatching for agent actions\n- NEVER CREATE: Logging infrastructure, metrics collection, or event systems\n\n**UI Component Delivery (ChatUI artifacts)**\n- Inline component rendering within chat flow\n- Artifact panel for rich content display\n- Form submission and response handling\n- NEVER CREATE: React components, UI layouts, or form state handlers\n\n**What Workflows SHOULD Define**:\n1. Agent Roles & Prompts - What each agent does and how it thinks\n2. Tools & Integrations - Declared external APIs, managed facades, and domain business logic\n3. Orchestration Flow - How agents coordinate and hand off\n4. Context Variables - Domain-specific state the workflow tracks\n5. Human Interaction Points - Where users provide input or approval\n6. Lifecycle Hooks - Custom initialization/cleanup beyond runtime defaults\n\n**Monetization Boundary**:\n- Workflows may call declared app module actions, managed-capability facade actions,\n  or workflow-local tools supplied by the app bundle.\n- Workflows must not call raw payment providers, hosted product internals, wallet\n  ledgers, subscription ledgers, or billing service endpoints directly.\n- When a tool or module action returns `INSUFFICIENT_TOKENS`, stop that paid path\n  and surface the structured recovery metadata. Do not retry automatically or\n  attempt to bypass token/entitlement checks.\n\n**Anti-Patterns to Avoid**:\n\u274c \"ChatAgent\" or \"UserProxyAgent\" - Runtime handles user communication\n\u274c Agents that recreate workflow persistence - Use context variables; runtime persists\n\u274c \"TokenTracker\" or \"UsageMonitor\" - OSS runtime token wallet and usage primitives handle this automatically\n\u274c \"WebSocketHandler\" or \"MessageRouter\" - Transport layer is provided\n\u274c \"SessionManager\" or \"LoggingAgent\" - Runtime manages these\n\"\"\"\n\n\n# =============================================================================\n# SECTION 2: CONDITIONAL - Apply to specific agent types\n# =============================================================================\n\nJSON_OUTPUT_COMPLIANCE = \"\"\"\n[JSON OUTPUT COMPLIANCE]\n(CRITICAL - REQUIRED FOR ALL STRUCTURED OUTPUTS)\nYou MUST output valid, parseable JSON. Follow these rules EXACTLY:\n\n**1. Output Format**:\n- Output ONLY raw JSON object - no markdown code fences (```json), no explanatory text\n- JSON MUST be valid and parseable by json.loads() without any cleaning\n\n**2. String Escaping (CRITICAL)**:\nWhen JSON strings contain special characters, escape them correctly:\n- Double quotes: Use `\\\\\"` (single backslash + quote)\n  * CORRECT: `\"description\": \"This is a \\\\\"quoted\\\\\" word\"`\n  * WRONG: `\"description\": \"This is a \\\\\\\\\\\\\"quoted\\\\\\\\\\\\\" word\"` (double-escaped)\n\n- Python docstrings (triple quotes): Use `\\\\\"\\\\\"\\\\\"` (escape each quote separately)\n  * CORRECT: `\"code\": \"def func():\\\\n    \\\\\"\\\\\"\\\\\"This is a docstring\\\\\"\\\\\"\\\\\"\\\\n    pass\"`\n\n- Single quotes in strings: Use `'` (NO escaping needed in JSON)\n  * CORRECT: `\"text\": \"It's a test\"`\n  * WRONG: `\"text\": \"It\\\\'s a test\"` (invalid escape sequence)\n\n- Backslashes: Use `\\\\\\\\` (double backslash)\n  * CORRECT: `\"path\": \"C:\\\\\\\\Users\\\\\\\\file.txt\"`\n\n- Newlines: Use `\\\\n`, tabs: Use `\\\\t`\n\n**3. No Trailing Commas**:\n- CORRECT: `{\"a\": 1, \"b\": 2}`\n- WRONG: `{\"a\": 1, \"b\": 2,}` (trailing comma)\n\n**4. No Trailing Garbage**:"},{"checksum":"sha256:33696edcc5193dea951b59ce8bd753288b6f01cee3b9be5d231f51159ea995fc","chunk_id":"chunk_894ad8d1c42ebc5c","end_line":362,"path":"workflows/AgentGenerator/tools/hook_universal_prompts.py","start_line":178,"symbol_ids":["sym_e9e977fb481f9c28"],"text":"- JSON MUST end with final closing brace `}`\n- NO additional text, notes, or comments after JSON\n\n**5. Test Your Output**:\nBefore emitting, mentally verify your JSON would pass `json.loads(your_output)`\n\n**Summary**: Single-escape quotes (`\\\\\"`), no markdown fences, valid JSON only.\n\"\"\"\n\nSEMANTIC_REFERENCE_RULES = \"\"\"\n[SEMANTIC REFERENCE RULES]\n(CRITICAL - PREVENTS CROSS-REFERENCE ERRORS)\n\nCopy supplied contract identifiers exactly, preserving case and spelling:\n- Workflow names and dependencies come from the supplied workflow specification.\n- In generated bundles, roster entries declare identifiers; routing, tool bindings,\n  and structured-output registry entries must reference those same identifiers.\n- Context references must resolve to declared variables exposed to the consumer.\n- Tool arguments must use the exact identifiers and allowed values in their schema.\n\nCopy character-for-character. Casing and spelling are part of the identifier:\n\n**Roster identifiers** (PascalCase preserved)\n  \u2705 the roster you declared contains \"RouterAgent\" \u2192 routing uses \"RouterAgent\"\n  \u274c the roster you declared contains \"RouterAgent\" \u2192 routing uses \"Router\" or \"routerAgent\"\n\n**Tool names** (snake_case preserved)\n  \u2705 the tool contract declares \"classify_request\" \u2192 the binding uses \"classify_request\"\n  \u274c the tool contract declares \"classify_request\" \u2192 the binding uses \"ClassifyRequest\"\n\n**Context variable names** (snake_case preserved)\n  \u2705 the exposed variable is \"current_domain\" \u2192 the reference uses \"current_domain\"\n  \u274c the exposed variable is \"current_domain\" \u2192 the reference uses \"currentDomain\"\n\n**Supplied workflow names** (copied verbatim, including any prefix)\n  \u2705 the specification names \"Stage 1: Intake\" \u2192 your output uses \"Stage 1: Intake\"\n  \u274c the specification names \"Stage 1: Intake\" \u2192 your output uses \"Intake Module\"\n\n**WHY**: The runtime resolves these by exact string match. Any deviation in\ncasing, spelling, or abbreviation causes a load or dispatch failure.\n\nDeclare new identifiers only when designing artifacts within the scoped task.\nDo not infer extra input objects from schema names, prior participants, or examples.\nReasoning prompts describe data dependencies by semantic fields; declarative\nreferences describe how the runtime connects the generated artifacts.\n\"\"\"\n\nVALIDATION_CHECKLIST = \"\"\"\n[CROSS-REFERENCE VALIDATION]\n(REQUIRED BEFORE EMITTING JSON OUTPUT)\n\nBefore you emit your final JSON, verify these checks:\n\nFor the artifacts within your assigned task:\n\u25a1 Every agent binding resolves to the declared roster\n\u25a1 Every tool binding matches its declared callable and schema\n\u25a1 Every transition source resolves to the roster or the canonical user source; each target resolves to the roster or an allowed terminal/user target\n\u25a1 Every prompt input is actually supplied, and each context reference resolves to a variable exposed to that consumer\n\u25a1 Every generated prompt describes its inputs and output contract without depending on a producer's identity or unseen history\n\u25a1 Every supplied workflow name and dependency is preserved exactly\n\nIf any check fails, correct the error before emitting.\n\"\"\"\n\nUI_SURFACE_LANE_DISCIPLINE = \"\"\"\n[UI SURFACE LANE DISCIPLINE]\nGenerated frontend work must stay in the correct UI surface lane.\n\n- Persistent app pages are AppGenerator-owned `declarative_page` or bounded `custom_react_page` artifacts.\n- Agent UI tools are workflow-local, response-bearing chat surfaces owned by AgentGenerator.\n- Transition UI is for workflow-sequence routing and choice screens only.\n- Do NOT generate persistent app pages from AgentGenerator UI tool prompts.\n- Do NOT turn workflow-local UI into app routes, shell chrome, profile menus, notifications, or global navigation.\n- Use the shipped `@mozaiks/chat-ui/ui` primitives for generated React and keep custom surfaces bounded to the declared workflow UI contract.\n\"\"\"\n\n\n# =============================================================================\n# HOOK FUNCTION - Single entry point for all injections\n# =============================================================================\n\ndef inject_universal_prompts(agent, messages: list[dict[str, Any]], run_context: Any = None) -> str:\n    \"\"\"\n    Injects universal and conditional prompt sections into agent system message.\n    \n    UNIVERSAL (all agents):\n    - COMPLIANCE_REQUIREMENTS: Output format adherence\n    - AGENTIC_BEST_PRACTICES: Execution discipline, context awareness\n    \n    CONDITIONAL (by agent type):\n    - RUNTIME_CONTEXT: workflow_design_agents - might invent wrong agent types\n    - JSON_OUTPUT_COMPLIANCE: Agents with structured output requirements\n    - SEMANTIC_REFERENCE_RULES: cross_referencing_agents - must copy names exactly\n    - VALIDATION_CHECKLIST: artifact_producing_agents - outputs become final artifacts\n    \n    This keeps prompts lean - agents only get what they need.\n    \"\"\"\n    try:\n        agent_name = getattr(agent, 'name', 'unknown')\n        system_message = getattr(agent, 'system_message', '') or \"\"\n        \n        # Skip user agent\n        if agent_name == \"user\":\n            logger.debug(\"Skipping prompt injection for %s (user agent)\", agent_name)\n            return system_message\n        \n        sections_added = []\n        \n        # =================================================================\n        # UNIVERSAL SECTIONS (all agents)\n        # =================================================================\n        \n        if \"[COMPLIANCE REQUIREMENTS]\" not in system_message:\n            system_message += f\"\\n\\n{COMPLIANCE_REQUIREMENTS}\"\n            sections_added.append(\"COMPLIANCE_REQUIREMENTS\")\n        \n        if \"[AGENTIC BEST PRACTICES]\" not in system_message:\n            system_message += f\"\\n\\n{AGENTIC_BEST_PRACTICES}\"\n            sections_added.append(\"AGENTIC_BEST_PRACTICES\")\n        \n        # =================================================================\n        # CONDITIONAL SECTIONS (specific agent types)\n        # =================================================================\n        \n        # Skip purely conversational agents for all conditional sections\n        conversational_agents = {\"InterviewAgent\"}\n        if agent_name in conversational_agents:\n            _apply_system_message(agent, system_message)\n            if sections_added:\n                logger.info(\"\u2713 Injected universal sections into %s: %s\", agent_name, \", \".join(sections_added))\n            return system_message\n        \n        # Agents that design workflow structure - might accidentally create\n        # UserProxy, persistence, or token tracking agents\n        workflow_design_agents = {\n            \"WorkflowBundleBuilderAgent\",\n        }\n\n        if agent_name in workflow_design_agents and \"[MOZAIKS RUNTIME CONTEXT]\" not in system_message:\n            system_message += f\"\\n\\n{RUNTIME_CONTEXT}\"\n            sections_added.append(\"RUNTIME_CONTEXT\")\n        \n        # JSON compliance for structured output agents\n        needs_structured = (\n            \"structured_output\" in system_message.lower() or\n            \"json\" in system_message.lower() or\n            \"[OUTPUT FORMAT]\" in system_message\n        )\n        \n        if needs_structured and \"[JSON OUTPUT COMPLIANCE]\" not in system_message:\n            system_message += f\"\\n\\n{JSON_OUTPUT_COMPLIANCE}\"\n            sections_added.append(\"JSON_OUTPUT_COMPLIANCE\")\n        \n        # Agents that read names from upstream and must copy them exactly\n        cross_referencing_agents = {\n            \"PatternAgent\", \"WorkflowBundleBuilderAgent\", \"PackMetadataAgent\",\n            \"ProjectOverviewAgent\", \"DownloadAgent\",\n        }\n        \n        if agent_name in cross_referencing_agents and \"[SEMANTIC REFERENCE RULES]\" not in system_message:\n            system_message += f\"\\n\\n{SEMANTIC_REFERENCE_RULES}\"\n            sections_added.append(\"SEMANTIC_REFERENCE_RULES\")\n        \n        # Agents whose outputs become final workflow artifacts (JSON files or code)\n        # Need cross-reference validation before emitting\n        artifact_producing_agents = {\n            \"WorkflowBundleBuilderAgent\", \"PackMetadataAgent\", \"DownloadAgent\",\n            \"ProjectOverviewAgent\",\n        }\n\n        if agent_name in artifact_producing_agents and \"[CROSS-REFERENCE VALIDATION]\" not in system_message:\n            system_message += f\"\\n\\n{VALIDATION_CHECKLIST}\"\n            sections_added.append(\"VALIDATION_CHECKLIST\")\n\n        ui_surface_agents = {\"WorkflowBundleBuilderAgent\", \"PackMetadataAgent\"}\n        if agent_name in ui_surface_agents and \"[UI SURFACE LANE DISCIPLINE]\" not in system_message:\n            system_message += f\"\\n\\n{UI_SURFACE_LANE_DISCIPLINE}\"\n            sections_added.append(\"UI_SURFACE_LANE_DISCIPLINE\")\n        \n        # Update agent and log\n        _apply_system_message(agent, system_message)\n        \n        if sections_added:\n            logger.info(\"\u2713 Injected prompt sections into %s: %s\", agent_name, \", \".join(sections_added))\n        else:"},{"checksum":"sha256:de467e6041bd727258763cbda4cb05606a981b4d5b551d3ae7ced37553f97096","chunk_id":"chunk_e4810974345d974e","end_line":372,"path":"workflows/AgentGenerator/tools/hook_universal_prompts.py","start_line":363,"symbol_ids":["sym_e9e977fb481f9c28"],"text":"            logger.debug(\"No changes needed for %s (all sections already present)\", agent_name)\n        \n        return system_message\n\n    except Exception as e:\n        logger.error(\"Error injecting prompts for %s: %s\", getattr(agent, \"name\", \"unknown\"), e, exc_info=True)\n        return getattr(agent, 'system_message', '') or \"\"\n\n\n"},{"checksum":"sha256:f1d2451fa1efb6184bc6baf4096ce5d18f8764b37ae59f5db1a5f94ed3af494e","chunk_id":"chunk_5185eb44c7365a75","end_line":215,"path":"workflows/AgentGenerator/tools/hook_workflow_archetypes_context.py","start_line":1,"symbol_ids":["sym_bb2cc4b074281fde","sym_e3a9c06b7e7fe835","sym_a650930fd246ebd3","sym_47e535a85d3e2edd","sym_7a0fda3057671761"],"text":"\"\"\"\nHook: Inject Workflow Archetype Library into WorkflowBundleBuilderAgent.\n\nFires as a prompt middleware function on WorkflowBundleBuilderAgent.\n\nWorkflowBundleBuilderAgent receives AG2 orchestration pattern guidance and the\nhigher-level workflow archetypes that define:\n  - Canonical agent sequences for AI-native packs (ai_review, ai_analysis, ai_extraction)\n  - Per-archetype hard constraints (workflow_startup_mode, result action contract, forbidden operations)\n  - Orchestrator defaults (human_in_the_loop, max_turns, workflow_startup_mode)\n\nWhen the worker's current_task has a capability_id ending in a known AI-native\nsuffix, this hook injects the matching archetype from workflow_archetypes.yaml as\n[WORKFLOW ARCHETYPE: <name>] so the agent has the full agent sequence and\nbehavioral constraints, not just the AG2 pattern topology.\n\nNo-ops for non-AI-native workflows.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport logging\nfrom typing import Any\n\nimport yaml\n\nfrom factory_app.workflows._shared.hook_utils import workflow_context_path\n\nlogger = logging.getLogger(__name__)\n\n_WORKFLOW_ARCHETYPES_PATH = workflow_context_path(\"AppGenerator\", \"workflow_archetypes.yaml\")\n\n_HEADER_PREFIX = \"[WORKFLOW ARCHETYPE]\"\n\n_SUFFIX_TO_ARCHETYPE = {\n    \"-review-workflow\": \"ai_review\",\n    \"-analysis-workflow\": \"ai_analysis\",\n    \"-extraction-workflow\": \"ai_extraction\",\n}\n\n\ndef _load_archetypes() -> dict[str, Any]:\n    try:\n        with _WORKFLOW_ARCHETYPES_PATH.open(encoding=\"utf-8\") as f:\n            data = yaml.safe_load(f)\n        return data.get(\"archetypes\", {}) if isinstance(data, dict) else {}\n    except Exception as exc:\n        logger.warning(\"[hook_workflow_archetypes_context] Failed to load workflow_archetypes.yaml: %s\", exc)\n        return {}\n\n\ndef _detect_archetype_name(context_variables: Any) -> str | None:\n    \"\"\"Return the archetype name for the current task if it is an AI-native workflow.\"\"\"\n    ctx: dict[str, Any] = {}\n    if hasattr(context_variables, \"data\"):\n        ctx = context_variables.data\n    elif isinstance(context_variables, dict):\n        ctx = context_variables\n\n    current_task = ctx.get(\"current_task\") or {}\n    if not isinstance(current_task, dict):\n        return None\n\n    capability_id = str(current_task.get(\"capability_id\") or \"\").strip()\n    if not capability_id:\n        # Fall back to workflow name\n        capability_id = str(current_task.get(\"name\") or \"\").strip()\n    if not capability_id:\n        return None\n\n    for suffix, archetype_name in _SUFFIX_TO_ARCHETYPE.items():\n        if capability_id.endswith(suffix):\n            return archetype_name\n    return None\n\n\ndef _render_archetype_section(name: str, archetype: dict[str, Any]) -> str:\n    \"\"\"Render a single archetype entry as readable guidance.\"\"\"\n    lines: list[str] = [\n        \"You are generating a workflow bundle for an AI-native pack workflow.\",\n        f\"The assigned archetype is: {name}\",\n        \"\",\n    ]\n\n    summary = str(archetype.get(\"summary\", \"\")).strip()\n    if summary:\n        lines.append(f\"SUMMARY: {summary}\")\n        lines.append(\"\")\n\n    workflow_startup_mode = str(archetype.get(\"workflow_startup_mode\", \"\")).strip()\n    if workflow_startup_mode:\n        lines.append(f\"workflow_startup_mode: {workflow_startup_mode}\")\n\n    orchestration_pattern = str(archetype.get(\"orchestration_pattern\", \"\")).strip()\n    if orchestration_pattern:\n        lines.append(f\"orchestration_pattern: {orchestration_pattern}\")\n\n    defaults = archetype.get(\"orchestrator_defaults\") or {}\n    if isinstance(defaults, dict) and defaults:\n        lines.append(\"orchestrator_defaults:\")\n        for k, v in defaults.items():\n            lines.append(f\"  {k}: {v}\")\n    lines.append(\"\")\n\n    canon_seq = archetype.get(\"canonical_agent_sequence\") or []\n    if canon_seq:\n        lines.append(\"CANONICAL AGENT SEQUENCE (follow exactly):\")\n        for entry in canon_seq:\n            if isinstance(entry, dict):\n                for agent_name, agent_spec in entry.items():\n                    role = str(agent_spec.get(\"role\", \"\")).strip() if isinstance(agent_spec, dict) else \"\"\n                    mcr = agent_spec.get(\"max_consecutive_auto_reply\") if isinstance(agent_spec, dict) else None\n                    sout = agent_spec.get(\"structured_outputs_required\") if isinstance(agent_spec, dict) else None\n                    lines.append(f\"  - {agent_name}:\")\n                    if role:\n                        # Wrap role text\n                        lines.append(f\"      role: {role[:300]}\")\n                    if mcr is not None:\n                        lines.append(f\"      max_consecutive_auto_reply: {mcr}\")\n                    if sout is not None:\n                        lines.append(f\"      structured_outputs_required: {sout}\")\n        lines.append(\"\")\n\n    hard_constraints = archetype.get(\"hard_constraints\") or []\n    if hard_constraints:\n        lines.append(\"HARD CONSTRAINTS (enforced \u2014 never violate):\")\n        for hc in hard_constraints:\n            lines.append(f\"  - {str(hc).strip()}\")\n        lines.append(\"\")\n\n    task_batches = archetype.get(\"task_batches_required\")\n    if task_batches:\n        lines.append(\"task_batches.yaml is REQUIRED for this archetype (parallel worker dispatch).\")\n        lines.append(\"\")\n\n    return \"\\n\".join(lines)\n\n\ndef _inject_section(agent: Any, header: str, body: str) -> None:\n    \"\"\"Append or replace a named section in the agent system message.\"\"\"\n    try:\n        current: str = (\n            getattr(agent, \"system_message\", None)\n            or getattr(agent, \"_system_message\", \"\")\n            or \"\"\n        )\n        section = f\"{header}\\n{body}\"\n        if header in current:\n            pre, _, rest = current.partition(header)\n            next_idx = rest.find(\"\\n\\n[\")\n            after = rest[next_idx:] if next_idx > 0 else \"\"\n            new_message = f\"{pre.rstrip()}\\n\\n{section}{after}\"\n        else:\n            new_message = f\"{current}\\n\\n{section}\" if current else section\n\n        if new_message == current:\n            return\n\n        updater = getattr(agent, \"update_system_message\", None)\n        if callable(updater):\n            updater(new_message)\n        elif hasattr(agent, \"_system_message\"):\n            agent._system_message = new_message\n        else:\n            agent._system_message = new_message\n    except Exception as exc:\n        logger.error(\n            \"[WorkflowBundleBuilderAgent] Failed to inject archetype section: %s\", exc\n        )\n\n\ndef inject_workflow_archetypes_context(\n    agent: Any,\n    messages: list[dict[str, Any]],\n) -> None:\n    \"\"\"\n    prompt middleware function for WorkflowBundleBuilderAgent.\n\n    Injects [WORKFLOW ARCHETYPE: <name>] from workflow_archetypes.yaml when the\n    current task is an AI-native pack workflow (capability_id ending in\n    -review-workflow, -analysis-workflow, or -extraction-workflow).\n\n    No-ops for all other workflows and all other agents.\n    \"\"\"\n    if getattr(agent, \"name\", \"\") != \"WorkflowBundleBuilderAgent\":\n        return\n\n    context_variables = getattr(agent, \"context_variables\", None)\n    archetype_name = _detect_archetype_name(context_variables)\n    if not archetype_name:\n        return\n\n    archetypes = _load_archetypes()\n    archetype = archetypes.get(archetype_name)\n    if not isinstance(archetype, dict):\n        logger.warning(\n            \"[WorkflowBundleBuilderAgent] Archetype %r not found in workflow_archetypes.yaml\",\n            archetype_name,\n        )\n        return\n\n    header = f\"{_HEADER_PREFIX}: {archetype_name}\"\n    body = _render_archetype_section(archetype_name, archetype)\n    _inject_section(agent, header, body)\n\n    logger.info(\n        \"[WorkflowBundleBuilderAgent] Injected workflow archetype %r from archetype library\",\n        archetype_name,\n    )\n\n\n__all__ = [\"inject_workflow_archetypes_context\"]\n\n\n"},{"checksum":"sha256:65b9f0972e4a7e974e9349d43cc0fba5713a9e51daf53282ce06f5b31b8e027c","chunk_id":"chunk_c9be38b40d454073","end_line":33,"path":"workflows/AgentGenerator/tools/hook_workflow_bundle_repair.py","start_line":1,"symbol_ids":["sym_e25de01f7336bfb4"],"text":"\"\"\"Prompt hook for AgentGenerator workflow-bundle repair merges.\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import Any\n\nfrom factory_app.workflows._shared.hook_utils import update_agent_section\nfrom factory_app.workflows.AgentGenerator.tools.workflow_quality_gate import (\n    merge_workflow_bundle_repair_results,\n)\n\n_HEADER = \"[WORKFLOW BUNDLE REPAIR]\"\n\n\ndef merge_repaired_workflow_bundle_results(agent: Any, messages: list[dict[str, Any]]) -> None:\n    \"\"\"Merge repaired workflow task outputs before PackMetadataAgent reads context.\"\"\"\n\n    if getattr(agent, \"name\", \"\") != \"PackMetadataAgent\":\n        return\n    context_variables = getattr(agent, \"context_variables\", None)\n    result = merge_workflow_bundle_repair_results(context_variables)\n    if result.get(\"status\") != \"merged\":\n        return\n    body = (\n        \"Workflow bundle repair outputs were merged into the full bundle result set.\\n\"\n        f\"- repaired_workflows: {result.get('repaired_workflows') or []}\\n\"\n        f\"- merged_workflow_count: {result.get('merged_workflow_count')}\\n\"\n        \"Use workflow_bundle_results from context as the authoritative merged pack.\"\n    )\n    update_agent_section(agent, _HEADER, body)\n\n\n__all__ = [\"merge_repaired_workflow_bundle_results\"]"},{"checksum":"sha256:a0e53d8ff6ad870401e72fa5551d18dbca507df0d110f95fe360131fa8d0c0cf","chunk_id":"chunk_a15d52f9576ca3b9","end_line":89,"path":"workflows/AgentGenerator/tools/mermaid_sequence_diagram.py","start_line":1,"symbol_ids":["sym_14ed9c170df383f8","sym_c6e57fbc6c95cabd","sym_dc2740797943c175"],"text":"\"\"\"Review an exact workflow partition through the runtime's correlated UI tool.\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport json\nfrom typing import Any, Literal\nfrom uuid import uuid4\n\nfrom pydantic import BaseModel, Field, StrictBool, StrictStr\n\nfrom mozaiksai.core.workflow.context.frozen import detach\nfrom mozaiksai.core.workflow.outputs.structured import load_workflow_structured_outputs\nfrom mozaiksai.core.workflow.ui_tools import use_ui_tool\n\nfrom .pattern_selection import validate_selection\n\n\nclass WorkflowPlanReviewResponse(BaseModel):\n    action: Literal[\"approve\", \"request_changes\", \"cancel\"]\n    approved: StrictBool\n    review_id: StrictStr\n    rationale: StrictStr = Field(default=\"\", max_length=4000)\n\n\ndef _fingerprint(selection: dict[str, Any]) -> str:\n    return hashlib.sha256(json.dumps(selection, sort_keys=True).encode()).hexdigest()\n\n\nasync def mermaid_sequence_diagram(\n    *,\n    MermaidSequenceDiagram: dict[str, Any] | None = None,\n    context_variables: Any | None = None,\n) -> dict[str, Any]:\n    if context_variables is None:\n        raise ValueError(\"Workflow plan review requires runtime context\")\n    selection = validate_selection(context_variables.get(\"PatternSelection\"), context_variables)\n    models, _ = load_workflow_structured_outputs(\"AgentGenerator\")\n    raw = MermaidSequenceDiagram\n    if raw is None:\n        output = detach(context_variables.get(\"structured_output\"))\n        raw = output.get(\"MermaidSequenceDiagram\") if isinstance(output, dict) else None\n    diagram = models[\"MermaidSequenceDiagram\"].model_validate(detach(raw)).model_dump(mode=\"json\")\n    review_id = f\"workflow_review_{uuid4().hex}\"\n    fingerprint = _fingerprint(selection)\n    review = {\"review_id\": review_id, \"selection_hash\": fingerprint, \"status\": \"pending\"}\n    context_variables.set(\"workflow_plan_review\", review)\n    context_variables.set(\"workflow_review_feedback\", \"\")\n    workflows = selection[\"workflows\"]\n    response = WorkflowPlanReviewResponse.model_validate(await use_ui_tool(\n        tool_id=\"WorkflowPlanReview\",\n        payload={\n            **diagram,\n            \"review_id\": review_id,\n            \"title\": selection[\"pack_name\"],\n            \"summary\": selection[\"pack_partition_reason\"] or \"Review the workflows to generate.\",\n            \"workflow_count\": len(workflows),\n            \"checkpoints\": [f\"{item['name']}: {item['description']}\" for item in workflows]\n            or [\"No AI workflows. App modules and pages provide the requested functionality.\"],\n        },\n        chat_id=context_variables.get(\"chat_id\"),\n        workflow_name=context_variables.get(\"workflow_name\") or \"AgentGenerator\",\n    ))\n    current = validate_selection(context_variables.get(\"PatternSelection\"), context_variables)\n    current_review = detach(context_variables.get(\"workflow_plan_review\"))\n    if current_review != review or response.review_id != review_id or _fingerprint(current) != fingerprint:\n        raise ValueError(\"Workflow approval does not match the current draft\")\n    if response.approved is not (response.action == \"approve\"):\n        raise ValueError(\"Workflow review action and approval disagree\")\n    outcome = {\"approve\": \"approved\", \"request_changes\": \"changes_requested\", \"cancel\": \"cancelled\"}[response.action]\n    context_variables.set(\"workflow_review_feedback\", response.rationale)\n    context_variables.set(\"workflow_plan_review\", {**review, \"status\": outcome, \"rationale\": response.rationale})\n    if outcome == \"approved\" and not workflows:\n        from factory_app.workflows._shared.platform.build_target import require_build_binding\n\n        from .generate_and_download import _record_context_and_artifacts\n\n        binding = require_build_binding(context_variables)\n        await _record_context_and_artifacts(\n            app_id=binding.target_app_id,\n            user_id=context_variables.get(\"user_id\"),\n            chat_id=context_variables.get(\"chat_id\"),\n            pack_name=selection[\"pack_name\"],\n            bundle_entries=[],\n            zip_path=None,\n            context_variables=context_variables,\n        )\n        outcome = \"no_workflows\"\n    return {\"outcome\": outcome, \"review_id\": review_id, \"workflow_count\": len(workflows)}"},{"checksum":"sha256:2a9b186b67a09b175c08e50df7842387d5d9198cbfb80f87fc55a4c54bc879b1","chunk_id":"chunk_0f258b5bcac07132","end_line":125,"path":"workflows/AgentGenerator/tools/outcome_materialization.py","start_line":1,"symbol_ids":["sym_08a55653196dacbd","sym_d9444cb881b8d8fb","sym_bf0ba994fc2d2185","sym_491d014318b023d2"],"text":"\"\"\"Materialize typed operation plans into the existing workflow YAML contracts.\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import Any, Literal\n\nimport yaml\nfrom pydantic import BaseModel, ConfigDict, Field\n\nfrom mozaiksai.core.workflow.contract_validation import validate_workflow_tool_outcomes\nfrom mozaiksai.core.workflow.declarative.contracts import (\n    ToolOutcomeSpec,\n    parse_context_variables_config,\n    parse_tools_config,\n    parse_transition_graph_config,\n)\n\n\nclass OutcomeRoute(BaseModel):\n    model_config = ConfigDict(extra=\"forbid\")\n\n    value: str\n    target_agent: str\n    termination_reason: Literal[\"workflow_complete\", \"workflow_failed\"] | None = None\n\n\nclass WorkflowOutcomePlan(BaseModel):\n    model_config = ConfigDict(extra=\"forbid\")\n\n    agent: str\n    function: str\n    context_key: str\n    attempts_key: str\n    result_field: str = \"status\"\n    error_value: str\n    max_attempts: int = Field(default=1, strict=True, ge=1, le=100)\n    retry_on: list[str] = Field(default_factory=list)\n    routes: list[OutcomeRoute] = Field(min_length=1)\n\n    def tool_outcome(self) -> ToolOutcomeSpec:\n        return ToolOutcomeSpec.model_validate({\n            **self.model_dump(exclude={\"agent\", \"function\", \"routes\"}),\n            \"values\": [route.value for route in self.routes],\n        })\n\n\ndef materialize_workflow_outcomes(entry: dict[str, Any]) -> dict[str, Any]:\n    raw_plans = entry.get(\"outcome_plans\", [])\n    if not isinstance(raw_plans, list):\n        raise ValueError(\"outcome_plans must be a list\")\n    if not raw_plans:\n        return entry\n    plans = [WorkflowOutcomePlan.model_validate(plan) for plan in raw_plans]\n    if len({plan.agent for plan in plans}) != len(plans):\n        raise ValueError(\"outcome_plans must have one operation per agent\")\n    files = {file[\"filename\"]: file for file in entry[\"files\"]}\n    if len(files) != len(entry[\"files\"]):\n        raise ValueError(\"workflow files contain duplicate filenames\")\n    payloads: dict[str, dict] = {}\n    for filename in (\"tools.yaml\", \"context_variables.yaml\", \"transition_graph.yaml\", \"structured_outputs.yaml\"):\n        if filename not in files:\n            raise ValueError(f\"outcome materialization requires {filename}\")\n        payload = yaml.safe_load(files[filename][\"content\"])\n        if not isinstance(payload, dict):\n            raise ValueError(f\"{filename} must contain a mapping\")\n        payloads[filename.removesuffix(\".yaml\")] = payload\n    tools = payloads[\"tools\"].get(\"tools\", [])\n    definitions = payloads[\"context_variables\"].setdefault(\"definitions\", {})\n    rules = payloads[\"transition_graph\"].setdefault(\"transition_rules\", [])\n    owned_keys: set[str] = set()\n    for plan in plans:\n        outcome = plan.tool_outcome()\n        matches = [tool for tool in tools if tool.get(\"agent\") == plan.agent and tool.get(\"function\") == plan.function]\n        if len(matches) != 1:\n            raise ValueError(f\"outcome plan must resolve one tool: {plan.agent}.{plan.function}\")\n        matches[0].update(auto_tool_call=True, bind_to_agent=False, outcome=outcome.model_dump())\n        for key, kind, default, authority in (\n            (plan.context_key, \"string\", plan.error_value, \"closed_writer_routing_state\"),\n            (plan.attempts_key, \"integer\", 0, \"closed_writer_quality_state\"),\n        ):\n            if key in owned_keys:\n                raise ValueError(f\"duplicate operation state key: {key}\")\n            owned_keys.add(key)\n            definition = {\n                \"type\": kind,\n                \"authority_class\": authority,\n                \"writer_ids\": [\"deterministic_tool\"],\n                \"persisted\": True,\n                \"source\": {\"type\": \"state\", \"default\": default},\n            }\n            if key in definitions and definitions[key] != definition:\n                raise ValueError(f\"outcome plan conflicts with an existing context definition: {key}\")\n            definitions[key] = definition\n        planned_rules = [{\n            \"source_agent\": plan.agent,\n            \"target_agent\": route.target_agent,\n            \"transition_type\": \"condition\",\n            \"condition_type\": \"context_equals\",\n            \"condition_key\": plan.context_key,\n            \"condition_value\": route.value,\n            **({\"termination_reason\": route.termination_reason} if route.termination_reason else {}),\n        } for route in plan.routes]\n        error_route = next(route for route in plan.routes if route.value == plan.error_value)\n        planned_rules.append({\n            \"source_agent\": plan.agent, \"target_agent\": error_route.target_agent, \"transition_type\": \"after_turn\",\n            **({\"termination_reason\": error_route.termination_reason} if error_route.termination_reason else {}),\n        })\n        existing_rules = [rule for rule in rules if rule.get(\"source_agent\") == plan.agent]\n        if existing_rules and existing_rules != planned_rules:\n            raise ValueError(f\"outcome plan conflicts with existing transitions: {plan.agent}\")\n        rules[:] = [rule for rule in rules if rule.get(\"source_agent\") != plan.agent]\n        rules.extend(planned_rules)\n\n    parse_tools_config(payloads[\"tools\"])\n    parse_context_variables_config(payloads[\"context_variables\"])\n    parse_transition_graph_config(payloads[\"transition_graph\"])\n    validate_workflow_tool_outcomes({**payloads, \"tools\": tools})\n    rewritten = {\n        f\"{name}.yaml\": yaml.safe_dump(payload, sort_keys=False, allow_unicode=True)\n        for name, payload in payloads.items() if name != \"structured_outputs\"\n    }\n    return {\n        **entry,\n        \"files\": [{**file, \"content\": rewritten.get(file[\"filename\"], file[\"content\"])} for file in entry[\"files\"]],\n    }"},{"checksum":"sha256:e38dd22b2d605581ac95ffb64e2e37d4061f441d58ddfb933850395dabbcfdbe","chunk_id":"chunk_cd61d53860f64023","end_line":63,"path":"workflows/AgentGenerator/tools/pattern_selection.py","start_line":1,"symbol_ids":["sym_7cd2d74d01c2e773","sym_46154455c8350ada"],"text":"\"\"\"Validate the workflow partition before dispatch or human review.\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import Annotated, Any\n\nfrom mozaiksai.core.workflow.context.frozen import detach\nfrom mozaiksai.core.workflow.outputs.structured import load_workflow_structured_outputs\n\n\ndef validate_selection(raw_selection: Any, context_variables: Any) -> dict[str, Any]:\n    models, _ = load_workflow_structured_outputs(\"AgentGenerator\")\n    selection = models[\"PatternSelection\"].model_validate(detach(raw_selection)).model_dump(mode=\"json\")\n    workflows = selection[\"workflows\"]\n    if selection[\"is_multi_workflow\"] != (len(workflows) > 1):\n        raise ValueError(\"is_multi_workflow must match the workflow count\")\n    if not workflows and not (selection[\"pack_partition_reason\"] or \"\").strip():\n        raise ValueError(\"An empty workflow partition requires a rationale\")\n    names = [item[\"name\"] for item in workflows]\n    if len(set(names)) != len(names):\n        raise ValueError(\"Workflow names must be unique\")\n    for item in workflows:\n        if item[\"initial_agent\"] != \"WorkflowBundleBuilderAgent\" or item[\"pattern_id\"] not in range(1, 10):\n            raise ValueError(\"Workflow dispatch must use the supported builder and pattern\")\n        if set(item.get(\"depends_on\") or []) - (set(names) - {item[\"name\"]}):\n            raise ValueError(\"Workflow dependencies must reference other declared workflows\")\n    surface_map = detach(context_variables.get(\"design_surface_map\"))\n    if surface_map is not None:\n        design_models, _ = load_workflow_structured_outputs(\"DesignDocs\")\n        surfaces = design_models[\"DesignSurfaceMap\"].model_validate(surface_map).model_dump(mode=\"json\")[\"surfaces\"]\n        has_workflows = any(item.get(\"surface_kind\") == \"workflow\" for item in surfaces)\n        if bool(workflows) != has_workflows:\n            expected = \"at least one declared AI workflow\" if has_workflows else \"workflows: [] (no AI workflows)\"\n            raise ValueError(f\"The canonical design surface map requires {expected}\")\n    return selection\n\n\ndef pattern_selection(\n    *,\n    PatternSelection: Annotated[dict[str, Any] | None, \"Pattern selection payload\"] = None,\n    context_variables: Annotated[Any | None, \"Runtime context\"] = None,\n) -> dict[str, Any]:\n    if context_variables is None:\n        raise ValueError(\"Pattern selection requires runtime context\")\n    raw = PatternSelection\n    if raw is None:\n        output = detach(context_variables.get(\"structured_output\"))\n        raw = output.get(\"PatternSelection\") if isinstance(output, dict) else None\n    try:\n        selection = validate_selection(raw, context_variables)\n    except ValueError as error:\n        context_variables.set(\"pattern_selection_feedback\", str(error))\n        context_variables.set(\"PatternSelection\", None)\n        context_variables.set(\"workflow_plan_review\", None)\n        return {\"outcome\": \"invalid\", \"error\": str(error)}\n    context_variables.set(\"pattern_selection_feedback\", \"\")\n    context_variables.set(\"PatternSelection\", selection)\n    for key in (\"is_multi_workflow\", \"pack_name\", \"pack_partition_reason\"):\n        context_variables.set(key, selection[key])\n    context_variables.set(\"workflows_spec\", selection[\"workflows\"])\n    context_variables.set(\"workflow_plan_review\", None)\n    return {\"outcome\": \"selected\", \"workflow_count\": len(selection[\"workflows\"])}\n"},{"checksum":"sha256:8e8a35ffdba12e0931679a88f009312b5ab92b938ec172b8bf690c336503d441","chunk_id":"chunk_d15d4db90aeb8757","end_line":9,"path":"workflows/AgentGenerator/tools/platform/build_lifecycle.py","start_line":1,"symbol_ids":[],"text":"\"\"\"AgentGenerator lifecycle hooks; the download tool owns bundle persistence.\"\"\"\n\nfrom factory_app.workflows._shared.platform.build_lifecycle import (\n    emit_build_completed,\n    emit_build_failed,\n    emit_build_started,\n)\n\n__all__ = [\"emit_build_started\", \"emit_build_completed\", \"emit_build_failed\"]"},{"checksum":"sha256:653d0c6c55b7cfe7530ff00148371e1e677e144d259401f1e9c9ce4f5fa65976","chunk_id":"chunk_1b9d991b54da2cce","end_line":53,"path":"workflows/AgentGenerator/tools/record_workflow_interview.py","start_line":1,"symbol_ids":["sym_ccff8d20b7545437","sym_c4ea7031ebfe38f0"],"text":"\"\"\"Write interview readiness from validated structured output, not from chat text.\n\nReadiness used to be inferred by matching the literal token ``NEXT`` against the\nagent's message. That required the model to emit a bare token with no preamble,\nwhich it does not reliably do: a live run produced two paragraphs of correct\nreasoning followed by ``NEXT``, the exact match failed, and the workflow waited\non a user forever. See issue #591.\n\nThe agent now states readiness in a typed field. This tool validates that output\nand writes the routing key, so the write is deterministic machinery rather than\nfreeform prose \u2014 the same authority boundary the exact-match sentinel protected.\n\"\"\"\n\nfrom typing import Any\n\nfrom mozaiksai.core.workflow.context.frozen import detach\nfrom mozaiksai.core.workflow.outputs.structured import load_workflow_structured_outputs\n\n\ndef _context_set(context_variables: Any | None, key: str, value: Any) -> None:\n    if context_variables is None:\n        return\n    if hasattr(context_variables, \"set\"):\n        try:\n            context_variables.set(key, value)\n            return\n        except Exception:\n            pass\n    data = getattr(context_variables, \"data\", None)\n    if isinstance(data, dict):\n        data[key] = value\n        return\n    if isinstance(context_variables, dict):\n        context_variables[key] = value\n\n\nasync def record_workflow_interview(context_variables: Any = None) -> dict[str, str]:\n    if context_variables is None:\n        raise ValueError(\"Workflow interview requires runtime context\")\n\n    models, _ = load_workflow_structured_outputs(\"AgentGenerator\")\n    result = (\n        models[\"WorkflowInterviewResult\"]\n        .model_validate(detach(context_variables.get(\"structured_output\")))\n        .model_dump(mode=\"json\")\n    )\n\n    if not str(result.get(\"agent_message\") or \"\").strip():\n        raise ValueError(\"Workflow interview requires a user-facing message\")\n\n    outcome = str(result[\"outcome\"])\n    _context_set(context_variables, \"interview_outcome\", outcome)\n    return {\"outcome\": outcome}"},{"checksum":"sha256:54c382f209c8ab3cfd0517d834abec67113bdd31d5216a965196f59672e00673","chunk_id":"chunk_26eb9364ef58768b","end_line":276,"path":"workflows/AgentGenerator/tools/workflow_converter.py","start_line":1,"symbol_ids":["sym_9b5e8ee08a235deb","sym_85cc0eb515b19619","sym_48cc9c3b431eea9d","sym_cbef4f07c18ccab2","sym_ef4c626a70a2a859","sym_c10df3b4891b42ae","sym_51239db91e592eab","sym_5cbff4cf51c164f4","sym_06d27488b54d7189","sym_3e75882592445935","sym_65e67f0b86415bf6","sym_308263d47ace0af0","sym_13214d0338633a20"],"text":"# ==============================================================================\n# FILE: workflows/AgentGenerator/tools/workflow_converter.py\n# DESCRIPTION: Workflow promotion helper and normalization contract utilities\n#              for the AgentGenerator workflow.\n# ==============================================================================\n\nimport os\nimport re\nimport shutil\nfrom pathlib import Path, PurePosixPath\nfrom typing import Any\n\nfrom factory_app.workflows._shared.platform.build_target import require_build_binding\nfrom mozaiksai.core.workflow.workflow_ui_catalog import (\n    get_workflow_shipped_component_map,\n    infer_workflow_ui_realization,\n)\n\nRUNTIME_EXTENSION_KINDS = {\"api_router\", \"startup_service\"}\nORCHESTRATOR_TRIGGER_TYPES = {\"chat\", \"event\", \"route\", \"action\", \"schedule\"}\nTRANSITION_CONDITION_TYPES = {\"context_equals\", \"context_expression\", \"tool_called\"}\n\n\ndef _repo_root() -> Path:\n    here = Path(__file__).resolve()\n    for parent in [here] + list(here.parents):\n        if (parent / \"mozaiksai\").is_dir():\n            return parent\n    return here.parents[-1]\n\n\ndef _resolve_generated_artifacts_root() -> Path:\n    raw = os.getenv(\"MOZAIKS_GENERATED_ARTIFACTS_PATH\", \"generated\").strip()\n    candidate = Path(raw)\n    if not candidate.is_absolute():\n        candidate = _repo_root() / candidate\n    return candidate.resolve()\n\n\ndef _context_get(context_variables: Any | None, key: str) -> Any | None:\n    if context_variables is None:\n        return None\n    if hasattr(context_variables, \"get\"):\n        try:\n            value = context_variables.get(key)\n            if value is not None:\n                return value\n        except Exception:\n            pass\n    data = getattr(context_variables, \"data\", None)\n    if isinstance(data, dict):\n        return data.get(key)\n    if isinstance(context_variables, dict):\n        return context_variables.get(key)\n    return None\n\n\ndef _safe_path_segment(value: Any, *, fallback: str) -> str:\n    text = str(value or \"\").strip()\n    if not text:\n        text = fallback\n    text = re.sub(r\"[^A-Za-z0-9_.-]+\", \"-\", text).strip(\".-\")\n    return text or fallback\n\n\ndef _resolve_artifact_ids(\n    *,\n    data: dict[str, Any] | None = None,\n    context_variables: Any | None = None,\n) -> tuple[str, str]:\n    binding = require_build_binding(context_variables)\n    return binding.target_app_id, binding.build_id\n\n\ndef _resolve_workflow_output_dir(\n    workflow_name: str,\n    *,\n    data: dict[str, Any] | None = None,\n    context_variables: Any | None = None,\n) -> Path:\n    app_id, build_id = _resolve_artifact_ids(data=data, context_variables=context_variables)\n    workflow = _safe_path_segment(workflow_name, fallback=\"GeneratedWorkflow\")\n    return _resolve_generated_artifacts_root() / \"workflows\" / app_id / build_id / workflow\n\n\ndef _normalize_workflow_extra_path(raw_path: Any) -> str | None:\n    \"\"\"Return a safe workflow-local relative path, or None if it escapes scope.\"\"\"\n\n    rel_path = str(raw_path or \"\").replace(\"\\\\\", \"/\").strip().lstrip(\"/\")\n    if not rel_path or \"\\x00\" in rel_path:\n        return None\n\n    parsed = PurePosixPath(rel_path)\n    parts = parsed.parts\n    if parsed.is_absolute() or not parts:\n        return None\n    if any(part in {\"\", \".\", \"..\", \"_shared\"} for part in parts):\n        return None\n\n    return \"/\".join(parts)\n\n\ndef _normalize_runtime_extensions(\n    extensions: Any,\n    *,\n    workflow_name: str,\n    wf_logger: Any,\n) -> list[dict[str, Any]]:\n    \"\"\"Keep runtime extension entrypoints inside the generated workflow package.\"\"\"\n\n    if not isinstance(extensions, list):\n        return []\n\n    workflow_prefix = f\"workflows.{workflow_name}.tools.\"\n    normalized: list[dict[str, Any]] = []\n    for ext in extensions:\n        if not isinstance(ext, dict):\n            continue\n\n        kind = str(ext.get(\"kind\") or \"\").strip()\n        if kind not in RUNTIME_EXTENSION_KINDS:\n            wf_logger.warning(\"\u26a0\ufe0f [CREATE_WORKFLOW_FILES] Skipping unknown runtime extension kind: %s\", kind)\n            continue\n\n        entrypoint = ext.get(\"entrypoint\")\n        if not isinstance(entrypoint, str) or not entrypoint.strip():\n            wf_logger.warning(\"\u26a0\ufe0f [CREATE_WORKFLOW_FILES] Skipping runtime extension without entrypoint: %s\", kind)\n            continue\n\n        entrypoint = entrypoint.strip()\n        if \"_shared\" in entrypoint or not entrypoint.startswith(workflow_prefix):\n            wf_logger.warning(\n                \"\u26a0\ufe0f [CREATE_WORKFLOW_FILES] Skipping non-local runtime extension entrypoint: %s\",\n                entrypoint,\n            )\n            continue\n\n        normalized_ext = dict(ext)\n        normalized_ext[\"kind\"] = kind\n        normalized_ext[\"entrypoint\"] = entrypoint\n        normalized.append(normalized_ext)\n\n    return normalized\n\n\ndef _normalize_orchestrator_triggers(\n    triggers: Any,\n    *,\n    wf_logger: Any,\n) -> list[dict[str, Any]]:\n    \"\"\"Keep orchestrator triggers within the runtime's declared trigger schema.\"\"\"\n\n    if not isinstance(triggers, list):\n        return []\n\n    normalized: list[dict[str, Any]] = []\n    for trigger in triggers:\n        if not isinstance(trigger, dict):\n            continue\n\n        item: dict[str, Any] = {}\n        trigger_type = str(trigger.get(\"type\") or \"\").strip().lower()\n        if trigger_type:\n            if trigger_type not in ORCHESTRATOR_TRIGGER_TYPES:\n                wf_logger.warning(\n                    \"\u26a0\ufe0f [CREATE_WORKFLOW_FILES] Skipping unknown orchestrator trigger type: %s\",\n                    trigger_type,\n                )\n                continue\n            item[\"type\"] = trigger_type\n\n        for key in (\"event\", \"endpoint\", \"method\", \"description\", \"capability_id\"):\n            value = trigger.get(key)\n            if isinstance(value, str):\n                value = value.strip()\n                if value:\n                    item[key] = value\n\n        if not (item.get(\"type\") or item.get(\"event\") or item.get(\"endpoint\")):\n            continue\n\n        normalized.append(item)\n\n    return normalized\n\n\ndef promote_generated_workflow(source_dir: str | Path, target_root: str | Path) -> dict[str, Any]:\n    \"\"\"Explicitly promote a generated workflow into the active workflows root.\"\"\"\n    source = Path(source_dir).resolve()\n    target_root_path = Path(target_root).resolve()\n\n    if not source.is_dir():\n        raise ValueError(f\"Generated workflow source_dir does not exist: {source}\")\n    if source == target_root_path or source in target_root_path.parents:\n        raise ValueError(\"target_root must not be the generated source_dir or inside it\")\n\n    workflow_name = _safe_path_segment(source.name, fallback=\"GeneratedWorkflow\")\n    target = target_root_path / workflow_name\n    target_root_path.mkdir(parents=True, exist_ok=True)\n\n    shutil.copytree(\n        source,\n        target,\n        dirs_exist_ok=True,\n        ignore=shutil.ignore_patterns(\"__pycache__\", \"*.pyc\"),\n    )\n\n    return {\n        \"status\": \"success\",\n        \"source_dir\": str(source),\n        \"target_root\": str(target_root_path),\n        \"target_dir\": str(target),\n    }\n\n\n# -----------------------------\n# Normalization contract helpers\n# -----------------------------\n\n\ndef _normalize_nullable_text(value: Any) -> str | None:\n    if value is None:\n        return None\n    if not isinstance(value, str):\n        return None\n    cleaned = value.strip()\n    if not cleaned:\n        return None\n    if cleaned.lower() in {\"null\", \"none\", \"undefined\"}:\n        return None\n    return cleaned\n\n\ndef _normalize_visual_agents(value: Any, *, workflow_startup_mode: str | None) -> list[str] | None:\n    mode = str(workflow_startup_mode or \"\").strip().lower()\n    backend_only = mode == \"backendonly\"\n\n    if value is None:\n        return None if backend_only else []\n\n    normalized: list[str] = []\n    if isinstance(value, str):\n        cleaned = value.strip()\n        if not cleaned or cleaned.lower() in {\"null\", \"none\", \"[]\"}:\n            return None if backend_only else []\n        candidates = [segment.strip() for segment in cleaned.split(\",\")] if \",\" in cleaned else [cleaned]\n        normalized = [item for item in candidates if item]\n    elif isinstance(value, list):\n        for item in value:\n            if not isinstance(item, str):\n                continue\n            cleaned = item.strip()\n            if not cleaned or cleaned.lower() in {\"null\", \"none\"}:\n                continue\n            normalized.append(cleaned)\n    else:\n        return None if backend_only else []\n\n    deduped: list[str] = []\n    seen = set()\n    for agent_name in normalized:\n        if agent_name not in seen:\n            deduped.append(agent_name)\n            seen.add(agent_name)\n\n    if deduped:\n        return deduped\n    return None if backend_only else []\n\n\ndef _normalize_transition_rules(raw_rules: Any) -> list[dict[str, Any]]:\n    if not isinstance(raw_rules, list):\n        return []\n\n    normalized: list[dict[str, Any]] = []\n    for rule in raw_rules:"},{"checksum":"sha256:814c69d4d6b7fd8ef28efa63730f4e0c1092caab3c9b49037f1d971978c5aaaa","chunk_id":"chunk_a0648f5939df25e4","end_line":467,"path":"workflows/AgentGenerator/tools/workflow_converter.py","start_line":277,"symbol_ids":["sym_13214d0338633a20","sym_534fe57ffcd5234d","sym_2e1f4ee369fa776b","sym_9effb3fb4678f9d8","sym_2f34b2773bd89bd9"],"text":"        if not isinstance(rule, dict):\n            continue\n        item = dict(rule)\n        stale_condition = _normalize_nullable_text(item.pop(\"condition\", None))\n        condition_type = _normalize_nullable_text(item.get(\"condition_type\"))\n        if condition_type is not None:\n            condition_type = condition_type.lower()\n        condition_key = _normalize_nullable_text(item.get(\"condition_key\"))\n        context_expression = _normalize_nullable_text(item.get(\"context_expression\"))\n        tool_name = _normalize_nullable_text(item.get(\"tool_name\"))\n        has_condition_value = \"condition_value\" in item\n        condition_value = item.get(\"condition_value\")\n\n        if condition_type in {\"llm\", \"string_llm\"}:\n            raise ValueError(\n                \"transition_graph.yaml does not support LLM-evaluated condition_type values. \"\n                \"Use AG2-native context_equals/context_expression/tool_called routing and \"\n                \"set routing context through a tool, structured output, or the control plane.\"\n            )\n        if condition_type == \"expression\" or stale_condition is not None:\n            raise ValueError(\n                \"transition_graph.yaml no longer supports expression condition strings. \"\n                \"Use condition_type=context_equals with condition_key/condition_value, \"\n                \"condition_type=context_expression with context_expression, or \"\n                \"condition_type=tool_called with tool_name.\"\n            )\n\n        transition_type = str(item.get(\"transition_type\") or \"\").strip().lower()\n        if not transition_type and condition_type:\n            item[\"transition_type\"] = \"condition\"\n        elif not transition_type:\n            item[\"transition_type\"] = \"after_turn\"\n        elif transition_type not in {\"condition\", \"after_turn\"}:\n            raise ValueError(f\"Unsupported transition_type in transition_graph.yaml: {transition_type}\")\n        else:\n            item[\"transition_type\"] = transition_type\n\n        if item[\"transition_type\"] == \"after_turn\":\n            if (\n                condition_type\n                or condition_key\n                or context_expression\n                or tool_name\n                or (has_condition_value and condition_value is not None)\n            ):\n                raise ValueError(\"after_turn transition rules must not declare condition fields\")\n            for key in (\"condition_type\", \"condition_key\", \"condition_value\", \"context_expression\", \"tool_name\"):\n                item.pop(key, None)\n        else:\n            if condition_type not in TRANSITION_CONDITION_TYPES:\n                raise ValueError(\n                    \"condition transition rules require condition_type=context_equals, \"\n                    \"context_expression, or tool_called\"\n                )\n            item[\"condition_type\"] = condition_type\n            if condition_type == \"context_equals\":\n                if condition_key is None:\n                    raise ValueError(\"context_equals transition rules require condition_key\")\n                if tool_name is not None:\n                    raise ValueError(\"context_equals transition rules must not declare tool_name\")\n                if context_expression is not None:\n                    raise ValueError(\"context_equals transition rules must not declare context_expression\")\n                item[\"condition_key\"] = condition_key\n                if not has_condition_value:\n                    item[\"condition_value\"] = None\n                item.pop(\"context_expression\", None)\n                item.pop(\"tool_name\", None)\n            elif condition_type == \"context_expression\":\n                if context_expression is None:\n                    raise ValueError(\"context_expression transition rules require context_expression\")\n                if condition_key is not None or (has_condition_value and condition_value is not None) or tool_name is not None:\n                    raise ValueError(\n                        \"context_expression transition rules must not declare \"\n                        \"condition_key, condition_value, or tool_name\"\n                    )\n                item[\"context_expression\"] = context_expression\n                for key in (\"condition_key\", \"condition_value\", \"tool_name\"):\n                    item.pop(key, None)\n            else:\n                if tool_name is None:\n                    raise ValueError(\"tool_called transition rules require tool_name\")\n                if (\n                    condition_key is not None\n                    or context_expression is not None\n                    or (has_condition_value and condition_value is not None)\n                ):\n                    raise ValueError(\"tool_called transition rules must not declare context condition fields\")\n                item[\"tool_name\"] = tool_name\n                for key in (\"condition_key\", \"condition_value\", \"context_expression\"):\n                    item.pop(key, None)\n\n        normalized.append(item)\n    return normalized\n\n\ndef _default_ui_payload_schema() -> dict[str, Any]:\n    return {\"type\": \"object\", \"properties\": {}, \"additionalProperties\": True}\n\n\ndef _normalize_ui_contract(raw_contract: Any) -> dict[str, Any]:\n    contract = raw_contract if isinstance(raw_contract, dict) else {}\n\n    surface_kind = str(contract.get(\"surface_kind\") or \"agent_tool\").strip().lower()\n    if surface_kind != \"agent_tool\":\n        surface_kind = \"agent_tool\"\n\n    payload_schema = contract.get(\"payload_schema\")\n    if not isinstance(payload_schema, dict) or not payload_schema:\n        payload_schema = _default_ui_payload_schema()\n\n    actions_schema: list[dict[str, Any]] = []\n    raw_actions = contract.get(\"actions_schema\")\n    if isinstance(raw_actions, list):\n        for action in raw_actions:\n            if not isinstance(action, dict):\n                continue\n            action_id = _normalize_nullable_text(action.get(\"id\"))\n            if action_id is None:\n                continue\n            normalized_action: dict[str, Any] = {\"id\": action_id}\n            label = _normalize_nullable_text(action.get(\"label\"))\n            if label is not None:\n                normalized_action[\"label\"] = label\n            description = _normalize_nullable_text(action.get(\"description\"))\n            if description is not None:\n                normalized_action[\"description\"] = description\n            variant = _normalize_nullable_text(action.get(\"variant\"))\n            if variant is not None:\n                normalized_action[\"variant\"] = variant\n            if isinstance(action.get(\"approved\"), bool):\n                normalized_action[\"approved\"] = action[\"approved\"]\n            action_payload_schema = action.get(\"payload_schema\")\n            if not isinstance(action_payload_schema, dict) or not action_payload_schema:\n                action_payload_schema = _default_ui_payload_schema()\n            normalized_action[\"payload_schema\"] = action_payload_schema\n            actions_schema.append(normalized_action)\n\n    return {\n        \"surface_kind\": surface_kind,\n        \"payload_schema\": payload_schema,\n        \"actions_schema\": actions_schema,\n    }\n\n\ndef _normalize_tool_type(raw_tool_type: Any) -> str:\n    text = str(raw_tool_type or \"\").strip().lower().replace(\"-\", \"_\")\n    if text == \"ui_tool\":\n        return \"UI_Tool\"\n    if text == \"ui_surface\":\n        return \"UI_Surface\"\n    return \"Agent_Tool\"\n\n\ndef _normalize_tools_manifest(\n    tools_manager_output: dict[str, Any],\n    wf_logger,\n) -> dict[str, Any]:\n    normalized: dict[str, Any] = {}\n\n    raw_tools = tools_manager_output.get(\"tools\")\n    if isinstance(raw_tools, list):\n        normalized_tools: list[dict[str, Any]] = []\n        for entry in raw_tools:\n            if not isinstance(entry, dict):\n                continue\n            tool = dict(entry)\n            tool.pop(\"integration\", None)\n            tool_type = _normalize_tool_type(tool.get(\"tool_type\"))\n            tool[\"tool_type\"] = tool_type\n            ui = tool.get(\"ui\")\n            if isinstance(ui, dict):\n                ui = dict(ui)\n                ui[\"realization\"] = infer_workflow_ui_realization(\n                    ui.get(\"workflow_primitive\"),\n                    ui.get(\"component\"),\n                )\n                tool[\"ui\"] = ui\n            if tool_type == \"UI_Tool\":\n                tool[\"ui_contract\"] = _normalize_ui_contract(tool.get(\"ui_contract\"))\n            else:\n                tool.pop(\"ui_contract\", None)\n            normalized_tools.append(tool)\n        normalized[\"tools\"] = normalized_tools\n        ui_surface_count = len([t for t in normalized_tools if t.get(\"tool_type\") in {\"UI_Tool\", \"UI_Surface\"}])\n        wf_logger.info(\n            \"\ud83e\udde9 [CREATE_WORKFLOW_FILES] Normalized tools manifest entries=%d ui_surfaces=%d interactive_ui_tools=%d\",\n            len(normalized_tools),\n            ui_surface_count,\n            len([t for t in normalized_tools if t.get(\"tool_type\") == \"UI_Tool\"]),\n        )\n"},{"checksum":"sha256:a0fcecc52b7c5709d1b8b42a718abd6ea18a78bfe23c9b10c67ecf74a80c4b61","chunk_id":"chunk_6c6a5c77b0f0a822","end_line":673,"path":"workflows/AgentGenerator/tools/workflow_converter.py","start_line":468,"symbol_ids":["sym_2f34b2773bd89bd9","sym_41e45b9ccfa927fc","sym_5d2f03e9c13edb4f","sym_b7168a3eacf59ea5","sym_5a0da81152cc388d"],"text":"    raw_lifecycle_tools = tools_manager_output.get(\"lifecycle_tools\")\n    if isinstance(raw_lifecycle_tools, list):\n        normalized_lifecycle: list[dict[str, Any]] = []\n        for entry in raw_lifecycle_tools:\n            if not isinstance(entry, dict):\n                continue\n            tool = dict(entry)\n            tool.pop(\"integration\", None)\n            if \"tool_type\" in tool:\n                tool[\"tool_type\"] = _normalize_tool_type(tool.get(\"tool_type\"))\n            ui = tool.get(\"ui\")\n            if isinstance(ui, dict):\n                ui = dict(ui)\n                ui[\"realization\"] = infer_workflow_ui_realization(\n                    ui.get(\"workflow_primitive\"),\n                    ui.get(\"component\"),\n                )\n                tool[\"ui\"] = ui\n            normalized_lifecycle.append(tool)\n        normalized[\"lifecycle_tools\"] = normalized_lifecycle\n\n    return normalized\n\n\ndef _collect_code_files(\n    output_payload: Any,\n    *,\n    list_key: str = \"tools\",\n    source_name: str,\n    wf_logger: Any,\n) -> list[dict[str, str]]:\n    \"\"\"Normalize CodeFile-style output objects into workflow extra files.\"\"\"\n\n    if not isinstance(output_payload, dict):\n        return []\n\n    raw_files = output_payload.get(list_key)\n    if not isinstance(raw_files, list):\n        return []\n\n    normalized_files: list[dict[str, str]] = []\n    for index, entry in enumerate(raw_files):\n        if not isinstance(entry, dict):\n            wf_logger.warning(\n                \"\u26a0\ufe0f [CREATE_WORKFLOW_FILES] Skipping %s entry %d: expected object, got %s\",\n                source_name,\n                index,\n                type(entry).__name__,\n            )\n            continue\n\n        rel_path = _normalize_workflow_extra_path(entry.get(\"filename\") or entry.get(\"path\"))\n        content = entry.get(\"content\")\n        if rel_path is None:\n            wf_logger.warning(\n                \"\u26a0\ufe0f [CREATE_WORKFLOW_FILES] Skipping %s entry %d with unsafe path: %r\",\n                source_name,\n                index,\n                entry.get(\"filename\") or entry.get(\"path\"),\n            )\n            continue\n        if not isinstance(content, str) or not content.strip():\n            wf_logger.warning(\n                \"\u26a0\ufe0f [CREATE_WORKFLOW_FILES] Skipping %s entry %d without file content: %s\",\n                source_name,\n                index,\n                rel_path,\n            )\n            continue\n\n        normalized_files.append({\"path\": rel_path, \"content\": content})\n\n    return normalized_files\n\n\ndef _index_workflow_ui_targets(tools_config: Any) -> dict[str, dict[str, Any]]:\n    \"\"\"Index declared workflow UI components by component name.\"\"\"\n\n    if not isinstance(tools_config, dict):\n        return {}\n\n    shipped_component_map = dict(get_workflow_shipped_component_map())\n    targets: dict[str, dict[str, Any]] = {}\n    for list_key in (\"tools\", \"lifecycle_tools\"):\n        raw_entries = tools_config.get(list_key)\n        if not isinstance(raw_entries, list):\n            continue\n        for entry in raw_entries:\n            if not isinstance(entry, dict):\n                continue\n            ui = entry.get(\"ui\")\n            if not isinstance(ui, dict):\n                continue\n            component_name = str(ui.get(\"component\") or \"\").strip()\n            workflow_primitive = str(ui.get(\"workflow_primitive\") or \"\").strip()\n            if not component_name or not workflow_primitive or workflow_primitive == \"composer_reply\":\n                continue\n            shipped_component = shipped_component_map.get(workflow_primitive)\n            realization = str(ui.get(\"realization\") or \"\").strip()\n            targets[component_name] = {\n                \"workflow_primitive\": workflow_primitive,\n                \"shipped_component\": shipped_component,\n                \"realization\": realization,\n                \"direct_shipped\": realization == \"shipped_component\",\n            }\n    return targets\n\n\ndef _build_workflow_ui_barrel(component_paths: dict[str, str]) -> str:\n    lines = [\n        \"/**\",\n        \" * AUTO-GENERATED FILE - workflow UI barrel.\",\n        \" * Each named export is auto-registered by @chat-workflows.\",\n        \" */\",\n        \"\",\n    ]\n    for component_name in sorted(component_paths):\n        rel_path = PurePosixPath(component_paths[component_name])\n        export_path = \"./\" + rel_path.relative_to(\"ui\").as_posix()\n        lines.append(\n            f\"export {{ default as {component_name} }} from './{export_path[2:]}';\"\n        )\n    lines.append(\"\")\n    return \"\\n\".join(lines)\n\n\ndef _collect_ui_code_files(\n    output_payload: Any,\n    *,\n    tools_config: Any,\n    wf_logger: Any,\n) -> list[dict[str, str]]:\n    \"\"\"Collect UIFileGenerator output while enforcing shipped-primitive rules.\"\"\"\n\n    files = _collect_code_files(\n        output_payload,\n        source_name=\"UIFileGenerator\",\n        wf_logger=wf_logger,\n    )\n    if not files:\n        return []\n\n    ui_targets = _index_workflow_ui_targets(tools_config)\n    workflow_component_paths: dict[str, str] = {}\n    kept_files: list[dict[str, str]] = []\n    seen_paths: set[str] = set()\n\n    for item in files:\n        rel_path = item[\"path\"]\n        if rel_path in seen_paths:\n            wf_logger.warning(\n                \"\u26a0\ufe0f [CREATE_WORKFLOW_FILES] Skipping duplicate UIFileGenerator path: %s\",\n                rel_path,\n            )\n            continue\n        seen_paths.add(rel_path)\n\n        if rel_path == \"ui/index.js\":\n            continue\n\n        if rel_path.startswith(\"ui/\") and PurePosixPath(rel_path).suffix.lower() in {\".js\", \".jsx\"}:\n            component_name = PurePosixPath(rel_path).stem\n            target = ui_targets.get(component_name)\n            if target and target.get(\"direct_shipped\"):\n                wf_logger.info(\n                    \"\ud83e\udde9 [CREATE_WORKFLOW_FILES] Skipping workflow-local React for shipped primitive \"\n                    \"%s (%s)\",\n                    component_name,\n                    target.get(\"workflow_primitive\"),\n                )\n                continue\n            if target:\n                existing = workflow_component_paths.get(component_name)\n                if existing and existing != rel_path:\n                    raise ValueError(\n                        f\"UIFileGenerator emitted multiple component paths for {component_name}: \"\n                        f\"{existing} and {rel_path}\"\n                    )\n                workflow_component_paths[component_name] = rel_path\n\n        kept_files.append(item)\n\n    expected_workflow_local_components = {\n        component_name\n        for component_name, target in ui_targets.items()\n        if not target.get(\"direct_shipped\")\n    }\n    missing_components = sorted(expected_workflow_local_components - set(workflow_component_paths))\n    if missing_components:\n        wf_logger.warning(\n            \"\u26a0\ufe0f [CREATE_WORKFLOW_FILES] UIFileGenerator did not emit workflow-local component files for: %s\",\n            \", \".join(missing_components),\n        )\n\n    if workflow_component_paths:\n        kept_files.append(\n            {\n                \"path\": \"ui/index.js\",\n                \"content\": _build_workflow_ui_barrel(workflow_component_paths),\n            }\n        )\n\n    return kept_files\n\n\n__all__ = [\"promote_generated_workflow\"]"},{"checksum":"sha256:c73939d954426f1dd620c76ec9f3a385a4591424edee857e81d1d902620fb77f","chunk_id":"chunk_58e1e9f2c028d7b4","end_line":240,"path":"workflows/AgentGenerator/tools/workflow_quality_gate.py","start_line":1,"symbol_ids":["sym_2473349b94f7a4b6","sym_ff57c142fa370f7e","sym_79e502df7b2d2595","sym_38d11ac2b461a602","sym_43b08327211fa93a","sym_b3ed1b1c504f0dbb","sym_47bc39d803b6f8af","sym_c98c7e71041ee809","sym_c7506dc92124b72b","sym_4f05791cb70cabd2","sym_8b345a3979bdb9cd","sym_05d6c9f97d957760"],"text":"\"\"\"Quality gate for AgentGenerator workflow bundle outputs.\n\nThis module validates generated workflow bundle entries before they are packaged,\ndownloaded, registered, or promoted. It intentionally checks both contract shape\nand semantic drift: generated YAML can be parseable and still lose the workflow\nmeaning the prompts asked for.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport ast\nimport re\nfrom pathlib import Path\nfrom typing import Any\n\nimport yaml\n\nfrom factory_app.workflows._shared.workflow_integration import workflow_name_to_capability_id\n\nfrom .outcome_materialization import materialize_workflow_outcomes\n\nREQUIRED_WORKFLOW_FILES = {\n    \"orchestrator.yaml\",\n    \"agents.yaml\",\n    \"transition_graph.yaml\",\n    \"context_variables.yaml\",\n    \"structured_outputs.yaml\",\n    \"tools.yaml\",\n    \"middleware.yaml\",\n    \"ui_config.yaml\",\n}\nSUPPORTED_TRANSITION_CONDITIONS = {\"context_equals\", \"context_expression\", \"tool_called\"}\nEVENT_PREFIXES = (\"domain.\", \"platform.\", \"hosted.\")\nWORKFLOW_BUNDLE_BUILDER_PROMPT_SURFACE = (\n    \"factory_app/workflows/AgentGenerator/agents.yaml#WorkflowBundleBuilderAgent\"\n)\n\n\ndef _context_get(context_variables: Any | None, key: str, default: Any = None) -> Any:\n    if context_variables is None:\n        return default\n    if hasattr(context_variables, \"get\"):\n        try:\n            value = context_variables.get(key)\n            return default if value is None else value\n        except Exception:\n            pass\n    data = getattr(context_variables, \"data\", None)\n    if isinstance(data, dict):\n        return data.get(key, default)\n    if isinstance(context_variables, dict):\n        return context_variables.get(key, default)\n    return default\n\n\ndef _context_set(context_variables: Any | None, key: str, value: Any) -> None:\n    if context_variables is None:\n        return\n    if hasattr(context_variables, \"set\"):\n        try:\n            context_variables.set(key, value)\n            return\n        except Exception:\n            pass\n    data = getattr(context_variables, \"data\", None)\n    if isinstance(data, dict):\n        data[key] = value\n        return\n    if isinstance(context_variables, dict):\n        context_variables[key] = value\n\n\ndef _workflow_result_entries(workflow_bundle_results: Any) -> list[dict[str, Any]]:\n    if not isinstance(workflow_bundle_results, dict):\n        return []\n    return [\n        value\n        for key, value in workflow_bundle_results.items()\n        if isinstance(key, str) and not key.startswith(\"_\") and isinstance(value, dict)\n    ]\n\n\ndef workflow_bundle_entries_from_context(context_variables: Any | None) -> list[dict[str, Any]]:\n    return _workflow_result_entries(_context_get(context_variables, \"workflow_bundle_results\"))\n\n\ndef expected_workflows_from_context(context_variables: Any | None) -> list[dict[str, Any]]:\n    workflows_spec = _context_get(context_variables, \"workflows_spec\")\n    if isinstance(workflows_spec, list):\n        return [dict(item) for item in workflows_spec if isinstance(item, dict)]\n\n    pattern_selection = _context_get(context_variables, \"PatternSelection\")\n    if isinstance(pattern_selection, dict):\n        workflows = pattern_selection.get(\"workflows\")\n        if isinstance(workflows, list):\n            return [dict(item) for item in workflows if isinstance(item, dict)]\n\n    return []\n\n\ndef load_bundle_entries_from_root(\n    bundle_root: Path,\n    expected_workflows: list[dict[str, Any]],\n) -> list[dict[str, Any]]:\n    entries: list[dict[str, Any]] = []\n    for spec in expected_workflows:\n        workflow_name = str(spec.get(\"name\") or \"\").strip()\n        if not workflow_name:\n            continue\n        workflow_dir = bundle_root / workflow_name\n        files: list[dict[str, Any]] = []\n        if workflow_dir.is_dir():\n            for path in sorted(workflow_dir.rglob(\"*\")):\n                if path.is_file():\n                    files.append(\n                        {\n                            \"filename\": str(path.relative_to(workflow_dir)).replace(\"\\\\\", \"/\"),\n                            \"content\": path.read_text(encoding=\"utf-8-sig\"),\n                        }\n                    )\n        entries.append({\"workflow_name\": workflow_name, \"files\": files})\n    return entries\n\n\ndef _safe_relpath(raw_path: Any) -> str | None:\n    text = str(raw_path or \"\").replace(\"\\\\\", \"/\").strip().lstrip(\"/\")\n    if not text or \"\\x00\" in text:\n        return None\n    parsed = Path(text)\n    if parsed.is_absolute():\n        return None\n    if any(part in {\"\", \".\", \"..\", \"_shared\"} for part in text.split(\"/\")):\n        return None\n    return text\n\n\ndef _files_by_name(entry: dict[str, Any], *, errors: list[str] | None = None) -> dict[str, str]:\n    files = entry.get(\"files\")\n    if not isinstance(files, list):\n        return {}\n    resolved: dict[str, str] = {}\n    for file_entry in files:\n        if not isinstance(file_entry, dict):\n            continue\n        filename = _safe_relpath(file_entry.get(\"filename\"))\n        if not filename:\n            if errors is not None:\n                errors.append(f\"invalid workflow file path: {file_entry.get('filename')!r}\")\n            continue\n        if filename in resolved and errors is not None:\n            errors.append(f\"duplicate workflow file: {filename}\")\n        if not isinstance(file_entry.get(\"content\"), str) and errors is not None:\n            errors.append(f\"{filename} content must be a string\")\n        resolved[filename] = str(file_entry.get(\"content\") or \"\")\n    return resolved\n\n\ndef _yaml_payloads_from_files(files: dict[str, str]) -> tuple[dict[str, Any], list[str]]:\n    payloads: dict[str, Any] = {}\n    errors: list[str] = []\n    for relpath, content in sorted(files.items()):\n        if not relpath.endswith(\".yaml\"):\n            continue\n        try:\n            payloads[relpath] = yaml.safe_load(content)\n        except Exception as exc:\n            errors.append(f\"{relpath} is not valid YAML: {exc}\")\n    return payloads, errors\n\n\ndef _read_agent_names(agents_payload: Any) -> list[str]:\n    agents = agents_payload.get(\"agents\") if isinstance(agents_payload, dict) else agents_payload\n    if isinstance(agents, dict):\n        return [str(name) for name in agents if str(name or \"\").strip()]\n    if isinstance(agents, list):\n        return [\n            str(agent.get(\"name\"))\n            for agent in agents\n            if isinstance(agent, dict) and str(agent.get(\"name\") or \"\").strip()\n        ]\n    return []\n\n\ndef _validate_bundle_implementations(files: dict[str, str], tools: dict[str, Any]) -> list[str]:\n    from mozaiksai.core.validation.functional_generated_app import scan_placeholder_implementations\n\n    errors: list[str] = []\n    modules: dict[str, ast.Module] = {}\n    for filename, content in files.items():\n        if not filename.endswith(\".py\"):\n            continue\n        try:\n            modules[filename] = ast.parse(content, filename=filename)\n            compile(modules[filename], filename, \"exec\")\n        except SyntaxError as exc:\n            errors.append(f\"{filename} is not valid Python: {exc}\")\n    errors.extend(\n        item.message for item in scan_placeholder_implementations({\n            f\"workflows/generated/{path}\": files[path] for path in modules\n        })\n    )\n    for binding in [*tools[\"tools\"], *tools[\"lifecycle_tools\"]]:\n        filename = str(binding[\"file\"]).replace(\"\\\\\", \"/\")\n        if not filename.startswith(\"tools/\"):\n            filename = f\"tools/{filename}\"\n        if filename not in files:\n            errors.append(f\"tools.yaml references missing implementation file {filename!r}\")\n            continue\n        module = modules.get(filename)\n        if module is None:\n            if not filename.endswith(\".py\"):\n                errors.append(f\"tools.yaml implementation must be a Python file: {filename!r}\")\n            continue\n        function_name = binding[\"function\"]\n        function = next((\n            node for node in module.body\n            if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)) and node.name == function_name\n        ), None)\n        if function is None:\n            errors.append(f\"{filename} does not define declared tool function {function_name!r}\")\n            continue\n        body = [node for node in function.body if not (\n            isinstance(node, ast.Expr) and isinstance(node.value, ast.Constant)\n            and isinstance(node.value.value, str)\n        )]\n        if not body or all(\n            isinstance(node, ast.Pass) or (\n                isinstance(node, ast.Expr) and isinstance(node.value, ast.Constant)\n                and node.value.value is Ellipsis\n            ) for node in body\n        ):\n            errors.append(f\"{filename} declares unfinished tool function {function_name!r}\")\n    return errors\n\n\ndef _event_type_from_trigger(trigger: Any) -> str | None:\n    if not isinstance(trigger, dict):\n        return None\n    for key in (\"event\", \"event_type\"):\n        value = str(trigger.get(key) or \"\").strip()"},{"checksum":"sha256:8086fc24892b8c1d7331e918628df8b4aa750ce899ac9873f6fa8fc417a0b019","chunk_id":"chunk_283fdf7bf7b3990b","end_line":465,"path":"workflows/AgentGenerator/tools/workflow_quality_gate.py","start_line":241,"symbol_ids":["sym_05d6c9f97d957760","sym_744b0564f3822829","sym_f5892b65837dc0ab"],"text":"        if value.startswith(EVENT_PREFIXES):\n            return value\n    trigger_type = str(trigger.get(\"type\") or \"\").strip()\n    if trigger_type.startswith(EVENT_PREFIXES):\n        return trigger_type\n    return None\n\n\ndef _is_generic_trigger_description(value: Any) -> bool:\n    text = re.sub(r\"\\s+\", \" \", str(value or \"\").strip().lower())\n    if not text:\n        return True\n    if any(marker in text for marker in (\"todo\", \"tbd\", \"placeholder\", \"example\", \"lorem\")):\n        return True\n    if text in {\n        \"event trigger\",\n        \"trigger event\",\n        \"workflow trigger\",\n        \"start workflow\",\n        \"starts workflow\",\n        \"trigger the workflow\",\n    }:\n        return True\n    return bool(re.fullmatch(r\"trigger for [a-z0-9_. -]+ event\\.?\", text))\n\n\ndef _semantic_tokens(*values: [REDACTED] -> set[str]:\n    stop_words = {\n        \"after\",\n        \"agent\",\n        \"automation\",\n        \"event\",\n        \"from\",\n        \"into\",\n        \"requested\",\n        \"requests\",\n        \"runs\",\n        \"start\",\n        \"the\",\n        \"this\",\n        \"through\",\n        \"trigger\",\n        \"workflow\",\n    }\n    tokens: [REDACTED] = [REDACTED]\n    for value in values:\n        for token in re.split(r\"[^a-z0-9]+\", str(value or \"\").lower()):\n            if len(token) >= [REDACTED] and token not in stop_words:\n                tokens.add(token)\n    return tokens\n\n\ndef _issue(\n    *,\n    check_id: str,\n    file: str,\n    expected: Any,\n    observed: Any,\n    fix_suggestion: str,\n    severity: str = \"error\",\n    prompt_surface: str = WORKFLOW_BUNDLE_BUILDER_PROMPT_SURFACE,\n) -> dict[str, Any]:\n    return {\n        \"severity\": severity,\n        \"check_id\": check_id,\n        \"file\": file,\n        \"expected\": expected,\n        \"observed\": observed,\n        \"prompt_surface\": prompt_surface,\n        \"fix_suggestion\": fix_suggestion,\n    }\n\n\ndef _issue_summary(workflow_name: str, issue: dict[str, Any]) -> str:\n    return (\n        f\"{workflow_name}: {issue['check_id']} in {issue['file']}: \"\n        f\"expected {issue['expected']!r}, observed {issue['observed']!r}; \"\n        f\"prompt_surface={issue['prompt_surface']}\"\n    )\n\n\ndef _expected_by_name(\n    *,\n    bundle_entries: list[dict[str, Any]],\n    expected_workflows: list[dict[str, Any]] | None,\n) -> dict[str, dict[str, Any]]:\n    expected = {\n        str(item.get(\"name\") or item.get(\"workflow_name\") or \"\").strip(): dict(item)\n        for item in expected_workflows or []\n        if isinstance(item, dict) and str(item.get(\"name\") or item.get(\"workflow_name\") or \"\").strip()\n    }\n    for entry in bundle_entries:\n        workflow_name = str(entry.get(\"workflow_name\") or \"\").strip()\n        if workflow_name and workflow_name not in expected:\n            expected[workflow_name] = {\"name\": workflow_name, \"context_variables\": {}}\n    return expected\n\n\ndef validate_workflow_bundle_structure(\n    *,\n    bundle_entries: list[dict[str, Any]],\n    expected_workflows: list[dict[str, Any]] | None = None,\n) -> dict[str, Any]:\n    from mozaiksai.core.workflow.contract_validation import (\n        validate_workflow_context_contract,\n        validate_workflow_tool_outcomes,\n    )\n    from mozaiksai.core.workflow.declarative.contracts import (\n        parse_a2a_config,\n        parse_agents_config,\n        parse_context_variables_config,\n        parse_middleware_config,\n        parse_orchestrator_config,\n        parse_structured_outputs_config,\n        parse_tools_config,\n        parse_transition_graph_config,\n        parse_ui_config,\n    )\n    from mozaiksai.core.workflow.execution.network_graph import compile_transition_rules_to_graph\n    from mozaiksai.core.workflow.task_batches import parse_task_batches_config\n\n    errors: list[str] = []\n    workflow_reports: list[dict[str, Any]] = []\n    expected = _expected_by_name(bundle_entries=bundle_entries, expected_workflows=expected_workflows)\n    entries_by_name = {\n        str(entry.get(\"workflow_name\") or \"\").strip(): entry\n        for entry in bundle_entries\n        if str(entry.get(\"workflow_name\") or \"\").strip()\n    }\n\n    for workflow_name, spec in expected.items():\n        entry = entries_by_name.get(workflow_name, {\"workflow_name\": workflow_name, \"files\": []})\n        report: dict[str, Any] = {\"workflow_name\": workflow_name, \"errors\": []}\n        workflow_reports.append(report)\n\n        try:\n            entry = materialize_workflow_outcomes(entry)\n        except (ValueError, TypeError, KeyError, yaml.YAMLError) as exc:\n            report[\"errors\"].append(f\"outcome plan materialization failed: {exc}\")\n\n        files = _files_by_name(entry, errors=report[\"errors\"])\n        emitted_files = set(files)\n        missing = sorted(REQUIRED_WORKFLOW_FILES.difference(emitted_files))\n        if missing:\n            report[\"errors\"].append(f\"missing required workflow files: {missing}\")\n\n        declarative_names = {Path(name).stem for name in REQUIRED_WORKFLOW_FILES} | {\"a2a\", \"handoffs\", \"hooks\"}\n        retired_files = {\"handoffs.yaml\", \"hooks.yaml\"} | {\n            f\"{name}{suffix}\" for name in declarative_names for suffix in (\".json\", \".yml\")\n        }\n        stale_files = sorted(retired_files.intersection(emitted_files))\n        if stale_files:\n            report[\"errors\"].append(f\"stale workflow files emitted: {stale_files}\")\n        templates = sorted(name for name in emitted_files if name.endswith(\".j2\"))\n        if templates:\n            report[\"errors\"].append(f\"unrendered workflow templates emitted: {templates}\")\n\n        payloads, yaml_errors = _yaml_payloads_from_files(files)\n        report[\"errors\"].extend(yaml_errors)\n\n        parsed_payloads: dict[str, Any] = {}\n        invalid_documents = False\n        for filename, parser in (\n            (\"orchestrator.yaml\", parse_orchestrator_config),\n            (\"agents.yaml\", parse_agents_config),\n            (\"transition_graph.yaml\", parse_transition_graph_config),\n            (\"context_variables.yaml\", parse_context_variables_config),\n            (\"structured_outputs.yaml\", parse_structured_outputs_config),\n            (\"tools.yaml\", parse_tools_config),\n            (\"middleware.yaml\", parse_middleware_config),\n            (\"ui_config.yaml\", parse_ui_config),\n            (\"a2a.yaml\", parse_a2a_config),\n        ):\n            if filename not in payloads:\n                continue\n            try:\n                parsed_payloads[filename] = parser(payloads[filename])\n            except ValueError as exc:\n                report[\"errors\"].append(str(exc))\n                invalid_documents = True\n\n        if invalid_documents or yaml_errors or missing:\n            errors.extend(f\"{workflow_name}: {message}\" for message in report[\"errors\"])\n            continue\n\n        try:\n            validate_workflow_context_contract(\n                workflow_name=workflow_name,\n                workflow_config={\n                    \"context_variables\": parsed_payloads[\"context_variables.yaml\"],\n                    \"transition_graph\": parsed_payloads[\"transition_graph.yaml\"],\n                    \"structured_outputs\": parsed_payloads[\"structured_outputs.yaml\"],\n                    \"tools\": parsed_payloads[\"tools.yaml\"][\"tools\"],\n                },\n            )\n        except ValueError as exc:\n            report[\"errors\"].append(str(exc))\n\n        report[\"errors\"].extend(_validate_bundle_implementations(files, parsed_payloads[\"tools.yaml\"]))\n\n        orchestrator = payloads.get(\"orchestrator.yaml\")\n        if isinstance(orchestrator, dict):\n            if orchestrator.get(\"workflow_name\") != workflow_name:\n                report[\"errors\"].append(\n                    f\"orchestrator.workflow_name={orchestrator.get('workflow_name')!r} \"\n                    f\"does not match {workflow_name!r}\"\n                )\n            if \"startup_mode\" in orchestrator:\n                report[\"errors\"].append(\"orchestrator.yaml must not use startup_mode\")\n            if \"visual_agents\" in orchestrator:\n                report[\"errors\"].append(\"orchestrator.yaml must not contain visual_agents; use ui_config.yaml\")\n            startup_mode = orchestrator.get(\"workflow_startup_mode\")\n            if not startup_mode:\n                report[\"errors\"].append(\"orchestrator.yaml missing workflow_startup_mode\")\n            expected_mode = (spec.get(\"context_variables\") or {}).get(\"expected_workflow_startup_mode\")\n            if expected_mode and startup_mode and startup_mode != expected_mode:\n                report[\"errors\"].append(\n                    f\"workflow_startup_mode={startup_mode!r} does not match expected {expected_mode!r}\"\n                )\n            trigger_keys = {\"type\", \"event\", \"capability_id\", \"endpoint\", \"method\", \"description\"}\n            triggers = orchestrator.get(\"triggers\")\n            if isinstance(triggers, list):\n                for index, trigger in enumerate(triggers):\n                    if not isinstance(trigger, dict):\n                        report[\"errors\"].append(f\"orchestrator trigger {index} must be a mapping\")"},{"checksum":"sha256:8f48346adff7296720a15a67b063cda03199bd23acd01b36b1446545c4de806e","chunk_id":"chunk_e655a3b1b62c62db","end_line":632,"path":"workflows/AgentGenerator/tools/workflow_quality_gate.py","start_line":466,"symbol_ids":[],"text":"                        continue\n                    extra_keys = sorted(set(trigger).difference(trigger_keys))\n                    if extra_keys:\n                        report[\"errors\"].append(\n                            f\"orchestrator trigger {index} uses unsupported keys: {extra_keys}\"\n                        )\n        else:\n            report[\"errors\"].append(\"orchestrator.yaml must contain a mapping\")\n            startup_mode = None\n\n        transition_graph = payloads.get(\"transition_graph.yaml\")\n        agents_payload = payloads.get(\"agents.yaml\")\n        if isinstance(transition_graph, dict):\n            transition_rules = transition_graph.get(\"transition_rules\")\n            if not isinstance(transition_rules, list) or not transition_rules:\n                report[\"errors\"].append(\"transition_graph.yaml must define non-empty transition_rules\")\n            else:\n                for index, rule in enumerate(transition_rules):\n                    if not isinstance(rule, dict):\n                        report[\"errors\"].append(f\"transition rule {index} must be a mapping\")\n                        continue\n                    if \"condition\" in rule:\n                        report[\"errors\"].append(f\"transition rule {index} uses removed condition field\")\n                    if str(rule.get(\"transition_type\") or \"\").strip() == \"condition\":\n                        condition_type = str(rule.get(\"condition_type\") or \"\").strip()\n                        if condition_type not in SUPPORTED_TRANSITION_CONDITIONS:\n                            report[\"errors\"].append(\n                                f\"transition rule {index} uses unsupported condition_type={condition_type!r}\"\n                            )\n                agent_names = _read_agent_names(agents_payload)\n                initial_agent = str(orchestrator.get(\"initial_agent\") or \"\").strip() if isinstance(orchestrator, dict) else \"\"\n                if agent_names and initial_agent:\n                    try:\n                        compile_transition_rules_to_graph(\n                            transition_rules,\n                            initial_agent_name=initial_agent,\n                            agent_id_by_name={name: name for name in agent_names},\n                            max_turns=orchestrator.get(\"max_turns\") if isinstance(orchestrator, dict) else None,\n                        )\n                    except Exception as exc:\n                        report[\"errors\"].append(f\"transition graph does not compile through AG2 adapter: {exc}\")\n        else:\n            report[\"errors\"].append(\"transition_graph.yaml must contain a mapping\")\n\n        ui_config = payloads.get(\"ui_config.yaml\")\n        if isinstance(ui_config, dict):\n            visual_agents = ui_config.get(\"visual_agents\")\n            if startup_mode == \"BackendOnly\" and visual_agents not in (None, []):\n                report[\"errors\"].append(\"BackendOnly workflow must not expose visual_agents\")\n        else:\n            report[\"errors\"].append(\"ui_config.yaml must contain a mapping\")\n\n        context_variables = payloads.get(\"context_variables.yaml\")\n        context_definitions = (\n            set(context_variables.get(\"definitions\") or {})\n            if isinstance(context_variables, dict)\n            else set()\n        )\n        if not isinstance(context_variables, dict):\n            report[\"errors\"].append(\"context_variables.yaml must contain a mapping\")\n\n        task_batches = payloads.get(\"extended_orchestration/task_batches.yaml\")\n        requires_task_batches = bool((spec.get(\"context_variables\") or {}).get(\"require_task_batches\"))\n        if requires_task_batches and not isinstance(task_batches, dict):\n            report[\"errors\"].append(\"required extended_orchestration/task_batches.yaml missing\")\n        if isinstance(task_batches, dict):\n            try:\n                parsed = parse_task_batches_config(task_batches)\n                validate_workflow_tool_outcomes({\n                    \"tools\": (payloads.get(\"tools.yaml\") or {}).get(\"tools\", []),\n                    \"context_variables\": payloads.get(\"context_variables.yaml\") or {},\n                    \"transition_graph\": payloads.get(\"transition_graph.yaml\") or {},\n                    \"structured_outputs\": payloads.get(\"structured_outputs.yaml\") or {},\n                    \"initial_agent\": (orchestrator or {}).get(\"initial_agent\"),\n                }, task_batches=parsed)\n                if not parsed.conveyors:\n                    report[\"errors\"].append(\"task_batches.yaml must declare conveyors[]\")\n                if not parsed.batches:\n                    report[\"errors\"].append(\"task_batches.yaml did not materialize executable batches\")\n                expected_task_batch_id = (spec.get(\"context_variables\") or {}).get(\"expected_task_batch_id\")\n                if expected_task_batch_id:\n                    batch_ids = {batch.id for batch in parsed.batches}\n                    if expected_task_batch_id not in batch_ids:\n                        report[\"errors\"].append(\n                            f\"task_batches.yaml must declare expected conveyor id {expected_task_batch_id!r}\"\n                        )\n                for batch in parsed.batches:\n                    for key in (batch.result.context_key, batch.result.status_key):\n                        if key not in context_definitions:\n                            report[\"errors\"].append(\n                                f\"task_batches {batch.id!r} writes undeclared context variable {key!r}\"\n                            )\n            except Exception as exc:\n                report[\"errors\"].append(f\"task_batches.yaml is invalid: {exc}\")\n\n        errors.extend(f\"{workflow_name}: {message}\" for message in report[\"errors\"])\n\n    return {\"valid\": not errors, \"errors\": errors, \"workflows\": workflow_reports}\n\n\ndef validate_agentgenerator_semantic_drift(\n    *,\n    bundle_entries: list[dict[str, Any]] | None = None,\n    bundle_root: Path | None = None,\n    expected_workflows: list[dict[str, Any]] | None = None,\n    context_variables: Any | None = None,\n) -> dict[str, Any]:\n    expected = expected_workflows or expected_workflows_from_context(context_variables)\n    entries = bundle_entries or []\n    if not entries and bundle_root is not None:\n        entries = load_bundle_entries_from_root(bundle_root, expected)\n\n    errors: list[str] = []\n    warnings: list[str] = []\n    workflow_reports: list[dict[str, Any]] = []\n    expected_by_name = _expected_by_name(bundle_entries=entries, expected_workflows=expected)\n    entries_by_name = {\n        str(entry.get(\"workflow_name\") or \"\").strip(): entry\n        for entry in entries\n        if str(entry.get(\"workflow_name\") or \"\").strip()\n    }\n\n    for workflow_name, spec in expected_by_name.items():\n        entry = entries_by_name.get(workflow_name, {\"workflow_name\": workflow_name, \"files\": []})\n        report: dict[str, Any] = {\"workflow_name\": workflow_name, \"semantic_drifts\": []}\n        workflow_reports.append(report)\n\n        files = _files_by_name(entry)\n        payloads, yaml_errors = _yaml_payloads_from_files(files)\n        for yaml_error in yaml_errors:\n            issue = _issue(\n                check_id=\"workflow_yaml_readable_for_semantic_audit\",\n                file=\"*.yaml\",\n                expected=\"parseable workflow YAML\",\n                observed=yaml_error,\n                fix_suggestion=(\n                    \"Tighten WorkflowBundleBuilderAgent output instructions so every \"\n                    \"generated YAML file is complete and parseable before emission.\"\n                ),\n            )\n            report[\"semantic_drifts\"].append(issue)\n            errors.append(_issue_summary(workflow_name, issue))\n        if yaml_errors:\n            continue\n\n        orchestrator = payloads.get(\"orchestrator.yaml\")\n        if not isinstance(orchestrator, dict):\n            issue = _issue(\n                check_id=\"orchestrator_mapping_required\",\n                file=\"orchestrator.yaml\",\n                expected=\"mapping\",\n                observed=type(orchestrator).__name__,\n                fix_suggestion=\"Ensure WorkflowBundleBuilderAgent always emits orchestrator.yaml as a YAML object.\",\n            )\n            report[\"semantic_drifts\"].append(issue)\n            errors.append(_issue_summary(workflow_name, issue))\n            continue\n\n        spec_context = spec.get(\"context_variables\") if isinstance(spec.get(\"context_variables\"), dict) else {}\n        expected_human = spec_context.get(\"expected_human_in_the_loop\")  # type: ignore[union-attr]\n        if isinstance(expected_human, bool) and orchestrator.get(\"human_in_the_loop\") is not expected_human:\n            issue = _issue(\n                check_id=\"human_in_the_loop_semantic_drift\",\n                file=\"orchestrator.yaml\",\n                expected=expected_human,\n                observed=orchestrator.get(\"human_in_the_loop\"),\n                fix_suggestion=("},{"checksum":"sha256:ae5acf02b0741d45bc9ba034b1f672e43b8b36cbdb6f83c8ff59a5ce5610b2a5","chunk_id":"chunk_3563054d0aa5101e","end_line":809,"path":"workflows/AgentGenerator/tools/workflow_quality_gate.py","start_line":633,"symbol_ids":[],"text":"                    \"Update WorkflowBundleBuilderAgent prompt handling so the HITL flag from \"\n                    \"the task brief is copied into orchestrator.yaml without reinterpretation.\"\n                ),\n            )\n            report[\"semantic_drifts\"].append(issue)\n            errors.append(_issue_summary(workflow_name, issue))\n\n        triggers = orchestrator.get(\"triggers\") if isinstance(orchestrator.get(\"triggers\"), list) else []\n        expected_event = str(spec_context.get(\"expected_event_trigger\") or \"\").strip()  # type: ignore[union-attr]\n        if expected_event:\n            matching_triggers = [trigger for trigger in triggers if _event_type_from_trigger(trigger) == expected_event]  # type: ignore[union-attr]\n            if not matching_triggers:\n                issue = _issue(\n                    check_id=\"event_trigger_missing\",\n                    file=\"orchestrator.yaml\",\n                    expected=expected_event,\n                    observed=triggers,\n                    fix_suggestion=(\n                        \"Make WorkflowBundleBuilderAgent copy the exact event trigger from \"\n                        \"the generation brief into orchestrator.yaml triggers[].\"\n                    ),\n                )\n                report[\"semantic_drifts\"].append(issue)\n                errors.append(_issue_summary(workflow_name, issue))\n        else:\n            matching_triggers = [trigger for trigger in triggers if _event_type_from_trigger(trigger)]  # type: ignore[union-attr]\n\n        explicit_expected_capability_id = str(spec_context.get(\"expected_workflow_capability_id\") or \"\").strip()  # type: ignore[union-attr]\n        expected_capability_id = explicit_expected_capability_id or workflow_name_to_capability_id(workflow_name)\n        for matching_trigger in matching_triggers:\n            trigger_type = str(matching_trigger.get(\"type\") or \"\").strip()\n            if trigger_type != \"event\":\n                issue = _issue(\n                    check_id=\"event_trigger_type_semantic_drift\",\n                    file=\"orchestrator.yaml\",\n                    expected=\"event\",\n                    observed=trigger_type,\n                    fix_suggestion=(\n                        \"Prompt WorkflowBundleBuilderAgent to emit `type: event` for \"\n                        \"domain/platform/hosted event triggers.\"\n                    ),\n                )\n                report[\"semantic_drifts\"].append(issue)\n                errors.append(_issue_summary(workflow_name, issue))\n\n            observed_capability_id = str(matching_trigger.get(\"capability_id\") or \"\").strip()\n            if not observed_capability_id:\n                issue = _issue(\n                    check_id=\"event_trigger_capability_id_semantic_drift\",\n                    file=\"orchestrator.yaml\",\n                    expected=\"non-empty stable workflow capability id\",\n                    observed=None,\n                    fix_suggestion=(\n                        \"Prompt WorkflowBundleBuilderAgent to include the stable workflow \"\n                        \"capability_id on every event trigger; AppGenerator reactions use \"\n                        \"that id as the runtime-resolvable target.\"\n                    ),\n                )\n                report[\"semantic_drifts\"].append(issue)\n                errors.append(_issue_summary(workflow_name, issue))\n            elif explicit_expected_capability_id and observed_capability_id != expected_capability_id:\n                issue = _issue(\n                    check_id=\"event_trigger_capability_id_semantic_drift\",\n                    file=\"orchestrator.yaml\",\n                    expected=expected_capability_id,\n                    observed=observed_capability_id,\n                    fix_suggestion=(\n                        \"Prompt WorkflowBundleBuilderAgent to include the stable workflow \"\n                        \"capability_id on every event trigger; AppGenerator reactions use \"\n                        \"that id as the runtime-resolvable target.\"\n                    ),\n                )\n                report[\"semantic_drifts\"].append(issue)\n                errors.append(_issue_summary(workflow_name, issue))\n\n            trigger_description = matching_trigger.get(\"description\")\n            if _is_generic_trigger_description(trigger_description):\n                issue = _issue(\n                    check_id=\"event_trigger_description_semantic_drift\",\n                    file=\"orchestrator.yaml\",\n                    expected=\"domain-specific trigger purpose\",\n                    observed=trigger_description,\n                    fix_suggestion=(\n                        \"Prompt WorkflowBundleBuilderAgent to preserve business meaning in \"\n                        \"trigger descriptions instead of emitting generic text such as \"\n                        \"`Trigger for ... event`.\"\n                    ),\n                )\n                report[\"semantic_drifts\"].append(issue)\n                errors.append(_issue_summary(workflow_name, issue))\n            else:\n                expected_tokens = [REDACTED] spec.get(\"description\"))\n                matched_tokens = [REDACTED]\n                    token\n                    for token in expected_tokens\n                    if token in str(trigger_description or \"\").lower()\n                }\n                if expected_tokens and len(matched_tokens) < 2:\n                    issue = _issue(\n                        check_id=\"[REDACTED]\",\n                        file=\"orchestrator.yaml\",\n                        expected=[REDACTED]\n                        observed=trigger_description,\n                        severity=\"warning\",\n                        fix_suggestion=(\n                            \"Consider tightening WorkflowBundleBuilderAgent examples so \"\n                            \"trigger descriptions retain domain nouns from the brief.\"\n                        ),\n                    )\n                    report[\"semantic_drifts\"].append(issue)\n                    warnings.append(_issue_summary(workflow_name, issue))\n\n        task_batches = payloads.get(\"extended_orchestration/task_batches.yaml\")\n        if isinstance(task_batches, dict):\n            conveyors = task_batches.get(\"conveyors\")\n            if isinstance(conveyors, list):\n                for conveyor in conveyors:\n                    if not isinstance(conveyor, dict):\n                        continue\n                    execution_agents = [\n                        str(agent).strip()\n                        for agent in conveyor.get(\"execution_agents\", [])\n                        if str(agent or \"\").strip()\n                    ]\n                    if len(set(execution_agents)) < 2:\n                        issue = _issue(\n                            check_id=\"task_conveyor_parallel_execution_agent_drift\",\n                            file=\"extended_orchestration/task_batches.yaml\",\n                            expected=\"at least two execution_agents for parallel downstream work\",\n                            observed=execution_agents,\n                            fix_suggestion=(\n                                \"Prompt WorkflowBundleBuilderAgent to model conveyor workflows \"\n                                \"as decomposition plus multiple downstream execution agents, not \"\n                                \"a single serial worker.\"\n                            ),\n                        )\n                        report[\"semantic_drifts\"].append(issue)\n                        errors.append(_issue_summary(workflow_name, issue))\n\n    return {\n        \"valid\": not errors,\n        \"errors\": errors,\n        \"warnings\": warnings,\n        \"workflows\": workflow_reports,\n    }\n\n\ndef run_workflow_bundle_quality_gate(\n    *,\n    bundle_entries: list[dict[str, Any]],\n    expected_workflows: list[dict[str, Any]] | None = None,\n    context_variables: Any | None = None,\n) -> dict[str, Any]:\n    expected = expected_workflows or expected_workflows_from_context(context_variables)\n    structure = validate_workflow_bundle_structure(\n        bundle_entries=bundle_entries,\n        expected_workflows=expected,\n    )\n    if structure.get(\"valid\"):\n        bundle_entries = [materialize_workflow_outcomes(entry) for entry in bundle_entries]\n    semantic_drift = validate_agentgenerator_semantic_drift(\n        bundle_entries=bundle_entries,\n        expected_workflows=expected,\n        context_variables=context_variables,\n    )\n    errors = list(structure.get(\"errors\") or []) + list(semantic_drift.get(\"errors\") or [])\n    warnings = list(semantic_drift.get(\"warnings\") or [])\n    result = {\n        \"status\": \"passed\" if not errors else \"failed\",\n        \"passed\": not errors,\n        \"errors\": errors,\n        \"warnings\": warnings,\n        \"structure\": structure,\n        \"semantic_drift\": semantic_drift,\n    }\n    _context_set(context_variables, \"workflow_bundle_validation_status\", result[\"status\"])\n    _context_set(context_variables, \"workflow_bundle_validation_errors\", errors)"},{"checksum":"sha256:da985a5192eaaa80445bf96ccac8a26dda21dfdd6a193eacc5669e1e07fd5b66","chunk_id":"chunk_c31ce55e1d442780","end_line":1011,"path":"workflows/AgentGenerator/tools/workflow_quality_gate.py","start_line":810,"symbol_ids":[],"text":"    _context_set(context_variables, \"workflow_bundle_validation_warnings\", warnings)\n    _context_set(context_variables, \"workflow_bundle_semantic_drift\", semantic_drift)\n    _context_set(context_variables, \"workflow_bundle_quality_gate\", result)\n    return result\n\n\ndef _workflow_issue_map(quality_gate: dict[str, Any]) -> dict[str, list[str]]:\n    issues: dict[str, list[str]] = {}\n    structure = quality_gate.get(\"structure\") if isinstance(quality_gate, dict) else {}\n    for report in structure.get(\"workflows\") or [] if isinstance(structure, dict) else []:\n        if not isinstance(report, dict):\n            continue\n        workflow_name = str(report.get(\"workflow_name\") or \"\").strip()\n        if not workflow_name:\n            continue\n        for error in report.get(\"errors\") or []:\n            issues.setdefault(workflow_name, []).append(str(error))\n\n    semantic_drift = quality_gate.get(\"semantic_drift\") if isinstance(quality_gate, dict) else {}\n    for report in semantic_drift.get(\"workflows\") or [] if isinstance(semantic_drift, dict) else []:\n        if not isinstance(report, dict):\n            continue\n        workflow_name = str(report.get(\"workflow_name\") or \"\").strip()\n        if not workflow_name:\n            continue\n        for item in report.get(\"semantic_drifts\") or []:\n            if not isinstance(item, dict) or item.get(\"severity\") != \"error\":\n                continue\n            summary = (\n                f\"{item.get('check_id')}: expected {item.get('expected')!r}, \"\n                f\"observed {item.get('observed')!r}; fix: {item.get('fix_suggestion')}\"\n            )\n            issues.setdefault(workflow_name, []).append(summary)\n    return issues\n\n\ndef _task_id_for_entry(entry: dict[str, Any]) -> str:\n    task_id = str(entry.get(\"_task_id\") or \"\").strip()\n    if task_id:\n        return task_id\n    workflow_name = str(entry.get(\"workflow_name\") or \"\").strip()\n    return re.sub(r\"[^a-z0-9]+\", \"_\", workflow_name.lower()).strip(\"_\")\n\n\ndef _workflow_spec_name(spec: dict[str, Any]) -> str:\n    return str(spec.get(\"name\") or spec.get(\"workflow_name\") or spec.get(\"id\") or \"\").strip()\n\n\ndef _repair_task_id_for_spec(spec: dict[str, Any]) -> str:\n    task_id = str(spec.get(\"task_id\") or \"\").strip()\n    if task_id:\n        return task_id\n    workflow_name = _workflow_spec_name(spec)\n    return re.sub(r\"[^a-z0-9]+\", \"_\", workflow_name.lower()).strip(\"_\")\n\n\ndef _build_repair_request(\n    *,\n    workflow_issues: dict[str, list[str]],\n    attempt: int,\n    max_attempts: int,\n) -> str:\n    lines = [\n        f\"Workflow bundle quality gate failed. Automated repair attempt {attempt} of {max_attempts}.\",\n        \"Regenerate only the failed workflow bundle(s). Preserve the original workflow intent.\",\n        \"Do not simplify the workflow, remove task-batch/conveyor behavior, or invent alternate trigger semantics.\",\n    ]\n    for workflow_name, issues in sorted(workflow_issues.items()):\n        lines.append(f\"\\n{workflow_name}:\")\n        for issue in issues:\n            lines.append(f\"- {issue}\")\n    return \"\\n\".join(lines)\n\n\ndef prepare_workflow_bundle_repair(\n    *,\n    quality_gate: dict[str, Any],\n    bundle_entries: list[dict[str, Any]],\n    context_variables: Any | None = None,\n    max_attempts: int = 2,\n) -> dict[str, Any]:\n    \"\"\"Prepare a bounded AgentGenerator task-batch retry for failed workflows.\"\"\"\n\n    max_attempts = max(0, int(max_attempts))\n    workflow_issues = _workflow_issue_map(quality_gate)\n    failed_workflows = sorted(workflow_issues)\n    prior_attempts = int(_context_get(context_variables, \"workflow_bundle_repair_count\", 0) or 0)\n\n    if not failed_workflows:\n        result = {\n            \"status\": \"blocked\",\n            \"repairable\": False,\n            \"reason\": \"quality_gate_failed_without_workflow_issue_mapping\",\n            \"failed_workflows\": [],\n            \"attempt\": prior_attempts,\n            \"max_attempts\": max_attempts,\n            \"repair_request\": None,\n        }\n        _context_set(context_variables, \"workflow_bundle_repair_status\", result[\"status\"])\n        _context_set(context_variables, \"workflow_bundle_repair_result\", result)\n        return result\n\n    if prior_attempts >= max_attempts:\n        repair_request = _build_repair_request(\n            workflow_issues=workflow_issues,\n            attempt=prior_attempts,\n            max_attempts=max_attempts,\n        )\n        result = {\n            \"status\": \"blocked\",\n            \"repairable\": False,\n            \"reason\": \"workflow_bundle_repair_attempts_exhausted\",\n            \"failed_workflows\": failed_workflows,\n            \"attempt\": prior_attempts,\n            \"max_attempts\": max_attempts,\n            \"repair_request\": repair_request,\n        }\n        _context_set(context_variables, \"workflow_bundle_repair_status\", result[\"status\"])\n        _context_set(context_variables, \"workflow_bundle_repair_request\", repair_request)\n        _context_set(context_variables, \"workflow_bundle_repair_failed_workflows\", failed_workflows)\n        _context_set(context_variables, \"workflow_bundle_repair_result\", result)\n        return result\n\n    attempt = prior_attempts + 1\n    repair_request = _build_repair_request(\n        workflow_issues=workflow_issues,\n        attempt=attempt,\n        max_attempts=max_attempts,\n    )\n\n    current_results = _context_get(context_variables, \"workflow_bundle_results\")\n    current_specs = _context_get(context_variables, \"workflows_spec\", [])\n    if not _context_get(context_variables, \"workflow_bundle_repair_original_workflows_spec\"):\n        _context_set(context_variables, \"workflow_bundle_repair_original_workflows_spec\", current_specs)\n    _context_set(context_variables, \"workflow_bundle_repair_base_results\", current_results)\n\n    specs_by_name = {\n        _workflow_spec_name(spec): dict(spec)\n        for spec in current_specs\n        if isinstance(spec, dict) and _workflow_spec_name(spec)\n    }\n    entries_by_name = {\n        str(entry.get(\"workflow_name\") or \"\").strip(): entry\n        for entry in bundle_entries\n        if str(entry.get(\"workflow_name\") or \"\").strip()\n    }\n\n    repair_specs: list[dict[str, Any]] = []\n    for workflow_name in failed_workflows:\n        spec = dict(specs_by_name.get(workflow_name) or {})\n        if not spec:\n            entry = entries_by_name.get(workflow_name, {})\n            spec = {\n                \"name\": workflow_name,\n                \"workflow_name\": workflow_name,\n                \"task_id\": _task_id_for_entry(entry),\n                \"initial_agent\": \"WorkflowBundleBuilderAgent\",\n                \"initial_message\": f\"Regenerate the complete workflow bundle for {workflow_name}.\",\n                \"context_variables\": {},\n            }\n        spec[\"initial_agent\"] = \"WorkflowBundleBuilderAgent\"\n        spec[\"repair_attempt\"] = attempt\n        original_message = str(spec.get(\"initial_message\") or \"\").strip()\n        issue_lines = \"\\n\".join(f\"- {issue}\" for issue in workflow_issues[workflow_name])\n        spec[\"initial_message\"] = (\n            f\"{original_message}\\n\\n\"\n            \"[WORKFLOW BUNDLE REPAIR REQUEST]\\n\"\n            f\"Repair attempt: {attempt} of {max_attempts}\\n\"\n            \"The previous output failed the production quality gate. Regenerate the entire \"\n            \"workflow bundle for this workflow and fix every issue below.\\n\"\n            f\"{issue_lines}\\n\"\n        ).strip()\n        context = spec.get(\"context_variables\") if isinstance(spec.get(\"context_variables\"), dict) else {}\n        context[\"workflow_bundle_repair_attempt\"] = attempt  # type: ignore[index]\n        context[\"workflow_bundle_repair_issues\"] = workflow_issues[workflow_name]  # type: ignore[index]\n        spec[\"context_variables\"] = context\n        repair_specs.append(spec)\n\n    result = {\n        \"status\": \"needs_revision\",\n        \"repairable\": True,\n        \"failed_workflows\": failed_workflows,\n        \"attempt\": attempt,\n        \"max_attempts\": max_attempts,\n        \"repair_request\": repair_request,\n        \"repair_workflow_count\": len(repair_specs),\n    }\n    _context_set(context_variables, \"workflow_bundle_repair_status\", result[\"status\"])\n    _context_set(context_variables, \"workflow_bundle_repair_active\", True)\n    _context_set(context_variables, \"workflow_bundle_repair_count\", attempt)\n    _context_set(context_variables, \"workflow_bundle_repair_max_attempts\", max_attempts)\n    _context_set(context_variables, \"workflow_bundle_repair_failed_workflows\", failed_workflows)\n    _context_set(context_variables, \"workflow_bundle_repair_request\", repair_request)\n    _context_set(context_variables, \"workflow_bundle_repair_result\", result)\n    _context_set(context_variables, \"workflows_spec\", repair_specs)\n    return result\n\n\ndef merge_workflow_bundle_repair_results(context_variables: Any | None = None) -> dict[str, Any]:\n    \"\"\"Merge repaired task-batch outputs back into the pre-repair bundle set.\"\"\"\n\n    if _context_get(context_variables, \"workflow_bundle_repair_active\") is not True:"},{"checksum":"sha256:8a474c4aee99e058b0ab032e2d64896b56f42cee2351f30941d7026e4fd40437","chunk_id":"chunk_bb0b95912ee6546c","end_line":1075,"path":"workflows/AgentGenerator/tools/workflow_quality_gate.py","start_line":1012,"symbol_ids":[],"text":"        return {\"status\": \"skipped\", \"reason\": \"repair_not_active\"}\n    base_results = _context_get(context_variables, \"workflow_bundle_repair_base_results\")\n    repair_results = _context_get(context_variables, \"workflow_bundle_results\")\n    if not isinstance(base_results, dict) or not isinstance(repair_results, dict):\n        return {\"status\": \"skipped\", \"reason\": \"missing_repair_results\"}\n\n    repair_entries = {\n        key: value\n        for key, value in repair_results.items()\n        if isinstance(key, str) and not key.startswith(\"_\") and isinstance(value, dict)\n    }\n    repair_names = {\n        str(value.get(\"workflow_name\") or \"\").strip()\n        for value in repair_entries.values()\n        if str(value.get(\"workflow_name\") or \"\").strip()\n    }\n    merged: dict[str, Any] = {}\n    for key, value in base_results.items():\n        if not isinstance(key, str) or key.startswith(\"_\"):\n            continue\n        if not isinstance(value, dict):\n            continue\n        workflow_name = str(value.get(\"workflow_name\") or \"\").strip()\n        if key in repair_entries or workflow_name in repair_names:\n            continue\n        merged[key] = value\n    merged.update(repair_entries)\n    merged[\"_meta\"] = {\n        **(base_results.get(\"_meta\") if isinstance(base_results.get(\"_meta\"), dict) else {}),  # type: ignore[dict-item]\n        \"repair\": {\n            \"status\": \"merged\",\n            \"attempt\": _context_get(context_variables, \"workflow_bundle_repair_count\", 0),\n            \"repaired_tasks\": sorted(repair_entries),\n            \"repaired_workflows\": sorted(repair_names),\n        },\n    }\n\n    original_specs = _context_get(context_variables, \"workflow_bundle_repair_original_workflows_spec\")\n    if isinstance(original_specs, list):\n        _context_set(context_variables, \"workflows_spec\", original_specs)\n    _context_set(context_variables, \"workflow_bundle_results\", merged)\n    _context_set(context_variables, \"workflow_bundle_repair_active\", False)\n    _context_set(context_variables, \"workflow_bundle_repair_status\", \"merged\")\n    _context_set(context_variables, \"workflow_bundle_repair_merged\", True)\n    result = {\n        \"status\": \"merged\",\n        \"merged_workflow_count\": len([key for key in merged if not key.startswith(\"_\")]),\n        \"repaired_workflows\": sorted(repair_names),\n    }\n    _context_set(context_variables, \"workflow_bundle_repair_merge_result\", result)\n    return result\n\n\n__all__ = [\n    \"REQUIRED_WORKFLOW_FILES\",\n    \"expected_workflows_from_context\",\n    \"load_bundle_entries_from_root\",\n    \"merge_workflow_bundle_repair_results\",\n    \"prepare_workflow_bundle_repair\",\n    \"run_workflow_bundle_quality_gate\",\n    \"validate_agentgenerator_semantic_drift\",\n    \"validate_workflow_bundle_structure\",\n    \"workflow_bundle_entries_from_context\",\n]"},{"checksum":"sha256:bd153f48e7c3312ac14e786237e639e012bf434a1cad2ad8f2e09a84577d2645","chunk_id":"chunk_8ead24dc2b10e0fc","end_line":156,"path":"workflows/AgentGenerator/transition_graph.yaml","start_line":1,"symbol_ids":[],"text":"transition_rules:\n# The runtime compiler prioritizes conditional rules before unconditional\n# after_turn fallbacks while preserving YAML order within each group.\n- source_agent: InterviewAgent\n  target_agent: user\n  transition_type: after_turn\n  transition_target: RevertToUserTarget\n\n- source_agent: PatternAgent\n  target_agent: ProjectOverviewAgent\n  transition_type: condition\n  condition_type: context_equals\n  condition_key: pattern_selection_outcome\n  condition_value: selected\n  transition_target: AgentTarget\n\n- source_agent: PatternAgent\n  target_agent: PatternAgent\n  transition_type: condition\n  condition_type: context_equals\n  condition_key: pattern_selection_outcome\n  condition_value: invalid\n  transition_target: AgentTarget\n\n- source_agent: PatternAgent\n  target_agent: terminate\n  transition_type: condition\n  condition_type: context_equals\n  condition_key: pattern_selection_outcome\n  condition_value: blocked\n  transition_target: TerminateTarget\n  termination_reason: workflow_failed\n\n- source_agent: PatternAgent\n  target_agent: terminate\n  transition_type: after_turn\n  transition_target: TerminateTarget\n  termination_reason: workflow_failed\n\n# Conditional rules win over same-source after_turn fallbacks when their context matches.\n- source_agent: InterviewAgent\n  target_agent: PatternAgent\n  transition_type: condition\n  condition_type: context_equals\n  condition_key: interview_outcome\n  condition_value: ready\n  transition_target: AgentTarget\n\n- source_agent: user\n  target_agent: InterviewAgent\n  transition_type: condition\n  condition_type: context_equals\n  condition_key: interview_outcome\n  condition_value: needs_input\n  transition_target: AgentTarget\n\n- source_agent: ProjectOverviewAgent\n  target_agent: PackBuildCoordinator\n  transition_type: condition\n  condition_type: context_equals\n  condition_key: workflow_review_outcome\n  condition_value: approved\n  transition_target: AgentTarget\n\n- source_agent: ProjectOverviewAgent\n  target_agent: PatternAgent\n  transition_type: condition\n  condition_type: context_equals\n  condition_key: workflow_review_outcome\n  condition_value: changes_requested\n  transition_target: AgentTarget\n\n- source_agent: ProjectOverviewAgent\n  target_agent: terminate\n  transition_type: condition\n  condition_type: context_equals\n  condition_key: workflow_review_outcome\n  condition_value: no_workflows\n  transition_target: TerminateTarget\n  termination_reason: workflow_complete\n\n- source_agent: ProjectOverviewAgent\n  target_agent: terminate\n  transition_type: condition\n  condition_type: context_equals\n  condition_key: workflow_review_outcome\n  condition_value: blocked\n  transition_target: TerminateTarget\n  termination_reason: workflow_failed\n\n- source_agent: ProjectOverviewAgent\n  target_agent: terminate\n  transition_type: condition\n  condition_type: context_equals\n  condition_key: workflow_review_outcome\n  condition_value: cancelled\n  transition_target: TerminateTarget\n  termination_reason: workflow_failed\n\n- source_agent: ProjectOverviewAgent\n  target_agent: terminate\n  transition_type: after_turn\n  transition_target: TerminateTarget\n  termination_reason: workflow_failed\n\n- source_agent: PackBuildCoordinator\n  target_agent: PackMetadataAgent\n  transition_type: after_turn\n  transition_target: AgentTarget\n\n- source_agent: PackMetadataAgent\n  target_agent: DownloadAgent\n  transition_type: after_turn\n  transition_target: AgentTarget\n\n- source_agent: DownloadAgent\n  target_agent: terminate\n  transition_type: after_turn\n  transition_target: TerminateTarget\n  termination_reason: workflow_failed\n\n- source_agent: DownloadAgent\n  target_agent: PackBuildCoordinator\n  transition_type: condition\n  condition_type: context_equals\n  condition_key: workflow_bundle_export_outcome\n  condition_value: needs_revision\n  transition_target: AgentTarget\n\n- source_agent: DownloadAgent\n  target_agent: terminate\n  transition_type: condition\n  condition_type: context_equals\n  condition_key: workflow_bundle_export_outcome\n  condition_value: ready\n  transition_target: TerminateTarget\n  termination_reason: workflow_complete\n\n- source_agent: DownloadAgent\n  target_agent: terminate\n  transition_type: condition\n  condition_type: context_equals\n  condition_key: workflow_bundle_export_outcome\n  condition_value: cancelled\n  transition_target: TerminateTarget\n  termination_reason: workflow_failed\n\n- source_agent: DownloadAgent\n  target_agent: terminate\n  transition_type: condition\n  condition_type: context_equals\n  condition_key: workflow_bundle_export_outcome\n  condition_value: blocked\n  transition_target: TerminateTarget\n  termination_reason: workflow_failed\n"},{"checksum":"sha256:8efccd3e9f87483fbacc7bf0f98a5987b0d71fdb4fccee09de39fe87369456f6","chunk_id":"chunk_70cc339df065f836","end_line":169,"path":"workflows/AgentGenerator/ui/ActionPlan.js","start_line":1,"symbol_ids":["sym_7f86a9a106018c24","sym_b68228a5af0f7629","sym_803b5348263fff6e","sym_7c28901548ee8ca3","sym_155880c265fe5776"],"text":"// ============================================================================\n// FILE: ChatUI/src/workflows/AgentGenerator/components/ActionPlan.js\n// REWRITE: Accordion-based Action Plan artifact (schema: { workflow:{...}, agent_message })\n// PURPOSE: Present hierarchical workflow (stages -> agents -> tools) with robust, defensive parsing.\n// ============================================================================\n\nimport { useState, useEffect, useRef } from 'react';\nimport { ChevronDown, ChevronRight, Layers, Plug, UserCheck, Bot, Sparkles, Zap, Activity, GitBranch, Clock, Settings, Database, MousePointerClick, Compass, MessageSquare, DollarSign, ArrowRightCircle } from 'lucide-react';\nimport { createToolsLogger } from '@mozaiks/chat-ui/platform/workflowSurfaceRuntime.js';\n\n// Badge classes using --mz-* semantic tokens (v2 theme system)\nconst MZ_BADGE = {\n  primary:   'inline-flex items-center gap-2 rounded-lg border-2 border-primary/45 bg-primary/10 text-primary px-4 py-2 text-xs font-bold uppercase tracking-wide',\n  secondary: 'inline-flex items-center gap-2 rounded-lg border-2 border-secondary/45 bg-secondary/10 text-secondary-foreground px-4 py-2 text-xs font-bold uppercase tracking-wide',\n  success:   'inline-flex items-center gap-2 rounded-lg border-2 border-success/45 bg-success/10 text-success px-4 py-2 text-xs font-bold uppercase tracking-wide',\n  warning:   'inline-flex items-center gap-2 rounded-lg border-2 border-warning/45 bg-warning/10 text-warning-foreground px-4 py-2 text-xs font-bold uppercase tracking-wide',\n  neutral:   'inline-flex items-center gap-2 rounded-lg border-2 border-border bg-muted text-muted-foreground px-4 py-2 text-xs font-bold uppercase tracking-wide',\n  info:      'inline-flex items-center gap-2 rounded-lg border-2 border-primary/45 bg-primary/10 text-primary px-4 py-2 text-xs font-bold uppercase tracking-wide',\n};\n\n// Semantic model field mappings (3 orthogonal dimensions)\nconst INITIATED_BY = {\n  user: { label: 'User', desc: 'Human explicitly starts workflow', color: 'cyan' },\n  system: { label: 'System', desc: 'Platform automatically starts workflow', color: 'violet' },\n  external_event: { label: 'External Event', desc: 'External service triggers workflow', color: 'amber' },\n};\n\nconst TRIGGER_TYPE = {\n  form_submit: { label: 'Form Submit', desc: 'User submits web form', color: 'emerald' },\n  chat_start: { label: 'Chat-Based', desc: 'User initiates conversation', color: 'cyan' },\n  chatstart: { label: 'Chat-Based', desc: 'User initiates conversation', color: 'cyan' },\n  cron_schedule: { label: 'Scheduled', desc: 'Time-based trigger', color: 'violet' },\n  webhook: { label: 'Webhook', desc: 'External HTTP POST', color: 'amber' },\n  database_condition: { label: 'Database', desc: 'Database state trigger', color: 'blue' },\n};\n\nconst PATTERN_META = {\n  pipeline: { label: 'Pipeline', desc: 'Sequential handoffs across workflow stages', color: 'violet' },\n  hierarchical: { label: 'Hierarchical', desc: 'Lead agent delegates work to specialists', color: 'cyan' },\n  star: { label: 'Star', desc: 'Central coordinator distributes and gathers work', color: 'emerald' },\n  redundant: { label: 'Redundant', desc: 'Parallel agents produce overlapping outputs', color: 'amber' },\n  feedbackloop: { label: 'Feedback Loop', desc: 'Iterative refinement until acceptance', color: 'blue' },\n  escalation: { label: 'Escalation', desc: 'Progressively engages higher-tier experts', color: 'violet' },\n  contextawarerouting: { label: 'Context-Aware Routing', desc: 'Dynamically routes tasks based on context variables', color: 'cyan' },\n  coordinator: { label: 'Coordinator', desc: 'Coordinator-managed specialist consultation', color: 'emerald' },\n  triagewithtasks: { label: 'Triage with Tasks', desc: 'Intake triage followed by targeted execution tasks', color: 'amber' },\n};\n\nconst LIFECYCLE_TRIGGER_META = {\n  before_chat: { label: 'Before Chat', desc: 'Runs before the first agent turn', color: 'violet' },\n  after_chat: { label: 'After Chat', desc: 'Runs after the workflow concludes', color: 'violet' },\n  before_agent: { label: 'Before Agent', desc: 'Runs immediately before the target agent starts', color: 'cyan' },\n  after_agent: { label: 'After Agent', desc: 'Runs immediately after the target agent finishes', color: 'emerald' },\n};\n\nconst toTitle = (text) => text.replace(/_/g, ' ').replace(/\\b\\w/g, char => char.toUpperCase());\n\nconst SemanticChip = ({ value, mapping, icon: Icon = Sparkles, prefix }) => {\n  const raw = String(value || '').trim();\n  const normalized = raw.toLowerCase();\n  const canonical = normalized.replace(/[^a-z0-9]/g, '');\n  const meta = mapping[normalized] || mapping[canonical] || {\n    label: raw ? toTitle(raw) : 'Unknown',\n    desc: raw ? toTitle(raw) : 'Not specified',\n    color: 'neutral',\n  };\n  const badgeClasses = {\n    cyan:    MZ_BADGE.primary,\n    emerald: MZ_BADGE.success,\n    violet:  MZ_BADGE.secondary,\n    amber:   MZ_BADGE.warning,\n    blue:    MZ_BADGE.info,\n    neutral: MZ_BADGE.neutral,\n  };\n\n  return (\n    <span className={`${badgeClasses[meta.color] || MZ_BADGE.neutral}`} title={meta.desc}>\n      <Icon className=\"h-3.5 w-3.5\" /> {prefix}: {meta.label}\n    </span>\n  );\n};\n\nconst ToolPill = ({ tool, idx, type = 'integration' }) => {\n  const rawName = typeof tool === 'string' ? tool : tool?.name;\n  const rawPurpose = typeof tool === 'string' ? null : tool?.purpose;\n  const name = String(rawName || `Tool ${idx + 1}`);\n  const purpose = rawPurpose && String(rawPurpose).trim() ? String(rawPurpose).trim() : null;\n  const integration = tool && typeof tool === 'object' && typeof tool.integration === 'string'\n    ? tool.integration\n    : null;\n  const trigger = tool && typeof tool === 'object' && typeof tool.trigger === 'string'\n    ? tool.trigger\n    : null;\n\n  // Different colors for operations vs integrations\n  const colorScheme = type === 'operation' \n    ? {\n        border: 'border-primary/50',\n        borderHover: 'hover:border-primary',\n        bg: 'bg-primary/20',\n        ring: 'ring-primary/50',\n        iconColor: 'text-primary'\n      }\n    : {\n        border: 'border-secondary/50',\n        borderHover: 'hover:border-secondary-foreground',\n        bg: 'bg-secondary/20',\n        ring: 'ring-secondary/50',\n        iconColor: 'text-secondary-foreground'\n      };\n\n  return (\n    <div className={`group relative overflow-hidden rounded-lg border-2 ${colorScheme.border} bg-card p-3 md:p-4 transition-all ${colorScheme.borderHover} hover:bg-card hover:shadow-xl hover:shadow-secondary/20`}>\n      <div className=\"flex items-start gap-2 md:gap-3\">\n        <div className={`rounded-lg ${colorScheme.bg} p-2 md:p-2.5 ring-2 ${colorScheme.ring}`}>\n          <Plug className={`h-4 w-4 md:h-5 md:w-5 ${colorScheme.iconColor}`} />\n        </div>\n        <div className=\"flex-1 min-w-0\">\n          <p className=\"font-bold text-foreground text-sm break-words\">{name}</p>\n          {purpose && <p className=\"mt-1.5 text-xs text-muted-foreground break-words line-clamp-3\">{purpose}</p>}\n          {type === 'integration' && integration && (\n            <p className=\"mt-1 text-[0.65rem] uppercase tracking-wider text-muted-foreground break-words\">\n              Integration: <span className=\"text-foreground break-all\">{integration}</span>\n            </p>\n          )}\n          {type === 'operation' && trigger && (\n            <p className=\"mt-1 text-[0.65rem] uppercase tracking-wider text-muted-foreground break-words\">\n              Trigger: <span className=\"text-foreground break-all\">{trigger}</span>\n            </p>\n          )}\n        </div>\n      </div>\n    </div>\n  );\n};\n\nconst ToolSection = ({ title, icon: Icon = Zap, items, type = 'integration' }) => {\n  if (!Array.isArray(items) || items.length === 0) return null;\n\n  // Different colors for section headers\n  const headerColor = type === 'operation' \n    ? 'text-primary' \n    : 'text-secondary-foreground';\n\n  return (\n    <div className=\"space-y-3\">\n      <div className={`flex items-center gap-2 text-xs font-black uppercase tracking-wider ${headerColor}`}>\n        <Icon className=\"h-4 w-4\" />\n        {title}\n      </div>\n      <div className=\"grid grid-cols-1 gap-3 lg:grid-cols-2\">\n        {items.map((tool, tIdx) => {\n          const key = typeof tool === 'string'\n            ? `${title}-${tool}-${tIdx}`\n            : `${title}-${tool?.name || tIdx}-${tIdx}`;\n          return <ToolPill key={key} tool={tool} idx={tIdx} type={type} />;\n        })}\n      </div>\n    </div>\n  );\n};\n\nconst ComponentCard = ({ component, idx }) => {\n  if (!component || typeof component !== 'object') return null;\n  const label = String(component?.label || component?.tool || `component ${idx + 1}`);\n  const stageName = String(component?.stage_name || 'Stage');\n  const agentName = String(component?.agent || 'Agent');\n  const toolName = String(component?.tool || '').trim();\n  const componentName = String(component?.component || '').trim();"},{"checksum":"sha256:18c532184505b67298357514b4cc33edf53e2c0dde25b4f1f694650078eddd74","chunk_id":"chunk_9ef20aabd895e7c1","end_line":397,"path":"workflows/AgentGenerator/ui/ActionPlan.js","start_line":170,"symbol_ids":["sym_155880c265fe5776","sym_43f2ff3332a1edc2","sym_059f38d3f0c5ad9c","sym_1ea25a550303e113","sym_4e18637a04c46696","sym_3c32a15f22944dd0","sym_894df585c123ee80","sym_76fe3e264548ac61","sym_795b8fe4b4255d0b"],"text":"  const display = String(component?.display || 'inline').trim();\n  const interactionPattern = String(component?.interaction_pattern || component?.interactionPattern || '').trim();\n  const summary = component?.summary ? String(component.summary) : '';\n\n  // Color code by display type\n  const isInline = display === 'inline';\n  const borderColor = isInline ? 'border-primary/40' : 'border-secondary/40';\n  const bgColor = isInline ? 'bg-primary/5' : 'bg-secondary/5';\n  const iconBg = isInline ? 'bg-primary/20' : 'bg-secondary/20';\n  const iconRing = isInline ? 'ring-primary/40' : 'ring-secondary/40';\n  const iconColor = isInline ? 'text-primary' : 'text-secondary-foreground';\n\n  return (\n    <div className={`rounded-xl border-2 ${borderColor} ${bgColor} p-3 md:p-4`}>\n      <div className=\"flex items-start justify-between gap-2 md:gap-3\">\n        <div className=\"flex items-center gap-2 min-w-0\">\n          <div className={`rounded-lg ${iconBg} p-1.5 md:p-2 ring-2 ${iconRing}`}>\n            <MousePointerClick className={`h-3.5 w-3.5 md:h-4 md:w-4 ${iconColor}`} />\n          </div>\n          <span className=\"font-bold text-foreground text-sm break-words\">{label}</span>\n        </div>\n        <span className=\"rounded-full bg-muted px-2 md:px-3 py-0.5 md:py-1 text-[10px] md:text-xs font-semibold uppercase tracking-wide text-foreground shrink-0\">\n          {toTitle(String(interactionPattern || display).replace(/_/g, ' '))}\n        </span>\n      </div>\n      <div className=\"mt-2 md:mt-3 space-y-1 text-xs text-muted-foreground\">\n        <div className=\"break-words\">\n          <span className=\"font-semibold text-foreground\">Stage:</span> {stageName}\n        </div>\n        <div className=\"break-words\">\n          <span className=\"font-semibold text-foreground\">Agent:</span> {agentName}\n        </div>\n        {toolName && (\n          <div className=\"break-words\">\n            <span className=\"font-semibold text-foreground\">Tool:</span> {toolName}\n          </div>\n        )}\n        {componentName && (\n          <div className=\"break-words\">\n            <span className=\"font-semibold text-foreground\">Component:</span> {componentName}\n          </div>\n        )}\n      </div>\n      {summary && (\n        <p className=\"mt-2 md:mt-3 text-sm leading-relaxed text-foreground break-words line-clamp-4\">{summary}</p>\n      )}\n    </div>\n  );\n};\n\nconst normalizeStringList = (value) => (\n  Array.isArray(value)\n    ? value\n        .filter((item) => typeof item === 'string' && item.trim().length > 0)\n        .map((item) => item.trim())\n    : []\n);\n\nconst mapToolStrings = (items, purpose) =>\n  items.map((name) => ({ name, purpose }));\n\nconst normalizeLifecycleOperations = (value) => {\n  const items = [];\n  if (Array.isArray(value)) {\n    items.push(...value);\n  } else if (value && typeof value === 'object') {\n    items.push(value);\n  }\n\n  return items\n    .filter((item) => item && typeof item === 'object')\n    .map((item, idx) => {\n      const triggerCandidate = item.trigger ?? item.trigger_type ?? item.lifecycle_trigger;\n      const trigger = String(triggerCandidate || '').trim().toLowerCase();\n      const targetCandidate =\n        item.target ?? item.agent ?? item.agent_name ?? item.source_agent ?? null;\n      const descriptionSource =\n        item.description ?? item.purpose ?? item.summary ?? '';\n\n      return {\n        name: String(item.name || `Lifecycle ${idx + 1}`),\n        trigger,\n        target:\n          targetCandidate === undefined || targetCandidate === null || String(targetCandidate).trim() === ''\n            ? null\n            : String(targetCandidate).trim(),\n        description:\n          descriptionSource !== undefined && descriptionSource !== null\n            ? String(descriptionSource)\n            : '',\n      };\n    })\n    .filter((op) => op.trigger);\n};\n\nconst mergeLifecycleCollections = (...collections) => {\n  const merged = [];\n  const seen = new Set();\n\n  collections.forEach((collection) => {\n    if (!Array.isArray(collection)) return;\n    collection.forEach((op) => {\n      if (!op || typeof op !== 'object') return;\n      const trigger = String(op.trigger || '').toLowerCase();\n      const target = op.target ? String(op.target).toLowerCase() : '';\n      const name = String(op.name || '').toLowerCase();\n      const key = `${trigger}::${target}::${name}`;\n      if (seen.has(key)) return;\n      seen.add(key);\n      merged.push(op);\n    });\n  });\n\n  return merged;\n};\n\n// Lifecycle operation card component (reusable)\nconst LifecycleCard = ({ operation, idx, compact = false }) => {\n  const triggerKey = String(operation.trigger || '').toLowerCase();\n\n  return (\n    <div className={`rounded-xl border-2 border-warning/50 bg-gradient-to-br from-background/80 to-card/80 ${compact ? 'p-3' : 'p-4'}`}>\n      <div className=\"flex flex-wrap items-center justify-between gap-3\">\n        <div className=\"flex items-center gap-2\">\n          <div className=\"rounded-lg bg-warning/20 p-2 ring-2 ring-warning/50\">\n            <Activity className=\"h-4 w-4 text-warning\" />\n          </div>\n          <span className={`${compact ? 'text-sm' : 'text-base'} font-bold text-foreground`}>\n            {operation.name || `Lifecycle ${idx + 1}`}\n          </span>\n        </div>\n        <SemanticChip\n          value={triggerKey}\n          mapping={LIFECYCLE_TRIGGER_META}\n          prefix=\"\"\n          icon={Clock}\n        />\n      </div>\n      {operation.target && (\n        <div className=\"mt-2 text-xs text-muted-foreground\">\n          Target Agent: <span className=\"font-semibold text-foreground\">{operation.target}</span>\n        </div>\n      )}\n      {operation.description && !compact && (\n        <p className=\"mt-2 text-sm leading-relaxed text-foreground whitespace-pre-line\">\n          {operation.description}\n        </p>\n      )}\n    </div>\n  );\n};\n\n// Workflow-level lifecycle section (before_chat / after_chat)\nconst WorkflowLifecycleSection = ({ operations, type }) => {\n  if (!Array.isArray(operations) || operations.length === 0) return null;\n\n  const isSetup = type === 'before_chat';\n  const title = isSetup ? 'Pre-Workflow Setup' : 'Post-Workflow Cleanup';\n  const subtitle = isSetup\n    ? 'Operations executed before the first agent runs'\n    : 'Operations executed after all agents complete';\n\n  return (\n    <div className=\"space-y-4\">\n      <div className=\"flex items-center gap-3 rounded-lg bg-card px-6 py-4 border-l-4 border-warning\">\n        <Activity className=\"h-6 w-6 text-warning\" />\n        <span className=\"text-xl font-black uppercase tracking-wider text-foreground\">{title}</span>\n      </div>\n      <div className=\"rounded-2xl border-2 border-warning/50 bg-background/60 p-6\">\n        <p className=\"mb-4 text-sm text-muted-foreground\">{subtitle}</p>\n        <div className=\"grid gap-3\">\n          {operations.map((op, idx) => (\n            <LifecycleCard key={`${type}-${idx}`} operation={op} idx={idx} />\n          ))}\n        </div>\n      </div>\n    </div>\n  );\n};\n\n// Minimal inference helper: derive trigger_type from a raw trigger string when missing.\nconst inferTriggerTypeFrom = (trigger) => {\n  if (!trigger || typeof trigger !== 'string') return undefined;\n  const s = trigger.toLowerCase();\n  if (s.includes('webhook')) return 'webhook';\n  if (s.includes('cron') || s.includes('schedule')) return 'cron_schedule';\n  if (s.includes('form') || s.includes('submit')) return 'form_submit';\n  if (s.includes('chat') || s.includes('conversation') || s.includes('user_initiated')) return 'chat_start';\n  if (s.includes('db') || s.includes('database')) return 'database_condition';\n  return undefined;\n};\n\nconst AgentAccordionRow = ({ agent, index, isOpen, onToggle, agentLifecycleHooks = [] }) => {\n  const agentName = String(agent?.agent_name || agent?.name || `Agent ${index + 1}`);\n  const rawAgentTools = Array.isArray(agent?.agent_tools) ? agent.agent_tools : [];\n\n  let integrationTools = [];\n  let operationTools = [];\n\n  if (rawAgentTools.length > 0) {\n    integrationTools = [];\n    operationTools = [];\n    rawAgentTools.forEach((tool, tIdx) => {\n      if (!tool || typeof tool !== 'object') return;\n      const toolName = String(tool?.name || `Tool ${tIdx + 1}`);\n      const purpose = tool?.purpose ? String(tool.purpose) : '';\n      const integration = typeof tool?.integration === 'string' && tool.integration.trim().length\n        ? tool.integration.trim()\n        : null;\n      const entry = {\n        name: toolName,\n        purpose,\n        integration,\n      };\n      if (integration) {\n        integrationTools.push(entry);\n      } else {\n        operationTools.push(entry);\n      }\n    });\n  } else {\n    const integrationNames = normalizeStringList(agent?.integrations);\n    const operationNames = normalizeStringList(agent?.operations);\n    integrationTools = integrationNames.map(name => ({ name, purpose: '', integration: name }));\n    operationTools = mapToolStrings(operationNames, '');\n  }\n\n  const displayedToolCount = integrationTools.length + operationTools.length;"},{"checksum":"sha256:2bb4ff7a6ca54d7286045819b32fa3fa8e8fbd92bdfeb76a1948271adc7ab941","chunk_id":"chunk_81afe54f0428c5c3","end_line":609,"path":"workflows/AgentGenerator/ui/ActionPlan.js","start_line":398,"symbol_ids":["sym_795b8fe4b4255d0b","sym_1ef66a3d8375ce07","sym_874acdc51068d056","sym_d4238b8dcefd9bd5"],"text":"  const hasTools = displayedToolCount > 0;\n\n  const lifecycleTools = Array.isArray(agent?.lifecycle_tools) ? agent.lifecycle_tools : [];\n  const agentLifecycleTools = lifecycleTools\n    .filter(tool => tool && typeof tool === 'object')\n    .map((tool, tIdx) => ({\n      name: String(tool?.name || `Lifecycle ${tIdx + 1}`),\n      trigger: String(tool?.trigger || ''),\n      target: agentName,\n      description: tool?.purpose ? String(tool.purpose) : '',\n      integration: typeof tool?.integration === 'string' && tool.integration.trim().length\n        ? tool.integration.trim()\n        : null,\n    }));\n\n  const combinedLifecycleHooks = [\n    ...agentLifecycleHooks,\n    ...agentLifecycleTools,\n  ];\n  const hasLifecycleHooks = combinedLifecycleHooks.length > 0;\n\n  const systemHooks = Array.isArray(agent?.system_hooks)\n    ? agent.system_hooks\n        .filter(hook => hook && typeof hook === 'object')\n        .map((hook, hIdx) => ({\n          name: String(hook?.name || `Hook ${hIdx + 1}`),\n          purpose: hook?.purpose ? String(hook.purpose) : '',\n        }))\n    : [];\n  const hasSystemHooks = systemHooks.length > 0;\n\n  // Determine interaction type from human_interaction field\n  const humanInteraction = String(agent?.human_interaction || 'none').toLowerCase();\n  const interactionType = ['none', 'context', 'approval', 'feedback', 'single'].includes(humanInteraction) \n    ? humanInteraction \n    : 'none';\n  \n  // Visual config per interaction type\n  const interactionConfig = {\n    none: {\n      icon: Bot,\n      bgClass: 'bg-primary/20 ring-2 ring-primary/50',\n      iconColor: 'text-primary',\n      badgeClass: 'bg-muted text-foreground',\n      badgeText: 'AUTONOMOUS'\n    },\n    context: {\n      icon: UserCheck,\n      bgClass: 'bg-secondary/20 ring-2 ring-secondary/50',\n      iconColor: 'text-secondary-foreground',\n      badgeClass: 'bg-secondary text-foreground shadow-lg shadow-secondary/50',\n      badgeText: 'REQUIRES CONTEXT'\n    },\n    approval: {\n      icon: UserCheck,\n      bgClass: 'bg-warning/20 ring-2 ring-warning/50',\n      iconColor: 'text-warning',\n      badgeClass: 'bg-warning text-foreground shadow-lg shadow-warning/50',\n      badgeText: 'REQUIRES APPROVAL'\n    },\n    feedback: {\n      icon: MessageSquare,\n      bgClass: 'bg-secondary/20 ring-2 ring-secondary/50',\n      iconColor: 'text-secondary-foreground',\n      badgeClass: 'bg-secondary text-foreground shadow-lg shadow-secondary/40',\n      badgeText: 'FEEDBACK LOOP'\n    },\n    single: {\n      icon: UserCheck,\n      bgClass: 'bg-primary/20 ring-2 ring-primary/50',\n      iconColor: 'text-primary',\n      badgeClass: 'bg-muted text-foreground',\n      badgeText: 'SINGLE STEP'\n    }\n  };\n  \n  const config = interactionConfig[interactionType];\n  const Icon = config.icon;\n  \n  return (\n    <div className={`overflow-hidden rounded-xl border-2 transition-all ${isOpen ? 'border-primary bg-card shadow-xl shadow-primary/20' : 'border-border bg-card/50'}`}>\n      <button\n        onClick={onToggle}\n        className=\"flex w-full items-center gap-2 md:gap-4 p-3 md:p-5 text-left transition-colors hover:bg-muted/50 border-l-4 border-transparent hover:border-primary\"\n      >\n        <div className={`flex h-6 w-6 md:h-8 md:w-8 shrink-0 items-center justify-center rounded-full border-2 transition-all ${isOpen ? 'border-primary bg-primary/20 rotate-90' : 'border-primary bg-muted/50'}`}>\n          <ChevronRight className={`h-3 w-3 md:h-4 md:w-4 transition-transform ${isOpen ? 'text-primary' : 'text-primary'}`} />\n        </div>\n        <div className=\"flex items-center gap-2 md:gap-3 min-w-0\">\n          <div className={`rounded-lg p-2 md:p-2.5 ${config.bgClass}`}>\n            <Icon className={`h-4 w-4 md:h-5 md:w-5 ${config.iconColor}`} />\n          </div>\n          <span className=\"text-sm md:text-lg font-bold text-foreground break-words\">\n            {agentName}\n          </span>\n        </div>\n        <div className=\"ml-auto flex items-center gap-2\">\n          {interactionType !== 'none' && (\n            <span className={`rounded-lg px-3 py-1 text-xs font-bold ${config.badgeClass}`}>\n              {config.badgeText}\n            </span>\n          )}\n        </div>\n      </button>\n      {isOpen && (\n        <div className=\"space-y-4 md:space-y-5 border-t-2 border-primary/30 bg-background p-4 md:p-6 ml-2 md:ml-4\">\n          <div className=\"rounded-lg bg-card/70 p-4 border-l-4 border-primary\">\n            <p className=\"text-sm leading-relaxed text-foreground\">\n              {String(agent?.description || 'No description provided.')}\n            </p>\n          </div>\n\n          {hasLifecycleHooks && (\n            <div className=\"space-y-3\">\n              <div className=\"flex items-center gap-2 text-xs font-black uppercase tracking-wider text-warning\">\n                <Activity className=\"h-4 w-4\" />\n                Lifecycle Hooks\n              </div>\n              <div className=\"grid gap-3\">\n                {combinedLifecycleHooks.map((hook, hIdx) => (\n                  <LifecycleCard key={`agent-hook-${hIdx}`} operation={hook} idx={hIdx} compact />\n                ))}\n              </div>\n            </div>\n          )}\n\n          {hasSystemHooks && (\n            <div className=\"space-y-3\">\n              <div className=\"flex items-center gap-2 text-xs font-black uppercase tracking-wider text-secondary-foreground\">\n                <Settings className=\"h-4 w-4\" />\n                System Hooks\n              </div>\n              <div className=\"grid gap-3\">\n                {systemHooks.map((hook, hIdx) => (\n                  <div key={`system-hook-${hIdx}`} className=\"rounded-lg border-2 border-border bg-card/40 p-4\">\n                    <p className=\"text-sm font-semibold text-foreground\">{hook.name}</p>\n                    {hook.purpose && (\n                      <p className=\"mt-1 text-xs text-muted-foreground\">{hook.purpose}</p>\n                    )}\n                  </div>\n                ))}\n              </div>\n            </div>\n          )}\n\n          <div className=\"space-y-4\">\n            {integrationTools.length > 0 && (\n              <ToolSection title=\"Integrations\" icon={Plug} items={integrationTools} type=\"integration\" />\n            )}\n            {!hasTools && !hasLifecycleHooks && (\n              <div className=\"rounded-lg border-2 border-dashed border-border bg-card/30 p-6 text-center text-sm font-medium text-muted-foreground\">\n                No tools configured for this agent yet\n              </div>\n            )}\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n\nconst ModuleAccordion = ({ module, index, open, onToggle, lifecycleOperations = [] }) => {\n  const agents = Array.isArray(module?.agents) ? module.agents : [];\n  const [openAgents, setOpenAgents] = useState({});\n  const toggleAgent = (i) => setOpenAgents(prev => ({ ...prev, [i]: !prev[i] }));\n\n  // Helper to get lifecycle hooks for a specific agent\n  const getAgentLifecycleHooks = (agentName) => {\n    return lifecycleOperations.filter(op => {\n      const trigger = String(op.trigger || '').toLowerCase();\n      const target = String(op.target || '').trim();\n      return (trigger === 'before_agent' || trigger === 'after_agent') && target === agentName;\n    });\n  };\n  \n  // Count approval gates\n  const approvalCount = agents.filter(a => \n    String(a?.human_interaction || '').toLowerCase() === 'approval'\n  ).length;\n  \n  // Count context collection points\n  const contextCount = agents.filter(a => \n    String(a?.human_interaction || '').toLowerCase() === 'context'\n  ).length;\n  \n  // Monetization logic\n  const monetizationScope = String(module?.monetization_scope || 'free_trial').toLowerCase();\n  const isPaid = monetizationScope === 'paid';\n  const isFreeTrialEntry = module?.free_trial_entry === true;\n  \n  return (\n    <div className={`overflow-hidden rounded-2xl border-2 transition-all ${open ? 'border-primary bg-card shadow-2xl shadow-primary/20' : 'border-border bg-card/80 shadow-sm'}`}>\n      <button\n        onClick={onToggle}\n        className=\"flex w-full items-center gap-5 p-6 text-left transition-colors hover:bg-card\"\n      >\n        <div className={`flex h-14 w-14 shrink-0 items-center justify-center rounded-xl ${open ? 'bg-gradient-to-br from-primary to-secondary shadow-lg shadow-primary/50' : 'bg-muted'}`}>\n          {open ? (\n            <ChevronDown className=\"h-6 w-6 text-foreground\" />\n          ) : (\n            <ChevronRight className=\"h-6 w-6 text-muted-foreground\" />\n          )}\n        </div>\n        \n        <div className=\"flex flex-col gap-1\">\n            <div className=\"flex items-center gap-4\">\n              <span className=\"text-xl font-black text-foreground\">\n                {String(module?.stage_name || `Stage ${index + 1}`)}\n              </span>\n              {/* Monetization Badge */}\n              {isPaid ? (\n                 <span className=\"flex items-center gap-1.5 rounded-lg bg-warning px-2 py-0.5 text-[10px] font-black uppercase tracking-wide text-foreground shadow-sm\">"},{"checksum":"sha256:450636c91ea5d082ea4ccd152114d126f8dc6470002070bbdc16667875c57f3c","chunk_id":"chunk_3be1d8a64a7813eb","end_line":805,"path":"workflows/AgentGenerator/ui/ActionPlan.js","start_line":610,"symbol_ids":["sym_1ef66a3d8375ce07","sym_77e692a4d558506d","sym_84c0f4011fcd6388","sym_db56b82db7088e0c","sym_3187d2901bece7b1","sym_03512103d6340498","sym_825d3322cc7f0d91","sym_756f3a123ab0756b","sym_bf8ac124c647daaa","sym_de811782b12c7169","sym_f6b8038d0eb13856"],"text":"                    <DollarSign className=\"h-3 w-3\" /> PAID\n                 </span>\n              ) : (\n                 <span className=\"flex items-center gap-1.5 rounded-lg bg-success px-2 py-0.5 text-[10px] font-black uppercase tracking-wide text-foreground shadow-sm\">\n                    FREE TRIAL\n                 </span>\n              )}\n            </div>\n            {isFreeTrialEntry && (\n                <span className=\"text-xs text-success font-medium flex items-center gap-1\">\n                    <ArrowRightCircle className=\"h-3 w-3\" /> Entry Point\n                </span>\n            )}\n        </div>\n\n        <div className=\"ml-auto flex flex-col items-end gap-2 sm:gap-2\">\n          <div className=\"flex items-center gap-1.5 rounded-lg bg-card/80 px-3 py-1.5 text-[10px] sm:text-xs font-black uppercase tracking-wide text-foreground shadow-lg shadow-primary/30\">\n            <Activity className=\"h-3.5 w-3.5 text-primary\" />\n            <span className=\"text-base font-black text-foreground leading-none\">{agents.length}</span>\n            <span className=\"text-[10px] sm:text-xs text-foreground\">\n              {agents.length === 1 ? 'Agent' : 'Agents'}\n            </span>\n          </div>\n          {contextCount > 0 && (\n            <span className=\"flex items-center gap-1.5 rounded-lg bg-secondary px-3 py-1.5 text-[10px] sm:text-xs font-black uppercase tracking-wide text-foreground shadow-lg shadow-secondary/35\">\n              <UserCheck className=\"h-3.5 w-3.5 text-foreground/90\" />\n              {contextCount} Context Required\n            </span>\n          )}\n          {approvalCount > 0 && (\n            <span className=\"flex items-center gap-1.5 rounded-lg bg-warning px-3 py-1.5 text-[10px] sm:text-xs font-black uppercase tracking-wide text-foreground shadow-lg shadow-warning/35\">\n              <UserCheck className=\"h-3.5 w-3.5 text-foreground/90\" />\n              {approvalCount} Approval {approvalCount === 1 ? 'Gate' : 'Gates'}\n            </span>\n          )}\n        </div>\n      </button>\n      {open && (\n        <div className=\"space-y-4 md:space-y-6 border-t-4 border-primary/30 bg-background p-4 md:p-6\">\n          <div className=\"rounded-lg bg-card/50 p-5 border-l-4 border-primary\">\n            <p className=\"text-base leading-relaxed text-foreground\">\n              {String(module?.stage_description || 'No description provided.')}\n            </p>\n          </div>\n          <div className=\"space-y-4\">\n            <div className=\"flex items-center gap-2 text-sm font-black uppercase tracking-wider text-primary\">\n              <Bot className=\"h-5 w-5\" />\n              Agents\n            </div>\n            {agents.length > 0 ? (\n              agents.map((agent, aIdx) => {\n                const agentName = String(agent?.agent_name || agent?.name || '');\n                const agentHooks = getAgentLifecycleHooks(agentName);\n                return (\n                  <AgentAccordionRow\n                    key={aIdx}\n                    agent={agent}\n                    index={aIdx}\n                    isOpen={!!openAgents[aIdx]}\n                    onToggle={() => toggleAgent(aIdx)}\n                    agentLifecycleHooks={agentHooks}\n                  />\n                );\n              })\n            ) : (\n              <div className=\"rounded-lg border-2 border-dashed border-border bg-card/30 p-8 text-center text-sm font-medium text-muted-foreground\">\n                No agents defined in this module\n              </div>\n            )}\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n\n// Mermaid preview with bold styling and multi-diagram support (flowchart + sequence)\nconst forceFlowchartOrientation = (diagram, orientation) => {\n  if (typeof diagram !== 'string' || !diagram.trim().startsWith('flowchart')) return diagram;\n  const normalizedOrientation = orientation?.toUpperCase?.() || 'TD';\n  const directiveRegex = /^flowchart\\s+(LR|RL|TD|TB|BT)/i;\n  if (directiveRegex.test(diagram)) {\n    return diagram.replace(directiveRegex, `flowchart ${normalizedOrientation}`);\n  }\n  return diagram.replace(/^flowchart/i, `flowchart ${normalizedOrientation}`);\n};\n\nconst MermaidPreview = ({ chart, pendingMessage, pattern }) => {\n  const ref = useRef(null);\n  const [isFullscreen, setIsFullscreen] = useState(false);\n  const [isMobile, setIsMobile] = useState(false);\n  \n  useEffect(() => {\n    const checkMobile = () => {\n      setIsMobile(window.innerWidth <= 640);\n    };\n    checkMobile();\n    window.addEventListener('resize', checkMobile);\n    return () => window.removeEventListener('resize', checkMobile);\n  }, []);\n  \n  useEffect(() => {\n    if (typeof window === 'undefined') return () => {};\n\n    let disposed = false;\n    const isMobileViewport = window.matchMedia ? window.matchMedia('(max-width: 640px)').matches : false;\n    let mobileFlowchartNodeCount = 0;\n    let mobileHorizontalFlow = false;\n\n    const detectTheme = () => {\n      const root = document.documentElement;\n      const body = document.body;\n      const rootStyle = root ? window.getComputedStyle(root) : null;\n      const bodyStyle = body ? window.getComputedStyle(body) : null;\n\n      const hasDarkClass = (root?.classList?.contains('dark') || body?.classList?.contains('dark')) ?? false;\n      const dataTheme = (root?.dataset?.theme || root?.getAttribute('data-theme') || body?.dataset?.theme || body?.getAttribute('data-theme') || '').toLowerCase();\n      const declaredScheme = (rootStyle?.colorScheme || bodyStyle?.colorScheme || '').toLowerCase();\n      const mediaPrefersDark = window.matchMedia ? window.matchMedia('(prefers-color-scheme: dark)').matches : false;\n\n      const isDark = Boolean(hasDarkClass || dataTheme.includes('dark') || declaredScheme.includes('dark') || mediaPrefersDark);\n\n      const pickVar = (name, fallback) => {\n        const val = rootStyle?.getPropertyValue(name) || bodyStyle?.getPropertyValue(name);\n        return val && val.trim().length ? val.trim() : fallback;\n      };\n\n      const palette = {\n        text: pickVar('--color-text-primary', isDark ? '#e2e8f0' : '#1f2937'),\n        textSecondary: pickVar('--color-text-secondary', isDark ? '#cbd5f5' : '#4b5563'),\n        surface: pickVar('--color-surface', isDark ? '#0f172a' : '#ffffff'),\n        surfaceAlt: pickVar('--color-surface-alt', isDark ? '#131d33' : '#f9fafb'),\n        note: pickVar('--color-surface-overlay', isDark ? '#1e293b' : '#f3f4f6'),\n        border: pickVar('--color-border-subtle', isDark ? '#334155' : '#d1d5db'),\n        primary: pickVar('--color-primary', '#3b82f6'),\n        primaryLight: pickVar('--color-primary-light', '#60a5fa'),\n        secondary: pickVar('--color-secondary', '#8b5cf6'),\n        accent: pickVar('--color-accent', '#10b981')\n      };\n\n      return { isDark, palette };\n    };\n\n    const shouldOverrideFill = (fill, isDark) => {\n      if (!fill) return true;\n      const normalized = fill.trim().toLowerCase();\n      const alwaysOverride = ['none', 'transparent', '#fff', '#ffffff', 'white'];\n      if (alwaysOverride.includes(normalized)) return true;\n      if (!isDark) return false;\n      const softLights = ['#edf2ae', '#fefce8', '#f5f5f5', '#eaeaea', '#f9fafb'];\n      if (softLights.includes(normalized)) return true;\n      const hexMatch = normalized.match(/^#([0-9a-f]{6})$/i);\n      if (hexMatch) {\n        const hex = hexMatch[1];\n        const r = parseInt(hex.slice(0, 2), 16);\n        const g = parseInt(hex.slice(2, 4), 16);\n        const b = parseInt(hex.slice(4, 6), 16);\n        const brightness = (r * 299 + g * 587 + b * 114) / 1000;\n        return brightness > 180; // treat bright colors as needing override in dark mode\n      }\n      return false;\n    };\n\n    const applyFill = (el, fill, stroke) => {\n      if (!el) return;\n      if (fill) {\n        el.setAttribute('fill', fill);\n        el.style.fill = fill;\n      }\n      if (stroke) {\n        el.setAttribute('stroke', stroke);\n        el.style.stroke = stroke;\n      }\n    };\n\n    const renderDiagram = async () => {\n      if (disposed) return;\n\n      const hasChart = typeof chart === 'string' && chart.trim().length > 0;\n      if (!hasChart) {\n        if (!ref.current) return;\n        const safeMessage = typeof pendingMessage === 'string' && pendingMessage.trim().length > 0\n          ? pendingMessage.trim()\n          : 'Approve the plan to generate a Mermaid sequence diagram.';\n        ref.current.innerHTML = `<div class=\"flex h-full items-center justify-center p-6 text-center text-sm text-muted-foreground\">${safeMessage}</div>`;\n        return;\n      }\n\n      let normalized = chart.trim();\n      const isSequence = normalized.startsWith('sequenceDiagram');\n      if (isSequence) {\n        // Guarantee a newline after the header\n        normalized = normalized.replace(/^sequenceDiagram(\\s*)/i, 'sequenceDiagram\\n');\n      }\n      const normalizeLineEndings = (s) => s.replace(/\\r\\n/g, '\\n').replace(/\\r/g, '\\n');\n      const sanitizeSequence = (s) => {"},{"checksum":"sha256:71cc1a009d8da199281abd209cb898e24625f9a4287190263ef9b7a94763bd2b","chunk_id":"chunk_57a364f00f6db6cc","end_line":1025,"path":"workflows/AgentGenerator/ui/ActionPlan.js","start_line":806,"symbol_ids":["sym_84c0f4011fcd6388","sym_bf8ac124c647daaa","sym_f6b8038d0eb13856","sym_09496679991f1330","sym_e28695840f3a2490"],"text":"        // Backend _fix_mermaid_syntax now handles all sanitization including legend stripping\n        // Frontend only normalizes line endings for consistent rendering across operating systems\n        return normalizeLineEndings(s);\n      };\n      if (isSequence) {\n        normalized = sanitizeSequence(normalized);\n      }\n      const isFlowchart = normalized.startsWith('flowchart');\n\n      if (!isSequence && isFlowchart) {\n        const isLR = normalized.startsWith('flowchart LR');\n        const nodeMatches = normalized.match(/\\w+[[(]/g);\n        const nodeCount = nodeMatches ? nodeMatches.length : 0;\n        mobileFlowchartNodeCount = nodeCount;\n        console.log('\ud83c\udfa8 [MermaidPreview] Analyzing flowchart:', { isLR, nodeCount, mobileViewport: isMobileViewport });\n        if (isMobileViewport) {\n          normalized = forceFlowchartOrientation(normalized, 'LR');\n          mobileHorizontalFlow = true;\n        } else if (isLR && nodeCount > 5) {\n          normalized = normalized.replace('flowchart LR', 'flowchart TD');\n          console.log('\ud83c\udfa8 [MermaidPreview] Converted LR to TD for better layout (nodeCount:', nodeCount, ')');\n        }\n      }\n\n      if (!isSequence && !isFlowchart) {\n        normalized = 'flowchart TD\\n' + normalized;\n      }\n\n      const themeState = detectTheme();\n\n      const safeRender = () => {\n        try {\n          const id = `diag-${Math.random().toString(36).slice(2)}`;\n          const { isDark, palette } = themeState;\n\n          const mermaidConfig = {\n            startOnLoad: false,\n            theme: isDark ? 'dark' : 'neutral',\n            flowchart: {\n              htmlLabels: true,\n              curve: 'basis',\n              padding: isMobileViewport ? 10 : 20,\n              nodeSpacing: isMobileViewport ? 60 : 80,\n              rankSpacing: isMobileViewport ? 60 : 80,\n              useMaxWidth: true,\n              wrappingWidth: isMobileViewport ? 150 : 200\n            },\n            sequence: {\n              diagramMarginX: isMobileViewport ? 10 : 20,\n              diagramMarginY: isMobileViewport ? 10 : 20,\n              actorMargin: isMobileViewport ? 50 : 80,\n              width: isMobileViewport ? 150 : 200,\n              height: isMobileViewport ? 50 : 65,\n              boxMargin: isMobileViewport ? 5 : 10,\n              boxTextMargin: isMobileViewport ? 3 : 5,\n              noteMargin: isMobileViewport ? 5 : 10,\n              messageMargin: isMobileViewport ? 35 : 50,\n              mirrorActors: !isMobileViewport,\n              useMaxWidth: true,\n              wrap: true,\n              wrapPadding: isMobileViewport ? 5 : 10\n            },\n            themeVariables: {\n              primaryColor: palette.primary,\n              primaryTextColor: palette.text,\n              primaryBorderColor: palette.primaryLight,\n              lineColor: palette.border,\n              secondaryColor: palette.secondary,\n              tertiaryColor: palette.accent,\n              noteBkgColor: palette.note,\n              noteTextColor: palette.text,\n              noteBorderColor: palette.border,\n              activationBkgColor: isDark ? palette.secondary : palette.surfaceAlt,\n              activationBorderColor: palette.primaryLight,\n              sequenceNumberColor: palette.text,\n              fontSize: '16px',\n              fontFamily: 'ui-sans-serif, system-ui, sans-serif'\n            }\n          };\n\n          window.mermaid.initialize(mermaidConfig);\n\n          window.mermaid.render(id, normalized).then(({ svg }) => {\n            if (!ref.current || disposed) return;\n            ref.current.innerHTML = svg;\n            const svgEl = ref.current.querySelector('svg');\n            if (!svgEl) return;\n\n            svgEl.style.maxWidth = '100%';\n            svgEl.style.height = 'auto';\n\n            // Mobile-optimized heights\n            if (isMobileViewport) {\n              svgEl.style.minHeight = isSequence ? '350px' : '300px';\n            } else {\n              svgEl.style.minHeight = isSequence ? '500px' : '400px';\n            }\n\n            // Mobile flowchart handling with better UX\n            if (mobileHorizontalFlow && !isSequence) {\n              const minWidth = Math.min(1200, Math.max(600, mobileFlowchartNodeCount * 110));\n              svgEl.style.minWidth = `${minWidth}px`;\n              ref.current.style.overflowX = 'auto';\n              ref.current.style.overflowY = 'hidden';\n              // Add scroll shadow indicator\n              ref.current.style.background = 'linear-gradient(90deg, rgba(15, 23, 42, 0) 0%, rgba(15, 23, 42, 0.05) 5%, rgba(15, 23, 42, 0.05) 95%, rgba(15, 23, 42, 0) 100%)';\n              // Smooth scrolling\n              ref.current.style.scrollBehavior = 'smooth';\n              ref.current.style.webkitOverflowScrolling = 'touch';\n            } else {\n              svgEl.style.minWidth = '';\n              ref.current.style.overflowX = '';\n              ref.current.style.overflowY = '';\n              ref.current.style.background = '';\n            }\n            svgEl.style.colorScheme = isDark ? 'dark' : 'light';\n            svgEl.style.background = palette.surfaceAlt;\n            ref.current.style.background = palette.surface;\n\n            console.log('\ud83c\udfa8 [MermaidPreview] SVG Color Mode:', {\n              dark: isDark,\n              text: palette.text,\n              note: palette.note,\n              surface: palette.surface,\n              surfaceAlt: palette.surfaceAlt\n            });\n\n            const textElements = svgEl.querySelectorAll('text, tspan, .messageText, .labelText, .actor');\n            textElements.forEach((el) => applyFill(el, palette.text));\n\n            const noteRects = svgEl.querySelectorAll('rect.note, .noteBox');\n            noteRects.forEach((el) => applyFill(el, palette.note, palette.border));\n\n            const actorRects = svgEl.querySelectorAll('rect.actor, .actor-box');\n            actorRects.forEach((el) => {\n              if (isDark || shouldOverrideFill(el.getAttribute('fill'), isDark)) {\n                applyFill(el, palette.surface, palette.border);\n              }\n            });\n\n            const otherRects = svgEl.querySelectorAll('rect:not(.note):not(.noteBox):not(.actor):not(.actor-box)');\n            otherRects.forEach((el) => {\n              if (shouldOverrideFill(el.getAttribute('fill'), isDark)) {\n                applyFill(el, palette.surfaceAlt, palette.border);\n              }\n            });\n          }).catch((err) => {\n            console.error('\ud83c\udfa8 [MermaidPreview] Render error:', err);\n            if (ref.current && !disposed) {\n              ref.current.innerHTML = '<div class=\"flex items-center justify-center h-full text-sm text-destructive\">Diagram render error</div>';\n            }\n          });\n        } catch (err) {\n          console.error('\ud83c\udfa8 [MermaidPreview] Render exception:', err);\n          if (ref.current && !disposed) {\n            ref.current.innerHTML = '<div class=\"flex items-center justify-center h-full text-sm text-destructive\">Diagram render error</div>';\n          }\n        }\n      };\n\n      if (!window.mermaid) {\n        const script = document.createElement('script');\n        script.src = 'https://cdnjs.cloudflare.com/ajax/libs/mermaid/10.6.1/mermaid.min.js';\n        script.onload = () => !disposed && safeRender();\n        script.onerror = () => {\n          console.error('\ud83c\udfa8 [MermaidPreview] Failed to load Mermaid.js');\n          if (ref.current && !disposed) {\n            ref.current.innerHTML = '<div class=\"flex items-center justify-center h-full text-sm text-destructive\">Failed to load diagram library</div>';\n          }\n        };\n        document.head.appendChild(script);\n      } else {\n        safeRender();\n      }\n    };\n\n    renderDiagram();\n\n    const handleThemeChange = () => {\n      if (!disposed) {\n        renderDiagram();\n      }\n    };\n\n    let mql;\n    if (window.matchMedia) {\n      mql = window.matchMedia('(prefers-color-scheme: dark)');\n      mql.addEventListener('change', handleThemeChange);\n    }\n\n    let observer;\n    if (window.MutationObserver) {\n      observer = new MutationObserver(handleThemeChange);\n      try {\n        observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class', 'data-theme'] });\n        if (document.body) {\n          observer.observe(document.body, { attributes: true, attributeFilter: ['class', 'data-theme'] });\n        }\n      } catch {}\n    }\n\n    return () => {\n      disposed = true;\n      if (mql) {\n        try {\n          mql.removeEventListener('change', handleThemeChange);\n        } catch {\n          mql.removeListener(handleThemeChange);\n        }\n      }\n      observer?.disconnect();\n    };\n  }, [chart, pendingMessage]);\n  \n  const hasChart = typeof chart === 'string' && chart.trim().length > 0;\n  const isLandscape = typeof window !== 'undefined' && window.innerWidth > window.innerHeight;\n  \n  if (isMobile && !isFullscreen) {\n    return (\n      <div className={`border-2 border-primary bg-card overflow-hidden rounded-2xl`}>"},{"checksum":"sha256:87129384018d91ed048ac8f90a2e2cca87f664f463a1e7c32f946d2ad700acda","chunk_id":"chunk_d54e674b4cf4826a","end_line":1217,"path":"workflows/AgentGenerator/ui/ActionPlan.js","start_line":1026,"symbol_ids":["sym_84c0f4011fcd6388","sym_116fdd7db965cbaa","sym_849a94df3397eef9","sym_5355a576564f7481","sym_f95bc830a87455f1"],"text":"        <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 sm:gap-0 border-b-2 border-secondary/50 bg-gradient-to-r from-secondary/80 to-secondary px-4 md:px-6 py-3 md:py-4\">\n          <div className=\"flex items-center gap-2 md:gap-3 text-sm md:text-base font-black uppercase tracking-wider text-foreground\">\n            <GitBranch className=\"h-4 w-4 md:h-5 md:w-5\" />\n            Workflow Diagram\n          </div>\n          {pattern && (\n            <SemanticChip value={pattern} mapping={PATTERN_META} prefix=\"Pattern\" icon={GitBranch} />\n          )}\n        </div>\n        <div className=\"flex flex-col items-center justify-center gap-4 bg-background p-8 min-h-[200px]\">\n          {hasChart ? (\n            <>\n              <GitBranch className=\"h-12 w-12 text-secondary-foreground\" />\n              <p className=\"text-sm text-muted-foreground text-center\">\n                View the full workflow diagram in landscape mode for the best experience\n              </p>\n              <button\n                onClick={() => setIsFullscreen(true)}\n                className=\"flex items-center gap-2 rounded-lg bg-gradient-to-r from-primary to-secondary px-6 py-3 text-sm font-bold text-foreground shadow-lg hover:shadow-xl transition-all\"\n              >\n                <GitBranch className=\"h-4 w-4\" />\n                View Flow Diagram\n              </button>\n            </>\n          ) : (\n            <p className=\"text-sm text-muted-foreground text-center\">\n              {typeof pendingMessage === 'string' && pendingMessage.trim().length > 0\n                ? pendingMessage.trim()\n                : 'Approve the plan to generate a Mermaid sequence diagram.'}\n            </p>\n          )}\n        </div>\n      </div>\n    );\n  }\n  \n  if (isFullscreen) {\n    return (\n      <div className=\"fixed inset-0 z-50 bg-background flex flex-col\">\n        {/* Header with close button */}\n        <div className=\"flex items-center justify-between gap-4 border-b-2 border-secondary/50 bg-gradient-to-r from-secondary/80 to-secondary px-4 py-3\">\n          <div className=\"flex items-center gap-2 text-sm font-black uppercase tracking-wider text-foreground\">\n            <GitBranch className=\"h-4 w-4\" />\n            Workflow Diagram\n          </div>\n          <button\n            onClick={() => setIsFullscreen(false)}\n            className=\"flex items-center gap-2 rounded-lg bg-muted hover:bg-muted px-3 py-2 text-sm font-bold text-foreground transition-colors\"\n          >\n            <ChevronDown className=\"h-4 w-4\" />\n            Close\n          </button>\n        </div>\n        \n        {/* Landscape hint for portrait mode */}\n        {!isLandscape && (\n          <div className=\"flex items-center gap-3 bg-warning/20 border-b-2 border-warning/50 px-4 py-3\">\n            <div className=\"animate-pulse\">\n              <svg className=\"h-6 w-6 text-warning\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z\" />\n                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M9 9l3 3m0 0l3-3m-3 3V3\" transform=\"rotate(90 12 12)\" />\n              </svg>\n            </div>\n            <p className=\"text-xs font-semibold text-warning-foreground\">\n              Rotate your device to landscape mode for better viewing\n            </p>\n          </div>\n        )}\n        \n        {/* Diagram content */}\n        <div className=\"flex-1 overflow-auto bg-background\">\n          <div ref={ref} className=\"min-h-full p-4\" />\n        </div>\n      </div>\n    );\n  }\n  \n  return (\n    <div className={`border-2 border-primary bg-card overflow-hidden rounded-2xl`}>\n      <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 sm:gap-0 border-b-2 border-secondary/50 bg-gradient-to-r from-secondary/80 to-secondary px-4 md:px-6 py-3 md:py-4\">\n        <div className=\"flex items-center gap-2 md:gap-3 text-sm md:text-base font-black uppercase tracking-wider text-foreground\">\n          <GitBranch className=\"h-4 w-4 md:h-5 md:w-5\" />\n          Workflow Diagram\n        </div>\n        {pattern && (\n          <SemanticChip value={pattern} mapping={PATTERN_META} prefix=\"Pattern\" icon={GitBranch} />\n        )}\n      </div>\n      <div ref={ref} className=\"min-h-[300px] md:min-h-[400px] overflow-auto bg-background p-4 md:p-8\" />\n    </div>\n  );\n};\n\n// Data View - Connection status and context variables\nconst DataView = ({ workflow, contextVariableDefinitions }) => {\n  const definitions = contextVariableDefinitions || {};\n  const databaseCapability = workflow?.database_capability || {};\n  const schemaProvided = Boolean(workflow?.database_schema);\n  const [expandedCollections, setExpandedCollections] = useState({});\n  const [carouselIndex, setCarouselIndex] = useState(0);\n  const mobileCarouselRef = useRef(null);\n  const schemaCollections = Array.isArray(workflow?.database_schema?.collections)\n    ? workflow.database_schema.collections\n    : [];\n  const sortedCollections = schemaCollections.slice().sort((a, b) => {\n    const left = String(a?.name || '').toLowerCase();\n    const right = String(b?.name || '').toLowerCase();\n    if (left < right) return -1;\n    if (left > right) return 1;\n    return 0;\n  });\n  const toggleCollection = (key) => {\n    setExpandedCollections((prev) => ({ ...prev, [key]: !prev[key] }));\n  };\n  useEffect(() => {\n    const node = mobileCarouselRef.current;\n    if (!node) return undefined;\n    const handleScroll = () => {\n      const child = node.firstElementChild;\n      if (!child) return;\n      const cardWidth = child.getBoundingClientRect().width || 1;\n      const idx = Math.round(node.scrollLeft / cardWidth);\n      const bounded = Math.min(Math.max(idx, 0), Math.max(sortedCollections.length - 1, 0));\n      if (bounded !== carouselIndex) {\n        setCarouselIndex(bounded);\n      }\n    };\n    node.addEventListener('scroll', handleScroll, { passive: true });\n    return () => node.removeEventListener('scroll', handleScroll);\n  }, [sortedCollections.length, carouselIndex]);\n\n  useEffect(() => {\n    setCarouselIndex(0);\n  }, [sortedCollections.length]);\n  \n  // Group variables by source type (six-type taxonomy)\n  const variablesByType = {\n    config: [],           // Environment variables and static defaults\n    data_reference: [],   // Read-only MongoDB queries\n    data_entity: [],      // Workflow-owned writes\n    computed: [],         // Deterministic derivations\n    state: [],            // Mutable orchestration state\n    external: []          // Third-party API fetches\n  };\n  \n  Object.entries(definitions).forEach(([name, def]) => {\n    const type = def?.source?.type || def?.type || 'computed';\n    if (variablesByType[type]) {\n      variablesByType[type].push({ name, ...def });\n    }\n  });\n  \n  // Check for database configuration\n  const hasDatabaseVars = variablesByType.data_reference.length > 0 || \n                          variablesByType.data_entity.length > 0;\n  const hasRuntimeVars = variablesByType.computed.length > 0 || \n                         variablesByType.state.length > 0;\n  const hasSystemVars = variablesByType.config.length > 0;\n  \n  // Check context-aware status (would come from environment/config)\n  const contextAwareEnabled = Boolean(databaseCapability.enabled || schemaProvided || hasDatabaseVars);\n  \n  // Extract unique database collections from data_reference and data_entity variables\n  const databaseCollections = new Set();\n  [...variablesByType.data_reference, ...variablesByType.data_entity].forEach(variable => {\n    const collection = variable?.source?.collection || variable?.collection;\n    if (collection && typeof collection === 'string') {\n      databaseCollections.add(collection);\n    }\n  });\n\n  const renderCollectionCard = (collection, idx, variant = 'grid') => {\n    const cardKey = `${collection?.name || 'collection'}-${idx}`;\n    const isExpanded = !!expandedCollections[cardKey];\n    const fields = Array.isArray(collection?.fields) ? collection.fields : [];\n    const previewFields = fields.slice(0, 3);\n    const previewOverflow = fields.length - previewFields.length;\n    const sampleKeys = Array.isArray(collection?.sample_doc_keys) ? collection.sample_doc_keys : [];\n    const containerBase = 'rounded-2xl border border-primary/40 bg-background/60 p-4 shadow-[0_10px_30px_rgba(15,23,42,0.35)] transition-all duration-300';\n    const variantClasses = variant === 'mobile'\n      ? 'min-w-[82vw] snap-center mr-2'\n      : '';\n\n    return (\n      <div key={cardKey} className={`${containerBase} ${variantClasses}`}>\n        <button\n          type=\"button\"\n          onClick={() => toggleCollection(cardKey)}\n          className=\"flex w-full items-center justify-between gap-3 text-left\"\n          aria-expanded={isExpanded}\n        >\n          <div>"},{"checksum":"sha256:743f40438d2a87736a996feb026336e75ca8e38d637012b9815460a84ba83516","chunk_id":"chunk_896b3913893e56a6","end_line":1401,"path":"workflows/AgentGenerator/ui/ActionPlan.js","start_line":1218,"symbol_ids":["sym_116fdd7db965cbaa","sym_f95bc830a87455f1"],"text":"            <p className=\"text-base font-bold text-primary\">{collection?.name || `Collection ${idx + 1}`}</p>\n            <div className=\"mt-1 flex flex-wrap gap-2 text-[0.65rem] uppercase tracking-widest text-muted-foreground\">\n              <span>{fields.length} Fields</span>\n                {collection?.is_app && (\n                  <span className=\"rounded-full bg-secondary/20 px-2 py-0.5 text-secondary-foreground\">\n                  App\n                </span>\n              )}\n              {collection?.has_sample_data && (\n                <span className=\"rounded-full bg-emerald-500/20 px-2 py-0.5 text-emerald-200\">\n                  Sample Data\n                </span>\n              )}\n            </div>\n          </div>\n          <div className={`rounded-full border border-primary/50 p-1 ${isExpanded ? 'rotate-180' : ''}`}>\n            <ChevronDown className=\"h-4 w-4 text-primary\" />\n          </div>\n        </button>\n        {!isExpanded && previewFields.length > 0 && (\n          <div className=\"mt-3 flex flex-wrap gap-1 text-xs\">\n            {previewFields.map((field, fieldIdx) => (\n              <span\n                key={`${cardKey}-preview-${field?.name || fieldIdx}`}\n                className=\"rounded-full bg-card/80 px-2 py-1 text-foreground\"\n              >\n                {field?.name || 'field'}\n              </span>\n            ))}\n            {previewOverflow > 0 && (\n              <span className=\"text-muted-foreground\">+{previewOverflow} more</span>\n            )}\n          </div>\n        )}\n        <div className={`overflow-hidden transition-all duration-300 ${isExpanded ? 'max-h-[460px] opacity-100 mt-4' : 'max-h-0 opacity-0'}`}>\n          {fields.length > 0 && (\n            <div className=\"space-y-2\">\n              <div className=\"text-xs font-semibold text-muted-foreground uppercase tracking-wider\">\n                Field Definitions\n              </div>\n              <div className=\"max-h-64 overflow-y-auto space-y-1 pr-1\">\n                {fields.map((field, fieldIdx) => (\n                  <div\n                    key={`${cardKey}-field-${field?.name || fieldIdx}`}\n                    className=\"flex items-center justify-between gap-2 rounded-lg border border-border/70 bg-background/80 px-2 py-1 text-xs\"\n                  >\n                    <span className=\"font-mono text-foreground\">{field?.name || 'field'}</span>\n                    <span className=\"text-muted-foreground\">{field?.type || 'unknown'}</span>\n                  </div>\n                ))}\n              </div>\n            </div>\n          )}\n          {collection?.has_sample_data && sampleKeys.length > 0 && (\n            <div className=\"mt-3\">\n              <div className=\"text-xs font-semibold text-muted-foreground uppercase tracking-wider\">\n                Sample Keys\n              </div>\n              <div className=\"mt-1 flex flex-wrap gap-1 text-xs text-muted-foreground\">\n                {sampleKeys.map((key, sampleIdx) => (\n                  <span key={`${cardKey}-sample-${sampleIdx}`} className=\"rounded border border-border px-2 py-0.5\">\n                    {key}\n                  </span>\n                ))}\n              </div>\n            </div>\n          )}\n        </div>\n      </div>\n    );\n  };\n  \n  return (\n    <div className=\"space-y-6\">\n      {/* Connection Status Overview */}\n      <div className=\"rounded-xl border-2 border-primary/50 bg-gradient-to-br from-background/80 to-card/80 p-6 min-h-[200px] flex flex-col\">\n        <div className=\"flex items-start gap-4 mb-6\">\n          <div className={`rounded-lg p-3 ring-2 ${\n            contextAwareEnabled \n              ? 'bg-success/30 ring-success/50' \n              : 'bg-warning/30 ring-warning/50'\n          }`}>\n            <Database className={`h-6 w-6 ${contextAwareEnabled ? 'text-success' : 'text-warning'}`} />\n          </div>\n          <div className=\"flex-1\">\n            <div className=\"flex items-center gap-3 mb-2\">\n              <h3 className=\"text-xl font-black text-foreground\">Connection Status</h3>\n              <span className={`rounded-full px-3 py-1 text-xs font-bold uppercase tracking-wider ${\n                contextAwareEnabled\n                  ? 'bg-success/20 border-2 border-success/50 text-success'\n                  : 'bg-warning/20 border-2 border-warning/50 text-warning'\n              }`}>\n                {contextAwareEnabled ? 'Connected' : 'Not Connected'}\n              </span>\n            </div>\n            {!contextAwareEnabled && (\n              <p className=\"text-sm text-muted-foreground mt-2\">\n                Configure your MongoDB URL in settings to enable context-aware features\n              </p>\n            )}\n          </div>\n        </div>\n        \n        {/* Database Schema Info */}\n        {contextAwareEnabled && workflow?.database_schema && (\n          <div className=\"mb-4\">\n            <div className=\"flex items-center gap-2 mb-3\">\n              <span className=\"text-xs font-black uppercase tracking-widest text-muted-foreground\">\n                Database: {databaseCapability.database_name || workflow.database_schema.database_name || 'Unknown'}\n              </span>\n              <span className=\"rounded-full bg-primary/20 border border-primary/50 px-2 py-0.5 text-xs font-bold text-primary\">\n                {databaseCapability.collections_reported || workflow.database_schema.total_collections || workflow.database_schema.collections?.length || 0} Collections\n              </span>\n            </div>\n            \n            {/* Collections List */}\n            {sortedCollections.length > 0 && (\n              <div className=\"space-y-4\">\n                <div className=\"flex items-center justify-between gap-2 flex-wrap\">\n                  <div className=\"text-xs font-black uppercase tracking-widest text-muted-foreground\">\n                    Collections ({sortedCollections.length})\n                  </div>\n                  {sortedCollections.length > 3 && (\n                    <button\n                      type=\"button\"\n                      onClick={() => setExpandedCollections({})}\n                      className=\"text-[0.65rem] font-semibold uppercase tracking-widest text-primary hover:text-primary-foreground\"\n                    >\n                      Collapse All\n                    </button>\n                  )}\n                </div>\n\n                {/* Mobile Carousel */}\n                <div className=\"md:hidden\">\n                  <div\n                    ref={mobileCarouselRef}\n                    className=\"flex snap-x snap-mandatory gap-4 overflow-x-auto pb-4\"\n                  >\n                    {sortedCollections.map((collection, idx) => renderCollectionCard(collection, idx, 'mobile'))}\n                  </div>\n                  {sortedCollections.length > 1 && (\n                    <div className=\"flex justify-center gap-1\">\n                      {sortedCollections.map((_, dotIdx) => (\n                        <span\n                          key={`collections-dot-${dotIdx}`}\n                          className={`h-1.5 rounded-full transition-all ${dotIdx === carouselIndex ? 'w-4 bg-primary' : 'w-2 bg-muted'}`}\n                        />\n                      ))}\n                    </div>\n                  )}\n                </div>\n\n                {/* Desktop Grid */}\n                <div className=\"hidden md:grid gap-3 md:grid-cols-2\">\n                  {sortedCollections.map((collection, idx) => renderCollectionCard(collection, idx))}\n                </div>\n              </div>\n            )}\n          </div>\n        )}\n        \n        {/* Database Variables Cards */}\n        {contextAwareEnabled && hasDatabaseVars && (\n          <div className=\"flex-1\">\n            <div className=\"text-xs font-black uppercase tracking-widest text-muted-foreground mb-3\">\n              Database Variables\n            </div>\n            <div className=\"space-y-2\">\n              {[...variablesByType.data_reference, ...variablesByType.data_entity].map((variable, idx) => (\n                <div key={idx} className=\"rounded-lg border border-border bg-card/70 p-3\">\n                  <div className=\"flex items-start justify-between gap-3\">\n                    <div className=\"flex-1\">\n                      <div className=\"flex items-center gap-2 mb-1\">\n                        <span className=\"font-bold text-primary\">{variable.name}</span>\n                        <span className=\"rounded-full bg-primary/20 border border-primary/50 px-2 py-0.5 text-xs font-semibold text-primary\">\n                          {variable.source?.type === 'data_entity' ? 'Write' : 'Query'}\n                        </span>\n                      </div>\n                      {variable.purpose && (\n                        <p className=\"text-xs text-muted-foreground mb-2\">{variable.purpose}</p>\n                      )}\n                      {variable.trigger_hint && (\n                        <p className=\"text-xs text-muted-foreground\">"},{"checksum":"sha256:46cc2ebc0380016b5b248067b72e1862ec2deab75fef29cc726a474aca7e57f9","chunk_id":"chunk_73eb0ef30402916b","end_line":1601,"path":"workflows/AgentGenerator/ui/ActionPlan.js","start_line":1402,"symbol_ids":["sym_116fdd7db965cbaa","sym_3c28b5fc9e614d76"],"text":"                          <span className=\"text-muted-foreground\">Source:</span> {variable.trigger_hint}\n                        </p>\n                      )}\n                    </div>\n                  </div>\n                </div>\n              ))}\n            </div>\n          </div>\n        )}\n      </div>\n      \n      {/* System Variables Section */}\n      {hasSystemVars && (\n        <div className=\"rounded-xl border-2 border-secondary/40 bg-card/50 p-6 min-h-[200px] flex flex-col\">\n          <div className=\"flex items-center gap-2 mb-4\">\n            <Settings className=\"h-5 w-5 text-secondary-foreground\" />\n            <span className=\"text-sm font-bold uppercase tracking-wider text-secondary-foreground\">\n              System Configuration\n            </span>\n            <span className=\"rounded-full bg-secondary px-2 py-0.5 text-xs font-bold text-foreground\">\n              {variablesByType.config.length}\n            </span>\n          </div>\n          <p className=\"text-xs text-muted-foreground mb-4\">\n            Pre-configured values loaded from environment or workflow definition\n          </p>\n          <div className=\"grid gap-3 md:grid-cols-2 flex-1\">\n            {variablesByType.config.map((variable, idx) => (\n              <div key={idx} className=\"rounded-lg border border-border bg-card/70 p-3 h-fit\">\n                <div className=\"flex items-start justify-between gap-2 mb-2\">\n                  <span className=\"font-bold text-foreground text-sm\">{variable.name}</span>\n                  <span className=\"rounded-full bg-success/20 border border-success/50 px-2 py-0.5 text-xs font-semibold text-success\">\n                    CONFIG\n                  </span>\n                </div>\n                {variable.purpose && (\n                  <p className=\"text-xs text-muted-foreground\">{variable.purpose}</p>\n                )}\n              </div>\n            ))}\n          </div>\n        </div>\n      )}\n      \n      {/* Runtime Variables Section */}\n      {hasRuntimeVars && (\n        <div className=\"rounded-xl border-2 border-accent/40 bg-card/50 p-6 min-h-[200px] flex flex-col\">\n          <div className=\"flex items-center gap-2 mb-4\">\n            <Activity className=\"h-5 w-5 text-warning\" />\n            <span className=\"text-sm font-bold uppercase tracking-wider text-warning\">\n              Runtime Variables\n            </span>\n            <span className=\"rounded-full bg-warning px-2 py-0.5 text-xs font-bold text-foreground\">\n              {variablesByType.computed.length + variablesByType.state.length}\n            </span>\n          </div>\n          <p className=\"text-xs text-muted-foreground mb-4\">\n            Variables computed or updated during workflow execution based on agent outputs or user interactions\n          </p>\n          <div className=\"space-y-3 flex-1\">\n            {[...variablesByType.computed, ...variablesByType.state].map((variable, idx) => (\n              <div key={idx} className=\"rounded-lg border border-border bg-card/70 p-3\">\n                <div className=\"flex items-start justify-between gap-3 mb-2\">\n                  <div className=\"flex items-center gap-2\">\n                    <span className=\"font-bold text-foreground text-sm\">{variable.name}</span>\n                    <span className=\"rounded-full bg-warning/20 border border-warning/50 px-2 py-0.5 text-xs font-semibold text-warning\">\n                      {variable.source?.type === 'state' ? 'State' : 'Computed'}\n                    </span>\n                  </div>\n                </div>\n                {variable.purpose && (\n                  <p className=\"text-xs text-muted-foreground mb-2\">{variable.purpose}</p>\n                )}\n                {variable.trigger_hint && (\n                  <div className=\"rounded-md bg-background/50 border border-border p-2 mt-2\">\n                    <p className=\"text-xs text-muted-foreground\">\n                      <span className=\"font-semibold text-muted-foreground\">Trigger:</span> {variable.trigger_hint}\n                    </p>\n                  </div>\n                )}\n              </div>\n            ))}\n          </div>\n        </div>\n      )}\n      \n      {/* Empty State */}\n      {!hasDatabaseVars && !hasSystemVars && !hasRuntimeVars && (\n        <div className=\"rounded-xl border-2 border-border bg-card/50 p-12 text-center\">\n          <Database className=\"h-12 w-12 text-muted-foreground mx-auto mb-4\" />\n          <p className=\"text-muted-foreground text-sm\">No context variables defined for this workflow</p>\n        </div>\n      )}\n    </div>\n  );\n};\n\nconst ActionPlan = ({ payload = {}, onResponse, toolName, toolCallId, workflowName, componentId = 'ActionPlan' }) => {\n  // CRITICAL: All hooks MUST be called before any conditional returns (React rules of hooks)\n  // Initialize state first\n  const [pending, setPending] = useState(false);\n  const [openModules, setOpenModules] = useState({ 0: true });\n  const [activeTab, setActiveTab] = useState('workflow'); // Tab state: 'workflow' | 'data' | 'interactions' | 'diagram'\n  const [activeWorkflowIndex, setActiveWorkflowIndex] = useState(0); // Pack mode: active workflow tab\n\n  const packWorkflows = Array.isArray(payload?.workflows)\n    ? payload.workflows.filter((entry) => entry && typeof entry === 'object')\n    : [];\n  const hasChildWorkflows = packWorkflows.length > 1;\n\n  useEffect(() => {\n    try {\n      const workflows = Array.isArray(payload?.workflows) ? payload.workflows : null;\n      if (!workflows || workflows.length < 2) {\n        setActiveWorkflowIndex(0);\n        return;\n      }\n\n      const desiredRaw = payload?.active_workflow_name || payload?.activeWorkflowName;\n      const desired = typeof desiredRaw === 'string' ? desiredRaw.trim() : '';\n      if (!desired) return;\n\n      const idx = workflows.findIndex((entry) => {\n        if (!entry || typeof entry !== 'object') return false;\n        const entryNameRaw =\n          typeof entry.workflow_name === 'string'\n            ? entry.workflow_name\n            : (entry.workflow && typeof entry.workflow === 'object' && typeof entry.workflow.name === 'string'\n                ? entry.workflow.name\n                : '');\n        return String(entryNameRaw || '').trim() === desired;\n      });\n      if (idx >= 0) {\n        setActiveWorkflowIndex(idx);\n        setActiveTab('workflow');\n        setOpenModules({ 0: true });\n      }\n    } catch (e) {\n      // Best-effort only; never block render for tab sync\n    }\n  }, [payload]);\n\n  const clampedWorkflowIndex = hasChildWorkflows\n    ? Math.max(0, Math.min(activeWorkflowIndex, packWorkflows.length - 1))\n    : 0;\n  const workflowPayload = hasChildWorkflows ? (packWorkflows[clampedWorkflowIndex] || payload) : payload;\n  \n  // CRITICAL: Early validation to prevent null reference errors on revision (AFTER hooks)\n  const isValidPayload = payload && typeof payload === 'object';\n  \n  if (!isValidPayload) {\n    console.error('\ud83c\udfa8 [ActionPlan] Invalid payload received:', payload);\n    return (\n      <div className=\"min-h-screen space-y-8 rounded-2xl p-8 bg-background text-foreground\">\n        <div className=\"text-destructive\">Error: Invalid workflow data received. Please refresh and try again.</div>\n      </div>\n    );\n  }\n\n  // CRITICAL: Early logging to debug render issues\n  try {\n    console.log('\ud83c\udfa8 [ActionPlan] Component ENTRY - Starting render', {\n      payloadKeys: Object.keys(payload),\n      toolName,\n      toolCallId\n    });\n  } catch (e) {\n    console.error('\ud83c\udfa8 [ActionPlan] Error in entry logging:', e);\n  }\n  \n  // Resolve root according to the current UI payload contract:\n  // { workflow, agent_message, agent_message_id, ... }\n  const preferredWorkflow = workflowPayload?.workflow && typeof workflowPayload.workflow === 'object' && !Array.isArray(workflowPayload.workflow) ? workflowPayload.workflow : null;\n  const workflow = preferredWorkflow || {};\n  \n  try {\n    console.log('\ud83c\udfa8 [ActionPlan] Resolved workflow:', {\n      hasWorkflow: !!workflow,\n      workflowType: typeof workflow,\n      isArray: Array.isArray(workflow),\n      workflowKeys: workflow && typeof workflow === 'object' && !Array.isArray(workflow) ? Object.keys(workflow) : 'not-an-object',\n      name: workflow?.name,\n      trigger: workflow?.trigger,\n      triggerType: typeof workflow?.trigger,\n      hasTechnicalBlueprint: !!workflow?.technical_blueprint,\n      hasLifecycleOps: !!workflow?.lifecycle_operations\n    });\n  } catch (e) {\n    console.error('\ud83c\udfa8 [ActionPlan] Error logging resolved workflow:', e);\n  }\n\n  const safeWorkflow = (workflow && typeof workflow === 'object' && !Array.isArray(workflow)) ? workflow : {};\n  const workflowStages = Array.isArray(safeWorkflow?.workflow_stages) ? safeWorkflow.workflow_stages : [];\n\n  const technicalBlueprintCandidates = [\n    safeWorkflow?.technical_blueprint,\n    workflowPayload?.technical_blueprint,\n  ];\n  const technicalBlueprint = technicalBlueprintCandidates.find("},{"checksum":"sha256:d01f94a38820f5389f158d4492c4d9ba1df36ee8af2971a2fe637fbc99eeff7f","chunk_id":"chunk_cfa36840a6a6dada","end_line":1797,"path":"workflows/AgentGenerator/ui/ActionPlan.js","start_line":1602,"symbol_ids":["sym_3c28b5fc9e614d76","sym_67b060247ddaf77d","sym_d799fdda5da5f5cb","sym_47fd7fbbd4f4acbd","sym_6a8d0874a30c93d1"],"text":"    (candidate) => candidate && typeof candidate === 'object' && !Array.isArray(candidate),\n  ) || null;\n\n  console.log('\ud83c\udfa8 [ActionPlan] TechnicalBlueprint resolved:', {\n    found: !!technicalBlueprint,\n    keys: technicalBlueprint ? Object.keys(technicalBlueprint) : 'null',\n    before_chat_lifecycle: technicalBlueprint?.before_chat_lifecycle,\n    after_chat_lifecycle: technicalBlueprint?.after_chat_lifecycle,\n    global_context_variables_count: Array.isArray(technicalBlueprint?.global_context_variables) ? technicalBlueprint.global_context_variables.length : 0,\n    ui_components_count: Array.isArray(technicalBlueprint?.ui_components) ? technicalBlueprint.ui_components.length : 0\n  });\n\n  const workflowLifecycleOperations = normalizeLifecycleOperations(safeWorkflow?.lifecycle_operations);\n  const blueprintLifecycleOperations = normalizeLifecycleOperations(technicalBlueprint?.lifecycle_operations || null);\n  const blueprintBeforeChat = normalizeLifecycleOperations(\n    technicalBlueprint?.before_chat_lifecycle\n      ? {\n          ...technicalBlueprint.before_chat_lifecycle,\n          trigger: technicalBlueprint.before_chat_lifecycle.trigger || 'before_chat',\n        }\n      : null,\n  );\n  const blueprintAfterChat = normalizeLifecycleOperations(\n    technicalBlueprint?.after_chat_lifecycle\n      ? {\n          ...technicalBlueprint.after_chat_lifecycle,\n          trigger: technicalBlueprint.after_chat_lifecycle.trigger || 'after_chat',\n        }\n      : null,\n  );\n  const lifecycleOperations = mergeLifecycleCollections(\n    workflowLifecycleOperations,\n    blueprintLifecycleOperations,\n    blueprintBeforeChat,\n    blueprintAfterChat\n  );\n\n  console.log('\ud83c\udfa8 [ActionPlan] Lifecycle operations debug:', {\n    workflowCount: workflowLifecycleOperations.length,\n    blueprintCount: blueprintLifecycleOperations.length,\n    beforeChatCount: blueprintBeforeChat.length,\n    afterChatCount: blueprintAfterChat.length,\n    mergedCount: lifecycleOperations.length,\n    hasTechnicalBlueprint: !!technicalBlueprint,\n    blueprintKeys: technicalBlueprint ? Object.keys(technicalBlueprint) : 'null'\n  });\n\n  // Separate lifecycle operations by context\n  const chatLevelHooks = {\n    before_chat: lifecycleOperations.filter(op => String(op.trigger || '').toLowerCase() === 'before_chat'),\n    after_chat: lifecycleOperations.filter(op => String(op.trigger || '').toLowerCase() === 'after_chat'),\n  };\n  if (chatLevelHooks.before_chat.length === 0 && technicalBlueprint?.before_chat_lifecycle) {\n    const fallbackBefore = normalizeLifecycleOperations({\n      ...technicalBlueprint.before_chat_lifecycle,\n      trigger: technicalBlueprint.before_chat_lifecycle.trigger || 'before_chat',\n    });\n    if (fallbackBefore.length > 0) {\n      chatLevelHooks.before_chat = mergeLifecycleCollections(chatLevelHooks.before_chat, fallbackBefore);\n    }\n  }\n  if (chatLevelHooks.after_chat.length === 0 && technicalBlueprint?.after_chat_lifecycle) {\n    const fallbackAfter = normalizeLifecycleOperations({\n      ...technicalBlueprint.after_chat_lifecycle,\n      trigger: technicalBlueprint.after_chat_lifecycle.trigger || 'after_chat',\n    });\n    if (fallbackAfter.length > 0) {\n      chatLevelHooks.after_chat = mergeLifecycleCollections(chatLevelHooks.after_chat, fallbackAfter);\n    }\n  }\n\n  console.log('\ud83c\udfa8 [ActionPlan] Final chat-level hooks:', {\n    beforeChatCount: chatLevelHooks.before_chat.length,\n    afterChatCount: chatLevelHooks.after_chat.length,\n    beforeChat: chatLevelHooks.before_chat,\n    afterChat: chatLevelHooks.after_chat\n  });\n\n  // Agent-level hooks will be distributed to individual agents within workflow stages\n\n  // agent_message intentionally ignored inside artifact to avoid duplicate display in chat; previously parsed here.\n  // (If future logic needs it for analytics, reintroduce as const agentMessage = String(payload?.agent_message || '') and use.)\n\n  // Derived counts (computed; not part of schema)\n  const agentCount = workflowStages.reduce((acc, stage) => acc + (Array.isArray(stage?.agents) ? stage.agents.length : 0), 0);\n  \n  // Tool count: deduplicate integrations across all agents (same integration used multiple times = 1 tool)\n  const uniqueToolNames = new Set();\n  const uniqueIntegrations = new Set();\n  workflowStages.forEach(stage => {\n    if (!Array.isArray(stage?.agents)) return;\n    stage.agents.forEach(agent => {\n      const agentTools = Array.isArray(agent?.agent_tools) ? agent.agent_tools : [];\n      if (agentTools.length > 0) {\n        agentTools.forEach(tool => {\n          if (!tool || typeof tool !== 'object') return;\n          const toolName = tool?.name ? String(tool.name).trim() : '';\n          if (toolName) uniqueToolNames.add(toolName);\n          const integration = typeof tool?.integration === 'string' ? tool.integration.trim() : '';\n          if (integration) uniqueIntegrations.add(integration);\n        });\n      } else {\n        normalizeStringList(agent?.operations).forEach(name => {\n          if (name) uniqueToolNames.add(name);\n        });\n        normalizeStringList(agent?.integrations).forEach(integration => {\n          if (integration) uniqueIntegrations.add(integration);\n        });\n      }\n    });\n  });\n  const toolCount = uniqueToolNames.size || uniqueIntegrations.size;\n  const normalizeDiagram = (value) => (typeof value === 'string' ? value.trim() : '');\n  const workflowDiagram = normalizeDiagram(safeWorkflow?.mermaid_flow);\n  const mermaidChart = workflowDiagram;\n  const mermaidMessage = 'Approve the plan to generate a Mermaid sequence diagram.';\n\n  const uicomponents = Array.isArray(safeWorkflow?.ui_components)\n    ? safeWorkflow.ui_components\n    : Array.isArray(technicalBlueprint?.ui_components)\n      ? technicalBlueprint.ui_components\n      : [];\n\n  const UIComponentItems = uicomponents.filter(item => item && typeof item === 'object');\n  const UIComponentCount = UIComponentItems.length;\n\n  // Logging / action integration\n  const agentMessageId = payload?.agent_message_id || payload?.agentMessageId || workflowPayload?.agent_message_id || workflowPayload?.agentMessageId || null;\n  const tlog = createToolsLogger({ tool: toolName || componentId, eventId: toolCallId, workflowName, agentMessageId });\n  const toggleModule = (idx) => setOpenModules(prev => ({ ...prev, [idx]: !prev[idx] }));\n\n  const emit = async ({ action, planAcceptance = false, agentContextOverrides = {} }) => {\n    if (pending) return;\n    setPending(true);\n    try {\n      tlog.event(action, 'start');\n      const resp = {\n        status: 'success',\n        action,\n        data: {\n          action,\n          workflow_name: String(safeWorkflow?.name || 'Generated Workflow'),\n          trigger: String(safeWorkflow?.trigger || 'chatbot'),\n          stage_count: workflowStages.length,\n          agent_count: agentCount,\n          tool_count: toolCount,\n          tool_name: toolName,\n          tool_call_id: toolCallId,\n          workflowName,\n          agent_message_id: agentMessageId,\n          plan_acceptance: Boolean(planAcceptance),\n        },\n        plan_acceptance: Boolean(planAcceptance),\n        agentContext: {\n          action_completed: true,\n          workflow_viewed: true,\n          action_type: action,\n          plan_acceptance: Boolean(planAcceptance),\n          ...agentContextOverrides,\n        },\n      };\n      await onResponse?.(resp);\n      tlog.event(action, 'done', { ok: true });\n    } catch (e) {\n      const msg = e?.message || 'Unknown error';\n      tlog.error('action_failed', { error: msg });\n      onResponse?.({\n        status: 'error',\n        action,\n        error: msg,\n        plan_acceptance: Boolean(planAcceptance),\n        agentContext: { action_completed: false, plan_acceptance: Boolean(planAcceptance) },\n      });\n    } finally {\n      setPending(false);\n    }\n  };\n\n  const approve = () => emit({ action: 'accept_workflow', planAcceptance: true });\n\n  // Tab configuration\n  const tabs = [\n    { id: 'workflow', label: 'Workflow', icon: Compass },\n    { id: 'data', label: 'Data', icon: Database },\n    { id: 'interactions', label: 'Interactions', icon: MessageSquare },\n    { id: 'diagram', label: 'Diagram', icon: GitBranch },\n  ];\n  return (\n    <div className=\"min-h-screen space-y-4 md:space-y-8 rounded-2xl border-2 border-primary bg-card p-6 md:p-8 shadow-2xl shadow-primary/20\" data-agent-message-id={agentMessageId || undefined}>\n      {/* Header Section */}\n        <header className=\"space-y-4 md:space-y-6 rounded-2xl border-2 border-primary bg-gradient-to-br from-background to-card p-4 md:p-8 shadow-2xl shadow-primary/30\">\n          <div className=\"flex flex-col gap-4 md:flex-row md:items-center md:justify-between\">\n            <div className=\"flex items-center gap-3 text-sm font-black uppercase tracking-[0.3em] text-primary\">\n              <Sparkles className=\"h-5 w-5\" />\n              Workflow Blueprint\n              {safeWorkflow?.human_in_loop && ("},{"checksum":"sha256:944fa76940bbd6a97c8934159478930cda2db4348489dfd243aaf2bd4d3922ac","chunk_id":"chunk_d60047ee5a62b953","end_line":1969,"path":"workflows/AgentGenerator/ui/ActionPlan.js","start_line":1798,"symbol_ids":["sym_3c28b5fc9e614d76"],"text":"                <span className=\"ml-2 md:ml-4 flex items-center gap-1.5 rounded-full bg-warning/20 border border-warning/50 px-3 py-0.5 text-[10px] font-bold tracking-wide text-warning-foreground shadow-sm\">\n                  <UserCheck className=\"h-3 w-3\" />\n                  HUMAN IN LOOP\n                </span>\n              )}\n            </div>\n            <div className=\"flex flex-col items-start gap-2 text-left md:items-end md:text-right\">\n              <div className=\"flex flex-wrap items-center gap-2\">\n                <button\n                  onClick={approve}\n                  disabled={pending}\n                  className=\"rounded-lg bg-primary px-6 py-3 text-xs md:text-sm font-bold uppercase tracking-wide text-primary-foreground transition-all hover:bg-primary/90 disabled:opacity-60 shadow-lg shadow-primary/30\"\n                >\n                  Approve Plan\n                </button>\n              </div>\n            </div>\n          </div>\n          \n          <div className=\"space-y-5\">\n            <h1 className=\"font-black text-xl sm:text-2xl md:text-3xl lg:text-4xl text-foreground drop-shadow-lg break-words max-w-full leading-tight overflow-hidden\">\n          {String(safeWorkflow?.name || 'Generated Workflow')}\n            </h1>\n          </div>\n        </header>\n\n      {/* Pack Workflow Tabs (1 tab per workflow) */}\n      {hasChildWorkflows && (\n        <div className=\"flex items-center gap-2 rounded-xl border-2 border-border bg-background p-2 overflow-x-auto\">\n          {packWorkflows.map((entry, idx) => {\n            const isActive = idx === clampedWorkflowIndex;\n            const rawName =\n              typeof entry?.workflow_name === 'string'\n                ? entry.workflow_name\n                : (entry?.workflow && typeof entry.workflow === 'object' && typeof entry.workflow.name === 'string'\n                    ? entry.workflow.name\n                    : `Workflow ${idx + 1}`);\n            const role = typeof entry?.role === 'string' && entry.role.trim() ? entry.role.trim() : null;\n            return (\n              <button\n                key={`${String(rawName)}-${idx}`}\n                onClick={() => {\n                  setActiveWorkflowIndex(idx);\n                  setActiveTab('workflow');\n                  setOpenModules({ 0: true });\n                }}\n                className={`flex items-center gap-2 rounded-lg px-3 py-2 text-xs font-bold transition-all whitespace-nowrap ${\n                  isActive\n                    ? 'bg-gradient-to-r from-primary to-secondary text-foreground shadow-lg'\n                    : 'text-muted-foreground hover:bg-card'\n                }`}\n                title={String(rawName)}\n              >\n                <span className=\"max-w-[240px] truncate\">{String(rawName)}</span>\n                {role && (\n                  <span className=\"rounded-full bg-muted/70 px-2 py-0.5 text-[10px] font-extrabold uppercase tracking-wide text-foreground\">\n                    {role}\n                  </span>\n                )}\n              </button>\n            );\n          })}\n        </div>\n      )}\n\n      {/* Tab Navigation */}\n      <div className=\"flex items-center gap-2 rounded-xl border-2 border-border bg-background p-2\">\n        {tabs.map(tab => {\n          const Icon = tab.icon;\n          const isActive = activeTab === tab.id;\n          return (\n            <button\n              key={tab.id}\n              onClick={() => setActiveTab(tab.id)}\n              className={`flex flex-1 flex-col sm:flex-row items-center justify-center gap-1 sm:gap-2 rounded-lg px-2 sm:px-4 py-2 sm:py-3 text-xs sm:text-sm font-bold transition-all ${\n                isActive\n                  ? 'bg-gradient-to-r from-primary to-secondary text-foreground shadow-lg'\n                  : 'text-muted-foreground hover:bg-card hover:text-foreground'\n              }`}\n            >\n              <Icon className=\"h-4 w-4\" />\n              <span className=\"text-[10px] sm:text-xs leading-tight text-center\">{tab.label}</span>\n            </button>\n          );\n        })}\n      </div>\n\n      {/* Tab Content */}\n      {/* Data Tab - Context variables and database information */}\n      {activeTab === 'data' && (\n        <DataView\n          workflow={safeWorkflow}\n          contextVariableDefinitions={safeWorkflow?.context_variable_definitions || {}}\n        />\n      )}\n\n      {/* Interactions Tab - UI Components */}\n      {activeTab === 'interactions' && (\n        <div className=\"space-y-6\">\n          {/* Initialization Process Section */}\n          <div className=\"rounded-xl border-2 border-border bg-gradient-to-br from-background/80 to-card/80 overflow-hidden shadow-xl\">\n            <div className=\"flex items-center gap-3 bg-gradient-to-r from-primary/10 via-secondary/10 to-primary/10 px-6 py-5 border-b-2 border-border\">\n              <Zap className=\"h-6 w-6 text-primary animate-pulse\" />\n              <span className=\"text-xl font-black uppercase tracking-widest text-foreground\">\n                Workflow Initialization\n              </span>\n            </div>\n            <div className=\"grid grid-cols-2 divide-x-2 divide-border/50\">\n              <div className=\"p-6 hover:bg-muted/30 transition-colors\">\n                <div className=\"text-xs font-black uppercase tracking-widest text-primary mb-3\">Initiated By</div>\n                <div className=\"text-2xl font-black text-primary mb-2\">\n                  {INITIATED_BY[String(safeWorkflow?.initiated_by || '').toLowerCase()]?.label || 'Unknown'}\n                </div>\n                <div className=\"text-sm text-muted-foreground leading-relaxed\">\n                  {INITIATED_BY[String(safeWorkflow?.initiated_by || '').toLowerCase()]?.desc || 'Not specified'}\n                </div>\n              </div>\n              <div className=\"p-6 hover:bg-muted/30 transition-colors\">\n                <div className=\"text-xs font-black uppercase tracking-widest text-primary mb-3\">Trigger Type</div>\n                <div className=\"text-2xl font-black text-primary mb-2\">\n                  {TRIGGER_TYPE[String(safeWorkflow?.trigger_type || inferTriggerTypeFrom(safeWorkflow?.trigger) || '').toLowerCase().replace(/[^a-z0-9]/g, '')]?.label || toTitle(String(safeWorkflow?.trigger_type || safeWorkflow?.trigger || 'Not specified'))}\n                </div>\n                <div className=\"text-sm text-muted-foreground leading-relaxed\">\n                  {TRIGGER_TYPE[String(safeWorkflow?.trigger_type || inferTriggerTypeFrom(safeWorkflow?.trigger) || '').toLowerCase().replace(/[^a-z0-9]/g, '')]?.desc || 'Workflow activation condition'}\n                </div>\n              </div>\n            </div>\n          </div>\n\n          {/* UI Components Section */}\n          {UIComponentCount > 0 ? (\n            <div className=\"space-y-4\">\n              <div className=\"flex items-center gap-3 rounded-lg bg-card px-6 py-4 border-l-4 border-primary\">\n                <MousePointerClick className=\"h-6 w-6 text-primary\" />\n                <span className=\"text-xl font-black uppercase tracking-wider text-foreground\">UI Components</span>\n              </div>\n              <div className=\"grid gap-3 lg:grid-cols-2\">\n                {UIComponentItems.map((component, idx) => (\n                  <ComponentCard key={`component-${idx}`} component={component} idx={idx} />\n                ))}\n              </div>\n              \n              {/* Legend */}\n              <div className=\"flex items-center justify-center gap-6 rounded-lg bg-card/50 px-6 py-3 border border-border\">\n                <div className=\"flex items-center gap-2\">\n                  <div className=\"w-4 h-4 rounded border-2 border-primary/60 bg-primary/20\"></div>\n                  <span className=\"text-sm font-medium text-muted-foreground\">Inline Display</span>\n                </div>\n                <div className=\"flex items-center gap-2\">\n                  <div className=\"w-4 h-4 rounded border-2 border-secondary/60 bg-secondary/20\"></div>\n                  <span className=\"text-sm font-medium text-muted-foreground\">Artifact Display</span>\n                </div>\n              </div>\n            </div>\n          ) : (\n            <div className=\"rounded-2xl border-2 border-dashed border-border bg-background/50 p-12 text-center\">\n              <MousePointerClick className=\"h-12 w-12 text-muted-foreground mx-auto mb-4\" />\n              <p className=\"text-base font-medium text-muted-foreground\">No UI interactions defined for this workflow</p>\n            </div>\n          )}\n        </div>\n      )}\n\n      {/* Workflow Tab - Lifecycle hooks + workflow stage details */}\n      {activeTab === 'workflow' && (\n        <div className=\"space-y-8\">\n          {/* Workflow Description */}\n          {safeWorkflow?.description && (\n            <div className=\"rounded-lg bg-card/70 p-5 border-l-4 border-primary\">\n              <p className=\"text-base leading-relaxed text-foreground\">{String(safeWorkflow.description)}</p>\n            </div>\n          )}"},{"checksum":"sha256:a06bc4be7b071973f4abe6615894d8c049a2397ecc4516f1eede5edc4dbe0177","chunk_id":"chunk_a3b62d980abc24b8","end_line":2017,"path":"workflows/AgentGenerator/ui/ActionPlan.js","start_line":1970,"symbol_ids":["sym_3c28b5fc9e614d76"],"text":"          \n          {/* Setup Hooks (before_chat) */}\n          <WorkflowLifecycleSection operations={chatLevelHooks.before_chat} type=\"before_chat\" />\n\n          {/* Workflow Stages Section */}\n          <div className=\"space-y-6\">\n            <div className=\"flex items-center gap-3 rounded-lg bg-card px-6 py-4 border-l-4 border-primary\">\n              <Layers className=\"h-6 w-6 text-primary\" />\n              <span className=\"text-xl font-black uppercase tracking-wider text-foreground\">Workflow Stages</span>\n            </div>\n            \n            {workflowStages.length === 0 && (\n              <div className=\"rounded-2xl border-2 border-dashed border-border bg-background/50 p-12 text-center\">\n                <p className=\"text-base font-medium text-muted-foreground\">No workflow stages defined. Please ensure the ActionPlan includes at least one stage.</p>\n              </div>\n            )}\n            \n            <div className=\"space-y-5\">\n              {workflowStages.map((module, idx) => (\n                <ModuleAccordion\n                  key={idx}\n                  module={module}\n                  index={idx}\n                  open={!!openModules[idx]}\n                  onToggle={() => toggleModule(idx)}\n                  lifecycleOperations={lifecycleOperations}\n                />\n              ))}\n            </div>\n          </div>\n\n          {/* Teardown Hooks (after_chat) */}\n          <WorkflowLifecycleSection operations={chatLevelHooks.after_chat} type=\"after_chat\" />\n        </div>\n      )}\n\n      {/* Diagram Tab - Mermaid visualization */}\n      {activeTab === 'diagram' && (\n        <MermaidPreview chart={mermaidChart} pendingMessage={mermaidMessage} pattern={safeWorkflow?.pattern} />\n      )}\n    </div>\n  );\n};\n\nActionPlan.displayName = 'ActionPlan';\nexport default ActionPlan;\n\n"},{"checksum":"sha256:b1879a0463be235809482ac0cf9adf75bd991aa61eef6213e69cc3ac4dc6f368","chunk_id":"chunk_5fde2cbc21d13353","end_line":16,"path":"workflows/AgentGenerator/ui/WorkflowPlanReview.jsx","start_line":1,"symbol_ids":["sym_3971aec69872cdcf","sym_655f52d7b3043a00"],"text":"import { ApprovalCard, DiagramViewer } from '@mozaiks/chat-ui';\n\nexport default function WorkflowPlanReview({ payload = {}, onResponse, workflowName }) {\n  const respond = (response) => onResponse({ ...response, review_id: payload.review_id });\n  return (\n    <div className=\"min-w-0 space-y-4\" key={payload.review_id}>\n      {payload.workflow_count > 0 ? <DiagramViewer payload={payload} /> : null}\n      <ApprovalCard\n        payload={payload}\n        workflowName={workflowName}\n        onResponse={respond}\n        onCancel={() => respond({ action: 'cancel', approved: false })}\n      />\n    </div>\n  );\n}"},{"checksum":"sha256:f6f96d707ac67ae0d49b61d60ca1f289dc639f38d8e8804c839f3a3bb8c99a45","chunk_id":"chunk_8a687704219b016a","end_line":3,"path":"workflows/AgentGenerator/ui/index.js","start_line":1,"symbol_ids":[],"text":"export { default as ActionPlan } from './ActionPlan.js';\nexport { default as WorkflowPlanReview } from './WorkflowPlanReview.jsx';\nexport { default as AgentAPIKeysBundleInput } from '../../_shared/ui/AgentAPIKeysBundleInput.js';"},{"checksum":"sha256:cd712d87c0d414a579b23cf63f317429bbb71120191b2f7fb1277ffa93d416c9","chunk_id":"chunk_20181a3aa189098a","end_line":5,"path":"workflows/AgentGenerator/ui_config.yaml","start_line":1,"symbol_ids":[],"text":"visual_agents:\n- InterviewAgent\n- user\n- ProjectOverviewAgent\n- DownloadAgent"},{"checksum":"sha256:fabc41c4adc6bc9ad899b24fb1147730d2b1953a62573ac174d7ff8a0b3ce321","chunk_id":"chunk_190b5403f7b42555","end_line":2,"path":"workflows/AppGenerator/__init__.py","start_line":1,"symbol_ids":[],"text":"# AppGenerator workflow package\n"},{"checksum":"sha256:1db3cdd49df0a2647e286d7573f7aef67a9490fc3d11d27329c325ba2e62fcd2","chunk_id":"chunk_ce4b4c3a3198dc3b","end_line":288,"path":"workflows/AppGenerator/context_variables.yaml","start_line":1,"symbol_ids":[],"text":"definitions:\n  app_bundle_acceptance_status:\n    type: string\n    authority_class: closed_writer_quality_state\n    writer_ids: [deterministic_tool]\n    persisted: true\n    source:\n      type: state\n      default: pending\n  app_bundle_acceptance_result:\n    type: object\n    authority_class: closed_writer_quality_state\n    writer_ids: [deterministic_tool]\n    persisted: true\n    source:\n      type: state\n      default: null\n  app_bundle_validation_evidence:\n    type: object\n    authority_class: closed_writer_quality_state\n    writer_ids: [deterministic_tool]\n    persisted: true\n    source:\n      type: state\n      default: null\n  app_runtime_load_passed:\n    type: boolean\n    authority_class: closed_writer_quality_state\n    writer_ids: [deterministic_tool]\n    persisted: true\n    source:\n      type: state\n      default: false\n  app_runtime_load_result:\n    type: object\n    authority_class: closed_writer_quality_state\n    writer_ids: [deterministic_tool]\n    persisted: true\n    source:\n      type: state\n      default: null\n  bundle_scan_passed:\n    type: boolean\n    authority_class: closed_writer_quality_state\n    writer_ids: [deterministic_tool]\n    persisted: true\n    source:\n      type: state\n      default: false\n  bundle_scan_result:\n    type: object\n    authority_class: closed_writer_quality_state\n    writer_ids: [deterministic_tool]\n    persisted: true\n    source:\n      type: state\n      default: null\n  generated_app_functional_completeness_passed:\n    type: boolean\n    authority_class: closed_writer_quality_state\n    writer_ids: [deterministic_tool]\n    persisted: true\n    source:\n      type: state\n      default: false\n  generated_app_functional_completeness_result:\n    type: object\n    authority_class: closed_writer_quality_state\n    writer_ids: [deterministic_tool]\n    persisted: true\n    source:\n      type: state\n      default: null\n  module_contract_quality_result:\n    type: object\n    authority_class: closed_writer_quality_state\n    writer_ids: [deterministic_tool]\n    persisted: true\n    source:\n      type: state\n      default: null\n  app_context_artifact_version_id:\n    type: string\n    authority_class: closed_writer_quality_state\n    writer_ids: [deterministic_tool]\n    persisted: true\n    source:\n      type: state\n      default: null\n  app_context_registration_warning:\n    type: string\n    authority_class: closed_writer_quality_state\n    writer_ids: [deterministic_tool]\n    persisted: true\n    source:\n      type: state\n      default: null\n  app_context_version_id:\n    type: string\n    authority_class: closed_writer_quality_state\n    writer_ids: [deterministic_tool]\n    persisted: true\n    source:\n      type: state\n      default: null\n  greenfield_app_context_registered:\n    type: boolean\n    authority_class: closed_writer_quality_state\n    writer_ids: [deterministic_tool]\n    persisted: true\n    source:\n      type: state\n      default: false\n  run_build_binding:\n    type: object\n    description: Server-verified target and build lineage. Execution app_id remains the host identity.\n    source:\n      type: runtime\n      required: true\n\n  app_bundle_export_outcome:\n    type: string\n    authority_class: closed_writer_routing_state\n    writer_ids: [deterministic_tool]\n    persisted: true\n    source:\n      type: state\n      default: blocked\n  app_bundle_export_attempts:\n    type: integer\n    authority_class: closed_writer_quality_state\n    writer_ids: [deterministic_tool]\n    persisted: true\n    source:\n      type: state\n      default: 0\n  build_timestamp:\n    type: string\n    description: >\n      Canonical timezone-aware ISO-8601 timestamp shared by every provenance\n      artifact in one deterministic app materialization. The launcher may seed\n      it for replay; otherwise provenance producers resolve current UTC.\n    source:\n      type: state\n      default: null\n  platform_user_email:\n    type: string\n    description: >\n      Email address of the authenticated platform user who started this AppGenerator\n      session. Injected by the hosted platform at workflow start from the session JWT.\n      Used by scaffold/config agents to populate `app/app.json` `admins` without\n      prompting the user. Falls back to null in OSS / unauthenticated contexts, in\n      which case InterviewAgent captures the email during the intake interview.\n    source:\n      type: state\n      default: null\n  coding_participation:\n    type: string\n    description: >\n      Build participation mode chosen at the checkpoint after theme capture.\n      \"autonomous\" means the user asked Mozaiks to make the remaining calls and\n      bring them a finished app; \"guided\" means they asked to be consulted on\n      the decisions that shape it. Seeded by coding_journey_selector.\n    source:\n      type: state\n      default: guided\n  build_mode:\n    type: string\n    description: >\n      Build mode for AppGenerator. `initial` means generate the app bundle from\n      scratch; `revision` means revise an existing bundle from persisted state.\n    source:\n      type: state\n      default: initial\n  workflow_sequence:\n    type: string\n    description: >\n      Active workflow sequence that launched this run, such as app_revision,\n      app_surface_revision, conceptual_replan, or full_rebuild.\n    source:\n      type: state\n      default: null\n  revision_scope:\n    type: string\n    description: >\n      Revision scope: patch | design | feature | core. Seeded by the\n      refinement control plane. AppPlanAgent uses this to scope the rebuild \u2014\n      patch edits targeted files, feature extends the plan, core restarts.\n    source:\n      type: state\n      default: null\n  change_request_id:\n    type: string\n    description: Stable lineage id for the active revision request.\n    source:\n      type: state\n      default: null\n  revision_id:\n    type: string\n    description: Runtime-generated revision run id for the current builder revision.\n    source:\n      type: state\n      default: null\n  artifact_kind:\n    type: string\n    description: >\n      Artifact family currently being refined, such as app_bundle or\n      workflow_bundle. Seeded by the refinement control plane so AppGenerator\n      can distinguish app-bundle-local work from broader cross-artifact changes.\n    source:\n      type: state\n      default: null\n  artifact_version_id:\n    type: string\n    description: >\n      Version id of the app bundle artifact being refined. Null for initial\n      generation runs. AppPlanAgent loads the existing build_tasks from this\n      version when build_mode is revision.\n    source:\n      type: state\n      default: null\n  sequence_status:\n    type: string\n    description: >\n      Builder sequence state before the revision launch: in_progress |\n      completed | stale | revising.\n    source:\n      type: state\n      default: in_progress\n  revision_origin_workflow:\n    type: string\n    description: Workflow where the revision request originated before reroute.\n    source:\n      type: state\n      default: null\n  refinement_request:\n    type: string\n    description: >\n      Raw user-supplied refinement request text, passed through from the\n      canonical RefinementRequest. InterviewAgent reads this instead of re-interviewing when\n      build_mode is revision. Revision workers use relevant behavioral qualifiers\n      within their owned task and declared contracts; this text grants no new\n      file ownership, operator authority, or authorization.\n    source:\n      type: state\n      default: null\n  refinement_request_meta:\n    type: object\n    description: >\n      Full typed RefinementRequest payload persisted by the control plane.\n      Useful when downstream agents need artifact ids, source surface, or other\n      request metadata beyond the raw refinement text.\n    source:\n      type: state\n      default: null\n  screen:\n    type: string\n    description: >\n      Builder surface or screen identifier that launched the current refinement\n      request, such as studio-create. Preserved for analytics and future\n      surface-aware prompt shaping.\n    source:\n      type: state\n      default: null\n  change_intent:\n    type: object\n    description: >\n      Typed refinement classification emitted by the control plane. Contains the\n      final `revision_scope`, rationale, and layer-touch information so\n      AppGenerator can distinguish a local patch from a wider feature or\n      concept-driven restart.\n    source:\n      type: state\n      default: null\n  impact_set:\n    type: object\n    description: >\n      Typed downstream impact summary emitted by the control plane. Contains\n      affected workflows, affected declarative families, restart_from, and\n      rebuild/replanning flags for the current refinement request.\n    source:\n      type: state\n      default: null\n  pivot_description:\n    type: string\n    description: >\n      User's original change request text, injected by the control plane when\n      the active workflow_sequence is conceptual_replan. Describes the nature"},{"checksum":"sha256:bcf976d47be3ef4444be7c27cb2d85f9cefda14fead528b049c7cebe2ee83545","chunk_id":"chunk_79b18fb6fd901103","end_line":531,"path":"workflows/AppGenerator/context_variables.yaml","start_line":289,"symbol_ids":[],"text":"      of the concept-level pivot so AppPlanAgent can align the new build plan\n      to explicit pivot intent rather than applying incremental revisions.\n    source:\n      type: state\n      default: null\n  preserve_families:\n    type: array\n    description: >\n      Artifact families that the conceptual_replan should preserve. Default is\n      [\"brand\"]. AppPlanAgent may use this to understand which artifact layers\n      have preservation intent. Carry-forward behavior is future work.\n    source:\n      type: state\n      default: []\n  previous_app_bundle_ref:\n    type: string\n    description: >\n      Artifact version id of the app bundle at the time the conceptual_replan\n      was triggered. Null when not available. Advisory \u2014 no file copy or merge\n      occurs from this reference in the current implementation.\n    source:\n      type: state\n      default: null\n  carry_forward_modules:\n    type: array\n    description: >\n      Advisory list of module ids from the previous app bundle that AppPlanAgent\n      may consider reusing during a conceptual_replan. Defaults to [] when not\n      supplied by the workbench. This is a preservation hint only \u2014 AppPlanAgent\n      must not blindly re-emit these modules. Each module must still fit the new\n      concept and pass the standard capability-pack derivation. Domain-specific\n      modules that no longer fit should be omitted. No automatic file copy or\n      merge occurs.\n    source:\n      type: state\n      default: []\n  llm_profile:\n    type: string\n    description: >\n      Advisory LLM profile name injected by the control plane when the\n      active workflow_sequence requires stronger reasoning (conceptual_replan\n      or full_rebuild). Maps to a named profile in ai.json llm_profiles.\n      Null for patch, design, and feature routes. Advisory only.\n    source:\n      type: state\n      default: null\n  context_graph_pack:\n    type: object\n    description: >\n      Compact Context Graph prompt pack loaded by the before_chat lifecycle\n      tool. Contains the prompt-safe graph status, relevant paths, matched\n      nodes, relationship hints, warnings, and semantic annotation targets.\n      This is advisory code-context intelligence, not routing or execution\n      authority.\n    source:\n      type: state\n      default: null\n  context_graph_catalog:\n    type: object\n    description: >\n      Rich machine-readable Context Graph catalog for diagnostics and tooling.\n      This is intentionally distinct from context_graph_pack. Populated by\n      load_context_graph_context when a current app context graph or artifact\n      workspace graph is available.\n    source:\n      type: state\n      default: null\n  context_graph_status:\n    type: string\n    description: >\n      Startup load status for Context Graph prompt packs: loaded, unavailable,\n      or null when the loader has not run.\n    source:\n      type: state\n      default: null\n  context_graph_reason:\n    type: string\n    description: >\n      Specific Context Graph load reason such as missing_app_id,\n      current_app_context_graph_unavailable, or context_refresh_prior_version.\n      Null when graph prompt context loaded without a special condition.\n    source:\n      type: state\n      default: null\n  context_graph_warnings:\n    type: array\n    description: Warnings emitted while loading Context Graph context.\n    source:\n      type: state\n      default: []\n  context_graph_health:\n    type: object\n    description: >\n      Deterministic Context Graph load health and coverage metadata, including\n      scan limits, selected file counts, parser availability, and skipped-file\n      counts when a local source scan was performed.\n    source:\n      type: state\n      default: null\n  current_app_context_version_id:\n    type: string\n    description: >\n      Current AppContextVersion id evaluated before a revision workflow starts.\n      Revision agents use this as the durable handle for source-backed App\n      Intelligence, Context Graph, and source retrieval tools.\n    source:\n      type: state\n      default: null\n  app_context_summary:\n    type: object\n    description: >\n      Prompt-safe summary of the current AppContextVersion, including artifact\n      refs, source refs, ownership boundaries, stale status, and warnings.\n      This is context authority for revision startup, not raw source content.\n    source:\n      type: state\n      default: null\n  app_context_required:\n    type: boolean\n    description: >\n      True when this run is a refinement or revision route that must have a\n      current AppContextVersion before agents perform build or edit work.\n    source:\n      type: state\n      default: false\n  app_intelligence_ready:\n    type: boolean\n    description: True when startup loaded an App Intelligence catalog.\n    source:\n      type: state\n      default: false\n  app_intelligence_status:\n    type: string\n    description: Startup load status for App Intelligence context.\n    source:\n      type: state\n      default: null\n  app_intelligence_summary:\n    type: string\n    description: Compact human-readable summary of indexed source coverage.\n    source:\n      type: state\n      default: null\n  app_intelligence_health:\n    type: object\n    description: App Intelligence coverage, scan health, and startup warnings.\n    source:\n      type: state\n      default: null\n  app_intelligence_catalog:\n    type: object\n    description: >\n      Prompt-safe App Intelligence catalog containing architecture, capability,\n      ownership, integration, data, and risk summaries. Exact code is not\n      embedded here; agents use source retrieval tools for selected files.\n    source:\n      type: state\n      default: null\n  source_context_catalog:\n    type: object\n    description: >\n      Prompt-safe source corpus catalog for indexed files, chunks, symbols, and\n      imports. It is an index for retrieval, not full source content.\n    source:\n      type: state\n      default: null\n  brownfield_build_path:\n    type: string\n    description: >\n      Selected brownfield build path from brownfield_path_selector. One of\n      \"light_integration\" (Add AI Workflows: preserve the existing app as\n      source of truth and generate app-aware AI workflows, chat surfaces, and\n      only required safe adapters around approved capabilities) or\n      \"full_migration\" (Build App Features: generate Mozaiks-owned modules,\n      workflows, pages, data contracts, and extended functionality for\n      explicitly approved expansion scope). Null for greenfield builds.\n    source:\n      type: state\n      default: null\n  adoption_plan:\n    type: object\n    description: >\n      Canonical AdoptionPlan from ExistingAppDiscovery \u2014 recommended_path,\n      phases, candidate_overlays, candidate_adapters, candidate_migrations, and\n      human_decisions_required. Present only for brownfield builds. Planning\n      agents scope generation work to approved surfaces declared here.\n    source:\n      type: state\n      default: null\n  ownership_boundary:\n    type: object\n    description: >\n      Canonical ownership_boundary artifact from ExistingAppDiscovery \u2014\n      app_id and ownership_boundaries[] listing each discovered surface with\n      its ownership class (read_only_discovered, generated_overlay, etc.),\n      allowed_operations, and requires_review flag. Present only for brownfield\n      builds. Agents must not propose changes to read_only_discovered surfaces.\n    source:\n      type: state\n      default: null\n  brownfield_registration:\n    type: object\n    description: >\n      BrownfieldRegistration record from ExistingAppDiscovery \u2014 registration_id,\n      app_id, source_refs, context_version_id, scan_policy_ref, and status.\n      Present only for brownfield builds. Used as the provenance anchor for\n      generated overlays and adapters.\n    source:\n      type: state\n      default: null\n  app_type:\n    type: string\n    description: >\n      Entry path selected at the app_type_selector gate. One of \"greenfield_app\"\n      (fresh concept, no prior design docs) or \"brownfield_app\" (user has a rough\n      idea or existing project).\n      Seeded from gate context when navigating via the build journey. InterviewAgent\n      uses this to tailor its opening questions \u2014 \"greenfield_app\" starts from\n      scratch, \"brownfield_app\" asks what they already have.\n    source:\n      type: state\n      default: \"greenfield_app\"\n  builder_options:\n    type: object\n    description: Optional app-agnostic builder UI option payload carried through workflow sequences.\n    source:\n      type: state\n      default: null\n  concept_overview:\n    type: string\n    description: Project description and overview from the BuilderConcepts collection (produced\n      by ValueEngine).\n    source:\n      type: data_reference\n      database_name: mozaiksai\n      collection: BuilderConcepts\n      query_template:\n        app_id: '{{run_build_binding.target_app_id}}'\n      fields:\n      - ConceptOverview\n      default: null\n  concept_api_endpoints:\n    type: array"},{"checksum":"sha256:2f1361c83fc20deae88e54c1fd064acf8525eec75f4b64bf897361fc2329b439","chunk_id":"chunk_cba171b1554995ab","end_line":794,"path":"workflows/AppGenerator/context_variables.yaml","start_line":532,"symbol_ids":[],"text":"    description: Optional API endpoints blueprint from the BuilderConcepts collection (produced\n      by ValueEngine).\n    source:\n      type: data_reference\n      database_name: mozaiksai\n      collection: BuilderConcepts\n      query_template:\n        app_id: '{{run_build_binding.target_app_id}}'\n      fields:\n      - ApiEndpoints\n      default: []\n  concept_blueprint:\n    type: object\n    description: Optional structured blueprint from the BuilderConcepts collection (produced\n      by ValueEngine).\n    source:\n      type: data_reference\n      database_name: mozaiksai\n      collection: BuilderConcepts\n      query_template:\n        app_id: '{{run_build_binding.target_app_id}}'\n      fields:\n      - Blueprint\n      default: null\n  frontend_design_document:\n    type: string\n    description: Latest frontend design document generated by DesignDocs (if available).\n    source:\n      type: data_reference\n      database_name: mozaiksai\n      collection: DesignDocuments\n      query_template:\n        app_id: '{{run_build_binding.target_app_id}}'\n        kind: frontend\n        status: succeeded\n      fields:\n      - content\n      default: null\n  backend_design_document:\n    type: string\n    description: >\n      Latest backend design document generated by DesignDocs (if available).\n      Human-readable reference for backend rationale, API intent, and event architecture.\n    source:\n      type: data_reference\n      database_name: mozaiksai\n      collection: DesignDocuments\n      query_template:\n        app_id: '{{run_build_binding.target_app_id}}'\n        kind: backend\n        status: succeeded\n      fields:\n      - content\n      default: null\n  database_design_document:\n    type: string\n    description: Latest database design document generated by DesignDocs (if available).\n    source:\n      type: data_reference\n      database_name: mozaiksai\n      collection: DesignDocuments\n      query_template:\n        app_id: '{{run_build_binding.target_app_id}}'\n        kind: database\n        status: succeeded\n      fields:\n      - content\n      default: null\n  ui_design_document:\n    type: string\n    description: >\n      Latest UI schema design document generated by DesignDocs (if available).\n      YAML-formatted page-by-page layout guide using the platform primitive system.\n      Primary input for AppSchemaAgent when producing AppSchemaOutput.\n    source:\n      type: data_reference\n      database_name: mozaiksai\n      collection: DesignDocuments\n      query_template:\n        app_id: '{{run_build_binding.target_app_id}}'\n        kind: ui_schema\n        status: succeeded\n      fields:\n      - content\n      default: null\n  experience_spec_document:\n    type: string\n    description: >\n      Human-readable YAML representation of the ExperienceSpec, generated from the\n      typed experience_spec and stored as the ui_schema doc content. Used by\n      AppSchemaAgent and AgentGenerator as a readable reference for persistent UI\n      ownership and workflow touchpoints.\n    source:\n      type: data_reference\n      database_name: mozaiksai\n      collection: DesignDocuments\n      query_template:\n        app_id: '{{run_build_binding.target_app_id}}'\n        kind: ui_schema\n        status: succeeded\n      fields:\n      - content\n      default: null\n  experience_spec:\n    type: object\n    description: >\n      Typed ExperienceSpec from DesignDocs \u2014 the authoritative machine-readable\n      page structure. Contains navigation_model, brand_direction, and pages[] with\n      typed primitive section specifications (id, primitive, intent, config_hint).\n      AppPlanAgent treats this as the canonical source for pages[] when present,\n      mapping designed sections directly to sections_hint[] rather than inferring\n      page structure from capability packs.\n    source:\n      type: data_reference\n      database_name: mozaiksai\n      collection: DesignDocuments\n      query_template:\n        app_id: '{{run_build_binding.target_app_id}}'\n        kind: ui_schema\n        status: succeeded\n      fields:\n      - experience_spec\n      default: null\n  design_surface_map:\n    type: object\n    description: >\n      Canonical typed surface realization contract persisted by DesignDocs.\n      This is the primary machine-readable source for deciding which capability\n      packs become modules, workflows, refinement surfaces, integrations, or UI-only surfaces.\n    source:\n      type: data_reference\n      database_name: mozaiksai\n      collection: DesignDocuments\n      query_template:\n        app_id: '{{run_build_binding.target_app_id}}'\n        kind: backend\n        status: succeeded\n      fields:\n      - surface_map\n      default: null\n  data_contract:\n    type: object\n    description: >\n      Canonical typed database ownership and migration contract persisted by DesignDocs.\n      AppGenerator uses this as the source of truth for staged `data/contract.json`\n      and for deterministic backend collection ownership.\n    source:\n      type: data_reference\n      database_name: mozaiksai\n      collection: DataContracts\n      query_template:\n        app_id: '{{run_build_binding.target_app_id}}'\n      fields:\n      - data_contract\n      default: null\n  captured_theme_config:\n    type: object\n    description: >\n      Most recent canonical theme_config captured by ThemeCapture for this app.\n      Highest-fidelity visual input for AppSchemaAgent when deriving theme_config_patch.\n    source:\n      type: data_reference\n      database_name: mozaiksai\n      collection: ThemeCaptures\n      query_template:\n        app_id: '{{run_build_binding.target_app_id}}'\n      fields:\n      - theme_config\n      default: null\n  subscription_contract:\n    type: object\n    description: >\n      Provider-neutral SubscriptionContractOutput produced by\n      SubscriptionContractDesigner in the current workflow sequence, when present.\n      This is the canonical contract for config/subscriptions.yaml, entitlement\n      gates, token wallets, token allowances, add-on products, generated\n      usage/billing pages, and workflow/module metering declarations.\n    source:\n      type: state\n      default: null\n  subscription_contract_artifact:\n    type: object\n    description: >\n      Latest persisted subscription_contract summary artifact. Used as a fallback\n      when the current sequence did not carry subscription_contract in state.\n    source:\n      type: data_reference\n      database_name: mozaiksai\n      collection: ArtifactVersions\n      query_template:\n        app_id: '{{run_build_binding.target_app_id}}'\n        build_family: subscription_contract\n        build_key: subscription_contract\n        lifecycle_status: current\n      fields:\n      - commit_metadata\n      default: null\n  revenue_model:\n    type: string\n    description: >\n      Core OSS monetization route for the app being built. Determines whether\n      subscription contracts, entitlement gates, token wallets, usage meters,\n      and plan catalog artifacts are included in the build plan. \"Monetized\" is\n      not a valid final model; it must resolve to a concrete route.\n      Valid values: free | subscriptions | usage_based | custom | hybrid.\n      Aliased values are mapped: pay_per_use -> usage_based and\n      one_time_purchase -> custom.\n    source:\n      type: state\n      default: free\n  app_backend_url:\n    type: string\n    description: >\n      Base HTTP URL of the active Mozaiks app host for this app.\n      AI agents call this URL + the platform module action API to persist data\n      and trigger domain events. Injected by the platform at workflow start when\n      a backend instance exists; null in schema-only runs.\n    source:\n      type: state\n      default: null\n  agent_websocket_url:\n    type: string\n    description: WebSocket URL for the agent backend (typically produced by AgentGenerator\n      export).\n    source:\n      type: data_reference\n      database_name: mozaiksai\n      collection: WorkflowExports\n      query_template:\n        app_id: '{{run_build_binding.target_app_id}}'\n        workflow_type: agent-generator\n      fields:\n      - agent_websocket_url\n      default: null\n  agent_api_url:\n    type: string\n    description: HTTP API URL for the agent backend (typically produced by AgentGenerator\n      export).\n    source:\n      type: data_reference\n      database_name: mozaiksai\n      collection: WorkflowExports\n      query_template:\n        app_id: '{{run_build_binding.target_app_id}}'\n        workflow_type: agent-generator\n      fields:\n      - agent_api_url\n      default: null\n  agent_repo_url:\n    type: string\n    description: GitHub repository URL for the latest AgentGenerator export (if available).\n    source:\n      type: data_reference\n      database_name: mozaiksai\n      collection: WorkflowExports\n      query_template:\n        app_id: '{{run_build_binding.target_app_id}}'\n        workflow_type: agent-generator\n      fields:\n      - repo_url\n      default: null\n  agent_names:\n    type: array"},{"checksum":"sha256:a4742398e6e9274205a95d7417fda9d6055669f80968b49fd295b9b41e7d537b","chunk_id":"chunk_9328c6dff03e78b8","end_line":1056,"path":"workflows/AppGenerator/context_variables.yaml","start_line":795,"symbol_ids":[],"text":"    description: Agent names extracted from the most recent AgentGenerator bundle export\n      (if available).\n    source:\n      type: data_reference\n      database_name: mozaiksai\n      collection: WorkflowExports\n      query_template:\n        app_id: '{{run_build_binding.target_app_id}}'\n        workflow_type: agent-generator\n      fields:\n      - agent_names\n      default: []\n  tool_names:\n    type: array\n    description: Tool names extracted from the most recent AgentGenerator bundle export\n      (if available).\n    source:\n      type: data_reference\n      database_name: mozaiksai\n      collection: WorkflowExports\n      query_template:\n        app_id: '{{run_build_binding.target_app_id}}'\n        workflow_type: agent-generator\n      fields:\n      - tool_names\n      default: []\n  available_agents:\n    type: array\n    description: Alias for agent_names (preferred downstream name).\n    source:\n      type: data_reference\n      database_name: mozaiksai\n      collection: WorkflowExports\n      query_template:\n        app_id: '{{run_build_binding.target_app_id}}'\n        workflow_type: agent-generator\n      fields:\n      - available_agents\n      default: []\n  available_tools:\n    type: array\n    description: Alias for tool_names (preferred downstream name).\n    source:\n      type: data_reference\n      database_name: mozaiksai\n      collection: WorkflowExports\n      query_template:\n        app_id: '{{run_build_binding.target_app_id}}'\n        workflow_type: agent-generator\n      fields:\n      - available_tools\n      default: []\n  workflow_integration_metadata:\n    type: object\n    description: >\n      Canonical normalized AgentGenerator-to-AppGenerator handoff metadata for the\n      latest workflow_bundle artifact. Contains contract_version, bundle_name,\n      workflows[], and primary_workflow. Hydrated before AppGenerator agents run\n      when a workflow_bundle artifact exists.\n    source:\n      type: computed\n      default: null\n  generated_workflow_integrations:\n    type: array\n    description: >\n      Normalized list of AgentGenerator-produced workflow integrations. Each item\n      carries workflow_name, capability_id, startup_mode, and trigger_events.\n      AppGenerator uses this list to wire module capabilities, emitted events, and\n      reactions deterministically.\n    source:\n      type: computed\n      default: []\n  workflow_bundle_artifact_version_id:\n    type: string\n    description: >\n      Source artifact version id for the workflow_bundle artifact that hydrated\n      workflow_integration_metadata. Null when AppGenerator is running without an\n      upstream workflow bundle.\n    source:\n      type: computed\n      default: null\n  generated_workflow_name:\n    type: string\n    description: >\n      Canonical name of the workflow generated by AgentGenerator for this app (e.g.\n      \"CustomerSupport\"). Use this as the direct `workflow_id` when persistent\n      page actions need to launch the workflow. This is not the value used in\n      `workflow_capability_ids` for domain event wiring. Null when no\n      AgentGenerator workflow has been produced for this app.\n    source:\n      type: data_reference\n      database_name: mozaiksai\n      collection: WorkflowExports\n      query_template:\n        app_id: '{{run_build_binding.target_app_id}}'\n        workflow_type: agent-generator\n      fields:\n      - workflow_name\n      default: null\n  generated_workflow_capability_id:\n    type: string\n    description: >\n      Stable hyphenated capability ID for the AgentGenerator-produced workflow\n      (e.g. \"customer-support\"). This is the value to use in workflow_capability_ids\n      fields of module.yaml and events.yaml so the platform can resolve the workflow\n      at runtime. Null when no workflow has been generated.\n    source:\n      type: data_reference\n      database_name: mozaiksai\n      collection: WorkflowExports\n      query_template:\n        app_id: '{{run_build_binding.target_app_id}}'\n        workflow_type: agent-generator\n      fields:\n      - capability_id\n      default: null\n  generated_workflow_startup_mode:\n    type: string\n    description: >\n      Startup mode of the AgentGenerator-produced workflow: AgentDriven (agents speak\n      first without user input) or UserDriven (waits for the user to send a message).\n      AppPlanAgent and AppSchemaAgent use this only to shape launch expectations\n      and copy. The runtime owns whether the workflow speaks first after session\n      launch.\n    source:\n      type: data_reference\n      database_name: mozaiksai\n      collection: WorkflowExports\n      query_template:\n        app_id: '{{run_build_binding.target_app_id}}'\n        workflow_type: agent-generator\n      fields:\n      - workflow_startup_mode\n      default: null\n  generated_workflow_trigger_events:\n    type: array\n    description: >\n      Trigger event contracts declared in the AgentGenerator-produced workflow's\n      orchestrator.yaml triggers block. Each entry carries the event type and any\n      capability_id that fires the workflow. ConfigMiddlewareAgent uses these when\n      generating events.yaml subscriptions so domain events wire up to the correct\n      workflow capability without hardcoding workflow names.\n    source:\n      type: data_reference\n      database_name: mozaiksai\n      collection: WorkflowExports\n      query_template:\n        app_id: '{{run_build_binding.target_app_id}}'\n        workflow_type: agent-generator\n      fields:\n      - trigger_events\n      default: []\n  workflow_integration_repair_status:\n    type: string\n    description: >\n      Bounded repair status for AgentGenerator-to-AppGenerator workflow wiring.\n      One of not_applicable | needs_revision | passed | blocked.\n    source:\n      type: computed\n      default: null\n  workflow_integration_repair_count:\n    type: integer\n    description: Number of workflow-integration repair passes already scheduled.\n    source:\n      type: computed\n      default: 0\n  workflow_integration_repair_max_attempts:\n    type: integer\n    description: Maximum automated workflow-integration repair attempts before blocking.\n    source:\n      type: computed\n      default: 2\n  workflow_integration_repair_request:\n    type: string\n    description: Focused ConfigMiddlewareAgent repair instruction derived from acceptance gate failures.\n    source:\n      type: computed\n      default: null\n  workflow_integration_repair_failed_tests:\n    type: array\n    description: Raw workflow integration failed tests that caused the repair pass.\n    source:\n      type: computed\n      default: []\n  workflow_integration_repair_failure_fingerprint:\n    type: string\n    description: Stable digest of the last workflow-integration failure evidence.\n    source:\n      type: computed\n      default: null\n  workflow_integration_repair_no_progress:\n    type: boolean\n    description: True when a repair pass reproduces the identical workflow-integration failure.\n    source:\n      type: computed\n      default: false\n  workflow_integration_repair_result:\n    type: object\n    description: Full workflow integration repair scheduling result.\n    source:\n      type: computed\n      default: null\n  bundle_repair_status:\n    type: string\n    description: >\n      Bounded repair status for deterministic generated-bundle validation failures.\n      One of not_applicable | needs_revision | passed | blocked.\n    source:\n      type: computed\n      default: null\n  bundle_repair_target:\n    type: string\n    description: >\n      Agent that owns the next generated-bundle repair pass. Null unless\n      bundle_repair_status is needs_revision.\n    source:\n      type: computed\n      default: null\n  bundle_repair_attempt_count:\n    type: integer\n    description: Number of generated-bundle validation repair passes already scheduled.\n    source:\n      type: computed\n      default: 0\n  bundle_repair_max_attempts:\n    type: integer\n    description: Maximum automated generated-bundle validation repair attempts before blocking.\n    source:\n      type: computed\n      default: 2\n  bundle_repair_request:\n    type: string\n    description: Focused repair instruction derived from generated-bundle validation failures.\n    source:\n      type: computed\n      default: null\n  bundle_repair_errors:\n    type: array\n    description: Generated-bundle validation errors that caused the repair pass.\n    source:\n      type: computed\n      default: []\n  bundle_repair_failure_fingerprint:\n    type: string\n    description: Stable digest of the last targeted generated-bundle failure evidence.\n    source:\n      type: computed\n      default: null\n  bundle_repair_no_progress:\n    type: boolean\n    description: True when a repair pass reproduces the identical targeted bundle failure.\n    source:\n      type: computed\n      default: false\n  bundle_repair_result:\n    type: object\n    description: Full generated-bundle validation repair scheduling result.\n    source:\n      type: computed\n      default: null\n  interview_complete:\n    type: boolean"},{"checksum":"sha256:ec1fc1fe075ee9a25decf8ad560ae938505e9e756dba8487dc2dc04d1f520ca3","chunk_id":"chunk_7a7253637ff6ed66","end_line":1319,"path":"workflows/AppGenerator/context_variables.yaml","start_line":1057,"symbol_ids":[],"text":"    description: True once the intake interview has gathered enough non-AI product\n      scope to begin app generation.\n    source:\n      type: state\n      default: false\n      triggers:\n      - type: agent_text\n        agent: InterviewAgent\n        ui_hidden: true\n        match:\n          equals: NEXT\n  app_plan_feedback:\n    type: string\n    description: Exact deterministic errors to repair in the next complete AppBuildPlan.\n    source: {type: computed, default: ''}\n  app_plan_outcome:\n    type: string\n    authority_class: closed_writer_routing_state\n    writer_ids: [deterministic_tool]\n    persisted: true\n    description: Validated plan outcome used by the existing AG2 transition graph.\n    source: {type: state, default: blocked}\n  app_plan_attempts:\n    type: integer\n    authority_class: closed_writer_quality_state\n    writer_ids: [deterministic_tool]\n    persisted: true\n    description: Runtime-owned count of complete plan validation attempts.\n    source: {type: state, default: 0}\n  app_build_plan:\n    type: object\n    description: Canonical app build plan derived from the brief and design documents.\n      It defines capability packs, pages, entities, roles, integrations, theme preferences,\n      and generation order for downstream code generation.\n    source:\n      type: computed\n      default: null\n  app_plan_ready:\n    type: boolean\n    description: True once AppPlanAgent has persisted the canonical app build plan.\n    source:\n      type: computed\n      default: false\n  app_task_batch_items:\n    type: array\n    description: Hydrated task batch items for each AppGenerator build task, written by app_build_plan.\n    source:\n      type: computed\n      default: []\n  app_task_batch_status:\n    type: string\n    description: >\n      Status of AppGenerator task batch execution: planned | running |\n      completed | failed.\n    source:\n      type: computed\n      default: null\n  app_task_batch_results:\n    type: object\n    description: Normalized results from AppGenerator task batch execution.\n    source:\n      type: computed\n      default: null\n  app_task_batch_results_summary:\n    type: object\n    description: Compact task batch status and task-key summary written after AssemblyAgent merges task outputs.\n    source:\n      type: computed\n      default: null\n  dev_pack_id:\n    type: string\n    description: >\n      Active domain dev pack identifier. Used by middleware hooks such as\n      hook_language_profile_context to load the correct language profile from\n      build_context/{dev_pack_id}/language_profile.yaml. Projected from the\n      active build context at launch time. Defaults to webapp_builder when not\n      set by the active build context or sequence.\n    source:\n      type: state\n      default: webapp_builder\n  build_task_model:\n    type: string\n    description: >\n      Qualified name of the domain task model used by the app_build_tasks\n      batch. Resolved at task batch launch time from this context variable.\n      Defaults to AppBuildTask for the webapp_builder domain. A future domain\n      pack overrides this to supply its own task model without changing the\n      harness contract.\n    source:\n      type: state\n      default: AppBuildTask\n  operator_capabilities:\n    type: array\n    description: >\n      Capability identifiers enabled by the active workspace/operator build\n      context. Empty list in OSS mode. Projected from\n      build_context/{context_name}/context.yaml at launch time.\n    source:\n      type: build_context\n      default: []\n  capability_packs:\n    type: array\n    description: >\n      Prompt-safe capability pack descriptors discovered from the active\n      build_context/{context_name}/context.yaml when it declares pack:. Each\n      entry is a CapabilityPack dict with fields such as id, capabilities,\n      facades, pack_source_path, and capability_source.\n      Empty list in OSS mode.\n    source:\n      type: build_context\n      default: []\n  readiness_profile:\n    type: string\n    description: >\n      Deterministic operator readiness classification emitted by AppPlanAgent.\n      Values: none, basic_app, saas_app, host_operator_platform, or\n      marketplace_platform. Downstream template renderers and operator helper\n      packs use this to choose the no-spend launch profile. Empty/none in OSS\n      mode or when the app does not need a readiness pack.\n    source:\n      type: computed\n      default: none\n  capability_registry:\n    type: object\n    description: >\n      Build-context deterministic capability routing rules. Maps capability\n      identifiers to their implementation strategy (capability_pack_id,\n      implementation_mode, surface_kind). AppPlanAgent consults this before\n      LLM reasoning to route known operator capabilities deterministically.\n      Empty dict in OSS mode. Projected from build_context/{context_name}/context.yaml\n      at launch time.\n    source:\n      type: build_context\n      default: {}\n  operator_contracts:\n    type: array\n    description: >\n      Prompt-safe typed operator contract descriptors loaded from the selected\n      build_context/{context_name}/contract.yaml file and projected for this\n      workflow.\n    source:\n      type: build_context\n      default: []\n  provider_backed_capabilities:\n    type: array\n    description: >\n      Capabilities implemented by external, proprietary, or operator-managed\n      providers rather than generated app-local internals.\n    source:\n      type: build_context\n      default: []\n  operator_policies:\n    type: object\n    description: >\n      Build-time operator policies such as entitlement mode, billing mode,\n      adapter boundaries, review requirements, or generation constraints.\n    source:\n      type: build_context\n      default: {}\n  app_manifest:\n    type: object\n    description: App manifest metadata used by AppSchemaAgent to persist app.json startup and validate page routes.\n    source:\n      type: computed\n      default: null\n  app_pages:\n    type: array\n    description: List of AppPageSchema objects persisted by AppSchemaAgent via save_app_schema.\n    source:\n      type: computed\n      default: []\n  app_theme_config_patch:\n    type: object\n    description: Partial brand/theme artifact persisted for this app (may be null).\n    source:\n      type: computed\n      default: null\n  app_shell_config:\n    type: object\n    description: Optional shell content/behavior config persisted by AppSchemaAgent.\n    source:\n      type: computed\n      default: null\n  app_asset_manifest:\n    type: object\n    description: Optional app asset inventory persisted by AppSchemaAgent.\n    source:\n      type: computed\n      default: null\n  app_custom_route_bundle:\n    type: object\n    description: Optional bounded custom full-page React route bundle persisted by AppSchemaAgent.\n    source:\n      type: computed\n      default: null\n  app_schema_ready:\n    type: boolean\n    description: True once AppSchemaAgent has persisted the app manifest and page schemas.\n    source:\n      type: computed\n      default: false\n  integration_needs:\n    type: array\n    description: >\n      App-scoped third-party connector needs discovered by AppPlanAgent build\n      tasks, task batch outputs, or task agents via record_integration_need.\n      IntegrationReadinessAgent aggregates this list and prompts inline only for\n      unresolved required integration setup.\n    source:\n      type: computed\n      default: []\n  integration_readiness_status:\n    type: string\n    description: >\n      Integration readiness checkpoint status set by check_integration_readiness:\n      ready | needs_configuration | blocked.\n    source:\n      type: computed\n      default: null\n  integration_readiness_result:\n    type: object\n    description: Raw result payload from the AppGenerator integration readiness checkpoint.\n    source:\n      type: computed\n      default: null\n  connector_inventory:\n    type: object\n    description: App-scoped connector inventory loaded from the platform connector store.\n    source:\n      type: computed\n      default: null\n  required_connector_services:\n    type: array\n    description: Normalized connector service ids required by the current app build.\n    source:\n      type: computed\n      default: []\n  ready_connector_services:\n    type: array\n    description: Normalized connector service ids ready for reuse by the current app build.\n    source:\n      type: computed\n      default: []\n  missing_connector_services:\n    type: array\n    description: Normalized required connector service ids still unresolved.\n    source:\n      type: computed\n      default: []\n  task_run_mode:\n    type: boolean\n    description: True when an AppGenerator agent is executing one scoped task batch item.\n    source:\n      type: state\n      default: false\n  current_build_task:\n    type: object\n    description: Current build task spec for task batch item execution.\n    source:\n      type: state\n      default: null\n  current_build_task_id:\n    type: string"},{"checksum":"sha256:168258a01d5f4939a208c7329307ec81589746d1b9e86d02a28f3e8dc90d29d6","chunk_id":"chunk_b5d044672b2b9188","end_line":1593,"path":"workflows/AppGenerator/context_variables.yaml","start_line":1320,"symbol_ids":[],"text":"    description: Current build task identifier for task batch item execution.\n    source:\n      type: state\n      default: null\n  current_build_task_type:\n    type: string\n    description: Current build task type for task batch item execution.\n    source:\n      type: state\n      default: null\n  integration_tests_passed:\n    type: boolean\n    description: Set by run_integration_tests tool to route handoffs.\n    source:\n      type: computed\n      default: false\n  integration_test_result:\n    type: object\n    description: Raw integration test result payload (may be null).\n    source:\n      type: computed\n      default: null\n  pending_schema_migration:\n    type: object\n    description: >\n      Migration document produced by DatabaseAgent during a refinement run.\n      Null for greenfield generation runs. generate_and_download injects this\n      into the bundle as data/migrations/{migration_id}.json when present.\n    source:\n      type: computed\n      default: null\n  app_validation_strategy:\n    type: string\n    description: >\n      Requested validation strategy for AppGenerator code validation. Allowed values:\n      e2b | local | skip. Null lets the validation tool resolve a runtime-appropriate\n      default.\n    source:\n      type: state\n      default: null\n  app_validation_status:\n    type: string\n    description: >\n      Validation outcome set by validate_app_build. One of pending | passed | failed | skipped.\n    source:\n      type: computed\n      default: pending\n  app_validation_strategy_used:\n    type: string\n    description: Resolved validation strategy actually used for the current run.\n    source:\n      type: computed\n      default: null\n  app_validation_preview_url:\n    type: string\n    description: Preview URL returned by app validation (may be null).\n    source:\n      type: computed\n      default: null\n  app_validation_result:\n    type: object\n    description: Raw app validation result payload (may be null).\n    source:\n      type: computed\n      default: null\n  wiring_validation_passed:\n    type: boolean\n    description: Set by the deterministic module/page wiring check.\n    source:\n      type: computed\n      default: false\n  wiring_validation_result:\n    type: object\n    description: Raw module/page wiring validation payload.\n    source:\n      type: computed\n      default: null\n  module_implementation_validation_passed:\n    type: boolean\n    description: Set by the deterministic module.yaml-to-backend implementation check.\n    source:\n      type: computed\n      default: false\n  module_implementation_validation_result:\n    type: object\n    description: Raw module implementation validation payload.\n    source:\n      type: computed\n      default: null\n  workflow_integration_validation_passed:\n    type: boolean\n    description: Set by the deterministic AgentGenerator workflow integration check.\n    source:\n      type: computed\n      default: false\n  workflow_integration_validation_result:\n    type: object\n    description: Raw AgentGenerator workflow integration validation result.\n    source:\n      type: computed\n      default: null\n  generated_app_dir:\n    type: string\n    description: Absolute path to the generated app bundle directory after schema save or download packaging.\n    source:\n      type: computed\n      default: null\n  bundle_path:\n    type: string\n    writer_ids: [deterministic_tool]\n    persisted: true\n    description: >\n      Staged app directory registered by generate_and_download in the current\n      build run. Forwarded through SecurityReadiness to AppReview for revision.\n    source:\n      type: computed\n      default: null\n  lifecycle_state:\n    type: string\n    writer_ids: [transition_router, deterministic_tool]\n    persisted: true\n    description: Review state published after the staged bundle is registered.\n    source:\n      type: computed\n      default: null\n  generated_app_zip:\n    type: string\n    description: Absolute path to the generated ZIP bundle after DownloadAgent packaging.\n    source:\n      type: computed\n      default: null\n  download_status:\n    type: string\n    description: Download packaging status, such as ready or cancelled.\n    source:\n      type: computed\n      default: null\n  app_download_ready:\n    type: boolean\n    description: True after DownloadAgent has packaged the app bundle and the artifact UI has completed.\n    source:\n      type: computed\n      default: false\n  download_result:\n    type: object\n    description: Compact download packaging result with bundle paths and file count.\n    source:\n      type: computed\n      default: null\n  admin_registry:\n    type: object\n    description: >\n      AdminRegistry dict persisted by save_admin_registry after AdminRegistryAgent runs.\n      Contains schema_version and pages[] (id, label, path, icon, order, enabled, scope).\n      Used by the module contract quality gate to validate that every admin.yaml panel\n      `page` field references a declared page id. Null until AdminRegistryAgent completes.\n    source:\n      type: computed\n      default: null\n  app_ui_quality_status:\n    type: string\n    description: >\n      UI schema quality gate outcome set by validate_app_ui_quality. One of\n      passed | needs_revision | blocked. Drives AG2 transition routing after\n      AppUIQualityAgent.\n    source:\n      type: computed\n      default: null\n  app_ui_quality_warnings:\n    type: array\n    description: Deterministic warnings produced by the app UI quality gate.\n    source:\n      type: computed\n      default: []\n  app_ui_quality_revision_count:\n    type: integer\n    description: Number of automated AppSchemaAgent revision loops used by the UI quality gate.\n    source:\n      type: computed\n      default: 0\n  app_ui_quality_revision_request:\n    type: string\n    description: Focused revision instruction passed back to AppSchemaAgent when UI quality needs revision.\n    source:\n      type: computed\n      default: null\n  app_ui_quality_result:\n    type: object\n    description: Raw app UI quality gate result payload.\n    source:\n      type: computed\n      default: null\n  module_contract_quality_status:\n    type: string\n    description: >\n      Quality gate outcome set by review_module_contract_quality. One of\n      passed | blocked. Drives handoff routing after ConfigMiddlewareAgent in\n      the sequential (non-task_run_mode) path.\n    source:\n      type: computed\n      default: null\n  module_contract_quality_warnings:\n    type: array\n    description: >\n      Deterministic warnings from audit_module_contracts. Populated by the\n      hook_module_contract_quality_gate hook before ModuleContractQualityAgent\n      speaks. Empty list when no issues are found.\n    source:\n      type: computed\n      default: []\n  module_runtime_quality_status:\n    type: string\n    description: >\n      Quality gate outcome set by review_module_runtime_quality after\n      ServiceAgent emits module backend Python. One of passed | needs_revision |\n      blocked. Drives handoff routing before FrontendStubAgent.\n    source:\n      type: computed\n      default: null\n  module_runtime_quality_warnings:\n    type: array\n    description: >\n      Deterministic warnings from the module runtime quality gate. Flags\n      placeholder/sample/mock data, TODO runtime logic, and hardcoded\n      stats/trends in generated module backend code.\n    source:\n      type: computed\n      default: []\n  module_runtime_quality_revision_count:\n    type: integer\n    description: Number of automated ServiceAgent revision loops already used by the runtime quality gate.\n    source:\n      type: computed\n      default: 0\n  module_runtime_quality_revision_request:\n    type: string\n    description: Revision instructions generated by the module runtime quality gate, or null when none are needed.\n    source:\n      type: computed\n      default: null\n  module_runtime_quality_result:\n    type: object\n    description: Raw module runtime quality result payload persisted by review_module_runtime_quality.\n    source:\n      type: computed\n      default: null\n  code_files:\n    type: array\n    description: >\n      Accumulated generated file overlay entries emitted by AppGenerator agents\n      and auto-save tools before AssemblyAgent writes the canonical\n      generated_files map. Later entries with the same filename replace earlier\n      entries.\n    source:\n      type: computed\n      default: []\n  deleted_files:\n    type: array\n    description: >\n      Relative generated file paths that should be removed from the current\n      assembled bundle during repair/refinement. Used when a stale or forbidden\n      artifact must be deleted rather than overwritten.\n    source:\n      type: computed\n      default: []\n  generated_files:\n    type: object\n    description: >-\n      Canonical app bundle file map. Partial revisions preload the verified\n      selected app-bundle archive; assembly overlays schema/task outputs and\n      explicit deletions while preserving unchanged files.\n    source:\n      type: computed\n      default: {}"},{"checksum":"sha256:d7dcad505323bce9fdf777cbf8e4333a5485bbb2b759b7c34d4bd48ea9694075","chunk_id":"chunk_f136c1b4b707dbe0","end_line":1939,"path":"workflows/AppGenerator/context_variables.yaml","start_line":1594,"symbol_ids":[],"text":"  assembled_source:\n    type: string\n    description: Assembly source marker describing which canonical lanes produced generated_files.\n    source:\n      type: computed\n      default: null\nagents:\n  InterviewAgent:\n    variables:\n    - platform_user_email\n    - build_mode\n    - revision_scope\n    - change_request_id\n    - revision_id\n    - artifact_kind\n    - artifact_version_id\n    - sequence_status\n    - revision_origin_workflow\n    - refinement_request\n    - refinement_request_meta\n    - screen\n    - change_intent\n    - impact_set\n    - app_context_required\n    - current_app_context_version_id\n    - app_context_summary\n    - app_type\n    - app_intelligence_ready\n    - app_intelligence_status\n    - app_intelligence_summary\n    - app_intelligence_health\n    - app_intelligence_catalog\n    - source_context_catalog\n    - concept_overview\n    - coding_participation\n    - concept_api_endpoints\n    - concept_blueprint\n    - design_surface_map\n    - data_contract\n    - frontend_design_document\n    - backend_design_document\n    - database_design_document\n    - a