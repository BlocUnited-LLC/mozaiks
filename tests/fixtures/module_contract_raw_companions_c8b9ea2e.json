   "app_id": null,
   "app_name": "TaskTracker Pro",
   "code_files": [
    {
     "content": "schema_version: mozaiks.subscriptions.v1\nlabel: TaskTracker Pro Subscription\ndefault_plan_id: free\nassignment_store:\n  data_alias: billing.subscriptions\n  app_id_field: app_id\n  tenant_id_field: tenant_id\n  user_id_field: user_id\n  plan_id_field: plan_id\n  status_field: status\n  starts_at_field: starts_at\n  expires_at_field: expires_at\n  capabilities_field: granted_capabilities\n  plan_snapshot_field: plan_snapshot\n  revision_field: billing_revision\n  active_statuses:\n  - active\n  - pending\n  - trialing\nproducts: []\nplans:\n- plan_id: free\n  label: Free Plan\n  description: Access to basic task management features.\n  capabilities:\n  - feature.module.task_management.create_task\n  - feature.module.task_management.delete_task\n  - feature.module.task_management.update_task\n  usage_limits:\n  - meter_id: module.task_management.create_task\n    label: Task Creation Limit\n    unit: requests\n    monthly_limit: 25\n    capability_id: feature.module.task_management.create_task\n- plan_id: pro\n  label: Pro Plan\n  description: Advanced features for task management.\n  capabilities:\n  - feature.module.task_management.create_task\n  - feature.module.task_management.delete_task\n  - feature.module.task_management.summarize_tasks\n  - feature.module.task_management.update_task\n",
     "filename": "config/subscriptions.yaml"
    }
   ],
