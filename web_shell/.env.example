# Frontend dev-server: point to the running runtime
VITE_CORE_URL=http://localhost:8001
VITE_AI_RUNTIME_PORT=8000

# Set to "true" to skip real API calls during UI development
VITE_MOCK_MODE=false

# Set to "true" to preview the Studio usage dashboard with sample chat usage.
# This affects usage screens only and does not write fake backend records.
VITE_USAGE_DEMO_MODE=false
